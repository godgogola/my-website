    <script>
      // 導覽列 AnimatedTabs 彈簧滑塊邏輯
      document.addEventListener('DOMContentLoaded', () => {
        const track = document.getElementById('mainNavTrack');
        const indicator = document.getElementById('navIndicator');
        const items = track?.querySelectorAll<HTMLAnchorElement>('.nav-item');

        if (track && indicator && items && items.length > 0) {
          const updateIndicator = (target: HTMLElement, immediate = false) => {
            const trackRect = track.getBoundingClientRect();
            const targetRect = target.getBoundingClientRect();
            const left = targetRect.left - trackRect.left;
            const top = targetRect.top - trackRect.top;
            const width = targetRect.width;
            const height = targetRect.height;

            if (immediate) {
              indicator.style.transition = 'none';
            } else {
              indicator.style.transition = 'transform 0.28s cubic-bezier(0.34, 1.56, 0.64, 1), width 0.28s cubic-bezier(0.34, 1.56, 0.64, 1)';
            }

            indicator.style.transform = `translate3d(${left}px, ${top}px, 0)`;
            indicator.style.width = `${width}px`;
            indicator.style.height = `${height}px`;
            indicator.style.opacity = '1';
          };

          const activeItem = track.querySelector<HTMLAnchorElement>('.nav-item.active') || items[0];
          if (activeItem) {
            updateIndicator(activeItem, true);
          }

          items.forEach(item => {
            item.addEventListener('mouseenter', () => updateIndicator(item));
          });

          track.addEventListener('mouseleave', () => {
            const current = track.querySelector<HTMLAnchorElement>('.nav-item.active') || items[0];
            if (current) updateIndicator(current);
          });

          window.addEventListener('resize', () => {
            const current = track.querySelector<HTMLAnchorElement>('.nav-item.active') || items[0];
            if (current) updateIndicator(current, true);
          }, { passive: true });
        }
      });
    </script>
  </body>
</html>

<style is:global>
  /* ═══════════════════════════════════════
     全域 Design Tokens (Veterinary Clinic 乾淨醫療風格)
  ═══════════════════════════════════════ */
  :root {
    --color-primary: #4a90a4; /* Ocean Teal */
    --color-primary-dark: #3b7688;
    --color-primary-light: #eef7f9;
    --color-secondary: #6bb5a2; /* Sage Sea Green */
    --color-secondary-light: #edf7f4;
    --color-accent: #f4a261; /* Warm Gold / Amber */
    --color-coral: #e76f51; /* Coral / Salmon Accent */
    --color-coral-light: #fdeee9;
    --color-bg-page: #f8fbfc; /* Crisp Clean Mint-Ice White */
    --color-bg-alt: #eef5f7;
    --color-bg-card: #ffffff;
    --color-bg-dark: #2c5364; /* Deep Petrol Slate */
    --color-text-title: #1e3a4c; /* Deep Petrol Navy */
    --color-text-body: #2d4f63;
    --color-text-muted: #5a7a8a;
    --color-border: #d4e5eb;
    --color-shadow: rgba(74, 144, 164, 0.08);

    --radius-sm: 8px;
    --radius-md: 14px;
    --radius-lg: 20px;
    --radius-full: 9999px;
  }

  * {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
  }

  html {
    font-family: 'Plus Jakarta Sans', 'Poppins', 'Noto Sans TC', -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
    background-color: var(--color-bg-page);
    color: var(--color-text-body);
    line-height: 1.6;
    scroll-behavior: smooth;
  }

  body {
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    position: relative;
    overflow-x: hidden;
  }

  /* ── 氛圍柔光球 ── */
