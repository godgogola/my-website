      <div class="glow-orb glow-orb-2"></div>
    </div>

    <!-- 頂部浮動雙層導覽列 (Floating 2-Tier Capsule Header) -->
    <header class="navbar-vet-wrapper">
      <div class="navbar-vet">
        <!-- 品牌區塊 (第一排) -->
        <div class="brand-row">
          <a href="/" class="brand-logo" aria-label="黃冠智醫師 豐田診所">
