---
interface Props {
  title: string;
  description?: string;
  /** 覆蓋 <title> 標籤的完整文字（不會自動加上 " | 黃冠智醫師" suffix） */
  meta_title?: string;
  /** 覆蓋 <meta name="description"> 的文字 */
  meta_description?: string;
  /** Open Graph 封面圖完整 URL（用於 FB / LINE 分享） */
  ogImage?: string;
  /** 當前頁面完整 URL（用於 og:url） */
  canonicalUrl?: string;
}

const {
  title,
  description = "黃冠智醫師的個人衛教專欄與筆記。提供肝膽腸胃健康、內科醫學等實證衛教資訊。",
  meta_title,
  meta_description,
  ogImage,
  canonicalUrl,
} = Astro.props;

// 決定最終 Open Graph / LINE 封面圖
const defaultOgImage = "https://drhuanggi.vercel.app/images/og-turtle.jpg";
const rawOgImage = ogImage || defaultOgImage;
const finalOgImage = rawOgImage.startsWith('http')
  ? rawOgImage
  : `${Astro.site?.origin ?? 'https://drhuanggi.vercel.app'}${rawOgImage.startsWith('/') ? '' : '/'}${rawOgImage}`;

// 決定最終 <title> 文字
const finalTitle = meta_title ?? `${title} | 黃冠智醫師`;
// 決定最終 description
const finalDescription = meta_description ?? description;

// 取得當前網址路徑以動態高亮選單
const pathname = Astro.url.pathname;
const isHome = pathname === '/' || pathname === '';
const isHealthColumn = pathname.startsWith('/health-column');
const isBowelPrep = pathname.startsWith('/bowel-prep');
---

<!DOCTYPE html>
<html lang="zh-TW">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <!-- 網站圖示 Favicon (供 Google 搜尋與各大瀏覽器使用) -->
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/png" sizes="48x48" href="/favicon-48x48.png" />
    <link rel="icon" type="image/png" sizes="192x192" href="/favicon-192x192.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="shortcut icon" href="/favicon-48x48.png" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- 基礎 SEO -->
    <title>{finalTitle}</title>
    <meta name="description" content={finalDescription} />
    {canonicalUrl && <link rel="canonical" href={canonicalUrl} />}

    <!-- Open Graph（Facebook / LINE 分享） -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={finalTitle} />
    <meta property="og:description" content={finalDescription} />
    <meta property="og:image" content={finalOgImage} />
    <meta property="og:site_name" content="黃冠智醫師 醫學筆記" />
    <meta property="og:locale" content="zh_TW" />
    {canonicalUrl && <meta property="og:url" content={canonicalUrl} />}

    <!-- Google 網站名稱 (Site Name) 官方結構化資料 -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "WebSite",
      "name": "黃冠智醫師 醫學筆記",
      "alternateName": ["黃冠智醫師", "豐田診所 黃冠智醫師", "黃冠智 院長", "Dr. Huang GI"],
      "url": "https://drhuanggi.vercel.app/"
    })} />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={finalTitle} />
    <meta name="twitter:description" content={finalDescription} />
    <meta name="twitter:image" content={finalOgImage} />
    
    <!-- Google tag (gtag.js) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-M2P627PEG5"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());

      gtag('config', 'G-M2P627PEG5');
    </script>

    <!-- Google Fonts (Plus Jakarta Sans + Noto Sans TC) -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+TC:wght@400;500;600;700;900&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    
    <style is:global>
      /* --- Pet Adoption Warm Coral & Cream Design Tokens --- */
      :root {
        --color-bg-page: #FAF6F0;       /* 溫暖奶油米白 */
        --color-bg-alt: #F4EFE6;        /* 柔和沙色副背景 */
        --color-bg-card: #FFFFFF;       /* 純白卡片 */
        --color-primary: #E76F51;       /* 暖珊瑚橘主色 */
        --color-primary-hover: #D65A3D; /* 珊瑚深橘 */
        --color-primary-light: #FDEEE9; /* 柔粉珊瑚淺底 */
        --color-secondary: #F4A261;     /* 溫暖蜜桃橘 */
        --color-secondary-light: #FEF6EC;/* 淺蜜桃 */
        --color-accent: #E9C46A;        /* 柔陽光金 */
        --color-accent-light: #FFF9E6;  /* 淺金底 */
        --color-mint: #4DB6AC;          /* 薄荷綠 */
        --color-mint-light: #E0F2F1;    /* 淺薄荷底 */
        --color-text-title: #1E293B;    /* 深暖炭灰標題 */
        --color-text-body: #334155;     /* 易讀深石板灰內文 */
        --color-text-muted: #64748B;    /* 柔和石板灰次要字 */
        --color-border: #EFE8DE;        /* 柔和邊框 */
        --color-border-subtle: #F5EFEB; /* 微細邊框 */
        --color-shadow: rgba(231, 111, 81, 0.08);
        --color-shadow-hover: rgba(231, 111, 81, 0.16);
      }

      /* Base Reset */
      *, *::before, *::after {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
      }

      html {
        font-size: 16px;
        scroll-behavior: smooth;
        -webkit-text-size-adjust: 100%;
        text-size-adjust: 100%;
      }

      @media (max-width: 768px) {
        html {
          font-size: 17px;
        }
      }

      body {
        font-family: 'Plus Jakarta Sans', 'Noto Sans TC', -apple-system, BlinkMacSystemFont, sans-serif;
        background-color: var(--color-bg-page);
        color: var(--color-text-body);
        line-height: 1.65;
        -webkit-font-smoothing: antialiased;
        position: relative;
        min-height: 100vh;
        overflow-x: hidden;
      }

      /* Background Ambient Light Glow Orbs */
      .ambient-glow-layer {
        position: fixed;
        inset: 0;
        pointer-events: none;
        z-index: 0;
        overflow: hidden;
      }

      .glow-orb {
        position: absolute;
        border-radius: 50%;
        filter: blur(100px);
        opacity: 0.18;
      }

      .glow-orb-1 {
        top: -100px;
        right: -80px;
        width: 500px;
        height: 500px;
        background: #E76F51;
      }

      .glow-orb-2 {
        top: 40%;
        left: -150px;
        width: 450px;
        height: 450px;
        background: #F4A261;
      }

      .glow-orb-3 {
        bottom: 10%;
        right: -100px;
        width: 400px;
        height: 400px;
        background: #E9C46A;
      }

      a {
        color: inherit;
        text-decoration: none;
      }

      /* Universal Gradient Text */
      .gradient-text {
        background: linear-gradient(135deg, #E76F51 0%, #F4845F 50%, #FF8A65 100%);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        color: transparent;
      }

      /* Layout Container */
      .layout-container {
        position: relative;
        z-index: 1;
        display: flex;
        flex-direction: column;
        min-height: 100vh;
        max-width: 1240px;
        margin: 0 auto;
        padding: 0 20px;
      }

      @media (max-width: 600px) {
        .layout-container {
          padding: 0 12px;
        }
      }

      main {
        flex-grow: 1;
        padding: 30px 0 60px;
      }

      /* Header (Pill Glassmorphism) */
      .site-header-wrapper {
        position: sticky;
        top: 16px;
        z-index: 100;
        width: 100%;
        margin: 0 0 24px 0;
      }

      .site-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 8px 16px;
        background: rgba(255, 255, 255, 0.92);
        backdrop-filter: blur(20px);
        -webkit-backdrop-filter: blur(20px);
        border: 1px solid rgba(231, 111, 81, 0.14);
        border-radius: 9999px;
        box-shadow: 0 10px 30px -4px rgba(231, 111, 81, 0.08), 0 2px 8px -1px rgba(0, 0, 0, 0.03);
        transition: box-shadow 0.3s ease, border-color 0.3s ease, transform 0.3s ease;
      }

      .site-header:hover {
        box-shadow: 0 14px 36px -4px rgba(231, 111, 81, 0.14), 0 4px 12px -1px rgba(0, 0, 0, 0.05);
        border-color: rgba(231, 111, 81, 0.25);
      }

      .logo-group {
        display: flex;
        align-items: center;
        gap: 12px;
        padding: 4px 8px;
        border-radius: 9999px;
        transition: opacity 0.2s ease;
      }

      .logo-group:hover {
        opacity: 0.9;
      }

      .logo-badge-icon {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 40px;
        height: 40px;
        border-radius: 50%;
        background: linear-gradient(135deg, #E76F51, #F4845F);
        box-shadow: 0 4px 12px rgba(231, 111, 81, 0.3);
        border: 2px solid #FFFFFF;
        overflow: hidden;
        flex-shrink: 0;
      }

      .logo-turtle-img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        border-radius: 50%;
      }

      .logo-text-wrap {
        display: flex;
        flex-direction: column;
      }

      .logo-title {
        font-size: 1.18rem;
        font-weight: 800;
        color: var(--color-text-title);
        letter-spacing: 0.3px;
        line-height: 1.2;
      }

      .logo-subtitle {
        font-size: 0.72rem;
        font-weight: 700;
        color: var(--color-primary);
        letter-spacing: 0.6px;
      }

      /* Center Animated Tabs */
      .smooth-tabs-nav {
        position: relative;
        display: inline-flex;
        align-items: center;
        background: rgba(231, 111, 81, 0.06);
        padding: 4px;
        border-radius: 9999px;
        border: 1px solid rgba(231, 111, 81, 0.08);
      }

      .smooth-tab-pill {
        position: absolute;
        top: 4px;
        left: 0;
        height: calc(100% - 8px);
        background: #FFFFFF;
        border-radius: 9999px;
        box-shadow: 0 4px 14px rgba(231, 111, 81, 0.15), 0 1px 3px rgba(0, 0, 0, 0.04);
        pointer-events: none;
        z-index: 1;
        transition: transform 0.35s cubic-bezier(0.34, 1.56, 0.64, 1), width 0.35s cubic-bezier(0.34, 1.56, 0.64, 1), opacity 0.2s ease;
        opacity: 0;
      }

      .smooth-tab-link {
        position: relative;
        z-index: 2;
        padding: 8px 18px;
        font-size: 0.92rem;
        font-weight: 700;
        color: var(--color-text-muted);
        text-decoration: none;
        border-radius: 9999px;
        transition: color 0.2s ease;
        white-space: nowrap;
        user-select: none;
      }

      .smooth-tab-link:hover {
        color: var(--color-primary);
      }

      .smooth-tab-link.active {
        color: var(--color-primary);
        font-weight: 800;
      }

      /* Right CTA Button */
      .header-cta-btn {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        background: linear-gradient(135deg, var(--color-primary), var(--color-secondary));
        color: #FFFFFF;
        padding: 9px 20px;
        border-radius: 9999px;
        font-size: 0.9rem;
        font-weight: 700;
        text-decoration: none;
        box-shadow: 0 4px 14px rgba(231, 111, 81, 0.32);
        transition: transform 0.2s ease, box-shadow 0.2s ease, filter 0.2s ease;
        white-space: nowrap;
      }

      .header-cta-btn:hover {
        transform: translateY(-2px);
        box-shadow: 0 6px 20px rgba(231, 111, 81, 0.42);
        filter: brightness(1.05);
      }

      .header-cta-btn:active {
        transform: scale(0.97);
      }

      /* Footer */
      .site-footer {
        padding: 48px 0 36px;
        border-top: 1.5px solid var(--color-border);
        text-align: center;
        color: var(--color-text-muted);
        font-size: 0.92rem;
      }

      .footer-badge-pill {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        background: var(--color-primary-light);
        color: var(--color-primary);
        font-weight: 700;
        font-size: 0.84rem;
        padding: 6px 14px;
        border-radius: 9999px;
        margin-bottom: 14px;
      }

      .footer-copy {
        margin-top: 10px;
        font-size: 0.85rem;
        color: #8C9CAE;
        max-width: 680px;
        margin-left: auto;
        margin-right: auto;
      }

      /* Responsive */
      @media (max-width: 900px) {
        .site-header-wrapper {
          top: 10px;
          margin-bottom: 18px;
        }
        .site-header {
          flex-wrap: wrap;
          gap: 12px;
          padding: 10px 16px;
          border-radius: 24px;
        }
        .logo-group {
          padding: 0;
        }
        .smooth-tabs-nav {
          order: 3;
          width: 100%;
          justify-content: space-around;
        }
        .header-cta-btn {
          padding: 7px 16px;
          font-size: 0.84rem;
        }
      }

      @media (max-width: 600px) {
        .smooth-tab-link {
          padding: 6px 10px;
          font-size: 0.85rem;
        }
        .logo-title {
          font-size: 1.08rem;
        }
        .header-cta-btn {
          display: none;
        }
      }
    </style>
  </head>
  <body>
    <!-- Ambient Glow Orbs -->
    <div class="ambient-glow-layer" aria-hidden="true">
      <div class="glow-orb glow-orb-1"></div>
      <div class="glow-orb glow-orb-2"></div>
      <div class="glow-orb glow-orb-3"></div>
    </div>

    <div class="layout-container">
      <div class="site-header-wrapper">
        <header class="site-header">
          <a href="/" class="logo-group">
            <div class="logo-badge-icon">
              <img src="/favicon-48x48.png" alt="黃冠智醫師海龜標誌" class="logo-turtle-img" />
            </div>
            <div class="logo-text-wrap">
              <span class="logo-title">黃冠智 醫師</span>
              <span class="logo-subtitle">豐田診所院長 · 肝膽腸胃專科</span>
            </div>
          </a>

          <nav class="smooth-tabs-nav" id="main-nav-tabs" aria-label="主要導覽">
            <div class="smooth-tab-pill" id="smooth-nav-pill"></div>
            <a href="/" class={`smooth-tab-link ${isHome ? 'active' : ''}`}>首頁</a>
            <a href="/health-column" class={`smooth-tab-link ${isHealthColumn ? 'active' : ''}`}>醫學筆記</a>
            <a href="/bowel-prep" class={`smooth-tab-link ${isBowelPrep ? 'active' : ''}`}>大腸鏡檢表單</a>
          </nav>

          <a href="/health-column" class="header-cta-btn">
            <span>瀏覽衛教專欄 ❤️</span>
            <span>→</span>
          </a>
        </header>
      </div>

      <script is:inline>
        // Smooth Animated Tabs Interactivity
        (function initSmoothTabs() {
          const nav = document.getElementById('main-nav-tabs');
          const pill = document.getElementById('smooth-nav-pill');
          if (!nav || !pill) return;

          const links = Array.from(nav.querySelectorAll('.smooth-tab-link'));
          const activeLink = nav.querySelector('.smooth-tab-link.active') || links[0];

          function movePillTo(target, smooth = true) {
            if (!target) return;
            const navRect = nav.getBoundingClientRect();
            const targetRect = target.getBoundingClientRect();
            
            const left = targetRect.left - navRect.left;
            const width = targetRect.width;

            if (!smooth) {
              pill.style.transition = 'none';
            } else {
              pill.style.transition = 'transform 0.35s cubic-bezier(0.34, 1.56, 0.64, 1), width 0.35s cubic-bezier(0.34, 1.56, 0.64, 1), opacity 0.2s ease';
            }

            pill.style.transform = `translateX(${left}px)`;
            pill.style.width = `${width}px`;
            pill.style.opacity = '1';
          }

          // Initial position
          requestAnimationFrame(() => {
            movePillTo(activeLink, false);
            setTimeout(() => movePillTo(activeLink, false), 60);
          });

          // Hover events on links
          links.forEach((link) => {
            link.addEventListener('mouseenter', () => movePillTo(link, true));
          });

          // Reset to active tab when mouse leaves nav
          nav.addEventListener('mouseleave', () => {
            movePillTo(activeLink, true);
          });

          // Handle window resize
          window.addEventListener('resize', () => {
            movePillTo(activeLink, false);
          });
        })();
      </script>

      <main>
        <slot />
      </main>

      <footer class="site-footer">
        <div class="footer-badge-pill">
          <span>🩺</span>
          <span>實證醫療 · 守護腸胃與代謝健康</span>
        </div>
        <p>© {new Date().getFullYear()} 黃冠智醫師. All rights reserved.</p>
        <p class="footer-copy">本站內容主要為個人衛教與醫療筆記，僅供參考。若有身體不適，請務必尋求專業醫師當面諮詢與評估。</p>
      </footer>
    </div>
  </body>
</html>
