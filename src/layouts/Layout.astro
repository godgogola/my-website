---
interface Props {
  title: string;
  meta_title?: string;
  description: string;
  image?: string;
  article?: boolean;
}

const {
  title,
  meta_title = '黃冠智醫師｜肝膽腸胃科·豐田診所院長｜醫學筆記與健康指南',
  description = '豐田診所院長黃冠智醫師的官方網站。提供胃食道逆流、大腸鏡檢查、肝病防治、減重門診等肝膽腸胃內科專業醫學筆記與健康指南。',
  image = '/images/og-default.jpg',
  article = false,
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site || 'https://drhuanggi.vercel.app');
---

<!doctype html>
<html lang="zh-Hant">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="48x48" href="/favicon-48x48.png" />
    <link rel="icon" type="image/png" sizes="192x192" href="/favicon-192x192.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.json" />
    <meta name="generator" content={Astro.generator} />

    <!-- Google Fonts: Plus Jakarta Sans & Poppins -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800;900&family=Poppins:wght@400;500;600;700&family=Noto+Sans+TC:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">

    <!-- Canonical URL -->
    <link rel="canonical" href={canonicalURL} />

    <!-- Primary Meta Tags -->
    <title>{meta_title}</title>
    <meta name="title" content={meta_title} />
    <meta name="description" content={description} />
    <meta name="author" content="黃冠智 醫師" />
    <meta name="keywords" content="黃冠智, 豐田診所, 肝膽腸胃科, 胃鏡, 大腸鏡, 胃食道逆流, 腹部超音波, 減重, 糖尿病, 高血壓, 慢性病管理" />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content={article ? 'article' : 'website'} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={meta_title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(image, Astro.site || 'https://drhuanggi.vercel.app')} />
    <meta property="og:locale" content="zh_TW" />
    <meta property="og:site_name" content="黃冠智醫師｜健康衛教指南" />

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={canonicalURL} />
    <meta property="twitter:title" content={meta_title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={new URL(image, Astro.site || 'https://drhuanggi.vercel.app')} />

    <!-- Structured Data (JSON-LD) -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "MedicalWebPage",
      "name": meta_title,
      "description": description,
      "url": canonicalURL,
      "author": {
        "@type": "Physician",
        "name": "黃冠智 醫師",
        "jobTitle": "院長 / 肝膽腸胃科主治醫師",
        "worksFor": {
          "@type": "MedicalClinic",
          "name": "豐田診所",
          "address": {
            "@type": "PostalAddress",
            "streetAddress": "建成路1848號",
            "addressLocality": "南區",
            "addressRegion": "台中市",
            "addressCountry": "TW"
          },
          "telephone": "+886-4-2285-0066"
        }
      }
    })} />
  </head>
  <body class="veterinary-theme">
    <!-- 背景柔光氛圍層 -->
    <div class="ambient-glow-layer" aria-hidden="true">
