  // ══════════════════════════════════════════════════════════════════════
  // 13. 環湖群山 · 雲海 · 帆船 · 小島 · 鳥瞰 · 拱橋  (Heart-Island 風格升級)
  // ══════════════════════════════════════════════════════════════════════
  const HM_UP = new THREE.Vector3(0, 1, 0);

  // 平面座標 (x,z) + 沿球心外推高度 h → 星球曲面世界座標 (與 hexToPlanet 同一套弧度公式)
  function planetPoint(x, z, h = 0, out = new THREE.Vector3()) {
    const dx = x - PLANET_CENTER.x;
    const dz = z - PLANET_CENTER.z;
    const d = Math.sqrt(dx * dx + dz * dz);
    const a = d / PLANET_RADIUS;
    const k = d > 1e-6 ? Math.sin(a) / d : 0;
    const rr = PLANET_RADIUS + h;
    return out.set(
      PLANET_CENTER.x + dx * k * rr,
      PLANET_CENTER.y + Math.cos(a) * rr,
      PLANET_CENTER.z + dz * k * rr
    );
  }
  function planetNormal(p, out = new THREE.Vector3()) {
    return out.subVectors(p, PLANET_CENTER).normalize();
  }

  // ── 小工具：平滑階梯 / 雜湊雜訊 / 分形雜訊 / 固定種子亂數 ──
  const hmSmooth = (a, b, x) => { const t = Math.min(1, Math.max(0, (x - a) / (b - a))); return t * t * (3 - 2 * t); };
  const hmHash = (ix, iy) => { const s = Math.sin(ix * 127.1 + iy * 311.7) * 43758.5453; return s - Math.floor(s); };
  function hmNoise(x, y) {
    const ix = Math.floor(x), iy = Math.floor(y);
    const fx = x - ix, fy = y - iy;
    const u = fx * fx * (3 - 2 * fx), v = fy * fy * (3 - 2 * fy);
    const a = hmHash(ix, iy), b = hmHash(ix + 1, iy), c = hmHash(ix, iy + 1), d = hmHash(ix + 1, iy + 1);
    return a + (b - a) * u + (c - a) * v + (a - b - c + d) * u * v;
  }
  function hmFbm(x, y) {
    let s = 0, amp = 0.5, f = 1;
    for (let i = 0; i < 4; i++) { s += amp * hmNoise(x * f, y * f); f *= 2.03; amp *= 0.5; }
    return s;
  }
  function hmRng(seed) {
    let a = seed | 0;
    return function () {
      a = (a + 0x6D2B79F5) | 0;
      let t = Math.imul(a ^ (a >>> 15), 1 | a);
      t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
      return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
    };
  }

  // ══════════════════════════════════════════════════════════════════════
  // 13-1. 環湖群山地形 (群島坐落在一座被山脈環抱的湖心)
  // ══════════════════════════════════════════════════════════════════════
  const MOUNTAIN_CENTER_X = PLANET_CENTER.x;
  let mountainGroup = null;

  // 湖岸半徑隨角度起伏 (不規則湖岸線)
  function shoreRadius(th) {
    return 44 + (hmFbm(Math.cos(th) * 1.8 + 11, Math.sin(th) * 1.8 + 11) - 0.47) * 12;
  }

  const _ts = { h: 0, e: 0 };
  // 取樣地形：h = 沿球心外推高度 (相對海平面)，e = 0..1 相對海拔 (著色用)
  function terrainSample(r, th) {
    const cs = Math.cos(th), sn = Math.sin(th);
    const t = (r - shoreRadius(th)) / 18;
    if (t < 0) {
      _ts.h = -0.55 + Math.max(t, -1.2) * 0.9; // 湖底緩降
      _ts.e = -1;
      return _ts;
    }
    const wx = r * cs, wz = r * sn;
    const base = hmFbm(wx * 0.07 + 3.1, wz * 0.07 + 7.7);
    const ridge = 1 - Math.abs(2 * hmFbm(wx * 0.11 + 20, wz * 0.11 + 4) - 1);
    // 面向鏡頭的前方(sn=+1)山勢較矮，後方與側邊群山高聳，不遮擋群島
    const facing = 0.24 + 0.76 * (1 - sn) / 2;
    const rise = hmSmooth(0, 1.0, t);
    const land = (6 + 11 * base + 8 * ridge * ridge) * facing * rise;
    // 山谷「碗形」補償：抵銷星球曲率造成的下陷，讓山脈像盆地邊緣般環繞升起
    const ang = r / PLANET_RADIUS;
    const bowl = PLANET_RADIUS * (1 - Math.cos(ang)) * 0.55 * hmSmooth(0, 0.9, t);
    const taper = 1 - hmSmooth(76, 104, r) * 0.5;
    _ts.h = (-0.2 + land + bowl) * taper;
    _ts.e = Math.min(1, land / 24);
    return _ts;
  }

  const TERRAIN_STOPS = [
    [-1.0, 0xa9c5b3], [0.0, 0xe4d9ac], [0.06, 0xbdd390],
    [0.35, 0xa4c57b], [0.62, 0x86ae68], [0.82, 0xa8a591], [1.0, 0xd6d4c6]
  ];
  function terrainColor(e, out) {
    if (e <= TERRAIN_STOPS[0][0]) return out.set(TERRAIN_STOPS[0][1]);
    for (let i = 1; i < TERRAIN_STOPS.length; i++) {
      if (e <= TERRAIN_STOPS[i][0]) {
        const a = TERRAIN_STOPS[i - 1], b = TERRAIN_STOPS[i];
        const t = (e - a[0]) / (b[0] - a[0]);
        return out.set(a[1]).lerp(new THREE.Color(b[1]), t);
      }
    }
    return out.set(TERRAIN_STOPS[TERRAIN_STOPS.length - 1][1]);
  }

  function createMountainRing() {
    mountainGroup = new THREE.Group();
    const rnd = hmRng(20261024);

    // 徑向分層：湖心稀疏、山腳到山腰加密
    const radii = [];
    for (let r = 2; r < 36; r += 6) radii.push(r);
    for (let r = 36; r < 80; r += 1.9) radii.push(r);
    for (let r = 80; r <= 104; r += 3) radii.push(r);
    const NR = radii.length;
    const NA = 192;

    const gridP = [], gridE = [];
    for (let i = 0; i < NR; i++) {
      const rowP = [], rowE = [];
      for (let j = 0; j < NA; j++) {
        const th = (j / NA) * Math.PI * 2;
        const s = terrainSample(radii[i], th);
        rowP.push(planetPoint(MOUNTAIN_CENTER_X + radii[i] * Math.cos(th), radii[i] * Math.sin(th), s.h));
        rowE.push(s.e);
      }
      gridP.push(rowP);
      gridE.push(rowE);
    }

    const pos = [], col = [];
    const tmpC = new THREE.Color();
    const pushTri = (A, B, C, eA, eB, eC) => {
      pos.push(A.x, A.y, A.z, B.x, B.y, B.z, C.x, C.y, C.z);
      terrainColor((eA + eB + eC) / 3, tmpC);
      tmpC.offsetHSL(0, 0, (rnd() - 0.5) * 0.07);
      for (let k = 0; k < 3; k++) col.push(tmpC.r, tmpC.g, tmpC.b);
    };
    for (let i = 0; i < NR - 1; i++) {
      for (let j = 0; j < NA; j++) {
        const j2 = (j + 1) % NA;
        const a = gridP[i][j], b = gridP[i][j2], c = gridP[i + 1][j], d = gridP[i + 1][j2];
        const ea = gridE[i][j], eb = gridE[i][j2], ec = gridE[i + 1][j], ed = gridE[i + 1][j2];
        pushTri(a, b, c, ea, eb, ec);
        pushTri(b, d, c, eb, ed, ec);
      }
    }
    const geo = new THREE.BufferGeometry();
    geo.setAttribute('position', new THREE.Float32BufferAttribute(pos, 3));
    geo.setAttribute('color', new THREE.Float32BufferAttribute(col, 3));
    geo.computeVertexNormals();
    const terrainMat = new THREE.MeshStandardMaterial({ vertexColors: true, flatShading: true, roughness: 0.96, metalness: 0 });
    const terrainMesh = new THREE.Mesh(geo, terrainMat);
    terrainMesh.receiveShadow = false;
    mountainGroup.add(terrainMesh);

    // ── 針葉松林 (InstancedMesh) ──
    const pineA = new THREE.ConeGeometry(0.72, 1.35, 6); pineA.translate(0, 0.95, 0);
    const pineB = new THREE.ConeGeometry(0.52, 1.1, 6); pineB.translate(0, 1.65, 0);
    const trunk = new THREE.CylinderGeometry(0.09, 0.12, 0.5, 5); trunk.translate(0, 0.25, 0);
    const pineGeo = mergeGeometries([pineA, pineB, trunk].map(g => { const n = g.toNonIndexed(); n.deleteAttribute('uv'); return n; }));
    const roundGeo = new THREE.IcosahedronGeometry(0.62, 0); roundGeo.translate(0, 0.95, 0);
    const treeMat = new THREE.MeshStandardMaterial({ color: 0xffffff, flatShading: true, roughness: 0.92 });
    const PINE_MAX = 1100, ROUND_MAX = 300;
    const pines = new THREE.InstancedMesh(pineGeo, treeMat, PINE_MAX);
    const rounds = new THREE.InstancedMesh(roundGeo, treeMat, ROUND_MAX);
    pines.frustumCulled = false; rounds.frustumCulled = false;
    let np = 0, nr = 0;
    const m4 = new THREE.Matrix4(), q = new THREE.Quaternion(), qy = new THREE.Quaternion();
    const sc = new THREE.Vector3(), pv = new THREE.Vector3(), nv = new THREE.Vector3();
    const cA = new THREE.Color(0x4a7a4a), cB = new THREE.Color(0x72a355), cC = new THREE.Color(0x8cc05c), cD = new THREE.Color(0xb7d36a), cTmp = new THREE.Color();

    for (let tries = 0; tries < 16000 && (np < PINE_MAX || nr < ROUND_MAX); tries++) {
      const th = rnd() * Math.PI * 2;
      const r = shoreRadius(th) + 0.6 + Math.pow(rnd(), 1.25) * 46;
      if (r > 98) continue;
      const s = terrainSample(r, th);
      if (s.e < 0.025 || s.e > 0.66) continue;
      const wx = r * Math.cos(th), wz = r * Math.sin(th);
      if (hmFbm(wx * 0.17 + 50, wz * 0.17 + 50) < 0.43) continue; // 樹叢聚落
      planetPoint(MOUNTAIN_CENTER_X + wx, wz, s.h - 0.1, pv);
      planetNormal(pv, nv);
      q.setFromUnitVectors(HM_UP, nv);
      qy.setFromAxisAngle(HM_UP, rnd() * Math.PI * 2);
      q.multiply(qy);
      const size = 0.75 + rnd() * 0.95;
      sc.set(size, size * (0.85 + rnd() * 0.5), size);
      m4.compose(pv, q, sc);
      const isRound = s.e < 0.2 && nr < ROUND_MAX && rnd() < 0.3;
      if (isRound) {
        rounds.setMatrixAt(nr, m4);
        rounds.setColorAt(nr, cTmp.copy(cC).lerp(cD, rnd()));
        nr++;
      } else if (np < PINE_MAX) {
        pines.setMatrixAt(np, m4);
        pines.setColorAt(np, cTmp.copy(cA).lerp(cB, rnd()));
        np++;
      }
    }
    pines.count = np; rounds.count = nr;
    pines.instanceMatrix.needsUpdate = true; rounds.instanceMatrix.needsUpdate = true;
    if (pines.instanceColor) pines.instanceColor.needsUpdate = true;
    if (rounds.instanceColor) rounds.instanceColor.needsUpdate = true;
    mountainGroup.add(pines, rounds);

    // ── 山坡紅頂小屋 ──
    const wallMat = new THREE.MeshStandardMaterial({ color: 0xf5ecd7, roughness: 0.8, flatShading: true });
    const roofMat = new THREE.MeshStandardMaterial({ color: 0xd9603b, roughness: 0.7, flatShading: true });
    for (let i = 0, placed = 0; i < 400 && placed < 11; i++) {
      const th = rnd() * Math.PI * 2;
      if (Math.sin(th) > 0.55) continue; // 避開鏡頭前緣
      const r = shoreRadius(th) + 1.5 + rnd() * 9;
      const s = terrainSample(r, th);
      if (s.e < 0.02 || s.e > 0.3) continue;
      const house = new THREE.Group();
      const walls = new THREE.Mesh(new THREE.BoxGeometry(0.95, 0.72, 0.8), wallMat);
      walls.position.y = 0.36;
      const roof = new THREE.Mesh(new THREE.ConeGeometry(0.82, 0.62, 4), roofMat);
      roof.rotation.y = Math.PI / 4; roof.position.y = 1.02;
      house.add(walls, roof);
      planetPoint(MOUNTAIN_CENTER_X + r * Math.cos(th), r * Math.sin(th), s.h - 0.05, house.position);
      planetNormal(house.position, nv);
      house.quaternion.setFromUnitVectors(HM_UP, nv).multiply(qy.setFromAxisAngle(HM_UP, rnd() * Math.PI * 2));
      const hs = 0.9 + rnd() * 0.6;
      house.scale.setScalar(hs);
      mountainGroup.add(house);
      placed++;
    }
    scene.add(mountainGroup);
  }

  // ══════════════════════════════════════════════════════════════════════
  // 13-2. 湖心小沙洲與燈塔
  // ══════════════════════════════════════════════════════════════════════
  function createIslets() {
    const rnd = hmRng(777);
    const grp = new THREE.Group();
    const sandMat = new THREE.MeshStandardMaterial({ color: 0xe8dcae, roughness: 0.9, flatShading: true });
    const grassMat = new THREE.MeshStandardMaterial({ color: 0x9fc872, roughness: 0.9, flatShading: true });
    const trunkMat = new THREE.MeshStandardMaterial({ color: 0x7a5a3c, roughness: 0.9 });
    const leafMat = new THREE.MeshStandardMaterial({ color: 0x4f8a45, roughness: 0.9, flatShading: true });
    const redMat = new THREE.MeshStandardMaterial({ color: 0xd9603b, roughness: 0.6, flatShading: true });
    const whiteMat = new THREE.MeshStandardMaterial({ color: 0xf8f4ea, roughness: 0.6, flatShading: true });
    const N = 7;
    for (let i = 0; i < N; i++) {
      const th = (i / N) * Math.PI * 2 + 0.35 + rnd() * 0.3;
      let r = 33.6 + rnd() * 1.9;
      // 若沙洲落在島嶼上 (群島重新佈局後)，就往外海推開
      const nearIsland = (rr) => ISLAND_DATA.some((d) => {
        const f = hexFlat(d.q, d.r, d.realm);
        return Math.hypot(MOUNTAIN_CENTER_X + rr * Math.cos(th) - f.x, rr * Math.sin(th) - f.z) < HEX_RADIUS + 3.2;
      });
      for (let guard = 0; guard < 12 && nearIsland(r); guard++) r += 1.5;
      const rad = 1.15 + rnd() * 0.9;
      const g = new THREE.Group();
      const p = planetPoint(MOUNTAIN_CENTER_X + r * Math.cos(th), r * Math.sin(th), 0);
      g.position.copy(p);
      g.quaternion.setFromUnitVectors(HM_UP, planetNormal(p));
      const sand = new THREE.Mesh(new THREE.CylinderGeometry(rad * 0.92, rad * 1.15, 0.8, 7), sandMat);
      sand.position.y = 0.05;
      const grass = new THREE.Mesh(new THREE.CylinderGeometry(rad * 0.78, rad * 0.88, 0.2, 7), grassMat);
      grass.position.y = 0.52;
      g.add(sand, grass);
      if (i === 2) {
        // 紅白燈塔 (夜間點亮)
        const base = new THREE.Mesh(new THREE.CylinderGeometry(0.34, 0.44, 0.7, 8), whiteMat); base.position.y = 0.95;
        const mid = new THREE.Mesh(new THREE.CylinderGeometry(0.27, 0.34, 0.6, 8), redMat); mid.position.y = 1.6;
        const top = new THREE.Mesh(new THREE.CylinderGeometry(0.2, 0.27, 0.5, 8), whiteMat); top.position.y = 2.15;
        const lamp = new THREE.Mesh(new THREE.SphereGeometry(0.2, 10, 10), nightGlowMaterial); lamp.position.y = 2.6;
        const cap = new THREE.Mesh(new THREE.ConeGeometry(0.28, 0.35, 8), redMat); cap.position.y = 2.95;
        g.add(base, mid, top, lamp, cap);
      } else {
        const trees = 1 + Math.floor(rnd() * 3);
        for (let k = 0; k < trees; k++) {
          const a = rnd() * Math.PI * 2, d = rnd() * rad * 0.45;
          const tr = new THREE.Mesh(new THREE.CylinderGeometry(0.05, 0.07, 0.4, 5), trunkMat);
          const lf = new THREE.Mesh(new THREE.ConeGeometry(0.34, 0.9, 6), leafMat);
          tr.position.set(Math.cos(a) * d, 0.82, Math.sin(a) * d);
          lf.position.set(Math.cos(a) * d, 1.4, Math.sin(a) * d);
          const s = 0.8 + rnd() * 0.6; tr.scale.setScalar(s); lf.scale.setScalar(s);
          g.add(tr, lf);
        }
      }
      grp.add(g);
    }
    scene.add(grp);
  }

  // ══════════════════════════════════════════════════════════════════════
  // 13-3. 雲海 (飄在群山之上，緩緩生成與消散；刻意避開鏡頭前方以免遮擋島嶼)
  // ══════════════════════════════════════════════════════════════════════
  const CLOUD_ARC_START = -3.0;
  const CLOUD_ARC_LEN = 2.85;
  function createLowPolyClouds() {
    cloudsGroup = new THREE.Group();
    const rnd = hmRng(4242);
    const cloudMat = new THREE.MeshStandardMaterial({
      color: 0xffffff, roughness: 1, transparent: true, opacity: 0.94,
      emissive: 0xffffff, emissiveIntensity: 0.14
    });
    const puffGeo = new THREE.IcosahedronGeometry(1, 2);
    const COUNT = 12;
    for (let c = 0; c < COUNT; c++) {
      const cloud = new THREE.Group();
      const puffs = 5 + Math.floor(rnd() * 4);
      for (let p = 0; p < puffs; p++) {
        const mid = 1 - Math.abs(p - (puffs - 1) / 2) / (puffs / 2);
        const rad = 1.0 + mid * 0.9 + rnd() * 0.4;
        const puff = new THREE.Mesh(puffGeo, cloudMat);
        puff.position.set((p - (puffs - 1) / 2) * 1.55 + (rnd() - 0.5) * 0.5, mid * 0.5 + (rnd() - 0.5) * 0.3, (rnd() - 0.5) * 1.1);
        puff.scale.set(rad * 1.25, rad * 0.78, rad);
        cloud.add(puff);
      }
      cloud.userData = {
        p0: rnd(),
        speed: 0.0030 + rnd() * 0.0030,
        r: 40 + rnd() * 26,
        lift: 5 + rnd() * 9,
        size: 1.0 + rnd() * 0.9
      };
      cloudsGroup.add(cloud);
    }
    scene.add(cloudsGroup);
  }

  const _cloudN = new THREE.Vector3();
  function updateCloudDrift(t) {
    if (!cloudsGroup) return;
    cloudsGroup.children.forEach((cloud) => {
      const u = cloud.userData;
      const p = (u.p0 + t * u.speed) % 1;
      const th = CLOUD_ARC_START + p * CLOUD_ARC_LEN;
      const s = terrainSample(u.r, th);
      const h = Math.max(s.h, 0) + u.lift;
      planetPoint(MOUNTAIN_CENTER_X + u.r * Math.cos(th), u.r * Math.sin(th), h, cloud.position);
      cloud.quaternion.setFromUnitVectors(HM_UP, planetNormal(cloud.position, _cloudN));
      const fade = hmSmooth(0, 0.1, p) * hmSmooth(0, 0.1, 1 - p);
      cloud.scale.setScalar(Math.max(0.001, u.size * fade));
    });
  }

  // ══════════════════════════════════════════════════════════════════════
  // 13-4. 湖上帆船
  // ══════════════════════════════════════════════════════════════════════
  let boatsGroup = null;
  function createBoats() {
    boatsGroup = new THREE.Group();
    const rnd = hmRng(99);
    const hullColors = [0xdb6a41, 0x2a9d8f, 0xf4a261, 0x5b8def, 0xe76f51];
    const sailShape = new THREE.Shape();
    sailShape.moveTo(0, 0); sailShape.lineTo(0.62, 0); sailShape.lineTo(0, 1.15); sailShape.lineTo(0, 0);
    const sailGeo = new THREE.ShapeGeometry(sailShape);
    const sailMat = new THREE.MeshStandardMaterial({ color: 0xfffaf0, side: THREE.DoubleSide, roughness: 0.8 });
    const mastMat = new THREE.MeshStandardMaterial({ color: 0x6b4f3a, roughness: 0.8 });
    for (let i = 0; i < 5; i++) {
      const boat = new THREE.Group();
      const hull = new THREE.Mesh(new THREE.BoxGeometry(1.25, 0.22, 0.46),
        new THREE.MeshStandardMaterial({ color: hullColors[i % hullColors.length], roughness: 0.6, flatShading: true }));
      hull.position.y = 0.11;
      const bow = new THREE.Mesh(new THREE.ConeGeometry(0.23, 0.35, 4), hull.material);
      bow.rotation.z = -Math.PI / 2; bow.rotation.y = Math.PI / 4; bow.position.set(0.8, 0.11, 0);
      const mast = new THREE.Mesh(new THREE.CylinderGeometry(0.025, 0.03, 1.4, 5), mastMat);
      mast.position.set(0.05, 0.8, 0);
      const sail = new THREE.Mesh(sailGeo, sailMat);
      sail.position.set(0.07, 0.3, 0);
      sail.rotation.y = Math.PI / 2;
      boat.add(hull, bow, mast, sail);
      boat.scale.setScalar(0.85 + rnd() * 0.4);
      boat.userData = {
        r: 37.4 + rnd() * 1.6,
        a: rnd() * Math.PI * 2,
        speed: (0.0007 + rnd() * 0.0006) * (i % 2 ? 1 : -1),
        bob: rnd() * 6
      };
      boatsGroup.add(boat);
    }
    scene.add(boatsGroup);
  }

  const _boatQn = new THREE.Quaternion(), _boatQy = new THREE.Quaternion(), _boatN = new THREE.Vector3();
  function updateBoats(t) {
    if (!boatsGroup) return;
    boatsGroup.children.forEach((boat) => {
      const u = boat.userData;
      u.a += u.speed;
      const x = MOUNTAIN_CENTER_X + u.r * Math.cos(u.a), z = u.r * Math.sin(u.a);
      planetPoint(x, z, 0.03 + Math.sin(t * 1.6 + u.bob) * 0.05, boat.position);
      _boatQn.setFromUnitVectors(HM_UP, planetNormal(boat.position, _boatN));
      const dir = Math.sign(u.speed);
      const fx = -Math.sin(u.a) * dir, fz = Math.cos(u.a) * dir;
      _boatQy.setFromAxisAngle(HM_UP, Math.atan2(-fz, fx));
      boat.quaternion.copy(_boatQn).multiply(_boatQy);
    });
  }

  // ══════════════════════════════════════════════════════════════════════
  // 13-5. 彩色拱橋 (石橋墩 + 拼花橋面 + 雙層漸層護欄 + 夜間路燈)
  // ══════════════════════════════════════════════════════════════════════
  function paintGeo(geo, hex, x = 0, y = 0, z = 0, rotZ = 0) {
    const g = geo.index ? geo.toNonIndexed() : geo.clone();
    g.deleteAttribute('uv');
    if (rotZ) g.rotateZ(rotZ);
    g.translate(x, y, z);
    const c = new THREE.Color(hex);
    const n = g.attributes.position.count;
    const arr = new Float32Array(n * 3);
    for (let i = 0; i < n; i++) { arr[i * 3] = c.r; arr[i * 3 + 1] = c.g; arr[i * 3 + 2] = c.b; }
    g.setAttribute('color', new THREE.BufferAttribute(arr, 3));
    return g;
  }

  function buildScenicBridges(bridgeList) {
    const deckMat = new THREE.MeshStandardMaterial({ vertexColors: true, roughness: 0.76, metalness: 0.03, flatShading: true });
    const foamMat = new THREE.MeshBasicMaterial({ color: 0xffffff, transparent: true, opacity: 0.45, depthWrite: false });
    const WATER_Y = -(HEX_HEIGHT + 0.06 + 0.18) + 0.08;

    // 圖二溫暖明亮的蜜糖原木色系
    const honeyDeckHex = 0xd89c62;  // 蜜糖原木主色 (明亮溫暖)
    const woodDarkHex  = 0xba7c42;  // 結構木樑與直櫺扶手立柱
    const beamUnderHex = 0x9e6230;  // 橋底弧形拱肋
    const finialCollar = 0xdca670;  // 寶頂柱頭基座
    const finialBall   = 0xf3c58e;  // 寶頂圓球 (圓潤精緻)
    const stoneStepHex = 0xc6874a;  // 兩島接合處木踏板

    // 棧道與踏石專屬色彩
    const rusticCedarHex = 0xab7b48; // 棧道杉木色
    const rusticDarkWood = 0x7c522a; // 棧道暗木色
    const stoneCol1      = 0x8c8275; // 溪石暖灰
    const stoneCol2      = 0x72695d; // 溪石深灰
    const stoneCol3      = 0x9e9488; // 溪石淺斑

    bridgeList.forEach(([idA, idB, bridgeType]) => {
      const objA = islandObjectsMap.get(idA);
      const objB = islandObjectsMap.get(idB);
      if (!objA || !objB) return;
      const dA = objA.userData.islandData, dB = objB.userData.islandData;
      const pA = objA.position, pB = objB.position;

      const mid = new THREE.Vector3().addVectors(pA, pB).multiplyScalar(0.5);
      const radialDir = new THREE.Vector3().subVectors(mid, PLANET_CENTER).normalize();
      const dist = pA.distanceTo(pB);
      // 橋體基底高度置於島嶼表面，兩端牢固平穩搭接
      mid.copy(PLANET_CENTER).addScaledVector(radialDir, PLANET_RADIUS + HEX_HEIGHT + 0.02);

      const bridgeGroup = new THREE.Group();
      bridgeGroup.position.copy(mid);
      const forward = new THREE.Vector3().subVectors(pB, pA).normalize();
      const right = new THREE.Vector3().crossVectors(radialDir, forward).normalize();
      const realUp = new THREE.Vector3().crossVectors(forward, right).normalize();
      bridgeGroup.quaternion.setFromRotationMatrix(new THREE.Matrix4().makeBasis(forward, realUp, right));

      // 水道大幅加寬至 4.6 單位，橋長約 5.8 單位，覆蓋兩端島緣各 0.6 單位
      const L = Math.max(3.2, dist - 2 * HEX_APOTHEM + 1.25);
      const parts = [];
      const foamParts = [];
      const pts = [];

      if (bridgeType === 'arch') {
        // ════════════════════════════════════════════════════════════
        // 類型 1：【圖二】日式蜜糖木拱橋 (Zen Arched Bridge)
        // ════════════════════════════════════════════════════════════
        const W = 0.72;
        const T = 0.08;
        const rise = 0.52; // 優美舒展的大拱弧
        const SEGS = 18;
        const segL = (L / SEGS) * 1.05;

        // 1. 弧形原木橋面與底層支撐弧肋
        for (let i = 0; i < SEGS; i++) {
          const u = (i + 0.5) / SEGS - 0.5;
          const x = u * L;
          const y = rise * (1 - 4 * u * u);
          const tangent = -8 * rise * u / L;
          const rotZ = Math.atan(tangent);

          const col = (i % 2 === 0) ? honeyDeckHex : woodDarkHex;
          parts.push(paintGeo(new THREE.BoxGeometry(segL, T, W), col, x, y - T / 2, 0, rotZ));

          // 兩側底層支撐弧樑
          for (const side of [-1, 1]) {
            parts.push(paintGeo(new THREE.BoxGeometry(segL, 0.07, 0.055), beamUnderHex, x, y - T - 0.035, side * (W / 2 - 0.035), rotZ));
          }

          // 兩側弧形扶手
          for (const side of [-1, 1]) {
            const z = side * (W / 2 + 0.025);
            parts.push(paintGeo(new THREE.BoxGeometry(segL, 0.05, 0.06), honeyDeckHex, x, y + 0.36, z, rotZ));
          }
        }

        // 2. 四角方形立柱與寶頂柱頭 (擬寶珠)
        for (const u of [-0.48, 0.48]) {
          const x = u * L;
          const y = rise * (1 - 4 * u * u);
          for (const side of [-1, 1]) {
            const z = side * (W / 2 + 0.025);
            parts.push(paintGeo(new THREE.BoxGeometry(0.09, 0.48, 0.09), woodDarkHex, x, y + 0.20, z));
            parts.push(paintGeo(new THREE.BoxGeometry(0.13, 0.04, 0.13), finialCollar, x, y + 0.45, z));
            parts.push(paintGeo(new THREE.SphereGeometry(0.055, 8, 8), finialBall, x, y + 0.51, z));
          }
        }

        // 3. 均勻排列的直櫺扶手立柱
        const balusterCount = 7;
        for (let k = 1; k <= balusterCount; k++) {
          const u = (k / (balusterCount + 1)) - 0.5;
          const x = u * L;
          const y_deck = rise * (1 - 4 * u * u);
          const y_rail = y_deck + 0.36;
          const h = y_rail - y_deck;
          for (const side of [-1, 1]) {
            const z = side * (W / 2 + 0.025);
            parts.push(paintGeo(new THREE.BoxGeometry(0.045, h, 0.045), woodDarkHex, x, y_deck + h / 2, z));
          }
        }

        // 4. 兩端平滑登橋木踏階
        for (const side of [-1, 1]) {
          const endX = side * (L / 2 - 0.15);
          parts.push(paintGeo(new THREE.BoxGeometry(0.42, 0.07, W * 1.15), stoneStepHex, endX, 0.03, 0));
        }

        // 5. 橋下水景：睡蓮荷葉與粉紅荷花
        for (let li = 0; li < 4; li++) {
          const lx = (li - 1.5) * 0.75;
          const lz = ((li % 2) * 2 - 1) * (W / 2 + 0.32);
          const lily = new THREE.CircleGeometry(0.18 + (li % 3) * 0.04, 8).toNonIndexed();
          lily.rotateX(-Math.PI / 2);
          lily.translate(lx, WATER_Y + 0.02, lz);
          parts.push(paintGeo(lily, 0x3d7e35, 0, 0, 0));

          if (li % 2 === 0) {
            const flower = new THREE.SphereGeometry(0.05, 6, 6).toNonIndexed();
            flower.translate(lx + 0.03, WATER_Y + 0.07, lz + 0.02);
            parts.push(paintGeo(flower, 0xf472b6, 0, 0, 0));
          }
        }

        // 6. 水下加固木樁
        for (const u of [-0.32, 0.32]) {
          const x = u * L;
          const y = rise * (1 - 4 * u * u);
          const top = y - T - 0.05;
          const bottom = WATER_Y - 0.45;
          const h = top - bottom;
          for (const side of [-1, 1]) {
            const pz = side * (W / 2 - 0.04);
            parts.push(paintGeo(new THREE.CylinderGeometry(0.05, 0.06, h, 6), beamUnderHex, x, (top + bottom) / 2, pz));
          }
          const ring = new THREE.RingGeometry(0.20, 0.46, 12).toNonIndexed();
          ring.rotateX(-Math.PI / 2);
          ring.translate(x, WATER_Y, 0);
          foamParts.push(ring);
        }

        // 軌跡路徑
        const WALK_N = 12;
        for (let i = 0; i <= WALK_N; i++) {
          const u = i / WALK_N - 0.5;
          const y = rise * (1 - 4 * u * u);
          pts.push(new THREE.Vector3(u * L, y + 0.03, 0).applyMatrix4(bridgeGroup.matrix));
        }

      } else if (bridgeType === 'boardwalk') {
        // ════════════════════════════════════════════════════════════
        // 類型 2：【次要通道】水上木棧道 (Wooden Boardwalk)
        // ════════════════════════════════════════════════════════════
        const W = 0.62;
        const T = 0.065;
        const boardY = 0.06;
        const SEGS = 14;
        const segL = (L / SEGS) * 1.05;

        // 棧道原木拼板
        for (let i = 0; i < SEGS; i++) {
          const u = (i + 0.5) / SEGS - 0.5;
          const x = u * L;
          const col = (i % 2 === 0) ? rusticCedarHex : rusticDarkWood;
          parts.push(paintGeo(new THREE.BoxGeometry(segL, T, W), col, x, boardY - T / 2, 0));
        }

        // 兩側通透低矮護欄
        for (const side of [-1, 1]) {
          const z = side * (W / 2 + 0.02);
          for (let p = -3; p <= 3; p++) {
            const px = (p / 3.5) * (L / 2);
            parts.push(paintGeo(new THREE.BoxGeometry(0.045, 0.28, 0.045), rusticDarkWood, px, boardY + 0.14, z));
          }
          parts.push(paintGeo(new THREE.BoxGeometry(L * 0.96, 0.035, 0.04), rusticCedarHex, 0, boardY + 0.26, z));
        }

        // 入水木樁與泡沫
        for (const px of [-L * 0.32, 0, L * 0.32]) {
          const top = boardY - T;
          const bottom = WATER_Y - 0.45;
          const h = top - bottom;
          for (const side of [-1, 1]) {
            parts.push(paintGeo(new THREE.CylinderGeometry(0.045, 0.05, h, 6), rusticDarkWood, px, (top + bottom) / 2, side * (W / 2 - 0.03)));
          }
          const ring = new THREE.RingGeometry(0.16, 0.38, 10).toNonIndexed();
          ring.rotateX(-Math.PI / 2);
          ring.translate(px, WATER_Y, 0);
          foamParts.push(ring);
        }

        // 漂浮荷葉
        for (let li = 0; li < 3; li++) {
          const lx = (li - 1) * 1.1;
          const lz = ((li % 2) * 2 - 1) * (W / 2 + 0.28);
          const lily = new THREE.CircleGeometry(0.16, 8).toNonIndexed();
          lily.rotateX(-Math.PI / 2);
          lily.translate(lx, WATER_Y + 0.02, lz);
          parts.push(paintGeo(lily, 0x3d7e35, 0, 0, 0));
        }

        // 軌跡路徑
        const WALK_N = 8;
        for (let i = 0; i <= WALK_N; i++) {
          const u = i / WALK_N - 0.5;
          pts.push(new THREE.Vector3(u * L, boardY + 0.03, 0).applyMatrix4(bridgeGroup.matrix));
        }

      } else {
        // ════════════════════════════════════════════════════════════
        // 類型 3：【自然通道】日式庭園踏水石階 (Stepping Stones)
        // ════════════════════════════════════════════════════════════
        const stoneCount = 7;
        const stoneStepY = WATER_Y + 0.16;

        for (let s = 0; s < stoneCount; s++) {
          const u = (s + 0.5) / stoneCount - 0.5;
          const sx = u * (L * 0.88);
          const sz = Math.sin(s * 1.7) * 0.22;
          const col = (s % 3 === 0) ? stoneCol1 : (s % 3 === 1 ? stoneCol2 : stoneCol3);

          const r = 0.38 + (s % 2) * 0.06;
          const stoneGeo = new THREE.DodecahedronGeometry(r, 0).toNonIndexed();
          stoneGeo.scale(1.0, 0.32, 1.0);
          parts.push(paintGeo(stoneGeo, col, sx, stoneStepY, sz));

          // 踏石邊緣水波漣漪
          const ring = new THREE.RingGeometry(r * 0.9, r * 1.35, 12).toNonIndexed();
          ring.rotateX(-Math.PI / 2);
          ring.translate(sx, WATER_Y + 0.01, sz);
          foamParts.push(ring);

          // 踏石間睡蓮與粉紅白花
          if (s % 2 === 1) {
            const lily = new THREE.CircleGeometry(0.17, 8).toNonIndexed();
            lily.rotateX(-Math.PI / 2);
            lily.translate(sx, WATER_Y + 0.02, -sz * 1.4);
            parts.push(paintGeo(lily, 0x3d7e35, 0, 0, 0));

            const fl = new THREE.SphereGeometry(0.045, 6, 6).toNonIndexed();
            fl.translate(sx + 0.02, WATER_Y + 0.06, -sz * 1.4 + 0.02);
            parts.push(paintGeo(fl, 0xfce7f3, 0, 0, 0));
          }

          // 踏石路徑點
          pts.push(new THREE.Vector3(sx, stoneStepY + 0.12, sz).applyMatrix4(bridgeGroup.matrix));
        }

        // 首尾平滑過渡島面階梯
        for (const side of [-1, 1]) {
          const endX = side * (L / 2 - 0.2);
          const stepGeo = new THREE.DodecahedronGeometry(0.42, 0).toNonIndexed();
          stepGeo.scale(1.1, 0.28, 1.1);
          parts.push(paintGeo(stepGeo, stoneCol1, endX, 0.03, 0));
        }
      }

      const deckMesh = new THREE.Mesh(mergeGeometries(parts), deckMat);
      deckMesh.castShadow = true;
      deckMesh.receiveShadow = true;
      bridgeGroup.add(deckMesh);
      if (foamParts.length > 0) {
        bridgeGroup.add(new THREE.Mesh(mergeGeometries(foamParts), foamMat));
      }

      bridgeGroup.userData = { realm: dA.realm, pair: [idA, idB], type: bridgeType };
      bridgesGroup.add(bridgeGroup);

      // 登記通行路徑 (過橋路網)
      bridgeGroup.updateMatrix();
      if (!bridgeLinks.has(idA)) bridgeLinks.set(idA, []);
      if (!bridgeLinks.has(idB)) bridgeLinks.set(idB, []);
      bridgeLinks.get(idA).push({ to: idB, points: pts });
      bridgeLinks.get(idB).push({ to: idA, points: pts.slice().reverse() });
    });
  }

  // ══════════════════════════════════════════════════════════════════════
  // 13-6. 鳥瞰模式 (升空俯瞰環湖群山，並緩慢環繞)
  // ══════════════════════════════════════════════════════════════════════
  let isBirdView = false;
  function setBirdView(on) {
    isBirdView = on;
    const btn = document.getElementById('birdViewBtn');
    if (btn) btn.classList.toggle('active', on);
    viewportBox.classList.toggle('bird-mode', on);
    if (on) {
      activeIsland = null;
      closeDetailCard();
      islandObjectsMap.forEach((obj) => { if (obj.userData.selectionRing) obj.userData.selectionRing.material.opacity = 0; });
      document.querySelectorAll('.sidebar-island-row').forEach(r => r.classList.remove('active'));
      startCameraFlight(new THREE.Vector3(2.1, 112, 34), new THREE.Vector3(2.1, -4, 3), 2200);
    } else {
      controls.autoRotate = false;
      startCameraFlight(new THREE.Vector3(2.1, 28, 48), new THREE.Vector3(2.1, 3.5, 0), 1600);
    }
  }
  function exitBirdViewSilently() {
    if (!isBirdView) return;
    isBirdView = false;
    controls.autoRotate = false;
    viewportBox.classList.remove('bird-mode');
    const btn = document.getElementById('birdViewBtn');
    if (btn) btn.classList.remove('active');
  }


  // ══════════════════════════════════════════════════════════════════════
  // 8. 沿大氣層升起之跨領域能量光索 (Atmospheric Flow Arcs)
  // ══════════════════════════════════════════════════════════════════════
  function buildFlowLines() {
    FLOW_CONNECTIONS.forEach((flow) => {
      const objA = islandObjectsMap.get(flow.from);
      const objB = islandObjectsMap.get(flow.to);
      if (!objA || !objB) return;

      const normA = objA.userData.normal;
      const normB = objB.userData.normal;

      const pA = objA.position.clone().addScaledVector(normA, HEX_HEIGHT + 0.4);
      const pB = objB.position.clone().addScaledVector(normB, HEX_HEIGHT + 0.4);
      const mid = new THREE.Vector3().addVectors(pA, pB).multiplyScalar(0.5);
      const radialDir = new THREE.Vector3().subVectors(mid, PLANET_CENTER).normalize();

      // 能量弧線拋向大氣層高空
      mid.copy(PLANET_CENTER).addScaledVector(radialDir, PLANET_RADIUS + HEX_HEIGHT + 2.8 + pA.distanceTo(pB) * 0.2);

      const curve = new THREE.QuadraticBezierCurve3(pA, mid, pB);
      const points = curve.getPoints(50);
      const geo = new THREE.BufferGeometry().setFromPoints(points);

      const mat = new THREE.LineDashedMaterial({
        color: flow.color,
        dashSize: 0.5,
        gapSize: 0.35,
        linewidth: 2,
        transparent: true,
        opacity: 0.85
      });

      const line = new THREE.Line(geo, mat);
      line.computeLineDistances();
      flowsGroup.add(line);

      // 光子球
      const photonGeo = new THREE.SphereGeometry(0.12, 8, 8);
      const photonMat = new THREE.MeshBasicMaterial({ color: flow.color });
      const photon = new THREE.Mesh(photonGeo, photonMat);
      flowsGroup.add(photon);

      flowCurves.push({ curve, photon, progress: Math.random(), speed: 0.0035 + Math.random() * 0.002 });
    });
  }

  // ══════════════════════════════════════════════════════════════════════
  // 9. 黏土小人微型漫步者 (Chibi Walkers on Curved Planet)
  // ══════════════════════════════════════════════════════════════════════
  const _walkNormal = new THREE.Vector3();
  function spawnWalkers() {
    const walkerColors = [0x3b82f6, 0xef4444, 0x10b981, 0xf59e0b, 0x8b5cf6, 0xec4899];
    const totalWalkers = ISLAND_DATA.length; // 每座島嶼一位居民，之後會沿橋串門子

    for (let i = 0; i < totalWalkers; i++) {
      const walkerGroup = new THREE.Group();

      const bodyGeo = new THREE.CylinderGeometry(0.08, 0.12, 0.22, 8);
      const bodyMat = new THREE.MeshStandardMaterial({
        color: walkerColors[i % walkerColors.length],
        roughness: 0.7
      });
      const body = new THREE.Mesh(bodyGeo, bodyMat);
      body.position.y = 0.15;
      walkerGroup.add(body);

      const headGeo = new THREE.SphereGeometry(0.1, 10, 10);
      const headMat = new THREE.MeshStandardMaterial({ color: 0xffedd5, roughness: 0.8 });
      const head = new THREE.Mesh(headGeo, headMat);
      head.position.y = 0.32;
      walkerGroup.add(head);

      const island = ISLAND_DATA[i % ISLAND_DATA.length];
      const islandObj = islandObjectsMap.get(island.id);
      if (islandObj) {
        walkerGroup.position.copy(islandObj.position).addScaledVector(islandObj.userData.normal, HEX_HEIGHT);
        walkerGroup.quaternion.copy(islandObj.quaternion);
      }
      walkersGroup.add(walkerGroup);

      walkers.push({
        group: walkerGroup,
        currentIsland: island.id,
        targetPos: walkerGroup.position.clone(),
        queue: [],            // 待走的路徑點 (過橋用)
        arriveIsland: null,   // 走完路徑後所在的島
        speed: 0.015 + Math.random() * 0.015,
        pauseTicks: Math.floor(Math.random() * 120)
      });
    }
  }

  function updateWalkers() {
    if (!showWalkers) return;

    walkers.forEach((w) => {
      if (w.pauseTicks > 0) {
        w.pauseTicks--;
        return;
      }

      const curPos = w.group.position;
      const dist = curPos.distanceTo(w.targetPos);

      if (dist < 0.1) {
        // 正在過橋：走向下一個橋面路徑點
        if (w.queue.length) {
          w.targetPos.copy(w.queue.shift());
          if (!w.queue.length && w.arriveIsland) {
            w.currentIsland = w.arriveIsland;
            w.arriveIsland = null;
          }
          return;
        }

        w.pauseTicks = Math.floor(60 + Math.random() * 120);

        const island = islandObjectsMap.get(w.currentIsland);
        if (!island) return;
        const origin = island.position;
        const normal = island.userData.normal;
        const links = bridgeLinks.get(w.currentIsland);

        if (links && links.length && Math.random() < 0.45) {
          // 決定走橋去鄰島串門子：橋面路徑 + 對岸島上的落腳點
          const link = links[Math.floor(Math.random() * links.length)];
          const dest = islandObjectsMap.get(link.to);
          w.queue = link.points.map((p) => p.clone());
          if (dest) {
            const dn = dest.userData.normal;
            const dt = new THREE.Vector3(1, 0, 0).cross(dn).normalize();
            const db = new THREE.Vector3().crossVectors(dn, dt).normalize();
            const a = Math.random() * Math.PI * 2;
            const rr = 0.6 + Math.random() * 0.7;
            w.queue.push(dest.position.clone()
              .addScaledVector(dt, Math.cos(a) * rr)
              .addScaledVector(db, Math.sin(a) * rr)
              .addScaledVector(dn, HEX_HEIGHT));
          }
          w.arriveIsland = link.to;
          w.targetPos.copy(w.queue.shift());
          w.pauseTicks = Math.floor(20 + Math.random() * 40);
        } else {
          const tangent = new THREE.Vector3(1, 0, 0).cross(normal).normalize();
          const bitangent = new THREE.Vector3().crossVectors(normal, tangent).normalize();
          const angle = Math.random() * Math.PI * 2;
          const r = Math.random() * 1.3;
          w.targetPos.copy(origin)
            .addScaledVector(tangent, Math.cos(angle) * r)
            .addScaledVector(bitangent, Math.sin(angle) * r)
            .addScaledVector(normal, HEX_HEIGHT);
        }
      } else {
        const dir = new THREE.Vector3().subVectors(w.targetPos, curPos).normalize();
        curPos.addScaledVector(dir, w.speed);
        // 隨星球曲面保持站立 (過橋時也不會歪倒)
        w.group.quaternion.setFromUnitVectors(HM_UP, planetNormal(curPos, _walkNormal));
      }
    });
  }

  // ══════════════════════════════════════════════════════════════════════
  // 9-2. 渡船：兩座群島之間隔著海峽、不架橋，改搭船往返
  // ══════════════════════════════════════════════════════════════════════
  const ferries = [];
  // 六角島中心的平面座標 (與 hexToPlanet 同一套公式)
  function hexFlat(q, r, realm) {
    return {
      x: Math.sqrt(3) * SPACING * (q + r / 2) + (REALM_OFFSET_X[realm] ?? 0),
      z: 1.5 * SPACING * r
    };
  }

  function createFerries() {
    const byId = (id) => ISLAND_DATA.find((d) => d.id === id);
    // 兩條航線：醫學筆島群 ↔ 讀書筆記島群 (起點、終點皆為面對海峽的島嶼)
    const ROUTES = [
      { from: 'chronic', to: 'random-walk', hull: 0xdb6a41, offset: 0 },
      { from: 'health-check', to: 'wealth-ladder', hull: 0x2a9d8f, offset: 0.5 }
    ];

    const woodMat = new THREE.MeshStandardMaterial({ color: 0x9a6b43, roughness: 0.85, flatShading: true });
    const woodDark = new THREE.MeshStandardMaterial({ color: 0x6b4a2f, roughness: 0.9, flatShading: true });
    const whiteMat = new THREE.MeshStandardMaterial({ color: 0xfaf5ea, roughness: 0.7, flatShading: true });

    ROUTES.forEach((route, ri) => {
      const A = byId(route.from), B = byId(route.to);
      if (!A || !B) return;
      const fa = hexFlat(A.q, A.r, A.realm), fb = hexFlat(B.q, B.r, B.realm);
      const dx = fb.x - fa.x, dz = fb.z - fa.z;
      const len = Math.hypot(dx, dz);
      const ux = dx / len, uz = dz / len;

      // 碼頭：棧橋從島緣向海面延伸，末端即渡船停靠點
      const PIER_IN = HEX_APOTHEM - 0.5, PIER_OUT = HEX_APOTHEM + 1.7;
      const docks = [
        { cx: fa.x, cz: fa.z, sx: ux, sz: uz, name: A.shortName },
        { cx: fb.x, cz: fb.z, sx: -ux, sz: -uz, name: B.shortName }
      ];
      const stops = [];
      docks.forEach((dk, di) => {
        const startX = dk.cx + dk.sx * PIER_IN, startZ = dk.cz + dk.sz * PIER_IN;
        const endX = dk.cx + dk.sx * PIER_OUT, endZ = dk.cz + dk.sz * PIER_OUT;
        const mx = (startX + endX) / 2, mz = (startZ + endZ) / 2;
        const p = planetPoint(mx, mz, HEX_HEIGHT + 0.02);
        const pier = new THREE.Group();
        pier.position.copy(p);
        pier.quaternion.setFromUnitVectors(HM_UP, planetNormal(p));
        const yaw = new THREE.Quaternion().setFromAxisAngle(HM_UP, Math.atan2(dk.sx, dk.sz));
        pier.quaternion.multiply(yaw);
        const pierLen = PIER_OUT - PIER_IN;
        const deck = new THREE.Mesh(new THREE.BoxGeometry(0.9, 0.1, pierLen), woodMat);
        deck.castShadow = true; deck.receiveShadow = true;
        pier.add(deck);
        for (let k = 0; k <= 4; k++) {
          for (const sd of [-1, 1]) {
            const post = new THREE.Mesh(new THREE.CylinderGeometry(0.06, 0.07, 0.95, 6), woodDark);
            post.position.set(sd * 0.42, -0.4, -pierLen / 2 + (k / 4) * pierLen);
            pier.add(post);
          }
        }
        // 碼頭末端燈柱 (夜間發光)
        const lampPole = new THREE.Mesh(new THREE.CylinderGeometry(0.035, 0.05, 0.8, 6), woodDark);
        lampPole.position.set(0.38, 0.45, pierLen / 2 - 0.12);
        const lamp = new THREE.Mesh(new THREE.SphereGeometry(0.14, 10, 10), nightGlowMaterial);
        lamp.position.set(0.38, 0.9, pierLen / 2 - 0.12);
        pier.add(lampPole, lamp);
        scene.add(pier);

        // 碼頭標示 (HTML 浮動標籤)
        const label = document.createElement('div');
        label.className = 'ferry-label';
        label.textContent = '⛴ 渡船碼頭';
        const labelObj = new CSS2DObject(label);
        labelObj.position.set(0, 1.5, 0);
        pier.add(labelObj);
        badgeObjects.push(label);

        // 渡船停靠點 (碼頭末端再往海面 0.9)
        stops.push({ x: endX + dk.sx * 0.9, z: endZ + dk.sz * 0.9 });
      });

      // 渡船模型
      const ferry = new THREE.Group();
      const hullMat = new THREE.MeshStandardMaterial({ color: route.hull, roughness: 0.6, flatShading: true });
      const hull = new THREE.Mesh(new THREE.BoxGeometry(2.1, 0.32, 0.86), hullMat);
      hull.position.y = 0.16;
      const bow = new THREE.Mesh(new THREE.ConeGeometry(0.43, 0.7, 4), hullMat);
      bow.rotation.z = -Math.PI / 2; bow.rotation.y = Math.PI / 4; bow.position.set(1.38, 0.16, 0);
      const stripe = new THREE.Mesh(new THREE.BoxGeometry(2.12, 0.07, 0.88), whiteMat);
      stripe.position.y = 0.31;
      const cabin = new THREE.Mesh(new THREE.BoxGeometry(0.85, 0.5, 0.62), whiteMat);
      cabin.position.set(-0.45, 0.6, 0);
      const cabinRoof = new THREE.Mesh(new THREE.BoxGeometry(0.98, 0.09, 0.74), hullMat);
      cabinRoof.position.set(-0.45, 0.89, 0);
      const winGeo = new THREE.BoxGeometry(0.16, 0.16, 0.64);
      const w1 = new THREE.Mesh(winGeo, nightGlowMaterial); w1.position.set(-0.7, 0.64, 0);
      const w2 = new THREE.Mesh(winGeo, nightGlowMaterial); w2.position.set(-0.2, 0.64, 0);
      const flagPole = new THREE.Mesh(new THREE.CylinderGeometry(0.02, 0.025, 0.55, 5), woodDark);
      flagPole.position.set(-0.45, 1.2, 0);
      const flag = new THREE.Mesh(new THREE.PlaneGeometry(0.34, 0.2), new THREE.MeshStandardMaterial({ color: 0xfbbf24, side: THREE.DoubleSide }));
      flag.position.set(-0.28, 1.36, 0);
      ferry.add(hull, bow, stripe, cabin, cabinRoof, w1, w2, flagPole, flag);
      // 甲板乘客 (毛線風小人)
      [0.55, 0.9].forEach((px, pi) => {
        const pass = new THREE.Group();
        const pb = new THREE.Mesh(new THREE.CylinderGeometry(0.07, 0.1, 0.2, 8),
          new THREE.MeshStandardMaterial({ color: [0xef4444, 0x3b82f6][pi], roughness: 0.7 }));
        pb.position.y = 0.13;
        const ph = new THREE.Mesh(new THREE.SphereGeometry(0.085, 10, 10),
          new THREE.MeshStandardMaterial({ color: 0xffedd5, roughness: 0.8 }));
        ph.position.y = 0.3;
        pass.add(pb, ph);
        pass.position.set(px, 0.33, (pi ? 0.14 : -0.14));
        ferry.add(pass);
      });
      ferry.scale.setScalar(1.15);
      ferry.userData = { stops, bob: ri * 2.1, offset: route.offset };
      scene.add(ferry);
      ferries.push(ferry);
    });
  }

  // 渡船往返：靠岸停留 → 航行 → 靠岸停留 → 返航 (循環 30 秒)
  const _fQn = new THREE.Quaternion(), _fQy = new THREE.Quaternion(), _fN = new THREE.Vector3();
  function updateFerries(t) {
    const CYCLE = 30, DWELL = 4, TRAVEL = 11; // DWELL*2 + TRAVEL*2 = 30
    ferries.forEach((f) => {
      const u = f.userData;
      const ph = (((t / CYCLE) + u.offset) % 1) * CYCLE;
      let k, dirSign;
      if (ph < DWELL) { k = 0; dirSign = 1; }
      else if (ph < DWELL + TRAVEL) { k = hmSmooth(0, 1, (ph - DWELL) / TRAVEL); dirSign = 1; }
      else if (ph < 2 * DWELL + TRAVEL) { k = 1; dirSign = -1; }
      else { k = 1 - hmSmooth(0, 1, (ph - 2 * DWELL - TRAVEL) / TRAVEL); dirSign = -1; }

      const a = u.stops[0], b = u.stops[1];
      const x = a.x + (b.x - a.x) * k, z = a.z + (b.z - a.z) * k;
      planetPoint(x, z, 0.03 + Math.sin(t * 1.6 + u.bob) * 0.04, f.position);
      _fQn.setFromUnitVectors(HM_UP, planetNormal(f.position, _fN));
      const fx = (b.x - a.x) * dirSign, fz = (b.z - a.z) * dirSign;
      _fQy.setFromAxisAngle(HM_UP, Math.atan2(-fz, fx));
      f.quaternion.copy(_fQn).multiply(_fQy);
    });
  }

  // ══════════════════════════════════════════════════════════════════════
  // 10. 點擊互動與射線選取
  // ══════════════════════════════════════════════════════════════════════
  const raycaster = new THREE.Raycaster();
  const mouse = new THREE.Vector2();

  function setupRaycaster() {
    container.addEventListener('pointerdown', (e) => {
      container._startX = e.clientX;
      container._startY = e.clientY;
    });

    container.addEventListener('pointerup', (e) => {
      const dx = Math.abs(e.clientX - container._startX);
      const dy = Math.abs(e.clientY - container._startY);
      if (dx > 6 || dy > 6) return;

      const rect = renderer.domElement.getBoundingClientRect();
      mouse.x = ((e.clientX - rect.left) / rect.width) * 2 - 1;
      mouse.y = -((e.clientY - rect.top) / rect.height) * 2 + 1;

      raycaster.setFromCamera(mouse, camera);
      const intersects = raycaster.intersectObjects(islandsGroup.children, true);

      if (intersects.length > 0) {
        let current = intersects[0].object;
        let foundIslandId = null;

        while (current && current !== scene) {
          if (current.userData && current.userData.islandId) {
            foundIslandId = current.userData.islandId;
            break;
          }
          current = current.parent;
        }

        if (foundIslandId) {
          focusIsland(foundIslandId);
        }
      }
    });
  }

  // ══════════════════════════════════════════════════════════════════════
  // 11. 平滑相機飛行與島嶼登陸
  // ══════════════════════════════════════════════════════════════════════
  function focusIsland(islandId) {
    exitBirdViewSilently();
    const island = ISLAND_DATA.find((i) => i.id === islandId);
    if (!island) return;

    activeIsland = islandId;

    // 1. 更新反白光圈
    islandObjectsMap.forEach((obj, id) => {
      if (obj.userData.selectionRing) {
        obj.userData.selectionRing.material.opacity = id === islandId ? 0.95 : 0;
      }
    });

    // 2. 開啟左側全文章抽屜
    openDetailCard(island);

    // 3. 高亮右側導覽列並在手機版收合目錄
    highlightSidebarRow(islandId);
    if (window.innerWidth <= 900) {
      const sidebar = document.getElementById('islandNavSidebar');
      const toggleSidebarBtn = document.getElementById('toggleSidebarBtn');
      if (sidebar) sidebar.classList.remove('open-mobile');
      if (toggleSidebarBtn) toggleSidebarBtn.classList.remove('active');
    }

    // 4. 計算沿著地球地平線傾角飛行之相機目標點
    const obj = islandObjectsMap.get(islandId);
    const center = obj.position;
    const normal = obj.userData.normal;

    // 相機停在島嶼正上方偏後方
    cameraDestPos = center.clone().addScaledVector(normal, 4.8).add(new THREE.Vector3(0.2, 0.4, 5.2));
    cameraTarget = center.clone().addScaledVector(normal, HEX_HEIGHT + 0.3);

    startCameraFlight(cameraDestPos, cameraTarget, 1200);
  }

  function resetView() {
    exitBirdViewSilently();
    activeIsland = null;
    closeDetailCard();

    islandObjectsMap.forEach((obj) => {
      if (obj.userData.selectionRing) obj.userData.selectionRing.material.opacity = 0;
    });

    document.querySelectorAll('.sidebar-island-row').forEach(r => r.classList.remove('active'));

    const overviewLookAt = new THREE.Vector3(2.1, 0, 0);
    const overviewPos = new THREE.Vector3(2.1, 18, 22);
    startCameraFlight(overviewPos, overviewLookAt, 1400);
  }

  function startCameraFlight(destPos, destLookAt, durationMs) {
    flightStartPos.copy(camera.position);
    flightStartLookAt.copy(controls.target);
    cameraDestPos.copy(destPos);
    cameraTarget.copy(destLookAt);

    flightStartTime = performance.now();
    flightDuration = durationMs;
    isFlightActive = true;
    controls.enabled = false;
    controls.autoRotate = false;
  }

  function updateCameraFlight() {
    if (!isFlightActive) return;

    const elapsed = performance.now() - flightStartTime;
    const progress = Math.min(elapsed / flightDuration, 1);
    const ease = progress < 0.5
      ? 4 * progress * progress * progress
      : 1 - Math.pow(-2 * progress + 2, 3) / 2;

    camera.position.lerpVectors(flightStartPos, cameraDestPos, ease);
    controls.target.lerpVectors(flightStartLookAt, cameraTarget, ease);

    if (progress >= 1) {
      isFlightActive = false;
      controls.enabled = true;
      if (isBirdView) { controls.autoRotate = true; controls.autoRotateSpeed = 0.6; }
    }
  }

  // ══════════════════════════════════════════════════════════════════════
  // 12. UI 面板與互動事件 (支援全文章展示與島內搜尋)
  // ══════════════════════════════════════════════════════════════════════
  let currentDrawerArticles = [];

  function setupUI() {
    // 星系切換鈕
    const realmPills = document.querySelectorAll('.realm-pill');
    realmPills.forEach((pill) => {
      pill.addEventListener('click', () => {
        realmPills.forEach(p => p.classList.remove('active'));
        pill.classList.add('active');
        filterRealm(pill.dataset.realm);
      });
    });

    // 光照時序鈕
    const timeBtns = document.querySelectorAll('.time-btn');
    timeBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        timeBtns.forEach(b => b.classList.remove('active'));
        btn.classList.add('active');
        applyTimePreset(btn.dataset.time);
      });
    });

    // 標籤開關
    const toggleLabelsBtn = document.getElementById('toggleLabelsBtn');
    toggleLabelsBtn.addEventListener('click', () => {
      showLabels = !showLabels;
      toggleLabelsBtn.classList.toggle('active', showLabels);
      badgeObjects.forEach(b => b.classList.toggle('labels-hidden', !showLabels));
    });

    // 漫步小人開關
    const toggleWalkersBtn = document.getElementById('toggleWalkersBtn');
    toggleWalkersBtn.addEventListener('click', () => {
      showWalkers = !showWalkers;
      toggleWalkersBtn.classList.toggle('active', showWalkers);
      walkersGroup.visible = showWalkers;
    });

    // 能量光流開關
    const toggleFlowsBtn = document.getElementById('toggleFlowsBtn');
    toggleFlowsBtn.addEventListener('click', () => {
      showFlows = !showFlows;
      toggleFlowsBtn.classList.toggle('active', showFlows);
      flowsGroup.visible = showFlows;
    });

    // 全景重置按鈕
    document.getElementById('resetCamBtn').addEventListener('click', resetView);

    // 鳥瞰模式 (升空 + 緩慢環繞；使用者一拖曳即停止自轉)
    document.getElementById('birdViewBtn').addEventListener('click', () => setBirdView(!isBirdView));
    controls.addEventListener('start', () => { if (isBirdView) controls.autoRotate = false; });

    // 側邊欄切換
    const sidebar = document.getElementById('islandNavSidebar');
    const toggleSidebarBtn = document.getElementById('toggleSidebarBtn');
    toggleSidebarBtn.addEventListener('click', () => {
      if (window.innerWidth <= 900) {
        sidebar.classList.toggle('open-mobile');
        toggleSidebarBtn.classList.toggle('active', sidebar.classList.contains('open-mobile'));
        if (sidebar.classList.contains('open-mobile')) {
          closeDetailCard();
        }
      } else {
        sidebar.classList.toggle('collapsed');
        toggleSidebarBtn.classList.toggle('active', !sidebar.classList.contains('collapsed'));
      }
    });

    // 關閉左側卡片
    document.getElementById('closeDetailBtn').addEventListener('click', closeDetailCard);

    // 填入右側導覽列清單
    populateSidebar();

    // 右側側邊欄搜尋
    const searchInput = document.getElementById('islandSearchInput');
    searchInput.addEventListener('input', (e) => {
      const query = e.target.value.trim().toLowerCase();
      filterSidebarBySearch(query);
    });

    // 抽屜內全文章搜尋過濾框
    const drawerSearch = document.getElementById('drawerArticleSearch');
    drawerSearch.addEventListener('input', (e) => {
      const query = e.target.value.trim().toLowerCase();
      renderDrawerArticles(query);
    });

    // 鍵盤 Esc 關閉抽屜
    window.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') {
        closeDetailCard();
      }
    });
  }

  // 填入右側島嶼清單
  function populateSidebar() {
    const healthContainer = document.getElementById('healthItems');
    const wisdomContainer = document.getElementById('wisdomItems');

    healthContainer.innerHTML = '';
    wisdomContainer.innerHTML = '';

    let totalHealthArticles = 0;
    let totalWisdomArticles = 0;

    ISLAND_DATA.forEach((island) => {
      const count = island.articles.length;
      if (island.realm === 'health') totalHealthArticles += count;
      else totalWisdomArticles += count;

      const row = document.createElement('div');
      row.className = 'sidebar-island-row';
      row.dataset.islandId = island.id;
      row.dataset.islandName = island.name.toLowerCase();
      row.dataset.islandSubtitle = island.subtitle.toLowerCase();
      row.innerHTML = `
        <div class="sidebar-island-main">
          <div class="sidebar-island-icon">${island.icon}</div>
          <span class="sidebar-island-name">${island.name}</span>
        </div>
        <span class="sidebar-island-tag">${count}篇</span>
      `;
      row.addEventListener('click', () => {
        focusIsland(island.id);
      });

      if (island.realm === 'health') {
        healthContainer.appendChild(row);
      } else {
        wisdomContainer.appendChild(row);
      }
    });

    const healthIslandsCount = ISLAND_DATA.filter(i => i.realm === 'health').length;
    const wisdomIslandsCount = ISLAND_DATA.filter(i => i.realm === 'wisdom').length;
    document.getElementById('healthTotalStat').textContent = `${healthIslandsCount} 座群島 · ${totalHealthArticles} 篇專文`;
    document.getElementById('wisdomTotalStat').textContent = `${wisdomIslandsCount} 部名著 · ${totalWisdomArticles} 篇章節`;
  }

  function highlightSidebarRow(islandId) {
    document.querySelectorAll('.sidebar-island-row').forEach((row) => {
      row.classList.toggle('active', row.dataset.islandId === islandId);
    });
  }

  function filterSidebarBySearch(query) {
    document.querySelectorAll('.sidebar-island-row').forEach((row) => {
      const name = row.dataset.islandName;
      const sub = row.dataset.islandSubtitle;
      const match = !query || name.includes(query) || sub.includes(query);
      row.style.display = match ? 'flex' : 'none';
    });
  }

  function filterRealm(realm) {
    islandsGroup.children.forEach((group) => {
      const data = group.userData.islandData;
      if (!data) return;
      const visible = realm === 'all' || data.realm === realm;
      group.visible = visible;
    });

    bridgesGroup.children.forEach((b) => {
      if (b.userData && b.userData.realm) {
        b.visible = (realm === 'all' || b.userData.realm === realm);
      }
    });

    walkers.forEach((w) => {
      const island = ISLAND_DATA.find(i => i.id === w.currentIsland);
      if (island && w.group) {
        w.group.visible = showWalkers && (realm === 'all' || island.realm === realm);
      }
    });

    document.querySelectorAll('.realm-group').forEach((group) => {
      const groupRealm = group.dataset.realmGroup;
      const visible = realm === 'all' || groupRealm === realm;
      group.style.display = visible ? 'block' : 'none';
    });

    if (activeIsland) {
      const activeData = ISLAND_DATA.find(i => i.id === activeIsland);
      if (activeData && realm !== 'all' && activeData.realm !== realm) {
        resetView();
      }
    }
  }

  // 開啟左側抽屜並載入「全文章與章節」
  function openDetailCard(island) {
    const drawer = document.getElementById('islandDetailCard');
    const realmTag = document.getElementById('cardRealmTag');
    const icon = document.getElementById('cardIcon');
    const title = document.getElementById('cardTitle');
    const subtitle = document.getElementById('cardSubtitle');
    const desc = document.getElementById('cardDesc');
    const ctaBtn = document.getElementById('cardCtaBtn');
    const drawerSearch = document.getElementById('drawerArticleSearch');

    realmTag.textContent = island.realm === 'health' ? '🏥 醫學筆島群' : '📚 讀書筆記島群';
    realmTag.classList.toggle('wisdom-style', island.realm === 'wisdom');

    icon.textContent = island.icon;
    title.textContent = island.name;
    subtitle.textContent = island.subtitle;
    desc.textContent = island.desc;

    ctaBtn.href = island.ctaUrl;
    ctaBtn.querySelector('span').textContent = island.ctaText;

    // 清空抽屜搜尋欄並重置當前文章清單
    drawerSearch.value = '';
    currentDrawerArticles = island.articles;
    renderDrawerArticles('');

    drawer.classList.add('open');
    drawer.setAttribute('aria-hidden', 'false');
  }

  // 渲染抽屜內全文章列表 (保留 100% 原始標題)
  function renderDrawerArticles(filterText) {
    const pinList = document.getElementById('cardPinList');
    const countBadge = document.getElementById('drawerArticlesCount');

    const filtered = currentDrawerArticles.filter(art => {
      if (!filterText) return true;
      return art.title.toLowerCase().includes(filterText) ||
             (art.category && art.category.toLowerCase().includes(filterText));
    });

    countBadge.textContent = `${filtered.length} 篇`;

    if (filtered.length === 0) {
      pinList.innerHTML = `
        <div style="text-align: center; padding: 24px 10px; color: #8aa4b2; font-size: 0.86rem; font-weight: 600;">
          無相符文章或章節
        </div>
      `;
      return;
    }

    pinList.innerHTML = filtered.map((art, idx) => `
      <a href="${art.url}" class="pin-item-card" target="_blank" rel="noopener">
        <div class="pin-num">${idx + 1}</div>
        <div class="pin-text-col">
          <div class="pin-title">${art.title}</div>
          <div class="pin-sub">${art.category}</div>
        </div>
        <svg class="pin-arrow-ic" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="9 18 15 12 9 6"/></svg>
      </a>
    `).join('');
  }

  function closeDetailCard() {
    const drawer = document.getElementById('islandDetailCard');
    drawer.classList.remove('open');
    drawer.setAttribute('aria-hidden', 'true');
    if (activeIsland) {
      const islandObj = islandObjectsMap.get(activeIsland);
      if (islandObj && islandObj.userData.selectionRing) {
        islandObj.userData.selectionRing.material.opacity = 0;
      }
      activeIsland = null;
    }
    document.querySelectorAll('.sidebar-island-row').forEach(r => r.classList.remove('active'));
  }

  function onWindowResize() {
    const width = container.clientWidth;
    const height = container.clientHeight;
    camera.aspect = width / height;
    camera.updateProjectionMatrix();
    renderer.setSize(width, height);
    cssRenderer.setSize(width, height);
  }

  // ══════════════════════════════════════════════════════════════════════
  // 13. 主渲染迴圈
  // ══════════════════════════════════════════════════════════════════════
  function animate() {
    requestAnimationFrame(animate);

    const now = Date.now();
    const elapsedTime = now * 0.001;

    // 1. 180s 日夜循環光影與天空星空更新
    updateDayNightCycle(elapsedTime);

    // 2. 動態海浪與慢速漂浮白雲更新
    updateWavesAndClouds(elapsedTime);

    // 2. 能量光流粒子在大氣層高空飛掠
    if (showFlows) {
      flowCurves.forEach((item) => {
        item.progress = (item.progress + item.speed) % 1;
        const pos = item.curve.getPointAt(item.progress);
        item.photon.position.copy(pos);
      });
    }

    // 3. 漫步微型小人移動更新
        // 飛鳥群 8 字型立體盤旋飛行與扇動翅膀
    if (birdFlockData && birdFlockData.birds) {
      birdFlockData.birds.forEach((bird) => {
        const u = bird.userData;
        if (u) {
          const t = elapsedTime * (u.speed || 1.0) + (u.phase || 0);
          bird.position.y = u.baseY + Math.sin(t * 2.5) * 0.45;
          bird.position.x = u.baseX + Math.sin(t * 0.8) * 1.5;
          bird.rotation.z = Math.sin(t * 3.0) * 0.12;
        }
      });
    }

    updateWalkers();

    // 4. 書卷水晶微幅漂浮旋轉
    islandsGroup.traverse((child) => {
      if (child.userData && child.userData.isFloatingGem) {
        child.rotation.y += 0.02;
        child.position.y = HEX_HEIGHT + 1.25 + Math.sin(now * 0.003 * child.userData.baseSpeed) * 0.08;
      }
    });

    // 5. 相機飛行補間更新
    updateCameraFlight();

    controls.update();
    renderer.render(scene, camera);
    cssRenderer.render(scene, camera);
  }

  // 啟動 3D 微縮星球世界
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', init);
  } else {
    init();
  }
</script>
