    const faceMat = new THREE.MeshStandardMaterial({ color: 0xfbd0b7, roughness: 0.8 });
    const darkMat = new THREE.MeshStandardMaterial({ color: 0x3d271d, roughness: 0.9 });

    // 蓬鬆圓毛球身軀
    const body = new THREE.Mesh(new THREE.SphereGeometry(0.34, 7, 6), woolMat);
    body.position.y = 0.36;
    body.scale.set(1.15, 0.95, 1.0);
    g.add(body);

    // 可愛小羊頭
    const head = new THREE.Mesh(new THREE.SphereGeometry(0.19, 6, 6), faceMat);
    head.position.set(0.32, 0.46, 0);
    g.add(head);

    // 下垂小耳朵
    const earGeo = new THREE.ConeGeometry(0.06, 0.14, 4);
    earGeo.rotateZ(-Math.PI / 3);
    const ear1 = new THREE.Mesh(earGeo, darkMat); ear1.position.set(0.26, 0.52, 0.14);
    const ear2 = new THREE.Mesh(earGeo, darkMat); ear2.position.set(0.26, 0.52, -0.14);
    g.add(ear1, ear2);

    // 四條小細腿
    const legGeo = new THREE.CylinderGeometry(0.045, 0.04, 0.22, 5);
    [[-0.15, -0.12], [-0.15, 0.12], [0.15, -0.12], [0.15, 0.12]].forEach(([lx, lz]) => {
      const leg = new THREE.Mesh(legGeo, darkMat);
      leg.position.set(lx, 0.11, lz);
      g.add(leg);
    });

    g.userData = { isAnimal: true, animalType: 'sheep', isWobbleable: true };
    g.traverse(c => { c.userData.isAnimal = true; c.userData.parentCreature = g; c.userData.isWobbleable = true; c.userData.parentWobble = g; });
    return g;
  }

