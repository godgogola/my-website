  // ── (2) 佈置島嶼生機小動物 (貓、狗、小羊、鸚鵡) 與海洋生物 ──
  const ANIMAL_BADGE_LABELS = {
    cat: '🐱 橘貓',
    puppy: '🐶 柴犬',
    sheep: '🐑 綿羊',
    cockatoo: '🦜 鸚鵡'
  };

  function attachAnimalHitboxAndBadge(creatureMesh, type) {
    // 1. 放大動物至清晰可見的療癒比例
    creatureMesh.scale.setScalar(1.48);

    // 2. 加上隱形大範圍點擊碰撞球，確保滑鼠點擊 100% 優先命中動物而非島嶼地面
    const hitGeo = new THREE.SphereGeometry(0.55, 8, 8);
    const hitMat = new THREE.MeshBasicMaterial({ transparent: true, opacity: 0, depthWrite: false });
    const hitSphere = new THREE.Mesh(hitGeo, hitMat);
    hitSphere.position.set(0, 0.35, 0);
    hitSphere.userData = {
      isAnimal: true,
      animalType: type,
      parentCreature: creatureMesh,
      isWobbleable: true,
      parentWobble: creatureMesh
    };
    creatureMesh.add(hitSphere);

    // 3. 加上精緻深翠綠迷你小膠囊 (高度貼近動物頭頂 0.52，尺寸與色彩皆和純白大型島嶼名牌徹底區隔)
    if (ANIMAL_BADGE_LABELS[type]) {
      const pill = document.createElement('div');
      pill.className = 'animal-mini-pill';
      pill.textContent = ANIMAL_BADGE_LABELS[type];
      pill.title = '點擊聽聽小動物的叫聲與衛教叮嚀！';
      pill.addEventListener('pointerdown', (e) => e.stopPropagation());
      pill.addEventListener('click', (e) => {
        e.stopPropagation();
        triggerAnimalInteraction(creatureMesh);
      });
      const pillObj = new CSS2DObject(pill);
      pillObj.position.set(0, 0.52, 0);
      pill._css2dObj = pillObj;
      pill._badgeKind = 'animal';
      creatureMesh.add(pillObj);
      badgeObjects.push(pill);
    }
  }

  function createMiniFauna() {
    // 3 條遠離中央建築物、水池與樹木的外環空曠草地散步路線 (半徑 r ≈ 2.05 ~ 2.35)
    const PATROL_ROUTES = [
      { ax: -0.95, az: 2.18, bx: 0.95, bz: 2.18 },  // 路線 0：島嶼正前方外緣寬敞草地走廊
      { ax: 1.55, az: 1.82, bx: 2.28, bz: 0.22 },   // 路線 1：島嶼右前方外緣寬敞草地走廊
      { ax: -2.28, az: -0.05, bx: -1.62, bz: 1.78 } // 路線 2：島嶼左前方外緣寬敞草地走廊
    ];

    // 陸地療癒動物：小橘貓 (cat)、小柴犬 (puppy)、小綿羊 (sheep)、巴丹鸚鵡 (cockatoo) 遍佈各座主題島嶼！
    const FAUNA_DISTRIBUTION = [
      // 🐱 小橘貓 (Cat)
      { islandId: 'endoscopy', type: 'cat', route: 0 },
      { islandId: 'intestine', type: 'cat', route: 1 },
      { islandId: 'liver-biliary', type: 'cat', route: 2 },
      { islandId: 'medication', type: 'cat', route: 0 },
      { islandId: 'random-walk', type: 'cat', route: 1 },
      { islandId: 'golden-rules', type: 'cat', route: 2 },

      // 🐶 小柴犬 (Puppy)
      { islandId: 'exercise', type: 'puppy', route: 0 },
      { islandId: 'stomach', type: 'puppy', route: 1 },
      { islandId: 'diabetes', type: 'puppy', route: 2 },
      { islandId: 'weight-loss', type: 'puppy', route: 0 },
      { islandId: 'wealth-ladder', type: 'puppy', route: 1 },
      { islandId: 'sapiens', type: 'puppy', route: 2 },

      // 🐑 小綿羊 (Sheep)
      { islandId: 'glucose', type: 'sheep', route: 0 },
      { islandId: 'diet', type: 'sheep', route: 1 },
      { islandId: 'chronic', type: 'sheep', route: 2 },
      { islandId: 'lipids', type: 'sheep', route: 0 },
      { islandId: 'die-with-zero', type: 'sheep', route: 1 },

      // 🦜 巴丹鸚鵡 (Cockatoo)
      { islandId: 'hypertension', type: 'cockatoo', route: 2 },
      { islandId: 'ultrasound', type: 'cockatoo', route: 0 },
      { islandId: 'hepatitis', type: 'cockatoo', route: 1 },
      { islandId: 'brain-neuro', type: 'cockatoo', route: 2 },
      { islandId: 'most-important', type: 'cockatoo', route: 0 }
    ];

    FAUNA_DISTRIBUTION.forEach((item, idx) => {
      const islandObj = islandObjectsMap.get(item.islandId);
      if (!islandObj) return;

      let creatureMesh;
      if (item.type === 'cat') creatureMesh = createCatModel();
      else if (item.type === 'sheep') creatureMesh = createSheepModel();
      else if (item.type === 'puppy') creatureMesh = createPuppyModel();
      else if (item.type === 'cockatoo') creatureMesh = createCockatooModel();

      if (!creatureMesh) return;
      attachAnimalHitboxAndBadge(creatureMesh, item.type);

      const rt = PATROL_ROUTES[item.route % PATROL_ROUTES.length];
      creatureMesh.position.set(rt.ax, HEX_HEIGHT + 0.08, rt.az);
      islandObj.add(creatureMesh);

      faunaCreatures.push({
        mesh: creatureMesh,
        type: item.type,
        islandId: item.islandId,
        ax: rt.ax,
        az: rt.az,
        bx: rt.bx,
        bz: rt.bz,
        walkSpeed: 0.85 + (idx % 4) * 0.14,
        phase: idx * 1.35,
        tailMesh: creatureMesh.userData.tailMesh
      });
    });

    // 水生生物：海龜、海豚、小黃鴨、跳跳魚
    // (a) 海龜
    const turtle1 = createTurtleModel();
    faunaGroup.add(turtle1);
    swimmingCreatures.push({
      mesh: turtle1, type: 'turtle',
      centerX: -2.5, centerZ: 2.0, radiusX: 9.5, radiusZ: 7.0, speed: 0.18, phase: 0.5
    });

    const turtle2 = createTurtleModel();
    turtle2.scale.setScalar(0.85);
    faunaGroup.add(turtle2);
    swimmingCreatures.push({
      mesh: turtle2, type: 'turtle',
      centerX: 6.0, centerZ: -8.0, radiusX: 8.0, radiusZ: 6.5, speed: 0.22, phase: 2.8
    });

    // (b) 海豚
    const dolphin1 = createDolphinModel();
    faunaGroup.add(dolphin1);
    swimmingCreatures.push({
      mesh: dolphin1, type: 'dolphin',
      centerX: 0.0, centerZ: -4.0, radiusX: 13.0, radiusZ: 10.0, speed: 0.38, phase: 1.2
    });

    const dolphin2 = createDolphinModel();
    dolphin2.scale.setScalar(0.9);
    faunaGroup.add(dolphin2);
    swimmingCreatures.push({
      mesh: dolphin2, type: 'dolphin',
      centerX: -10.0, centerZ: 10.0, radiusX: 11.0, radiusZ: 8.5, speed: 0.35, phase: 4.1
    });

    // (c) 漂浮小黃鴨
    const duckCoords = [
      { x: -5.5, z: 6.8 },
      { x: 3.8, z: 8.2 },
      { x: -8.0, z: -10.5 }
    ];
    duckCoords.forEach((coord, i) => {
      const duck = createDuckModel();
      duck.position.set(coord.x, 0.06, coord.z);
      duck.rotation.y = Math.random() * Math.PI * 2;
      faunaGroup.add(duck);
      floatingDucks.push({
        mesh: duck, baseY: 0.06, bobPhase: i * 1.8
      });
    });

    // (d) 躍出水面跳跳魚
    const leapConfigs = [
      { startX: -7.0, startZ: 3.0, endX: -4.5, endZ: 4.5, period: 5.5, offset: 0.0, jumpDuration: 1.2, jumpHeight: 1.6 },
      { startX: 4.0, startZ: -5.0, endX: 6.5, endZ: -3.5, period: 6.2, offset: 2.3, jumpDuration: 1.3, jumpHeight: 1.8 },
      { startX: -1.0, startZ: 12.0, endX: 1.5, endZ: 13.5, period: 7.0, offset: 4.5, jumpDuration: 1.25, jumpHeight: 1.5 }
    ];
    leapConfigs.forEach(cfg => {
      const fish = createFishModel();
      fish.visible = false;
      faunaGroup.add(fish);
      leapingFishList.push({
        mesh: fish,
        startX: cfg.startX, startZ: cfg.startZ,
        endX: cfg.endX, endZ: cfg.endZ,
        period: cfg.period,
        offset: cfg.offset,
        jumpDuration: cfg.jumpDuration,
        jumpHeight: cfg.jumpHeight,
        rippled: false
      });
    });
  }

