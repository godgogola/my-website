  // ── (5) 果凍 Q 彈物理搖晃動畫 (Jelly Wobble) ──
  function triggerJellyWobble(mesh) {
    if (!mesh) return;
    if (activeJellyAnims.some(a => a.mesh === mesh)) return;
    activeJellyAnims.push({
      mesh,
      startTime: Date.now(),
      duration: 850,
      origRotX: mesh.rotation.x,
      origRotZ: mesh.rotation.z,
      amp: 0.16
    });
  }

  function updateJellyAnims() {
    const now = Date.now();
    for (let i = activeJellyAnims.length - 1; i >= 0; i--) {
      const a = activeJellyAnims[i];
      const elapsed = now - a.startTime;
      if (elapsed >= a.duration) {
        a.mesh.rotation.x = a.origRotX;
        a.mesh.rotation.z = a.origRotZ;
        activeJellyAnims.splice(i, 1);
      } else {
        const p = elapsed / a.duration;
        const decay = Math.exp(-p * 4.5);
        const wave = Math.sin(p * Math.PI * 7) * a.amp * decay;
        a.mesh.rotation.z = a.origRotZ + wave;
        a.mesh.rotation.x = a.origRotX + wave * 0.6;
      }
    }
  }

  // ── (6) 向上彈跳縮放動畫 (Squash & Jump) ──
  function triggerSquash(mesh) {
    if (!mesh) return;
    if (activeSquashAnims.some(a => a.mesh === mesh)) return;
    activeSquashAnims.push({
      mesh,
      startTime: Date.now(),
      duration: 680,
      origScaleX: mesh.scale.x,
      origScaleY: mesh.scale.y,
      origScaleZ: mesh.scale.z,
      origPosY: mesh.position.y,
      jumpH: 0.72
    });
  }

  function updateSquashAnims() {
    const now = Date.now();
    for (let i = activeSquashAnims.length - 1; i >= 0; i--) {
      const a = activeSquashAnims[i];
      const elapsed = now - a.startTime;
      if (elapsed >= a.duration) {
        a.mesh.scale.set(a.origScaleX, a.origScaleY, a.origScaleZ);
        a.mesh.position.y = a.origPosY;
        activeSquashAnims.splice(i, 1);
      } else {
        const p = elapsed / a.duration;
        let sy = 1, sxz = 1, dy = 0;
        if (p < 0.2) {
          const t = p / 0.2;
          sy = 1 - 0.28 * Math.sin(t * Math.PI);
          sxz = 1 + 0.14 * Math.sin(t * Math.PI);
          dy = -0.08 * Math.sin(t * Math.PI);
        } else if (p < 0.65) {
          const t = (p - 0.2) / 0.45;
          const jumpSin = Math.sin(t * Math.PI);
          dy = a.jumpH * jumpSin;
          sy = 1 + 0.22 * jumpSin;
          sxz = 1 - 0.12 * jumpSin;
        } else {
          const t = (p - 0.65) / 0.35;
          const bounce = Math.sin(t * Math.PI * 2) * Math.exp(-t * 3);
          sy = 1 + 0.12 * bounce;
          sxz = 1 - 0.06 * bounce;
          dy = 0.08 * Math.max(0, bounce);
        }
        a.mesh.scale.y = a.origScaleY * sy;
        a.mesh.scale.x = a.origScaleX * sxz;
        a.mesh.scale.z = a.origScaleZ * sxz;
        a.mesh.position.y = a.origPosY + dy;
      }
    }
  }

  // ── (7) 海面白色擴散水波紋 (Water Ripples) ──
  const rippleGeo = new THREE.RingGeometry(0.12, 0.32, 32);
  rippleGeo.rotateX(-Math.PI / 2);

  function createWaterRipple(worldPos) {
    const mat = new THREE.MeshBasicMaterial({
      color: 0xffffff,
      transparent: true,
      opacity: 0.85,
      side: THREE.DoubleSide,
      depthWrite: false
    });
    const mesh = new THREE.Mesh(rippleGeo, mat);
    mesh.position.set(worldPos.x, 0.08, worldPos.z);
    scene.add(mesh);
    waterRipples.push({
      mesh,
      startTime: Date.now(),
      duration: 1300,
      maxScale: 4.8
    });
  }

  function updateWaterRipples() {
    const now = Date.now();
    for (let i = waterRipples.length - 1; i >= 0; i--) {
      const r = waterRipples[i];
      const elapsed = now - r.startTime;
      if (elapsed >= r.duration) {
        scene.remove(r.mesh);
        r.mesh.material.dispose();
        waterRipples.splice(i, 1);
      } else {
        const p = elapsed / r.duration;
        const scale = 1 + (r.maxScale - 1) * Math.sqrt(p);
        r.mesh.scale.set(scale, 1, scale);
        r.mesh.material.opacity = (1 - p) * 0.8;
      }
    }
  }

  // ── (8) 船尾水花粒子 (Wake Particles) ──
  const wakeGeo = new THREE.BoxGeometry(0.12, 0.08, 0.12);
  function spawnWakeParticle(pos) {
    if (wakeParticles.length > 35) return;
    const pMat = new THREE.MeshBasicMaterial({
      color: 0xffffff,
      transparent: true,
      opacity: 0.85
    });
    const pMesh = new THREE.Mesh(wakeGeo, pMat);
    pMesh.position.set(
      pos.x + (Math.random() - 0.5) * 0.45,
      0.08,
      pos.z + (Math.random() - 0.5) * 0.45
    );
    scene.add(pMesh);
    wakeParticles.push({
      mesh: pMesh,
      startTime: Date.now(),
      duration: 750 + Math.random() * 400
    });
  }

  function updateWakeParticles() {
    const now = Date.now();
    for (let i = wakeParticles.length - 1; i >= 0; i--) {
      const p = wakeParticles[i];
      const elapsed = now - p.startTime;
      if (elapsed >= p.duration) {
        scene.remove(p.mesh);
        p.mesh.material.dispose();
        wakeParticles.splice(i, 1);
      } else {
        const prog = elapsed / p.duration;
        p.mesh.scale.setScalar(1 + prog * 1.6);
        p.mesh.material.opacity = (1 - prog) * 0.8;
      }
    }
  }

  // ── (9) 動物生機動畫即時更新 (定兩點 A ↔ B 來回散步、轉向與搖尾巴) ──
  function updateFauna(elapsedTime) {
    faunaCreatures.forEach(c => {
      // 1. 計算 A ↔ B 兩點來回散步週期 (10 秒一循環：去程 3.8s -> 停留 1.2s -> 回程 3.8s -> 停留 1.2s)
      const cycle = (elapsedTime * (c.walkSpeed || 0.9) + c.phase) % 10.0;
      let u = 0;
      let isWalking = false;
      let dirSign = 1; // +1: A -> B, -1: B -> A

      if (cycle < 3.8) {
        u = cycle / 3.8;
        isWalking = true;
        dirSign = 1;
      } else if (cycle < 5.0) {
        u = 1.0;
        isWalking = false;
        dirSign = 1;
      } else if (cycle < 8.8) {
        u = 1.0 - (cycle - 5.0) / 3.8;
        isWalking = true;
        dirSign = -1;
      } else {
        u = 0.0;
        isWalking = false;
        dirSign = -1;
      }

      // 平滑插值當前位置 (遠離中央建築物與樹木的外環草地)
      const curX = c.ax + (c.bx - c.ax) * u;
      const curZ = c.az + (c.bz - c.az) * u;
      c.mesh.position.x = curX;
      c.mesh.position.z = curZ;

      // 若未處於被點擊的高跳動畫中，加入散步小碎步輕快彈跳
      const isSquashing = activeSquashAnims.some(a => a.mesh === c.mesh);
      if (!isSquashing) {
        const hopY = isWalking ? Math.abs(Math.sin(elapsedTime * 11 + c.phase)) * 0.065 : 0;
        c.mesh.position.y = HEX_HEIGHT + 0.08 + hopY;
      }

      // 計算朝向角度 (動物模型頭部朝向 +X 軸)
      const dx = (c.bx - c.ax) * dirSign;
      const dz = (c.bz - c.az) * dirSign;
      const targetRotY = Math.atan2(-dz, dx);
      const lookAround = isWalking ? 0 : Math.sin(elapsedTime * 3.0 + c.phase) * 0.18;
      c.mesh.rotation.y = targetRotY + lookAround;

      // 尾巴搖擺與鸚鵡點頭細節
      if ((c.type === 'puppy' || c.type === 'cat') && c.tailMesh) {
        c.tailMesh.rotation.y = Math.sin(elapsedTime * 12 + c.phase) * 0.48;
      } else if (c.type === 'cockatoo') {
        c.mesh.rotation.z = Math.sin(elapsedTime * 4.5 + c.phase) * 0.06;
      }
    });

    // 海龜與海豚環形游泳
    swimmingCreatures.forEach(s => {
      const angle = elapsedTime * s.speed + s.phase;
      const x = s.centerX + Math.cos(angle) * s.radiusX;
      const z = s.centerZ + Math.sin(angle) * s.radiusZ;
      s.mesh.position.set(x, 0.05 + Math.sin(elapsedTime * 2.5 + s.phase) * 0.02, z);
      s.mesh.rotation.y = -angle + Math.PI / 2;
    });

    // 小黃鴨隨浪漂浮
    floatingDucks.forEach(d => {
      d.mesh.position.y = d.baseY + Math.sin(elapsedTime * 2.2 + d.bobPhase) * 0.04;
      d.mesh.rotation.z = Math.sin(elapsedTime * 1.8 + d.bobPhase) * 0.08;
      d.mesh.rotation.x = Math.cos(elapsedTime * 1.5 + d.bobPhase) * 0.06;
    });

    // 跳跳魚拋物線躍出海面
    leapingFishList.forEach(fish => {
      const cycle = fish.period;
      const t = (elapsedTime + fish.offset) % cycle;
      if (t < fish.jumpDuration) {
        fish.mesh.visible = true;
        const p = t / fish.jumpDuration;
        const curX = fish.startX + (fish.endX - fish.startX) * p;
        const curZ = fish.startZ + (fish.endZ - fish.startZ) * p;
        const curY = 0.02 + Math.sin(p * Math.PI) * fish.jumpHeight;
        fish.mesh.position.set(curX, curY, curZ);

        const pitch = (0.5 - p) * 1.4;
        fish.mesh.rotation.z = pitch;

        if (p > 0.95 && !fish.rippled) {
          fish.rippled = true;
          createWaterRipple(new THREE.Vector3(fish.endX, 0.05, fish.endZ));
        }
      } else {
        fish.mesh.visible = false;
        fish.rippled = false;
      }
    });
  }

  // ══════════════════════════════════════════════════════════════════════
  // 10. 點擊互動與防視角旋轉衝突之 Raycaster 系統
  // ══════════════════════════════════════════════════════════════════════
  const raycaster = new THREE.Raycaster();
  const mouse = new THREE.Vector2();
  let lastHoverTime = 0;

  function setupRaycaster() {
    // 記錄滑鼠按下起點與時間戳，用於嚴格區分「視角旋轉拖曳」與「短按點擊」
    container.addEventListener('pointerdown', (e) => {
      container._startX = e.clientX;
      container._startY = e.clientY;
      container._startTime = Date.now();
    });

    // 滑鼠移動經過 (Hover Jelly Effect 撥動世界物理反饋)
    // 嚴格節流 ~35ms 確保 60 FPS
    container.addEventListener('pointermove', (e) => {
      const now = Date.now();
      if (now - lastHoverTime < 35) return;
      lastHoverTime = now;

      const rect = renderer.domElement.getBoundingClientRect();
      mouse.x = ((e.clientX - rect.left) / rect.width) * 2 - 1;
      mouse.y = -((e.clientY - rect.top) / rect.height) * 2 + 1;

      raycaster.setFromCamera(mouse, camera);

      const checkList = [];
      if (dragonGroup) checkList.push(dragonGroup);
      if (giantTurtleGroup) checkList.push(giantTurtleGroup);
      if (treasureChests && treasureChests.length > 0) checkList.push(...treasureChests.map(tc => tc.root));
      if (faunaGroup && faunaGroup.children.length > 0) checkList.push(faunaGroup);
      if (islandsGroup && islandsGroup.children.length > 0) checkList.push(islandsGroup);
      if (ferries && ferries.length > 0) checkList.push(...ferries);
      if (celestialPivot) checkList.push(celestialPivot);

      const intersects = raycaster.intersectObjects(checkList, true);

      let isHoverInteractive = false;
      if (intersects.length > 0) {
        let cur = intersects[0].object;
        let wobbleObj = null;

        while (cur && cur !== scene) {
          if (cur.userData) {
            if (cur.userData.isAnimal) {
              wobbleObj = cur.userData.parentCreature || cur;
              isHoverInteractive = true;
              break;
            }
            if (cur.userData.isLighthouse || cur.userData.isSun || cur.userData.isMoon || cur.userData.isFerry) {
              isHoverInteractive = true;
              break;
            }
            if (cur.userData.isWobbleable) {
              wobbleObj = cur.userData.parentWobble || cur;
              isHoverInteractive = true;
              break;
            }
            if (cur.userData.islandId) {
              isHoverInteractive = true;
              break;
            }
          }
          cur = cur.parent;
        }

        if (wobbleObj) {
          triggerJellyWobble(wobbleObj);
        }
      }

      container.style.cursor = isHoverInteractive ? 'pointer' : 'default';
    });

    // 短按點擊 (pointerdown + pointerup 位移 <= 5px 且時間 < 500ms)
    // 徹底避免與 OrbitControls 旋轉視角衝突！
    container.addEventListener('pointerup', (e) => {
      if (container._startX === undefined) return;
      const dx = Math.abs(e.clientX - container._startX);
      const dy = Math.abs(e.clientY - container._startY);
      const elapsed = Date.now() - (container._startTime || 0);

      // 位移超過 5px 或長按超過 500ms 均視為拖曳視角，嚴格不觸發點擊！
      if (dx > 5 || dy > 5 || elapsed > 500) return;

      const rect = renderer.domElement.getBoundingClientRect();
      mouse.x = ((e.clientX - rect.left) / rect.width) * 2 - 1;
      mouse.y = -((e.clientY - rect.top) / rect.height) * 2 + 1;

      raycaster.setFromCamera(mouse, camera);

      const allIntersects = raycaster.intersectObjects(scene.children, true);
      if (allIntersects.length === 0) return;

      // 【最高優先級 1】若點擊射線穿過赤紅巨龍，100% 優先觸發巨龍咆哮噴火
      for (let i = 0; i < allIntersects.length; i++) {
        let testNode = allIntersects[i].object;
        while (testNode && testNode !== scene) {
          if (testNode.userData && testNode.userData.isDragon) {
            triggerDragonInteraction();
            return;
          }
          if (testNode.userData && testNode.userData.isGiantTurtle) {
            setTurtleRideMode(true);
            return;
          }
          testNode = testNode.parent;
        }
      }

      // 【最高優先級 1.5】若點擊射線穿過黃金寶箱，100% 優先開啟寶箱噴射金幣噴泉
      for (let i = 0; i < allIntersects.length; i++) {
        let testNode = allIntersects[i].object;
        while (testNode && testNode !== scene) {
          if (testNode.userData && testNode.userData.isTreasureChest) {
            triggerTreasureChest(testNode.userData.chestIndex ?? 0);
            return;
          }
          testNode = testNode.parent;
        }
      }

      // 【最高優先級 2】若點擊射線穿過 Q 版小動物 (小貓、小狗、小羊、鸚鵡、海龜、海豚、小黃鴨)，優先彈出動物專屬衛教金句
      for (let i = 0; i < allIntersects.length; i++) {
        let testNode = allIntersects[i].object;
        while (testNode && testNode !== scene) {
          if (testNode.userData && testNode.userData.isAnimal) {
            const animalRoot = testNode.userData.parentCreature || testNode;
            triggerAnimalInteraction(animalRoot);
            return;
          }
          testNode = testNode.parent;
        }
      }

      // 依互動優先級尋找命中目標
      for (let i = 0; i < allIntersects.length; i++) {
        const hit = allIntersects[i];
        const cur = hit.object;

        // 1. 太陽或月亮 ➔ 切換日夜模式
        let isSunOrMoon = false;
        let testNode = cur;
        while (testNode && testNode !== scene) {
          if (testNode.userData && (testNode.userData.isSun || testNode.userData.isMoon)) {
            isSunOrMoon = true;
            break;
          }
          testNode = testNode.parent;
        }
        if (isSunOrMoon) {
          toggleDayNight();
          return;
        }

        // 1b. 中古世紀赤紅巨龍 ➔ 咆哮噴火 + 翻騰加速 + 巨龍專屬金句泡泡
        let isDragonHit = false;
        testNode = cur;
        while (testNode && testNode !== scene) {
          if (testNode.userData && testNode.userData.isDragon) {
            isDragonHit = true;
            break;
          }
          testNode = testNode.parent;
        }
        if (isDragonHit) {
          triggerDragonInteraction();
          return;
        }

        // 2. 紅白小燈塔 ➔ 切換日夜模式
        let isLighthouse = false;
        testNode = cur;
        while (testNode && testNode !== scene) {
          if (testNode.userData && testNode.userData.isLighthouse) {
            isLighthouse = true;
            break;
          }
          testNode = testNode.parent;
        }
        if (isLighthouse) {
          toggleDayNight();
          return;
        }

        // 3. 渡船 ➔ 跨海開船啟航
        let ferryIdx = -1;
        testNode = cur;
        while (testNode && testNode !== scene) {
          if (testNode.userData && testNode.userData.isFerry) {
            ferryIdx = testNode.userData.ferryIndex ?? 0;
            break;
          }
          testNode = testNode.parent;
        }
        if (ferryIdx >= 0) {
          launchFerry(ferryIdx);
          return;
        }

        // 4. Q版小動物 ➔ 向上彈跳 (Squash & Jump) + 冷知識泡泡
        let animalRoot = null;
        testNode = cur;
        while (testNode && testNode !== scene) {
          if (testNode.userData && testNode.userData.isAnimal) {
            animalRoot = testNode.userData.parentCreature || testNode;
            break;
          }
          testNode = testNode.parent;
        }
        if (animalRoot) {
          triggerAnimalInteraction(animalRoot);
          return;
        }

        // 5. 島上建築物 ➔ 向上彈跳 + 健康/理財泡泡
        let buildingRoot = null;
        testNode = cur;
        while (testNode && testNode !== scene) {
          if (testNode.userData && testNode.userData.isBuilding) {
            buildingRoot = testNode.userData.parentBuilding || testNode;
            break;
          }
          testNode = testNode.parent;
        }
        if (buildingRoot) {
          playIslandSound('building');
          triggerSquash(buildingRoot);
          const worldPos = new THREE.Vector3();
          buildingRoot.getWorldPosition(worldPos);
          showSpeechBubble(worldPos);
          return;
        }

        // 6. 島嶼本體 / 島嶼地面 ➔ 聚焦登陸開啟側邊抽屜
        let islandId = null;
        testNode = cur;
        while (testNode && testNode !== scene) {
          if (testNode.userData && testNode.userData.islandId) {
            islandId = testNode.userData.islandId;
            break;
          }
          testNode = testNode.parent;
        }
        if (islandId) {
          focusIsland(islandId);
          return;
        }

        // 7. 海洋水面點擊 ➔ 生成向外擴散的水波紋
        if (cur === oceanMesh || (cur.userData && cur.userData.isOcean)) {
          playIslandSound('water');
          createWaterRipple(hit.point);
          return;
        }
      }
    });
  }

  // ══════════════════════════════════════════════════════════════════════
  // 11. 平滑相機飛行與島嶼登陸
  // ══════════════════════════════════════════════════════════════════════
  function focusIsland(islandId) {
    exitBirdViewSilently();
    exitDragonRideSilently();
    exitTurtleRideSilently();
    const island = ISLAND_DATA.find((i) => i.id === islandId);
    if (!island) return;
    playIslandSound('island');

    activeIsland = islandId;

    // 1. 更新反白光圈
    islandObjectsMap.forEach((obj, id) => {
      if (obj.userData.selectionRing) {
        obj.userData.selectionRing.material.opacity = id === islandId ? 0.95 : 0;
      }
    });

    // 2. 開啟左側全文章抽屜
    openDetailCard(island);

    // 3. 高亮右側導覽列並在手機版收合目錄
    highlightSidebarRow(islandId);
    if (window.innerWidth <= 900) {
      const sidebar = document.getElementById('islandNavSidebar');
      const toggleSidebarBtn = document.getElementById('toggleSidebarBtn');
      if (sidebar) sidebar.classList.remove('open-mobile');
      if (toggleSidebarBtn) toggleSidebarBtn.classList.remove('active');
    }

    // 4. 計算沿著地球地平線傾角飛行之相機目標點
    const obj = islandObjectsMap.get(islandId);
    const center = obj.position;
    const normal = obj.userData.normal;

    // 相機停在島嶼斜上方，完美微縮俯瞰整個中世紀島嶼與建築群
    cameraDestPos = center.clone().add(new THREE.Vector3(0, 14.5, 17.5));
    cameraTarget = center.clone().add(new THREE.Vector3(0, 1.2, 0));

    startCameraFlight(cameraDestPos, cameraTarget, 1200);
  }

  function resetView() {
    exitBirdViewSilently();
    exitDragonRideSilently();
    exitTurtleRideSilently();
    activeIsland = null;
    closeDetailCard();

    islandObjectsMap.forEach((obj) => {
      if (obj.userData.selectionRing) obj.userData.selectionRing.material.opacity = 0;
    });

    document.querySelectorAll('.sidebar-island-row').forEach(r => r.classList.remove('active'));

    const overviewLookAt = new THREE.Vector3(0, 0, 0);
    const overviewPos = new THREE.Vector3(0, 54, 70);
    startCameraFlight(overviewPos, overviewLookAt, 1400);
  }

  function startCameraFlight(destPos, destLookAt, durationMs) {
    flightStartPos.copy(camera.position);
    flightStartLookAt.copy(controls.target);
    cameraDestPos.copy(destPos);
    cameraTarget.copy(destLookAt);

    flightStartTime = performance.now();
    flightDuration = durationMs;
    isFlightActive = true;
    controls.enabled = false;
    controls.autoRotate = false;
  }

  function updateCameraFlight() {
    if (!isFlightActive) return;

    const elapsed = performance.now() - flightStartTime;
    const progress = Math.min(elapsed / flightDuration, 1);
    const ease = progress < 0.5
      ? 4 * progress * progress * progress
      : 1 - Math.pow(-2 * progress + 2, 3) / 2;

    camera.position.lerpVectors(flightStartPos, cameraDestPos, ease);
    controls.target.lerpVectors(flightStartLookAt, cameraTarget, ease);

    if (progress >= 1) {
      isFlightActive = false;
      controls.enabled = true;
      if (isBirdView) { controls.autoRotate = true; controls.autoRotateSpeed = 0.6; }
    }
  }

  // ══════════════════════════════════════════════════════════════════════
  // 12. UI 面板與互動事件 (支援全文章展示與島內搜尋)
  // ══════════════════════════════════════════════════════════════════════
  let currentDrawerArticles = [];

  function setupUI() {
    // 星系切換鈕
    const realmPills = document.querySelectorAll('.realm-pill');
    realmPills.forEach((pill) => {
      pill.addEventListener('click', () => {
        realmPills.forEach(p => p.classList.remove('active'));
        pill.classList.add('active');
        filterRealm(pill.dataset.realm);
      });
    });

    // 🌙/☀️ 日夜平滑切換快捷鈕 (HUD 右上角)
    const dayNightQuickToggle = document.getElementById('dayNightQuickToggle');
    if (dayNightQuickToggle) {
      dayNightQuickToggle.addEventListener('click', () => {
        toggleDayNight();
      });
    }

    // 🐉 騎乘飛龍 / 🐢 騎乘大海龜 視角切換按鈕與底部懸浮控制列
    const summonDragonBtn = document.getElementById('summonDragonBtn');
    if (summonDragonBtn) {
      summonDragonBtn.addEventListener('click', () => {
        toggleDragonRideMode();
      });
    }
    const summonTurtleBtn = document.getElementById('summonTurtleBtn');
    if (summonTurtleBtn) {
      summonTurtleBtn.addEventListener('click', () => {
        toggleTurtleRideMode();
      });
    }
    const dragonFloatExitBtn = document.getElementById('dragonFloatExitBtn');
    if (dragonFloatExitBtn) {
      dragonFloatExitBtn.addEventListener('click', () => {
        if (isTurtleRideMode) setTurtleRideMode(false);
        else setDragonRideMode(false);
      });
    }
    const dragonFloatFireBtn = document.getElementById('dragonFloatFireBtn');
    if (dragonFloatFireBtn) {
      dragonFloatFireBtn.addEventListener('click', () => {
        if (isTurtleRideMode) triggerGiantTurtleInteraction();
        else triggerDragonInteraction();
      });
    }

    // ✨ 天氣魔法切換按鈕 (晴空 / 飄雪 / 黃金楓葉 / 許願流星雨)
    const weatherMagicBtn = document.getElementById('weatherMagicBtn');
    if (weatherMagicBtn) {
      weatherMagicBtn.addEventListener('click', () => {
        cycleWeatherMagic();
      });
    }
    document.querySelectorAll('.weather-opt-btn').forEach(opt => {
      opt.addEventListener('click', (e) => {
        e.stopPropagation();
        const mode = opt.dataset.weather;
        if (mode) setWeatherMode(mode);
      });
    });

    // 🔊 音效開關切換按鈕
    const toggleSoundBtn = document.getElementById('toggleSoundBtn');
    if (toggleSoundBtn) {
      toggleSoundBtn.addEventListener('click', () => {
        soundEnabled = !soundEnabled;
        toggleSoundBtn.classList.toggle('active', soundEnabled);
        const sIcon = document.getElementById('soundBtnIcon');
        const sText = document.getElementById('soundBtnText');
        if (sIcon) sIcon.textContent = soundEnabled ? '🔊' : '🔇';
        if (sText) sText.textContent = soundEnabled ? '音效' : '靜音';
        if (soundEnabled) {
          playIslandSound('magic');
          showMiniToast('🔊 3D 小島互動音效已開啟！（點擊巨龍、小動物、寶箱、海面皆有專屬音效）');
        } else {
          showMiniToast('🔇 已切換為靜音模式');
        }
      });
    }

    // 光照時序鈕
    const timeBtns = document.querySelectorAll('.time-btn');
    timeBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        timeBtns.forEach(b => b.classList.remove('active'));
        btn.classList.add('active');
        applyTimePreset(btn.dataset.time);
      });
    });

    // 標籤開關
    const toggleLabelsBtn = document.getElementById('toggleLabelsBtn');
    toggleLabelsBtn.addEventListener('click', () => {
      showLabels = !showLabels;
      toggleLabelsBtn.classList.toggle('active', showLabels);
      badgeObjects.forEach(b => b.classList.toggle('labels-hidden', !showLabels));
    });

    // 漫步小人開關
    const toggleWalkersBtn = document.getElementById('toggleWalkersBtn');
    toggleWalkersBtn.addEventListener('click', () => {
      showWalkers = !showWalkers;
      toggleWalkersBtn.classList.toggle('active', showWalkers);
      walkersGroup.visible = showWalkers;
    });

    // 能量光流開關
    const toggleFlowsBtn = document.getElementById('toggleFlowsBtn');
    toggleFlowsBtn.addEventListener('click', () => {
      showFlows = !showFlows;
      toggleFlowsBtn.classList.toggle('active', showFlows);
      flowsGroup.visible = showFlows;
    });

    // 全景重置按鈕
    document.getElementById('resetCamBtn').addEventListener('click', resetView);

    // 鳥瞰模式 (升空 + 緩慢環繞；使用者一拖曳即停止自轉)
    document.getElementById('birdViewBtn').addEventListener('click', () => setBirdView(!isBirdView));
    controls.addEventListener('start', () => { if (isBirdView) controls.autoRotate = false; });

    // 側邊欄切換
    const sidebar = document.getElementById('islandNavSidebar');
    const toggleSidebarBtn = document.getElementById('toggleSidebarBtn');
    toggleSidebarBtn.addEventListener('click', () => {
      if (window.innerWidth <= 900) {
        sidebar.classList.toggle('open-mobile');
        toggleSidebarBtn.classList.toggle('active', sidebar.classList.contains('open-mobile'));
        if (sidebar.classList.contains('open-mobile')) {
          closeDetailCard();
        }
      } else {
        sidebar.classList.toggle('collapsed');
        toggleSidebarBtn.classList.toggle('active', !sidebar.classList.contains('collapsed'));
      }
    });

    // 關閉左側卡片
    document.getElementById('closeDetailBtn').addEventListener('click', closeDetailCard);

    // 填入右側導覽列清單
    populateSidebar();

    // 右側側邊欄搜尋
    const searchInput = document.getElementById('islandSearchInput');
    searchInput.addEventListener('input', (e) => {
      const query = e.target.value.trim().toLowerCase();
      filterSidebarBySearch(query);
    });

    // 抽屜內全文章搜尋過濾框
    const drawerSearch = document.getElementById('drawerArticleSearch');
    drawerSearch.addEventListener('input', (e) => {
      const query = e.target.value.trim().toLowerCase();
      renderDrawerArticles(query);
    });

    // 鍵盤 Esc 關閉抽屜
    window.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') {
        closeDetailCard();
      }
    });
  }

  // 填入右側島嶼清單
  function populateSidebar() {
    const healthContainer = document.getElementById('healthItems');
    const wisdomContainer = document.getElementById('wisdomItems');

    healthContainer.innerHTML = '';
    wisdomContainer.innerHTML = '';

    let totalHealthArticles = 0;
    let totalWisdomArticles = 0;

    ISLAND_DATA.forEach((island) => {
      const count = island.articles.length;
      if (island.realm === 'health') totalHealthArticles += count;
      else totalWisdomArticles += count;

      const row = document.createElement('div');
      row.className = 'sidebar-island-row';
      row.dataset.islandId = island.id;
      row.dataset.islandName = island.name.toLowerCase();
      row.dataset.islandSubtitle = island.subtitle.toLowerCase();
      row.innerHTML = `
        <div class="sidebar-island-main">
          <div class="sidebar-island-icon">${island.icon}</div>
          <span class="sidebar-island-name">${island.name}</span>
        </div>
        <span class="sidebar-island-tag">${count}篇</span>
      `;
      row.addEventListener('click', () => {
        focusIsland(island.id);
      });

      if (island.realm === 'health') {
        healthContainer.appendChild(row);
      } else {
        wisdomContainer.appendChild(row);
      }
    });

    const healthIslandsCount = ISLAND_DATA.filter(i => i.realm === 'health').length;
    const wisdomIslandsCount = ISLAND_DATA.filter(i => i.realm === 'wisdom').length;
    document.getElementById('healthTotalStat').textContent = `${healthIslandsCount} 座群島 · ${totalHealthArticles} 篇專文`;
    document.getElementById('wisdomTotalStat').textContent = `${wisdomIslandsCount} 部名著 · ${totalWisdomArticles} 篇章節`;
  }

  function highlightSidebarRow(islandId) {
    document.querySelectorAll('.sidebar-island-row').forEach((row) => {
      row.classList.toggle('active', row.dataset.islandId === islandId);
    });
  }

  function filterSidebarBySearch(query) {
    document.querySelectorAll('.sidebar-island-row').forEach((row) => {
      const name = row.dataset.islandName;
      const sub = row.dataset.islandSubtitle;
      const match = !query || name.includes(query) || sub.includes(query);
      row.style.display = match ? 'flex' : 'none';
    });
  }

  function filterRealm(realm) {
    islandsGroup.children.forEach((group) => {
      const data = group.userData.islandData;
      if (!data) return;
      const visible = realm === 'all' || data.realm === realm;
      group.visible = visible;
    });

    bridgesGroup.children.forEach((b) => {
      if (b.userData && b.userData.realm) {
        b.visible = (realm === 'all' || b.userData.realm === realm);
      }
    });

    walkers.forEach((w) => {
      const island = ISLAND_DATA.find(i => i.id === w.currentIsland);
      if (island && w.group) {
        w.group.visible = showWalkers && (realm === 'all' || island.realm === realm);
      }
    });

    document.querySelectorAll('.realm-group').forEach((group) => {
      const groupRealm = group.dataset.realmGroup;
      const visible = realm === 'all' || groupRealm === realm;
      group.style.display = visible ? 'block' : 'none';
    });

    if (activeIsland) {
      const activeData = ISLAND_DATA.find(i => i.id === activeIsland);
      if (activeData && realm !== 'all' && activeData.realm !== realm) {
        resetView();
      }
    }
  }

  // 開啟左側抽屜並載入「全文章與章節」
  function openDetailCard(island) {
    const drawer = document.getElementById('islandDetailCard');
    const realmTag = document.getElementById('cardRealmTag');
    const icon = document.getElementById('cardIcon');
    const title = document.getElementById('cardTitle');
    const subtitle = document.getElementById('cardSubtitle');
    const desc = document.getElementById('cardDesc');
    const ctaBtn = document.getElementById('cardCtaBtn');
    const drawerSearch = document.getElementById('drawerArticleSearch');

    realmTag.textContent = island.realm === 'health' ? '🏥 醫學筆島群' : '📚 讀書筆記島群';
    realmTag.classList.toggle('wisdom-style', island.realm === 'wisdom');

    icon.textContent = island.icon;
    title.textContent = island.name;
    subtitle.textContent = island.subtitle;
    desc.textContent = island.desc;

    ctaBtn.href = island.ctaUrl;
    ctaBtn.querySelector('span').textContent = island.ctaText;

    // 清空抽屜搜尋欄並重置當前文章清單，且自動將捲軸歸零回到第 1 篇
    drawerSearch.value = '';
    currentDrawerArticles = island.articles;
    renderDrawerArticles('');
    const pinsSec = document.querySelector('.card-pins-section');
    if (pinsSec) pinsSec.scrollTop = 0;

    drawer.classList.add('open');
    drawer.setAttribute('aria-hidden', 'false');
  }

  // 渲染抽屜內全文章列表 (保留 100% 原始標題)
  function renderDrawerArticles(filterText) {
    const pinList = document.getElementById('cardPinList');
    const countBadge = document.getElementById('drawerArticlesCount');

    const filtered = currentDrawerArticles.filter(art => {
      if (!filterText) return true;
      return art.title.toLowerCase().includes(filterText) ||
             (art.category && art.category.toLowerCase().includes(filterText));
    });

    countBadge.textContent = `${filtered.length} 篇`;

    if (filtered.length === 0) {
      pinList.innerHTML = `
        <div style="text-align: center; padding: 24px 10px; color: #8aa4b2; font-size: 0.86rem; font-weight: 600;">
          無相符文章或章節
        </div>
      `;
      return;
    }

    pinList.innerHTML = filtered.map((art, idx) => `
      <a href="${art.url}" class="pin-item-card" target="_blank" rel="noopener">
        <div class="pin-num">${idx + 1}</div>
        <div class="pin-text-col">
          <div class="pin-title">${art.title}</div>
          <div class="pin-sub">${art.category}</div>
        </div>
        <svg class="pin-arrow-ic" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="9 18 15 12 9 6"/></svg>
      </a>
    `).join('');
  }

  function closeDetailCard() {
    const drawer = document.getElementById('islandDetailCard');
    drawer.classList.remove('open');
    drawer.setAttribute('aria-hidden', 'true');
    if (activeIsland) {
      const islandObj = islandObjectsMap.get(activeIsland);
      if (islandObj && islandObj.userData.selectionRing) {
        islandObj.userData.selectionRing.material.opacity = 0;
      }
      activeIsland = null;
    }
    document.querySelectorAll('.sidebar-island-row').forEach(r => r.classList.remove('active'));
  }

  function onWindowResize() {
    const width = container.clientWidth;
    const height = container.clientHeight;
    camera.aspect = width / height;
    camera.updateProjectionMatrix();
    renderer.setSize(width, height);
    cssRenderer.setSize(width, height);
  }

  // ── 巨龍與坐騎螢幕空間防遮擋系統 (防止島名膠囊蓋住 3D 赤紅巨龍與大海龜) ──
  const _occVec = new THREE.Vector3();
  function _projectLocalToScreen(group, lx, ly, lz, W, H) {
    _occVec.set(lx, ly, lz).applyMatrix4(group.matrixWorld).project(camera);
    return {
      x: (_occVec.x * 0.5 + 0.5) * W,
      y: (-_occVec.y * 0.5 + 0.5) * H,
      z: _occVec.z
    };
  }

  function _distToSegmentSq(px, py, x1, y1, x2, y2) {
    const dx = x2 - x1;
    const dy = y2 - y1;
    const lenSq = dx * dx + dy * dy;
    let t = 0;
    if (lenSq > 0.0001) {
      t = ((px - x1) * dx + (py - y1) * dy) / lenSq;
      if (t < 0) t = 0;
      else if (t > 1) t = 1;
    }
    const cx = x1 + t * dx - px;
    const cy = y1 + t * dy - py;
    return cx * cx + cy * cy;
  }

  function updateBadgeOcclusion() {
    const W = container.clientWidth || window.innerWidth;
    const H = container.clientHeight || window.innerHeight;
    const inRide = isDragonRideMode || isTurtleRideMode;

    // 1. 騎乘飛龍或大海龜時，徹底隱藏坐騎自身頭頂名牌與次要小標籤
    if (dragonData && dragonData.dragonBadge) {
      dragonData.dragonBadge.classList.toggle('ride-hidden', inRide);
      if (dragonData.dragonLabelObj) {
        dragonData.dragonLabelObj.visible = !inRide && showLabels;
      }
    }
    if (giantTurtleData && giantTurtleData.turtleBadge) {
      giantTurtleData.turtleBadge.classList.toggle('ride-hidden', inRide);
      if (giantTurtleData.turtleLabelObj) {
        giantTurtleData.turtleLabelObj.visible = !inRide && showLabels;
      }
    }

    // 2. 計算赤紅巨龍在 2D 螢幕上的軀幹軸線 (龍吻↔龍尾) 與雙翼軸線 (左翼尖↔右翼尖)
    let hasDragon = false;
    let snout2D, tail2D, wingL2D, wingR2D, crest2D, spineRad = 0, wingRad = 0;
    if (dragonData && dragonData.group) {
      snout2D = _projectLocalToScreen(dragonData.group, 0, 0.45, 2.95, W, H);
      tail2D = _projectLocalToScreen(dragonData.group, 0, 0.0, -4.55, W, H);
      wingL2D = _projectLocalToScreen(dragonData.group, -3.85, 0.25, -0.25, W, H);
      wingR2D = _projectLocalToScreen(dragonData.group, 3.85, 0.25, -0.25, W, H);
      crest2D = _projectLocalToScreen(dragonData.group, 0, 2.35, 0, W, H);
      if (snout2D.z < 1 && tail2D.z < 1) {
        hasDragon = true;
        const wingSpanPx = Math.hypot(wingR2D.x - wingL2D.x, wingR2D.y - wingL2D.y);
        const spineLenPx = Math.hypot(snout2D.x - tail2D.x, snout2D.y - tail2D.y);
        const scalePx = Math.max(wingSpanPx, spineLenPx);
        spineRad = Math.max(26, scalePx * (isDragonRideMode ? 0.19 : 0.15));
        wingRad = Math.max(30, scalePx * (isDragonRideMode ? 0.23 : 0.19));
      }
    }

    // 3. 若在騎龜模式，計算大海龜螢幕中心安全區
    let hasTurtleRide = false;
    let turtle2D;
    if (isTurtleRideMode && giantTurtleData && giantTurtleData.group) {
      turtle2D = _projectLocalToScreen(giantTurtleData.group, 0, 0.5, 0, W, H);
      if (turtle2D.z < 1) hasTurtleRide = true;
    }

    // 4. 逐一檢查所有 3D 標籤是否與巨龍 / 坐騎重疊
    for (let i = 0; i < badgeObjects.length; i++) {
      const el = badgeObjects[i];
      const kind = el._badgeKind;
      if (!el._css2dObj || kind === 'dragon') continue;

      // 騎乘模式下自動隱藏動物與碼頭次要小標籤，保持視野純淨
      if (kind === 'animal' || kind === 'pier') {
        el.classList.toggle('ride-hidden', inRide);
        if (inRide) continue;
      }

      // 檢查標籤所在島嶼或父節點是否可見
      let p = el._css2dObj.parent;
      let parentVisible = true;
      while (p) {
        if (p.visible === false) { parentVisible = false; break; }
        p = p.parent;
      }
      if (!parentVisible) continue;

      el._css2dObj.getWorldPosition(_occVec);
      _occVec.project(camera);
      if (_occVec.z > 1 || _occVec.z < -1) {
        el.classList.remove('dragon-occluded');
        continue;
      }

      const bx = (_occVec.x * 0.5 + 0.5) * W;
      const by = (-_occVec.y * 0.5 + 0.5) * H - 10;
      const bw = kind === 'island' ? 38 : 22;
      const bh = kind === 'island' ? 11 : 8;

      let occluded = false;
      if (hasDragon) {
        const sThreshSq = (spineRad + bh) * (spineRad + bh);
        const wThreshSq = (wingRad + bh) * (wingRad + bh);
        // 檢測膠囊左、中、右三點是否觸碰巨龍軀幹或雙翼
        for (let k = -1; k <= 1; k++) {
          const px = bx + k * bw;
          if (
            _distToSegmentSq(px, by, snout2D.x, snout2D.y, tail2D.x, tail2D.y) < sThreshSq ||
            _distToSegmentSq(px, by, wingL2D.x, wingL2D.y, wingR2D.x, wingR2D.y) < wThreshSq
          ) {
            occluded = true;
            break;
          }
        }
        // 一般視角下，若島名膠囊與巨龍頭頂名牌重疊，亦優先讓位給巨龍名牌
        if (!occluded && !inRide && crest2D && showLabels) {
          if (Math.abs(bx - crest2D.x) < 56 + bw && Math.abs(by - crest2D.y) < 18 + bh) {
            occluded = true;
          }
        }
      }

      if (!occluded && hasTurtleRide && kind !== 'turtle') {
        const dx = Math.abs(bx - turtle2D.x);
        const dy = Math.abs(by - turtle2D.y);
        if (dx < 85 + bw && dy < 65 + bh) {
          occluded = true;
        }
      }

      el.classList.toggle('dragon-occluded', occluded);
    }
  }

  // ══════════════════════════════════════════════════════════════════════
  // 13. 主渲染迴圈
  // ══════════════════════════════════════════════════════════════════════
  function animate() {
    requestAnimationFrame(animate);

    const now = Date.now();
    const elapsedTime = now * 0.001;

    // 1. 180s 日夜循環光影與天空星空更新
    updateDayNightCycle(elapsedTime);

    // 2. 動態海浪與慢速漂浮白雲更新
    updateWavesAndClouds(elapsedTime);

    // 2. 能量光流粒子在大氣層高空飛掠
    if (showFlows) {
      flowCurves.forEach((item) => {
        item.progress = (item.progress + item.speed) % 1;
        const pos = item.curve.getPointAt(item.progress);
        item.photon.position.copy(pos);
      });
    }

    // 3. 漫步微型小人移動更新
        // 飛鳥群 8 字型立體盤旋飛行與扇動翅膀
    if (birdFlockData && birdFlockData.birds) {
      birdFlockData.birds.forEach((bird) => {
        const u = bird.userData;
        if (u) {
          const t = elapsedTime * (u.speed || 1.0) + (u.phase || 0);
          bird.position.y = u.baseY + Math.sin(t * 2.5) * 0.45;
          bird.position.x = u.baseX + Math.sin(t * 0.8) * 1.5;
          bird.rotation.z = Math.sin(t * 3.0) * 0.12;
        }
      });
    }

    updateWalkers();

    // 4b. 中世紀微縮奇幻模型生機動畫 (風車旋轉、旗幟飄揚、營火微光)
    animatedWindmills.forEach((wm) => {
      wm.mesh.rotation.z += (wm.speed || 0.014);
    });
    animatedFlags.forEach((item) => {
      item.mesh.rotation.y = item.baseRotY + Math.sin(elapsedTime * (item.speed || 3.0) + (item.phase || 0)) * 0.22;
    });
    animatedCampfires.forEach((cf) => {
      cf.light.intensity = cf.baseIntensity + (Math.sin(elapsedTime * 8) + Math.cos(elapsedTime * 13)) * 0.15;
    });

    // 4. 書卷水晶微幅漂浮旋轉
    islandsGroup.traverse((child) => {
      if (child.userData && child.userData.isFloatingGem) {
        child.rotation.y += 0.02;
        child.position.y = HEX_HEIGHT + 1.25 + Math.sin(now * 0.003 * child.userData.baseSpeed) * 0.08;
      }
    });

    // 5. 療癒微縮世界互動更新 (赤紅巨龍、聖劍大海龜、黃金寶箱、天氣魔法、動物生機、果凍物理、彈跳縮放、水波紋、船尾水花)
    updateRedDragon(elapsedTime);
    updateGiantSeaTurtle(elapsedTime);
    updateTreasureChests(elapsedTime);
    updateWeatherMagic(elapsedTime);
    updateFauna(elapsedTime);
    updateJellyAnims();
    updateSquashAnims();
    updateWaterRipples();
    updateWakeParticles();

    // 6. 相機飛行補間更新
    updateCameraFlight();

    // 騎乘赤紅巨龍或大海龜時暫時停用 controls.update，由 requestAnimationFrame 動態更新追尾攝影機
    if (!isDragonRideMode && !isTurtleRideMode) {
      controls.update();
    }
    renderer.render(scene, camera);
    updateBadgeOcclusion();
    cssRenderer.render(scene, camera);
  }

  // 啟動 3D 微縮星球世界
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', init);
  } else {
    init();
  }
</script>
