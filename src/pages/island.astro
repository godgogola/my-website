  // ══════════════════════════════════════════════════════════════════════
  // 6. 建造雙層六角建築底座與微縮島嶼 (Double-layer Hex Toy Islands)
  // ══════════════════════════════════════════════════════════════════════
  function buildIslands() {
    ISLAND_DATA.forEach((island) => {
      const proj = hexToPlanet(island.q, island.r, island.realm);
      const group = new THREE.Group();
      group.position.copy(proj.position);
      group.quaternion.copy(proj.orientation);
      group.userData = {
        islandId: island.id,
        islandData: island,
        normal: proj.normal,
        worldCenter: proj.position.clone()
      };

      // 1. 底層外框層：白色/淺米灰色六角形石材堤防邊框 (CylinderGeometry 6 邊柱體)
      const baseCurbGeo = new THREE.CylinderGeometry(HEX_RADIUS, HEX_RADIUS, HEX_HEIGHT, 6, 1);
      const baseCurbMat = new THREE.MeshStandardMaterial({
        color: 0xf1f5f9,
        roughness: 0.65,
        metalness: 0.05,
        flatShading: true
      });
      const baseCurb = new THREE.Mesh(baseCurbGeo, baseCurbMat);
      baseCurb.position.y = HEX_HEIGHT / 2;
      baseCurb.castShadow = true;
      baseCurb.receiveShadow = true;
      group.add(baseCurb);

      // 2. 頂層主題地面層：內圈依衛教主題換成不同粉彩馬卡龍顏色 (如鵝黃、清新草綠、醫療灰白、粉橘等)
      const themeColor = THEME_FLOOR_COLORS[island.id] || island.color || 0xfef08a;
      const topFloorGeo = new THREE.CylinderGeometry(HEX_RADIUS * 0.93, HEX_RADIUS * 0.93, 0.08, 6, 1);
      const topFloorMat = new THREE.MeshStandardMaterial({
        color: themeColor,
        roughness: 0.72,
        metalness: 0.02,
        flatShading: true
      });
      const topFloor = new THREE.Mesh(topFloorGeo, topFloorMat);
      topFloor.position.y = HEX_HEIGHT + 0.04;
      topFloor.castShadow = true;
      topFloor.receiveShadow = true;
      group.add(topFloor);

      // 3. 在沒有連接橋樑的邊緣加上精巧迷你白色欄杆與小路燈
      addHexEdgeRailingsAndLamps(group, island);

      // 4. 水岸微白浪花光環
      createShoreFoamRings(group);

      // 5. 連接各橋頭之平整白色步道
      addPlazaWalkways(group, island);

      // 6. 島嶼地表微縮地標、可愛疊球樹、3~5 微型小人偶與生活細節
      populateMiniatureCity(group, island);

      // 7. 選取反白光圈 (Selection Beacon Ring)
      const ringGeo = new THREE.RingGeometry(HEX_RADIUS * 1.05, HEX_RADIUS * 1.15, 32);
      const ringMat = new THREE.MeshBasicMaterial({
        color: 0xffffff,
        side: THREE.DoubleSide,
        transparent: true,
        opacity: 0,
        depthWrite: false
      });
      const ringMesh = new THREE.Mesh(ringGeo, ringMat);
      ringMesh.rotation.x = -Math.PI / 2;
      ringMesh.position.y = HEX_HEIGHT + 0.082;
      group.add(ringMesh);
      group.userData.selectionRing = ringMesh;

      // 8. CSS2D 輕量化懸浮標籤 (白底圓角小膠囊風格)
      const badgeDiv = document.createElement('div');
      badgeDiv.className = `island-3d-badge ${island.realm}`;
      badgeDiv.innerHTML = `
        <div class="island-3d-badge-inner">
          <span class="badge-title">${island.shortName}</span>
          <span class="badge-pins-count">${island.articles.length}篇</span>
        </div>
        <div class="badge-arrow"></div>
      `;
      badgeDiv.addEventListener('click', (e) => {
        e.stopPropagation();
        focusIsland(island.id);
      });

      const staggerY = HEX_HEIGHT + 1.95 + (Math.abs(island.q * 3 + island.r) % 3) * 0.28;
      const badgeObj = new CSS2DObject(badgeDiv);
      badgeObj.position.set(0, staggerY, 0);
      badgeDiv._css2dObj = badgeObj;
      badgeDiv._badgeKind = 'island';
      group.add(badgeObj);
      badgeObjects.push(badgeDiv);

      // 9. 島嶼主光源：夜間開啟、白天為 0，真實暖光立體照亮 3D 建築與樹木
      const pLight = new THREE.PointLight(0xff9933, 0, 18, 1.35);
      pLight.position.set(0, HEX_HEIGHT + 2.2, 0);
      group.add(pLight);
      nightPointLights.push(pLight);

      islandsGroup.add(group);
      islandObjectsMap.set(island.id, group);
    });
  }

  // ── 中世紀鍛鐵吊臂路燈 (木柱燈桿 + 鍛鐵橫臂 + 提燈燈籠 + 地面發光圓盤) ──
  function createMedievalStreetLamp(facingAngle = 0) {
    const lampGroup = new THREE.Group();

    // 1. 深褐色細圓柱燈桿
    const woodDarkMat = new THREE.MeshStandardMaterial({ color: 0x451a03, roughness: 0.85 });
    const ironMat = new THREE.MeshStandardMaterial({ color: 0x1e293b, roughness: 0.6, metalness: 0.7 });

    const pole = new THREE.Mesh(
      new THREE.CylinderGeometry(0.022, 0.034, 0.68, 6),
      woodDarkMat
    );
    pole.position.y = 0.34;
    pole.castShadow = true;
    lampGroup.add(pole);

    // 2. 頂部橫向短支架 (鍛鐵吊臂) 與 45° 斜撐
    const armGroup = new THREE.Group();
    armGroup.position.y = 0.64;
    armGroup.rotation.y = facingAngle;

    const arm = new THREE.Mesh(
      new THREE.BoxGeometry(0.18, 0.022, 0.022),
      ironMat
    );
    arm.position.x = 0.09;
    armGroup.add(arm);

    const brace = new THREE.Mesh(
      new THREE.BoxGeometry(0.08, 0.016, 0.016),
      ironMat
    );
    brace.position.set(0.045, -0.04, 0);
    brace.rotation.z = Math.PI / 4;
    armGroup.add(brace);

    // 3. 懸掛一個小巧八角柱提燈燈籠 (夜晚亮起溫暖琥珀橘黃光 0xffaa33)
    const lantern = new THREE.Mesh(
      new THREE.CylinderGeometry(0.042, 0.052, 0.09, 8),
      nightLanternMaterial
    );
    lantern.position.set(0.15, -0.065, 0);
    lantern.castShadow = true;
    armGroup.add(lantern);

    // 燈籠黑鐵頂蓋
    const lanternCap = new THREE.Mesh(
      new THREE.ConeGeometry(0.056, 0.042, 8),
      ironMat
    );
    lanternCap.position.set(0.15, -0.01, 0);
    armGroup.add(lanternCap);

    lampGroup.add(armGroup);

    // 4. 地面受光效果：平貼稍微浮起 (y + 0.02) 的半透明漸層發光小圓盤
    const groundPoolGeo = new THREE.CircleGeometry(0.85, 14);
    const groundPool = new THREE.Mesh(groundPoolGeo, groundLightPoolMaterial);
    groundPool.rotation.x = -Math.PI / 2;
    // 光斑位置稍微偏移至提燈正下方
    groundPool.position.set(Math.cos(facingAngle) * 0.15, 0.02, -Math.sin(facingAngle) * 0.15);
    lampGroup.add(groundPool);

    return lampGroup;
  }

  // ── 六角堤防未連橋邊緣：迷你欄杆與中世紀鍛鐵吊臂路燈 ──
  function addHexEdgeRailingsAndLamps(group, island) {
    const byId = new Map();
    ISLAND_DATA.forEach((d) => byId.set(d.id, d));

    const connectedNeighborAngles = [];
    ALL_SCENIC_BRIDGES.forEach(([idA, idB]) => {
      let nId = null;
      if (idA === island.id) nId = idB;
      else if (idB === island.id) nId = idA;
      if (nId) {
        const neighbor = byId.get(nId);
        if (neighbor) {
          const dq = neighbor.q - island.q;
          const dr = neighbor.r - island.r;
          const dx = SPACING * (Math.sqrt(3) * dq + (Math.sqrt(3) / 2) * dr);
          const dz = SPACING * (1.5 * dr);
          const ang = Math.atan2(dx, dz);
          connectedNeighborAngles.push(ang);
        }
      }
    });

    const railingMat = new THREE.MeshStandardMaterial({
      color: 0xffffff,
      roughness: 0.35,
      metalness: 0.1
    });
    const postMat = new THREE.MeshStandardMaterial({
      color: 0xe2e8f0,
      roughness: 0.45
    });

    const rApothem = HEX_RADIUS * Math.cos(Math.PI / 6); // 邊心距
    let placedLampsCount = 0;

    // 6 個六角形邊的中心角度 (30°, 90°, 150°, 210°, 270°, 330°)
    for (let k = 0; k < 6; k++) {
      const edgeAngle = (k * 60 + 30) * (Math.PI / 180);
      // 檢查此邊是否與任一相連橋樑方向對齊
      const hasBridge = connectedNeighborAngles.some((bAng) => {
        let diff = Math.abs(bAng - edgeAngle);
        while (diff > Math.PI) diff = Math.abs(diff - Math.PI * 2);
        return diff < 0.32;
      });

      if (!hasBridge) {
        // 沒有連接橋樑之邊緣，加上精巧迷你白色欄杆
        const edgeGroup = new THREE.Group();
        const ex = Math.sin(edgeAngle) * (rApothem * 0.96);
        const ez = Math.cos(edgeAngle) * (rApothem * 0.96);
        edgeGroup.position.set(ex, HEX_HEIGHT + 0.08, ez);
        edgeGroup.rotation.y = edgeAngle + Math.PI / 2; // 與邊緣切線平行

        // 橫桿
        const railBar = new THREE.Mesh(
          new THREE.BoxGeometry(HEX_RADIUS * 0.82, 0.035, 0.035),
          railingMat
        );
        railBar.position.y = 0.065;
        railBar.castShadow = true;
        edgeGroup.add(railBar);

        // 3 根微型立柱
        for (const px of [-HEX_RADIUS * 0.32, 0, HEX_RADIUS * 0.32]) {
          const post = new THREE.Mesh(
            new THREE.BoxGeometry(0.04, 0.12, 0.04),
            postMat
          );
          post.position.set(px, 0.015, 0);
          post.castShadow = true;
          edgeGroup.add(post);
        }

        group.add(edgeGroup);

        // 配置 3~4 盞中世紀鍛鐵木柱路燈 (含吊臂提燈與地面光暈圓盤)
        if (placedLampsCount < 4) {
          const lampX = Math.sin(edgeAngle + 0.28) * (rApothem * 0.90);
          const lampZ = Math.cos(edgeAngle + 0.28) * (rApothem * 0.90);
          // 吊臂朝向島嶼內側步道
          const inwardAngle = Math.atan2(-lampX, -lampZ);
          const lamp = createMedievalStreetLamp(inwardAngle);
          lamp.position.set(lampX, HEX_HEIGHT + 0.08, lampZ);
          group.add(lamp);
          placedLampsCount++;
        }
      } else {
        // 連接橋頭兩側也適度配置中世紀路燈，引導步道視線
        if (placedLampsCount < 4) {
          const bridgeFlankX = Math.sin(edgeAngle + 0.42) * (rApothem * 0.88);
          const bridgeFlankZ = Math.cos(edgeAngle + 0.42) * (rApothem * 0.88);
          const inwardAngle = Math.atan2(-bridgeFlankX, -bridgeFlankZ);
          const bridgeFlankLamp = createMedievalStreetLamp(inwardAngle);
          bridgeFlankLamp.position.set(bridgeFlankX, HEX_HEIGHT + 0.08, bridgeFlankZ);
          group.add(bridgeFlankLamp);
          placedLampsCount++;
        }
      }
    }
  }

  // ── 拍岸微白浪花光環 ──
  function createShoreFoamRings(group) {
    const foamMat = new THREE.MeshBasicMaterial({
      color: 0xffffff,
      transparent: true,
      opacity: 0.40,
      side: THREE.DoubleSide
    });
    const ringGeo = new THREE.RingGeometry(HEX_RADIUS * 1.01, HEX_RADIUS * 1.12, 24);
    const foam = new THREE.Mesh(ringGeo, foamMat);
    foam.rotation.x = -Math.PI / 2;
    foam.position.y = 0.01;
