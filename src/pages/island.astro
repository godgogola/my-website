  // ══════════════════════════════════════════════════════════════════════
  // 6. 建造雙層六角建築底座與微縮島嶼 (Double-layer Hex Toy Islands)
  // ══════════════════════════════════════════════════════════════════════
  function buildIslands() {
    ISLAND_DATA.forEach((island) => {
      const proj = hexToPlanet(island.q, island.r, island.realm);
      const group = new THREE.Group();
      group.position.copy(proj.position);
      group.quaternion.copy(proj.orientation);
      group.userData = {
        islandId: island.id,
        islandData: island,
        normal: proj.normal,
        worldCenter: proj.position.clone()
      };

      // 1. 底層外框層：白色/淺米灰色六角形石材堤防邊框 (CylinderGeometry 6 邊柱體)
      const baseCurbGeo = new THREE.CylinderGeometry(HEX_RADIUS, HEX_RADIUS, HEX_HEIGHT, 6, 1);
      const baseCurbMat = new THREE.MeshStandardMaterial({
        color: 0xf1f5f9,
        roughness: 0.65,
        metalness: 0.05,
        flatShading: true
      });
      const baseCurb = new THREE.Mesh(baseCurbGeo, baseCurbMat);
      baseCurb.position.y = HEX_HEIGHT / 2;
      baseCurb.castShadow = true;
      baseCurb.receiveShadow = true;
      group.add(baseCurb);

      // 2. 頂層主題地面層：內圈依衛教主題換成不同粉彩馬卡龍顏色 (如鵝黃、清新草綠、醫療灰白、粉橘等)
      const themeColor = THEME_FLOOR_COLORS[island.id] || island.color || 0xfef08a;
      const topFloorGeo = new THREE.CylinderGeometry(HEX_RADIUS * 0.93, HEX_RADIUS * 0.93, 0.08, 6, 1);
      const topFloorMat = new THREE.MeshStandardMaterial({
        color: themeColor,
        roughness: 0.72,
        metalness: 0.02,
        flatShading: true
      });
      const topFloor = new THREE.Mesh(topFloorGeo, topFloorMat);
      topFloor.position.y = HEX_HEIGHT + 0.04;
      topFloor.castShadow = true;
      topFloor.receiveShadow = true;
      group.add(topFloor);

      // 3. 在沒有連接橋樑的邊緣加上精巧迷你白色欄杆與小路燈
      addHexEdgeRailingsAndLamps(group, island);

      // 4. 水岸微白浪花光環
      createShoreFoamRings(group);

      // 5. 連接各橋頭之平整白色步道
      addPlazaWalkways(group, island);

      // 6. 島嶼地表微縮地標、可愛疊球樹、3~5 微型小人偶與生活細節
      populateMiniatureCity(group, island);

      // 7. 選取反白光圈 (Selection Beacon Ring)
      const ringGeo = new THREE.RingGeometry(HEX_RADIUS * 1.05, HEX_RADIUS * 1.15, 32);
      const ringMat = new THREE.MeshBasicMaterial({
        color: 0xffffff,
        side: THREE.DoubleSide,
        transparent: true,
        opacity: 0,
        depthWrite: false
      });
      const ringMesh = new THREE.Mesh(ringGeo, ringMat);
      ringMesh.rotation.x = -Math.PI / 2;
      ringMesh.position.y = HEX_HEIGHT + 0.082;
      group.add(ringMesh);
      group.userData.selectionRing = ringMesh;

      // 8. CSS2D 輕量化懸浮標籤 (白底圓角小膠囊風格)
      const badgeDiv = document.createElement('div');
      badgeDiv.className = `island-3d-badge ${island.realm}`;
      badgeDiv.innerHTML = `
        <div class="island-3d-badge-inner">
          <span class="badge-icon">${island.icon}</span>
          <span class="badge-title">${island.shortName}</span>
          <span class="badge-pins-count">${island.articles.length}篇</span>
        </div>
        <div class="badge-arrow"></div>
      `;
      badgeDiv.addEventListener('click', (e) => {
        e.stopPropagation();
        focusIsland(island.id);
      });

      const staggerY = HEX_HEIGHT + 2.05 + (Math.abs(island.q * 3 + island.r) % 3) * 0.35;
      const badgeObj = new CSS2DObject(badgeDiv);
      badgeObj.position.set(0, staggerY, 0);
      group.add(badgeObj);
      badgeObjects.push(badgeDiv);

      // 9. 島嶼夜間柔和暖光
      const pLight = new THREE.PointLight(0xffea79, 0, 16, 1.4);
      pLight.position.set(0, HEX_HEIGHT + 1.8, 0);
      group.add(pLight);
      nightPointLights.push(pLight);

      islandsGroup.add(group);
      islandObjectsMap.set(island.id, group);
    });
  }

  // ── 六角堤防未連橋邊緣：迷你欄杆與小路燈 ──
  function addHexEdgeRailingsAndLamps(group, island) {
    const byId = new Map();
    ISLAND_DATA.forEach((d) => byId.set(d.id, d));

    const connectedNeighborAngles = [];
    ALL_SCENIC_BRIDGES.forEach(([idA, idB]) => {
      let nId = null;
      if (idA === island.id) nId = idB;
      else if (idB === island.id) nId = idA;
      if (nId) {
        const neighbor = byId.get(nId);
        if (neighbor) {
          const dq = neighbor.q - island.q;
          const dr = neighbor.r - island.r;
          const dx = SPACING * (Math.sqrt(3) * dq + (Math.sqrt(3) / 2) * dr);
          const dz = SPACING * (1.5 * dr);
          const ang = Math.atan2(dx, dz);
          connectedNeighborAngles.push(ang);
        }
      }
    });

    const railingMat = new THREE.MeshStandardMaterial({
      color: 0xffffff,
      roughness: 0.35,
      metalness: 0.1
    });
    const postMat = new THREE.MeshStandardMaterial({
      color: 0xe2e8f0,
      roughness: 0.45
    });

    const rApothem = HEX_RADIUS * Math.cos(Math.PI / 6); // 邊心距

    // 6 個六角形邊的中心角度 (30°, 90°, 150°, 210°, 270°, 330°)
    for (let k = 0; k < 6; k++) {
      const edgeAngle = (k * 60 + 30) * (Math.PI / 180);
      // 檢查此邊是否與任一相連橋樑方向對齊
      const hasBridge = connectedNeighborAngles.some((bAng) => {
        let diff = Math.abs(bAng - edgeAngle);
        while (diff > Math.PI) diff = Math.abs(diff - Math.PI * 2);
        return diff < 0.32;
      });

      if (!hasBridge) {
        // 沒有連接橋樑之邊緣，加上精巧迷你白色欄杆
        const edgeGroup = new THREE.Group();
        const ex = Math.sin(edgeAngle) * (rApothem * 0.96);
        const ez = Math.cos(edgeAngle) * (rApothem * 0.96);
        edgeGroup.position.set(ex, HEX_HEIGHT + 0.08, ez);
        edgeGroup.rotation.y = edgeAngle + Math.PI / 2; // 與邊緣切線平行

        // 橫桿
        const railBar = new THREE.Mesh(
          new THREE.BoxGeometry(HEX_RADIUS * 0.82, 0.035, 0.035),
          railingMat
        );
        railBar.position.y = 0.065;
        railBar.castShadow = true;
        edgeGroup.add(railBar);

        // 3 根微型立柱
        for (const px of [-HEX_RADIUS * 0.32, 0, HEX_RADIUS * 0.32]) {
          const post = new THREE.Mesh(
            new THREE.BoxGeometry(0.04, 0.12, 0.04),
            postMat
          );
          post.position.set(px, 0.015, 0);
          post.castShadow = true;
          edgeGroup.add(post);
        }

        group.add(edgeGroup);

        // 在無橋邊緣角隅點綴小巧白柱暖光路燈
        if (k % 2 === 0) {
          const lampX = Math.sin(edgeAngle + 0.32) * (rApothem * 0.92);
          const lampZ = Math.cos(edgeAngle + 0.32) * (rApothem * 0.92);
          const lampGroup = new THREE.Group();
          lampGroup.position.set(lampX, HEX_HEIGHT + 0.08, lampZ);

          const pole = new THREE.Mesh(
            new THREE.CylinderGeometry(0.02, 0.03, 0.45, 6),
            railingMat
          );
          pole.position.y = 0.225;
          pole.castShadow = true;
          lampGroup.add(pole);

          const bulb = new THREE.Mesh(
            new THREE.SphereGeometry(0.05, 8, 8),
            new THREE.MeshStandardMaterial({
              color: 0xfef08a,
              roughness: 0.2,
              emissive: 0xfef08a,
              emissiveIntensity: 0.6
            })
          );
          bulb.position.y = 0.45;
          lampGroup.add(bulb);

          group.add(lampGroup);
        }
      }
    }
  }

  // ── 拍岸微白浪花光環 ──
  function createShoreFoamRings(group) {
    const foamMat = new THREE.MeshBasicMaterial({
      color: 0xffffff,
      transparent: true,
      opacity: 0.40,
      side: THREE.DoubleSide
    });
    const ringGeo = new THREE.RingGeometry(HEX_RADIUS * 1.01, HEX_RADIUS * 1.12, 24);
    const foam = new THREE.Mesh(ringGeo, foamMat);
    foam.rotation.x = -Math.PI / 2;
    foam.position.y = 0.01;
    group.add(foam);
  }

  // ── 乾淨白色步道與中央廣場 (直通各橋頭) ──
  function addPlazaWalkways(group, island) {
    const walkMat = new THREE.MeshStandardMaterial({
      color: 0xffffff,
      roughness: 0.75,
      metalness: 0.02,
      flatShading: true
    });

    const roadGroup = new THREE.Group();
    roadGroup.position.y = HEX_HEIGHT + 0.081;

    // 中央圓形石板廣場
    const centerPlaza = new THREE.Mesh(
      new THREE.CylinderGeometry(0.92, 0.92, 0.01, 16),
      walkMat
    );
    centerPlaza.receiveShadow = true;
    roadGroup.add(centerPlaza);

    // 通往有架橋之通道
    const byId = new Map();
    ISLAND_DATA.forEach((d) => byId.set(d.id, d));

    const connectedNeighborIds = [];
    ALL_SCENIC_BRIDGES.forEach(([idA, idB]) => {
      if (idA === island.id) connectedNeighborIds.push(idB);
      else if (idB === island.id) connectedNeighborIds.push(idA);
    });

    const roadLen = HEX_APOTHEM - 0.75;
    const midR = (0.92 + HEX_APOTHEM) / 2;

    connectedNeighborIds.forEach((nId) => {
      const neighbor = byId.get(nId);
      if (neighbor) {
        const dq = neighbor.q - island.q;
        const dr = neighbor.r - island.r;
        const dx = SPACING * (Math.sqrt(3) * dq + (Math.sqrt(3) / 2) * dr);
        const dz = SPACING * (1.5 * dr);
        const angle = Math.atan2(dx, dz);

        const roadMesh = new THREE.Mesh(
          new THREE.BoxGeometry(0.52, 0.01, roadLen),
          walkMat
        );
        roadMesh.position.set(Math.sin(angle) * midR, 0, Math.cos(angle) * midR);
        roadMesh.rotation.y = angle;
        roadMesh.receiveShadow = true;
        roadGroup.add(roadMesh);
      }
    });

    group.add(roadGroup);
  }

  // ── 可愛低多邊形疊球樹 (2~3 個圓球疊在圓柱樹幹上，果綠與深綠交錯) ──
  function createCuteToyTree(x, z, scale = 1.0) {
    const treeGroup = new THREE.Group();
    treeGroup.position.set(x, HEX_HEIGHT + 0.08, z);
    treeGroup.scale.setScalar(scale);

    // 圓柱樹幹
    const trunkMat = new THREE.MeshStandardMaterial({ color: 0x8b5a2b, roughness: 0.85 });
    const trunk = new THREE.Mesh(new THREE.CylinderGeometry(0.06, 0.08, 0.36, 6), trunkMat);
    trunk.position.y = 0.18;
    trunk.castShadow = true;
    treeGroup.add(trunk);

    // 粉嫩果綠與深綠交錯色彩庫
    const greens = [0x86efac, 0x4ade80, 0xa3e635, 0x22c55e, 0x15803d, 0x6ee7b7];
    const col1 = greens[Math.floor(Math.random() * greens.length)];
    const col2 = greens[Math.floor(Math.random() * greens.length)];

    const mat1 = new THREE.MeshStandardMaterial({ color: col1, roughness: 0.7, flatShading: true });
    const mat2 = new THREE.MeshStandardMaterial({ color: col2, roughness: 0.7, flatShading: true });

    // 底層較大圓球
    const sphere1 = new THREE.Mesh(new THREE.IcosahedronGeometry(0.25, 1), mat1);
    sphere1.position.set(0, 0.38, 0);
    sphere1.castShadow = true;
    treeGroup.add(sphere1);

    // 中層圓球 (微錯位偏心)
    const sphere2 = new THREE.Mesh(new THREE.IcosahedronGeometry(0.19, 1), mat2);
    sphere2.position.set(0.04, 0.54, -0.03);
    sphere2.castShadow = true;
    treeGroup.add(sphere2);

    // 頂層小圓球
    const sphere3 = new THREE.Mesh(new THREE.IcosahedronGeometry(0.13, 1), mat1);
    sphere3.position.set(-0.03, 0.67, 0.02);
    sphere3.castShadow = true;
    treeGroup.add(sphere3);

    return treeGroup;
  }

  // ── 微型小人偶 (圓柱身體 + 小圓球頭，多彩馬卡龍衣著，3~5 人活潑點綴) ──
  function createMiniFigures(group, count = 4) {
    const clothingColors = [
      0x38bdf8, // 晴空藍
      0xf472b6, // 糖果粉
      0xfacc15, // 鵝黃
      0xfb923c, // 亮橘
      0xa78bfa, // 薰衣草紫
      0x34d399, // 薄荷綠
      0xffffff  // 醫師白袍
    ];

    for (let i = 0; i < count; i++) {
      const angle = (i / count) * Math.PI * 2 + (Math.random() * 0.4 - 0.2);
      const dist = 0.65 + Math.random() * 0.75;
      const fx = Math.cos(angle) * dist;
      const fz = Math.sin(angle) * dist;

      const person = new THREE.Group();
      person.position.set(fx, HEX_HEIGHT + 0.08, fz);

      const clothesCol = clothingColors[Math.floor(Math.random() * clothingColors.length)];
      const bodyMat = new THREE.MeshStandardMaterial({ color: clothesCol, roughness: 0.65 });
      const headMat = new THREE.MeshStandardMaterial({ color: 0xffdfba, roughness: 0.5 }); // 溫暖小膚色

      // 圓柱身體
      const body = new THREE.Mesh(new THREE.CylinderGeometry(0.045, 0.06, 0.16, 8), bodyMat);
      body.position.y = 0.08;
      body.castShadow = true;
      person.add(body);

      // 小圓球頭
      const head = new THREE.Mesh(new THREE.SphereGeometry(0.055, 8, 8), headMat);
      head.position.y = 0.19;
      head.castShadow = true;
      person.add(head);

      person.rotation.y = Math.random() * Math.PI * 2;
      group.add(person);
    }
  }

  // ── 小長椅與小遮陽傘 ──
  function createBenchAndUmbrella(group, bx, bz, rotY = 0) {
    const propGroup = new THREE.Group();
