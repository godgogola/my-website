  function init() {
    // Scene
    scene = new THREE.Scene();
    scene.background = new THREE.Color(0xd7edf6);
    scene.fog = new THREE.FogExp2(0xd7edf6, 0.016);

    // Camera
    const aspect = container.clientWidth / container.clientHeight;
    camera = new THREE.PerspectiveCamera(38, aspect, 0.5, 200);
    camera.position.set(2.1, 18, 22);

    // WebGL Renderer
    renderer = new THREE.WebGLRenderer({ antialias: true, alpha: true, powerPreference: 'high-performance' });
    renderer.setSize(container.clientWidth, container.clientHeight);
    renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
    renderer.shadowMap.enabled = true;
    renderer.shadowMap.type = THREE.PCFSoftShadowMap;
    renderer.toneMapping = THREE.ACESFilmicToneMapping;
    renderer.toneMappingExposure = 1.05;
    container.appendChild(renderer.domElement);

    // CSS2D Renderer (Sharp HTML Floating Badges)
    cssRenderer = new CSS2DRenderer();
    cssRenderer.setSize(container.clientWidth, container.clientHeight);
    cssRenderer.domElement.style.position = 'absolute';
    cssRenderer.domElement.style.top = '0px';
    cssRenderer.domElement.style.left = '0px';
    cssRenderer.domElement.style.pointerEvents = 'none';
    viewportBox.appendChild(cssRenderer.domElement);

    // Orbit Controls
    controls = new OrbitControls(camera, renderer.domElement);
    controls.enableDamping = true;
    controls.dampingFactor = 0.06;
    controls.maxPolarAngle = Math.PI / 2.15; // 不穿入星球水底
    controls.minDistance = 5;
    controls.maxDistance = 45;
    controls.target.copy(cameraLookAt);

    // 添加核心群組
    scene.add(lightsGroup);
    scene.add(islandsGroup);
    scene.add(bridgesGroup);
    scene.add(walkersGroup);
    scene.add(flowsGroup);

    createDayNightSystem();   // 1. 太陽月亮 180s 日夜循環
    createStarfieldAndMilkyWay(); // 2. 穹頂星空與銀河微粒
    createLowPolyClouds();    // 3. 漂浮低空慢速白雲
    createCurvedOcean();      // 4. 動態波浪海洋
    buildIslands();           // 5. 24 座微縮島嶼
    buildBridges();           // 6. 連接木橋
    buildFlowLines();         // 7. 跨界光流索
    spawnWalkers();           // 8. 漫步小人
    birdFlockData = createBirdFlock(); // 9. 飛鳥振翅盤旋
    setupNightLights();       // 10. 島嶼路燈與夜間發光窗戶
    setupRaycaster();
    setupUI();

    const urlParams = new URLSearchParams(window.location.search);
    const timeParam = urlParams.get('time');
    if (timeParam) {
      manualTimeLock = true;
      isAutoDayNight = false;
      document.querySelectorAll('.time-btn').forEach(b => b.classList.remove('active'));
      const activeBtn = document.querySelector(`[data-time="${timeParam}"]`);
      if (activeBtn) activeBtn.classList.add('active');

      if (timeParam === 'dawn') targetCycle = currentCycle = 0.02;
      else if (timeParam === 'noon') targetCycle = currentCycle = 0.25;
      else if (timeParam === 'dusk') targetCycle = currentCycle = 0.48;
      else if (timeParam === 'night') targetCycle = currentCycle = 0.75;
    }

    window.addEventListener('resize', onWindowResize);

    // 關閉載入視窗
    setTimeout(() => {
      const loader = document.getElementById('loadingOverlay');
      if (loader) loader.classList.add('hidden');
    }, 450);

    animate();
  }

  // ══════════════════════════════════════════════════════════════════════
  // 4. 光照與時序光影
  // ══════════════════════════════════════════════════════════════════════
  function createBirdFlock() {
    const flockGroup = new THREE.Group();
    const birdGeo = new THREE.BufferGeometry();
    const birdVerts = new Float32Array([
      -0.35, 0.12, 0,
      0, 0, 0.08,
      0.35, 0.12, 0
    ]);
    birdGeo.setAttribute('position', new THREE.BufferAttribute(birdVerts, 3));
    const birdMat = new THREE.LineBasicMaterial({ color: 0x27272a, linewidth: 2.2 });
    
    const birdMeshes = [];
    for (let i = 0; i < 20; i++) {
      const bird = new THREE.Line(birdGeo, birdMat);
      const baseX = -24 - (i % 5) * 3.6 + Math.random() * 2;
      const baseY = 8.8 + (i * 0.42) + Math.random() * 1.5;
      const baseZ = -16 - (i * 1.2);
      bird.position.set(baseX, baseY, baseZ);
      bird.rotation.y = -0.42;
      bird.scale.setScalar(0.72 + (i % 4) * 0.18);
      bird.userData = {
        baseX, baseY, baseZ,
        phase: i * 0.4,
        speed: 0.8 + (i % 3) * 0.3
      };
      flockGroup.add(bird);
      birdMeshes.push(bird);
    }
    scene.add(flockGroup);
    return { group: flockGroup, birds: birdMeshes };
  }

  // 全景天空穹頂 Shader (左側夕陽霞光 ➔ 右側午夜星空)

  function setupLights() {
    ambientLight = new THREE.AmbientLight(0xfff7ed, 0.72);
    lightsGroup.add(ambientLight);

    hemiLight = new THREE.HemisphereLight(0xd9f0fc, 0x826d5e, 0.62);
    lightsGroup.add(hemiLight);

    dirLight = new THREE.DirectionalLight(0xfff4e6, 1.45);
    dirLight.position.set(16, 26, 18);
    dirLight.castShadow = true;
    dirLight.shadow.mapSize.width = 2048;
    dirLight.shadow.mapSize.height = 2048;
    dirLight.shadow.camera.near = 1;
    dirLight.shadow.camera.far = 70;
    const d = 24;
    dirLight.shadow.camera.left = -d;
    dirLight.shadow.camera.right = d;
    dirLight.shadow.camera.top = d;
    dirLight.shadow.camera.bottom = -d;
    dirLight.shadow.bias = -0.0004;
    lightsGroup.add(dirLight);
  }

  function applyTimePreset(time) {
    switch (time) {
      case 'dawn':
        scene.background.set(0xfbeee6);
        scene.fog.color.set(0xfbeee6);
        ambientLight.color.set(0xffeedb);
        ambientLight.intensity = 0.62;
        hemiLight.color.set(0xfed7aa);
        hemiLight.groundColor.set(0x78350f);
        dirLight.color.set(0xffedd5);
        dirLight.intensity = 1.15;
        dirLight.position.set(24, 15, 12);
        if (waterSphere) waterSphere.material.color.set(0x74b4c7);
        break;
      case 'noon':
        scene.background.set(0xd7edf6);
        scene.fog.color.set(0xd7edf6);
        ambientLight.color.set(0xfff7ed);
        ambientLight.intensity = 0.72;
        hemiLight.color.set(0xd9f0fc);
        hemiLight.groundColor.set(0x826d5e);
        dirLight.color.set(0xfff4e6);
        dirLight.intensity = 1.45;
        dirLight.position.set(16, 26, 18);
        if (waterSphere) waterSphere.material.color.set(0x48a8c4);
        break;
      case 'dusk':
        scene.background.set(0xfed7aa);
        scene.fog.color.set(0xfed7aa);
        ambientLight.color.set(0xffedd5);
        ambientLight.intensity = 0.58;
        hemiLight.color.set(0xfb923c);
        hemiLight.groundColor.set(0x431407);
        dirLight.color.set(0xf97316);
        dirLight.intensity = 1.25;
        dirLight.position.set(-22, 11, 16);
        if (waterSphere) waterSphere.material.color.set(0x5c7c8c);
        break;
      case 'night':
        scene.background.set(0x0f172a);
        scene.fog.color.set(0x0f172a);
        ambientLight.color.set(0x38bdf8);
        ambientLight.intensity = 0.38;
        hemiLight.color.set(0x1e293b);
        hemiLight.groundColor.set(0x090d16);
        dirLight.color.set(0x93c5fd);
        dirLight.intensity = 0.65;
        dirLight.position.set(-10, 22, -10);
        if (waterSphere) waterSphere.material.color.set(0x0e2f44);
        break;
    }
  }


  // ══════════════════════════════════════════════════════════════════════
  // 6. 沿地球弧度建造六角島嶼 (Curved Hexagonal Islands)
  // ══════════════════════════════════════════════════════════════════════
  
  // ══════════════════════════════════════════════════════════════════════
  // 系統 1: 180 秒日夜循環系統 (太陽 + 月亮 + 天空色彩插值)
  // ══════════════════════════════════════════════════════════════════════
  function createDayNightSystem() {
    celestialPivot = new THREE.Group();
    celestialPivot.position.set(2.1, 0, 0);
    celestialPivot.rotation.x = -0.35; // 傾斜軸，讓太陽從左前天際升起，月亮從右後天際升起
    scene.add(celestialPivot);

    // ── 太陽端 (Radius 28) ──
    const sunGroup = new THREE.Group();
    sunGroup.position.set(-28, 0, 0);

    const sunGeo = new THREE.SphereGeometry(2.0, 24, 24);
    const sunMat = new THREE.MeshBasicMaterial({ color: 0xfff9db });
    sunMesh = new THREE.Mesh(sunGeo, sunMat);
    sunGroup.add(sunMesh);

    // 太陽金色放射日冕 Sprite
    const sunCanvas = document.createElement('canvas');
    sunCanvas.width = 256;
    sunCanvas.height = 256;
    const sctx = sunCanvas.getContext('2d');
    const sgrad = sctx.createRadialGradient(128, 128, 14, 128, 128, 128);
    sgrad.addColorStop(0.0, 'rgba(255, 255, 235, 1.0)');
    sgrad.addColorStop(0.25, 'rgba(254, 215, 170, 0.85)');
    sgrad.addColorStop(0.6, 'rgba(251, 146, 60, 0.35)');
    sgrad.addColorStop(1.0, 'rgba(251, 146, 60, 0.0)');
    sctx.fillStyle = sgrad;
    sctx.fillRect(0, 0, 256, 256);
    const sunTexture = new THREE.CanvasTexture(sunCanvas);
    const sunGlowMat = new THREE.SpriteMaterial({
      map: sunTexture,
      blending: THREE.AdditiveBlending,
      transparent: true,
      depthWrite: false
    });
    sunGlowSprite = new THREE.Sprite(sunGlowMat);
    sunGlowSprite.scale.set(18, 18, 1);
    sunGroup.add(sunGlowSprite);

    sunLight = new THREE.DirectionalLight(0xfff7ed, 1.6);
    sunLight.castShadow = true;
    sunLight.shadow.mapSize.width = 2048;
    sunLight.shadow.mapSize.height = 2048;
    sunLight.shadow.camera.near = 1;
    sunLight.shadow.camera.far = 75;
    const sd = 25;
    sunLight.shadow.camera.left = -sd;
    sunLight.shadow.camera.right = sd;
    sunLight.shadow.camera.top = sd;
    sunLight.shadow.camera.bottom = -sd;
    sunLight.shadow.bias = -0.0003;
    sunGroup.add(sunLight);
    celestialPivot.add(sunGroup);

    // ── 月亮端 (對立面 180 度，Radius 28) ──
    const moonGroup = new THREE.Group();
    moonGroup.position.set(28, 0, 0);

    const moonGeo = new THREE.SphereGeometry(1.5, 24, 24);
    const moonMat = new THREE.MeshStandardMaterial({
      color: 0xf8fafc,
      roughness: 0.75,
      metalness: 0.1
    });
    moonMesh = new THREE.Mesh(moonGeo, moonMat);
    moonGroup.add(moonMesh);

    // 月亮幽藍月暈 Sprite
    const moonCanvas = document.createElement('canvas');
    moonCanvas.width = 256;
    moonCanvas.height = 256;
    const mctx = moonCanvas.getContext('2d');
    const mgrad = mctx.createRadialGradient(128, 128, 14, 128, 128, 128);
    mgrad.addColorStop(0.0, 'rgba(240, 248, 255, 0.95)');
    mgrad.addColorStop(0.3, 'rgba(165, 180, 252, 0.6)');
    mgrad.addColorStop(0.7, 'rgba(99, 102, 241, 0.2)');
    mgrad.addColorStop(1.0, 'rgba(99, 102, 241, 0.0)');
    mctx.fillStyle = mgrad;
    mctx.fillRect(0, 0, 256, 256);
    const moonTexture = new THREE.CanvasTexture(moonCanvas);
    const moonGlowMat = new THREE.SpriteMaterial({
      map: moonTexture,
      blending: THREE.AdditiveBlending,
      transparent: true,
      depthWrite: false
    });
    moonGlowSprite = new THREE.Sprite(moonGlowMat);
    moonGlowSprite.scale.set(14, 14, 1);
    moonGroup.add(moonGlowSprite);

    moonLight = new THREE.DirectionalLight(0xa5b4fc, 0.5);
    moonGroup.add(moonLight);
    celestialPivot.add(moonGroup);

    // 環境基礎光
    ambientLight = new THREE.AmbientLight(0xfff7ed, 0.65);
    scene.add(ambientLight);
    hemiLight = new THREE.HemisphereLight(0xd9f0fc, 0x826d5e, 0.55);
    scene.add(hemiLight);
  }

  // ══════════════════════════════════════════════════════════════════════
  // 系統 2: 璀璨星空與銀河粒子系統 (遠景深度 + 圓形星芒)
  // ══════════════════════════════════════════════════════════════════════
  function createStarfieldAndMilkyWay() {
    const starCanvas = document.createElement('canvas');
    starCanvas.width = 64;
    starCanvas.height = 64;
    const sctx = starCanvas.getContext('2d');
    const sgrad = sctx.createRadialGradient(32, 32, 2, 32, 32, 32);
    sgrad.addColorStop(0.0, 'rgba(255, 255, 255, 1.0)');
    sgrad.addColorStop(0.3, 'rgba(255, 255, 255, 0.75)');
    sgrad.addColorStop(0.7, 'rgba(199, 210, 254, 0.25)');
    sgrad.addColorStop(1.0, 'rgba(199, 210, 254, 0.0)');
    sctx.fillStyle = sgrad;
    sctx.fillRect(0, 0, 64, 64);
    const starTexture = new THREE.CanvasTexture(starCanvas);

    // 1. 穹頂星空 (2,500 顆，半徑 75~105，高空遠景)
    const starCount = 2500;
    const starGeo = new THREE.BufferGeometry();
    const starPositions = new Float32Array(starCount * 3);

    for (let i = 0; i < starCount; i++) {
      const radius = 75 + Math.random() * 30;
      const theta = Math.random() * Math.PI * 2;
      const phi = Math.acos(0.15 + Math.random() * 0.75); // 只在高空穹頂
      starPositions[i * 3] = radius * Math.sin(phi) * Math.cos(theta) + 2.1;
      starPositions[i * 3 + 1] = radius * Math.cos(phi) + 12; // 確保高於島嶼
      starPositions[i * 3 + 2] = radius * Math.sin(phi) * Math.sin(theta);
    }
    starGeo.setAttribute('position', new THREE.BufferAttribute(starPositions, 3));

    const starMat = new THREE.PointsMaterial({
      map: starTexture,
      color: 0xffffff,
      size: 1.4,
      transparent: true,
      opacity: 0,
      blending: THREE.AdditiveBlending,
      depthTest: true,
      depthWrite: false
    });
    starfieldPoints = new THREE.Points(starGeo, starMat);
    starfieldPoints.visible = false;
    scene.add(starfieldPoints);

    // 2. 銀河拱門微粒帶 (3,500 顆彩色微粒，高空大圓弧)
    const mwCount = 3500;
    const mwGeo = new THREE.BufferGeometry();
    const mwPositions = new Float32Array(mwCount * 3);
    const mwColors = new Float32Array(mwCount * 3);

    const c1 = new THREE.Color(0xc084fc);
    const c2 = new THREE.Color(0xf472b6);
    const c3 = new THREE.Color(0x93c5fd);
    const c4 = new THREE.Color(0xffffff);
    const palette = [c1, c2, c3, c4];

    for (let i = 0; i < mwCount; i++) {
      const t = (Math.random() - 0.5) * Math.PI * 1.5;
      const spread = (Math.random() + Math.random() - 1) * 6.0;
      const radius = 80 + (Math.random() - 0.5) * 8;

      const rawX = Math.cos(t) * radius;
      const rawY = Math.sin(t) * radius * 0.55 + 32; // 高聳銀河拱橋
      const rawZ = spread * 4.0;

      const rot = 0.65;
      mwPositions[i * 3] = (rawX * Math.cos(rot) - rawZ * Math.sin(rot)) + 2.1;
      mwPositions[i * 3 + 1] = Math.max(rawY, 14.0);
      mwPositions[i * 3 + 2] = rawX * Math.sin(rot) + rawZ * Math.cos(rot);

      const col = palette[Math.floor(Math.random() * palette.length)];
      mwColors[i * 3] = col.r;
      mwColors[i * 3 + 1] = col.g;
      mwColors[i * 3 + 2] = col.b;
    }
    mwGeo.setAttribute('position', new THREE.BufferAttribute(mwPositions, 3));
    mwGeo.setAttribute('color', new THREE.BufferAttribute(mwColors, 3));

    const mwMat = new THREE.PointsMaterial({
      map: starTexture,
      vertexColors: true,
      size: 1.8,
      transparent: true,
      opacity: 0,
      blending: THREE.AdditiveBlending,
      depthTest: true,
      depthWrite: false
    });
    milkyWayPoints = new THREE.Points(mwGeo, mwMat);
    milkyWayPoints.visible = false;
    scene.add(milkyWayPoints);
  }

  // ══════════════════════════════════════════════════════════════════════
  // 系統 3: 低空慢速漂浮白雲 (純白立體蓬鬆雲朵)
  // ══════════════════════════════════════════════════════════════════════
  function createLowPolyClouds() {
    cloudsGroup = new THREE.Group();
    const cloudMat = new THREE.MeshStandardMaterial({
      color: 0xffffff,
      roughness: 0.8,
      flatShading: true,
      transparent: true,
      opacity: 0.94
    });

    // 生成 6 朵分佈在群島視野兩側的白雲
    for (let c = 0; c < 6; c++) {
      const singleCloud = new THREE.Group();
      const puffCount = 5 + Math.floor(Math.random() * 3);
      for (let p = 0; p < puffCount; p++) {
        const radius = 0.85 + Math.random() * 0.65;
        const puff = new THREE.Mesh(new THREE.DodecahedronGeometry(radius, 1), cloudMat);
        puff.position.set(
          (p - puffCount / 2) * 0.95 + (Math.random() - 0.5) * 0.35,
          (Math.random() - 0.5) * 0.4,
          (Math.random() - 0.5) * 0.5
        );
        puff.scale.set(1.2, 0.8, 1.0);
        puff.castShadow = true;
        singleCloud.add(puff);
      }

      const orbitRadius = 18 + (c % 3) * 4.0;
      const angle = (c / 6) * Math.PI * 2;
      const y = 8.5 + (c % 2) * 1.5;
      singleCloud.position.set(Math.cos(angle) * orbitRadius + 2.1, y, Math.sin(angle) * orbitRadius);
      singleCloud.userData = {
        orbitRadius,
        angle,
        speed: 0.08 + (c % 3) * 0.03,
        y
      };
      cloudsGroup.add(singleCloud);
    }
    scene.add(cloudsGroup);
  }

  // ══════════════════════════════════════════════════════════════════════
  // 系統 4: 動態波浪海洋 (高反射率 + 頂點海浪動畫)
  // ══════════════════════════════════════════════════════════════════════
  function createCurvedOcean() {
    const oceanRadius = PLANET_RADIUS - 0.18;
    // 96x64 細分度，提供細緻海浪起伏
    oceanGeo = new THREE.SphereGeometry(oceanRadius, 96, 64, 0, Math.PI * 2, 0, Math.PI * 0.48);
    
    // 保存初始頂點位置
    const pos = oceanGeo.attributes.position;
    oceanInitialPositions = new Float32Array(pos.count * 3);
    for (let i = 0; i < pos.count * 3; i++) {
      oceanInitialPositions[i] = pos.array[i];
    }

    const oceanMat = new THREE.MeshStandardMaterial({
      color: 0x184e77,
      roughness: 0.16,
      metalness: 0.52,
      transparent: true,
      opacity: 0.92,
      flatShading: true
    });
    oceanMesh = new THREE.Mesh(oceanGeo, oceanMat);
    oceanMesh.position.copy(PLANET_CENTER);
    oceanMesh.receiveShadow = true;
    scene.add(oceanMesh);
    waterSphere = oceanMesh;
  }

  // ══════════════════════════════════════════════════════════════════════
  // 系統 5: 夜間點燈 (路燈與窗戶發光)
  // ══════════════════════════════════════════════════════════════════════
  function setupNightLights() {
    // 共享發光材質
    nightGlowMaterial = new THREE.MeshStandardMaterial({
      color: 0xffedd5,
      emissive: 0xff9900,
      emissiveIntensity: 0.0,
      roughness: 0.3
    });

    // 在 4 座主要島嶼上方配置夜間微弱暖色點光源
    const majorIslands = ['endoscopy', 'stomach', 'wealth-ladder', 'golden-rules'];
    majorIslands.forEach((id) => {
      const islObj = islandObjectsMap.get(id);
      if (islObj) {
        const pLight = new THREE.PointLight(0xffaa44, 0, 12, 1.8);
        pLight.position.set(0, HEX_HEIGHT + 2.5, 0);
        islObj.add(pLight);
        nightPointLights.push(pLight);
      }
    });
  }

  // ══════════════════════════════════════════════════════════════════════
  // 系統 6: 日夜時序光影插值更新 (在 animate 每幀調用)
  // ══════════════════════════════════════════════════════════════════════
  function updateDayNightCycle(elapsedTime) {
    if (isAutoDayNight && !manualTimeLock) {
      targetCycle = (elapsedTime % 180) / 180;
    }
    // 平滑跟隨 targetCycle (解決點擊按鈕時的突兀跳變)
    let diff = targetCycle - currentCycle;
    if (diff > 0.5) diff -= 1.0;
    if (diff < -0.5) diff += 1.0;
    currentCycle = (currentCycle + diff * 0.05 + 1.0) % 1.0;

    const cycle = currentCycle;

    // 1. 旋轉日月軸 (繞島嶼群斜向旋轉升起與落下)
    if (celestialPivot) {
      celestialPivot.rotation.z = cycle * Math.PI * 2;
      celestialPivot.rotation.x = Math.sin(cycle * Math.PI * 2) * 0.28;
    }

    // 2. 太陽與月亮光照強度切換
    // 白天：0.0~0.5 (正午 ~0.25)；夜晚：0.5~1.0 (午夜 ~0.75)
    const isDay = cycle < 0.5;
    const sunAltitude = Math.sin(cycle * Math.PI * 2); // > 0 為在天空
    const sunIntensity = Math.max(0, sunAltitude) * 1.55;
    const moonIntensity = Math.max(0, -sunAltitude) * 0.45;

    if (sunLight) sunLight.intensity = sunIntensity;
    if (moonLight) moonLight.intensity = moonIntensity;

    // 3. 天空背景色與霧氣平滑插值 (Lerp)
    // 4 個關鍵時段色彩：
    // Noon(0.25): #7dc4e8; Dusk(0.48): #fd5e53; Midnight(0.75): #060919; Dawn(0.02): #fbcfe8
    const noonCol = new THREE.Color(0x7dc4e8);
    const duskCol = new THREE.Color(0xfd5e53);
    const nightCol = new THREE.Color(0x060919);
    const dawnCol = new THREE.Color(0xfbcfe8);

    const curSky = new THREE.Color();
    const curFog = new THREE.Color();

    if (cycle < 0.25) {
      // 晨曦 (0.02) ➔ 正午 (0.25)
      const t = (cycle) / 0.25;
      curSky.lerpColors(dawnCol, noonCol, t);
    } else if (cycle < 0.5) {
      // 正午 (0.25) ➔ 暮霞黃昏 (0.5)
      const t = (cycle - 0.25) / 0.25;
      curSky.lerpColors(noonCol, duskCol, t);
    } else if (cycle < 0.75) {
      // 暮霞黃昏 (0.5) ➔ 深夜 (0.75)
      const t = (cycle - 0.5) / 0.25;
      curSky.lerpColors(duskCol, nightCol, t);
    } else {
      // 深夜 (0.75) ➔ 晨曦 (1.0)
      const t = (cycle - 0.75) / 0.25;
      curSky.lerpColors(nightCol, dawnCol, t);
    }

    scene.background.copy(curSky);
    if (scene.fog) {
      curFog.copy(curSky).multiplyScalar(0.92);
      scene.fog.color.copy(curFog);
    }

    // 4. 星空與銀河透明度 (夜晚淡入，白天隱藏)
    let starAlpha = 0;
    const isNightVisible = cycle > 0.46 && cycle < 0.98;
    if (isNightVisible) {
      if (cycle >= 0.54 && cycle <= 0.92) {
        starAlpha = 1.0;
      } else if (cycle < 0.54) {
        starAlpha = (cycle - 0.46) / 0.08;
      } else {
        starAlpha = (0.98 - cycle) / 0.06;
      }
    }
    if (starfieldPoints) {
      starfieldPoints.visible = starAlpha > 0.02;
      starfieldPoints.material.opacity = starAlpha;
    }
    if (milkyWayPoints) {
      milkyWayPoints.visible = starAlpha > 0.02;
      milkyWayPoints.material.opacity = starAlpha * 0.95;
    }

    // 星空緩慢自轉
    if (starfieldPoints) starfieldPoints.rotation.y += 0.0003;
    if (milkyWayPoints) milkyWayPoints.rotation.y += 0.00025;

    // 5. 夜間點燈邏輯 (路燈與發光窗戶)
    const isNightTime = cycle > 0.46 && cycle < 0.96;
    const glowTarget = isNightTime ? 2.0 : 0.0;
    if (nightGlowMaterial) {
      nightGlowMaterial.emissiveIntensity += (glowTarget - nightGlowMaterial.emissiveIntensity) * 0.05;
    }
    nightPointLights.forEach((pl) => {
      pl.intensity += ((isNightTime ? 1.5 : 0.0) - pl.intensity) * 0.05;
    });

    // 6. 海水色彩隨時間過渡
    if (oceanMesh) {
      const dayOcean = new THREE.Color(0x184e77);
      const sunsetOcean = new THREE.Color(0x7c3a2e);
      const nightOcean = new THREE.Color(0x0a192f);
      const curOcean = new THREE.Color();

      if (cycle < 0.4) {
        curOcean.copy(dayOcean);
      } else if (cycle < 0.52) {
        curOcean.lerpColors(dayOcean, sunsetOcean, (cycle - 0.4) / 0.12);
      } else if (cycle < 0.65) {
        curOcean.lerpColors(sunsetOcean, nightOcean, (cycle - 0.52) / 0.13);
      } else {
        curOcean.lerpColors(nightOcean, dayOcean, (cycle - 0.88) / 0.12);
      }
      oceanMesh.material.color.copy(curOcean);
    }
  }

  // ══════════════════════════════════════════════════════════════════════
  // 海浪波動與雲朵位移動畫 (在 animate 每幀調用)
  // ══════════════════════════════════════════════════════════════════════
  function updateWavesAndClouds(elapsedTime) {
    // 1. 動態海浪頂點起伏
    if (oceanGeo && oceanInitialPositions) {
      const pos = oceanGeo.attributes.position;
      const count = pos.count;
      for (let i = 0; i < count; i++) {
        const ox = oceanInitialPositions[i * 3];
        const oy = oceanInitialPositions[i * 3 + 1];
        const oz = oceanInitialPositions[i * 3 + 2];

        // 疊加正弦波
        const wave = Math.sin(ox * 0.35 + elapsedTime * 1.8) * 0.16 +
                     Math.cos(oz * 0.28 + elapsedTime * 1.4) * 0.12 +
                     Math.sin((ox + oz) * 0.2 + elapsedTime * 2.1) * 0.08;

        // 沿法向量方向微幅浮動
        const len = Math.sqrt(ox * ox + oy * oy + oz * oz);
        const nx = ox / len;
        const ny = oy / len;
        const nz = oz / len;

        pos.setXYZ(i, ox + nx * wave, oy + ny * wave, oz + nz * wave);
      }
      pos.needsUpdate = true;
      oceanGeo.computeVertexNormals();
    }

    // 2. 雲朵慢速飄移
    if (cloudsGroup) {
      cloudsGroup.children.forEach((cloud) => {
        const u = cloud.userData;
        if (u) {
          u.angle += u.speed * 0.0018;
          cloud.position.x = Math.cos(u.angle) * u.orbitRadius;
          cloud.position.z = Math.sin(u.angle) * u.orbitRadius;
          cloud.position.y = u.y + Math.sin(elapsedTime * 0.6 + u.orbitRadius) * 0.35;
        }
      });
    }
  }


  function buildIslands() {
    ISLAND_DATA.forEach((island) => {
      const proj = hexToPlanet(island.q, island.r);
      const group = new THREE.Group();
      group.position.copy(proj.position);
      group.quaternion.copy(proj.orientation);
      group.userData = {
        islandId: island.id,
        islandData: island,
        normal: proj.normal,
        worldCenter: proj.position.clone()
      };

      // 1. 六角島嶼頂層土壤/草皮 (Beveled Hexagon Cylinder)
      const hexGeo = new THREE.CylinderGeometry(HEX_RADIUS, HEX_RADIUS * 1.03, HEX_HEIGHT, 6, 1);
      const topMat = new THREE.MeshStandardMaterial({
        color: island.color,
        roughness: 0.72,
        metalness: 0.05,
        flatShading: true
      });
      const topMesh = new THREE.Mesh(hexGeo, topMat);
      topMesh.position.y = HEX_HEIGHT / 2;
      topMesh.castShadow = true;
      topMesh.receiveShadow = true;
      group.add(topMesh);

      // 2. 六角天然海蝕巨石岩壁 (Rocky Cliff Base) - 徹底取代平滑幾何感
      addRockyCliffBase(group, island);

      // 3. 雙層拍岸白浪花光環
      createShoreFoamRings(group);

      // 4. 島嶼地表微縮村落與專屬地標模型
      populateMiniatureCity(group, island);

      // 4. 島嶼光圈／選取反白環 (Selection Beacon Ring)
      const ringGeo = new THREE.RingGeometry(HEX_RADIUS * 1.05, HEX_RADIUS * 1.15, 32);
      const ringMat = new THREE.MeshBasicMaterial({
        color: 0xffffff,
        side: THREE.DoubleSide,
        transparent: true,
        opacity: 0,
        depthWrite: false
      });
      const ringMesh = new THREE.Mesh(ringGeo, ringMat);
      ringMesh.rotation.x = -Math.PI / 2;
      ringMesh.position.y = HEX_HEIGHT + 0.04;
      group.add(ringMesh);
      group.userData.selectionRing = ringMesh;

      // 5. CSS2D 懸浮標籤 (顯示真實全文章數)
      const badgeDiv = document.createElement('div');
      badgeDiv.className = `island-3d-badge ${island.realm}`;
      badgeDiv.innerHTML = `
        <div class="island-3d-badge-inner">
          <span class="badge-icon">${island.icon}</span>
          <span class="badge-title">${island.shortName}</span>
          <span class="badge-pins-count">${island.articles.length}篇</span>
        </div>
        <div class="badge-arrow"></div>
      `;
      badgeDiv.addEventListener('click', (e) => {
        e.stopPropagation();
        focusIsland(island.id);
      });

      const staggerY = HEX_HEIGHT + 2.15 + (Math.abs(island.q * 3 + island.r) % 3) * 0.45;
      const badgeObj = new CSS2DObject(badgeDiv);
      badgeObj.position.set(0, staggerY, 0);
      group.add(badgeObj);
      badgeObjects.push(badgeDiv);

      islandsGroup.add(group);
      islandObjectsMap.set(island.id, group);
    });
  }

  // 微縮城市建築生成
  
  // ── 天然海蝕巨石岩壁 (還原示意圖真實海島多面切削岩體) ──
  function addRockyCliffBase(group, island) {
    const rockMat1 = new THREE.MeshStandardMaterial({ color: 0x54463a, roughness: 0.95, flatShading: true });
    const rockMat2 = new THREE.MeshStandardMaterial({ color: 0x6e5a4c, roughness: 0.9, flatShading: true });
    const rockMat3 = new THREE.MeshStandardMaterial({ color: 0x3d322a, roughness: 0.95, flatShading: true });
    const mats = [rockMat1, rockMat2, rockMat3];

    // 環繞 14 顆隨機刀削巨石
    for (let i = 0; i < 14; i++) {
      const angle = (i / 14) * Math.PI * 2 + (Math.random() * 0.15 - 0.075);
      const dist = HEX_RADIUS * (0.86 + Math.random() * 0.22);
      const rx = Math.cos(angle) * dist;
      const rz = Math.sin(angle) * dist;
      const ry = -0.42 - Math.random() * 0.38;

      const rockRadius = 0.52 + Math.random() * 0.42;
      const rockGeo = new THREE.DodecahedronGeometry(rockRadius, 0);
      
      // 隨機擾動頂點形成天然海蝕裂紋
      const posAttr = rockGeo.attributes.position;
      for (let p = 0; p < posAttr.count; p++) {
        const vx = posAttr.getX(p) + (Math.random() - 0.5) * 0.12;
        const vy = posAttr.getY(p) * (0.85 + Math.random() * 0.3);
        const vz = posAttr.getZ(p) + (Math.random() - 0.5) * 0.12;
        posAttr.setXYZ(p, vx, vy, vz);
      }
      rockGeo.computeVertexNormals();

      const rockMesh = new THREE.Mesh(rockGeo, mats[i % 3]);
      rockMesh.position.set(rx, ry, rz);
      rockMesh.rotation.set(Math.random() * Math.PI, Math.random() * Math.PI, Math.random() * Math.PI);
      rockMesh.castShadow = true;
      rockMesh.receiveShadow = true;
      group.add(rockMesh);
    }
  }

  // ── 雙層拍岸白浪花光環 ──
  function createShoreFoamRings(group) {
    const foamMat = new THREE.MeshBasicMaterial({
      color: 0xffffff,
      transparent: true,
      opacity: 0.42,
      side: THREE.DoubleSide
    });
    const ringGeo = new THREE.RingGeometry(HEX_RADIUS * 1.02, HEX_RADIUS * 1.14, 24);
    const foam = new THREE.Mesh(ringGeo, foamMat);
    foam.rotation.x = -Math.PI / 2;
    foam.position.y = -0.08;
    group.add(foam);
  }

  // ── 可愛毛線小羊 (示意圖專屬生物) ──
  function createAmigurumiSheep(group, x, z, scale = 0.35) {
    const sheepGroup = new THREE.Group();
    sheepGroup.position.set(x, HEX_HEIGHT + 0.12, z);
    sheepGroup.scale.setScalar(scale);

    const bodyMat = new THREE.MeshStandardMaterial({ color: 0xfaf8f5, roughness: 0.95, flatShading: true });
    const faceMat = new THREE.MeshStandardMaterial({ color: 0x221f1d, roughness: 0.8 });

    // 蓬鬆毛線身體
    const body = new THREE.Mesh(new THREE.DodecahedronGeometry(0.38, 1), bodyMat);
    body.position.y = 0.32;
    body.scale.set(1.15, 0.9, 0.9);
    body.castShadow = true;
    sheepGroup.add(body);

    // 黑小臉
    const head = new THREE.Mesh(new THREE.SphereGeometry(0.16, 8, 8), faceMat);
    head.position.set(0.35, 0.42, 0);
    sheepGroup.add(head);

    // 四隻細黑腿
    const legGeo = new THREE.CylinderGeometry(0.03, 0.03, 0.22, 5);
    const legPositions = [
      [0.18, 0.11, 0.16],
      [0.18, 0.11, -0.16],
      [-0.18, 0.11, 0.16],
      [-0.18, 0.11, -0.16]
    ];
    legPositions.forEach(([lx, ly, lz]) => {
      const leg = new THREE.Mesh(legGeo, faceMat);
      leg.position.set(lx, ly, lz);
      sheepGroup.add(leg);
    });

    group.add(sheepGroup);
  }


  function populateMiniatureCity(group, island) {
    const isWisdom = island.realm === 'wisdom';
    const mainRoofColor = island.roofColor;

    // 1. 中央主題大建築 (Central Archetype Building)
    if (island.id === 'cardio' || island.id === 'wealth-ladder') {
      const towerBaseGeo = new THREE.BoxGeometry(0.7, 1.4, 0.7);
      const wallMat = new THREE.MeshStandardMaterial({ color: 0xfaf5ef, roughness: 0.6 });
      const towerBase = new THREE.Mesh(towerBaseGeo, wallMat);
      towerBase.position.set(0, HEX_HEIGHT + 0.7, 0);
      towerBase.castShadow = true;
      group.add(towerBase);

      const roofGeo = new THREE.ConeGeometry(0.58, 0.85, 4);
      const roofMat = new THREE.MeshStandardMaterial({ color: mainRoofColor, roughness: 0.5 });
      const roof = new THREE.Mesh(roofGeo, roofMat);
      roof.rotation.y = Math.PI / 4;
      roof.position.set(0, HEX_HEIGHT + 1.4 + 0.42, 0);
      roof.castShadow = true;
      group.add(roof);

      const stairGeo = new THREE.BoxGeometry(0.9, 0.15, 0.9);
      const stair = new THREE.Mesh(stairGeo, wallMat);
      stair.position.set(0, HEX_HEIGHT + 0.08, 0);
      group.add(stair);
    } else if (island.id === 'endoscopy') {
      const lightGeo = new THREE.CylinderGeometry(0.28, 0.45, 1.6, 8);
      const lightMat = new THREE.MeshStandardMaterial({ color: 0xf0fdfa, roughness: 0.5 });
      const lighthouse = new THREE.Mesh(lightGeo, lightMat);
      lighthouse.position.set(0, HEX_HEIGHT + 0.8, 0);
      lighthouse.castShadow = true;
      group.add(lighthouse);

      const domeGeo = new THREE.SphereGeometry(0.32, 8, 8);
      const domeMat = new THREE.MeshStandardMaterial({ color: 0x2dd4bf, roughness: 0.2, emissive: 0x14b8a6, emissiveIntensity: 0.3 });
      const dome = new THREE.Mesh(domeGeo, domeMat);
      dome.position.set(0, HEX_HEIGHT + 1.7, 0);
      group.add(dome);
    } else if (isWisdom) {
      const bookGeo = new THREE.BoxGeometry(0.65, 0.8, 0.5);
      const bookMat = new THREE.MeshStandardMaterial({ color: mainRoofColor, roughness: 0.4 });
      const bookMesh = new THREE.Mesh(bookGeo, bookMat);
      bookMesh.position.set(0, HEX_HEIGHT + 0.45, 0);
      bookMesh.rotation.y = 0.3;
      bookMesh.castShadow = true;
      group.add(bookMesh);

      const gemGeo = new THREE.OctahedronGeometry(0.25);
      const gemMat = new THREE.MeshStandardMaterial({
        color: island.accentColor,
        roughness: 0.1,
        emissive: island.accentColor,
        emissiveIntensity: 0.4
      });
      const gem = new THREE.Mesh(gemGeo, gemMat);
      gem.position.set(0, HEX_HEIGHT + 1.25, 0);
      gem.userData = { isFloatingGem: true, baseSpeed: 1.5 + Math.random() * 0.5 };
      group.add(gem);
    } else {
      const houseGeo = new THREE.BoxGeometry(0.75, 0.65, 0.65);
      const wallMat = new THREE.MeshStandardMaterial({ color: 0xfffbeb, roughness: 0.7 });
      const house = new THREE.Mesh(houseGeo, wallMat);
      house.position.set(0, HEX_HEIGHT + 0.33, 0);
      house.castShadow = true;
      group.add(house);

      const roofGeo = new THREE.ConeGeometry(0.62, 0.55, 4);
      const roofMat = new THREE.MeshStandardMaterial({ color: mainRoofColor, roughness: 0.6 });
      const roof = new THREE.Mesh(roofGeo, roofMat);
      roof.rotation.y = Math.PI / 4;
      roof.position.set(0, HEX_HEIGHT + 0.65 + 0.27, 0);
      roof.castShadow = true;
      group.add(roof);
    }

    // 2. 周圍小木屋與毛線絨球質感小樹
    const offsets = [
      { x: 0.85, z: 0.5, type: 'house' },
      { x: -0.75, z: 0.65, type: 'tree' },
      { x: 0.6, z: -0.8, type: 'tree' },
      { x: -0.85, z: -0.55, type: 'house' }
    ];

    offsets.forEach((pos, idx) => {
      if (pos.type === 'house') {
        const miniGeo = new THREE.BoxGeometry(0.48, 0.45, 0.48);
        const miniWall = new THREE.MeshStandardMaterial({ color: 0xfef3c7, roughness: 0.7 });
        const miniHouse = new THREE.Mesh(miniGeo, miniWall);
        miniHouse.position.set(pos.x, HEX_HEIGHT + 0.22, pos.z);
        miniHouse.rotation.y = (idx * Math.PI) / 3;
        miniHouse.castShadow = true;
        group.add(miniHouse);

        const miniRoofGeo = new THREE.ConeGeometry(0.38, 0.38, 4);
        const miniRoofMat = new THREE.MeshStandardMaterial({ color: mainRoofColor, roughness: 0.6 });
        const miniRoof = new THREE.Mesh(miniRoofGeo, miniRoofMat);
        miniRoof.rotation.y = miniHouse.rotation.y + Math.PI / 4;
        miniRoof.position.set(pos.x, HEX_HEIGHT + 0.45 + 0.18, pos.z);
        miniRoof.castShadow = true;
        group.add(miniRoof);
      } else {
        const trunkGeo = new THREE.CylinderGeometry(0.08, 0.11, 0.4, 6);
        const trunkMat = new THREE.MeshStandardMaterial({ color: 0x854d0e, roughness: 0.9 });
        const trunk = new THREE.Mesh(trunkGeo, trunkMat);
        trunk.position.set(pos.x, HEX_HEIGHT + 0.2, pos.z);
        trunk.castShadow = true;
        group.add(trunk);

        const foliageGeo = new THREE.DodecahedronGeometry(0.36, 1);
        const treeColor = isWisdom ? 0x6366f1 : (idx % 2 === 0 ? 0x15803d : 0x16a34a);
        const foliageMat = new THREE.MeshStandardMaterial({ color: treeColor, roughness: 0.85, flatShading: true });
        const foliage = new THREE.Mesh(foliageGeo, foliageMat);
        foliage.position.set(pos.x, HEX_HEIGHT + 0.52, pos.z);
        foliage.castShadow = true;
        group.add(foliage);
      }
    });
  }

  // ══════════════════════════════════════════════════════════════════════
  // 7. 拱橋系統 (沿地平線弧度架設)
  // ══════════════════════════════════════════════════════════════════════
  function buildBridges() {
    const BRIDGE_PAIRS = [
      ['cardio', 'stomach'],
      ['cardio', 'endoscopy'],
      ['cardio', 'metabolism'],
      ['stomach', 'liver'],
      ['stomach', 'colon'],
      ['stomach', 'endoscopy'],
      ['liver', 'endoscopy'],
      ['colon', 'metabolism'],
      // 跨界大天橋 (Grand Cross-Realm Bridge)
      ['cardio', 'wealth-ladder'],
      // 知識宇宙群島互連
      ['wealth-ladder', 'six-neuro'],
      ['wealth-ladder', 'random-walk'],
      ['wealth-ladder', 'die-with-zero'],
      ['six-neuro', 'glucose-goddess'],
      ['six-neuro', 'die-with-zero'],
      ['glucose-goddess', 'die-with-zero'],
      ['random-walk', 'four-pillars'],
      ['die-with-zero', 'four-pillars']
    ];

    BRIDGE_PAIRS.forEach(([idA, idB]) => {
      const objA = islandObjectsMap.get(idA);
      const objB = islandObjectsMap.get(idB);
      if (!objA || !objB) return;

      const pA = objA.position;
      const pB = objB.position;
      const isCrossRealm = (idA === 'cardio' && idB === 'wealth-ladder');

      // 拱橋中點往球面法線方向抬升，吻合地球地平線弧度
      const mid = new THREE.Vector3().addVectors(pA, pB).multiplyScalar(0.5);
      const radialDir = new THREE.Vector3().subVectors(mid, PLANET_CENTER).normalize();
      const dist = pA.distanceTo(pB);

      // 將中點拉回球面外緣並加上拱高
      mid.copy(PLANET_CENTER).addScaledVector(radialDir, PLANET_RADIUS + HEX_HEIGHT + (isCrossRealm ? 0.15 : 0.08));

      const bridgeGroup = new THREE.Group();
      bridgeGroup.position.copy(mid);

      // 橋體朝向
      const forward = new THREE.Vector3().subVectors(pB, pA).normalize();
      const up = radialDir;
      const right = new THREE.Vector3().crossVectors(up, forward).normalize();
      const realUp = new THREE.Vector3().crossVectors(forward, right).normalize();
      const mat4 = new THREE.Matrix4().makeBasis(forward, realUp, right);
      bridgeGroup.quaternion.setFromRotationMatrix(mat4);

      const bridgeLen = dist * 0.48;
      const bridgeWidth = isCrossRealm ? 0.72 : 0.52;

      const archGeo = new THREE.BoxGeometry(bridgeLen, 0.16, bridgeWidth);
      const archMat = new THREE.MeshStandardMaterial({
        color: isCrossRealm ? 0xfcd34d : 0xf1ebe5,
        roughness: 0.6,
        metalness: isCrossRealm ? 0.3 : 0.05
      });
      const arch = new THREE.Mesh(archGeo, archMat);
      arch.castShadow = true;
      arch.receiveShadow = true;
      bridgeGroup.add(arch);

      // 欄杆
      const railGeo = new THREE.BoxGeometry(bridgeLen, 0.12, 0.06);
      const railMat = new THREE.MeshStandardMaterial({ color: isCrossRealm ? 0xd97706 : 0xa8a29e, roughness: 0.7 });
      const rail1 = new THREE.Mesh(railGeo, railMat);
      rail1.position.set(0, 0.14, bridgeWidth / 2 - 0.03);
      bridgeGroup.add(rail1);

      const rail2 = new THREE.Mesh(railGeo, railMat);
      rail2.position.set(0, 0.14, -bridgeWidth / 2 + 0.03);
      bridgeGroup.add(rail2);

      bridgesGroup.add(bridgeGroup);
    });
  }

  // ══════════════════════════════════════════════════════════════════════
  // 8. 沿大氣層升起之跨領域能量光索 (Atmospheric Flow Arcs)
  // ══════════════════════════════════════════════════════════════════════
  function buildFlowLines() {
    FLOW_CONNECTIONS.forEach((flow) => {
      const objA = islandObjectsMap.get(flow.from);
      const objB = islandObjectsMap.get(flow.to);
      if (!objA || !objB) return;

      const normA = objA.userData.normal;
      const normB = objB.userData.normal;

      const pA = objA.position.clone().addScaledVector(normA, HEX_HEIGHT + 0.4);
      const pB = objB.position.clone().addScaledVector(normB, HEX_HEIGHT + 0.4);
      const mid = new THREE.Vector3().addVectors(pA, pB).multiplyScalar(0.5);
      const radialDir = new THREE.Vector3().subVectors(mid, PLANET_CENTER).normalize();

      // 能量弧線拋向大氣層高空
      mid.copy(PLANET_CENTER).addScaledVector(radialDir, PLANET_RADIUS + HEX_HEIGHT + 2.8 + pA.distanceTo(pB) * 0.2);

      const curve = new THREE.QuadraticBezierCurve3(pA, mid, pB);
      const points = curve.getPoints(50);
      const geo = new THREE.BufferGeometry().setFromPoints(points);

      const mat = new THREE.LineDashedMaterial({
        color: flow.color,
        dashSize: 0.5,
        gapSize: 0.35,
        linewidth: 2,
        transparent: true,
        opacity: 0.85
      });

      const line = new THREE.Line(geo, mat);
      line.computeLineDistances();
      flowsGroup.add(line);

      // 光子球
      const photonGeo = new THREE.SphereGeometry(0.12, 8, 8);
      const photonMat = new THREE.MeshBasicMaterial({ color: flow.color });
      const photon = new THREE.Mesh(photonGeo, photonMat);
      flowsGroup.add(photon);

      flowCurves.push({ curve, photon, progress: Math.random(), speed: 0.0035 + Math.random() * 0.002 });
    });
  }

  // ══════════════════════════════════════════════════════════════════════
  // 9. 黏土小人微型漫步者 (Chibi Walkers on Curved Planet)
  // ══════════════════════════════════════════════════════════════════════
  function spawnWalkers() {
    const walkerColors = [0x3b82f6, 0xef4444, 0x10b981, 0xf59e0b, 0x8b5cf6, 0xec4899];
    const totalWalkers = 10;

    for (let i = 0; i < totalWalkers; i++) {
      const walkerGroup = new THREE.Group();

      const bodyGeo = new THREE.CylinderGeometry(0.08, 0.12, 0.22, 8);
      const bodyMat = new THREE.MeshStandardMaterial({
        color: walkerColors[i % walkerColors.length],
        roughness: 0.7
      });
      const body = new THREE.Mesh(bodyGeo, bodyMat);
      body.position.y = 0.15;
      walkerGroup.add(body);

      const headGeo = new THREE.SphereGeometry(0.1, 10, 10);
      const headMat = new THREE.MeshStandardMaterial({ color: 0xffedd5, roughness: 0.8 });
      const head = new THREE.Mesh(headGeo, headMat);
      head.position.y = 0.32;
      walkerGroup.add(head);

      const island = ISLAND_DATA[i % ISLAND_DATA.length];
      const islandObj = islandObjectsMap.get(island.id);
      if (islandObj) {
        walkerGroup.position.copy(islandObj.position).addScaledVector(islandObj.userData.normal, HEX_HEIGHT);
        walkerGroup.quaternion.copy(islandObj.quaternion);
      }
      walkersGroup.add(walkerGroup);

      walkers.push({
        group: walkerGroup,
        currentIsland: island.id,
        targetPos: walkerGroup.position.clone(),
        speed: 0.015 + Math.random() * 0.015,
        pauseTicks: 0
      });
    }
  }

  function updateWalkers() {
    if (!showWalkers) return;

    walkers.forEach((w) => {
      if (w.pauseTicks > 0) {
        w.pauseTicks--;
        return;
      }

      const curPos = w.group.position;
      const dist = curPos.distanceTo(w.targetPos);

      if (dist < 0.1) {
        w.pauseTicks = Math.floor(60 + Math.random() * 120);

        const island = islandObjectsMap.get(w.currentIsland);
        if (island) {
          const origin = island.position;
          const normal = island.userData.normal;
          const tangent = new THREE.Vector3(1, 0, 0).cross(normal).normalize();
          const bitangent = new THREE.Vector3().crossVectors(normal, tangent).normalize();

          const angle = Math.random() * Math.PI * 2;
          const r = Math.random() * 1.3;
          w.targetPos.copy(origin)
            .addScaledVector(tangent, Math.cos(angle) * r)
            .addScaledVector(bitangent, Math.sin(angle) * r)
            .addScaledVector(normal, HEX_HEIGHT);
        }
      } else {
        const dir = new THREE.Vector3().subVectors(w.targetPos, curPos).normalize();
        curPos.addScaledVector(dir, w.speed);
      }
    });
  }

  // ══════════════════════════════════════════════════════════════════════
  // 10. 點擊互動與射線選取
  // ══════════════════════════════════════════════════════════════════════
  const raycaster = new THREE.Raycaster();
  const mouse = new THREE.Vector2();

  function setupRaycaster() {
    container.addEventListener('pointerdown', (e) => {
      container._startX = e.clientX;
      container._startY = e.clientY;
    });

    container.addEventListener('pointerup', (e) => {
      const dx = Math.abs(e.clientX - container._startX);
      const dy = Math.abs(e.clientY - container._startY);
      if (dx > 6 || dy > 6) return;

      const rect = renderer.domElement.getBoundingClientRect();
      mouse.x = ((e.clientX - rect.left) / rect.width) * 2 - 1;
      mouse.y = -((e.clientY - rect.top) / rect.height) * 2 + 1;

      raycaster.setFromCamera(mouse, camera);
      const intersects = raycaster.intersectObjects(islandsGroup.children, true);

      if (intersects.length > 0) {
        let current = intersects[0].object;
        let foundIslandId = null;

        while (current && current !== scene) {
          if (current.userData && current.userData.islandId) {
            foundIslandId = current.userData.islandId;
            break;
          }
          current = current.parent;
        }

        if (foundIslandId) {
          focusIsland(foundIslandId);
        }
      }
    });
  }

  // ══════════════════════════════════════════════════════════════════════
  // 11. 平滑相機飛行與島嶼登陸
  // ══════════════════════════════════════════════════════════════════════
  function focusIsland(islandId) {
    const island = ISLAND_DATA.find((i) => i.id === islandId);
    if (!island) return;

    activeIsland = islandId;

    // 1. 更新反白光圈
    islandObjectsMap.forEach((obj, id) => {
      if (obj.userData.selectionRing) {
        obj.userData.selectionRing.material.opacity = id === islandId ? 0.95 : 0;
      }
    });

    // 2. 開啟左側全文章抽屜
    openDetailCard(island);

    // 3. 高亮右側導覽列並在手機版收合目錄
    highlightSidebarRow(islandId);
    if (window.innerWidth <= 900) {
      const sidebar = document.getElementById('islandNavSidebar');
      const toggleSidebarBtn = document.getElementById('toggleSidebarBtn');
      if (sidebar) sidebar.classList.remove('open-mobile');
      if (toggleSidebarBtn) toggleSidebarBtn.classList.remove('active');
    }

    // 4. 計算沿著地球地平線傾角飛行之相機目標點
    const obj = islandObjectsMap.get(islandId);
    const center = obj.position;
    const normal = obj.userData.normal;

    // 相機停在島嶼正上方偏後方
    cameraDestPos = center.clone().addScaledVector(normal, 4.8).add(new THREE.Vector3(0.2, 0.4, 5.2));
    cameraTarget = center.clone().addScaledVector(normal, HEX_HEIGHT + 0.3);

    startCameraFlight(cameraDestPos, cameraTarget, 1200);
  }

  function resetView() {
    activeIsland = null;
    closeDetailCard();

    islandObjectsMap.forEach((obj) => {
      if (obj.userData.selectionRing) obj.userData.selectionRing.material.opacity = 0;
    });

    document.querySelectorAll('.sidebar-island-row').forEach(r => r.classList.remove('active'));

    const overviewLookAt = new THREE.Vector3(2.1, 0, 0);
    const overviewPos = new THREE.Vector3(2.1, 18, 22);
    startCameraFlight(overviewPos, overviewLookAt, 1400);
  }

  function startCameraFlight(destPos, destLookAt, durationMs) {
    flightStartPos.copy(camera.position);
    flightStartLookAt.copy(controls.target);
    cameraDestPos.copy(destPos);
    cameraTarget.copy(destLookAt);

    flightStartTime = performance.now();
    flightDuration = durationMs;
    isFlightActive = true;
    controls.enabled = false;
  }

  function updateCameraFlight() {
    if (!isFlightActive) return;

    const elapsed = performance.now() - flightStartTime;
    const progress = Math.min(elapsed / flightDuration, 1);
    const ease = progress < 0.5
      ? 4 * progress * progress * progress
      : 1 - Math.pow(-2 * progress + 2, 3) / 2;

    camera.position.lerpVectors(flightStartPos, cameraDestPos, ease);
    controls.target.lerpVectors(flightStartLookAt, cameraTarget, ease);

    if (progress >= 1) {
      isFlightActive = false;
      controls.enabled = true;
    }
  }

  // ══════════════════════════════════════════════════════════════════════
  // 12. UI 面板與互動事件 (支援全文章展示與島內搜尋)
  // ══════════════════════════════════════════════════════════════════════
  let currentDrawerArticles = [];

  function setupUI() {
    // 星系切換鈕
    const realmPills = document.querySelectorAll('.realm-pill');
    realmPills.forEach((pill) => {
      pill.addEventListener('click', () => {
        realmPills.forEach(p => p.classList.remove('active'));
        pill.classList.add('active');
        filterRealm(pill.dataset.realm);
      });
    });

    // 光照時序鈕
    const timeBtns = document.querySelectorAll('.time-btn');
    timeBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        timeBtns.forEach(b => b.classList.remove('active'));
        btn.classList.add('active');
        applyTimePreset(btn.dataset.time);
      });
    });

    // 標籤開關
    const toggleLabelsBtn = document.getElementById('toggleLabelsBtn');
    toggleLabelsBtn.addEventListener('click', () => {
      showLabels = !showLabels;
      toggleLabelsBtn.classList.toggle('active', showLabels);
      badgeObjects.forEach(b => b.classList.toggle('labels-hidden', !showLabels));
    });

    // 漫步小人開關
    const toggleWalkersBtn = document.getElementById('toggleWalkersBtn');
    toggleWalkersBtn.addEventListener('click', () => {
      showWalkers = !showWalkers;
      toggleWalkersBtn.classList.toggle('active', showWalkers);
      walkersGroup.visible = showWalkers;
    });

    // 能量光流開關
    const toggleFlowsBtn = document.getElementById('toggleFlowsBtn');
    toggleFlowsBtn.addEventListener('click', () => {
      showFlows = !showFlows;
      toggleFlowsBtn.classList.toggle('active', showFlows);
      flowsGroup.visible = showFlows;
    });

    // 全景重置按鈕
    document.getElementById('resetCamBtn').addEventListener('click', resetView);

    // 側邊欄切換
    const sidebar = document.getElementById('islandNavSidebar');
    const toggleSidebarBtn = document.getElementById('toggleSidebarBtn');
    toggleSidebarBtn.addEventListener('click', () => {
      if (window.innerWidth <= 900) {
        sidebar.classList.toggle('open-mobile');
        toggleSidebarBtn.classList.toggle('active', sidebar.classList.contains('open-mobile'));
        if (sidebar.classList.contains('open-mobile')) {
          closeDetailCard();
        }
      } else {
        sidebar.classList.toggle('collapsed');
        toggleSidebarBtn.classList.toggle('active', !sidebar.classList.contains('collapsed'));
      }
    });

    // 關閉左側卡片
    document.getElementById('closeDetailBtn').addEventListener('click', closeDetailCard);

    // 填入右側導覽列清單
    populateSidebar();

    // 右側側邊欄搜尋
    const searchInput = document.getElementById('islandSearchInput');
    searchInput.addEventListener('input', (e) => {
      const query = e.target.value.trim().toLowerCase();
      filterSidebarBySearch(query);
    });

    // 抽屜內全文章搜尋過濾框
    const drawerSearch = document.getElementById('drawerArticleSearch');
    drawerSearch.addEventListener('input', (e) => {
      const query = e.target.value.trim().toLowerCase();
      renderDrawerArticles(query);
    });

    // 鍵盤 Esc 關閉抽屜
    window.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') {
        closeDetailCard();
      }
    });
  }

  // 填入右側島嶼清單
  function populateSidebar() {
    const healthContainer = document.getElementById('healthItems');
    const wisdomContainer = document.getElementById('wisdomItems');

    healthContainer.innerHTML = '';
    wisdomContainer.innerHTML = '';

    let totalHealthArticles = 0;
    let totalWisdomArticles = 0;

    ISLAND_DATA.forEach((island) => {
      const count = island.articles.length;
      if (island.realm === 'health') totalHealthArticles += count;
      else totalWisdomArticles += count;

      const row = document.createElement('div');
      row.className = 'sidebar-island-row';
      row.dataset.islandId = island.id;
      row.dataset.islandName = island.name.toLowerCase();
      row.dataset.islandSubtitle = island.subtitle.toLowerCase();
      row.innerHTML = `
        <div class="sidebar-island-main">
          <div class="sidebar-island-icon">${island.icon}</div>
          <span class="sidebar-island-name">${island.name}</span>
        </div>
        <span class="sidebar-island-tag">${count}篇</span>
      `;
      row.addEventListener('click', () => {
        focusIsland(island.id);
      });

      if (island.realm === 'health') {
        healthContainer.appendChild(row);
      } else {
        wisdomContainer.appendChild(row);
      }
    });

    const healthIslandsCount = ISLAND_DATA.filter(i => i.realm === 'health').length;
    const wisdomIslandsCount = ISLAND_DATA.filter(i => i.realm === 'wisdom').length;
    document.getElementById('healthTotalStat').textContent = `${healthIslandsCount} 座群島 · ${totalHealthArticles} 篇專文`;
    document.getElementById('wisdomTotalStat').textContent = `${wisdomIslandsCount} 部名著 · ${totalWisdomArticles} 篇章節`;
  }

  function highlightSidebarRow(islandId) {
    document.querySelectorAll('.sidebar-island-row').forEach((row) => {
      row.classList.toggle('active', row.dataset.islandId === islandId);
    });
  }

  function filterSidebarBySearch(query) {
    document.querySelectorAll('.sidebar-island-row').forEach((row) => {
      const name = row.dataset.islandName;
      const sub = row.dataset.islandSubtitle;
      const match = !query || name.includes(query) || sub.includes(query);
      row.style.display = match ? 'flex' : 'none';
    });
  }

  function filterRealm(realm) {
    islandsGroup.children.forEach((group) => {
      const data = group.userData.islandData;
      if (!data) return;
      const visible = realm === 'all' || data.realm === realm;
      group.visible = visible;
    });

    document.querySelectorAll('.realm-group').forEach((group) => {
      const groupRealm = group.dataset.realmGroup;
      const visible = realm === 'all' || groupRealm === realm;
      group.style.display = visible ? 'block' : 'none';
    });

    if (activeIsland) {
      const activeData = ISLAND_DATA.find(i => i.id === activeIsland);
      if (activeData && realm !== 'all' && activeData.realm !== realm) {
        resetView();
      }
    }
  }

  // 開啟左側抽屜並載入「全文章與章節」
  function openDetailCard(island) {
    const drawer = document.getElementById('islandDetailCard');
    const realmTag = document.getElementById('cardRealmTag');
    const icon = document.getElementById('cardIcon');
    const title = document.getElementById('cardTitle');
    const subtitle = document.getElementById('cardSubtitle');
    const desc = document.getElementById('cardDesc');
    const ctaBtn = document.getElementById('cardCtaBtn');
    const drawerSearch = document.getElementById('drawerArticleSearch');

    realmTag.textContent = island.realm === 'health' ? '🏥 人體健康微縮群島' : '📚 知識宇宙探索群島';
    realmTag.classList.toggle('wisdom-style', island.realm === 'wisdom');

    icon.textContent = island.icon;
    title.textContent = island.name;
    subtitle.textContent = island.subtitle;
    desc.textContent = island.desc;

    ctaBtn.href = island.ctaUrl;
    ctaBtn.querySelector('span').textContent = island.ctaText;

    // 清空抽屜搜尋欄並重置當前文章清單
    drawerSearch.value = '';
    currentDrawerArticles = island.articles;
    renderDrawerArticles('');

    drawer.classList.add('open');
    drawer.setAttribute('aria-hidden', 'false');
  }

  // 渲染抽屜內全文章列表 (保留 100% 原始標題)
  function renderDrawerArticles(filterText) {
    const pinList = document.getElementById('cardPinList');
    const countBadge = document.getElementById('drawerArticlesCount');

    const filtered = currentDrawerArticles.filter(art => {
      if (!filterText) return true;
      return art.title.toLowerCase().includes(filterText) ||
             (art.category && art.category.toLowerCase().includes(filterText));
    });

    countBadge.textContent = `${filtered.length} 篇`;

    if (filtered.length === 0) {
      pinList.innerHTML = `
        <div style="text-align: center; padding: 24px 10px; color: #8aa4b2; font-size: 0.86rem; font-weight: 600;">
          無相符文章或章節
        </div>
      `;
      return;
    }

    pinList.innerHTML = filtered.map((art, idx) => `
      <a href="${art.url}" class="pin-item-card" target="_blank" rel="noopener">
        <div class="pin-num">${idx + 1}</div>
        <div class="pin-text-col">
          <div class="pin-title">${art.title}</div>
          <div class="pin-sub">${art.category}</div>
        </div>
        <svg class="pin-arrow-ic" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="9 18 15 12 9 6"/></svg>
      </a>
    `).join('');
  }

  function closeDetailCard() {
    const drawer = document.getElementById('islandDetailCard');
    drawer.classList.remove('open');
    drawer.setAttribute('aria-hidden', 'true');
    if (activeIsland) {
      const islandObj = islandObjectsMap.get(activeIsland);
      if (islandObj && islandObj.userData.selectionRing) {
        islandObj.userData.selectionRing.material.opacity = 0;
      }
      activeIsland = null;
    }
    document.querySelectorAll('.sidebar-island-row').forEach(r => r.classList.remove('active'));
  }

  function onWindowResize() {
    const width = container.clientWidth;
    const height = container.clientHeight;
    camera.aspect = width / height;
    camera.updateProjectionMatrix();
    renderer.setSize(width, height);
    cssRenderer.setSize(width, height);
  }

  // ══════════════════════════════════════════════════════════════════════
  // 13. 主渲染迴圈
  // ══════════════════════════════════════════════════════════════════════
  function animate() {
    requestAnimationFrame(animate);

    const now = Date.now();
    const elapsedTime = now * 0.001;

    // 1. 180s 日夜循環光影與天空星空更新
    updateDayNightCycle(elapsedTime);

    // 2. 動態海浪與慢速漂浮白雲更新
    updateWavesAndClouds(elapsedTime);

    // 2. 能量光流粒子在大氣層高空飛掠
    if (showFlows) {
      flowCurves.forEach((item) => {
        item.progress = (item.progress + item.speed) % 1;
        const pos = item.curve.getPointAt(item.progress);
        item.photon.position.copy(pos);
      });
    }

    // 3. 漫步微型小人移動更新
        // 飛鳥群 8 字型立體盤旋飛行與扇動翅膀
    if (birdFlockData && birdFlockData.birds) {
      birdFlockData.birds.forEach((bird) => {
        const u = bird.userData;
        if (u) {
          const t = elapsedTime * (u.speed || 1.0) + (u.phase || 0);
          bird.position.y = u.baseY + Math.sin(t * 2.5) * 0.45;
          bird.position.x = u.baseX + Math.sin(t * 0.8) * 1.5;
          bird.rotation.z = Math.sin(t * 3.0) * 0.12;
        }
      });
    }

    updateWalkers();

    // 4. 書卷水晶微幅漂浮旋轉
    islandsGroup.traverse((child) => {
      if (child.userData && child.userData.isFloatingGem) {
        child.rotation.y += 0.02;
        child.position.y = HEX_HEIGHT + 1.25 + Math.sin(now * 0.003 * child.userData.baseSpeed) * 0.08;
      }
    });

    // 5. 相機飛行補間更新
    updateCameraFlight();

    controls.update();
    renderer.render(scene, camera);
    cssRenderer.render(scene, camera);
  }

  // 啟動 3D 微縮星球世界
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', init);
  } else {
    init();
  }
</script>
