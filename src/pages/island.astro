  function triggerAnimalInteraction(animalRoot) {
    if (!animalRoot) return;
    triggerSquash(animalRoot);
    const worldPos = new THREE.Vector3();
    animalRoot.getWorldPosition(worldPos);
    const aType = animalRoot.userData && animalRoot.userData.animalType;
    playIslandSound(aType || 'cat');
    const pool = (aType && ANIMAL_QUOTES_BY_TYPE[aType]) ? ANIMAL_QUOTES_BY_TYPE[aType] : HEALTH_WEALTH_QUOTES;
    const msg = pool[Math.floor(Math.random() * pool.length)];
