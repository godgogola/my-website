        const lintel = new THREE.Mesh(new THREE.BoxGeometry(0.68, 0.18, 0.24), stonehengeMat);
        lintel.position.set(0, 0.75 + 0.09, 0);
        lintel.castShadow = true;
        triGroup.add(lintel);

        wildGroup.add(triGroup);
