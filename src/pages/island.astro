  const SPACING = 6.25;       // 網格間距參數 D (使得相鄰島中心距離 dist = sqrt(3)*D = 10.825)
  // 水道淨寬 = dist - 2 * r_inner = 10.825 - 6.235 = 4.59 單位 (完美符合 4.5~5 規範)

  // 兩大群島：醫學筆島群 (health) 與 讀書筆記島群 (wisdom)，左右並列，中間隔著開闊海峽 (由渡船往來)
  const ARCHIPELAGO_GAP = 20.0;
  const REALM_OFFSET_X = {
    health: -ARCHIPELAGO_GAP / 2,
    wisdom: ARCHIPELAGO_GAP / 2
  };

  // 標準蜂巢六角座標 (q, r) 轉換為 3D 平面世界座標 (x, y=0, z)
  // x = D * (Math.sqrt(3) * q + (Math.sqrt(3) / 2) * r)
  // z = D * (1.5 * r)
  function hexToPlanet(q, r, realm = 'health') {
    const worldX = SPACING * (Math.sqrt(3) * q + (Math.sqrt(3) / 2) * r) + (REALM_OFFSET_X[realm] ?? 0);
    const worldZ = SPACING * (1.5 * r);
    const worldY = 0; // 徹底移除地球弧度下陷，所有島嶼基準基座純平放在 y = 0 平面上

    return {
      position: new THREE.Vector3(worldX, worldY, worldZ),
      normal: new THREE.Vector3(0, 1, 0),
      orientation: new THREE.Quaternion() // 純水平無傾角
    };
  }

  // ══════════════════════════════════════════════════════════════════════
  // 3. Three.js 場景初始化
  // ══════════════════════════════════════════════════════════════════════
  const container = document.getElementById('canvasMount');
  const viewportBox = document.getElementById('viewportContainer');

  let scene, camera, renderer, cssRenderer, controls;
  let islandsGroup = new THREE.Group();
  let bridgesGroup = new THREE.Group();
  let walkersGroup = new THREE.Group();
  let flowsGroup = new THREE.Group();
  let lightsGroup = new THREE.Group();
  let waterSphere;

  
  // ══════════════════════════════════════════════════════════════════════
  // 6 大自然與光影特效系統變數 (Day/Night, Stars, Clouds, Waves, Night Lights)
  // ══════════════════════════════════════════════════════════════════════
  const clock = new THREE.Clock();
  let celestialPivot;          // 日月旋轉軸
  let sunMesh, sunLight, sunGlowSprite;
  let moonMesh, moonLight, moonGlowSprite;
  let starfieldPoints, milkyWayPoints;
  let cloudsGroup;             // 低空慢速雲朵
  let oceanMesh, oceanGeo, oceanInitialPositions;
  let nightGlowMaterial = new THREE.MeshBasicMaterial({ color: 0x475569 }); // 路燈與窗戶夜間發光材質
  let nightPointLights = [];   // 島嶼夜間暖光
  let isAutoDayNight = true;   // 是否開啟 180s 自動循環
  let targetCycle = 0.25;      // 當前目標時間 (預設正午 0.25)
  let currentCycle = 0.25;     // 插值平滑 cycle
  let manualTimeLock = false;  // 手動選擇時段鎖定

  let dirLight, hemiLight, ambientLight;
  let activeIsland = null;
  let showLabels = true;
  let showWalkers = true;
  let showFlows = true;

  const islandObjectsMap = new Map();
  const badgeObjects = [];
  const walkers = [];
  const flowCurves = [];
  let birdFlockData = null;
  let animatedWindmills = []; // { mesh, speed }
  let animatedFlags = [];     // { mesh, baseRotY, speed, phase }
  let animatedCampfires = []; // { light, baseIntensity }

  // 動態相機飛行參數
  let cameraTarget = new THREE.Vector3(0, 0, 0);
  let cameraLookAt = new THREE.Vector3(0, 0, 0);
  let cameraDestPos = new THREE.Vector3(0, 54, 70);
  let flightStartTime = 0;
  let flightDuration = 0;
  let flightStartPos = new THREE.Vector3();
  let flightStartLookAt = new THREE.Vector3();
  let isFlightActive = false;

  function init() {
    // Scene
    scene = new THREE.Scene();
    scene.background = new THREE.Color(0xdff2f8);
    scene.fog = null; // 徹底移除全域霧氣，呈現通透、高對比且色彩鮮豔的清晰視覺

    // Camera: 採用窄視角微縮透視鏡頭 (FOV 32° 斜角俯瞰)，呈現精緻桌遊微縮等角感
    const aspect = container.clientWidth / container.clientHeight;
    camera = new THREE.PerspectiveCamera(32, aspect, 0.5, 450);
    camera.position.set(0, 54, 70);

    // WebGL Renderer
    renderer = new THREE.WebGLRenderer({ antialias: true, alpha: true, powerPreference: 'high-performance' });
    renderer.setSize(container.clientWidth, container.clientHeight);
    renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
    renderer.shadowMap.enabled = true;
    renderer.shadowMap.type = THREE.PCFSoftShadowMap;
    renderer.toneMapping = THREE.ACESFilmicToneMapping;
    renderer.toneMappingExposure = 1.05;
    container.appendChild(renderer.domElement);

    // CSS2D Renderer (Sharp HTML Floating Badges)
    cssRenderer = new CSS2DRenderer();
    cssRenderer.setSize(container.clientWidth, container.clientHeight);
    cssRenderer.domElement.style.position = 'absolute';
    cssRenderer.domElement.style.top = '0px';
    cssRenderer.domElement.style.left = '0px';
    cssRenderer.domElement.style.pointerEvents = 'none';
    viewportBox.appendChild(cssRenderer.domElement);

    // Orbit Controls
    controls = new OrbitControls(camera, renderer.domElement);
    controls.enableDamping = true;
    controls.dampingFactor = 0.06;
    controls.maxPolarAngle = Math.PI / 2.15; // 不穿入水底
    controls.minDistance = 5;
    controls.maxDistance = 180;
    controls.target.set(0, 0, 0);

    // 添加核心群組
    scene.add(lightsGroup);
    scene.add(islandsGroup);
    scene.add(bridgesGroup);
    scene.add(walkersGroup);
    scene.add(flowsGroup);

    createDayNightSystem();   // 1. 太陽月亮 180s 日夜循環
    createStarfieldAndMilkyWay(); // 2. 穹頂星空與銀河微粒
    createMountainRing();     // 3a. 環湖群山 + 松林 + 山坡小屋
    createIslets();           // 3b. 湖心沙洲與燈塔
    createLowPolyClouds();    // 3c. 群山之上的雲海
    createBoats();            // 3d. 湖上帆船
    createCurvedOcean();      // 4. 動態波浪海洋
    setupNightLights();       // 5. 初始化夜間發光材質 (在建島與造橋前就緒)
    buildIslands();           // 6. 24 座微縮島嶼
    buildBridges();           // 7. 連接木橋 (同群島相鄰島之間)
    createFerries();          // 7b. 兩大群島之間的渡船與碼頭
    buildFlowLines();         // 8. 跨界光流索
    spawnWalkers();           // 9. 漫步小人
    birdFlockData = createBirdFlock(); // 10. 飛鳥振翅盤旋
    setupRaycaster();
    setupUI();

    const urlParams = new URLSearchParams(window.location.search);
    const timeParam = urlParams.get('time');
    if (timeParam) {
      manualTimeLock = true;
      isAutoDayNight = false;
      document.querySelectorAll('.time-btn').forEach(b => b.classList.remove('active'));
      const activeBtn = document.querySelector(`[data-time="${timeParam}"]`);
      if (activeBtn) activeBtn.classList.add('active');

      applyTimePreset(timeParam);
    }

    if (urlParams.get('view') === 'bird') setBirdView(true);

    window.addEventListener('resize', onWindowResize);

    // 關閉載入視窗
    setTimeout(() => {
      const loader = document.getElementById('loadingOverlay');
      if (loader) loader.classList.add('hidden');
    }, 450);

    animate();
  }

  // ══════════════════════════════════════════════════════════════════════
  // 4. 光照與時序光影
  // ══════════════════════════════════════════════════════════════════════
  function createBirdFlock() {
    const flockGroup = new THREE.Group();
    const birdGeo = new THREE.BufferGeometry();
    const birdVerts = new Float32Array([
      -0.35, 0.12, 0,
      0, 0, 0.08,
      0.35, 0.12, 0
    ]);
    birdGeo.setAttribute('position', new THREE.BufferAttribute(birdVerts, 3));
    const birdMat = new THREE.LineBasicMaterial({ color: 0x27272a, linewidth: 2.2 });
    
    const birdMeshes = [];
    for (let i = 0; i < 20; i++) {
      const bird = new THREE.Line(birdGeo, birdMat);
      const baseX = -24 - (i % 5) * 3.6 + Math.random() * 2;
      const baseY = 8.8 + (i * 0.42) + Math.random() * 1.5;
      const baseZ = -16 - (i * 1.2);
      bird.position.set(baseX, baseY, baseZ);
      bird.rotation.y = -0.42;
      bird.scale.setScalar(0.72 + (i % 4) * 0.18);
      bird.userData = {
        baseX, baseY, baseZ,
        phase: i * 0.4,
        speed: 0.8 + (i % 3) * 0.3
      };
      flockGroup.add(bird);
      birdMeshes.push(bird);
    }
    scene.add(flockGroup);
    return { group: flockGroup, birds: birdMeshes };
  }

  // 全景天空穹頂 Shader (左側夕陽霞光 ➔ 右側午夜星空)

  function setupLights() {
    ambientLight = new THREE.AmbientLight(0xffffff, 0.55);
    lightsGroup.add(ambientLight);

    hemiLight = new THREE.HemisphereLight(0xffffff, 0xe0f7fa, 0.9);
    lightsGroup.add(hemiLight);

    dirLight = new THREE.DirectionalLight(0xfffdf2, 1.2);
    dirLight.position.set(16, 26, 18);
    dirLight.castShadow = true;
    dirLight.shadow.mapSize.width = 2048;
    dirLight.shadow.mapSize.height = 2048;
    dirLight.shadow.camera.near = 1;
    dirLight.shadow.camera.far = 70;
    const d = 24;
    dirLight.shadow.camera.left = -d;
    dirLight.shadow.camera.right = d;
    dirLight.shadow.camera.top = d;
    dirLight.shadow.camera.bottom = -d;
    dirLight.shadow.bias = -0.0004;
    lightsGroup.add(dirLight);
  }

  function applyTimePreset(time) {
    manualTimeLock = true;
    isAutoDayNight = false;
    if (time === 'dawn') targetCycle = currentCycle = 0.02;
    else if (time === 'noon') targetCycle = currentCycle = 0.25;
    else if (time === 'dusk') targetCycle = currentCycle = 0.48;
    else if (time === 'night') targetCycle = currentCycle = 0.75;

    const isNightTime = currentCycle > 0.46 && currentCycle < 0.96;
    if (nightGlowMaterial) {
      nightGlowMaterial.color.set(isNightTime ? 0xffea79 : 0x475569);
    }
    nightPointLights.forEach((pl) => {
      pl.intensity = isNightTime ? 3.2 : 0.0;
    });
    if (starfieldPoints) {
      starfieldPoints.visible = isNightTime;
      starfieldPoints.material.opacity = isNightTime ? 1.0 : 0.0;
    }
    if (milkyWayPoints) {
      milkyWayPoints.visible = isNightTime;
      milkyWayPoints.material.opacity = isNightTime ? 1.0 : 0.0;
    }
  }


  // ══════════════════════════════════════════════════════════════════════
  // 6. 沿地球弧度建造六角島嶼 (Curved Hexagonal Islands)
  // ══════════════════════════════════════════════════════════════════════
  
  // ══════════════════════════════════════════════════════════════════════
  // 系統 1: 180 秒日夜循環系統 (太陽 + 月亮 + 天空色彩插值)
  // ══════════════════════════════════════════════════════════════════════
  function createDayNightSystem() {
    celestialPivot = new THREE.Group();
    celestialPivot.position.set(2.1, 0, 0);
    celestialPivot.rotation.x = -0.35; // 傾斜軸，讓太陽從左前天際升起，月亮從右後天際升起
    scene.add(celestialPivot);

    // ── 太陽端 (Radius 28) ──
    const sunGroup = new THREE.Group();
    sunGroup.position.set(-28, 0, 0);

    const sunGeo = new THREE.SphereGeometry(2.0, 24, 24);
    const sunMat = new THREE.MeshBasicMaterial({ color: 0xfff9db });
    sunMesh = new THREE.Mesh(sunGeo, sunMat);
    sunGroup.add(sunMesh);

    // 太陽金色放射日冕 Sprite
    const sunCanvas = document.createElement('canvas');
    sunCanvas.width = 256;
    sunCanvas.height = 256;
    const sctx = sunCanvas.getContext('2d');
    const sgrad = sctx.createRadialGradient(128, 128, 14, 128, 128, 128);
    sgrad.addColorStop(0.0, 'rgba(255, 255, 235, 1.0)');
    sgrad.addColorStop(0.25, 'rgba(254, 215, 170, 0.85)');
    sgrad.addColorStop(0.6, 'rgba(251, 146, 60, 0.35)');
    sgrad.addColorStop(1.0, 'rgba(251, 146, 60, 0.0)');
    sctx.fillStyle = sgrad;
    sctx.fillRect(0, 0, 256, 256);
    const sunTexture = new THREE.CanvasTexture(sunCanvas);
    const sunGlowMat = new THREE.SpriteMaterial({
      map: sunTexture,
      blending: THREE.AdditiveBlending,
      transparent: true,
      depthWrite: false
    });
    sunGlowSprite = new THREE.Sprite(sunGlowMat);
    sunGlowSprite.scale.set(18, 18, 1);
    sunGroup.add(sunGlowSprite);

    sunLight = new THREE.DirectionalLight(0xfffdf2, 1.2);
    sunLight.castShadow = true;
    sunLight.shadow.mapSize.width = 2048;
    sunLight.shadow.mapSize.height = 2048;
    sunLight.shadow.camera.near = 1;
    sunLight.shadow.camera.far = 75;
    const sd = 25;
    sunLight.shadow.camera.left = -sd;
    sunLight.shadow.camera.right = sd;
    sunLight.shadow.camera.top = sd;
    sunLight.shadow.camera.bottom = -sd;
    sunLight.shadow.bias = -0.0003;
    sunGroup.add(sunLight);
    celestialPivot.add(sunGroup);

    // ── 月亮端 (對立面 180 度，Radius 28) ──
    const moonGroup = new THREE.Group();
    moonGroup.position.set(28, 0, 0);

    const moonGeo = new THREE.SphereGeometry(1.5, 24, 24);
    const moonMat = new THREE.MeshStandardMaterial({
      color: 0xf8fafc,
      roughness: 0.75,
      metalness: 0.1
    });
    moonMesh = new THREE.Mesh(moonGeo, moonMat);
    moonGroup.add(moonMesh);

    // 月亮幽藍月暈 Sprite
    const moonCanvas = document.createElement('canvas');
    moonCanvas.width = 256;
    moonCanvas.height = 256;
    const mctx = moonCanvas.getContext('2d');
    const mgrad = mctx.createRadialGradient(128, 128, 14, 128, 128, 128);
    mgrad.addColorStop(0.0, 'rgba(240, 248, 255, 0.95)');
    mgrad.addColorStop(0.3, 'rgba(165, 180, 252, 0.6)');
    mgrad.addColorStop(0.7, 'rgba(99, 102, 241, 0.2)');
    mgrad.addColorStop(1.0, 'rgba(99, 102, 241, 0.0)');
    mctx.fillStyle = mgrad;
    mctx.fillRect(0, 0, 256, 256);
    const moonTexture = new THREE.CanvasTexture(moonCanvas);
    const moonGlowMat = new THREE.SpriteMaterial({
      map: moonTexture,
      blending: THREE.AdditiveBlending,
      transparent: true,
      depthWrite: false
    });
    moonGlowSprite = new THREE.Sprite(moonGlowMat);
    moonGlowSprite.scale.set(14, 14, 1);
    moonGroup.add(moonGlowSprite);

    moonLight = new THREE.DirectionalLight(0xa5b4fc, 0.5);
    moonGroup.add(moonLight);
    celestialPivot.add(moonGroup);

    // 環境基礎光 (明亮清新馬卡龍風格)
    ambientLight = new THREE.AmbientLight(0xffffff, 0.55);
    scene.add(ambientLight);
    hemiLight = new THREE.HemisphereLight(0xffffff, 0xe0f7fa, 0.9);
    scene.add(hemiLight);
  }

  // ══════════════════════════════════════════════════════════════════════
  // 系統 2: 璀璨星空與壯闊銀河系統 (夜空星光點點 + 雙重銀河拱門)
  // ══════════════════════════════════════════════════════════════════════
  function createStarfieldAndMilkyWay() {
    const starCanvas = document.createElement('canvas');
    starCanvas.width = 64;
    starCanvas.height = 64;
    const sctx = starCanvas.getContext('2d');
    const sgrad = sctx.createRadialGradient(32, 32, 2, 32, 32, 32);
    sgrad.addColorStop(0.0, 'rgba(255, 255, 255, 1.0)');
    sgrad.addColorStop(0.3, 'rgba(255, 255, 255, 0.85)');
    sgrad.addColorStop(0.65, 'rgba(199, 210, 254, 0.35)');
    sgrad.addColorStop(1.0, 'rgba(199, 210, 254, 0.0)');
    sctx.fillStyle = sgrad;
    sctx.fillRect(0, 0, 64, 64);
    const starTexture = new THREE.CanvasTexture(starCanvas);

    // 1. 遠景天穹星空 (4,500 顆深邃夜空細緻星點，位於後方天幕視角，fog: false 絕不被霧氣衰減)
    const starCount = 4500;
    const starGeo = new THREE.BufferGeometry();
    const starPositions = new Float32Array(starCount * 3);
    const starSizes = new Float32Array(starCount);

    for (let i = 0; i < starCount; i++) {
      const x = (Math.random() - 0.5) * 280 + 2.1;
      const y = 6 + Math.random() * 88;
      const z = -25 - Math.random() * 140; // 位於島嶼群正後方開闊天際
      starPositions[i * 3] = x;
      starPositions[i * 3 + 1] = y;
      starPositions[i * 3 + 2] = z;
      starSizes[i] = 1.0 + Math.random() * 1.5;
    }
    starGeo.setAttribute('position', new THREE.BufferAttribute(starPositions, 3));
    starGeo.setAttribute('size', new THREE.BufferAttribute(starSizes, 1));

    const starMat = new THREE.PointsMaterial({
      map: starTexture,
      color: 0xffffff,
      size: 7.5,
      sizeAttenuation: false, // 璀璨星芒晶瑩透亮
      transparent: true,
      opacity: 0,
      fog: false, // 璀璨星空不受霧氣遮擋
      blending: THREE.AdditiveBlending,
      depthTest: true,
      depthWrite: false
    });
    starfieldPoints = new THREE.Points(starGeo, starMat);
    starfieldPoints.visible = false;
    scene.add(starfieldPoints);

    // 2. 壯麗遠景銀河拱門 (8,000 顆夢幻星雲微粒，斜貫夜空天際)
    const mwCount = 8000;
    const mwGeo = new THREE.BufferGeometry();
    const mwPositions = new Float32Array(mwCount * 3);
    const mwColors = new Float32Array(mwCount * 3);

    const c1 = new THREE.Color(0xd8b4fe); // 夢幻星雲紫
    const c2 = new THREE.Color(0xf472b6); // 浪漫玫瑰粉
    const c3 = new THREE.Color(0x93c5fd); // 冰晶寶石藍
    const c4 = new THREE.Color(0xffffff); // 耀眼鑽石白
    const c5 = new THREE.Color(0xfef08a); // 金色微塵
    const palette = [c1, c2, c3, c4, c5];

    for (let i = 0; i < mwCount; i++) {
      const progress = (i / mwCount - 0.5) * 2; // -1.0 ~ +1.0
      const x = progress * 110 + 2.1 + (Math.random() - 0.5) * 18;
      // 壯麗天際銀河拱門 (位於相機仰角天空中段 y: 14 ~ 30, z: -35 ~ -55)
      const arcY = 28 - (progress * progress) * 14 + (Math.random() - 0.5) * 10;
      const z = -35 - Math.abs(progress) * 22 + (Math.random() - 0.5) * 14;

      mwPositions[i * 3] = x;
      mwPositions[i * 3 + 1] = Math.max(arcY, 6.0);
      mwPositions[i * 3 + 2] = z;

      const col = palette[Math.floor(Math.random() * palette.length)];
      mwColors[i * 3] = col.r;
      mwColors[i * 3 + 1] = col.g;
      mwColors[i * 3 + 2] = col.b;
    }
    mwGeo.setAttribute('position', new THREE.BufferAttribute(mwPositions, 3));
    mwGeo.setAttribute('color', new THREE.BufferAttribute(mwColors, 3));

    const mwMat = new THREE.PointsMaterial({
      map: starTexture,
      vertexColors: true,
      size: 11.0,
      sizeAttenuation: false,
      transparent: true,
      opacity: 0,
      fog: false, // 銀河星雲不受霧氣遮擋
      blending: THREE.AdditiveBlending,
      depthTest: true,
      depthWrite: false
    });
    milkyWayPoints = new THREE.Points(mwGeo, mwMat);
    milkyWayPoints.visible = false;
    scene.add(milkyWayPoints);
  }

  // ══════════════════════════════════════════════════════════════════════
  // 系統 4: 平面微縮湖水模型 (平面 CircleGeometry + 頂點微波起伏)
  // ══════════════════════════════════════════════════════════════════════
  function createCurvedOcean() {
    const oceanRadius = 66.0;
    oceanGeo = new THREE.CircleGeometry(oceanRadius, 96);
    oceanGeo.rotateX(-Math.PI / 2); // 旋轉為 X-Z 水平面
    
    // 保存初始頂點位置
    const pos = oceanGeo.attributes.position;
    oceanInitialPositions = new Float32Array(pos.count * 3);
    for (let i = 0; i < pos.count * 3; i++) {
      oceanInitialPositions[i] = pos.array[i];
    }

    const oceanMat = new THREE.MeshStandardMaterial({
      color: 0x68b5c9,
      roughness: 0.82,
      metalness: 0.02,
      transparent: true,
      opacity: 0.96,
      flatShading: true
    });
    oceanMesh = new THREE.Mesh(oceanGeo, oceanMat);
    oceanMesh.position.set(0, -0.05, 0); // 略低於島嶼基座 (y = 0)
    oceanMesh.receiveShadow = true;
    scene.add(oceanMesh);
    waterSphere = oceanMesh;
  }

  // ══════════════════════════════════════════════════════════════════════
  // 系統 5: 夜間點燈 (路燈與窗戶發光)
  // ══════════════════════════════════════════════════════════════════════
  function setupNightLights() {
    // 共享發光材質初始設定
    nightGlowMaterial.color.set(0x475569);
  }

  // ══════════════════════════════════════════════════════════════════════
  // 系統 6: 日夜時序光影插值更新 (在 animate 每幀調用)
  // ══════════════════════════════════════════════════════════════════════
  function updateDayNightCycle(elapsedTime) {
    if (isAutoDayNight && !manualTimeLock) {
      targetCycle = (elapsedTime % 180) / 180;
    }
    // 平滑跟隨 targetCycle (解決點擊按鈕時的突兀跳變)
    let diff = targetCycle - currentCycle;
    if (diff > 0.5) diff -= 1.0;
    if (diff < -0.5) diff += 1.0;
    currentCycle = (currentCycle + diff * 0.05 + 1.0) % 1.0;

    const cycle = currentCycle;

    // 1. 旋轉日月軸 (繞島嶼群斜向旋轉升起與落下)
    if (celestialPivot) {
      celestialPivot.rotation.z = cycle * Math.PI * 2;
      celestialPivot.rotation.x = Math.sin(cycle * Math.PI * 2) * 0.28;
    }

    // 2. 太陽與月亮光照強度切換
    // 白天：0.0~0.5 (正午 ~0.25)；夜晚：0.5~1.0 (午夜 ~0.75)
    const isDay = cycle < 0.5;
    const sunAltitude = Math.sin(cycle * Math.PI * 2); // > 0 為在天空
    const sunIntensity = Math.max(0, sunAltitude) * 1.2;
    const moonIntensity = Math.max(0, -sunAltitude) * 0.45;

    if (sunLight) sunLight.intensity = sunIntensity;
    if (moonLight) moonLight.intensity = moonIntensity;

    // 3. 天空背景色與霧氣平滑插值 (Lerp)
    // 4 個關鍵時段色彩：
    // Noon(0.25): #75c2d6 (清新淡青藍); Dusk(0.48): #fd5e53; Midnight(0.75): #060919; Dawn(0.02): #fbcfe8
    const noonCol = new THREE.Color(0x75c2d6);
    const duskCol = new THREE.Color(0xfd5e53);
    const nightCol = new THREE.Color(0x060919);
    const dawnCol = new THREE.Color(0xfbcfe8);

    const curSky = new THREE.Color();
    const curFog = new THREE.Color();

    if (cycle < 0.25) {
      // 晨曦 (0.02) ➔ 正午 (0.25)
      const t = (cycle) / 0.25;
      curSky.lerpColors(dawnCol, noonCol, t);
    } else if (cycle < 0.5) {
      // 正午 (0.25) ➔ 暮霞黃昏 (0.5)
      const t = (cycle - 0.25) / 0.25;
      curSky.lerpColors(noonCol, duskCol, t);
    } else if (cycle < 0.75) {
      // 暮霞黃昏 (0.5) ➔ 深夜 (0.75)
      const t = (cycle - 0.5) / 0.25;
      curSky.lerpColors(duskCol, nightCol, t);
    } else {
      // 深夜 (0.75) ➔ 晨曦 (1.0)
      const t = (cycle - 0.75) / 0.25;
      curSky.lerpColors(nightCol, dawnCol, t);
    }

    scene.background.copy(curSky);
    if (scene.fog) {
      curFog.copy(curSky).multiplyScalar(0.92);
      scene.fog.color.copy(curFog);
    }

    // 4. 星空與銀河透明度 (夜晚淡入，白天隱藏)
    let starAlpha = 0;
    const isNightVisible = cycle > 0.46 && cycle < 0.98;
    if (isNightVisible) {
      if (cycle >= 0.54 && cycle <= 0.92) {
        starAlpha = 1.0;
      } else if (cycle < 0.54) {
        starAlpha = (cycle - 0.46) / 0.08;
      } else {
        starAlpha = (0.98 - cycle) / 0.06;
      }
    }
    if (starfieldPoints) {
      starfieldPoints.visible = starAlpha > 0.02;
      starfieldPoints.material.opacity = starAlpha;
    }
    if (milkyWayPoints) {
      milkyWayPoints.visible = starAlpha > 0.02;
      milkyWayPoints.material.opacity = starAlpha * 0.95;
    }

    // 星空緩慢自轉
    if (starfieldPoints) starfieldPoints.rotation.y += 0.0003;
    if (milkyWayPoints) milkyWayPoints.rotation.y += 0.00025;

    // 5. 夜間點燈邏輯 (建築物窗戶、島嶼路燈與木橋路燈全數點亮，暖黃光芒流淌)
    const isNightTime = cycle > 0.46 && cycle < 0.96;
    if (nightGlowMaterial) {
      nightGlowMaterial.color.set(isNightTime ? 0xffea79 : 0x475569);
    }
    nightPointLights.forEach((pl) => {
      pl.intensity = isNightTime ? 3.0 : 0.0;
    });

    // 雲朵在夜晚調暗半透明度，襯托星空與銀河
    if (cloudsGroup) {
      const cloudOpacity = isNightTime ? 0.28 : 0.94;
      cloudsGroup.children.forEach((c) => {
        c.children.forEach((puff) => {
          if (puff.material) puff.material.opacity = cloudOpacity;
        });
      });
    }

    // 6. 海水色彩隨時間過渡
    if (oceanMesh) {
      const dayOcean = new THREE.Color(0x2f8fb5);
      const sunsetOcean = new THREE.Color(0x286685); // 暮色清澈蔚藍，避免偏土偏褐
      const nightOcean = new THREE.Color(0x0a192f);
      const curOcean = new THREE.Color();

      if (cycle < 0.4) {
        curOcean.copy(dayOcean);
      } else if (cycle < 0.52) {
        curOcean.lerpColors(dayOcean, sunsetOcean, (cycle - 0.4) / 0.12);
      } else if (cycle < 0.65) {
        curOcean.lerpColors(sunsetOcean, nightOcean, (cycle - 0.52) / 0.13);
      } else {
        curOcean.lerpColors(nightOcean, dayOcean, (cycle - 0.88) / 0.12);
      }
      oceanMesh.material.color.copy(curOcean);
    }
  }

  // ══════════════════════════════════════════════════════════════════════
  // 海浪波動與雲朵位移動畫 (在 animate 每幀調用)
  // ══════════════════════════════════════════════════════════════════════
  function updateWavesAndClouds(elapsedTime) {
    // 1. 動態海浪頂點起伏
    if (oceanGeo && oceanInitialPositions) {
      const pos = oceanGeo.attributes.position;
      const count = pos.count;
      for (let i = 0; i < count; i++) {
        const ox = oceanInitialPositions[i * 3];
        const oy = oceanInitialPositions[i * 3 + 1];
        const oz = oceanInitialPositions[i * 3 + 2];

        // 疊加正弦波 (平面垂直微波)
        const wave = Math.sin(ox * 0.32 + elapsedTime * 1.8) * 0.08 +
                     Math.cos(oz * 0.26 + elapsedTime * 1.4) * 0.06;

        pos.setXYZ(i, ox, oy + wave, oz);
      }
      pos.needsUpdate = true;
      oceanGeo.computeVertexNormals();
    }

    // 2. 雲海漂移與湖上帆船
    updateCloudDrift(elapsedTime);
    updateBoats(elapsedTime);
    updateFerries(elapsedTime);
  }


