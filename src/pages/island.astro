      }

      // 3. 四角圓柱防禦塔樓 + 經典橘紅圓錐尖頂 (4 Corner Turrets with Terracotta Cones)
      const turretPositions = [
        [0.48, 0.48], [-0.48, 0.48], [0.48, -0.48], [-0.48, -0.48]
      ];
      turretPositions.forEach(([tx, tz]) => {
        const turret = new THREE.Mesh(new THREE.CylinderGeometry(0.19, 0.23, 1.5, 8), stoneMat);
