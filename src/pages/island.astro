  function initSpeechBubble() {
    speechBubbleDiv = document.createElement('div');
    speechBubbleDiv.className = 'speech-bubble-3d';
    speechBubbleDiv.style.display = 'none';
    speechBubbleObj = new CSS2DObject(speechBubbleDiv);
    scene.add(speechBubbleObj);
  }

  function showSpeechBubble(worldPos, text) {
    if (!speechBubbleObj || !speechBubbleDiv) return;
    const msg = text || HEALTH_WEALTH_QUOTES[Math.floor(Math.random() * HEALTH_WEALTH_QUOTES.length)];
    speechBubbleDiv.textContent = msg;
    speechBubbleObj.position.copy(worldPos);
    speechBubbleObj.position.y += 1.8;
    speechBubbleDiv.style.display = 'block';
    // 延遲微秒觸發 CSS transition 彈跳動畫
    requestAnimationFrame(() => {
      speechBubbleDiv.classList.add('active');
    });

    if (speechBubbleTimer) clearTimeout(speechBubbleTimer);
    speechBubbleTimer = setTimeout(() => {
      speechBubbleDiv.classList.remove('active');
      setTimeout(() => {
        speechBubbleDiv.style.display = 'none';
      }, 350);
    }, 3200);
  }

  function showMiniToast(msg) {
    let toast = document.getElementById('islandMiniToast');
    if (!toast) {
      toast = document.createElement('div');
      toast.id = 'islandMiniToast';
      toast.className = 'island-mini-toast';
      document.body.appendChild(toast);
    }
    toast.textContent = msg;
    toast.classList.add('show');
    if (toast._timer) clearTimeout(toast._timer);
    toast._timer = setTimeout(() => {
      toast.classList.remove('show');
    }, 2800);
  }

