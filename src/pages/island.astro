  // ── 乾淨白色步道與中央廣場 (直通各橋頭) ──
  function addPlazaWalkways(group, island) {
    const walkMat = new THREE.MeshStandardMaterial({
      color: 0xffffff,
      roughness: 0.75,
      metalness: 0.02,
      flatShading: true
    });

    const roadGroup = new THREE.Group();
    roadGroup.position.y = HEX_HEIGHT + 0.081;

    // 中央圓形石板廣場
    const centerPlaza = new THREE.Mesh(
      new THREE.CylinderGeometry(0.92, 0.92, 0.01, 16),
      walkMat
    );
    centerPlaza.receiveShadow = true;
    roadGroup.add(centerPlaza);

    // 通往有架橋之通道
    const byId = new Map();
    ISLAND_DATA.forEach((d) => byId.set(d.id, d));

    const connectedNeighborIds = [];
    ALL_SCENIC_BRIDGES.forEach(([idA, idB]) => {
      if (idA === island.id) connectedNeighborIds.push(idB);
      else if (idB === island.id) connectedNeighborIds.push(idA);
    });

    const roadLen = HEX_APOTHEM - 0.75;
    const midR = (0.92 + HEX_APOTHEM) / 2;

    connectedNeighborIds.forEach((nId) => {
      const neighbor = byId.get(nId);
      if (neighbor) {
        const dq = neighbor.q - island.q;
        const dr = neighbor.r - island.r;
        const dx = SPACING * (Math.sqrt(3) * dq + (Math.sqrt(3) / 2) * dr);
        const dz = SPACING * (1.5 * dr);
        const angle = Math.atan2(dx, dz);

        const roadMesh = new THREE.Mesh(
          new THREE.BoxGeometry(0.52, 0.01, roadLen),
          walkMat
        );
        roadMesh.position.set(Math.sin(angle) * midR, 0, Math.cos(angle) * midR);
        roadMesh.rotation.y = angle;
        roadMesh.receiveShadow = true;
        roadGroup.add(roadMesh);
      }
    });

    group.add(roadGroup);
  }

  // ── 可愛低多邊形疊球樹 (2~3 個圓球疊在圓柱樹幹上，果綠與深綠交錯) ──
  function createCuteToyTree(x, z, scale = 1.0) {
    const treeGroup = new THREE.Group();
    treeGroup.position.set(x, HEX_HEIGHT + 0.08, z);
    treeGroup.scale.setScalar(scale);

    // 圓柱樹幹
    const trunkMat = new THREE.MeshStandardMaterial({ color: 0x8b5a2b, roughness: 0.85 });
    const trunk = new THREE.Mesh(new THREE.CylinderGeometry(0.06, 0.08, 0.36, 6), trunkMat);
    trunk.position.y = 0.18;
    trunk.castShadow = true;
    treeGroup.add(trunk);

    // 粉嫩果綠與深綠交錯色彩庫
    const greens = [0x86efac, 0x4ade80, 0xa3e635, 0x22c55e, 0x15803d, 0x6ee7b7];
    const col1 = greens[Math.floor(Math.random() * greens.length)];
    const col2 = greens[Math.floor(Math.random() * greens.length)];

    const mat1 = new THREE.MeshStandardMaterial({ color: col1, roughness: 0.7, flatShading: true });
    const mat2 = new THREE.MeshStandardMaterial({ color: col2, roughness: 0.7, flatShading: true });

    // 底層較大圓球
    const sphere1 = new THREE.Mesh(new THREE.IcosahedronGeometry(0.25, 1), mat1);
    sphere1.position.set(0, 0.38, 0);
    sphere1.castShadow = true;
    treeGroup.add(sphere1);

    // 中層圓球 (微錯位偏心)
    const sphere2 = new THREE.Mesh(new THREE.IcosahedronGeometry(0.19, 1), mat2);
    sphere2.position.set(0.04, 0.54, -0.03);
    sphere2.castShadow = true;
    treeGroup.add(sphere2);

    // 頂層小圓球
    const sphere3 = new THREE.Mesh(new THREE.IcosahedronGeometry(0.13, 1), mat1);
    sphere3.position.set(-0.03, 0.67, 0.02);
    sphere3.castShadow = true;
    treeGroup.add(sphere3);

    return treeGroup;
  }

  // ── 微型小人偶 (圓柱身體 + 小圓球頭，多彩馬卡龍衣著，3~5 人活潑點綴) ──
  function createMiniFigures(group, count = 4) {
    const clothingColors = [
      0x38bdf8, // 晴空藍
      0xf472b6, // 糖果粉
      0xfacc15, // 鵝黃
      0xfb923c, // 亮橘
      0xa78bfa, // 薰衣草紫
      0x34d399, // 薄荷綠
      0xffffff  // 醫師白袍
    ];

    for (let i = 0; i < count; i++) {
      const angle = (i / count) * Math.PI * 2 + (Math.random() * 0.4 - 0.2);
      const dist = 0.65 + Math.random() * 0.75;
      const fx = Math.cos(angle) * dist;
      const fz = Math.sin(angle) * dist;

      const person = new THREE.Group();
      person.position.set(fx, HEX_HEIGHT + 0.08, fz);

      const clothesCol = clothingColors[Math.floor(Math.random() * clothingColors.length)];
      const bodyMat = new THREE.MeshStandardMaterial({ color: clothesCol, roughness: 0.65 });
      const headMat = new THREE.MeshStandardMaterial({ color: 0xffdfba, roughness: 0.5 }); // 溫暖小膚色

      // 圓柱身體
      const body = new THREE.Mesh(new THREE.CylinderGeometry(0.045, 0.06, 0.16, 8), bodyMat);
      body.position.y = 0.08;
      body.castShadow = true;
      person.add(body);

      // 小圓球頭
      const head = new THREE.Mesh(new THREE.SphereGeometry(0.055, 8, 8), headMat);
      head.position.y = 0.19;
      head.castShadow = true;
      person.add(head);

      person.rotation.y = Math.random() * Math.PI * 2;
      group.add(person);
    }
  }

