  function createRedDragon() {
    dragonGroup = new THREE.Group();

    // 材質定義：深紅龍鱗、金珀色腹甲與翼膜、黑曜石龍角、發光黃金龍眼
    const crimsonMat = new THREE.MeshStandardMaterial({ color: 0xdc2626, roughness: 0.55, metalness: 0.08, flatShading: true });
    const darkRedMat = new THREE.MeshStandardMaterial({ color: 0x991b1b, roughness: 0.6, flatShading: true });
    const goldBellyMat = new THREE.MeshStandardMaterial({ color: 0xf59e0b, roughness: 0.5, metalness: 0.15, flatShading: true });
    const wingMembraneMat = new THREE.MeshStandardMaterial({
      color: 0xea580c,
      emissive: 0x9a3412,
      emissiveIntensity: 0.25,
      roughness: 0.6,
      side: THREE.DoubleSide,
      flatShading: true
    });
    const hornMat = new THREE.MeshStandardMaterial({ color: 0x1e293b, roughness: 0.4, metalness: 0.3, flatShading: true });
    const spineGoldMat = new THREE.MeshStandardMaterial({ color: 0xfbbf24, roughness: 0.4, metalness: 0.2, flatShading: true });
    const eyeMat = new THREE.MeshBasicMaterial({ color: 0xfef08a });

    // 內部主體群組 (朝向 +Z 軸飛行，方便 lookAt 導航)
    const bodyRoot = new THREE.Group();
    dragonGroup.add(bodyRoot);

    // 1. 龍身軀幹 (強壯流線胸腔與腹甲)
    const torso = new THREE.Mesh(new THREE.DodecahedronGeometry(0.68, 1), crimsonMat);
    torso.scale.set(0.95, 0.88, 1.85);
    torso.castShadow = true;
    bodyRoot.add(torso);

    const belly = new THREE.Mesh(new THREE.BoxGeometry(0.82, 0.32, 1.95), goldBellyMat);
    belly.position.set(0, -0.38, 0.05);
    belly.castShadow = true;
    bodyRoot.add(belly);

    // 背部金色鋸齒龍脊刺
    for (let i = -2; i <= 2; i++) {
      const spine = new THREE.Mesh(new THREE.ConeGeometry(0.14, 0.42, 4), spineGoldMat);
      spine.position.set(0, 0.62, i * 0.42);
      spine.rotation.x = -0.28;
      spine.castShadow = true;
      bodyRoot.add(spine);
    }

    // 2. 龍頸與威武龍頭 (含可張開噴火的下顎)
    const neckGroup = new THREE.Group();
    neckGroup.position.set(0, 0.25, 1.05);
    bodyRoot.add(neckGroup);

    const neck1 = new THREE.Mesh(new THREE.CylinderGeometry(0.32, 0.46, 0.85, 7), crimsonMat);
    neck1.rotation.x = Math.PI / 3.2;
    neck1.position.set(0, 0.22, 0.32);
    neck1.castShadow = true;
    neckGroup.add(neck1);

    const headGroup = new THREE.Group();
    headGroup.position.set(0, 0.52, 0.72);
    neckGroup.add(headGroup);

    // 上頭顱與吻部
    const skull = new THREE.Mesh(new THREE.BoxGeometry(0.56, 0.44, 0.62), crimsonMat);
    skull.castShadow = true;
    headGroup.add(skull);

    const snout = new THREE.Mesh(new THREE.BoxGeometry(0.42, 0.28, 0.58), crimsonMat);
    snout.position.set(0, -0.04, 0.52);
    snout.castShadow = true;
    headGroup.add(snout);

    // 鼻孔與尖牙
    [-0.12, 0.12].forEach(nx => {
      const nostril = new THREE.Mesh(new THREE.BoxGeometry(0.08, 0.08, 0.08), darkRedMat);
      nostril.position.set(nx, 0.11, 0.72);
      headGroup.add(nostril);

      const fang = new THREE.Mesh(new THREE.ConeGeometry(0.045, 0.14, 4), new THREE.MeshBasicMaterial({ color: 0xffffff }));
      fang.rotation.x = Math.PI;
      fang.position.set(nx, -0.22, 0.68);
      headGroup.add(fang);
    });

    // 發光黃金龍眼與威嚴眉骨
    [-0.26, 0.26].forEach(ex => {
      const eye = new THREE.Mesh(new THREE.SphereGeometry(0.085, 6, 6), eyeMat);
      eye.position.set(ex, 0.08, 0.18);
      headGroup.add(eye);

      const brow = new THREE.Mesh(new THREE.BoxGeometry(0.14, 0.08, 0.34), darkRedMat);
      brow.position.set(ex * 1.02, 0.18, 0.18);
      brow.rotation.z = ex > 0 ? -0.25 : 0.25;
      headGroup.add(brow);
    });

    // 後掠雙長龍角 (雙節彎角)
    [-0.22, 0.22].forEach(hx => {
      const hornBase = new THREE.Mesh(new THREE.ConeGeometry(0.11, 0.95, 5), hornMat);
      hornBase.position.set(hx, 0.42, -0.35);
      hornBase.rotation.x = -Math.PI / 2.8;
      hornBase.rotation.z = hx > 0 ? -0.22 : 0.22;
      hornBase.castShadow = true;
      headGroup.add(hornBase);

      const hornTip = new THREE.Mesh(new THREE.ConeGeometry(0.07, 0.55, 5), spineGoldMat);
      hornTip.position.set(hx * 1.35, 0.68, -0.82);
      hornTip.rotation.x = -Math.PI / 3.1;
      hornTip.rotation.z = hx > 0 ? -0.28 : 0.28;
      headGroup.add(hornTip);
    });

    // 可張合下顎 (Jaw Pivot) + 噴火發射點
    const jawPivot = new THREE.Group();
    jawPivot.position.set(0, -0.16, 0.15);
    headGroup.add(jawPivot);

    const lowerJaw = new THREE.Mesh(new THREE.BoxGeometry(0.36, 0.14, 0.62), goldBellyMat);
    lowerJaw.position.set(0, -0.04, 0.28);
    jawPivot.add(lowerJaw);

    const fireEmitter = new THREE.Object3D();
    fireEmitter.position.set(0, 0.02, 0.72);
    jawPivot.add(fireEmitter);

    // 龍口烈焰動態點光源 (噴火時瞬間照亮)
    const fireLight = new THREE.PointLight(0xff5500, 0, 18, 1.4);
    fireLight.position.set(0, 0.0, 0.85);
    headGroup.add(fireLight);

    // 3. 巨大雙翼 (Left & Right Articulated Dragon Wings)
    function buildDragonWing(side) {
      const wingPivot = new THREE.Group();
      wingPivot.position.set(side * 0.52, 0.36, 0.25);

      // 主翼骨 (內段)
      const innerArm = new THREE.Mesh(new THREE.BoxGeometry(1.55, 0.12, 0.16), darkRedMat);
      innerArm.position.set(side * 0.75, 0.12, 0.18);
      innerArm.rotation.z = side * 0.15;
      innerArm.rotation.y = -side * 0.12;
      innerArm.castShadow = true;
      wingPivot.add(innerArm);

      // 翼肘皇冠爪
      const thumbClaw = new THREE.Mesh(new THREE.ConeGeometry(0.07, 0.28, 4), hornMat);
      thumbClaw.position.set(side * 1.48, 0.24, 0.42);
      thumbClaw.rotation.x = Math.PI / 2;
      wingPivot.add(thumbClaw);

      // 內側翼膜
      const innerMembrane = new THREE.Mesh(new THREE.BoxGeometry(1.52, 0.04, 1.35), wingMembraneMat);
      innerMembrane.position.set(side * 0.78, 0.08, -0.42);
      innerMembrane.rotation.z = side * 0.12;
      innerMembrane.castShadow = true;
      wingPivot.add(innerMembrane);

      // 外段翼骨關節 (次級延遲扇動，讓飛行更逼真柔順)
      const outerPivot = new THREE.Group();
      outerPivot.position.set(side * 1.48, 0.22, 0.22);
      wingPivot.add(outerPivot);

      const outerArm = new THREE.Mesh(new THREE.BoxGeometry(1.75, 0.09, 0.12), crimsonMat);
      outerArm.position.set(side * 0.85, 0, -0.15);
      outerArm.rotation.y = side * 0.18;
      outerArm.castShadow = true;
      outerPivot.add(outerArm);

      // 翼骨支撐指條 (3 根龍翼骨指)
      [-0.25, -0.65, -1.05].forEach((zOff, idx) => {
        const strut = new THREE.Mesh(new THREE.CylinderGeometry(0.025, 0.04, 1.5 - idx * 0.2, 5), darkRedMat);
        strut.rotation.z = Math.PI / 2;
        strut.rotation.y = side * (0.25 + idx * 0.22);
        strut.position.set(side * (0.68 - idx * 0.08), -0.01, zOff);
        outerPivot.add(strut);
      });

      // 外側巨型翼膜
      const outerMembrane = new THREE.Mesh(new THREE.BoxGeometry(1.72, 0.035, 1.45), wingMembraneMat);
      outerMembrane.position.set(side * 0.82, -0.02, -0.68);
      outerMembrane.rotation.y = side * 0.14;
      outerMembrane.castShadow = true;
      outerPivot.add(outerMembrane);

      return { wingPivot, outerPivot };
    }

    const leftWing = buildDragonWing(1);
    const rightWing = buildDragonWing(-1);
    bodyRoot.add(leftWing.wingPivot, rightWing.wingPivot);

    // 4. 收起的四肢與利爪
    [[-0.45, -0.42, 0.55], [0.45, -0.42, 0.55], [-0.48, -0.42, -0.55], [0.48, -0.42, -0.55]].forEach(([lx, ly, lz]) => {
      const leg = new THREE.Mesh(new THREE.CylinderGeometry(0.12, 0.08, 0.52, 6), crimsonMat);
      leg.position.set(lx, ly, lz);
      leg.rotation.x = 0.55;
      bodyRoot.add(leg);

      const claw = new THREE.Mesh(new THREE.ConeGeometry(0.09, 0.22, 4), hornMat);
      claw.position.set(lx, ly - 0.22, lz - 0.12);
      claw.rotation.x = Math.PI * 0.75;
      bodyRoot.add(claw);
    });

    // 5. 多節擺動長龍尾 (7 節漸細龍尾 + 火焰紅箭形尾鎚)
    const tailSegments = [];
    let parentTail = bodyRoot;
    for (let t = 0; t < 7; t++) {
      const segGroup = new THREE.Group();
      segGroup.position.set(0, t === 0 ? 0.05 : 0, t === 0 ? -1.05 : -0.48);
      parentTail.add(segGroup);

      const r = Math.max(0.10, 0.36 - t * 0.042);
      const segMesh = new THREE.Mesh(new THREE.CylinderGeometry(r * 0.82, r, 0.52, 6), crimsonMat);
      segMesh.rotation.x = Math.PI / 2;
      segMesh.position.z = -0.24;
      segMesh.castShadow = true;
      segGroup.add(segMesh);

      // 尾節背刺
      if (t < 6) {
        const tSpine = new THREE.Mesh(new THREE.ConeGeometry(0.08, 0.24, 4), spineGoldMat);
        tSpine.position.set(0, r + 0.08, -0.24);
        tSpine.rotation.x = -0.3;
        segGroup.add(tSpine);
      } else {
        // 尾端紅金箭形龍尾翼
        const tailBlade = new THREE.Mesh(new THREE.OctahedronGeometry(0.32, 0), goldBellyMat);
        tailBlade.scale.set(1.35, 0.28, 1.65);
        tailBlade.position.set(0, 0, -0.52);
        segGroup.add(tailBlade);
      }

      tailSegments.push(segGroup);
      parentTail = segGroup;
    }

    // 放大至巨龍氣勢尺寸 (翼展超過 10 單位，盤旋於雙群島正上空清晰壯觀)
    dragonGroup.scale.setScalar(2.35);
    dragonGroup.position.set(0, 10.2, 0);

    // 大範圍隱形點擊碰撞球，讓滑鼠輕鬆點擊飛行中的巨龍
    const dragonHitMesh = new THREE.Mesh(
      new THREE.SphereGeometry(1.8, 8, 8),
      new THREE.MeshBasicMaterial({ transparent: true, opacity: 0, depthWrite: false })
    );
    dragonGroup.add(dragonHitMesh);

    // 標記互動屬性，支援滑鼠懸停與點擊噴火
    dragonGroup.userData = { isDragon: true, isWobbleable: true };
    dragonGroup.traverse(c => {
      c.userData.isDragon = true;
      c.userData.parentDragon = dragonGroup;
      c.userData.isWobbleable = true;
      c.userData.parentWobble = bodyRoot;
    });

    // 頭頂專屬輕量級懸浮小徽章 (可跟隨標籤開關切換)
    const dragonBadge = document.createElement('div');
    dragonBadge.className = 'ferry-label';
    dragonBadge.style.background = 'linear-gradient(135deg, rgba(185, 28, 28, 0.92), rgba(217, 119, 6, 0.92))';
    dragonBadge.style.borderColor = '#fde047';
    dragonBadge.style.cursor = 'pointer';
    dragonBadge.style.pointerEvents = 'auto';
    dragonBadge.textContent = '🐉 赤紅巨龍 (點擊噴火)';
    dragonBadge.addEventListener('pointerdown', (e) => e.stopPropagation());
    dragonBadge.addEventListener('click', (e) => {
      e.stopPropagation();
      triggerDragonInteraction();
    });
    const dragonLabelObj = new CSS2DObject(dragonBadge);
    dragonLabelObj.position.set(0, 2.35, 0);
    dragonBadge._css2dObj = dragonLabelObj;
    dragonBadge._badgeKind = 'dragon';
    dragonGroup.add(dragonLabelObj);
    badgeObjects.push(dragonBadge);

    scene.add(dragonGroup);

    dragonData = {
      group: dragonGroup,
      bodyRoot,
      headGroup,
      jawPivot,
      fireEmitter,
      fireLight,
      leftWing,
      rightWing,
      tailSegments,
      dragonBadge,
      dragonLabelObj,
      flightPhase: 0,
      boostSpeed: 0,
      fireUntil: 0,
      barrelRollStart: 0
    };
  }

  // 觸發赤紅巨龍噴火與金句互動 (平穩滑行不翻滾，避免鏡頭晃動頭暈)
  function triggerDragonInteraction() {
    if (!dragonData) return;
    playIslandSound('dragon');
    const now = Date.now();
    dragonData.fireUntil = now + 2600;       // 連續噴火 2.6 秒
    dragonData.boostSpeed = 0.35;            // 溫和推進，不劇烈晃動

    const worldPos = new THREE.Vector3();
    dragonData.group.getWorldPosition(worldPos);
    const quote = DRAGON_QUOTES[Math.floor(Math.random() * DRAGON_QUOTES.length)];
    showSpeechBubble(worldPos, quote);
    showMiniToast('🔥 赤紅巨龍昂首咆哮，噴出熾熱黃金龍息！');
  }

  const dragonFireGeo = new THREE.DodecahedronGeometry(0.22, 0);
  function spawnDragonFireParticle() {
    if (!dragonData || dragonFireParticles.length > 55) return;

    const emitterWorldPos = new THREE.Vector3();
    dragonData.fireEmitter.getWorldPosition(emitterWorldPos);

    // 取得巨龍當前飛行正前方方向
    const forward = new THREE.Vector3(0, -0.18, 1).applyQuaternion(dragonData.group.quaternion).normalize();

    // 隨機火焰色階：耀眼金黃 -> 熾熱橘紅 -> 深紅烈焰
    const fireColors = [0xfef08a, 0xfbbf24, 0xf97316, 0xef4444, 0xdc2626];
    const col = fireColors[Math.floor(Math.random() * fireColors.length)];
    const mat = new THREE.MeshBasicMaterial({
      color: col,
      transparent: true,
      opacity: 0.95,
      blending: THREE.AdditiveBlending,
      depthWrite: false
    });

    const pMesh = new THREE.Mesh(dragonFireGeo, mat);
    pMesh.position.copy(emitterWorldPos);
    pMesh.scale.setScalar(0.55 + Math.random() * 0.45);
    scene.add(pMesh);

    // 加入擴散噴射锥角速度
    const spread = new THREE.Vector3(
      (Math.random() - 0.5) * 0.35,
      (Math.random() - 0.5) * 0.28 - 0.06,
      (Math.random() - 0.5) * 0.35
    );
    const vel = forward.multiplyScalar(0.45 + Math.random() * 0.25).add(spread);

    dragonFireParticles.push({
      mesh: pMesh,
      vel,
      startTime: Date.now(),
      duration: 520 + Math.random() * 320
    });
  }

  // 每幀更新赤紅巨龍：平穩大橢圓環島御風滑行 (Gliding)、極致穩定不頭暈
  let _lastDragonTime = 0;
  function updateRedDragon(elapsedTime) {
    if (!dragonData) return;
    const dt = _lastDragonTime ? Math.min(0.05, elapsedTime - _lastDragonTime) : 0.016;
    _lastDragonTime = elapsedTime;

    const now = Date.now();
    const isBreathingFire = now < dragonData.fireUntil;

    // 1. 優雅慢速巡航角速度 (約 75 秒平穩環繞全群島一圈)
    dragonData.boostSpeed *= 0.96;
    const baseOmega = 0.082 + dragonData.boostSpeed * 0.06;
    dragonData.flightPhase += dt * baseOmega;
    const u = dragonData.flightPhase;

    // 2. 寬廣大橢圓等高滑行航線 (純水平恆定高度，徹底消除上下顛簸與左右急轉)
    const spanX = 24.5;
    const spanZ = 15.0;
    const x = Math.cos(u) * spanX;
    const z = Math.sin(u) * spanZ;
    const y = isDragonRideMode ? 14.8 : 12.2;

    const uNext = u + 0.03;
    const nx = Math.cos(uNext) * spanX;
    const nz = Math.sin(uNext) * spanZ;
    const ny = y;

    dragonData.group.position.set(x, y, z);

    // 🐉 若處於「騎乘飛龍視角 (聖劍傳說3 芙拉米高空置中俯瞰視角)」：
    // 讓巨龍朝向群島內側前方滑翔，並將相機鎖定在巨龍正後方高處、視線 100% 穿過巨龍正中央俯瞰整片群島！
    // 巨龍沿飛行航道前進，帶自然側傾轉向（banking）
    dragonData.group.lookAt(nx, ny, nz);
    dragonData.bodyRoot.rotation.z = Math.sin(u) * 0.12;

    // 🐉 騎乘赤紅巨龍：鎖定「看著龍背」的沉浸式第三人稱追尾視角（Third-Person Chase Camera）
    if (isDragonRideMode) {
      const isMobile = window.innerWidth <= 768;
      // 局部偏移量：鏡頭在龍尾後方 10 單位、龍背上方 4.5 單位處
      const relativeCameraOffset = new THREE.Vector3(0, isMobile ? 4.8 : 4.5, isMobile ? -11.0 : -10.0);

      // 將局部偏移乘上巨龍的旋轉四元數，轉為世界座標
      const targetCamPos = relativeCameraOffset.clone()
        .applyQuaternion(dragonData.group.quaternion)
        .add(dragonData.group.position);

      // 隨著翅膀拍動，加上輕微的呼吸起伏 Math.sin(time * 4) * 0.3
      targetCamPos.y += Math.sin(elapsedTime * 4.0) * 0.3;

      // 平滑跟隨（產生自然的飛行慣性延遲感）
      camera.position.lerp(targetCamPos, 0.1);

      // 視線中心（LookAt）：看向龍頭正前方偏下一點的位置，
      // 確保畫面下半部 1/3 剛好是巨龍的背部脊刺、脖頸與兩側上下拍動的巨大紅翅膀，上半部則是前方的天空與島嶼！
      const dragonForward = new THREE.Vector3(0, 0, 1).applyQuaternion(dragonData.group.quaternion);
      const lookTarget = dragonData.group.position.clone()
        .add(dragonForward.clone().multiplyScalar(15.0))
        .add(new THREE.Vector3(0, 0.2, 0));

      camera.lookAt(lookTarget);
      controls.target.copy(lookTarget);
    }

    // 4. 雙翼平展御風滑翔 (僅有極微幅的慢速呼吸感起伏，徹底告別劇烈拍動)
    const flapFreq = isBreathingFire ? 2.2 : 0.9;
    const flapAmp = isBreathingFire ? 0.14 : 0.06;
    const flapAngle = 0.06 + Math.sin(elapsedTime * flapFreq) * flapAmp;
    const outerFlap = -0.04 + Math.sin(elapsedTime * flapFreq - 0.6) * (flapAmp * 0.7);

    dragonData.leftWing.wingPivot.rotation.z = flapAngle;
    dragonData.leftWing.outerPivot.rotation.z = outerFlap;
    dragonData.rightWing.wingPivot.rotation.z = -flapAngle;
    dragonData.rightWing.outerPivot.rotation.z = -outerFlap;

    // 5. 長尾平順緩慢隨風擺動
    dragonData.tailSegments.forEach((seg, idx) => {
      seg.rotation.y = Math.sin(elapsedTime * 1.4 - idx * 0.45) * (0.04 + idx * 0.008);
      seg.rotation.x = 0;
    });

    // 定期自動短暫噴出小龍息 (每 14 秒偶爾噴出一小口火)，或點擊時大噴火
    const autoFirePulse = (elapsedTime % 14.0) < 1.1;
    if (isBreathingFire || autoFirePulse) {
      dragonData.jawPivot.rotation.x = 0.46 + Math.sin(elapsedTime * 16) * 0.05;
      dragonData.fireLight.intensity = isBreathingFire ? 4.5 : 2.2;
      const count = isBreathingFire ? 3 : 1;
      for (let k = 0; k < count; k++) {
        spawnDragonFireParticle();
      }
    } else {
      dragonData.jawPivot.rotation.x = 0.05;
      dragonData.fireLight.intensity = 0;
    }

    // 更新龍息火焰粒子運動與消散
    for (let i = dragonFireParticles.length - 1; i >= 0; i--) {
      const fp = dragonFireParticles[i];
      const age = now - fp.startTime;
      if (age >= fp.duration) {
        scene.remove(fp.mesh);
        fp.mesh.material.dispose();
        dragonFireParticles.splice(i, 1);
      } else {
        const prog = age / fp.duration;
        fp.mesh.position.add(fp.vel);
        fp.mesh.rotation.x += 0.15;
        fp.mesh.rotation.y += 0.18;
        const scale = (0.6 + prog * 2.2) * (1 - prog * 0.3);
        fp.mesh.scale.setScalar(scale);
        fp.mesh.material.opacity = (1 - prog) * 0.9;
      }
    }
  }

  // 切換「🐉 騎乘飛龍第一人稱追尾視角」
  function toggleDragonRideMode() {
    setDragonRideMode(!isDragonRideMode);
  }

  function setDragonRideMode(on) {
    if (on) exitTurtleRideSilently();
    isDragonRideMode = on;
    const btn = document.getElementById('summonDragonBtn');
    const txt = document.getElementById('dragonBtnText');
    const floatBar = document.getElementById('dragonRideFloatBar');
    const banner = document.getElementById('rideCinematicBanner');
    const bIcon = document.getElementById('rideBannerIcon');
    const bText = document.getElementById('rideBannerText');
    const tipsEl = document.querySelector('.island-floating-tips');
    const fActIcon = document.getElementById('floatActionIcon');
    const fActText = document.getElementById('floatActionText');
    const fExitIcon = document.getElementById('floatExitIcon');
    const fExitText = document.getElementById('floatExitText');
    const appEl = document.getElementById('islandApp');

    if (btn) btn.classList.toggle('active', on);
    if (txt) txt.textContent = on ? '降落' : '騎龍';
    if (on) {
      if (fActIcon) fActIcon.textContent = '🔥';
      if (fActText) fActText.textContent = '點擊噴火';
      if (fExitIcon) fExitIcon.textContent = '⏬';
      if (fExitText) fExitText.textContent = '結束騎乘';
      if (bIcon) bIcon.textContent = '🔥';
      if (bText) bText.textContent = '點擊畫面噴火 · 俯瞰 3D 衛教群島';
    }
    if (floatBar) {
      floatBar.classList.toggle('active', on);
      floatBar.setAttribute('aria-hidden', on ? 'false' : 'true');
    }
    if (banner) {
      banner.classList.toggle('active', on);
      banner.setAttribute('aria-hidden', on ? 'false' : 'true');
    }
    if (appEl) {
      appEl.classList.toggle('is-riding-mount', on);
    }
    if (tipsEl) {
      tipsEl.style.opacity = on ? '0' : '';
      tipsEl.style.pointerEvents = on ? 'none' : '';
    }
    if (dragonData) {
      if (dragonData.dragonBadge) {
        dragonData.dragonBadge.style.display = on ? 'none' : '';
      }
      dragonData.group.scale.setScalar(on ? 1.55 : 2.35);
    }

    if (on) {
      // 騎乘時停用 OrbitControls 旋轉，改由 requestAnimationFrame 計算追尾攝影機
      controls.enabled = false;
      controls.autoRotate = false;
      exitBirdViewSilently();
      closeDetailCard();
      isFlightActive = false;
      camera.fov = window.innerWidth <= 768 ? 56 : 48;
      camera.updateProjectionMatrix();
      triggerDragonInteraction();
      showMiniToast('🐉 鎖定龍背追尾視角：俯瞰 3D 衛教群島！');
    } else {
      // 結束騎乘時平滑將鏡頭歸還 OrbitControls
      controls.enabled = true;
      camera.fov = 32;
      camera.updateProjectionMatrix();
      resetView();
    }
  }

  function exitDragonRideSilently() {
    if (!isDragonRideMode) return;
    isDragonRideMode = false;
    controls.enabled = true;
    camera.fov = 32;
    camera.updateProjectionMatrix();
    const btn = document.getElementById('summonDragonBtn');
    const txt = document.getElementById('dragonBtnText');
    const floatBar = document.getElementById('dragonRideFloatBar');
    const banner = document.getElementById('rideCinematicBanner');
    const appEl = document.getElementById('islandApp');
    const tipsEl = document.querySelector('.island-floating-tips');
    if (btn) btn.classList.remove('active');
    if (txt) txt.textContent = '騎龍';
    if (floatBar) {
      floatBar.classList.remove('active');
      floatBar.setAttribute('aria-hidden', 'true');
    }
    if (banner) {
      banner.classList.remove('active');
      banner.setAttribute('aria-hidden', 'true');
    }
    if (appEl) {
      appEl.classList.remove('is-riding-mount');
    }
    if (tipsEl) {
      tipsEl.style.opacity = '';
      tipsEl.style.pointerEvents = '';
    }
    if (dragonData) {
      if (dragonData.dragonBadge) {
        dragonData.dragonBadge.style.display = '';
      }
      dragonData.group.scale.setScalar(2.35);
    }
  }

  // ── (2b-2) 《聖劍傳說3》布斯卡布 (Vuscav) 潛水鏡大海龜坐騎系統 ──
  const GIANT_TURTLE_QUOTES = [
    '🐢 噗咻～！我是戴著潛水鏡的聖劍大海龜！像海龜一樣長壽健康的秘訣，就是定期健檢與無痛腸胃鏡！',
    '🐢 咕嚕嚕～！海龜不急不徐橫渡大海，正如「指數化投資」穩健長期持有，終能抵達財富彼岸！',
    '🐢 呼哈～！每天補充充足水分與高纖蔬果，讓你的腸道與腎臟像大海一樣清澈順暢！',
    '🐢 乘風破浪！三高（血壓、血糖、血脂）控制好，血管不硬化，跟海龜一樣活到一百歲！',
    '🐢 噗通～！壓力大的時候，來海島上陪我游一圈，深呼吸放鬆自律神經，胃食道逆流自然好！'
  ];

  function createGiantSeaTurtle() {
    giantTurtleGroup = new THREE.Group();

    const shellGreenMat = new THREE.MeshStandardMaterial({ color: 0x3f6212, roughness: 0.65, flatShading: true });
    const scuteDarkMat = new THREE.MeshStandardMaterial({ color: 0x365314, roughness: 0.7, flatShading: true });
    const rimCreamMat = new THREE.MeshStandardMaterial({ color: 0xfef08a, roughness: 0.6, flatShading: true });
    const bellyYellowMat = new THREE.MeshStandardMaterial({ color: 0xfde047, roughness: 0.7, flatShading: true });
    const skinGreenMat = new THREE.MeshStandardMaterial({ color: 0x65a30d, roughness: 0.65, flatShading: true });
    const beakYellowMat = new THREE.MeshStandardMaterial({ color: 0xfacc15, roughness: 0.5, flatShading: true });
    const strapLeatherMat = new THREE.MeshStandardMaterial({ color: 0x78350f, roughness: 0.8, flatShading: true });
    const goggleRedMat = new THREE.MeshStandardMaterial({ color: 0xef4444, roughness: 0.35, flatShading: true });
    const lensBlueMat = new THREE.MeshStandardMaterial({ color: 0xe0f2fe, emissive: 0x38bdf8, emissiveIntensity: 0.25, roughness: 0.15 });
    const darkPupilMat = new THREE.MeshBasicMaterial({ color: 0x0f172a });
    const flagRedMat = new THREE.MeshStandardMaterial({ color: 0xef4444, side: THREE.DoubleSide, roughness: 0.5 });

    const bodyRoot = new THREE.Group();
    giantTurtleGroup.add(bodyRoot);

    // 1. 圓潤飽滿的立體大龜殼 (Domed Carapace + 六角龜甲紋 + 奶油金滾邊)
    const carapace = new THREE.Mesh(
      new THREE.SphereGeometry(1.15, 10, 8, 0, Math.PI * 2, 0, Math.PI * 0.56),
      shellGreenMat
    );
    carapace.scale.set(1.05, 0.78, 1.25);
    carapace.position.y = 0.12;
    carapace.castShadow = true;
    bodyRoot.add(carapace);

    // 龜背立體六角甲片 (Scutes)
    const scuteOffsets = [
      [0, 0.96, 0],
      [0, 0.88, 0.52],
      [0, 0.88, -0.52],
      [-0.52, 0.78, 0.24],
      [0.52, 0.78, 0.24],
      [-0.52, 0.78, -0.28],
      [0.52, 0.78, -0.28]
    ];
    scuteOffsets.forEach(([sx, sy, sz]) => {
      const scute = new THREE.Mesh(new THREE.CylinderGeometry(0.28, 0.34, 0.10, 6), scuteDarkMat);
      scute.position.set(sx, sy, sz);
      bodyRoot.add(scute);
    });

    // 龜殼外緣奶油黃護邊與腹甲
    const shellRim = new THREE.Mesh(new THREE.TorusGeometry(1.12, 0.11, 7, 16), rimCreamMat);
    shellRim.rotation.x = Math.PI / 2;
    shellRim.scale.set(1.04, 1.24, 0.85);
    shellRim.position.y = 0.16;
    bodyRoot.add(shellRim);

    const plastron = new THREE.Mesh(new THREE.CylinderGeometry(1.02, 0.92, 0.22, 10), bellyYellowMat);
    plastron.scale.set(1.0, 1.0, 1.2);
    plastron.position.y = 0.04;
    bodyRoot.add(plastron);

    // 2. 《聖劍傳說3》布斯卡布招牌皮革背帶 + 龜背紅色探險三角小旗 (🚩)
    const strap1 = new THREE.Mesh(new THREE.TorusGeometry(1.13, 0.065, 6, 14, Math.PI), strapLeatherMat);
    strap1.scale.set(1.04, 0.84, 1.0);
    strap1.position.set(0, 0.14, 0.25);
    bodyRoot.add(strap1);

    const flagPole = new THREE.Mesh(new THREE.CylinderGeometry(0.03, 0.035, 0.95, 6), strapLeatherMat);
    flagPole.position.set(0.32, 1.18, -0.45);
    flagPole.rotation.x = -0.22;
    bodyRoot.add(flagPole);

    const pennantGeo = new THREE.ConeGeometry(0.22, 0.52, 3);
    pennantGeo.rotateZ(Math.PI / 2);
    const turtleFlag = new THREE.Mesh(pennantGeo, flagRedMat);
    turtleFlag.position.set(0.10, 1.52, -0.56);
    bodyRoot.add(turtleFlag);

    // 3. 呆萌大龜頭 + 黃色鳥喙嘴 + 頭頂小呆毛 + 招牌紅框潛水護目鏡 (Diving Goggles)
    const headPivot = new THREE.Group();
    headPivot.position.set(0, 0.42, 1.48);
    bodyRoot.add(headPivot);

    const headMesh = new THREE.Mesh(new THREE.DodecahedronGeometry(0.46, 1), skinGreenMat);
    headMesh.scale.set(1.05, 0.95, 1.12);
    headMesh.castShadow = true;
    headPivot.add(headMesh);

    // 可愛黃色小鳥喙與微笑下巴
    const beakMesh = new THREE.Mesh(new THREE.ConeGeometry(0.26, 0.32, 5), beakYellowMat);
    beakMesh.rotation.x = Math.PI / 2;
    beakMesh.position.set(0, -0.08, 0.48);
    headPivot.add(beakMesh);

    // 頭頂布斯卡布招牌黑色小天線呆毛
    const antenna = new THREE.Mesh(new THREE.ConeGeometry(0.045, 0.32, 5), darkPupilMat);
    antenna.position.set(0, 0.54, 0.10);
    antenna.rotation.x = 0.25;
    headPivot.add(antenna);

    // 復古紅框雙眼潛水護目鏡 (Goggles)
    const goggleStrap = new THREE.Mesh(new THREE.CylinderGeometry(0.47, 0.47, 0.12, 12), strapLeatherMat);
    goggleStrap.position.set(0, 0.12, 0.02);
    headPivot.add(goggleStrap);

    for (const side of [-1, 1]) {
      const gFrame = new THREE.Mesh(new THREE.CylinderGeometry(0.20, 0.20, 0.14, 10), goggleRedMat);
      gFrame.rotation.x = Math.PI / 2;
      gFrame.position.set(side * 0.21, 0.13, 0.40);
      headPivot.add(gFrame);

      const gLens = new THREE.Mesh(new THREE.CylinderGeometry(0.15, 0.15, 0.15, 10), lensBlueMat);
      gLens.rotation.x = Math.PI / 2;
      gLens.position.set(side * 0.21, 0.13, 0.41);
      headPivot.add(gLens);

      const pupil = new THREE.Mesh(new THREE.SphereGeometry(0.055, 6, 6), darkPupilMat);
      pupil.position.set(side * 0.19, 0.13, 0.49);
      headPivot.add(pupil);
    }

    // 4. 前後四隻強壯划水大鰭足 (Flippers) + 小尾巴
    function makeFlipper(isFront, side) {
      const pivot = new THREE.Group();
      pivot.position.set(side * (isFront ? 1.05 : 0.88), 0.15, isFront ? 0.72 : -0.78);
      const mesh = new THREE.Mesh(
        new THREE.BoxGeometry(isFront ? 0.95 : 0.68, 0.12, isFront ? 0.42 : 0.32),
        skinGreenMat
      );
      mesh.position.set(side * (isFront ? 0.42 : 0.30), 0, 0);
      mesh.rotation.y = side * (isFront ? -0.25 : 0.35);
      mesh.castShadow = true;
      pivot.add(mesh);
      bodyRoot.add(pivot);
      return pivot;
    }

    const leftFrontFlipper = makeFlipper(true, -1);
    const rightFrontFlipper = makeFlipper(true, 1);
    const leftRearFlipper = makeFlipper(false, -1);
    const rightRearFlipper = makeFlipper(false, 1);

    const tailPivot = new THREE.Mesh(new THREE.ConeGeometry(0.14, 0.42, 5), skinGreenMat);
    tailPivot.rotation.x = -Math.PI / 2;
    tailPivot.position.set(0, 0.14, -1.48);
    bodyRoot.add(tailPivot);

    // 放大至醒目可愛的聖劍大海龜尺寸
    giantTurtleGroup.scale.setScalar(1.55);
    giantTurtleGroup.position.set(0, 0.16, 8.0);

    // 隱形大範圍點擊碰撞球
    const hitSphere = new THREE.Mesh(
      new THREE.SphereGeometry(1.75, 8, 8),
      new THREE.MeshBasicMaterial({ transparent: true, opacity: 0, depthWrite: false })
    );
    hitSphere.position.y = 0.5;
    giantTurtleGroup.add(hitSphere);

    giantTurtleGroup.userData = { isGiantTurtle: true, isWobbleable: true };
    giantTurtleGroup.traverse(c => {
      c.userData.isGiantTurtle = true;
      c.userData.parentGiantTurtle = giantTurtleGroup;
      c.userData.isWobbleable = true;
      c.userData.parentWobble = bodyRoot;
    });

    // 頭頂專屬祖母綠懸浮小徽章
    const turtleBadge = document.createElement('div');
    turtleBadge.className = 'ferry-label';
    turtleBadge.style.background = 'linear-gradient(135deg, rgba(5, 150, 105, 0.94), rgba(13, 148, 136, 0.94))';
    turtleBadge.style.borderColor = '#a7f3d0';
    turtleBadge.style.cursor = 'pointer';
    turtleBadge.style.pointerEvents = 'auto';
    turtleBadge.textContent = '🐢 聖劍大海龜 (點擊乘騎)';
    turtleBadge.addEventListener('pointerdown', (e) => e.stopPropagation());
    turtleBadge.addEventListener('click', (e) => {
      e.stopPropagation();
      triggerGiantTurtleInteraction();
    });
    const turtleLabelObj = new CSS2DObject(turtleBadge);
    turtleLabelObj.position.set(0, 1.75, 0);
    turtleBadge._css2dObj = turtleLabelObj;
    turtleBadge._badgeKind = 'turtle';
    giantTurtleGroup.add(turtleLabelObj);
    badgeObjects.push(turtleBadge);

    scene.add(giantTurtleGroup);

    giantTurtleData = {
      group: giantTurtleGroup,
      bodyRoot,
      headPivot,
      leftFrontFlipper,
      rightFrontFlipper,
      leftRearFlipper,
      rightRearFlipper,
      tailPivot,
      turtleFlag,
      turtleBadge,
      turtleLabelObj,
      swimPhase: 0,
      boostSpeed: 0,
      waveUntil: 0
    };
  }

  const splashDropGeo = new THREE.DodecahedronGeometry(0.14, 0);
  function triggerGiantTurtleInteraction() {
    if (!giantTurtleData) return;
    playIslandSound('giant-turtle');
    const now = Date.now();
    giantTurtleData.waveUntil = now + 2200;
    giantTurtleData.boostSpeed = 0.45;

    const worldPos = new THREE.Vector3();
    giantTurtleData.group.getWorldPosition(worldPos);
    createWaterRipple(worldPos);

    // 噴出清涼湛藍與純白浪花水珠特效！
    const splashColors = [0xffffff, 0xe0f2fe, 0x7dd3fc, 0x38bdf8];
    for (let k = 0; k < 22; k++) {
      const col = splashColors[k % splashColors.length];
      const mat = new THREE.MeshBasicMaterial({ color: col, transparent: true, opacity: 0.9 });
      const drop = new THREE.Mesh(splashDropGeo, mat);
      drop.position.copy(worldPos).add(new THREE.Vector3((Math.random() - 0.5) * 1.6, 0.35, (Math.random() - 0.5) * 1.6));
      scene.add(drop);

      const ang = Math.random() * Math.PI * 2;
      const spd = 0.05 + Math.random() * 0.12;
      giantTurtleSplashParticles.push({
        mesh: drop,
        vx: Math.cos(ang) * spd,
        vy: 0.16 + Math.random() * 0.16,
        vz: Math.sin(ang) * spd,
        startTime: now,
        duration: 850 + Math.random() * 350
      });
    }

    const quote = GIANT_TURTLE_QUOTES[Math.floor(Math.random() * GIANT_TURTLE_QUOTES.length)];
    showSpeechBubble(worldPos, quote);
    showMiniToast('🐢 聖劍大海龜揮手歡呼，激起清涼海浪水花！');
  }

  let _lastGiantTurtleTime = 0;
  function updateGiantSeaTurtle(elapsedTime) {
    if (!giantTurtleData) return;
    const dt = _lastGiantTurtleTime ? Math.min(0.05, elapsedTime - _lastGiantTurtleTime) : 0.016;
    _lastGiantTurtleTime = elapsedTime;

    const now = Date.now();
    const isWaving = now < giantTurtleData.waveUntil;

    giantTurtleData.boostSpeed *= 0.96;
    const omega = 0.095 + giantTurtleData.boostSpeed * 0.08;
    giantTurtleData.swimPhase += dt * omega;
    const u = giantTurtleData.swimPhase;

    // 沿著雙群島中央壯闊海峽與外海平穩巡航 (S 型海峽航道)
    const x = Math.sin(u * 2) * 4.2;
    const z = Math.sin(u) * 16.5;
    const y = 0.15 + Math.sin(elapsedTime * 1.8) * 0.03;

    const uNext = u + 0.025;
    const nx = Math.sin(uNext * 2) * 4.2;
    const nz = Math.sin(uNext) * 16.5;

    giantTurtleData.group.position.set(x, y, z);
    giantTurtleData.group.lookAt(nx, y, nz);

    // 划水動作與點擊時右前鰭像《聖劍傳說3》截圖一樣熱情揮手打招呼！
    const rowSin = Math.sin(elapsedTime * 2.6);
    const rowCos = Math.cos(elapsedTime * 2.6);
    giantTurtleData.leftFrontFlipper.rotation.y = 0.25 + rowSin * 0.38;
    giantTurtleData.leftFrontFlipper.rotation.z = rowCos * 0.15;

    if (isWaving) {
      // 像截圖中布斯卡布一樣舉起前鰭開心揮手！
      giantTurtleData.rightFrontFlipper.rotation.z = 0.65 + Math.sin(elapsedTime * 14) * 0.28;
      giantTurtleData.rightFrontFlipper.rotation.y = -0.15;
      giantTurtleData.headPivot.rotation.z = 0.18;
      giantTurtleData.headPivot.rotation.x = -0.18;
    } else {
      giantTurtleData.rightFrontFlipper.rotation.y = -0.25 - rowSin * 0.38;
      giantTurtleData.rightFrontFlipper.rotation.z = -rowCos * 0.15;
      giantTurtleData.headPivot.rotation.z = Math.sin(elapsedTime * 1.5) * 0.05;
      giantTurtleData.headPivot.rotation.x = Math.sin(elapsedTime * 2.0) * 0.05;
    }

    giantTurtleData.leftRearFlipper.rotation.y = -0.3 + rowCos * 0.25;
    giantTurtleData.rightRearFlipper.rotation.y = 0.3 - rowCos * 0.25;
    giantTurtleData.tailPivot.rotation.y = Math.sin(elapsedTime * 4.0) * 0.22;
    giantTurtleData.turtleFlag.rotation.y = Math.sin(elapsedTime * 6.0) * 0.25;

    // 游動時身後自然產生白色水花軌跡
    if (Math.random() < 0.28) {
      spawnWakeParticle(new THREE.Vector3(x, 0.07, z));
    }

    // 更新水花粒子
    for (let i = giantTurtleSplashParticles.length - 1; i >= 0; i--) {
      const sp = giantTurtleSplashParticles[i];
      const age = now - sp.startTime;
      if (age >= sp.duration) {
        scene.remove(sp.mesh);
        sp.mesh.material.dispose();
        giantTurtleSplashParticles.splice(i, 1);
      } else {
        sp.vy -= 0.008;
        sp.mesh.position.x += sp.vx;
        sp.mesh.position.y += sp.vy;
        sp.mesh.position.z += sp.vz;
        sp.mesh.material.opacity = (1 - age / sp.duration) * 0.9;
      }
    }

    // 🐢 若處於「騎乘聖劍大海龜視角 (Trials of Mana 3 Vuscav Sea-Level Camera)」：
    // 鏡頭貼近海平面，從海龜正後方望過龜殼與紅色小旗，仰望兩側壯麗的六角島嶼、燈塔與跨海渡輪！
    // 🐢 騎乘靈動大海龜：鎖定「看著龜背」的沉浸式第三人稱追尾視角（Third-Person Chase Camera）
    if (isTurtleRideMode) {
      const isMobile = window.innerWidth <= 768;
      // 局部座標鎖定在海龜正後方與龜殼上方（距離龜背上方 2.5 單位、後方 6 單位）
      const relativeTurtleOffset = new THREE.Vector3(0, isMobile ? 2.8 : 2.5, isMobile ? -6.8 : -6.0);
      const targetCamPos = relativeTurtleOffset.clone()
        .applyQuaternion(giantTurtleData.group.quaternion)
        .add(giantTurtleData.group.position);

      // 隨海浪微幅起伏
      targetCamPos.y += Math.sin(elapsedTime * 2.6) * 0.08;

      camera.position.lerp(targetCamPos, 0.1);

      // 視角壓低，讓畫面下方清楚呈現海龜的立體龜殼紋路與划動的前肢，前方則是貼近海面的超低仰角風景
      const turtleForward = new THREE.Vector3(0, 0, 1).applyQuaternion(giantTurtleData.group.quaternion);
      const turtleLookTarget = giantTurtleData.group.position.clone()
        .add(turtleForward.clone().multiplyScalar(12.0))
        .add(new THREE.Vector3(0, 1.1, 0));

      camera.lookAt(turtleLookTarget);
      controls.target.copy(turtleLookTarget);
    }
  }

  function toggleTurtleRideMode() {
    setTurtleRideMode(!isTurtleRideMode);
  }

  function setTurtleRideMode(on) {
    if (on) exitDragonRideSilently();
    isTurtleRideMode = on;
    const btn = document.getElementById('summonTurtleBtn');
    const txt = document.getElementById('turtleBtnText');
    const floatBar = document.getElementById('dragonRideFloatBar');
    const banner = document.getElementById('rideCinematicBanner');
    const bIcon = document.getElementById('rideBannerIcon');
    const bText = document.getElementById('rideBannerText');
    const tipsEl = document.querySelector('.island-floating-tips');
    const fActIcon = document.getElementById('floatActionIcon');
    const fActText = document.getElementById('floatActionText');
    const fExitIcon = document.getElementById('floatExitIcon');
    const fExitText = document.getElementById('floatExitText');
    const appEl = document.getElementById('islandApp');

    if (btn) btn.classList.toggle('active', on);
    if (txt) txt.textContent = on ? '靠岸' : '騎龜';
    if (on) {
      if (fActIcon) fActIcon.textContent = '🌊';
      if (fActText) fActText.textContent = '加速游動';
      if (fExitIcon) fExitIcon.textContent = '⏬';
      if (fExitText) fExitText.textContent = '結束騎乘';
      if (bIcon) bIcon.textContent = '🌊';
      if (bText) bText.textContent = '點擊畫面加速游動 · 仰望海島古堡';
    }
    if (floatBar) {
      floatBar.classList.toggle('active', on);
      floatBar.setAttribute('aria-hidden', on ? 'false' : 'true');
    }
    if (banner) {
      banner.classList.toggle('active', on);
      banner.setAttribute('aria-hidden', on ? 'false' : 'true');
    }
    if (appEl) {
      appEl.classList.toggle('is-riding-mount', on);
    }
    if (tipsEl) {
      tipsEl.style.opacity = on ? '0' : '';
      tipsEl.style.pointerEvents = on ? 'none' : '';
    }
    if (giantTurtleData && giantTurtleData.turtleBadge) {
      giantTurtleData.turtleBadge.style.display = on ? 'none' : '';
    }

    if (on) {
      // 騎乘時停用 OrbitControls 旋轉，改由 requestAnimationFrame 計算追尾攝影機
      controls.enabled = false;
      controls.autoRotate = false;
      exitBirdViewSilently();
      closeDetailCard();
      isFlightActive = false;
      camera.fov = window.innerWidth <= 768 ? 56 : 48;
      camera.updateProjectionMatrix();
      triggerGiantTurtleInteraction();
      showMiniToast('🐢 鎖定龜背追尾視角：貼近海面仰望奇幻群島！');
    } else {
      // 結束騎乘時平滑將鏡頭歸還 OrbitControls
      controls.enabled = true;
      camera.fov = 32;
      camera.updateProjectionMatrix();
      resetView();
    }
  }

  function exitTurtleRideSilently() {
    if (!isTurtleRideMode) return;
    isTurtleRideMode = false;
    controls.enabled = true;
    camera.fov = 32;
    camera.updateProjectionMatrix();
    const btn = document.getElementById('summonTurtleBtn');
    const txt = document.getElementById('turtleBtnText');
    const floatBar = document.getElementById('dragonRideFloatBar');
    const banner = document.getElementById('rideCinematicBanner');
    const appEl = document.getElementById('islandApp');
    const tipsEl = document.querySelector('.island-floating-tips');
    if (btn) btn.classList.remove('active');
    if (txt) txt.textContent = '騎龜';
    if (floatBar) {
      floatBar.classList.remove('active');
      floatBar.setAttribute('aria-hidden', 'true');
    }
    if (banner) {
      banner.classList.remove('active');
      banner.setAttribute('aria-hidden', 'true');
    }
    if (appEl) {
      appEl.classList.remove('is-riding-mount');
    }
    if (tipsEl) {
      tipsEl.style.opacity = '';
      tipsEl.style.pointerEvents = '';
    }
    if (giantTurtleData && giantTurtleData.turtleBadge) {
      giantTurtleData.turtleBadge.style.display = '';
    }
  }

  // ── (2c) 中古世紀深海黃金寶箱與噴金幣互動系統 (Golden Treasure Chests & Coin Fountain) ──
  const TREASURE_QUOTES = [
    '💰 寶箱大開！巴菲特：人生就像滾雪球，最重要的是找到濕的雪和長長的山坡（健康的身體）！',
    '💰 獲得黃金秘寶！複利是世界第八大奇蹟，而定期無痛腸胃鏡則是守護奇蹟的護城河！',
    '💰 金幣噴發！留在市場裡的時間（Time in the market），遠比猜測高低點（Timing）更重要！',
    '💰 王國寶藏箴言：今日省下一杯含糖飲料，明日收穫健康的肝臟與滿滿的複利股息！',
    '💰 傳奇秘寶：最好的投資是投資自己的健康與大腦，這兩樣資產永遠不會被通膨課稅！'
  ];

  function createTreasureChests() {
    const CHEST_SPOTS = [
      { x: 0.0, z: 3.6, rotY: 0.15, label: '💰 黃金寶箱' },
      { x: -4.4, z: -5.4, rotY: 0.65, label: '💰 醫療秘寶箱' },
      { x: 4.6, z: -5.2, rotY: -0.55, label: '💰 財富秘寶箱' }
    ];

    const woodMat = new THREE.MeshStandardMaterial({ color: 0x78350f, roughness: 0.75, flatShading: true });
    const goldMat = new THREE.MeshStandardMaterial({ color: 0xfbbf24, roughness: 0.25, metalness: 0.7, flatShading: true });
    const glowGoldMat = new THREE.MeshBasicMaterial({ color: 0xfef08a });
    const rubyMat = new THREE.MeshBasicMaterial({ color: 0xef4444 });
    const raftRockMat = new THREE.MeshStandardMaterial({ color: 0xe6d5ac, roughness: 0.9, flatShading: true });

    CHEST_SPOTS.forEach((spot, idx) => {
      const root = new THREE.Group();
      root.position.set(spot.x, 0.05, spot.z);
      root.rotation.y = spot.rotY;

      // 底部迷你金沙礁石底座
      const reef = new THREE.Mesh(new THREE.CylinderGeometry(0.95, 1.25, 0.28, 7), raftRockMat);
      reef.position.y = 0.06;
      reef.castShadow = true;
      reef.receiveShadow = true;
      root.add(reef);

      // 寶箱主體群組 (可彈跳)
      const chestGroup = new THREE.Group();
      chestGroup.position.y = 0.20;
      root.add(chestGroup);

      // 下半部木箱與黃金邊框
      const boxBase = new THREE.Mesh(new THREE.BoxGeometry(0.92, 0.46, 0.64), woodMat);
      boxBase.position.y = 0.23;
      boxBase.castShadow = true;
      chestGroup.add(boxBase);

      const goldTrim = new THREE.Mesh(new THREE.BoxGeometry(0.96, 0.10, 0.68), goldMat);
      goldTrim.position.y = 0.42;
      chestGroup.add(goldTrim);

      const lockPlate = new THREE.Mesh(new THREE.BoxGeometry(0.18, 0.24, 0.06), goldMat);
      lockPlate.position.set(0, 0.40, 0.34);
      chestGroup.add(lockPlate);

      // 箱內滿滿的發光金幣與紅寶石 (開箱時閃耀露出)
      const innerGold = new THREE.Mesh(new THREE.BoxGeometry(0.82, 0.14, 0.54), glowGoldMat);
      innerGold.position.y = 0.44;
      chestGroup.add(innerGold);

      [-0.22, 0, 0.22].forEach((rx, ri) => {
        const gem = new THREE.Mesh(new THREE.OctahedronGeometry(0.10, 0), ri === 1 ? rubyMat : goldMat);
        gem.position.set(rx, 0.54, 0.04);
        chestGroup.add(gem);
      });

      // 可掀開的上蓋樞紐 (Lid Pivot，軸心設於箱體後緣)
      const lidPivot = new THREE.Group();
      lidPivot.position.set(0, 0.46, -0.32);
      chestGroup.add(lidPivot);

      const lidWood = new THREE.Mesh(new THREE.CylinderGeometry(0.32, 0.32, 0.92, 8, 1, false, 0, Math.PI), woodMat);
      lidWood.rotation.z = Math.PI / 2;
      lidWood.position.set(0, 0, 0.32);
      lidWood.castShadow = true;
      lidPivot.add(lidWood);

      const lidBand1 = new THREE.Mesh(new THREE.CylinderGeometry(0.34, 0.34, 0.10, 8, 1, false, 0, Math.PI), goldMat);
      lidBand1.rotation.z = Math.PI / 2;
      lidBand1.position.set(-0.34, 0, 0.32);
      const lidBand2 = lidBand1.clone();
      lidBand2.position.set(0.34, 0, 0.32);
      lidPivot.add(lidBand1, lidBand2);

      // 隱形大範圍點擊碰撞球
      const hitSphere = new THREE.Mesh(
        new THREE.SphereGeometry(1.15, 8, 8),
        new THREE.MeshBasicMaterial({ transparent: true, opacity: 0, depthWrite: false })
      );
      hitSphere.position.y = 0.45;
      chestGroup.add(hitSphere);

      // 頭頂浮動小標籤 (皇家紫金配色，與純白島名、深翠綠動物膠囊明顯區隔)
      const badge = document.createElement('div');
      badge.className = 'animal-mini-pill';
      badge.style.background = 'rgba(88, 28, 135, 0.90)';
      badge.style.borderColor = '#facc15';
      badge.style.color = '#fef08a';
      badge.style.fontSize = '0.58rem';
      badge.style.padding = '1.5px 6.5px';
      badge.textContent = spot.label;
      badge.title = '點擊打開黃金寶箱噴出滿滿金幣與叮噹音效！';
      badge.addEventListener('pointerdown', (e) => e.stopPropagation());
      badge.addEventListener('click', (e) => {
        e.stopPropagation();
        triggerTreasureChest(idx);
      });
      const badgeObj = new CSS2DObject(badge);
      badgeObj.position.set(0, 1.05, 0);
      badge._css2dObj = badgeObj;
      badge._badgeKind = 'chest';
      chestGroup.add(badgeObj);
      badgeObjects.push(badge);

      root.userData = { isTreasureChest: true, chestIndex: idx, isWobbleable: true };
      root.traverse(c => {
        c.userData.isTreasureChest = true;
        c.userData.chestIndex = idx;
        c.userData.parentWobble = chestGroup;
        c.userData.isWobbleable = true;
      });

      scene.add(root);
      treasureChests.push({
        root,
        chestGroup,
        lidPivot,
        openUntil: 0,
        curLidAngle: 0,
        bobPhase: idx * 2.1
      });
    });
  }

  const coinGeo = new THREE.CylinderGeometry(0.18, 0.18, 0.05, 10);
  function triggerTreasureChest(idx) {
    const item = treasureChests[idx];
    if (!item) return;
    playIslandSound('treasure');

    item.openUntil = Date.now() + 3600;
    triggerSquash(item.chestGroup);

    const worldPos = new THREE.Vector3();
    item.chestGroup.getWorldPosition(worldPos);
    createWaterRipple(worldPos);

    // 噴射 28 枚旋轉閃耀 3D 黃金硬幣噴泉！
    for (let k = 0; k < 28; k++) {
      const isRuby = (k % 7 === 0);
      const mat = new THREE.MeshStandardMaterial({
        color: isRuby ? 0xef4444 : 0xfacc15,
        emissive: isRuby ? 0x991b1b : 0xd97706,
        emissiveIntensity: 0.45,
        roughness: 0.2,
        metalness: 0.8
      });
      const coin = new THREE.Mesh(coinGeo, mat);
      coin.position.copy(worldPos).add(new THREE.Vector3(0, 0.55, 0));
      coin.rotation.set(Math.random() * Math.PI, Math.random() * Math.PI, Math.random() * Math.PI);
      scene.add(coin);

      const ang = Math.random() * Math.PI * 2;
      const radSpd = 0.04 + Math.random() * 0.11;
      treasureCoins.push({
        mesh: coin,
        vx: Math.cos(ang) * radSpd,
        vy: 0.18 + Math.random() * 0.16,
        vz: Math.sin(ang) * radSpd,
        rx: (Math.random() - 0.5) * 0.35,
        ry: (Math.random() - 0.5) * 0.35,
        startTime: Date.now(),
        duration: 1450 + Math.random() * 500
      });
    }

    const quote = TREASURE_QUOTES[Math.floor(Math.random() * TREASURE_QUOTES.length)];
    showSpeechBubble(worldPos, quote);
    showMiniToast('💰 黃金寶箱開啟！噴出滿滿健康與複利金幣！');
  }

  function updateTreasureChests(elapsedTime) {
    const now = Date.now();
    treasureChests.forEach(tc => {
      // 隨海浪微微起伏
      tc.root.position.y = 0.04 + Math.sin(elapsedTime * 2.0 + tc.bobPhase) * 0.035;
      // 上蓋平滑開合動畫
      const targetAngle = (now < tc.openUntil) ? -1.15 : 0;
      tc.curLidAngle += (targetAngle - tc.curLidAngle) * 0.14;
      tc.lidPivot.rotation.x = tc.curLidAngle;
    });

    // 更新拋物線噴發金幣粒子
    for (let i = treasureCoins.length - 1; i >= 0; i--) {
      const c = treasureCoins[i];
      const age = now - c.startTime;
      if (age >= c.duration) {
        scene.remove(c.mesh);
        c.mesh.material.dispose();
        treasureCoins.splice(i, 1);
      } else {
        c.vy -= 0.0068; // 重力加速度落下
        c.mesh.position.x += c.vx;
        c.mesh.position.y += c.vy;
        c.mesh.position.z += c.vz;
        c.mesh.rotation.x += c.rx;
        c.mesh.rotation.y += c.ry;
        if (c.mesh.position.y < 0.05 && c.vy < 0) {
          c.vy = -c.vy * 0.45; // 碰到水面輕微彈跳
        }
      }
    }
  }

  // ── (2d) 中古世紀奇幻天氣魔法系統（保留流星、飄雪、秋楓，新增櫻花、黃金夕陽、極光螢火）──
  const WEATHER_CONFIGS = {
    clear: { icon: '☀️', name: '晴朗', toast: '☀️ 天氣切換：群島晴朗，萬里無雲' },
    sakura: { icon: '🌸', name: '櫻花', toast: '🌸 天氣切換：春日櫻花雨，暖粉花瓣微風飄落' },
    sunset: { icon: '🌅', name: '夕陽', toast: '🌅 天氣切換：魔幻黃金夕陽，斜陽灑落金色海面' },
    leaves: { icon: '🍁', name: '秋楓', toast: '🍁 天氣切換：秋風漸起，楓葉隨風優雅旋轉' },
    snow: { icon: '❄️', name: '飄雪', toast: '❄️ 天氣切換：冬日初雪，純白雪花靜靜飄落' },
    aurora: { icon: '🌌', name: '極光', toast: '🌌 天氣切換：極光星夜與螢火蟲之森，奇幻光芒流轉' },
    meteor: { icon: '🌠', name: '流星', toast: '🌠 天氣切換：流星雨降臨，向劃破夜空的繁星許願' }
  };
  const WEATHER_MODES_LIST = ['clear', 'sakura', 'sunset', 'leaves', 'snow', 'aurora', 'meteor'];

  function initWeatherMagicSystem() {
    // 1. ❄️ 奇幻飄雪粒子群 (320 朵立體六角雪花)
    snowParticlesGroup = new THREE.Group();
    snowParticlesGroup.visible = false;
    const snowGeo = new THREE.OctahedronGeometry(0.14, 0);
    const snowMat = new THREE.MeshBasicMaterial({ color: 0xffffff, transparent: true, opacity: 0.9 });
    for (let i = 0; i < 320; i++) {
      const flake = new THREE.Mesh(snowGeo, snowMat);
      flake.position.set(
        (Math.random() - 0.5) * 76,
        Math.random() * 28,
        (Math.random() - 0.5) * 52
      );
      flake.scale.setScalar(0.6 + Math.random() * 0.8);
      flake.userData = {
        fallSpeed: 0.05 + Math.random() * 0.06,
        swaySpeed: 1.2 + Math.random() * 1.5,
        phase: Math.random() * Math.PI * 2
      };
      snowParticlesGroup.add(flake);
    }
    scene.add(snowParticlesGroup);

    // 2. 🍁 黃金秋楓落葉粒子群 (220 片金黃、琥珀、楓紅落葉)
    leavesParticlesGroup = new THREE.Group();
    leavesParticlesGroup.visible = false;
    const leafGeo = new THREE.ConeGeometry(0.18, 0.04, 5);
    const leafColors = [0xf59e0b, 0xea580c, 0xfacc15, 0xd97706, 0xef4444];
    const leafMats = leafColors.map(col => new THREE.MeshBasicMaterial({ color: col, side: THREE.DoubleSide }));
    for (let i = 0; i < 220; i++) {
      const leaf = new THREE.Mesh(leafGeo, leafMats[i % leafMats.length]);
      leaf.position.set(
        (Math.random() - 0.5) * 74,
        Math.random() * 26,
        (Math.random() - 0.5) * 50
      );
      leaf.rotation.set(Math.random() * Math.PI, Math.random() * Math.PI, Math.random() * Math.PI);
      leaf.userData = {
        fallSpeed: 0.04 + Math.random() * 0.05,
        swaySpeed: 1.5 + Math.random() * 1.6,
        phase: Math.random() * Math.PI * 2,
        rotSpeed: 0.03 + Math.random() * 0.05
      };
      leavesParticlesGroup.add(leaf);
    }
    scene.add(leavesParticlesGroup);

    // 3. 🌸 春日櫻花雨粒子群 (260 片粉紅與淡白櫻花花瓣，帶水平風向偏移與旋轉飄落)
    sakuraParticlesGroup = new THREE.Group();
    sakuraParticlesGroup.visible = false;
    const petalGeo = new THREE.ConeGeometry(0.15, 0.03, 5);
    const petalColors = [0xfbcfe8, 0xf472b6, 0xffccd5, 0xffe4e6, 0xfce7f3];
    const petalMats = petalColors.map(col => new THREE.MeshBasicMaterial({ color: col, side: THREE.DoubleSide, transparent: true, opacity: 0.92 }));
    for (let i = 0; i < 260; i++) {
      const petal = new THREE.Mesh(petalGeo, petalMats[i % petalMats.length]);
      petal.position.set(
        (Math.random() - 0.5) * 80,
        Math.random() * 28,
        (Math.random() - 0.5) * 56
      );
      petal.rotation.set(Math.random() * Math.PI, Math.random() * Math.PI, Math.random() * Math.PI);
      petal.userData = {
        fallSpeed: 0.032 + Math.random() * 0.04,
        swaySpeed: 1.4 + Math.random() * 1.6,
        phase: Math.random() * Math.PI * 2,
        rotSpeed: 0.02 + Math.random() * 0.04,
        windDrift: 0.022 + Math.random() * 0.025
      };
      sakuraParticlesGroup.add(petal);
    }
    scene.add(sakuraParticlesGroup);

    // 4. 🌌 極光星夜（夜空高處半透明波浪發光幾何帶 AdditiveBlending）
    auroraGroup = new THREE.Group();
    auroraGroup.visible = false;

    // 極光帶 1：青綠色流光
    const ribbonGeo1 = new THREE.PlaneGeometry(84, 16, 42, 6);
    const ribbonMat1 = new THREE.MeshBasicMaterial({
      color: 0x00ffcc,
      transparent: true,
      opacity: 0.55,
      blending: THREE.AdditiveBlending,
      side: THREE.DoubleSide,
      depthWrite: false
    });
    const ribbon1 = new THREE.Mesh(ribbonGeo1, ribbonMat1);
    ribbon1.position.set(0, 33, -30);
    ribbon1.rotation.x = Math.PI * 0.38;
    const posArr1 = ribbonGeo1.attributes.position.array;
    ribbon1.userData = { origPos: new Float32Array(posArr1) };
    auroraGroup.add(ribbon1);

    // 極光帶 2：紫粉色流光
    const ribbonGeo2 = new THREE.PlaneGeometry(84, 14, 42, 6);
    const ribbonMat2 = new THREE.MeshBasicMaterial({
      color: 0xd946ef,
      transparent: true,
      opacity: 0.48,
      blending: THREE.AdditiveBlending,
      side: THREE.DoubleSide,
      depthWrite: false
    });
    const ribbon2 = new THREE.Mesh(ribbonGeo2, ribbonMat2);
    ribbon2.position.set(0, 36, -34);
    ribbon2.rotation.x = Math.PI * 0.40;
    const posArr2 = ribbonGeo2.attributes.position.array;
    ribbon2.userData = { origPos: new Float32Array(posArr2) };
    auroraGroup.add(ribbon2);
    scene.add(auroraGroup);

    // 5. ✨ 螢火蟲之森（島嶼地面與樹林間飄飛暖黃色螢火蟲光點）
    firefliesGroup = new THREE.Group();
    firefliesGroup.visible = false;
    const ffGeo = new THREE.SphereGeometry(0.09, 6, 6);
    const ffMat = new THREE.MeshBasicMaterial({
      color: 0xfef08a,
      transparent: true,
      opacity: 0.85,
      blending: THREE.AdditiveBlending
    });
    for (let i = 0; i < 95; i++) {
      const ff = new THREE.Mesh(ffGeo, ffMat.clone());
      ff.position.set(
        (Math.random() - 0.5) * 62,
        1.2 + Math.random() * 4.2,
        (Math.random() - 0.5) * 46
      );
      ff.userData = {
        baseX: ff.position.x,
        baseY: ff.position.y,
        baseZ: ff.position.z,
        speed: 0.8 + Math.random() * 1.2,
        phase: Math.random() * Math.PI * 2
      };
      firefliesGroup.add(ff);
    }
    scene.add(firefliesGroup);
  }

  function setWeatherMode(mode) {
    if (!WEATHER_CONFIGS[mode]) return;
    currentWeatherMode = mode;
    playIslandSound('magic');

    const btn = document.getElementById('weatherMagicBtn');
    const icon = document.getElementById('weatherBtnIcon');
    const text = document.getElementById('weatherBtnText');
    const cfg = WEATHER_CONFIGS[mode];

    // 更新可見度
    if (snowParticlesGroup) snowParticlesGroup.visible = (mode === 'snow');
    if (leavesParticlesGroup) leavesParticlesGroup.visible = (mode === 'leaves');
    if (sakuraParticlesGroup) sakuraParticlesGroup.visible = (mode === 'sakura');
    if (auroraGroup) auroraGroup.visible = (mode === 'aurora');
    if (firefliesGroup) firefliesGroup.visible = (mode === 'aurora');

    // 下拉選單 active 狀態
    document.querySelectorAll('.weather-opt-btn').forEach(b => {
      b.classList.toggle('active', b.dataset.weather === mode);
    });

    if (btn) btn.classList.toggle('active', mode !== 'clear');
    if (icon) icon.textContent = cfg.icon;
    if (text) text.textContent = cfg.name;

    // 天氣模式環境光與日夜聯動
    if (mode === 'sunset') {
      isAutoDayNight = false;
      manualTimeLock = true;
      targetCycle = 0.49;
    } else if (mode === 'aurora') {
      isAutoDayNight = false;
      manualTimeLock = true;
      targetCycle = 0.75;
    } else if (mode === 'meteor') {
      isAutoDayNight = false;
      manualTimeLock = true;
      targetCycle = 0.75;
      for (let k = 0; k < 5; k++) spawnShootingStar();
    } else if (mode === 'clear') {
      isAutoDayNight = true;
      manualTimeLock = false;
      targetCycle = 0.25;
    }

    showMiniToast(cfg.toast);
  }

  function cycleWeatherMagic() {
    const nextIdx = (WEATHER_MODES_LIST.indexOf(currentWeatherMode) + 1) % WEATHER_MODES_LIST.length;
    setWeatherMode(WEATHER_MODES_LIST[nextIdx]);
  }

  function spawnShootingStar() {
    if (shootingStars.length > 14) return;
    const group = new THREE.Group();

    // 流星頭 + 漸層長尾
    const headMat = new THREE.MeshBasicMaterial({ color: 0xfef08a });
    const head = new THREE.Mesh(new THREE.OctahedronGeometry(0.32, 0), headMat);
    group.add(head);

    const tailGeo = new THREE.ConeGeometry(0.24, 6.8, 6);
    tailGeo.rotateX(-Math.PI / 2);
    tailGeo.translate(0, 0, -3.4);
    const tailMat = new THREE.MeshBasicMaterial({
      color: Math.random() > 0.4 ? 0x38bdf8 : 0xfde047,
      transparent: true,
      opacity: 0.85,
      blending: THREE.AdditiveBlending,
      depthWrite: false
    });
    const tail = new THREE.Mesh(tailGeo, tailMat);
    group.add(tail);

    // 隨機起點與速度
    const startX = -38 + Math.random() * 55;
    const startY = 22 + Math.random() * 16;
    const startZ = -18 - Math.random() * 28;
    group.position.set(startX, startY, startZ);

    const vel = new THREE.Vector3(
      0.65 + Math.random() * 0.45,
      -0.38 - Math.random() * 0.22,
      0.15 + (Math.random() - 0.5) * 0.25
    );
    group.lookAt(group.position.clone().add(vel));
    scene.add(group);

    shootingStars.push({
      group,
      tailMat,
      vel,
      startTime: Date.now(),
      duration: 950 + Math.random() * 550
    });
  }

  function updateWeatherMagic(elapsedTime) {
    // 1. ❄️ 雪花飄落
    if (currentWeatherMode === 'snow' && snowParticlesGroup) {
      snowParticlesGroup.children.forEach(flake => {
        const u = flake.userData;
        flake.position.y -= u.fallSpeed;
        flake.position.x += Math.sin(elapsedTime * u.swaySpeed + u.phase) * 0.025;
        flake.rotation.y += 0.02;
        if (flake.position.y < 0) {
          flake.position.y = 26 + Math.random() * 4;
        }
      });
    }

    // 2. 🍁 楓葉旋轉飄落
    if (currentWeatherMode === 'leaves' && leavesParticlesGroup) {
      leavesParticlesGroup.children.forEach(leaf => {
        const u = leaf.userData;
        leaf.position.y -= u.fallSpeed;
        leaf.position.x += Math.sin(elapsedTime * u.swaySpeed + u.phase) * 0.04;
        leaf.position.z += Math.cos(elapsedTime * u.swaySpeed + u.phase) * 0.02;
        leaf.rotation.x += u.rotSpeed;
        leaf.rotation.z += u.rotSpeed * 0.8;
        if (leaf.position.y < 0) {
          leaf.position.y = 24 + Math.random() * 4;
        }
      });
    }

    // 3. 🌸 春日櫻花雨（微風水平漂移 + 旋轉）
    if (currentWeatherMode === 'sakura' && sakuraParticlesGroup) {
      sakuraParticlesGroup.children.forEach(petal => {
        const u = petal.userData;
        petal.position.y -= u.fallSpeed;
        petal.position.x += Math.sin(elapsedTime * u.swaySpeed + u.phase) * 0.03 + u.windDrift;
        petal.position.z += Math.cos(elapsedTime * (u.swaySpeed * 0.8) + u.phase) * 0.02;
        petal.rotation.x += u.rotSpeed;
        petal.rotation.y += u.rotSpeed * 1.3;
        petal.rotation.z += u.rotSpeed * 0.7;
        if (petal.position.y < 0.02) {
          petal.position.y = 26 + Math.random() * 4;
          petal.position.x = (Math.random() - 0.5) * 80;
        }
      });
    }

    // 4. 🌌 極光波動（頂點波浪位移）
    if (currentWeatherMode === 'aurora' && auroraGroup) {
      auroraGroup.children.forEach((ribbon, rIdx) => {
        const posAttr = ribbon.geometry.attributes.position;
        const origArr = ribbon.userData.origPos;
        if (!origArr) return;
        const count = posAttr.count;
        const waveSpeed = elapsedTime * 1.6 + rIdx * 1.2;
        for (let i = 0; i < count; i++) {
          const ox = origArr[i * 3];
          const oy = origArr[i * 3 + 1];
          const wave = Math.sin(waveSpeed + ox * 0.12) * 1.8 + Math.cos(elapsedTime * 0.9 + ox * 0.06) * 1.1;
          posAttr.setY(i, oy + wave);
        }
        posAttr.needsUpdate = true;
      });

      // 螢火蟲微浮動與呼吸閃爍
      if (firefliesGroup) {
        firefliesGroup.children.forEach(ff => {
          const u = ff.userData;
          const t = elapsedTime * u.speed + u.phase;
          ff.position.x = u.baseX + Math.sin(t * 1.2) * 0.8;
          ff.position.y = u.baseY + Math.sin(t * 2.0) * 0.45;
          ff.position.z = u.baseZ + Math.cos(t * 1.0) * 0.8;
          ff.material.opacity = 0.25 + 0.65 * (0.5 + 0.5 * Math.sin(elapsedTime * 4.0 + u.phase));
        });
      }
    }

    // 5. 🌠 流星雨
    if (currentWeatherMode === 'meteor' && Math.random() < 0.14) {
      spawnShootingStar();
    }
    const now = Date.now();
    for (let i = shootingStars.length - 1; i >= 0; i--) {
      const st = shootingStars[i];
      const age = now - st.startTime;
      if (age >= st.duration) {
        scene.remove(st.group);
        st.tailMat.dispose();
        shootingStars.splice(i, 1);
      } else {
        const prog = age / st.duration;
        st.group.position.add(st.vel);
        st.tailMat.opacity = (1 - prog) * 0.85;
      }
    }
  }

