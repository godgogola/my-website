        turret.castShadow = true;
        group.add(turret);

        // 橘紅圓錐塔尖
        const cone = new THREE.Mesh(new THREE.ConeGeometry(0.26, 0.65, 8), towerRoofMat);
        cone.position.set(tx, HEX_HEIGHT + 1.5 + 0.32, tz);
        cone.castShadow = true;
        group.add(cone);

        // 塔頂金屬尖飾
        const finial = new THREE.Mesh(new THREE.CylinderGeometry(0.015, 0.02, 0.16, 4), new THREE.MeshStandardMaterial({ color: 0xffd166, metalness: 0.8 }));
        finial.position.set(tx, HEX_HEIGHT + 1.5 + 0.65 + 0.08, tz);
        group.add(finial);
      });

      // 4. 拱形城門 (Arched Portal)
      const gate = new THREE.Mesh(new THREE.BoxGeometry(0.32, 0.44, 0.06), woodDoorMat);
      gate.position.set(0, HEX_HEIGHT + 0.22, 0.47);
      group.add(gate);

      // 5. 主堡高樓旗桿與飄揚小三角旗
      const flagpole = new THREE.Mesh(new THREE.CylinderGeometry(0.02, 0.02, 0.8, 4), woodDoorMat);
      flagpole.position.set(0, HEX_HEIGHT + 1.25 + 0.4, 0);
      const flag = new THREE.Mesh(new THREE.BoxGeometry(0.28, 0.16, 0.02), new THREE.MeshStandardMaterial({ color: 0x3b82f6, roughness: 0.4 }));
      flag.position.set(0.14, HEX_HEIGHT + 1.25 + 0.65, 0);
      group.add(flagpole, flag);

      // 6. 城樓夜間發光窗戶
      const winFront = new THREE.Mesh(new THREE.BoxGeometry(0.14, 0.18, 0.04), nightGlowMaterial);
      winFront.position.set(0, HEX_HEIGHT + 0.85, 0.47);
      group.add(winFront);
    }
    // 🌊 類型 B：層疊石壁瀑布與和風清潭 (Cascading Rock Waterfall & Zen Garden Pond)
    // 參考 ujUZHhkLRX.jpg / 7ynHQk9mXN.jpg / 圖二：疊石、垂柳、櫻花、清泉瀑布、池塘
    else if (island.id === 'stomach' || island.id === 'hepatitis' || island.id === 'lipids' || island.id === 'brain-neuro') {
      const rockCliffMat = new THREE.MeshStandardMaterial({ color: 0x6e5c4d, roughness: 0.95, flatShading: true });
      const waterMat = new THREE.MeshStandardMaterial({ color: 0x38bdf8, roughness: 0.15, transparent: true, opacity: 0.88 });

      // 1. 後方疊層高聳岩壁 (Tiered Cascading Cliffs)
      const cliff1 = new THREE.Mesh(new THREE.DodecahedronGeometry(0.85, 0), rockCliffMat);
      cliff1.scale.set(1.4, 1.2, 0.9);
      cliff1.position.set(0, HEX_HEIGHT + 0.7, -0.45);
      cliff1.castShadow = true;
      group.add(cliff1);

      const cliff2 = new THREE.Mesh(new THREE.DodecahedronGeometry(0.55, 0), rockCliffMat);
      cliff2.scale.set(1.1, 0.9, 0.8);
