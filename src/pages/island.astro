    const woodMat = new THREE.MeshStandardMaterial({ color: 0xba8c59, roughness: 0.8 });
    const bench = new THREE.Mesh(new THREE.BoxGeometry(0.26, 0.03, 0.09), woodMat);
    bench.position.set(0, 0.065, 0);
    bench.castShadow = true;
    propGroup.add(bench);

    const back = new THREE.Mesh(new THREE.BoxGeometry(0.26, 0.09, 0.02), woodMat);
    back.position.set(0, 0.11, -0.035);
    back.castShadow = true;
    propGroup.add(back);

    const legGeo = new THREE.BoxGeometry(0.03, 0.065, 0.07);
    const leg1 = new THREE.Mesh(legGeo, woodMat);
    leg1.position.set(0.10, 0.032, 0);
    propGroup.add(leg1);
    const leg2 = new THREE.Mesh(legGeo, woodMat);
    leg2.position.set(-0.10, 0.032, 0);
    propGroup.add(leg2);

    // 小遮陽傘
    const poleMat = new THREE.MeshStandardMaterial({ color: 0xffffff, roughness: 0.3 });
    const umbrellaPole = new THREE.Mesh(new THREE.CylinderGeometry(0.016, 0.016, 0.52, 6), poleMat);
    umbrellaPole.position.set(0.26, 0.26, 0.08);
    umbrellaPole.castShadow = true;
    propGroup.add(umbrellaPole);

    const umbrellaCanopy = new THREE.Mesh(
      new THREE.ConeGeometry(0.25, 0.09, 8),
