---
import { getCollection, render } from 'astro:content';
import Layout from '../../../layouts/Layout.astro';

export async function getStaticPaths() {
  const allBooks = await getCollection('books');
  return allBooks.map(post => ({
    params: {
      book: post.data.book,
      slug: post.data.slug
    },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);

// 取得同本書籍的所有章節，依序號由小到大排序
const allBooks = await getCollection('books');
const allValidBooks = allBooks.filter(p => !p.data.draft);

const bookChapters = allValidBooks
  .filter(p => p.data.book === post.data.book)
  .sort((a, b) => (a.data.order ?? 999) - (b.data.order ?? 999));

// 上一章 / 下一章 計算
const currentIndex = bookChapters.findIndex(p => p.data.slug === post.data.slug);
const prevChapter = currentIndex > 0 ? bookChapters[currentIndex - 1] : null;
const nextChapter = currentIndex < bookChapters.length - 1 ? bookChapters[currentIndex + 1] : null;

// 取得所有書籍分組（用於左側 Obsidian 側邊欄樹狀目錄）
const bookGroups: Record<string, typeof allValidBooks> = {};
for (const b of allValidBooks) {
  if (!bookGroups[b.data.book]) bookGroups[b.data.book] = [];
  bookGroups[b.data.book].push(b);
}

for (const k in bookGroups) {
  bookGroups[k].sort((a, b) => (a.data.order ?? 999) - (b.data.order ?? 999));
}

const sortedBooks = Object.keys(bookGroups).sort((a, b) => a.localeCompare(b, 'zh-Hant'));
---

<Layout
  title={`${post.data.title} - 《${post.data.book}》讀書筆記｜黃冠智醫師`}
  description={`${post.data.title} - 黃冠智醫師精讀《${post.data.book}》之章節筆記與核心觀點提煉。`}
  fullWidth={true}
>
  <div class="obsidian-workspace">
    <!-- 左側：Obsidian 風格樹狀側邊欄 -->
    <aside class="obs-sidebar" id="obsSidebar">
      <div class="sidebar-header">
        <div class="sidebar-title-row">
          <a href="/books" class="home-link" title="返回讀書筆記總覽">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
          </a>
          <span>讀書筆記目錄</span>
          <span class="post-count-badge">{allValidBooks.length}</span>
        </div>
        <div class="sidebar-search">
          <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
          <input type="text" id="sidebarSearch" placeholder="搜尋章節標題..." autocomplete="off" />
          <button id="sidebarSearchClear" class="search-clear" hidden>×</button>
        </div>
      </div>

      <nav class="file-tree" id="fileTree">
        {sortedBooks.map(bName => (
          <div class="folder-group expanded" data-category={bName}>
            <button class="folder-btn" data-folder={bName}>
              <svg class="folder-chevron" width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="9 18 15 12 9 6"/></svg>
              <svg class="folder-icon-svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 20h16a2 2 0 0 0 2-2V8a2 2 0 0 0-2-2h-7.93a2 2 0 0 1-1.66-.9l-.82-1.2A2 2 0 0 0 7.93 3H4a2 2 0 0 0-2 2v13a2 2 0 0 0 2 2Z"/></svg>
              <span class="folder-name">《{bName}》</span>
              <span class="folder-count">{bookGroups[bName].length}</span>
            </button>
            <div class="folder-contents" id={`folder-${bName}`}>
              {bookGroups[bName].map(item => (
                <a
                  href={`/books/${encodeURIComponent(item.data.book)}/${item.data.slug}`}
                  class:list={['file-item', { active: item.data.book === post.data.book && item.data.slug === post.data.slug }]}
                  data-slug={item.data.slug}
                  data-title={item.data.title.toLowerCase()}
                  data-category={item.data.book}
                >
                  <svg class="file-icon" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/></svg>
                  <span class="file-name">{item.data.title}</span>
                </a>
              ))}
            </div>
          </div>
        ))}
      </nav>
      <button class="sidebar-close-btn" id="sidebarClose" aria-label="關閉側邊欄">×</button>
    </aside>
    <div class="sidebar-overlay" id="sidebarOverlay"></div>

    <!-- 右側：章節正文內容 -->
    <div class="obs-main">
      <button class="mobile-menu-btn" id="mobileMenuBtn" aria-label="開啟章節目錄">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="18" x2="21" y2="18"/></svg>
        書籍目錄清單
      </button>

      <article class="article-detail">
        <nav class="article-breadcrumb" aria-label="Breadcrumb">
          <a href="/books">← 返回讀書筆記</a>
          <span class="divider">/</span>
          <a href={`/books?filter=${encodeURIComponent(post.data.book)}`} class="bc-cat">《{post.data.book}》</a>
          <span class="divider">/</span>
          <span class="current">{post.data.title}</span>
        </nav>

        <header class="article-header">
          <div class="article-meta">
            <span class="article-category">《{post.data.book}》章節精讀</span>
            <span class="meta-dot">·</span>
            <span class="article-order">第 {post.data.order ?? (currentIndex + 1)} 節</span>
          </div>
          <h1 class="article-title">{post.data.title}</h1>
          <div class="header-divider"></div>
        </header>

        <div class="article-content">
          <Content />
        </div>

        <!-- 循序閱讀章節導覽 (上一章 / 下一章) -->
        <nav class="chapter-nav" aria-label="章節導覽">
          {prevChapter ? (
            <a href={`/books/${encodeURIComponent(prevChapter.data.book)}/${prevChapter.data.slug}`} class="chapter-nav-btn prev-btn">
              <span class="nav-sub">← 上一章</span>
              <span class="nav-title">{prevChapter.data.title}</span>
            </a>
          ) : (
            <div class="chapter-nav-btn disabled">
              <span class="nav-sub">本書第一章</span>
              <span class="nav-title">起點</span>
            </div>
          )}

          {nextChapter ? (
            <a href={`/books/${encodeURIComponent(nextChapter.data.book)}/${nextChapter.data.slug}`} class="chapter-nav-btn next-btn">
              <span class="nav-sub">下一章 →</span>
              <span class="nav-title">{nextChapter.data.title}</span>
            </a>
          ) : (
            <div class="chapter-nav-btn disabled">
              <span class="nav-sub">本書完結</span>
              <span class="nav-title">全書閱讀完畢</span>
            </div>
          )}
        </nav>

        <footer class="article-footer">
          <div class="footer-card">
            <div class="doctor-mini-bio">
              <img src="/turtle-transparent.png" alt="黃冠智醫師" class="bio-avatar" />
              <div class="bio-text">
                <div class="bio-name">黃冠智 醫師</div>
                <div class="bio-title">豐田診所院長 · 肝膽腸胃內科專科</div>
                <p class="bio-desc">熱愛閱讀經典理論與跨學科知識，透過筆記萃取本質，探索心智、投資科學與健康醫學的底層連結。</p>
              </div>
            </div>
          </div>
        </footer>
      </article>
    </div>
  </div>
</Layout>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    // 側邊欄折疊邏輯
    document.querySelectorAll<HTMLButtonElement>('.folder-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        const group = btn.closest('.folder-group');
        group?.classList.toggle('expanded');
      });
    });

    // 手機版側邊欄開關
    const mobileBtn = document.getElementById('mobileMenuBtn');
    const sidebar = document.getElementById('obsSidebar');
    const overlay = document.getElementById('sidebarOverlay');
    const closeBtn = document.getElementById('sidebarClose');

    const openSidebar = () => {
      sidebar?.classList.add('mobile-open');
      overlay?.classList.add('active');
      document.body.style.overflow = 'hidden';
    };

    const closeSidebar = () => {
      sidebar?.classList.remove('mobile-open');
      overlay?.classList.remove('active');
      document.body.style.overflow = '';
    };

    mobileBtn?.addEventListener('click', openSidebar);
    overlay?.addEventListener('click', closeSidebar);
    closeBtn?.addEventListener('click', closeSidebar);

    // 側邊欄即時搜尋
    const searchInput = document.getElementById('sidebarSearch') as HTMLInputElement | null;
    const clearBtn = document.getElementById('sidebarSearchClear') as HTMLButtonElement | null;
    const fileItems = document.querySelectorAll<HTMLElement>('.file-item');
    const folderGroups = document.querySelectorAll<HTMLElement>('.folder-group');

    searchInput?.addEventListener('input', () => {
      const q = searchInput.value.trim().toLowerCase();
      if (clearBtn) clearBtn.hidden = !q;

      if (!q) {
        fileItems.forEach(el => (el.style.display = ''));
        folderGroups.forEach(el => (el.style.display = ''));
        return;
      }

      folderGroups.forEach(group => {
        let hasVisible = false;
        group.querySelectorAll<HTMLElement>('.file-item').forEach(item => {
          const match = (item.dataset.title || '').includes(q);
          item.style.display = match ? '' : 'none';
          if (match) hasVisible = true;
        });
        group.style.display = hasVisible ? '' : 'none';
        if (hasVisible) group.classList.add('expanded');
      });
    });

    clearBtn?.addEventListener('click', () => {
      if (searchInput) {
        searchInput.value = '';
        searchInput.dispatchEvent(new Event('input'));
        searchInput.focus();
      }
    });

    // 自動捲動到當前作用的章節
    const activeItem = document.querySelector('.file-item.active');
    if (activeItem) {
      activeItem.scrollIntoView({ block: 'nearest', behavior: 'smooth' });
    }
  });
</script>

