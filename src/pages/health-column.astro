---
import Layout from '../layouts/Layout.astro';
import PostCard from '../components/PostCard.astro';
import { getCollection } from 'astro:content';

// ── 取得所有已發布文章 ──
const allPosts = await getCollection('posts');
const unDraftPosts = allPosts.filter(post => !post.data.draft);

// 1. 「全部」分類預設排序：純粹依發布日期 (publishDate) 由新到舊排序
const posts = [...unDraftPosts].sort((a, b) => {
  return new Date(b.data.publishDate).getTime() - new Date(a.data.publishDate).getTime();
});

// 2. 其他特定分類排序：優先依 order (由小到大)，再依發布日期排序
const categoryPosts = [...unDraftPosts].sort((a, b) => {
  const orderA = a.data.order ?? 9999;
  const orderB = b.data.order ?? 9999;
  if (orderA !== orderB) return orderA - orderB;
  return new Date(b.data.publishDate).getTime() - new Date(a.data.publishDate).getTime();
});


// ── 分類清單（依照指定順序排列） ──
const CATEGORY_ORDER = [
  '內視鏡檢查', '肝膽胰疾病', '胃部疾病', '腸道疾病',
  '慢性病', '高血壓', '高血脂', '糖尿病', '減重',
  '健康飲食', '各種檢驗檢查', '藥物介紹', '肝病特區'
];

// ── 取得所有出現的分類（含未在 CATEGORY_ORDER 裡的） ──
const allCategories = [...new Set(posts.map(p => p.data.category || '其他'))];
const sortedCategories = [
  '全部',
  ...CATEGORY_ORDER.filter(c => allCategories.includes(c)),
  ...allCategories.filter(c => !CATEGORY_ORDER.includes(c)),
];

// ── 擷取文章摘要（去除 Markdown 符號，取前 120 字） ──
function getSummary(body: string | undefined): string {
  if (!body) return '點擊閱讀完整文章。';
  return body
    .replace(/^---[\s\S]*?---/, '')        // 移除 frontmatter
    .replace(/#{1,6}\s+/g, '')             // 移除標題符號
    .replace(/[*_`~>|]/g, '')             // 移除格式符號
    .replace(/\[([^\]]+)\]\([^)]+\)/g, '$1') // 保留連結文字
    .replace(/\s+/g, ' ')
    .trim()
    .slice(0, 120) + '…';
}
---

<Layout
  meta_title="醫學筆記｜胃腸鏡、減重與三高控制筆記 - 黃冠智醫師"
  title="醫學筆記｜胃腸鏡、減重與三高控制筆記 - 黃冠智醫師"
  description={`黃冠智醫師的胃腸肝膽醫學筆記，共 ${posts.length} 篇實證文章，涵蓋胃食道逆流、無痛胃腸鏡、肝病追蹤、減重醫學與三高慢病管理等主題。`}
>
  <!-- ── 頁面 Hero 標題 ── -->
  <div class="column-hero">
    <div class="column-hero-inner">
      <h1 class="column-hero-title">醫學筆記</h1>
    </div>
  </div>

  <!-- ── 分類篩選 Tab Pills ── -->
  <div class="filter-bar" id="filterBar" role="tablist" aria-label="文章分類篩選">
    {sortedCategories.map((cat, i) => (
      <button
        class={`filter-pill ${i === 0 ? 'active' : ''}`}
        role="tab"
        aria-selected={i === 0 ? 'true' : 'false'}
        data-filter={cat}
        id={`tab-${cat}`}
      >
        {cat}
        <span class="pill-count">
          {cat === '全部' ? posts.length : posts.filter(p => p.data.category === cat).length}
        </span>
      </button>
    ))}
  </div>

  <!-- ── 搜尋欄 ── -->
  <div class="search-row">
    <div class="search-wrapper">
      <svg class="search-icon" viewBox="0 0 24 24" width="17" height="17" fill="none" aria-hidden="true">
        <circle cx="11" cy="11" r="8" stroke="currentColor" stroke-width="2"/>
        <line x1="21" y1="21" x2="16.65" y2="16.65" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
      </svg>
      <input
        type="search"
        id="articleSearch"
        class="search-input"
        placeholder="搜尋文章標題或分類..."
        autocomplete="off"
        aria-label="搜尋文章"
      />
    </div>
    <p class="result-count" id="resultCount" aria-live="polite">顯示 {posts.length} 篇文章</p>
  </div>

  <!-- ── 文章卡片網格 ── -->
  <div class="posts-grid" id="postsGrid">
    {posts.map((post) => (
      <article
        class="grid-item"
        data-category={post.data.category || '其他'}
        data-title={post.data.title.toLowerCase()}
        data-publish-date={post.data.publishDate}
        data-order={post.data.order ?? 9999}
      >
        <PostCard
          title={post.data.title}
          href={`/posts/${post.data.slug || post.id}`}
          category={post.data.category || '其他'}
          publishDate={post.data.publishDate}
          coverImage={post.data.coverImage}
        />
      </article>
    ))}
  </div>

  <!-- ── 無結果提示 ── -->
  <div class="no-results" id="noResults" hidden aria-live="polite">
    <svg viewBox="0 0 24 24" width="52" height="52" fill="none" aria-hidden="true">
      <circle cx="12" cy="12" r="10" stroke="currentColor" stroke-width="1.5"/>
      <path d="M15 9l-6 6M9 9l6 6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
    </svg>
    <h3>找不到相符的文章</h3>
    <p>請嘗試其他關鍵字，或點擊「全部」瀏覽所有文章。</p>
    <button class="reset-btn" id="resetFilter">清除篩選</button>
  </div>

  <!-- ── 浮動選單按鈕 (FAB) ── -->
  <button class="fab-category-btn" id="fabCategoryBtn" aria-label="所有分類目錄">
    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
      <path d="M4 20h16a2 2 0 0 0 2-2V8a2 2 0 0 0-2-2h-7.93a2 2 0 0 1-1.66-.9l-.82-1.2A2 2 0 0 0 7.93 3H4a2 2 0 0 0-2 2v13a2 2 0 0 0 2 2Z"/>
    </svg>
    <span>所有分類</span>
  </button>

  <!-- ── 側滑分類抽屜 ── -->
  <div class="drawer-overlay" id="drawerOverlay"></div>
  <aside class="category-drawer" id="categoryDrawer">
    <div class="drawer-header">
      <div class="drawer-title-group">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M4 20h16a2 2 0 0 0 2-2V8a2 2 0 0 0-2-2h-7.93a2 2 0 0 1-1.66-.9l-.82-1.2A2 2 0 0 0 7.93 3H4a2 2 0 0 0-2 2v13a2 2 0 0 0 2 2Z"/></svg>
        <span>衛教文章庫目錄</span>
        <span class="drawer-badge">{posts.length}</span>
      </div>
      <button class="drawer-close-btn" id="drawerCloseBtn" aria-label="關閉目錄">×</button>
    </div>

    <div class="drawer-body">
      <div class="drawer-search">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
        <input type="text" id="drawerSearch" placeholder="在目錄中搜尋文章..." autocomplete="off" />
      </div>

      <nav class="drawer-tree">
        {sortedCategories.filter(c => c !== '全部').map((cat) => {
          const catPosts = categoryPosts.filter(p => (p.data.category || '其他') === cat);
          return (
            <div class="drawer-folder" data-drawer-cat={cat}>
              <button class="drawer-folder-btn" data-toggle-cat={cat}>
                <svg class="chevron" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="9 18 15 12 9 6"/></svg>
                <svg class="folder-ic" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 20h16a2 2 0 0 0 2-2V8a2 2 0 0 0-2-2h-7.93a2 2 0 0 1-1.66-.9l-.82-1.2A2 2 0 0 0 7.93 3H4a2 2 0 0 0-2 2v13a2 2 0 0 0 2 2Z"/></svg>
                <span class="cat-name">{cat}</span>
                <span class="cat-count">{catPosts.length}</span>
              </button>
              <div class="drawer-file-list" id={`drawer-list-${cat}`}>
                {catPosts.map(p => (
                  <a href={`/posts/${p.data.slug || p.id}`} class="drawer-file-item" data-title={p.data.title.toLowerCase()}>
                    <svg class="file-ic" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/></svg>
                    <span>{p.data.title}</span>
                  </a>
                ))}
              </div>
            </div>
          );
        })}
      </nav>
    </div>
  </aside>
</Layout>

<!-- ── 互動篩選 JS ── -->
<script>
  document.addEventListener('DOMContentLoaded', () => {
    const filterBtns = document.querySelectorAll<HTMLButtonElement>('.filter-pill');
    const gridItems = document.querySelectorAll<HTMLElement>('.grid-item');
    const searchInput = document.getElementById('articleSearch') as HTMLInputElement;
    const resultCount = document.getElementById('resultCount');
    const noResults = document.getElementById('noResults');
    const resetBtn = document.getElementById('resetFilter');

    let activeFilter = '全部';
    let searchQuery = '';

    function reorderItems() {
      const postsGrid = document.getElementById('postsGrid');
      if (!postsGrid) return;
      const items = Array.from(gridItems);
      items.sort((a, b) => {
        if (activeFilter === '全部') {
          // 「全部」分類：依 publishDate 由新到舊排序
          const dateA = new Date(a.dataset.publishDate || 0).getTime();
          const dateB = new Date(b.dataset.publishDate || 0).getTime();
          return dateB - dateA;
        } else {
          // 特定分類：依 order (由小到大)，次要依 publishDate 由新到舊
          const orderA = parseInt(a.dataset.order || '9999', 10);
          const orderB = parseInt(b.dataset.order || '9999', 10);
          if (orderA !== orderB) return orderA - orderB;
          const dateA = new Date(a.dataset.publishDate || 0).getTime();
          const dateB = new Date(b.dataset.publishDate || 0).getTime();
          return dateB - dateA;
        }
      });
      items.forEach(item => postsGrid.appendChild(item));
    }

    function updateView() {
      let visible = 0;
      gridItems.forEach(item => {
        const cat = item.dataset.category || '';
        const titleText = item.dataset.title || '';
        const matchFilter = activeFilter === '全部' || cat === activeFilter;
        const matchSearch = !searchQuery || titleText.includes(searchQuery) || cat.toLowerCase().includes(searchQuery);
        const show = matchFilter && matchSearch;
        item.hidden = !show;
        if (show) visible++;
      });
      if (resultCount) resultCount.textContent = `顯示 ${visible} 篇文章`;
      if (noResults) noResults.hidden = visible > 0;
    }

    filterBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        activeFilter = btn.dataset.filter || '全部';
        filterBtns.forEach(b => {
          b.classList.toggle('active', b === btn);
          b.setAttribute('aria-selected', b === btn ? 'true' : 'false');
        });
        reorderItems();
        updateView();
        // 篩選後捲回網格頂部
        document.getElementById('postsGrid')?.scrollIntoView({ behavior: 'smooth', block: 'start' });
      });
    });

    searchInput?.addEventListener('input', e => {
      searchQuery = (e.target as HTMLInputElement).value.trim().toLowerCase();
      updateView();
    });

    resetBtn?.addEventListener('click', () => {
      activeFilter = '全部';
      searchQuery = '';
      if (searchInput) searchInput.value = '';
      filterBtns.forEach(b => {
        const isAll = b.dataset.filter === '全部';
        b.classList.toggle('active', isAll);
        b.setAttribute('aria-selected', isAll ? 'true' : 'false');
      });
      reorderItems();
      updateView();
    });

    // ── 抽屜選單互動 ──
    const fabBtn = document.getElementById('fabCategoryBtn');
    const drawer = document.getElementById('categoryDrawer');
    const overlay = document.getElementById('drawerOverlay');
    const closeBtn = document.getElementById('drawerCloseBtn');
    const drawerSearch = document.getElementById('drawerSearch') as HTMLInputElement;

    function openDrawer() {
      drawer?.classList.add('open');
      overlay?.classList.add('active');
      document.body.style.overflow = 'hidden';
    }
    function closeDrawer() {
      drawer?.classList.remove('open');
      overlay?.classList.remove('active');
      document.body.style.overflow = '';
    }

    fabBtn?.addEventListener('click', openDrawer);
    closeBtn?.addEventListener('click', closeDrawer);
    overlay?.addEventListener('click', closeDrawer);

    // 展開/收合目錄分類
    const folderBtns = document.querySelectorAll<HTMLButtonElement>('[data-toggle-cat]');
    folderBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        const cat = btn.dataset.toggleCat;
        const list = document.getElementById(`drawer-list-${cat}`);
        const isExpanded = btn.classList.contains('open');
        btn.classList.toggle('open', !isExpanded);
        list?.classList.toggle('open', !isExpanded);
      });
    });

    // 抽屜內搜尋
    drawerSearch?.addEventListener('input', (e) => {
      const q = (e.target as HTMLInputElement).value.trim().toLowerCase();
      const folders = document.querySelectorAll<HTMLElement>('[data-drawer-cat]');
      folders.forEach(folder => {
        const cat = folder.dataset.drawerCat || '';
        const items = folder.querySelectorAll<HTMLElement>('.drawer-file-item');
        let matchCount = 0;
        items.forEach(item => {
          const t = item.dataset.title || '';
          const match = !q || t.includes(q) || cat.toLowerCase().includes(q);
          item.hidden = !match;
          if (match) matchCount++;
        });
        const folderBtn = folder.querySelector<HTMLButtonElement>('.drawer-folder-btn');
        const list = folder.querySelector<HTMLElement>('.drawer-file-list');
        if (q) {
          folder.hidden = matchCount === 0;
          if (matchCount > 0) {
            folderBtn?.classList.add('open');
            list?.classList.add('open');
          }
        } else {
          folder.hidden = false;
          folderBtn?.classList.remove('open');
          list?.classList.remove('open');
        }
      });
    });
  });
</script>

<style>
  /* ── Hero ── */
  .column-hero {
    text-align: center;
    padding: 48px 20px 36px;
    margin-bottom: 8px;
  }

  .column-hero-inner {
    max-width: 640px;
    margin: 0 auto;
  }

  .hero-eyebrow {
    display: inline-block;
    font-size: 0.82rem;
    font-weight: 700;
    color: var(--color-accent);
    background-color: var(--color-accent-light);
    padding: 4px 14px;
    border-radius: 999px;
    margin-bottom: 14px;
    letter-spacing: 0.5px;
  }

  .column-hero-title {
    font-size: clamp(1.7rem, 4vw, 2.4rem);
    font-weight: 900;
    color: var(--color-primary);
    margin-bottom: 12px;
    line-height: 1.25;
  }

  .column-hero-desc {
    font-size: 1rem;
    color: var(--color-text-muted);
    line-height: 1.7;
  }

  .column-hero-desc strong {
    color: var(--color-primary);
    font-weight: 700;
  }

  /* ── 分類篩選 Pill Tabs (與首頁一致的 SmoothUI 膠囊樣式) ── */
  .filter-bar {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    justify-content: center;
    padding: 0 4px 24px;
    max-width: 1200px;
    margin: 0 auto;
  }

  .filter-pill {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    background: #FFFFFF;
    color: var(--color-text-body);
    font-family: inherit;
    font-size: 0.86rem;
    font-weight: 700;
    padding: 6px 14px;
    border-radius: 9999px;
    border: 1px solid rgba(47, 102, 86, 0.14);
    box-shadow: 0 2px 6px rgba(0, 0, 0, 0.03);
    cursor: pointer;
    user-select: none;
    white-space: nowrap;
    line-height: 1.2;
    transition: all 0.22s cubic-bezier(0.34, 1.56, 0.64, 1);
  }

  .filter-pill:hover {
    transform: translateY(-2px);
    border-color: var(--color-primary);
    color: var(--color-primary);
    background: var(--color-primary-light);
    box-shadow: 0 4px 12px rgba(47, 102, 86, 0.15);
  }

  .filter-pill.active {
    background-color: var(--color-primary);
    border-color: var(--color-primary);
    color: #FFFFFF;
    box-shadow: 0 4px 14px rgba(47, 102, 86, 0.28);
    transform: translateY(-1px);
  }

  .pill-count {
    font-size: 0.74rem;
    font-weight: 700;
    padding: 1px 7px;
    border-radius: 999px;
    line-height: 1.5;
    background-color: rgba(47, 102, 86, 0.07);
    color: var(--color-primary);
    transition: all 0.2s ease;
  }

  .filter-pill:hover .pill-count {
    background-color: rgba(47, 102, 86, 0.14);
  }

  .filter-pill.active .pill-count {
    background-color: rgba(255, 255, 255, 0.25);
    color: #FFFFFF;
  }

  /* ── 搜尋欄 ── */
  .search-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    max-width: 1200px;
    margin: 0 auto 28px;
    flex-wrap: wrap;
  }

  .search-wrapper {
    position: relative;
    flex: 1;
    min-width: 220px;
    max-width: 420px;
  }

  .search-icon {
    position: absolute;
    left: 13px;
    top: 50%;
    transform: translateY(-50%);
    color: var(--color-text-muted);
    pointer-events: none;
  }

  .search-input {
    width: 100%;
    padding: 10px 16px 10px 40px;
    border: 1.5px solid var(--color-border);
    border-radius: 10px;
    background-color: var(--color-bg-card);
    font-family: inherit;
    font-size: 0.9rem;
    color: var(--color-text-body);
    outline: none;
    transition: border-color 0.2s ease, box-shadow 0.2s ease;
  }

  .search-input:focus {
    border-color: var(--color-primary);
    box-shadow: 0 0 0 3px rgba(47, 102, 86, 0.1);
  }

  .search-input::placeholder {
    color: var(--color-text-muted);
  }

  .result-count {
    font-size: 0.85rem;
    color: var(--color-text-muted);
    white-space: nowrap;
    font-weight: 500;
  }

  /* ── 卡片網格 ── */
  .posts-grid {
    display: grid;
    /* 手機：1 欄 */
    grid-template-columns: 1fr;
    gap: 24px;
    max-width: 1200px;
    margin: 0 auto 48px;
  }

  /* 平板：2 欄 */
  @media (min-width: 640px) {
    .posts-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  /* 桌面：3 欄 */
  @media (min-width: 1024px) {
    .posts-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .grid-item {
    display: flex;
    flex-direction: column;
    width: 100%;
  }

  .grid-item[hidden] {
    display: none;
  }

  /* ── 無結果提示 ── */
  .no-results {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 72px 24px;
    text-align: center;
    color: var(--color-text-muted);
    gap: 12px;
    max-width: 400px;
    margin: 0 auto 48px;
  }

  .no-results[hidden] {
    display: none;
  }

  .no-results svg {
    color: #C5786E;
    opacity: 0.8;
    margin-bottom: 4px;
  }

  .no-results h3 {
    font-size: 1.15rem;
    color: var(--color-primary);
    font-weight: 700;
  }

  .no-results p {
    font-size: 0.92rem;
    line-height: 1.6;
  }

  .reset-btn {
    margin-top: 8px;
    padding: 9px 24px;
    border-radius: 999px;
    border: 1.5px solid var(--color-primary);
    background: transparent;
    color: var(--color-primary);
    font-family: inherit;
    font-size: 0.88rem;
    font-weight: 700;
    cursor: pointer;
    transition: background-color 0.2s ease, color 0.2s ease;
  }

  .reset-btn:hover {
    background-color: var(--color-primary);
    color: #ffffff;
  }

  /* ── 浮動選單按鈕 (FAB) ── */
  .fab-category-btn {
    position: fixed;
    bottom: 28px;
    right: 24px;
    z-index: 99;
    display: flex;
    align-items: center;
    gap: 8px;
    background-color: var(--color-primary);
    color: #ffffff;
    border: none;
    padding: 12px 20px;
    border-radius: 999px;
    font-family: inherit;
    font-size: 0.95rem;
    font-weight: 700;
    cursor: pointer;
    box-shadow: 0 6px 24px rgba(47, 102, 86, 0.38);
    transition: transform 0.25s cubic-bezier(0.34, 1.56, 0.64, 1), background-color 0.2s ease, box-shadow 0.25s ease;
  }
  .fab-category-btn:hover {
    transform: translateY(-4px) scale(1.04);
    background-color: var(--color-primary-dark, #234d41);
    box-shadow: 0 10px 30px rgba(47, 102, 86, 0.48);
  }

  /* ── 側滑抽屜 ── */
  .drawer-overlay {
    position: fixed;
    inset: 0;
    background-color: rgba(0, 0, 0, 0.45);
    backdrop-filter: blur(3px);
    z-index: 1000;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.3s ease;
  }
  .drawer-overlay.active {
    opacity: 1;
    pointer-events: auto;
  }

  .category-drawer {
    position: fixed;
    top: 0;
    left: 0;
    bottom: 0;
    width: 320px;
    max-width: 85vw;
    background-color: #f3f0eb;
    z-index: 1001;
