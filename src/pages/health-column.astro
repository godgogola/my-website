---
import Layout from '../layouts/Layout.astro';
import PostCard from '../components/PostCard.astro';
import { getCollection } from 'astro:content';

// ── 取得所有已發布文章 ──
const allPosts = await getCollection('posts');
const unDraftPosts = allPosts.filter(post => !post.data.draft);

// 1. 「全部」分類預設排序：純粹依發布日期 (publishDate) 由新到舊排序
const posts = [...unDraftPosts].sort((a, b) => {
  const dateDiff = new Date(b.data.publishDate).getTime() - new Date(a.data.publishDate).getTime();
  if (dateDiff !== 0) return dateDiff;
  const orderA = a.data.order ?? 9999;
  const orderB = b.data.order ?? 9999;
  if (orderA !== orderB) return orderA - orderB;
  return a.data.title.localeCompare(b.data.title, 'zh-Hant');
});

// 2. 其他特定分類排序：優先依 order (由小到大)，再依發布日期排序
const categoryPosts = [...unDraftPosts].sort((a, b) => {
  const orderA = a.data.order ?? 9999;
  const orderB = b.data.order ?? 9999;
  if (orderA !== orderB) return orderA - orderB;
  return new Date(b.data.publishDate).getTime() - new Date(a.data.publishDate).getTime();
});

// ── 分類清單（依照指定順序排列） ──
const CATEGORY_ORDER = [
  '內視鏡檢查', '肝膽胰疾病', '胃部疾病', '腸道疾病',
  '慢性病', '高血壓', '高血脂', '糖尿病', '減重',
  '健康飲食', '各種檢驗檢查', '藥物介紹', '肝病特區', '超音波檢查'
];

// ── 取得所有出現的分類（含未在 CATEGORY_ORDER 裡的） ──
const allCategories = [...new Set(posts.map(p => p.data.category || '其他'))];
const sortedCategories = [
  '全部',
  ...CATEGORY_ORDER.filter(c => allCategories.includes(c)),
  ...allCategories.filter(c => !CATEGORY_ORDER.includes(c)),
];
---

<Layout
  meta_title="醫學筆記｜胃腸鏡、減重與三高控制筆記 - 黃冠智醫師"
  title="醫學筆記｜胃腸鏡、減重與三高控制筆記 - 黃冠智醫師"
  description={`黃冠智醫師的胃腸肝膽醫學筆記，共 ${posts.length} 篇實證文章，涵蓋胃食道逆流、無痛胃腸鏡、肝病追蹤、減重醫學與三高慢病管理等主題。`}
>
  <!-- ── 頁面 Hero 標題 ── -->
  <div class="column-hero">
    <div class="column-hero-inner">
      <h1 class="column-hero-title">臨床實證 <span class="gradient-text">醫學筆記</span></h1>
      <p class="column-hero-desc">
        共收錄 <strong>{posts.length}</strong> 篇專業衛教文章，為您解析胃腸鏡、慢性病防治與健康飲食
      </p>
    </div>
  </div>

  <!-- ── 搜尋欄與目錄按鈕 ── -->
  <div class="search-row">
    <div class="search-wrapper">
      <svg class="search-icon" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true">
        <circle cx="11" cy="11" r="8"/>
        <line x1="21" y1="21" x2="16.65" y2="16.65"/>
      </svg>
      <input
        type="search"
        id="articleSearch"
        class="search-input"
        placeholder="搜尋文章標題、疾病或關鍵字..."
        autocomplete="off"
        aria-label="搜尋文章"
      />
    </div>
    <div class="search-actions">
      <button class="open-drawer-btn" id="openDrawerBtn" aria-label="展開完整分類目錄">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2">
          <path d="M4 20h16a2 2 0 0 0 2-2V8a2 2 0 0 0-2-2h-7.93a2 2 0 0 1-1.66-.9l-.82-1.2A2 2 0 0 0 7.93 3H4a2 2 0 0 0-2 2v13a2 2 0 0 0 2 2Z"/>
        </svg>
        <span>目錄分類</span>
      </button>
      <p class="result-count" id="resultCount" aria-live="polite">共 {posts.length} 篇</p>
    </div>
  </div>

  <!-- ── AnimatedTabs 彈簧磁吸滑塊分類選單 (方案 A) ── -->
  <div class="filter-bar-wrapper">
    <div class="filter-bar-track" id="filterBarTrack" role="tablist" aria-label="文章分類篩選">
      <!-- 彈簧磁吸滑動背景 Indicator -->
      <div class="filter-spring-indicator" id="filterSpringIndicator" aria-hidden="true"></div>
      
      {sortedCategories.map((cat, i) => (
        <button
          class={`filter-tab-btn ${i === 0 ? 'active' : ''}`}
          role="tab"
          aria-selected={i === 0 ? 'true' : 'false'}
          data-filter={cat}
          id={`tab-${cat}`}
          type="button"
        >
          <span class="tab-label">{cat}</span>
          <span class="tab-count">
            {cat === '全部' ? posts.length : posts.filter(p => p.data.category === cat).length}
          </span>
        </button>
      ))}
    </div>
  </div>

  <!-- ── 文章卡片網格 ── -->
  <div class="posts-grid" id="postsGrid">
    {posts.map((post) => (
      <article
        class="grid-item"
        data-category={post.data.category || '其他'}
        data-title={post.data.title.toLowerCase()}
        data-publish-date={post.data.publishDate}
        data-order={post.data.order ?? 9999}
      >
        <PostCard
          title={post.data.title}
          href={`/posts/${post.data.slug || post.id}`}
          category={post.data.category || '其他'}
          publishDate={post.data.publishDate}
          coverImage={post.data.coverImage}
        />
      </article>
    ))}
  </div>

  <!-- ── 無結果提示 ── -->
  <div class="no-results" id="noResults" hidden aria-live="polite">
    <div class="no-results-icon">🩺</div>
    <h3>找不到相符的衛教文章</h3>
    <p>請嘗試其他關鍵字，或點擊「全部」瀏覽所有專欄。</p>
    <button class="reset-btn" id="resetFilter">清除篩選條件</button>
  </div>

  <!-- ── 側滑分類抽屜 ── -->
  <div class="drawer-overlay" id="drawerOverlay"></div>
  <aside class="category-drawer" id="categoryDrawer">
    <div class="drawer-header">
      <div class="drawer-title-group">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M4 20h16a2 2 0 0 0 2-2V8a2 2 0 0 0-2-2h-7.93a2 2 0 0 1-1.66-.9l-.82-1.2A2 2 0 0 0 7.93 3H4a2 2 0 0 0-2 2v13a2 2 0 0 0 2 2Z"/></svg>
        <span>衛教筆記庫目錄</span>
        <span class="drawer-badge">{posts.length}</span>
      </div>
      <button class="drawer-close-btn" id="drawerCloseBtn" aria-label="關閉目錄">×</button>
    </div>

    <div class="drawer-body">
      <div class="drawer-search">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
        <input type="text" id="drawerSearch" placeholder="在目錄中搜尋文章..." autocomplete="off" />
      </div>

      <nav class="drawer-tree">
        {sortedCategories.filter(c => c !== '全部').map((cat) => {
          const catPosts = categoryPosts.filter(p => (p.data.category || '其他') === cat);
          return (
            <div class="drawer-folder" data-drawer-cat={cat}>
              <button class="drawer-folder-btn" data-toggle-cat={cat}>
                <svg class="chevron" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="9 18 15 12 9 6"/></svg>
                <svg class="folder-ic" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 20h16a2 2 0 0 0 2-2V8a2 2 0 0 0-2-2h-7.93a2 2 0 0 1-1.66-.9l-.82-1.2A2 2 0 0 0 7.93 3H4a2 2 0 0 0-2 2v13a2 2 0 0 0 2 2Z"/></svg>
                <span class="cat-name">{cat}</span>
                <span class="cat-count">{catPosts.length}</span>
              </button>
              <div class="drawer-file-list" id={`drawer-list-${cat}`}>
                {catPosts.map(p => (
                  <a href={`/posts/${p.data.slug || p.id}`} class="drawer-file-item" data-title={p.data.title.toLowerCase()}>
                    <svg class="file-ic" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/></svg>
                    <span>{p.data.title}</span>
                  </a>
                ))}
              </div>
            </div>
          );
        })}
      </nav>
    </div>
  </aside>
</Layout>

<!-- ── 互動篩選與 AnimatedTabs Spring 動效 JS ── -->
<script>
  document.addEventListener('DOMContentLoaded', () => {
    const filterTrack = document.getElementById('filterBarTrack');
    const indicator = document.getElementById('filterSpringIndicator');
    const filterBtns = document.querySelectorAll<HTMLButtonElement>('.filter-tab-btn');
    const gridItems = document.querySelectorAll<HTMLElement>('.grid-item');
    const searchInput = document.getElementById('articleSearch') as HTMLInputElement;
    const resultCount = document.getElementById('resultCount');
    const noResults = document.getElementById('noResults');
    const resetBtn = document.getElementById('resetFilter');

    // 檢查 URL query params
    const urlParams = new URLSearchParams(window.location.search);
    const initialSearch = urlParams.get('search') || urlParams.get('q') || '';
    const initialFilter = urlParams.get('filter') || '全部';

    let activeFilter = initialFilter;
    let searchQuery = initialSearch.toLowerCase();

    if (searchInput && initialSearch) {
      searchInput.value = initialSearch;
    }

    // ── 彈簧滑塊位置更新函數 ──
    const updateSpringIndicator = (target: HTMLElement, immediate = false) => {
      if (!filterTrack || !indicator || !target) return;
      const trackRect = filterTrack.getBoundingClientRect();
      const targetRect = target.getBoundingClientRect();
      const left = targetRect.left - trackRect.left + filterTrack.scrollLeft;
      const top = targetRect.top - trackRect.top;
      const width = targetRect.width;
      const height = targetRect.height;

      if (immediate) {
        indicator.style.transition = 'none';
      } else {
        indicator.style.transition = 'transform 0.28s cubic-bezier(0.34, 1.56, 0.64, 1), width 0.28s cubic-bezier(0.34, 1.56, 0.64, 1)';
      }

      indicator.style.transform = `translate3d(${left}px, ${top}px, 0)`;
      indicator.style.width = `${width}px`;
      indicator.style.height = `${height}px`;
      indicator.style.opacity = '1';
    };

    if (initialFilter !== '全部') {
      filterBtns.forEach(btn => {
        if (btn.dataset.filter === initialFilter) {
          btn.classList.add('active');
          btn.setAttribute('aria-selected', 'true');
          btn.scrollIntoView({ behavior: 'smooth', block: 'nearest', inline: 'center' });
        } else {
          btn.classList.remove('active');
          btn.setAttribute('aria-selected', 'false');
        }
      });
    }

    // 初始化滑塊位置
    const currentActiveBtn = document.querySelector<HTMLButtonElement>('.filter-tab-btn.active') || filterBtns[0];
    if (currentActiveBtn) {
      updateSpringIndicator(currentActiveBtn, true);
    }

    function reorderItems() {
      const postsGrid = document.getElementById('postsGrid');
      if (!postsGrid) return;
      const items = Array.from(gridItems);
      items.sort((a, b) => {
        if (activeFilter === '全部') {
          const dateA = new Date(a.dataset.publishDate || 0).getTime();
          const dateB = new Date(b.dataset.publishDate || 0).getTime();
          if (dateB !== dateA) return dateB - dateA;
          const orderA = parseInt(a.dataset.order || '9999', 10);
          const orderB = parseInt(b.dataset.order || '9999', 10);
          if (orderA !== orderB) return orderA - orderB;
          return (a.dataset.title || '').localeCompare(b.dataset.title || '', 'zh-Hant');
        } else {
          const orderA = parseInt(a.dataset.order || '9999', 10);
          const orderB = parseInt(b.dataset.order || '9999', 10);
          if (orderA !== orderB) return orderA - orderB;
          const dateA = new Date(a.dataset.publishDate || 0).getTime();
          const dateB = new Date(b.dataset.publishDate || 0).getTime();
          return dateB - dateA;
        }
      });
      items.forEach(item => postsGrid.appendChild(item));
    }

    function updateView() {
      let visible = 0;
      gridItems.forEach(item => {
        const cat = item.dataset.category || '';
        const titleText = item.dataset.title || '';
        const matchFilter = activeFilter === '全部' || cat === activeFilter;
        const matchSearch = !searchQuery || titleText.includes(searchQuery) || cat.toLowerCase().includes(searchQuery);
        const show = matchFilter && matchSearch;
        item.hidden = !show;
        if (show) visible++;
      });
      if (resultCount) resultCount.textContent = `共 ${visible} 篇`;
      if (noResults) noResults.hidden = visible > 0;
    }

    filterBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        activeFilter = btn.dataset.filter || '全部';
        filterBtns.forEach(b => {
          const isMe = b === btn;
          b.classList.toggle('active', isMe);
          b.setAttribute('aria-selected', isMe ? 'true' : 'false');
        });
        updateSpringIndicator(btn);
        btn.scrollIntoView({ behavior: 'smooth', block: 'nearest', inline: 'center' });
        reorderItems();
        updateView();
      });
    });

    window.addEventListener('resize', () => {
      const active = document.querySelector<HTMLButtonElement>('.filter-tab-btn.active') || filterBtns[0];
      if (active) updateSpringIndicator(active, true);
    }, { passive: true });

    searchInput?.addEventListener('input', (e) => {
      searchQuery = (e.target as HTMLInputElement).value.trim().toLowerCase();
      updateView();
    });

    resetBtn?.addEventListener('click', () => {
      activeFilter = '全部';
      searchQuery = '';
      if (searchInput) searchInput.value = '';
      filterBtns.forEach((b, i) => {
        b.classList.toggle('active', i === 0);
        b.setAttribute('aria-selected', i === 0 ? 'true' : 'false');
      });
      if (filterBtns[0]) {
        updateSpringIndicator(filterBtns[0]);
        filterBtns[0].scrollIntoView({ behavior: 'smooth', block: 'nearest', inline: 'center' });
      }
      reorderItems();
      updateView();
    });

    // 初始執行
    reorderItems();
    updateView();

    // 側邊欄抽屜邏輯
    const openDrawerBtn = document.getElementById('openDrawerBtn');
    const drawer = document.getElementById('categoryDrawer');
    const overlay = document.getElementById('drawerOverlay');
    const closeBtn = document.getElementById('drawerCloseBtn');
    const drawerSearch = document.getElementById('drawerSearch') as HTMLInputElement;

    function openDrawer() {
      drawer?.classList.add('active');
      overlay?.classList.add('active');
      document.body.style.overflow = 'hidden';
      drawerSearch?.focus();
    }

    function closeDrawer() {
      drawer?.classList.remove('active');
      overlay?.classList.remove('active');
      document.body.style.overflow = '';
    }

    openDrawerBtn?.addEventListener('click', openDrawer);
    closeBtn?.addEventListener('click', closeDrawer);
    overlay?.addEventListener('click', closeDrawer);

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') closeDrawer();
    });

    // 展開/收合目錄分類
    const folderBtns = document.querySelectorAll<HTMLButtonElement>('[data-toggle-cat]');
    folderBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        const cat = btn.dataset.toggleCat;
        const list = document.getElementById(`drawer-list-${cat}`);
        const isExpanded = btn.classList.contains('open');
        btn.classList.toggle('open', !isExpanded);
        list?.classList.toggle('open', !isExpanded);
      });
    });

    // 抽屜內搜尋
    drawerSearch?.addEventListener('input', (e) => {
      const q = (e.target as HTMLInputElement).value.trim().toLowerCase();
      const folders = document.querySelectorAll<HTMLElement>('[data-drawer-cat]');
      folders.forEach(folder => {
        const cat = folder.dataset.drawerCat || '';
        const items = folder.querySelectorAll<HTMLElement>('.drawer-file-item');
        let matchCount = 0;
        items.forEach(item => {
          const t = item.dataset.title || '';
          const match = !q || t.includes(q) || cat.toLowerCase().includes(q);
          item.hidden = !match;
          if (match) matchCount++;
        });
        const folderBtn = folder.querySelector<HTMLButtonElement>('.drawer-folder-btn');
        const list = folder.querySelector<HTMLElement>('.drawer-file-list');
        if (q) {
          folder.hidden = matchCount === 0;
          if (matchCount > 0) {
            folderBtn?.classList.add('open');
            list?.classList.add('open');
          }
        } else {
          folder.hidden = false;
          folderBtn?.classList.remove('open');
          list?.classList.remove('open');
        }
      });
    });
  });
</script>

<style>
  /* ── 頂部 Hero ── */
  .column-hero {
    text-align: center;
    padding: 24px 16px 14px;
    margin-bottom: 4px;
  }

  .column-hero-inner {
    max-width: 680px;
    margin: 0 auto;
  }

  .hero-badge {
    margin-bottom: 10px;
  }

  .column-hero-title {
    font-size: clamp(1.8rem, 3.8vw, 2.5rem);
    font-weight: 900;
    color: var(--color-text-title, #1e3a4c);
    margin-bottom: 8px;
    line-height: 1.25;
  }

  .column-hero-desc {
    font-size: 0.98rem;
    color: var(--color-text-muted, #5a7a8a);
    line-height: 1.6;
  }

  .column-hero-desc strong {
    color: var(--color-primary, #4a90a4);
    font-weight: 800;
  }

  /* ── 搜尋欄與目錄按鈕 ── */
  .search-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    max-width: 1200px;
    margin: 0 auto 16px;
    flex-wrap: wrap;
  }

  .search-wrapper {
    position: relative;
    flex: 1;
    min-width: 240px;
  }

  .search-icon {
    position: absolute;
    left: 16px;
    top: 50%;
    transform: translateY(-50%);
    color: var(--color-text-muted, #5a7a8a);
    pointer-events: none;
  }

  .search-input {
    width: 100%;
    padding: 11px 18px 11px 44px;
    border: 1.5px solid var(--color-border, #d4e5eb);
    border-radius: 9999px;
    background-color: #FFFFFF;
    font-family: inherit;
    font-size: 0.92rem;
    color: var(--color-text-body, #2d4f63);
    outline: none;
    box-shadow: 0 4px 14px rgba(74, 144, 164, 0.04);
    transition: border-color 0.25s ease, box-shadow 0.25s ease;
  }

  .search-input:focus {
    border-color: var(--color-primary, #4a90a4);
    box-shadow: 0 6px 20px rgba(74, 144, 164, 0.18);
  }

  .search-input::placeholder {
    color: #8ba5b5;
  }

  .search-actions {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .open-drawer-btn {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    background: #FFFFFF;
    color: var(--color-primary, #4a90a4);
    border: 1.5px solid var(--color-border, #d4e5eb);
    padding: 9px 16px;
    border-radius: 9999px;
    font-family: inherit;
    font-size: 0.88rem;
    font-weight: 700;
    cursor: pointer;
    box-shadow: 0 2px 8px rgba(74, 144, 164, 0.06);
    transition: all 0.2s ease;
    white-space: nowrap;
  }

  .open-drawer-btn:hover {
    background: var(--color-primary-light, #eef7f9);
    border-color: var(--color-primary, #4a90a4);
    transform: translateY(-1px);
  }

  .result-count {
    font-size: 0.86rem;
    color: var(--color-text-muted, #5a7a8a);
    white-space: nowrap;
    font-weight: 700;
  }

  /* ── AnimatedTabs 彈簧磁吸滑塊 (如附圖白色純淨膠囊) ── */
  .filter-bar-wrapper {
    max-width: 1200px;
    margin: 0 auto 24px;
    position: relative;
  }

  /* 右側漸層提示：表示可以左右滑動看更多分類 */
  .filter-bar-wrapper::after {
    content: '';
    position: absolute;
    top: 0;
    right: 0;
    width: 48px;
    height: 100%;
    background: linear-gradient(to right, transparent, #f0f4f6 90%);
    border-radius: 0 9999px 9999px 0;
    pointer-events: none;
    z-index: 10;
  }

  .filter-bar-track {
    position: relative;
    display: flex;
    flex-wrap: nowrap;
    overflow-x: auto;
    gap: 2px;
    background: #eef2f5;
    padding: 4px;
    border-radius: 9999px;
    border: 1px solid var(--color-border, #d4e5eb);
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
  }

  .filter-bar-track::-webkit-scrollbar {
    display: none;
  }

  /* 彈簧磁吸白色膠囊 Indicator */
  .filter-spring-indicator {
    position: absolute;
    top: 0;
    left: 0;
    border-radius: 9999px;
    background: #ffffff;
    box-shadow: 0 2px 8px rgba(30, 58, 76, 0.08), 0 1px 3px rgba(30, 58, 76, 0.04);
    border: 1px solid rgba(212, 229, 235, 0.85);
    pointer-events: none;
    z-index: 1;
    opacity: 0;
    transition: transform 0.28s cubic-bezier(0.34, 1.56, 0.64, 1), width 0.28s cubic-bezier(0.34, 1.56, 0.64, 1);
  }

  .filter-tab-btn {
    position: relative;
    z-index: 2;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    background: transparent;
    border: none;
    padding: 7px 16px;
    border-radius: 9999px;
    font-family: inherit;
    font-size: 0.88rem;
    font-weight: 600;
    color: var(--color-text-muted, #5a7a8a);
    cursor: pointer;
    user-select: none;
