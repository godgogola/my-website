---
import Layout from '../../layouts/Layout.astro';
import EndoscopyPageContent from '../../components/EndoscopyPageContent.astro';
---

<Layout
  title="豐田診所無痛腸胃鏡專題 (Wix 嵌入版)"
  meta_title="豐田診所無痛腸胃鏡專題 (Wix 嵌入版)"
  description="豐田診所無痛腸胃鏡 Wix 嵌入版，免 Header/Footer 乾淨滿版，支援大腸鏡檢個人化時間試算與內視鏡衛教短影音。"
  hideHeader={true}
  hideFooter={true}
  isEmbed={true}
  fullWidth={true}
>
  <EndoscopyPageContent isEmbed={true} />
</Layout>

<style is:global>
  /* 專門為 Wix 嵌入環境設計的極限防切邊與 100% 自適應重設（對齊個人網站大字級標準） */
  html, body {
    width: 100% !important;
    max-width: 100vw !important;
    margin: 0 !important;
    padding: 0 !important;
    overflow-x: hidden !important;
    background: transparent !important;
    -webkit-text-size-adjust: 100% !important;
    text-size-adjust: 100% !important;
  }
  @media (max-width: 640px) {
    html {
      font-size: 18px !important; /* 對齊個人網站手機版 18px 大字級標準，提升長輩與病患閱讀清晰度 */
    }
  }
  @media (max-width: 360px) {
    html {
      font-size: 16px !important; /* 極窄螢幕（如 320px Wix 邊界）微調為 16px，維持舒適可讀且防貼邊 */
    }
  }
</style>
