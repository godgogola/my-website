---
import Layout from '../layouts/Layout.astro';
import VideoCard from '../components/VideoCard.astro';
import VideoModal from '../components/VideoModal.astro';
import {
  videos,
  medicalCategories,
  bookCategories,
  getVideoSectionType,
} from '../data/videos';

// 分開計算醫學與讀書筆記各分類的影片數量
const medicalVideos = videos.filter((v) => getVideoSectionType(v.category) === 'medical');
const bookVideos = videos.filter((v) => getVideoSectionType(v.category) === 'book');

const medicalCategoryCounts = medicalCategories.reduce((acc, cat) => {
  if (cat === '全部') {
    acc[cat] = medicalVideos.length;
  } else {
    acc[cat] = medicalVideos.filter((v) => v.category === cat).length;
  }
  return acc;
}, {} as Record<string, number>);

const bookCategoryCounts = bookCategories.reduce((acc, cat) => {
  if (cat === '全部') {
    acc[cat] = bookVideos.length;
  } else {
    acc[cat] = bookVideos.filter((v) => v.category === cat).length;
  }
  return acc;
}, {} as Record<string, number>);
---

<Layout
  title="動物農莊衛教短影音 ＆ 說書人講堂｜黃冠智醫師 肝膽腸胃科"
  meta_title="影音專區｜動物農莊衛教短影音 ＆ 說書人經典導讀｜黃冠智醫師"
  description="黃冠智醫師影音專區：包含「動物農莊衛教短影音」1 分鐘解說腸胃疾病與代謝醫學；以及「說書人講堂」以 3D 羊毛針氈定格美學導讀《漫步華爾街》等經典著作。"
>
  <div class="videos-page-container">
    <!-- 頂部雙軌次分頁切換 Segmented Switcher (Obsidian & Liquid Chrome Style) -->
    <div class="dual-track-wrapper">
      <div class="dual-track-nav" role="tablist" aria-label="影片專區軌道切換">
        <button
          type="button"
          role="tab"
          class="track-tab active"
          id="tab-btn-medical"
          data-target-section="medical"
          aria-selected="true"
        >
          <span class="track-tab-icon">🩺</span>
          <span class="track-tab-text">
            <span class="text-desktop">動物農莊 · 醫學短影音</span>
            <span class="text-mobile">醫學短影音</span>
          </span>
          <span class="track-tab-count">{medicalVideos.length}</span>
        </button>

        <button
          type="button"
          role="tab"
          class="track-tab"
          id="tab-btn-book"
          data-target-section="book"
          aria-selected="false"
        >
          <span class="track-tab-icon">📚</span>
          <span class="track-tab-text">
            <span class="text-desktop">說書人講堂 · 讀書短影音</span>
            <span class="text-mobile">讀書短影音</span>
          </span>
          <span class="track-tab-count">{bookVideos.length}</span>
        </button>
      </div>
    </div>

    <!-- ════════════ 雙態 Hero Banner ════════════ -->
    <!-- [1] 醫學短影音專屬 Hero -->
    <header class="videos-hero hero-medical active" id="hero-medical">
      <div class="ambient-mesh-glow medical-glow" aria-hidden="true"></div>
      
      <div class="header-eyebrow">
        <span class="eyebrow-dot"></span>
        <span class="eyebrow-text">動物界專科醫師出診</span>
        <span class="eyebrow-pill">實證衛教</span>
      </div>

      <h1 class="videos-hero-title">
        <span class="text-steel">動物農莊</span>
        <span class="text-chrome">衛教短影音</span>
      </h1>
      
      <p class="videos-hero-desc">
        邀請動物界專科醫師出診，以 1 分鐘實證短片為您解說常見腸胃疾病、內視鏡檢查與代謝保健。
      </p>

      <div class="videos-hero-actions">
        <div class="hero-stats">
          <div class="stat-pill">
            <span>收錄影片</span>
            <strong>{medicalVideos.length} 部</strong>
          </div>
          <div class="stat-pill">
            <span>涵蓋專題</span>
            <strong>{medicalCategories.length - 1} 大類別</strong>
          </div>
        </div>
      </div>
    </header>

    <!-- [2] 讀書短影音專屬 Hero -->
    <header class="videos-hero hero-book" id="hero-book">
      <div class="ambient-mesh-glow book-glow" aria-hidden="true"></div>
      
      <div class="header-eyebrow">
        <span class="eyebrow-dot book-dot"></span>
        <span class="eyebrow-text">羊毛定格說書美學</span>
        <span class="eyebrow-pill book-pill">經典精讀</span>
      </div>

      <h1 class="videos-hero-title">
        <span class="text-steel">說書人講堂</span>
        <span class="text-chrome-gold">讀書短影音</span>
      </h1>
      
      <p class="videos-hero-desc">
        用 1 分鐘品味經典巨作，以羊毛針氈定格美學解構《漫步華爾街》、《你的人生，他們六個說了算！》等底層心智與投資科學。
      </p>

      <div class="videos-hero-actions">
        <div class="hero-stats">
          <div class="stat-pill">
            <span>收錄影片</span>
            <strong>{bookVideos.length} 部</strong>
          </div>
          <div class="stat-pill">
            <span>導讀書目</span>
            <strong>{bookCategories.length - 1} 本經典</strong>
          </div>
        </div>
      </div>
    </header>

    <!-- ════════════ 雙態次分類過濾列 ════════════ -->
    <!-- [1] 醫學短影音次分類 -->
    <section class="video-filter-section filter-medical active" id="filter-medical" aria-label="醫學影片分類篩選">
      <div class="filter-pills-wrap">
        {medicalCategories.map((cat, index) => (
          <button
            type="button"
            class:list={['filter-pill', { active: index === 0 }]}
            data-section="medical"
            data-category={cat}
          >
            <span>{cat}</span>
            <span class="count-bubble">{medicalCategoryCounts[cat] || 0}</span>
          </button>
        ))}
      </div>
    </section>

    <!-- [2] 讀書短影音次分類 -->
    <section class="video-filter-section filter-book" id="filter-book" aria-label="讀書影片分類篩選">
      <div class="filter-pills-wrap">
        {bookCategories.map((cat, index) => (
          <button
            type="button"
            class:list={['filter-pill', { active: index === 0 }]}
            data-section="book"
            data-category={cat}
          >
            <span>{cat}</span>
            <span class="count-bubble">{bookCategoryCounts[cat] || 0}</span>
          </button>
        ))}
      </div>
    </section>

    <!-- ════════════ 影片網格列表 ════════════ -->
    <section class="videos-grid-section">
      <div class="videos-grid" id="videos-grid">
        {videos.map((video) => {
          const sec = getVideoSectionType(video.category);
          return (
            <div class="video-grid-item" data-section={sec} data-category={video.category}>
              <VideoCard video={video} />
            </div>
          );
        })}
      </div>

      <!-- 查無結果提示 -->
      <div id="no-videos-match" class="no-videos-message" style="display: none;">
        <p>此分類目前尚無收錄影片，敬請期待陸續上線！</p>
      </div>
    </section>

    <!-- ════════════ 雙態底部導引卡片 ════════════ -->
    <!-- [1] 醫學分頁專屬導引卡片 -->
    <section class="channel-callout-card callout-medical active" id="callout-medical">
      <div class="callout-inner">
        <div class="callout-text">
          <h3>想要更深入的醫學衛教文章？</h3>
          <p>除了短影音外，黃冠智醫師親自撰寫的長篇衛教專欄已同步上線，包含最新降血脂藥物、胃食道逆流及內視鏡深度解析。</p>
        </div>
        <div class="callout-actions">
          <a href="/health-column" class="btn-primary">
            <span>閱讀醫學專欄筆記</span>
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
          </a>
        </div>
      </div>
    </section>

    <!-- [2] 讀書分頁專屬導引卡片 -->
    <section class="channel-callout-card callout-book" id="callout-book">
      <div class="callout-inner">
        <div class="callout-text">
          <h3>想要閱讀完整的讀書筆記與精華書摘？</h3>
          <p>從《漫步華爾街》的漫步投資哲學到大腦神經科學，黃冠智醫師親自整理的讀書筆記專區已完整收錄，包含章節解析與實踐心法。</p>
        </div>
        <div class="callout-actions">
          <a href="/books" class="btn-primary btn-book-primary">
            <span>探索讀書筆記庫</span>
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
          </a>
        </div>
      </div>
    </section>
  </div>

  <!-- 沉浸式燈箱彈窗播放器 -->
  <VideoModal />
</Layout>

<script>
  function initDualTrackVideos() {
    const trackTabs = document.querySelectorAll<HTMLButtonElement>('.track-tab');
    const heroMedical = document.getElementById('hero-medical');
    const heroBook = document.getElementById('hero-book');
    const filterMedical = document.getElementById('filter-medical');
    const filterBook = document.getElementById('filter-book');
    const calloutMedical = document.getElementById('callout-medical');
    const calloutBook = document.getElementById('callout-book');
    const filterButtons = document.querySelectorAll<HTMLButtonElement>('.filter-pill');
    const items = document.querySelectorAll<HTMLElement>('.video-grid-item');
    const noResults = document.getElementById('no-videos-match');

    let currentSection: 'medical' | 'book' = 'medical';
    let currentCategory = '全部';

    function updateView() {
      // 1. 切換 Hero
      if (heroMedical && heroBook) {
        if (currentSection === 'medical') {
          heroMedical.classList.add('active');
          heroBook.classList.remove('active');
        } else {
          heroMedical.classList.remove('active');
          heroBook.classList.add('active');
        }
      }

      // 2. 切換次分類篩選器
      if (filterMedical && filterBook) {
        if (currentSection === 'medical') {
          filterMedical.classList.add('active');
          filterBook.classList.remove('active');
        } else {
          filterMedical.classList.remove('active');
          filterBook.classList.add('active');
        }
      }

      // 3. 切換底部導引卡片
      if (calloutMedical && calloutBook) {
        if (currentSection === 'medical') {
          calloutMedical.classList.add('active');
          calloutBook.classList.remove('active');
        } else {
          calloutMedical.classList.remove('active');
          calloutBook.classList.add('active');
        }
      }

      // 4. 切換軌道按鈕 active 樣式
      trackTabs.forEach((tab) => {
        const isTarget = tab.dataset.targetSection === currentSection;
        tab.classList.toggle('active', isTarget);
        tab.setAttribute('aria-selected', isTarget ? 'true' : 'false');
      });

      // 5. 過濾影片網格
      let visibleCount = 0;
      items.forEach((item) => {
        const itemSection = item.dataset.section;
        const itemCat = item.dataset.category;

        if (itemSection === currentSection && (currentCategory === '全部' || itemCat === currentCategory)) {
          item.style.display = 'block';
          item.classList.remove('fade-in');
          void item.offsetWidth; // 強制重繪觸發動畫
          item.classList.add('fade-in');
          visibleCount++;
        } else {
          item.style.display = 'none';
        }
      });

      if (noResults) {
        noResults.style.display = visibleCount === 0 ? 'block' : 'none';
      }
    }

    // 監聽軌道切換
    trackTabs.forEach((tab) => {
      tab.addEventListener('click', () => {
        const targetSec = tab.dataset.targetSection as 'medical' | 'book';
        if (targetSec === currentSection) return;

        currentSection = targetSec;
        currentCategory = '全部'; // 切換軌道時次分類重設為「全部」

        // 重設對應次分類按鈕 active 狀態
        filterButtons.forEach((btn) => {
          if (btn.dataset.section === currentSection) {
            btn.classList.toggle('active', btn.dataset.category === '全部');
          }
        });

        // 同步 URL 參數
        const url = new URL(window.location.href);
        url.searchParams.set('tab', currentSection === 'book' ? 'books' : 'medical');
        window.history.replaceState({}, '', url.toString());

        updateView();
      });
    });

    // 監聽次分類按鈕切換
    filterButtons.forEach((btn) => {
      btn.addEventListener('click', () => {
        const btnSec = btn.dataset.section;
        if (btnSec !== currentSection) return;

        // 更新同軌道按鈕 active
        filterButtons.forEach((b) => {
          if (b.dataset.section === currentSection) {
            b.classList.remove('active');
          }
        });
        btn.classList.add('active');

        currentCategory = btn.dataset.category || '全部';
        updateView();
      });
    });

    // 讀取 URL 參數預設切換 (支援 ?tab=books, ?tab=book, ?section=books, #books)
    const urlParams = new URLSearchParams(window.location.search);
    const tabParam = urlParams.get('tab') || urlParams.get('section') || window.location.hash.replace('#', '');
    if (tabParam === 'books' || tabParam === 'book' || tabParam === 'reading') {
      currentSection = 'book';
      currentCategory = '全部';
      filterButtons.forEach((btn) => {
        if (btn.dataset.section === 'book') {
          btn.classList.toggle('active', btn.dataset.category === '全部');
        }
      });
    }

    updateView();
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initDualTrackVideos);
  } else {
    initDualTrackVideos();
  }
</script>

<style>
  /* ═══════════════════════════════════════
     Videos 專頁樣式
  ═══════════════════════════════════════ */
  .videos-page-container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 2rem 1.5rem 5rem 1.5rem;
    box-sizing: border-box;
    width: 100%;
    overflow-x: hidden;
  }

  .text-desktop {
    display: inline;
  }
  .text-mobile {
    display: none;
  }

  /* 頂部雙軌切換 Segmented Control (Capsule Nav) */
  .dual-track-wrapper {
    display: flex;
    justify-content: center;
    margin-bottom: 2rem;
  }

  .dual-track-nav {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 6px;
    background: rgba(17, 21, 28, 0.85);
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 9999px;
    box-shadow: 0 16px 36px rgba(0, 0, 0, 0.5), inset 0 1px 1px rgba(255, 255, 255, 0.08);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
  }

  .track-tab {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 10px 22px;
    border-radius: 9999px;
    border: 1px solid transparent;
    background: transparent;
    color: #94a3b8;
    font-size: 0.98rem;
    font-weight: 700;
    cursor: pointer;
    transition: all 0.25s cubic-bezier(0.34, 1.56, 0.64, 1);
    white-space: nowrap;
    text-decoration: none;
  }

  .track-tab:hover {
    color: #ffffff;
    background: rgba(255, 255, 255, 0.06);
  }

  .track-tab.active {
    background: 
      radial-gradient(circle at 50% 20%, rgba(255, 255, 255, 0.95) 0%, rgba(255, 255, 255, 0) 65%),
      linear-gradient(180deg, #ffffff 0%, #e2e8f0 25%, #cbd5e1 55%, #f8fafc 80%, #94a3b8 100%);
    border: 1px solid #ffffff;
    color: #090b0e;
    font-weight: 800;
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.4), 0 0 20px rgba(255, 255, 255, 0.35);
  }

  .track-tab-icon {
    font-size: 1.15rem;
    line-height: 1;
  }

  .track-tab-count {
    font-size: 0.78rem;
    padding: 2px 8px;
    border-radius: 9999px;
    background: rgba(255, 255, 255, 0.08);
    color: #94a3b8;
  }

  .track-tab.active .track-tab-count {
    background: rgba(9, 11, 14, 0.16);
    color: #090b0e;
    font-weight: 800;
  }

  /* 頁面 Hero */
  .videos-hero {
    display: none; /* 由 JS 依 active 狀態切換 */
    position: relative;
    background-color: #090b0f;
    background-image: 
      radial-gradient(1100px 520px at 50% -80px, rgba(148, 163, 184, 0.12), transparent 70%),
      radial-gradient(rgba(255, 255, 255, 0.06) 1px, transparent 1px);
    background-size: 100% 100%, 32px 32px;
    border-radius: 28px;
    border: 1px solid rgba(255, 255, 255, 0.1);
    box-shadow: 0 24px 60px -12px rgba(0, 0, 0, 0.7), inset 0 1px 1px rgba(255, 255, 255, 0.1);
    padding: 42px 32px 46px;
    margin-bottom: 32px;
    overflow: hidden;
    isolation: isolate;
    text-align: center;
    max-width: 900px;
    margin-left: auto;
    margin-right: auto;
    flex-direction: column;
    align-items: center;
  }

  .videos-hero.active {
    display: flex;
    animation: heroFadeIn 0.35s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }

  @keyframes heroFadeIn {
    from {
      opacity: 0;
      transform: translateY(12px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .ambient-mesh-glow {
    position: absolute;
    top: -100px;
    right: 10%;
    width: 450px;
    height: 450px;
    filter: blur(60px);
    pointer-events: none;
    z-index: 0;
  }

  .medical-glow {
    background: radial-gradient(circle, rgba(16, 185, 129, 0.15) 0%, rgba(56, 189, 248, 0.06) 50%, transparent 70%);
  }

  .book-glow {
    background: radial-gradient(circle, rgba(245, 158, 11, 0.18) 0%, rgba(217, 119, 6, 0.08) 50%, transparent 70%);
  }

  .header-eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 5px 14px;
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.14);
    border-radius: 9999px;
    color: #94a3b8;
    font-size: 0.76rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    box-shadow: inset 0 1px 1px rgba(255, 255, 255, 0.06);
    margin-bottom: 12px;
  }

  .eyebrow-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #10b981;
    box-shadow: 0 0 8px #10b981;
  }

  .eyebrow-dot.book-dot {
    background: #f59e0b;
    box-shadow: 0 0 8px #f59e0b;
  }

  .eyebrow-pill {
    padding: 2px 7px;
    border-radius: 999px;
    background: linear-gradient(135deg, #ffffff 0%, #cbd5e1 100%);
    color: #090b0e;
    font-size: 0.68rem;
    font-weight: 800;
    letter-spacing: 0.06em;
  }

  .eyebrow-pill.book-pill {
    background: linear-gradient(135deg, #fef3c7 0%, #fde68a 100%);
    color: #78350f;
  }

  .videos-hero-title {
    font-size: 2.75rem;
    font-weight: 900;
    letter-spacing: -0.02em;
    line-height: 1.25;
    margin-bottom: 1rem;
  }

  .text-steel {
    background: linear-gradient(135deg, #ffffff 0%, #cbd5e1 50%, #94a3b8 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    font-weight: 800;
    margin-right: 6px;
  }

  .text-chrome {
    background: linear-gradient(135deg, 
      #ffffff 0%, 
      #f8fafc 24%, 
      #e2e8f0 44%, 
      #94a3b8 58%, 
      #cbd5e1 74%, 
      #ffffff 88%, 
      #a0aec0 100%
    );
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    filter: drop-shadow(0 2px 12px rgba(255, 255, 255, 0.15));
    font-weight: 900;
  }

  .text-chrome-gold {
    background: linear-gradient(135deg, 
      #ffffff 0%, 
      #fef3c7 24%, 
      #fde68a 44%, 
      #d97706 58%, 
      #fcd34d 74%, 
      #ffffff 88%, 
      #b45309 100%
    );
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    filter: drop-shadow(0 2px 12px rgba(245, 158, 11, 0.25));
    font-weight: 900;
  }

  .videos-hero-desc {
    font-size: 1.125rem;
    color: #94a3b8;
    line-height: 1.8;
    max-width: 760px;
    margin: 0 auto 1.5rem auto;
  }

  .videos-hero-actions {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.5rem;
  }

  .hero-stats {
    display: flex;
    align-items: center;
    gap: 1rem;
    flex-wrap: wrap;
    justify-content: center;
  }

  .stat-pill {
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.1);
    padding: 0.45rem 1rem;
    border-radius: 9999px;
    font-size: 0.85rem;
    color: #94a3b8;
    display: flex;
    align-items: center;
    gap: 0.4rem;
  }

  .stat-pill strong {
    font-size: 1.05rem;
    color: #ffffff;
    font-weight: 800;
  }

