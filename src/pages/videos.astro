---
import Layout from '../layouts/Layout.astro';
import VideoCard from '../components/VideoCard.astro';
import VideoModal from '../components/VideoModal.astro';
import { videos, videoCategories } from '../data/videos';

// 計算各分類數量
const categoryCounts = videoCategories.reduce((acc, cat) => {
  if (cat === '全部') {
    acc[cat] = videos.length;
  } else {
    acc[cat] = videos.filter((v) => v.category === cat).length;
  }
  return acc;
}, {} as Record<string, number>);
---

<Layout
  title="動物農莊衛教短影音｜黃冠智醫師 肝膽腸胃科"
  meta_title="動物農莊衛教短影音｜黃冠智醫師｜一分鐘看懂腸胃疾病與內視鏡衛教"
  description="黃冠智醫師「動物農莊衛教短影音」，邀請動物界專科醫師出診，用精簡生動的實證短片為您解構常見腸胃疾病、內視鏡檢查與代謝保健。"
>
  <div class="videos-page-container">
    <!-- 影音專區專屬頂部 Hero Banner (Obsidian & Liquid Chrome Style) -->
    <header class="videos-hero">
      <div class="ambient-mesh-glow" aria-hidden="true"></div>
      <div class="header-eyebrow">
        <span class="eyebrow-dot"></span>
        <span>YOUTUBE CLINICAL SERIES</span>
        <span class="eyebrow-pill">衛教短影音</span>
      </div>

      <h1 class="videos-hero-title">
        <span class="text-steel">動物農莊</span>
        <span class="text-chrome">衛教短影音</span>
      </h1>
      
      <p class="videos-hero-desc">
        我們特別邀請動物界的各科專科醫師出診！用精簡生動的實證短片，為您深入講解常見腸胃疾病、內視鏡檢查與代謝保健，輕鬆簡單就能守護健康。
      </p>

      <!-- 旗艦專題特輯入口卡片 (黑曜岩鈦金框) -->
      <a href="/weight-loss" class="special-topic-hero-card" aria-label="前往健康享瘦專頁">
        <div class="special-card-left">
          <div class="special-badge">
            <span class="sparkle">✦</span>
            <span>旗艦專題特輯</span>
          </div>
          <h2 class="special-title">健康享瘦：瘦瘦針、飲食與運動</h2>
          <p class="special-desc">以 2026 ADA 指南、GLP-1 腸泌素科學用藥、真食物原則與 ACSM 運動處方，完整 15 部實證影音闖關地圖</p>
        </div>
        <div class="special-card-right">
          <span class="btn-enter-special">進入通關地圖 →</span>
        </div>
      </a>
    </header>

    <!-- 分類過濾篩選器 (Tabs) -->
    <section class="video-filter-section" aria-label="影片分類篩選">
      <div class="filter-pills-wrap">
        {videoCategories.map((cat, index) => (
          <button
            type="button"
            class:list={['filter-pill', { active: index === 0 }]}
            data-category={cat}
          >
            <span>{cat}</span>
            <span class="count-bubble">{categoryCounts[cat] || 0}</span>
          </button>
        ))}
      </div>
    </section>

    <!-- 影片網格列表 -->
    <section class="videos-grid-section">
      <div class="videos-grid" id="videos-grid">
        {videos.map((video) => (
          <div class="video-grid-item" data-category={video.category}>
            <VideoCard video={video} />
          </div>
        ))}
      </div>

      <!-- 查無結果提示 (預留) -->
      <div id="no-videos-match" class="no-videos-message" style="display: none;">
        <p>此分類目前尚無收錄影片，敬請期待陸續上線！</p>
      </div>
    </section>

    <!-- 底部資訊導引卡片 -->
    <section class="channel-callout-card">
      <div class="callout-inner">
        <div class="callout-text">
          <h3>想要更深入的醫學衛教文章？</h3>
          <p>除了短影音外，黃冠智醫師親自撰寫的長篇衛教專欄已同步上線，包含最新降血脂藥物、胃食道逆流及內視鏡深度解析。</p>
        </div>
        <div class="callout-actions">
          <a href="/health-column" class="btn-primary">
            <span>閱讀醫學專欄筆記</span>
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
          </a>
        </div>
      </div>
    </section>
  </div>

  <!-- 沉浸式燈箱彈窗播放器 -->
  <VideoModal />
</Layout>

<script>
  // 分類篩選邏輯
  function initCategoryFilter() {
    const filterButtons = document.querySelectorAll<HTMLButtonElement>('.filter-pill');
    const items = document.querySelectorAll<HTMLElement>('.video-grid-item');
    const noResults = document.getElementById('no-videos-match');

    filterButtons.forEach((btn) => {
      btn.addEventListener('click', () => {
        // 更新按鈕 active 樣式
        filterButtons.forEach((b) => b.classList.remove('active'));
        btn.classList.add('active');

        const selectedCat = btn.dataset.category || '全部';
        let visibleCount = 0;

        items.forEach((item) => {
          const itemCat = item.dataset.category;
          if (selectedCat === '全部' || itemCat === selectedCat) {
            item.style.display = 'block';
            item.classList.add('fade-in');
            visibleCount++;
          } else {
            item.style.display = 'none';
          }
        });

        if (noResults) {
          noResults.style.display = visibleCount === 0 ? 'block' : 'none';
        }
      });
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initCategoryFilter);
  } else {
    initCategoryFilter();
  }
</script>

<style>
  /* ═══════════════════════════════════════
     Videos 專頁樣式
  ═══════════════════════════════════════ */
  .videos-page-container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 2.5rem 1.5rem 5rem 1.5rem;
  }

  /* 頁面 Hero */
  .videos-hero {
    text-align: center;
    max-width: 800px;
    margin: 0 auto 3rem auto;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .videos-hero-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.82rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    color: var(--color-primary-dark, #3b7688);
    background: var(--color-primary-light, #eef7f9);
    border: 1px solid rgba(74, 144, 164, 0.25);
    padding: 0.35rem 1rem;
    border-radius: var(--radius-full, 9999px);
    margin-bottom: 1.25rem;
  }

  .pulse-dot {
    width: 8px;
    height: 8px;
    background: #e76f51;
    border-radius: 50%;
    box-shadow: 0 0 0 0 rgba(231, 111, 81, 0.7);
    animation: pulse 1.8s infinite;
  }

  @keyframes pulse {
    0% {
      transform: scale(0.95);
      box-shadow: 0 0 0 0 rgba(231, 111, 81, 0.7);
    }
    70% {
      transform: scale(1);
      box-shadow: 0 0 0 8px rgba(231, 111, 81, 0);
    }
    100% {
      transform: scale(0.95);
      box-shadow: 0 0 0 0 rgba(231, 111, 81, 0);
    }
  }

  .videos-hero-title {
    font-size: 2.75rem;
    font-weight: 900;
    color: var(--color-text-title, #1e3a4c);
    letter-spacing: -0.02em;
    line-height: 1.25;
    margin-bottom: 1rem;
  }

  .gradient-text {
    background: linear-gradient(135deg, var(--color-primary, #4a90a4) 0%, var(--color-secondary, #6bb5a2) 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .videos-hero-desc {
    font-size: 1.125rem;
    color: var(--color-text-body, #2d4f63);
    line-height: 1.8;
    max-width: 760px;
    margin: 0 auto 1.5rem auto;
    opacity: 0.9;
  }

  /* 旗艦專題特輯入口卡片 */
  .special-topic-hero-card {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    width: 100%;
    max-width: 820px;
    background: linear-gradient(135deg, #f0fdf4 0%, #e6f8f3 50%, #e0f2fe 100%);
    border: 1.5px solid rgba(16, 185, 129, 0.35);
    border-radius: 20px;
    padding: 20px 28px;
    text-decoration: none;
    box-shadow: 0 8px 24px rgba(16, 185, 129, 0.1);
    transition: all 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
    text-align: left;
    margin-top: 0.5rem;
  }
  .special-topic-hero-card:hover {
    transform: translateY(-3px);
    box-shadow: 0 12px 32px rgba(16, 185, 129, 0.2);
    border-color: #10b981;
  }
  .special-badge {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    background: #10b981;
    color: #ffffff;
    font-size: 0.76rem;
    font-weight: 800;
    padding: 2px 10px;
    border-radius: 9999px;
    margin-bottom: 6px;
    letter-spacing: 0.05em;
  }
  .special-title {
    font-size: 1.25rem;
    font-weight: 900;
    color: #065f46;
    margin: 0 0 4px 0;
    line-height: 1.35;
  }
  .special-desc {
    font-size: 0.9rem;
    color: #334155;
    margin: 0;
    line-height: 1.55;
  }
  .special-card-right {
    flex-shrink: 0;
  }
  .btn-enter-special {
    display: inline-flex;
    align-items: center;
    background: #059669;
    color: #ffffff;
    font-size: 0.88rem;
    font-weight: 800;
    padding: 8px 18px;
    border-radius: 9999px;
    box-shadow: 0 2px 8px rgba(5, 150, 105, 0.3);
    white-space: nowrap;
    transition: all 0.2s ease;
  }
  .special-topic-hero-card:hover .btn-enter-special {
    background: #047857;
    transform: scale(1.05);
  }
  @media (max-width: 768px) {
    .special-topic-hero-card {
      flex-direction: column;
      align-items: flex-start;
      padding: 16px;
      gap: 12px;
    }
    .special-title {
      font-size: 1.1rem;
    }
    .special-card-right {
      width: 100%;
    }
    .btn-enter-special {
      width: 100%;
      justify-content: center;
    }
  }

  .videos-hero-actions {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.5rem;
  }

  .hero-stats {
    display: flex;
    align-items: center;
    gap: 1rem;
    flex-wrap: wrap;
    justify-content: center;
  }

  .stat-pill {
    background: #ffffff;
    border: 1px solid var(--color-border, #d4e5eb);
    padding: 0.45rem 1rem;
    border-radius: var(--radius-full, 9999px);
    font-size: 0.85rem;
    color: var(--color-text-body, #2d4f63);
    display: flex;
    align-items: center;
    gap: 0.4rem;
    box-shadow: 0 2px 8px rgba(74, 144, 164, 0.05);
  }

  .stat-pill strong {
    font-size: 1.05rem;
    color: var(--color-primary-dark, #3b7688);
    font-weight: 800;
  }

  .btn-youtube-subscribe {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    background: #ff0000;
    color: #ffffff;
    padding: 0.8rem 1.6rem;
    border-radius: var(--radius-full, 9999px);
    font-weight: 800;
    font-size: 0.95rem;
    text-decoration: none;
    box-shadow: 0 8px 20px rgba(255, 0, 0, 0.28);
    transition: transform 0.25s cubic-bezier(0.34, 1.56, 0.64, 1), box-shadow 0.25s ease;
  }

  .btn-youtube-subscribe:hover {
    transform: translateY(-2px);
    box-shadow: 0 12px 28px rgba(255, 0, 0, 0.4);
    background: #e60000;
  }

  /* 篩選器 */
  .video-filter-section {
    margin-bottom: 2.5rem;
  }

  .filter-pills-wrap {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.65rem;
    flex-wrap: wrap;
  }

  .filter-pill {
    background: #ffffff;
    border: 1.5px solid var(--color-border, #d4e5eb);
    color: var(--color-text-body, #2d4f63);
    padding: 0.45rem 1rem;
    border-radius: var(--radius-full, 9999px);
    font-size: 0.9rem;
    font-weight: 700;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    transition: all 0.2s cubic-bezier(0.16, 1, 0.3, 1);
    box-shadow: 0 2px 6px rgba(74, 144, 164, 0.04);
  }

  .filter-pill:hover {
    border-color: var(--color-primary, #4a90a4);
    color: var(--color-primary-dark, #3b7688);
    background: var(--color-primary-light, #eef7f9);
    transform: translateY(-1px);
  }

  .filter-pill.active {
    background: var(--color-primary-dark, #3b7688);
    border-color: var(--color-primary-dark, #3b7688);
    color: #ffffff;
    box-shadow: 0 4px 14px rgba(59, 118, 136, 0.3);
  }

  .count-bubble {
    font-size: 0.75rem;
    background: rgba(0, 0, 0, 0.08);
    padding: 0.1rem 0.45rem;
    border-radius: 9999px;
  }

  .filter-pill.active .count-bubble {
    background: rgba(255, 255, 255, 0.25);
    color: #ffffff;
  }

  /* 影片網格 */
  .videos-grid-section {
    margin-bottom: 4rem;
  }

  .videos-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
    gap: 1.75rem;
  }

  .video-grid-item.fade-in {
    animation: itemFade 0.35s ease forwards;
  }

  @keyframes itemFade {
    from {
      opacity: 0;
      transform: translateY(10px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .no-videos-message {
    text-align: center;
    padding: 3rem 1.5rem;
    background: #ffffff;
    border-radius: var(--radius-md, 14px);
    border: 1px dashed var(--color-border, #d4e5eb);
    color: var(--color-text-muted, #5a7a8a);
  }

  /* 底部導引卡片 */
  .channel-callout-card {
    background: linear-gradient(135deg, #eef7f9 0%, #edf7f4 100%);
    border: 1px solid var(--color-border, #d4e5eb);
    border-radius: var(--radius-lg, 20px);
    padding: 2.25rem;
    box-shadow: 0 10px 30px rgba(74, 144, 164, 0.08);
  }

  .callout-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
  }

  .callout-text h3 {
    font-size: 1.4rem;
    font-weight: 800;
    color: var(--color-text-title, #1e3a4c);
    margin-bottom: 0.5rem;
  }

  .callout-text p {
    font-size: 0.95rem;
    color: var(--color-text-body, #2d4f63);
    line-height: 1.7;
    margin: 0;
    max-width: 680px;
  }

  .callout-actions {
    flex-shrink: 0;
  }

  .btn-primary {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    background: var(--color-primary-dark, #3b7688);
    color: #ffffff;
    padding: 0.8rem 1.5rem;
    border-radius: var(--radius-full, 9999px);
    font-weight: 700;
    font-size: 0.95rem;
    text-decoration: none;
    transition: all 0.25s ease;
    box-shadow: 0 4px 12px rgba(59, 118, 136, 0.25);
  }

  .btn-primary:hover {
    background: var(--color-primary, #4a90a4);
    transform: translateY(-2px);
    box-shadow: 0 8px 20px rgba(74, 144, 164, 0.35);
  }

  @media (max-width: 768px) {
    .videos-page-container {
      padding: 1.25rem 0.85rem 3.5rem 0.85rem;
    }
    .videos-hero {
      margin-bottom: 1.75rem;
    }
    .videos-hero-badge {
      font-size: 0.72rem;
      padding: 0.22rem 0.7rem;
      margin-bottom: 0.75rem;
    }
    .videos-hero-title {
      font-size: 1.8rem;
      margin-bottom: 0.5rem;
    }
    .videos-hero-desc {
      font-size: 0.92rem;
      line-height: 1.6;
      margin-bottom: 1.15rem;
      padding: 0 0.5rem;
      white-space: normal;
    }
    .videos-hero-actions {
      gap: 0.85rem;
    }
    .hero-stats {
      gap: 0.45rem;
    }
    .stat-pill {
      padding: 0.25rem 0.65rem;
      font-size: 0.76rem;
      gap: 0.3rem;
      box-shadow: 0 1px 4px rgba(74, 144, 164, 0.05);
    }
    .stat-pill strong {
      font-size: 0.88rem;
    }
    .btn-youtube-subscribe {
      padding: 0.55rem 1.15rem;
      font-size: 0.86rem;
      gap: 0.45rem;
      box-shadow: 0 4px 14px rgba(255, 0, 0, 0.2);
    }
    .video-filter-section {
      margin-bottom: 1.5rem;
    }
    .filter-pills-wrap {
      gap: 0.4rem;
    }
    .filter-pill {
      padding: 0.32rem 0.68rem;
      font-size: 0.82rem;
      gap: 0.35rem;
      border-width: 1px;
      box-shadow: 0 1px 4px rgba(74, 144, 164, 0.04);
    }
    .count-bubble {
      font-size: 0.68rem;
      padding: 0.05rem 0.35rem;
    }
    .videos-grid {
      grid-template-columns: 1fr;
    }
    .callout-inner {
      flex-direction: column;
      align-items: flex-start;
      gap: 1.25rem;
    }
  }

  /* ================================================================
     UI/UX Pro Max — Obsidian & Liquid Chrome Styles for Videos Page
     ================================================================ */
  .videos-hero {
    position: relative;
    background-color: #090B0F !important;
    background-image: 
      radial-gradient(1100px 520px at 50% -80px, rgba(148, 163, 184, 0.12), transparent 70%),
      radial-gradient(rgba(255, 255, 255, 0.06) 1px, transparent 1px) !important;
    background-size: 100% 100%, 32px 32px !important;
    border-radius: 28px !important;
    border: 1px solid rgba(255, 255, 255, 0.1) !important;
    box-shadow: 0 24px 60px -12px rgba(0, 0, 0, 0.7), inset 0 1px 1px rgba(255, 255, 255, 0.1) !important;
    padding: 42px 32px 46px !important;
    margin-bottom: 32px !important;
    overflow: hidden;
    isolation: isolate;
  }

  .ambient-mesh-glow {
    position: absolute;
    top: -100px;
    right: 10%;
    width: 450px;
    height: 450px;
    background: radial-gradient(circle, rgba(16, 185, 129, 0.12) 0%, rgba(56, 189, 248, 0.05) 50%, transparent 70%);
    filter: blur(60px);
    pointer-events: none;
    z-index: 0;
  }

  .header-eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 5px 14px;
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.14);
    border-radius: 9999px;
    color: #94A3B8;
    font-size: 0.76rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    box-shadow: inset 0 1px 1px rgba(255, 255, 255, 0.06);
    margin-bottom: 12px;
  }
  .eyebrow-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #10B981;
    box-shadow: 0 0 8px #10B981;
  }
  .eyebrow-pill {
    padding: 2px 7px;
    border-radius: 999px;
    background: linear-gradient(135deg, #FFFFFF 0%, #CBD5E1 100%);
    color: #090B0E;
    font-size: 0.68rem;
    font-weight: 800;
    letter-spacing: 0.06em;
  }

  .text-steel {
    background: linear-gradient(135deg, #FFFFFF 0%, #CBD5E1 50%, #94A3B8 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    font-weight: 800;
    margin-right: 6px;
  }
  .text-chrome {
    background: linear-gradient(135deg, 
      #FFFFFF 0%, 
      #F8FAFC 24%, 
      #E2E8F0 44%, 
      #94A3B8 58%, 
      #CBD5E1 74%, 
      #FFFFFF 88%, 
      #A0AEC0 100%
    );
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    filter: drop-shadow(0 2px 12px rgba(255, 255, 255, 0.15));
    font-weight: 900;
  }

  .videos-hero-desc {
    color: #94A3B8 !important;
  }

  /* 旗艦特輯卡片黑曜化 */
  .special-topic-hero-card {
    background: #11141B !important;
    border: 1px solid rgba(255, 255, 255, 0.12) !important;
    border-left: 4px solid #10B981 !important;
    border-radius: 20px !important;
    box-shadow: 0 16px 36px rgba(0, 0, 0, 0.65) !important;
    color: #FFFFFF !important;
  }
  .special-title {
    color: #FFFFFF !important;
  }
  .special-desc {
    color: #94A3B8 !important;
  }
  .btn-enter-special {
    background: 
      radial-gradient(circle at 50% 20%, rgba(255,255,255,0.95) 0%, rgba(255,255,255,0) 65%),
      linear-gradient(180deg, #FFFFFF 0%, #E2E8F0 25%, #CBD5E1 55%, #F8FAFC 80%, #94A3B8 100%) !important;
    border: 1px solid #FFFFFF !important;
    color: #0A0D12 !important;
