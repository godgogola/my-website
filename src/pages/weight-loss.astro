<script>
  // ── 播放影片觸發 ──
  function initPlayTriggers() {
    const playTriggers = document.querySelectorAll<HTMLElement>('[data-trigger-play]');
    playTriggers.forEach((el) => {
      el.addEventListener('click', (e) => {
        e.stopPropagation();
        const card = el.closest<HTMLElement>('.step-card');
        if (!card) return;

        // 觸發全域 VideoModal
        const videoId = card.dataset.videoId;
        if (videoId) {
          card.click();
        }
      });
    });
  }

  // ── 臨床方案手風琴動態畫廊與分類切換機制 ──
  function initSolutionGallery() {
    const gallery = document.getElementById('solutionsGallery');
    if (!gallery) return;

    const cards = gallery.querySelectorAll<HTMLElement>('.solution-expand-card');
    const tabBtns = document.querySelectorAll<HTMLButtonElement>('.sol-tab-btn');
    let lastActiveCard = gallery.querySelector<HTMLElement>('.solution-expand-card.is-active') || cards[0];

    function setActiveCard(targetCard: HTMLElement, isToggleAllowed: boolean = false) {
      const isMobile = window.innerWidth < 900;
      const wasActive = targetCard.classList.contains('is-active');

      if (isMobile && isToggleAllowed && wasActive) {
        // 手機版點擊已展開卡片的標題列可切換收合
        targetCard.classList.remove('is-active');
        return;
      }

      cards.forEach((c) => c.classList.remove('is-active'));
      targetCard.classList.add('is-active');
      lastActiveCard = targetCard;
    }

    // 1. 卡片懸停與點擊互動
    cards.forEach((card) => {
      // 電腦版懸停（僅實體滑鼠）
      card.addEventListener('mouseenter', () => {
        if (window.innerWidth >= 900 && window.matchMedia && window.matchMedia('(hover: hover)').matches) {
          cards.forEach((c) => c.classList.remove('is-active'));
          card.classList.add('is-active');
        }
      });

      // 點擊事件 (手機手風琴切換 / 電腦版固定選擇)
      card.addEventListener('click', (e) => {
        const target = e.target as HTMLElement;
        if (target.closest('a') || target.closest('button')) {
          return; // 點擊閱讀專文連結不攔截
        }

        const isMobile = window.innerWidth < 900;
        const isMobileBar = !!target.closest('.solution-card-mobile-bar');
        const wasActive = card.classList.contains('is-active');

        // 手機版若點擊已展開的內文區，避免誤觸關閉
        if (isMobile && wasActive && !isMobileBar) {
          return;
        }

        setActiveCard(card, isMobileBar);
      });
    });

    // 電腦版滑鼠移出畫廊時復原到最後選定的卡片
    gallery.addEventListener('mouseleave', () => {
      if (window.innerWidth >= 900 && window.matchMedia && window.matchMedia('(hover: hover)').matches) {
        cards.forEach((c) => c.classList.remove('is-active'));
        if (lastActiveCard && !lastActiveCard.classList.contains('is-hidden')) {
          lastActiveCard.classList.add('is-active');
        } else {
          const firstVisible = Array.from(cards).find((c) => !c.classList.contains('is-hidden'));
          firstVisible?.classList.add('is-active');
        }
      }
    });

    // 2. 分類篩選 Tab
    tabBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        const filter = btn.dataset.filter || 'all';

        tabBtns.forEach((b) => b.classList.remove('active'));
        btn.classList.add('active');

        let firstVisible: HTMLElement | null = null;
        let isCurrentActiveVisible = false;

        cards.forEach((card) => {
          const cat = card.dataset.solCat;
          const isMatch = filter === 'all' || cat === filter;
          if (isMatch) {
            card.classList.remove('is-hidden');
            if (!firstVisible) firstVisible = card;
            if (card.classList.contains('is-active')) isCurrentActiveVisible = true;
          } else {
            card.classList.add('is-hidden');
          }
        });

        // 若原先 active 的卡片被隱藏了，自動切換至第一個可見卡片
        if (!isCurrentActiveVisible && firstVisible) {
          setActiveCard(firstVisible);
        }
      });
    });
  }

  document.addEventListener('DOMContentLoaded', () => {
    initPlayTriggers();
    initSolutionGallery();
  });
</script>

