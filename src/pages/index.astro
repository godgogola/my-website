    width: 200px;
    aspect-ratio: 1 / 1.18;
    border-radius: 20px;
    overflow: hidden;
    box-shadow: 0 8px 24px rgba(74, 144, 164, 0.14);
    border: 2px solid var(--color-border);
    background-color: var(--color-bg-alt);
  }

  .hero-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top center;
    display: block;
    transition: transform 0.4s ease;
  }

  .about-hero:hover .hero-image {
    transform: scale(1.03);
  }

  .hero-text-content {
    flex: 1;
    display: flex;
    flex-direction: column;
    min-width: 0;
  }

  .hero-badge {
    margin-bottom: 8px;
  }

  .hero-name {
