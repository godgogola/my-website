---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';

// 取得所有未草稿的文章，並依日期排序
const allPosts = await getCollection('posts');
const latestPosts = allPosts
  .filter(post => !post.data.draft)
  .sort((a, b) => new Date(b.data.publishDate).getTime() - new Date(a.data.publishDate).getTime())
  .slice(0, 3); // 只取最新3篇

// 格式化日期
const formatDate = (date: Date) => {
  return new Date(date).toLocaleDateString('zh-TW', {
    year: 'numeric',
    month: 'long',
    day: 'numeric'
  });
};
---

<Layout title="首頁 & 關於我" description="豐田診所院長黃冠智醫師的個人網站。分享肝膽腸胃內科專業知識與個人衛教筆記。">
  <!-- 頁首海龜視覺橫幅 Banner -->
  <section class="turtle-hero-banner">
    <img src="/images/turtle-banner.jpg" alt="海龜悠遊海洋" class="banner-bg-img" />
    <div class="banner-overlay"></div>
    <div class="banner-content">
      <span class="banner-badge">🐢 海洋般寬廣的健康守護</span>
      <h1 class="banner-title">肝膽胃腸科 · 專業衛教專區</h1>
      <p class="banner-subtitle">以溫暖、細心與專業的態度，陪伴您守護腸胃與肝膽健康</p>
    </div>
  </section>

  <!-- Hero Section (關於我) -->
  <section class="about-hero">
    <div class="hero-image-wrapper">
      <img src="https://static.wixstatic.com/media/f229cb_5dcb4100d96e46e1bab7ea4cb7062215~mv2.jpg" alt="黃冠智 醫師" class="hero-image" />
    </div>
    <div class="hero-text-content">
      <h1 class="hero-name">關於 黃冠智 醫師</h1>
      <p class="hero-title">豐田診所院長 / 肝膽腸胃內科主治醫師</p>
      
      <blockquote class="hero-quote">
        「我很喜歡肝膽腸胃科，除了病史、理學及抽血檢查之外，還有超音波和胃腸鏡，可以動手幫病患找出及解決問題」
      </blockquote>

      <div class="hero-meta">
        <div class="meta-item">
          <strong>專長領域</strong>
          <span>內視鏡檢查，超音波檢查，腸胃問題，肝病追蹤，三高控制，減重，內痔結紮，勞工健檢</span>
        </div>
      </div>
    </div>
  </section>

  <!-- Profile Details (學經歷) -->
  <section class="profile-details">
    <div class="details-card">
      <div class="card-icon">
        <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 10v6M2 10l10-5 10 5-10 5z"/><path d="M6 12v5c0 2 2 3 6 3s6-1 6-3v-5"/></svg>
      </div>
      <h2>專業學歷</h2>
      <ul class="details-list">
        <li>中山醫學大學醫學系學士</li>
        <li>中華民國內科專科醫師</li>
        <li>中華民國消化內科專科醫師</li>
        <li>中華民國消化內視鏡專科醫師</li>
        <li>中華民國勞工健檢專責醫師</li>
      </ul>
    </div>

    <div class="details-card">
      <div class="card-icon">
        <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="7" width="20" height="14" rx="2" ry="2"/><path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"/></svg>
      </div>
      <h2>臨床經歷</h2>
      <ul class="details-list">
        <li>中山醫學大學附設醫院胃腸肝膽科主治醫師</li>
        <li>大里仁愛醫院/長庚醫院 消化內科內視鏡室主任</li>
        <li>大里仁愛醫院/長庚醫院 肝癌多專科診療團隊召集人</li>
        <li>現任 豐田診所 院長</li>
      </ul>
    </div>
  </section>

  <!-- Schedule Section (門診時間表) -->
  <section class="schedule-section">
    <div class="section-header">
      <h2>個人門診時間表</h2>
      <p class="section-desc">以下為黃冠智醫師的常態門診時間，如遇休診或調整，請以診所當日公告為準。</p>
    </div>

    <div class="table-container">
      <table class="schedule-table">
        <thead>
          <tr>
            <th>時段</th>
            <th>星期一</th>
            <th>星期二</th>
            <th>星期三</th>
            <th>星期四</th>
            <th>星期五</th>
            <th>星期六</th>
            <th>星期日</th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <td class="time-header">
              <strong>早上</strong>
              <span>08:30 - 12:00</span>
            </td>
            <td class="exam">檢查診</td>
            <td class="on-duty">豐田診所</td>
            <td class="exam">檢查診</td>
            <td class="on-duty">豐田診所</td>
            <td class="exam">檢查診</td>
            <td class="on-duty">豐田診所</td>
            <td class="closed">休診</td>
          </tr>
          <tr>
            <td class="time-header">
              <strong>下午</strong>
              <span>14:00 - 17:30</span>
            </td>
            <td class="on-duty">豐田診所</td>
            <td class="closed">休診</td>
            <td class="on-duty">豐田診所</td>
            <td class="external">豐田仁愛</td>
            <td class="on-duty">豐田診所</td>
            <td class="closed">休診</td>
            <td class="closed">休診</td>
          </tr>
          <tr>
            <td class="time-header">
              <strong>晚上</strong>
              <span>18:00 - 20:30</span>
            </td>
            <td class="closed">休診</td>
            <td class="closed">休診</td>
            <td class="on-duty">豐田診所</td>
            <td class="closed">休診</td>
            <td class="closed">休診</td>
            <td class="closed">休診</td>
            <td class="closed">休診</td>
          </tr>
        </tbody>
      </table>
    </div>
    
    <div class="schedule-tips">
      <p>💡 星期四下午於豐田仁愛診所看診，其餘時段均在豐田診所。「檢查診」為內視鏡檢查時段。</p>
    </div>
  </section>


  <!-- Latest Articles Section -->
  <section class="latest-articles">
    <div class="section-header">
      <h2>最新衛教文章</h2>
      <a href="/health-column" class="view-all-link">查看全部文章 →</a>
    </div>

    <div class="articles-grid">
      {latestPosts.length > 0 ? (
        latestPosts.map((post) => (
          <a href={`/posts/${post.data.slug}`} class="article-card">
            <div class="card-meta">
              <span class="card-category">{post.data.category}</span>
            </div>
            <h3 class="card-title">{post.data.title}</h3>
            <p class="card-summary">
              {post.body ? post.body.slice(0, 100).replace(/[#*`>]/g, '') + '...' : '點擊閱讀完整文章。'}
            </p>
            <span class="read-more">閱讀全文 →</span>
          </a>
        ))
      ) : (
        <div class="empty-articles">
          <p>目前尚無文章，請設定並同步您的 Obsidian 筆記！</p>
        </div>
      )}
    </div>
  </section>

  <!-- 豐田診所 · 門診資訊與就醫指引專區 -->
  <section class="clinic-info-section" aria-labelledby="clinic-section-title">
    <div class="clinic-section-header">
      <span class="clinic-section-badge">就醫指引</span>
      <h2 id="clinic-section-title" class="clinic-section-title">豐田診所 · 門診資訊</h2>
      <p class="clinic-section-desc">歡迎來電或透過 LINE 預約掛號，我們將竭誠為您服務</p>
    </div>

    <div class="clinic-cards-row">
      <!-- 左欄：診所基本資訊 -->
      <div class="clinic-info-card">
        <div class="clinic-card-icon-wrap">
          <svg viewBox="0 0 32 32" width="28" height="28" fill="none" aria-hidden="true">
            <rect x="4" y="8" width="24" height="20" rx="3" stroke="currentColor" stroke-width="2"/>
            <path d="M10 8V5a2 2 0 0 1 2-2h8a2 2 0 0 1 2 2v3" stroke="currentColor" stroke-width="2"/>
            <path d="M16 14v6M13 17h6" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
          </svg>
        </div>
        <h3 class="clinic-card-name">🏥 豐田診所 <span class="clinic-name-en">Toyoda Clinic</span></h3>

        <ul class="clinic-detail-list">
          <li class="clinic-detail-item">
            <span class="clinic-detail-icon" aria-hidden="true">
              <svg viewBox="0 0 20 20" width="16" height="16" fill="none">
                <path d="M10 1C6.686 1 4 3.686 4 7c0 4.418 6 12 6 12s6-7.582 6-12c0-3.314-2.686-6-6-6z" stroke="currentColor" stroke-width="1.6"/>
                <circle cx="10" cy="7" r="2" stroke="currentColor" stroke-width="1.6"/>
              </svg>
            </span>
            <div>
              <span class="clinic-detail-label">診所地址</span>
              <a
                href="https://maps.google.com/?q=台中市南區建成路1848號"
                target="_blank"
                rel="noopener noreferrer"
                class="clinic-detail-value clinic-map-link"
              >
                台中市南區建成路1848號
                <svg viewBox="0 0 12 12" width="11" height="11" fill="none" aria-label="開啟 Google 地圖">
                  <path d="M2 2h8v8M10 2 2 10" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
                </svg>
              </a>
            </div>
          </li>
          <li class="clinic-detail-item">
            <span class="clinic-detail-icon" aria-hidden="true">
              <svg viewBox="0 0 20 20" width="16" height="16" fill="none">
                <path d="M3 3.5A1.5 1.5 0 0 1 4.5 2h1.879a.5.5 0 0 1 .471.337l1 2.8a.5.5 0 0 1-.156.554L6.5 6.7a9.006 9.006 0 0 0 6.8 6.8l1.009-1.194a.5.5 0 0 1 .554-.156l2.8 1a.5.5 0 0 1 .337.471V15.5A1.5 1.5 0 0 1 16.5 17C9.044 17 3 10.956 3 3.5z" stroke="currentColor" stroke-width="1.6"/>
              </svg>
            </span>
            <div>
              <span class="clinic-detail-label">診所電話</span>
              <a href="tel:+886422850066" class="clinic-detail-value clinic-phone-link">
                (04) 2285-0066
              </a>
            </div>
          </li>
          <li class="clinic-detail-item">
            <span class="clinic-detail-icon" aria-hidden="true">
              <svg viewBox="0 0 20 20" width="16" height="16" fill="none">
                <rect x="2" y="4" width="16" height="12" rx="2" stroke="currentColor" stroke-width="1.6"/>
                <path d="M2 8l8 5 8-5" stroke="currentColor" stroke-width="1.6"/>
              </svg>
            </span>
            <div>
              <span class="clinic-detail-label">醫師門診時間</span>
              <span class="clinic-detail-value">週一至週六（請見上方時間表）</span>
            </div>
          </li>
        </ul>
      </div>

      <!-- 右欄：LINE 掛號預約 -->
      <div class="clinic-line-card">
        <div class="line-card-inner">
          <div class="line-icon-ring">
            <svg viewBox="0 0 40 40" width="40" height="40" fill="none" aria-hidden="true">
              <circle cx="20" cy="20" r="20" fill="#06C755"/>
              <path d="M20 8C13.373 8 8 12.477 8 18c0 3.48 2.093 6.545 5.28 8.432-.234.857-.881 3.115-.993 3.568 0 0 1.136-.45 4.374-2.26A14.91 14.91 0 0 0 20 28c6.627 0 12-4.477 12-10S26.627 8 20 8z" fill="white"/>
              <path d="M15.5 20.5h2M18.5 20.5h2M21.5 20.5h2" stroke="#06C755" stroke-width="2" stroke-linecap="round"/>
            </svg>
          </div>
          <h3 class="line-card-title">立即預約掛號</h3>
          <p class="line-card-desc">
            透過 LINE 官方帳號預約，隨時隨地輕鬆安排就診，不需電話等候。
          </p>
          <a
            href="https://lin.ee/u3yRD2d"
            target="_blank"
            rel="noopener noreferrer"
            class="line-booking-btn"
            id="clinic-line-booking-btn"
            aria-label="透過 LINE 預約豐田診所掛號"
          >
            <svg viewBox="0 0 24 24" width="20" height="20" fill="white" aria-hidden="true">
              <path d="M19.365 9.863c.349 0 .63.285.63.631 0 .345-.281.63-.63.63H17.61v1.125h1.755c.349 0 .63.283.63.63 0 .344-.281.629-.63.629h-2.386c-.345 0-.627-.285-.627-.629V8.108c0-.345.282-.63.63-.63h2.386c.346 0 .627.285.627.63 0 .349-.281.63-.63.63H17.61v1.125h1.755zm-3.855 3.016c0 .27-.174.51-.432.596-.064.021-.133.031-.199.031-.211 0-.391-.09-.51-.25l-2.443-3.317v2.94c0 .344-.279.629-.631.629-.346 0-.626-.285-.626-.629V8.108c0-.27.173-.51.43-.595.06-.023.136-.033.194-.033.195 0 .375.104.495.254l2.462 3.33V8.108c0-.345.282-.63.63-.63.345 0 .63.285.63.63v4.771zm-5.741 0c0 .344-.282.629-.631.629-.345 0-.627-.285-.627-.629V8.108c0-.345.282-.63.63-.63.346 0 .628.285.628.63v4.771zm-2.466.629H4.917c-.345 0-.63-.285-.63-.629V8.108c0-.345.285-.63.63-.63.348 0 .63.285.63.63v4.141h1.756c.348 0 .629.283.629.63 0 .344-.281.629-.629.629M24 10.314C24 4.943 18.615.572 12 .572S0 4.943 0 10.314c0 4.811 4.27 8.842 10.035 9.608.391.082.923.258 1.058.59.12.301.079.766.038 1.08l-.164 1.02c-.045.301-.24 1.186 1.049.645 1.291-.539 6.916-4.078 9.436-6.975C23.176 14.393 24 12.458 24 10.314"/>
            </svg>
            🟢 透過 LINE 預約掛號
          </a>
          <p class="line-notice">
            ※ 點擊後將開啟豐田診所 LINE 官方帳號，加入好友後即可預約
          </p>
        </div>
      </div>
    </div>
  </section>
</Layout>

<style>
  /* 頁首海龜視覺橫幅 Banner */
  .turtle-hero-banner {
    position: relative;
    width: 100%;
    height: 240px;
    border-radius: 20px;
    overflow: hidden;
    margin-bottom: 32px;
    box-shadow: 0 8px 30px rgba(47, 102, 86, 0.12);
  }
  @media (max-width: 768px) {
    .turtle-hero-banner {
      height: 200px;
    }
  }
  .banner-bg-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 40%;
    transition: transform 0.6s ease;
  }
  .turtle-hero-banner:hover .banner-bg-img {
    transform: scale(1.04);
  }
  .banner-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      180deg,
      rgba(28, 68, 56, 0.3) 0%,
      rgba(28, 68, 56, 0.75) 100%
    );
  }
  .banner-content {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    text-align: center;
    padding: 24px;
    color: #FFFFFF;
    z-index: 1;
  }
  .banner-badge {
    display: inline-block;
    background: rgba(255, 255, 255, 0.2);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    color: #FFFFFF;
    font-size: 0.85rem;
    font-weight: 800;
    padding: 4px 14px;
    border-radius: 50px;
    margin-bottom: 12px;
    border: 1px solid rgba(255, 255, 255, 0.3);
    letter-spacing: 1px;
  }
  .banner-title {
    font-size: 1.8rem;
    font-weight: 900;
    color: #FFFFFF;
    text-shadow: 0 2px 8px rgba(0, 0, 0, 0.3);
    margin-bottom: 6px;
  }
  .banner-subtitle {
    font-size: 1rem;
    color: #E2EAE6;
    font-weight: 500;
    text-shadow: 0 1px 4px rgba(0, 0, 0, 0.3);
    max-width: 650px;
  }
  @media (max-width: 600px) {
    .banner-title {
      font-size: 1.4rem;
    }
    .banner-subtitle {
      font-size: 0.85rem;
    }
  }

  /* Hero Section */
  .about-hero {
    display: grid;
    grid-template-columns: 320px 1fr;
    gap: 48px;
    align-items: center;
    background-color: var(--color-bg-card);
    border-radius: 20px;
    padding: 40px;
    box-shadow: 0 10px 30px var(--color-shadow);
    margin-bottom: 40px;
  }

  .hero-image-wrapper {
    position: relative;
    border-radius: 16px;
    overflow: hidden;
    aspect-ratio: 1 / 1.1;
    background: linear-gradient(135deg, var(--color-primary-light), var(--color-bg-page));
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.05);
  }

  .hero-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top center;
    transition: transform 0.5s ease;
  }

  .hero-image-wrapper:hover .hero-image {
    transform: scale(1.03);
  }

  .hero-text-content {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  .hero-badge {
    background-color: var(--color-primary-light);
    color: var(--color-primary);
    padding: 6px 14px;
    border-radius: 20px;
    font-size: 0.85rem;
    font-weight: 700;
    margin-bottom: 16px;
    letter-spacing: 0.5px;
  }

  .hero-name {
    font-size: 2.5rem;
    font-weight: 900;
    color: var(--color-primary);
    margin-bottom: 4px;
  }

  .hero-title {
    font-size: 1.2rem;
    color: var(--color-accent);
    font-weight: 500;
    margin-bottom: 24px;
  }

  .hero-quote {
    font-size: 1.1rem;
    font-style: italic;
    color: var(--color-text-body);
    border-left: 4px solid var(--color-accent);
    padding-left: 18px;
    margin-bottom: 28px;
    line-height: 1.7;
  }

  .hero-meta {
    width: 100%;
    border-top: 1px solid var(--color-border);
    padding-top: 20px;
  }

  .meta-item {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .meta-item strong {
    font-size: 0.95rem;
    color: var(--color-primary);
  }

  .meta-item span {
    color: var(--color-text-muted);
    font-size: 1rem;
  }

  /* Profile Details (学经历) */
  .profile-details {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 24px;
    margin-bottom: 48px;
  }

  .details-card {
    background-color: var(--color-bg-card);
    border-radius: 20px;
    padding: 32px;
    box-shadow: 0 8px 24px var(--color-shadow);
    border: 1px solid var(--color-border);
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }

  .details-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 12px 30px rgba(47, 102, 86, 0.1);
  }

  .card-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 48px;
    height: 48px;
    background-color: var(--color-primary-light);
    color: var(--color-primary);
    border-radius: 12px;
    margin-bottom: 20px;
  }

  .details-card h2 {
    font-size: 1.4rem;
    color: var(--color-primary);
    margin-bottom: 18px;
    font-weight: 700;
  }

  .details-list {
    list-style: none;
  }

  .details-list li {
    position: relative;
    padding-left: 20px;
    margin-bottom: 12px;
    color: var(--color-text-body);
    font-size: 1.05rem;
  }

  .details-list li::before {
    content: "•";
    position: absolute;
    left: 0;
    color: var(--color-accent);
    font-size: 1.2rem;
    line-height: 1;
  }

  /* Schedule Section */
  .schedule-section {
    background-color: var(--color-bg-card);
    border-radius: 20px;
    padding: 40px;
    box-shadow: 0 10px 30px var(--color-shadow);
    margin-bottom: 48px;
  }

  .section-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    margin-bottom: 30px;
  }

  .section-header h2 {
    font-size: 1.8rem;
    color: var(--color-primary);
    font-weight: 700;
  }

  .section-desc {
    color: var(--color-text-muted);
    font-size: 0.95rem;
    margin-top: 4px;
  }

  .table-container {
