  </section>

  <!-- SmoothUI 3D Interactive Perspective Grid Initialization -->
  <script is:inline>
    (function initHero3DGrid() {
      const grid = document.getElementById('about-hero-grid');
      if (!grid || grid.children.length > 0) return;
      const fragment = document.createDocumentFragment();
      const count = 28 * 28; // 784 tiles for silky 60fps interaction
      for (let i = 0; i < count; i++) {
        const tile = document.createElement('div');
        tile.className = 'grid-tile';
        fragment.appendChild(tile);
      }
      grid.appendChild(fragment);
    })();
  </script>
</Layout>

<style>
  /* 頁首海龜視覺橫幅 Banner (純粹清澈全景版) */
  .turtle-hero-banner {
    position: relative;
    width: 100%;
    height: 320px;
    border-radius: 24px;
    overflow: hidden;
    margin-bottom: 36px;
    box-shadow: 0 10px 32px rgba(27, 67, 50, 0.1);
    border: 1px solid var(--color-border);
  }
  @media (max-width: 768px) {
    .turtle-hero-banner {
      height: 240px;
      border-radius: 18px;
      margin-bottom: 24px;
    }
  }
  .banner-bg-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 55%;
    transition: transform 0.6s ease;
  }
  .turtle-hero-banner:hover .banner-bg-img {
    transform: scale(1.03);
  }

  /* Hero Section (關於我) + SmoothUI 3D Interactive Perspective Grid */
  .about-hero {
    position: relative;
    overflow: hidden;
    display: grid;
    grid-template-columns: 320px 1fr;
    gap: 48px;
    align-items: center;
    background-color: var(--color-bg-card);
    border-radius: 24px;
    padding: 40px;
    box-shadow: 0 10px 30px var(--color-shadow);
    margin-bottom: 40px;
    border: 1px solid var(--color-border);
  }

  .interactive-grid-container {
    --hero-grid-hover-color-1: rgba(47, 102, 86, 0.3);
    --hero-grid-hover-color-2: rgba(61, 128, 109, 0.3);
    --hero-grid-hover-color-3: rgba(188, 138, 74, 0.3);
    --hero-grid-hover-color-4: rgba(232, 242, 238, 0.7);
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: hidden;
    perspective: 2000px;
    perspective-origin: center center;
    pointer-events: auto;
    z-index: 0;
  }

  .main-3d-grid {
    position: absolute;
    top: 50%;
    left: 50%;
    display: grid;
    grid-template-rows: repeat(28, 1fr);
    grid-template-columns: repeat(28, 1fr);
    width: 110rem;
    aspect-ratio: 1;
    transform: translate(-50%, -50%) rotateX(50deg) rotateY(-5deg) rotateZ(20deg) scale(1.25);
    pointer-events: auto;
  }

  .main-3d-grid::after {
    position: absolute;
    inset: 0;
    z-index: 3;
    pointer-events: none;
    content: "";
    background: radial-gradient(circle, transparent 25%, #FFFFFF 78%);
  }

  .grid-tile {
    border: 0.5px solid rgba(47, 102, 86, 0.08);
    transition: background-color 1500ms cubic-bezier(0.4, 0, 0.2, 1);
    cursor: crosshair;
  }

  .grid-tile:hover {
    transition-duration: 0ms !important;
  }

  .grid-tile:nth-child(4n):hover { background-color: var(--hero-grid-hover-color-1); }
  .grid-tile:nth-child(4n + 1):hover { background-color: var(--hero-grid-hover-color-2); }
  .grid-tile:nth-child(4n + 2):hover { background-color: var(--hero-grid-hover-color-3); }
  .grid-tile:nth-child(4n + 3):hover { background-color: var(--hero-grid-hover-color-4); }
  .grid-tile:nth-child(7n):hover { background-color: var(--hero-grid-hover-color-2); }
  .grid-tile:nth-child(7n + 3):hover { background-color: var(--hero-grid-hover-color-3); }
  .grid-tile:nth-child(7n + 5):hover { background-color: var(--hero-grid-hover-color-4); }
  .grid-tile:nth-child(7n + 6):hover { background-color: var(--hero-grid-hover-color-1); }
  .grid-tile:nth-child(11n + 1):hover { background-color: var(--hero-grid-hover-color-1); }
  .grid-tile:nth-child(11n + 4):hover { background-color: var(--hero-grid-hover-color-2); }
  .grid-tile:nth-child(11n + 7):hover { background-color: var(--hero-grid-hover-color-3); }
  .grid-tile:nth-child(11n + 10):hover { background-color: var(--hero-grid-hover-color-4); }

  @media (prefers-reduced-motion: reduce) {
    .main-3d-grid {
      transform: translate(-50%, -50%) rotateZ(20deg);
    }
    .grid-tile {
      transition: none;
    }
  }

  .hero-image-wrapper {
    position: relative;
    z-index: 2;
    border-radius: 20px;
    overflow: hidden;
