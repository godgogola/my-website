---
import Layout from '../layouts/Layout.astro';
import PostCard from '../components/PostCard.astro';
import { getCollection } from 'astro:content';

// 取得所有未草稿的文章，並依日期排序
const allPosts = await getCollection('posts');
const latestPosts = allPosts
  .filter(post => !post.data.draft)
  .sort((a, b) => new Date(b.data.publishDate).getTime() - new Date(a.data.publishDate).getTime())
  .slice(0, 3); // 取最新 3 篇精選文章

// 格式化日期
const formatDate = (date: Date) => {
  return new Date(date).toLocaleDateString('zh-TW', {
    year: 'numeric',
    month: 'long',
    day: 'numeric'
  });
};
---

<Layout
  meta_title="黃冠智醫師｜肝膽腸胃科·豐田診所院長｜醫學筆記與健康指南"
  title="黃冠智醫師｜肝膽腸胃科·豐田診所院長｜醫學筆記與健康指南"
  description="豐田診所院長黃冠智醫師的官方網站。提供胃食道逆流、大腸鏡檢查、肝病防治、減重門診等肝膽腸胃內科專業醫學筆記與健康指南。"
>
  <!-- Google 醫師專業結構化標籤 (JSON-LD) -->
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "Physician",
    "name": "黃冠智醫師",
    "alternateName": ["黃冠智 醫師", "黃冠智 院長"],
    "jobTitle": "豐田診所院長 / 肝膽腸胃內科主治醫師",
    "medicalSpecialty": [
      "Gastroenterology",
      "Hepatology",
      "InternalMedicine"
    ],
    "description": "豐田診所院長黃冠智醫師，專長內視鏡檢查、胃食道逆流、大腸息肉切除、肝病追蹤、減重醫學與三高慢病管理。",
    "image": "https://static.wixstatic.com/media/f229cb_5dcb4100d96e46e1bab7ea4cb7062215~mv2.jpg",
    "url": "https://drhuanggi.vercel.app"
  })} />
  <!-- 頁首海龜視覺橫幅 Banner -->
  <section class="turtle-hero-banner">
    <img src="/images/turtle-banner.jpg" alt="海龜悠遊海洋" class="banner-bg-img" />
  </section>

  <!-- Hero Section (關於我) -->
  <section class="about-hero">
    <!-- SmoothUI Interactive 3D Perspective Grid -->
    <div class="interactive-grid-container" aria-hidden="true">
      <div class="main-3d-grid" id="about-hero-grid"></div>
    </div>

    <div class="hero-image-wrapper">
      <img src="https://static.wixstatic.com/media/f229cb_5dcb4100d96e46e1bab7ea4cb7062215~mv2.jpg" alt="黃冠智 醫師" class="hero-image" />
    </div>

    <div class="hero-text-content">
      <div class="hero-header-info">
        <h1 class="hero-name">關於 黃冠智 醫師</h1>
        <p class="hero-title">豐田診所院長 / 肝膽腸胃內科主治醫師</p>
      </div>
      
      <div class="hero-quote-card">
        <span class="quote-mark">“</span>
        <blockquote class="hero-quote-text">
          我很喜歡肝膽腸胃科，除了病史、理學及抽血檢查之外，還有超音波和胃腸鏡，可以動手幫病患找出及解決問題。
        </blockquote>
      </div>

      <div class="hero-meta">
        <div class="meta-header">
          <strong>專長領域與特色診療</strong>
        </div>
        <div class="specialty-pill-grid">
          <span class="specialty-pill">消化道內視鏡</span>
          <span class="specialty-pill">腹部超音波</span>
          <span class="specialty-pill">胃食道逆流</span>
          <span class="specialty-pill">肝病慢性追蹤</span>
          <span class="specialty-pill">減重代謝門診</span>
          <span class="specialty-pill">三高慢性病</span>
          <span class="specialty-pill">內痔微創結紮</span>
          <span class="specialty-pill">勞工健康檢查</span>
