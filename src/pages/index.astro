    padding: 38px 42px;
    margin-bottom: 48px;
    box-shadow: 6px 6px 20px rgba(74, 144, 164, 0.08), -6px -6px 20px #ffffff;
    border: 1.5px solid var(--color-border);
    display: flex;
    gap: 36px;
    align-items: center;
    overflow: hidden;
    isolation: isolate;
