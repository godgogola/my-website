<script>
  // SmoothUI Interactive 3D Grid Dynamic Mouse Perspective Tracking
  document.addEventListener('DOMContentLoaded', () => {
    const heroCard = document.querySelector('.about-hero') as HTMLElement;
    const grid = document.getElementById('about-hero-grid') as HTMLElement;

    if (!heroCard || !grid) return;

    let rafId: number | null = null;

    const handleMouseMove = (e: MouseEvent) => {
      if (rafId) cancelAnimationFrame(rafId);
      rafId = requestAnimationFrame(() => {
        const rect = heroCard.getBoundingClientRect();
        const x = e.clientX - rect.left;
        const y = e.clientY - rect.top;

        const xPercent = (x / rect.width - 0.5) * 2;
        const yPercent = (y / rect.height - 0.5) * 2;

        const rotX = 65 - yPercent * 14;
        const rotY = xPercent * 10;
        const rotZ = -xPercent * 8;

        grid.style.transform = `perspective(1000px) rotateX(${rotX}deg) rotateY(${rotY}deg) rotateZ(${rotZ}deg) scale(1.15)`;
      });
    };

    const handleMouseLeave = () => {
      if (rafId) cancelAnimationFrame(rafId);
      grid.style.transform = `perspective(1000px) rotateX(65deg) rotateY(0deg) rotateZ(0deg) scale(1)`;
    };

    heroCard.addEventListener('mousemove', handleMouseMove, { passive: true });
    heroCard.addEventListener('mouseleave', handleMouseLeave, { passive: true });
  });
</script>

<style>
  /* ═══════════════════════════════════════
     頁首海龜視覺橫幅 Banner (滿版置頂)
  ═══════════════════════════════════════ */
  .turtle-hero-banner {
    position: relative;
    width: 100vw;
    margin-left: calc(-50vw + 50%);
    margin-top: -28px;
    margin-bottom: 24px;
    height: 380px;
    overflow: hidden;
  }

