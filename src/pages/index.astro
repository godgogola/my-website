---
import Layout from '../layouts/Layout.astro';
import PostCard from '../components/PostCard.astro';
import { getCollection } from 'astro:content';

// 取得所有未草稿的文章，並依日期排序
const allPosts = await getCollection('posts');
const unDraftPosts = allPosts.filter(post => !post.data.draft);
const latestPosts = [...unDraftPosts]
  .sort((a, b) => {
    const dateDiff = new Date(b.data.publishDate).getTime() - new Date(a.data.publishDate).getTime();
    if (dateDiff !== 0) return dateDiff;
    return a.data.title.localeCompare(b.data.title, 'zh-Hant');
  })
  .slice(0, 3); // 取最新 3 篇精選文章
---

<Layout
  meta_title="黃冠智醫師｜肝膽腸胃科·豐田診所院長｜醫學筆記與健康指南"
  title="黃冠智醫師｜肝膽腸胃科·豐田診所院長｜醫學筆記與健康指南"
  description="豐田診所院長黃冠智醫師的官方網站。提供胃食道逆流、大腸鏡檢查、肝病防治、減重門診等肝膽腸胃內科專業醫學筆記與健康指南。"
>
  <!-- Google 醫師專業結構化標籤 (JSON-LD) -->
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "Physician",
    "name": "黃冠智醫師",
    "alternateName": ["黃冠智 醫師", "黃冠智 院長"],
    "jobTitle": "豐田診所院長 / 肝膽腸胃內科主治醫師",
    "medicalSpecialty": [
      "Gastroenterology",
      "Hepatology",
      "InternalMedicine"
    ],
    "description": "豐田診所院長黃冠智醫師，專長內視鏡檢查、胃食道逆流、大腸息肉切除、肝病追蹤、減重醫學與三高慢病管理。",
    "image": "https://static.wixstatic.com/media/f229cb_5dcb4100d96e46e1bab7ea4cb7062215~mv2.jpg",
    "url": "https://drhuanggi.vercel.app"
  })} />

  <!-- ── 1. Hero 形象區 (Pet-Adoption Warm Coral Style) ── -->
  <section class="pet-hero-section">
    <div class="pet-hero-grid">
      <!-- 左欄：主標題、搜尋膠囊、分類 Chips 與數據 -->
      <div class="hero-left-content">
        <div class="badge badge-primary">
          <span class="badge-icon-pulse">🩺</span>
          <span>專業醫療 · 實證衛教筆記</span>
        </div>

        <h1 class="hero-main-title">
          守護腸胃與代謝健康<br />
          <span class="gradient-text">黃冠智 醫師</span>
        </h1>

        <p class="hero-lead-text">
          豐田診所院長 / 肝膽腸胃內科專科醫師。深耕胃食道逆流、無痛胃腸鏡、肝病防治、減重代謝與三高管理，以臨床經驗為您提供最安心的實證衛教。❤️
        </p>

        <!-- 搜尋膠囊列 -->
        <form class="hero-search-box" action="/health-column" method="GET">
          <div class="search-input-wrap">
            <svg class="search-lens-svg" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="11" cy="11" r="8"/>
              <line x1="21" y1="21" x2="16.65" y2="16.65"/>
            </svg>
            <input
              type="text"
              name="search"
              placeholder="搜尋衛教文章、疾病、檢查項目..."
              class="hero-search-input"
              autocomplete="off"
            />
          </div>
          <button type="submit" class="hero-search-btn">
            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="11" cy="11" r="8"/>
              <line x1="21" y1="21" x2="16.65" y2="16.65"/>
            </svg>
            <span>搜尋筆記</span>
          </button>
        </form>

        <!-- 專科快速標籤 Filter Chips -->
        <div class="hero-chips-wrap">
          <a href="/health-column?filter=內視鏡檢查" class="filter-chip active">🔬 消化胃腸鏡</a>
          <a href="/health-column?filter=胃部疾病" class="filter-chip">🩺 胃食道逆流</a>
          <a href="/health-column?filter=肝膽胰疾病" class="filter-chip">🌿 肝病追蹤</a>
          <a href="/health-column?filter=減重" class="filter-chip">⚖️ 減重代謝</a>
          <a href="/health-column?filter=超音波檢查" class="filter-chip">🌊 腹部超音波</a>
        </div>

        <!-- 數據統計膠囊 -->
        <div class="hero-stats-row">
          <div class="stat-item">
            <div class="stat-number gradient-text">{unDraftPosts.length}+</div>
            <div class="stat-label">篇實證衛教筆記</div>
          </div>
          <div class="stat-divider"></div>
          <div class="stat-item">
            <div class="stat-number gradient-text">15+</div>
            <div class="stat-label">大專科領域分類</div>
          </div>
          <div class="stat-divider"></div>
          <div class="stat-item">
            <div class="stat-number gradient-text">100%</div>
            <div class="stat-label">親切專業診療</div>
          </div>
        </div>
      </div>

      <!-- 右欄：Pet-Adoption 雙欄浮動 Bento 卡片群 -->
      <div class="hero-right-bento">
        <!-- 欄位 1 -->
        <div class="bento-column">
          <!-- 醫師主卡片 -->
          <div class="bento-doctor-card">
            <div class="bento-img-wrap">
              <img
                src="https://static.wixstatic.com/media/f229cb_5dcb4100d96e46e1bab7ea4cb7062215~mv2.jpg"
                alt="黃冠智 醫師"
                class="bento-doc-img"
              />
              <div class="bento-heart-btn" title="用心守護健康">
                <svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor">
                  <path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"/>
                </svg>
              </div>
            </div>
            <div class="bento-card-info">
              <h3 class="bento-card-title">黃冠智 醫師</h3>
              <p class="bento-card-subtitle">豐田診所院長 · 胃腸肝膽專科</p>
            </div>
          </div>

          <!-- 浮動資訊膠囊 1 -->
          <div class="bento-motion-pill">
            <div class="pill-icon-circle bg-peach">🏠</div>
            <div>
              <div class="pill-title">豐田診所 院長</div>
              <div class="pill-subtitle">台中市南區建成路1848號</div>
            </div>
          </div>
        </div>

        <!-- 欄位 2（微向下位移營造層次感） -->
        <div class="bento-column offset-col">
          <!-- 浮動資訊膠囊 2 -->
          <div class="bento-motion-pill">
            <div class="pill-icon-circle bg-coral">❤️</div>
            <div>
              <div class="pill-title">臨床實證筆記</div>
              <div class="pill-subtitle">最新醫學與用藥指引</div>
            </div>
          </div>

          <!-- 副卡片（海龜與海洋視覺） -->
          <div class="bento-doctor-card">
            <div class="bento-img-wrap">
              <img
                src="/images/turtle-banner.jpg"
                alt="海龜悠遊海洋"
                class="bento-doc-img"
              />
              <div class="bento-heart-btn" title="自在悠遊健康生活">
                <svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor">
                  <path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"/>
                </svg>
              </div>
            </div>
            <div class="bento-card-info">
              <h3 class="bento-card-title">專業儀器設備</h3>
              <p class="bento-card-subtitle">ELUXEO™ 6000 高解析內視鏡</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ── 2. 醫師專長與特診領域 ── -->
  <section class="specialty-section">
    <div class="section-badge-center">
      <span class="badge badge-primary">🩺 診療特色</span>
    </div>
    <h2 class="section-title-center">專長領域與 <span class="gradient-text">特色診療</span></h2>
    <p class="section-subtitle-center">全方位肝膽腸胃及內科診療服務，細心傾聽您的身體訊號</p>

    <div class="specialty-pills-container">
      <span class="specialty-tag">🔬 消化道內視鏡檢查</span>
      <span class="specialty-tag">🌊 腹部超音波精準檢查</span>
      <span class="specialty-tag">🔥 胃食道逆流整合治療</span>
      <span class="specialty-tag">🌿 B/C型肝炎慢性追蹤</span>
      <span class="specialty-tag">⚖️ 減重代謝整合門診</span>
      <span class="specialty-tag">💊 三高慢性病精準管理</span>
      <span class="specialty-tag">🩹 內痔微創結紮術</span>
      <span class="specialty-tag">📋 勞工健康檢查專責</span>
    </div>
  </section>

  <!-- ── 3. 專業學歷與臨床經歷 (Bento Cards) ── -->
  <section class="profile-details">
    <div class="details-card">
      <div class="card-icon-circle">
        <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2.2">
          <path d="M22 10v6M2 10l10-5 10 5-10 5z"/>
          <path d="M6 12v5c0 2 2 3 6 3s6-1 6-3v-5"/>
        </svg>
      </div>
      <h2>專業學歷</h2>
      <ul class="details-list">
        <li>中山醫學大學醫學系學士</li>
        <li>中華民國內科專科醫師</li>
        <li>中華民國消化內科專科醫師</li>
        <li>中華民國消化內視鏡專科醫師</li>
        <li>中華民國勞工健檢專責醫師</li>
      </ul>
    </div>

    <div class="details-card">
      <div class="card-icon-circle">
        <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2.2">
          <rect x="2" y="7" width="20" height="14" rx="2" ry="2"/>
          <path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"/>
        </svg>
      </div>
      <h2>臨床經歷</h2>
      <ul class="details-list">
        <li>中山醫學大學附設醫院胃腸肝膽科主治醫師</li>
        <li>大里仁愛醫院/長庚醫院 消化內科內視鏡室主任</li>
        <li>大里仁愛醫院/長庚醫院 肝癌多專科診療團隊召集人</li>
        <li>現任 豐田診所 院長</li>
      </ul>
    </div>
  </section>

  <!-- ── 4. 個人門診時間表 ── -->
  <section class="schedule-section">
    <div class="section-header">
      <div>
        <div class="badge badge-primary mb-2">📅 門診資訊</div>
        <h2>個人門診時間表</h2>
        <p class="section-desc">以下為黃冠智醫師常態門診時間，如遇休診或代診請以診所最新公告為準。</p>
      </div>
    </div>

    <div class="table-container">
      <table class="schedule-table">
        <thead>
          <tr>
            <th>時段</th>
            <th>星期一</th>
            <th>星期二</th>
            <th>星期三</th>
            <th>星期四</th>
            <th>星期五</th>
            <th>星期六</th>
            <th>星期日</th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <td class="time-header">
              <strong>早診</strong>
              <span>08:30 - 12:00</span>
            </td>
            <td class="exam">檢查診</td>
            <td class="on-duty">豐田診所</td>
            <td class="exam">檢查診</td>
            <td class="on-duty">豐田診所</td>
            <td class="exam">檢查診</td>
            <td class="on-duty">豐田診所</td>
            <td class="closed">休診</td>
          </tr>
          <tr>
            <td class="time-header">
              <strong>午診</strong>
              <span>14:00 - 17:30</span>
            </td>
            <td class="on-duty">豐田診所</td>
            <td class="closed">休診</td>
            <td class="on-duty">豐田診所</td>
            <td class="external">豐田仁愛</td>
            <td class="on-duty">豐田診所</td>
            <td class="closed">休診</td>
            <td class="closed">休診</td>
          </tr>
          <tr>
            <td class="time-header">
              <strong>晚診</strong>
              <span>18:00 - 20:30</span>
            </td>
            <td class="closed">休診</td>
            <td class="closed">休診</td>
            <td class="on-duty">豐田診所</td>
            <td class="closed">休診</td>
            <td class="closed">休診</td>
            <td class="closed">休診</td>
            <td class="closed">休診</td>
          </tr>
        </tbody>
      </table>
    </div>
    
    <div class="schedule-tips">
      <p>💡 備註：星期四下午於「豐田仁愛診所」看診，其餘時段均在「豐田診所」。「檢查診」為胃鏡與大腸鏡內視鏡預約檢查時段。</p>
    </div>
  </section>

  <!-- ── 5. 最新精選醫學筆記 ── -->
  <section class="latest-articles">
    <div class="section-header">
      <div>
        <div class="badge badge-primary mb-2">📚 實證專欄</div>
        <h2>最新醫學筆記</h2>
        <p class="section-desc">由黃冠智醫師親筆撰寫之實證衛教文章，點擊直接閱讀完整內容</p>
      </div>
      <a href="/health-column" class="view-all-btn">
        <span>查看全部專欄 ({unDraftPosts.length} 篇)</span>
        <span>→</span>
      </a>
    </div>

    <div class="articles-grid">
      {latestPosts.length > 0 ? (
        latestPosts.map((post) => (
          <PostCard
            title={post.data.title}
            href={`/posts/${post.data.slug || post.id}`}
            category={post.data.category || '衛教文章'}
            publishDate={post.data.publishDate}
            coverImage={post.data.coverImage}
          />
        ))
      ) : (
        <div class="empty-articles">
          <p>目前尚無文章，請設定並同步您的筆記！</p>
        </div>
      )}
    </div>
  </section>

  <!-- ── 6. 豐田診所 · 就醫指引與 LINE 掛號 ── -->
  <section class="clinic-info-section" aria-labelledby="clinic-section-title">
    <div class="clinic-section-header">
      <div class="badge badge-primary mb-2">🏥 診所聯絡</div>
      <h2 id="clinic-section-title" class="clinic-section-title">豐田診所 · 門診資訊</h2>
      <p class="clinic-section-desc">歡迎來電或透過 LINE 官方帳號預約掛號，我們將竭誠為您服務</p>
    </div>

    <div class="clinic-cards-row">
      <!-- 左欄：診所基本資訊 -->
      <div class="clinic-info-card">
        <div class="clinic-card-icon-wrap">
          <svg viewBox="0 0 32 32" width="28" height="28" fill="none" aria-hidden="true">
            <rect x="4" y="8" width="24" height="20" rx="3" stroke="currentColor" stroke-width="2"/>
            <path d="M10 8V5a2 2 0 0 1 2-2h8a2 2 0 0 1 2 2v3" stroke="currentColor" stroke-width="2"/>
            <path d="M16 14v6M13 17h6" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
          </svg>
        </div>
        <h3 class="clinic-card-name">豐田診所 <span class="clinic-name-en">FT Clinic</span></h3>

        <ul class="clinic-detail-list">
          <li class="clinic-detail-item">
            <span class="clinic-detail-icon" aria-hidden="true">
              <svg viewBox="0 0 20 20" width="16" height="16" fill="none">
                <path d="M10 1C6.686 1 4 3.686 4 7c0 4.418 6 12 6 12s6-7.582 6-12c0-3.314-2.686-6-6-6z" stroke="currentColor" stroke-width="1.6"/>
                <circle cx="10" cy="7" r="2" stroke="currentColor" stroke-width="1.6"/>
              </svg>
            </span>
            <div>
              <span class="clinic-detail-label">診所地址</span>
              <a
                href="https://www.google.com/maps/search/?api=1&query=豐田診所+台中市南區建成路1848號"
                target="_blank"
                rel="noopener noreferrer"
                class="clinic-detail-value clinic-map-link"
              >
                台中市南區建成路1848號
                <svg viewBox="0 0 12 12" width="11" height="11" fill="none" aria-label="開啟 Google 地圖">
                  <path d="M2 2h8v8M10 2 2 10" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
                </svg>
              </a>
            </div>
          </li>
          <li class="clinic-detail-item">
            <span class="clinic-detail-icon" aria-hidden="true">
              <svg viewBox="0 0 20 20" width="16" height="16" fill="none">
                <path d="M3 3.5A1.5 1.5 0 0 1 4.5 2h1.879a.5.5 0 0 1 .471.337l1 2.8a.5.5 0 0 1-.156.554L6.5 6.7a9.006 9.006 0 0 0 6.8 6.8l1.009-1.194a.5.5 0 0 1 .554-.156l2.8 1a.5.5 0 0 1 .337.471V15.5A1.5 1.5 0 0 1 16.5 17C9.044 17 3 10.956 3 3.5z" stroke="currentColor" stroke-width="1.6"/>
              </svg>
            </span>
            <div>
              <span class="clinic-detail-label">診所電話</span>
              <a href="tel:+886422850066" class="clinic-detail-value clinic-phone-link">
                (04) 2285-0066
              </a>
            </div>
          </li>
          <li class="clinic-detail-item">
            <span class="clinic-detail-icon" aria-hidden="true">
              <svg viewBox="0 0 20 20" width="16" height="16" fill="none">
                <rect x="2" y="4" width="16" height="12" rx="2" stroke="currentColor" stroke-width="1.6"/>
                <path d="M2 8l8 5 8-5" stroke="currentColor" stroke-width="1.6"/>
              </svg>
            </span>
            <div>
              <span class="clinic-detail-label">醫師門診時間</span>
              <span class="clinic-detail-value">週一至週六（請參考上方時間表）</span>
            </div>
          </li>
        </ul>
      </div>

      <!-- 右欄：LINE 掛號預約 -->
      <div class="clinic-line-card">
        <div class="line-card-inner">
          <div class="line-icon-ring">
            <svg viewBox="0 0 40 40" width="40" height="40" fill="none" aria-hidden="true">
              <circle cx="20" cy="20" r="20" fill="#06C755"/>
              <path d="M20 8C13.373 8 8 12.477 8 18c0 3.48 2.093 6.545 5.28 8.432-.234.857-.881 3.115-.993 3.568 0 0 1.136-.45 4.374-2.26A14.91 14.91 0 0 0 20 28c6.627 0 12-4.477 12-10S26.627 8 20 8z" fill="white"/>
              <path d="M15.5 20.5h2M18.5 20.5h2M21.5 20.5h2" stroke="#06C755" stroke-width="2" stroke-linecap="round"/>
            </svg>
          </div>
          <h3 class="line-card-title">立即預約掛號</h3>
          <p class="line-card-desc">
            透過 LINE 官方帳號預約，隨時隨地輕鬆安排就診，不需現場久候。
          </p>
          <a
            href="https://lin.ee/u3yRD2d"
            target="_blank"
            rel="noopener noreferrer"
            class="line-booking-btn"
            id="clinic-line-booking-btn"
            aria-label="透過 LINE 預約豐田診所掛號"
          >
            <svg viewBox="0 0 24 24" width="20" height="20" fill="white" aria-hidden="true">
