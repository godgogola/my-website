---
import Layout from '../layouts/Layout.astro';
import PostCard from '../components/PostCard.astro';
import VideoCard from '../components/VideoCard.astro';
import VideoModal from '../components/VideoModal.astro';
import { getCollection } from 'astro:content';
import { videos } from '../data/videos';

// 取得首頁精選 4 部短影音
const featuredVideos = videos.filter(v => v.featured).slice(0, 4);

// 取得所有未草稿的文章，並依日期排序
const allPosts = await getCollection('posts');
const latestPosts = allPosts
  .filter(post => !post.data.draft)
  .sort((a, b) => {
    const dateDiff = new Date(b.data.publishDate).getTime() - new Date(a.data.publishDate).getTime();
    if (dateDiff !== 0) return dateDiff;
    return a.data.title.localeCompare(b.data.title, 'zh-Hant');
  })
  .slice(0, 3); // 取最新 3 篇精選文章

// 格式化日期
const formatDate = (date: Date) => {
  return new Date(date).toLocaleDateString('zh-TW', {
    year: 'numeric',
    month: 'long',
    day: 'numeric'
  });
};
