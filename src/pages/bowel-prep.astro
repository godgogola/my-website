<script>
  // ── JavaScript Client Side Script for Calculator & Tabs ──
  document.addEventListener('DOMContentLoaded', () => {
    const examDateTimeInput = document.getElementById('examDateTime') as HTMLInputElement;
    const drugRadios = document.querySelectorAll('input[name="drugType"]') as NodeListOf<HTMLInputElement>;
    const timelineContainer = document.getElementById('timelineContainer');
    const displayDrugTag = document.getElementById('displayDrugTag');
    const displayExamTimeText = document.getElementById('displayExamTimeText');
    const labelBowklean = document.getElementById('label-bowklean');
    const labelNiflec = document.getElementById('label-niflec');

    // 預設將時間設為「明天 08:30」
    function setDefaultDateTime() {
      const now = new Date();
      const tomorrow = new Date(now.getFullYear(), now.getMonth(), now.getDate() + 1, 8, 30);
      const isoStr = formatDateTimeForInput(tomorrow);
      examDateTimeInput.value = isoStr;
    }

    function formatDateTimeForInput(date: Date): string {
      const pad = (n: number) => n.toString().padStart(2, '0');
      const yyyy = date.getFullYear();
      const mm = pad(date.getMonth() + 1);
      const dd = pad(date.getDate());
      const hh = pad(date.getHours());
      const min = pad(date.getMinutes());
      return `${yyyy}-${mm}-${dd}T${hh}:${min}`;
    }

    // 格式化顯示用日期時間 (例如：2026/07/24 星期五 08:30)
    function formatChineseDate(date: Date, showTime = true): string {
      const days = ['星期日', '星期一', '星期二', '星期三', '星期四', '星期五', '星期六'];
      const yyyy = date.getFullYear();
      const mm = (date.getMonth() + 1).toString().padStart(2, '0');
      const dd = date.getDate().toString().padStart(2, '0');
      const dayName = days[date.getDay()];
      const hh = date.getHours().toString().padStart(2, '0');
      const min = date.getMinutes().toString().padStart(2, '0');

      if (!showTime) {
        return `${yyyy}/${mm}/${dd} (${dayName})`;
      }
      return `${yyyy}/${mm}/${dd} (${dayName}) ${hh}:${min}`;
    }

    // 格式化時間 (如 17:00)
    function formatTimeOnly(date: Date): string {
      const hh = date.getHours().toString().padStart(2, '0');
      const min = date.getMinutes().toString().padStart(2, '0');
      return `${hh}:${min}`;
    }

    // 更新選取卡片高亮
    function updateDrugCardActive() {
      const selectedDrug = (document.querySelector('input[name="drugType"]:checked') as HTMLInputElement)?.value;
      if (selectedDrug === 'bowklean') {
        labelBowklean?.classList.add('active');
        labelNiflec?.classList.remove('active');
      } else {
        labelNiflec?.classList.add('active');
        labelBowklean?.classList.remove('active');
      }
    }

    // 計算時程主邏輯
    function calculateSchedule() {
      if (!examDateTimeInput.value) return;

      const examDate = new Date(examDateTimeInput.value);
      if (isNaN(examDate.getTime())) return;

      const selectedDrug = (document.querySelector('input[name="drugType"]:checked') as HTMLInputElement)?.value || 'bowklean';

      // 1. 檢查前兩天
      const dayMinus2 = new Date(examDate);
      dayMinus2.setDate(examDate.getDate() - 2);

      // 2. 檢查前一天
      const dayMinus1 = new Date(examDate);
      dayMinus1.setDate(examDate.getDate() - 1);

      // 3. 檢查前一晚第一劑 (保可淨 17:00-19:00 vs 耐福利散 19:00)
      const dose1Time = new Date(dayMinus1);
      dose1Time.setHours(selectedDrug === 'bowklean' ? 17 : 19, 0, 0);

      // 4. 前一日午夜 12 點
      const midnight = new Date(dayMinus1);
      midnight.setHours(24, 0, 0); // 即當天 00:00

      // 5. 檢查當天早上第二劑 (預設 04:00)
      const dose2Time = new Date(examDate);
      dose2Time.setHours(4, 0, 0);

      // 6. 血壓藥時間 (第二劑前 1 小時，即 03:00)
      const medBloodPressureTime = new Date(dose2Time);
      medBloodPressureTime.setHours(dose2Time.getHours() - 1);

      // 7. 禁水截止時間 (檢查前 3 小時)
      const npoTime = new Date(examDate);
      npoTime.setHours(examDate.getHours() - 3, examDate.getMinutes());

      // 更新 Tag
      if (displayDrugTag) {
        displayDrugTag.textContent = selectedDrug === 'bowklean' ? '保可淨 (Bowklean) 服藥時間表' : '耐福利散 (Niflec Powder) 服藥時間表';
      }
      if (displayExamTimeText) {
        displayExamTimeText.textContent = `📅 預約檢查時間：${formatChineseDate(examDate)}`;
      }

      // 生成 HTML
      let html = '';

      // 節點 1：前 2-3 天低渣飲食
      html += `
        <div class="timeline-item">
          <div class="timeline-flow-card">
            <div class="flow-left">
              <div class="badge-row">
                <span class="step-number-tag">Step 1</span>
                <span class="timeline-time-badge">📅 ${formatChineseDate(dayMinus2, false)} 起</span>
              </div>
              <h4 class="timeline-title">🍚 檢查前二至三天：開始「低渣飲食」</h4>
              <p class="timeline-desc">臨床建議檢查前二至三日開始採行低渣飲食（有嚴重便秘習慣者建議提前至 5~7 天），大幅減少腸道殘渣。</p>
            </div>
            <div class="flow-right-card">
              <div class="food-box-allow">
                <span class="food-pill-title title-allow">⭕ 可以吃的食物（軟質低渣）：</span>
                <div class="food-pills">
                  <span class="pill pill-allow">白稀飯</span>
                  <span class="pill pill-allow">白吐司</span>
                  <span class="pill pill-allow">白饅頭</span>
                  <span class="pill pill-allow">去湯麵條</span>
                  <span class="pill pill-allow">去皮蒸蛋</span>
                  <span class="pill pill-allow">去皮魚肉</span>
                  <span class="pill pill-allow">清湯</span>
                </div>
              </div>
              <div class="food-box-deny">
                <span class="food-pill-title title-deny">❌ 必須避開的食物（高纖/奶類）：</span>
                <div class="food-pills">
                  <span class="pill pill-deny">青菜水果</span>
                  <span class="pill pill-deny">堅果/豆類</span>
                  <span class="pill pill-deny">油炸大塊肉</span>
                  <span class="pill pill-deny">牛奶/乳製品</span>
                </div>
              </div>
            </div>
          </div>
        </div>
      `;

      // 節點 2：前 1 天清流質飲食
      html += `
        <div class="timeline-item">
          <div class="timeline-flow-card">
            <div class="flow-left">
              <div class="badge-row">
                <span class="step-number-tag">Step 2</span>
                <span class="timeline-time-badge">📅 ${formatChineseDate(dayMinus1, false)} 全天</span>
              </div>
              <h4 class="timeline-title">🥤 檢查前一天：全天「無渣清流質飲食」</h4>
              <p class="timeline-desc">今日全天<strong>嚴禁食用任何固體食物與零食</strong>！只能飲用完全透明無渣的清流質液體。</p>
            </div>
            <div class="flow-right-card">
              <div class="food-box-allow">
                <span class="food-pill-title title-allow">⭕ 可以飲用的液體（無渣清流）：</span>
                <div class="food-pills">
                  <span class="pill pill-allow">濾渣肉湯/魚湯</span>
                  <span class="pill pill-allow">運動飲料</span>
                  <span class="pill pill-allow">蜂蜜水</span>
                  <span class="pill pill-allow">冬瓜茶</span>
                  <span class="pill pill-allow">雪碧/沙士(建議消氣後喝)</span>
                </div>
              </div>
              <div class="food-box-deny">
                <span class="food-pill-title title-deny">❌ 絕對禁止飲用（奶/有渣/深色）：</span>
                <div class="food-pills">
                  <span class="pill pill-deny">牛奶/優酪乳</span>
                  <span class="pill pill-deny">豆漿/奶茶</span>
                  <span class="pill pill-deny">帶渣果汁</span>
                  <span class="pill pill-deny">葡萄汁/番茄汁(深色)</span>
                </div>
              </div>
            </div>
          </div>
        </div>
      `;

      // 節點 3：前一晚第一劑
      if (selectedDrug === 'bowklean') {
        html += `
          <div class="timeline-item item-warning">
            <div class="timeline-flow-card">
              <div class="flow-left">
                <div class="badge-row">
                  <span class="step-number-tag">Step 3</span>
                  <span class="timeline-time-badge">⏰ ${formatChineseDate(dayMinus1, false)} ${formatTimeOnly(dose1Time)} - 19:00</span>
                </div>
                <h4 class="timeline-title">🍵 服用「保可淨」第一劑 + 大量補水</h4>
                <p class="timeline-desc">將<strong>第 1 包藥粉</strong>倒入 150 c.c. 冷開水，攪拌 3-5 分鐘後立即喝下（產熱為正常現象，切勿乾吞）。</p>
              </div>
              <div class="flow-right-card">
                <div class="food-box-water">
                  <span class="food-pill-title title-water">💧 關鍵大補充水分目標：</span>
                  <div class="food-pills">
                    <span class="pill pill-water">陸續喝足 1500 ~ 2000 c.c. 水</span>
                    <span class="pill pill-water">約 6-8 杯清流質水</span>
                  </div>
                  <p style="font-size:0.78rem; color:#1E40AF; margin-top:6px; margin-bottom:0;">💡 充足水分能幫助腸道加速蠕動排空殘渣</p>
                </div>
              </div>
            </div>
          </div>
        `;
      } else {
        html += `
          <div class="timeline-item item-warning">
            <div class="timeline-flow-card">
              <div class="flow-left">
                <div class="badge-row">
                  <span class="step-number-tag">Step 3</span>
                  <span class="timeline-time-badge">⏰ ${formatChineseDate(dayMinus1, false)} ${formatTimeOnly(dose1Time)}</span>
                </div>
                <h4 class="timeline-title">🥤 服用「耐福利散」第一階段 (1000c.c.)</h4>
                <p class="timeline-desc">⚠️ 請先以 2000c.c. 冷開水將全包藥粉完全溶解！於晚上 19:00 開始喝第 1 半 (1000c.c.)，每 15-20 分鐘喝 250c.c.，20:00 前喝完。</p>
              </div>
              <div class="flow-right-card">
                <div class="food-box-water">
                  <span class="food-pill-title title-water">💧 補充水分目標：</span>
                  <div class="food-pills">
                    <span class="pill pill-water">喝完藥後再補 1000 c.c. 水</span>
                  </div>
                </div>
              </div>
            </div>
          </div>
        `;
      }

      // 節點 4：當天早晨第二劑
      if (selectedDrug === 'bowklean') {
        html += `
          <div class="timeline-item item-warning">
            <div class="timeline-flow-card">
              <div class="flow-left">
                <div class="badge-row">
                  <span class="step-number-tag">Step 4</span>
                  <span class="timeline-time-badge">⏰ ${formatChineseDate(examDate, false)} ${formatTimeOnly(dose2Time)} - 05:00</span>
                </div>
                <h4 class="timeline-title">🍵 服用「保可淨」第二劑 + 補水至清澈</h4>
                <p class="timeline-desc">將<strong>第 2 包藥粉</strong>溶於 150 c.c. 冷開水喝下。服藥後需再飲用至少 <strong>750 c.c.（或 3 杯 250 c.c.）的水分</strong>。</p>
              </div>
              <div class="flow-right-card">
                <div class="food-pill-group">
                  <span class="food-pill-title title-water">🎯 糞水清澈檢查目標：</span>
                  <div class="food-pills">
                    <span class="pill pill-water">再補水 750 c.c. 以上</span>
                    <span class="pill pill-allow">糞水呈清澈淡黃無渣如尿液</span>
                  </div>
                </div>
              </div>
            </div>
          </div>
        `;
      } else {
        html += `
          <div class="timeline-item item-warning">
            <div class="timeline-flow-card">
              <div class="flow-left">
                <div class="badge-row">
                  <span class="step-number-tag">Step 4</span>
                  <span class="timeline-time-badge">⏰ ${formatChineseDate(examDate, false)} ${formatTimeOnly(dose2Time)} - 05:00</span>
                </div>
                <h4 class="timeline-title">🥤 服用「耐福利散」第二階段 (1000c.c.)</h4>
                <p class="timeline-desc">服用剩下的 1000 c.c. 藥液（每 15-20 分鐘喝 250 c.c.），直到排出的糞水呈清澈無渣狀。</p>
              </div>
              <div class="flow-right-card">
                <div class="food-pill-group">
                  <span class="food-pill-title title-water">🎯 糞水清澈檢查目標：</span>
                  <div class="food-pills">
                    <span class="pill pill-allow">糞水呈清澈淡黃無渣如尿液</span>
                  </div>
                </div>
              </div>
            </div>
          </div>
        `;
      }

      // 節點 5：禁水截止時間
      html += `
        <div class="timeline-item item-danger">
          <div class="timeline-flow-card">
            <div class="flow-left">
              <div class="badge-row">
                <span class="step-number-tag">Step 5</span>
                <span class="timeline-time-badge">🛑 ${formatChineseDate(examDate, false)} 約 ${formatTimeOnly(npoTime)} 起</span>
              </div>
              <h4 class="timeline-title">🛑 滴水不沾！完全禁水截止時間</h4>
              <p class="timeline-desc"><strong>檢查前 2 - 4 小時起，必須完全停止飲用任何水分（包含開水與藥液）</strong>。</p>
            </div>
            <div class="flow-right-card" style="justify-content:center; background:#FEF2F2; border-color:#FCA5A5;">
              <span class="food-pill-title title-deny" style="font-size:0.9rem;">🛑 滴水不沾！(含白開水)</span>
              <p style="font-size:0.8rem; color:#991B1B; margin:0;">麻醉防嘔吐吸入的最重要安全守則。</p>
            </div>
          </div>
        </div>
      `;

      if (timelineContainer) {
        timelineContainer.innerHTML = html;
      }
    }

    // 快速設定按鈕 Event
    document.querySelectorAll('.btn-preset').forEach(btn => {
      btn.addEventListener('click', (e) => {
        const preset = (e.currentTarget as HTMLElement).getAttribute('data-preset');
        const now = new Date();

        if (preset === 'tomorrow-morning') {
          const t = new Date(now.getFullYear(), now.getMonth(), now.getDate() + 1, 8, 30);
          examDateTimeInput.value = formatDateTimeForInput(t);
        } else if (preset === 'tomorrow-afternoon') {
          const t = new Date(now.getFullYear(), now.getMonth(), now.getDate() + 1, 13, 30);
          examDateTimeInput.value = formatDateTimeForInput(t);
        } else if (preset === 'dayafter-morning') {
          const t = new Date(now.getFullYear(), now.getMonth(), now.getDate() + 2, 8, 30);
          examDateTimeInput.value = formatDateTimeForInput(t);
        }
        calculateSchedule();
      });
    });

    // 監聽變更
    examDateTimeInput?.addEventListener('change', calculateSchedule);
    drugRadios.forEach(r => r.addEventListener('change', () => {
      updateDrugCardActive();
      calculateSchedule();
    }));

    // 列印按鈕
    document.getElementById('btnPrint')?.addEventListener('click', () => {
      window.print();
    });

    // 複製 LINE 提醒文字
    document.getElementById('btnCopy')?.addEventListener('click', () => {
      const examDate = new Date(examDateTimeInput.value);
      const selectedDrug = (document.querySelector('input[name="drugType"]:checked') as HTMLInputElement)?.value || 'bowklean';
      const drugName = selectedDrug === 'bowklean' ? '保可淨 (Bowklean)' : '耐福利散 (Niflec)';

      const dayMinus2 = new Date(examDate); dayMinus2.setDate(examDate.getDate() - 2);
      const dayMinus1 = new Date(examDate); dayMinus1.setDate(examDate.getDate() - 1);

      const text = `【大腸鏡清腸提醒卡】
🏥 預約檢查時間：${formatChineseDate(examDate)}
💊 使用藥物：${drugName}

📌 檢查前二至三天 (${formatChineseDate(dayMinus2, false)})：開始低渣飲食 (白稀飯、白吐司、去皮魚肉蒸蛋；便秘者建議 5-7 天)。
📌 檢查前一天 (${formatChineseDate(dayMinus1, false)})：全天無渣清流質飲食 (魚湯清湯、寶礦力、冬瓜茶，沙士雪碧建議消氣喝)。
📌 前一晚 (17:00-19:00)：喝第 1 劑清腸藥 + 補充 1500-2000c.c. 水分。
📌 當天早上 (04:00-05:00)：喝第 2 劑清腸藥 + 補充至少 750c.c. 水分直到糞水清澈無渣如尿液。
🛑 檢查前 2-4 小時：滴水不沾，停止所有飲水！`;

      navigator.clipboard.writeText(text).then(() => {
        alert('已成功複製清腸提醒文字！您可以直接貼上發送到 LINE 分享給家人。');
      }).catch(() => {
        alert('複製失敗，請手動選取文字複製。');
      });
    });

    // 頁面詳細步驟 Tab 切換
    document.querySelectorAll('.tab-btn').forEach(btn => {
      btn.addEventListener('click', (e) => {
        const targetTab = (e.currentTarget as HTMLElement).getAttribute('data-tab');

        document.querySelectorAll('.tab-btn').forEach(b => {
          b.classList.remove('active');
          b.setAttribute('aria-selected', 'false');
        });
        document.querySelectorAll('.tab-content').forEach(c => c.classList.remove('active'));

        (e.currentTarget as HTMLElement).classList.add('active');
        (e.currentTarget as HTMLElement).setAttribute('aria-selected', 'true');
        document.getElementById(targetTab!)?.classList.add('active');
      });
    });

    // 初始化
    setDefaultDateTime();
    updateDrugCardActive();
    calculateSchedule();
  });
</script>
