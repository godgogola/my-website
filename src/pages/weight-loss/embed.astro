  step: number;
  id: string;
  badge: string;
  coreTakeaways: string[];
  bridgeNarrative?: string;
  isActFinal?: boolean;
}

interface ActGroup {
  actNumber: string;
  actTitle: string;
  actSubtitle: string;
  actIntro: string;
  actColor: string;
  steps: StepItem[];
}

