<script>
  // ── 通關進度管理 (LocalStorage 存取與動態更新) ──
  const STORAGE_KEY = 'dr_huang_weight_loss_unlocked_steps';

  function getUnlockedSteps(): number[] {
    try {
      const data = localStorage.getItem(STORAGE_KEY);
      return data ? JSON.parse(data) : [];
    } catch {
      return [];
    }
  }

  function saveUnlockedSteps(steps: number[]) {
    try {
      localStorage.setItem(STORAGE_KEY, JSON.stringify(steps));
    } catch (e) {
      console.warn('無法存取 localStorage', e);
    }
  }

  // 智慧 iframe 自適應高度回報
  function notifyParentHeight() {
    try {
      if (window.parent && window.parent !== window) {
        const height = document.documentElement.scrollHeight;
        window.parent.postMessage({ type: 'embed-resize', height: height }, '*');
      }
    } catch (e) {
      // ignore cross-origin error
    }
  }

  function updateTrackerUI() {
    const unlocked = getUnlockedSteps();
    const count = unlocked.length;
    const total = 15;
    const pct = Math.round((count / total) * 100);

    const countEl = document.getElementById('unlockedCount');
    const pctEl = document.getElementById('unlockedPercent');
    const fillEl = document.getElementById('trackerFill');

    if (countEl) countEl.textContent = String(count);
    if (pctEl) pctEl.textContent = `${pct}%`;
    if (fillEl) fillEl.style.width = `${pct}%`;

    // 更新節點卡片打勾樣式與左側圓圈樣式
    for (let i = 1; i <= total; i++) {
      const isDone = unlocked.includes(i);
      const circleEl = document.querySelector(`[data-step-circle="${i}"]`);
      const toggleBtn = document.querySelector(`[data-toggle-step="${i}"]`);
      const cardEl = document.querySelector(`[data-step-id="${i}"]`);

      if (circleEl) {
        circleEl.classList.toggle('is-completed', isDone);
      }
      if (toggleBtn) {
        toggleBtn.classList.toggle('active', isDone);
        const toggleText = toggleBtn.querySelector('.toggle-text');
        if (toggleText) {
          toggleText.textContent = isDone ? '已掌握觀念 ✓' : '標記已掌握';
        }
      }
      if (cardEl) {
        cardEl.classList.toggle('step-card-completed', isDone);
      }
    }

    notifyParentHeight();
  }

  function initProgressTracker() {
    // 綁定所有打勾切換按鈕
    const toggleButtons = document.querySelectorAll<HTMLButtonElement>('[data-toggle-step]');
    toggleButtons.forEach((btn) => {
      btn.addEventListener('click', (e) => {
        e.stopPropagation();
        const stepNum = Number(btn.getAttribute('data-toggle-step'));
        if (!stepNum) return;

        let unlocked = getUnlockedSteps();
        if (unlocked.includes(stepNum)) {
          unlocked = unlocked.filter((s) => s !== stepNum);
        } else {
          unlocked.push(stepNum);
        }
        saveUnlockedSteps(unlocked);
        updateTrackerUI();
      });
    });

    // 綁定重設按鈕
    const resetBtn = document.getElementById('btnResetTracker');
    resetBtn?.addEventListener('click', () => {
      if (confirm('確定要重置這 15 部影片的已掌握進度嗎？')) {
        saveUnlockedSteps([]);
        updateTrackerUI();
      }
    });

    // 初始載入渲染
    updateTrackerUI();
  }

  // ── 播放影片觸發 ──
  function initPlayTriggers() {
    const playTriggers = document.querySelectorAll<HTMLElement>('[data-trigger-play]');
    playTriggers.forEach((el) => {
      el.addEventListener('click', (e) => {
        e.stopPropagation();
        const card = el.closest<HTMLElement>('.step-card');
        if (!card) return;

        const videoId = card.dataset.videoId;
        if (videoId) {
          card.click();
        }
      });
    });
  }

  // ── 臨床方案切換 Tab ──
  function initSolutionTabs() {
    const tabBtns = document.querySelectorAll<HTMLButtonElement>('.sol-tab-btn');
    const cards = document.querySelectorAll<HTMLElement>('.sol-card');

    tabBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        const filter = btn.dataset.filter || 'all';

        tabBtns.forEach((b) => b.classList.remove('active'));
        btn.classList.add('active');

        cards.forEach((card) => {
          const cat = card.dataset.solCat;
          if (filter === 'all' || cat === filter) {
            card.classList.remove('is-hidden');
          } else {
            card.classList.add('is-hidden');
          }
        });

        notifyParentHeight();
      });
    });
  }

  document.addEventListener('DOMContentLoaded', () => {
    initProgressTracker();
    initPlayTriggers();
