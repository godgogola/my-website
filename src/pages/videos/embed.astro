---
import Layout from '../../layouts/Layout.astro';
import VideoCard from '../../components/VideoCard.astro';
import VideoModal from '../../components/VideoModal.astro';
import { videos, videoCategories } from '../../data/videos';

// 計算各分類數量
const categoryCounts = videoCategories.reduce((acc, cat) => {
  if (cat === '全部') {
    acc[cat] = videos.length;
  } else {
    acc[cat] = videos.filter((v) => v.category === cat).length;
  }
  return acc;
}, {} as Record<string, number>);
---

<Layout
  title="動物農莊衛教短影音｜豐田診所 × 黃冠智醫師"
  meta_title="動物農莊衛教短影音｜豐田診所 × 黃冠智醫師"
  description="豐田診所「動物農莊衛教短影音」，由動物界各科專科醫師出診，精選 16:9 實證短片與詳細衛教專文。"
  hideHeader={true}
  hideFooter={true}
  isEmbed={true}
>
  <div class="videos-embed-container">
    <!-- 影音專區頂部標題與說明 -->
    <header class="videos-hero">
      <div class="videos-hero-badge">
        <span class="pulse-dot"></span>
        <span>YOUTUBE 衛教影視頻道</span>
      </div>

      <h1 class="videos-hero-title">
        動物農莊 <span class="gradient-text">衛教短影音</span>
      </h1>
      
      <p class="videos-hero-desc">
        我們特別邀請動物界的各科專科醫師出診！用精簡生動的實證短片，為您深入講解常見腸胃疾病、內視鏡檢查與代謝保健，輕鬆簡單就能守護健康。
      </p>
    </header>

    <!-- 分類過濾篩選器 (Tabs) -->
    <section class="video-filter-section" aria-label="影片分類篩選">
      <div class="filter-pills-wrap">
        {videoCategories.map((cat, index) => (
          <button
            type="button"
            class:list={['filter-pill', { active: index === 0 }]}
            data-category={cat}
          >
            <span>{cat}</span>
            <span class="count-bubble">{categoryCounts[cat] || 0}</span>
          </button>
        ))}
      </div>
    </section>

    <!-- 影片網格列表 (雙態一體卡片) -->
    <section class="videos-grid-section">
      <div class="videos-grid" id="videos-grid">
        {videos.map((video) => (
          <div class="video-grid-item" data-category={video.category}>
            <VideoCard video={video} isEmbed={true} />
          </div>
        ))}
      </div>

      <!-- 查無結果提示 -->
      <div id="no-videos-match" class="no-videos-message" style="display: none;">
        <p>此分類目前尚無收錄影片，敬請期待陸續上線！</p>
      </div>
    </section>

    <!-- 底部導流個人網站專欄卡片 -->
    <section class="channel-callout-card">
      <div class="callout-inner">
        <div class="callout-text">
          <h3>想要更深入的醫學衛教圖文？</h3>
          <p>除了短影音外，黃冠智醫師親自撰寫的長篇衛教專欄已同步上線，包含最新降血脂藥物、胃食道逆流及內視鏡深度解析。</p>
        </div>
        <div class="callout-actions">
          <a href="https://drhuanggi.vercel.app/health-column" target="_blank" rel="noopener noreferrer" class="btn-primary">
            <span>造訪黃醫師個人衛教網站</span>
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
          </a>
        </div>
      </div>
    </section>
  </div>

  <!-- 沉浸式燈箱彈窗播放器 -->
  <VideoModal />
</Layout>

<script>
  // 分類篩選邏輯與自動高度通知 (ResizeObserver + postMessage)
  function initCategoryFilter() {
    const filterButtons = document.querySelectorAll<HTMLButtonElement>('.filter-pill');
    const items = document.querySelectorAll<HTMLElement>('.video-grid-item');
    const noResults = document.getElementById('no-videos-match');

    function notifyParentHeight() {
      try {
        if (window.parent && window.parent !== window) {
          const height = document.documentElement.scrollHeight;
          window.parent.postMessage({ type: 'embed-resize', height: height }, '*');
        }
      } catch (e) {
        // ignore cross-origin error
      }
    }

    filterButtons.forEach((btn) => {
      btn.addEventListener('click', () => {
        filterButtons.forEach((b) => b.classList.remove('active'));
        btn.classList.add('active');

        const selectedCat = btn.dataset.category || '全部';
        let visibleCount = 0;

        items.forEach((item) => {
          const itemCat = item.dataset.category;
          if (selectedCat === '全部' || itemCat === selectedCat) {
            item.style.display = 'block';
            item.classList.add('fade-in');
            visibleCount++;
          } else {
            item.style.display = 'none';
          }
        });

        if (noResults) {
          noResults.style.display = visibleCount === 0 ? 'block' : 'none';
        }

        // 分類切換後更新外層 iframe 高度
        setTimeout(notifyParentHeight, 150);
      });
    });

    // 視窗變動與初始化時通知
    window.addEventListener('resize', notifyParentHeight);
    window.addEventListener('load', notifyParentHeight);
    notifyParentHeight();
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initCategoryFilter);
  } else {
    initCategoryFilter();
  }
</script>

<style>
  /* ═══════════════════════════════════════
     Videos 嵌入專頁樣式 (Embed Container)
  ═══════════════════════════════════════ */
  .videos-embed-container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 1.5rem 1rem 3rem 1rem;
  }

  /* 頁面 Hero */
  .videos-hero {
    text-align: center;
    max-width: 780px;
    margin: 0 auto 2.5rem auto;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .videos-hero-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.82rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    color: var(--color-primary-dark, #3b7688);
    background: var(--color-primary-light, #eef7f9);
    border: 1px solid rgba(74, 144, 164, 0.25);
    padding: 0.35rem 1rem;
    border-radius: var(--radius-full, 9999px);
    margin-bottom: 1rem;
  }

  .pulse-dot {
    width: 8px;
    height: 8px;
    background: #e76f51;
    border-radius: 50%;
    box-shadow: 0 0 0 0 rgba(231, 111, 81, 0.7);
    animation: pulse 1.8s infinite;
  }

  @keyframes pulse {
    0% {
      transform: scale(0.95);
      box-shadow: 0 0 0 0 rgba(231, 111, 81, 0.7);
    }
    70% {
      transform: scale(1);
      box-shadow: 0 0 0 8px rgba(231, 111, 81, 0);
    }
    100% {
      transform: scale(0.95);
      box-shadow: 0 0 0 0 rgba(231, 111, 81, 0);
    }
  }

  .videos-hero-title {
    font-size: 2.25rem;
    font-weight: 900;
    color: var(--color-text-title, #1e3a4c);
    letter-spacing: -0.02em;
    line-height: 1.25;
    margin-bottom: 0.85rem;
  }

  .gradient-text {
    background: linear-gradient(135deg, var(--color-primary, #4a90a4) 0%, var(--color-secondary, #6bb5a2) 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .videos-hero-desc {
    font-size: 1.05rem;
    color: var(--color-text-body, #2d4f63);
    line-height: 1.7;
    margin-bottom: 1.5rem;
    opacity: 0.9;
  }

  /* 篩選器 */
  .video-filter-section {
    margin-bottom: 2.25rem;
  }

  .filter-pills-wrap {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.65rem;
    flex-wrap: wrap;
  }

  .filter-pill {
    background: #ffffff;
    border: 1.5px solid var(--color-border, #d4e5eb);
    color: var(--color-text-body, #2d4f63);
    padding: 0.45rem 1rem;
    border-radius: var(--radius-full, 9999px);
    font-size: 0.9rem;
    font-weight: 700;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    transition: all 0.2s cubic-bezier(0.16, 1, 0.3, 1);
    box-shadow: 0 2px 6px rgba(74, 144, 164, 0.04);
  }

  .filter-pill:hover {
    border-color: var(--color-primary, #4a90a4);
    color: var(--color-primary-dark, #3b7688);
    background: var(--color-primary-light, #eef7f9);
    transform: translateY(-1px);
  }

  .filter-pill.active {
    background: var(--color-primary-dark, #3b7688);
    border-color: var(--color-primary-dark, #3b7688);
    color: #ffffff;
    box-shadow: 0 4px 14px rgba(59, 118, 136, 0.3);
  }

  .count-bubble {
    font-size: 0.75rem;
    background: rgba(0, 0, 0, 0.08);
    padding: 0.1rem 0.45rem;
    border-radius: 9999px;
  }

  .filter-pill.active .count-bubble {
    background: rgba(255, 255, 255, 0.25);
    color: #ffffff;
  }

  /* 影片網格 */
  .videos-grid-section {
    margin-bottom: 3.5rem;
  }

  .videos-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
    gap: 1.65rem;
  }

  .video-grid-item.fade-in {
    animation: itemFade 0.35s ease forwards;
  }

  @keyframes itemFade {
    from {
      opacity: 0;
      transform: translateY(10px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .no-videos-message {
    text-align: center;
    padding: 3rem 1.5rem;
    background: #ffffff;
    border-radius: var(--radius-md, 14px);
    border: 1px dashed var(--color-border, #d4e5eb);
    color: var(--color-text-muted, #5a7a8a);
  }

  /* 底部導引卡片 */
  .channel-callout-card {
    background: linear-gradient(135deg, #eef7f9 0%, #edf7f4 100%);
    border: 1px solid var(--color-border, #d4e5eb);
    border-radius: var(--radius-lg, 18px);
    padding: 2rem;
    box-shadow: 0 8px 24px rgba(74, 144, 164, 0.06);
  }

  .callout-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
  }

  .callout-text h3 {
    font-size: 1.35rem;
    font-weight: 800;
    color: var(--color-text-title, #1e3a4c);
    margin-bottom: 0.45rem;
  }

  .callout-text p {
    font-size: 0.92rem;
    color: var(--color-text-body, #2d4f63);
    line-height: 1.65;
    margin: 0;
  }

  .callout-actions {
    flex-shrink: 0;
  }

  .btn-primary {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    background: var(--color-primary-dark, #3b7688);
    color: #ffffff;
    padding: 0.75rem 1.4rem;
    border-radius: var(--radius-full, 9999px);
    font-weight: 700;
    font-size: 0.92rem;
    text-decoration: none;
    box-shadow: 0 4px 14px rgba(59, 118, 136, 0.28);
    transition: all 0.2s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .btn-primary:hover {
    background: #2b5764;
    transform: translateY(-2px);
    box-shadow: 0 6px 18px rgba(59, 118, 136, 0.38);
    color: #ffffff;
  }

  @media (max-width: 768px) {
    .videos-hero-title {
      font-size: 1.85rem;
    }
    .callout-inner {
      flex-direction: column;
      text-align: center;
      gap: 1.25rem;
    }
    .videos-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
