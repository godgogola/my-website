  .mobile-menu-btn { display: none; align-items: center; gap: 8px; margin: 14px 16px 0; padding: 8px 16px; background-color: var(--color-primary-light, #eef7f9); color: var(--color-primary, #4a90a4); border: 1px solid var(--color-border, #d4e5eb); border-radius: 9999px; font-family: inherit; font-size: 0.88rem; font-weight: 700; cursor: pointer; transition: background-color .2s; }
