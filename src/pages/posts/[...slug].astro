  .bc-cat { color: var(--color-text-muted, #5a7a8a); font-weight: 600; }
  .article-breadcrumb .current { font-weight: 600; color: var(--color-text-title, #1e3a4c); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; max-width: 250px; }
  .article-header { margin-bottom: 32px; }
  .article-meta { display: flex; align-items: center; gap: 14px; font-size: 0.88rem; color: var(--color-text-muted, #5a7a8a); margin-bottom: 14px; }
  .article-category { background-color: var(--color-primary-light, #eef7f9); color: var(--color-primary, #4a90a4); padding: 4px 14px; border-radius: 9999px; font-weight: 700; }
  .article-title { font-size: 2.2rem; font-weight: 900; color: var(--color-text-title, #1e3a4c); line-height: 1.3; margin-bottom: 20px; }
  .header-divider { width: 60px; height: 4px; background: linear-gradient(135deg, var(--color-primary, #4a90a4), var(--color-secondary, #6bb5a2)); border-radius: 9999px; }
  .article-footer { margin-top: 56px; border-top: 1px solid var(--color-border, #d4e5eb); padding-top: 36px; }
  .footer-card { background-color: var(--color-bg-page, #f8fbfc); border-radius: 20px; padding: 24px; border: 1.5px solid var(--color-border, #d4e5eb); box-shadow: 6px 6px 18px rgba(74, 144, 164, 0.06), -6px -6px 18px #ffffff; margin-bottom: 30px; }
  .doctor-mini-bio { display: flex; gap: 20px; align-items: center; }
  .bio-avatar { width: 72px; height: 72px; border-radius: 50%; object-fit: cover; object-position: top center; border: 2px solid var(--color-primary, #4a90a4); }
  .bio-text h3 { font-size: 1.15rem; color: var(--color-text-title, #1e3a4c); font-weight: 800; margin-bottom: 6px; }
  .bio-text p { font-size: 0.92rem; color: var(--color-text-muted, #5a7a8a); line-height: 1.6; }
