---
import { getCollection, render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';

export async function getStaticPaths() {
  const allPosts = await getCollection('posts');
  return allPosts.map(post => ({
    params: { slug: post.data.slug || post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);

const allPosts = await getCollection('posts');
const posts = allPosts
  .filter(p => !p.data.draft)
  .sort((a, b) => {
    const orderA = a.data.order ?? 9999;
    const orderB = b.data.order ?? 9999;
    if (orderA !== orderB) return orderA - orderB;
    return new Date(b.data.publishDate).getTime() - new Date(a.data.publishDate).getTime();
  });

const CATEGORY_ORDER = [
  '內視鏡檢查', '超音波檢查', '肝膽胰疾病', '胃部疾病', '腸道疾病',
  '慢性病', '高血壓', '高血脂', '糖尿病', '減重',
  '健康飲食', '各種檢驗檢查', '藥物介紹', '肝病特區'
];

const categorizedPosts: Record<string, typeof posts> = {};
for (const p of posts) {
  const cat = p.data.category || '其他';
  if (!categorizedPosts[cat]) categorizedPosts[cat] = [];
  categorizedPosts[cat].push(p);
}

const sortedCategories = [
  ...CATEGORY_ORDER.filter(c => categorizedPosts[c]),
  ...Object.keys(categorizedPosts).filter(c => !CATEGORY_ORDER.includes(c))
];

const currentSlug = post.data.slug || post.id;
const currentCategory = post.data.category || '其他';
---

<Layout title={post.data.title} description={`${post.data.title} - 黃冠智醫師胃腸肝膽衛教筆記。`}>
  <div class="obsidian-workspace">
    <!-- 左側：Obsidian 風格側邊欄 -->
    <aside class="obs-sidebar" id="obsSidebar">
      <div class="sidebar-header">
        <div class="sidebar-title-row">
          <a href="/health-column" class="home-link" title="返回醫學筆記總覽">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
          </a>
          <span>醫學筆記目錄</span>
          <span class="post-count-badge">{posts.length}</span>
        </div>
        <div class="sidebar-search">
          <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
          <input type="text" id="sidebarSearch" placeholder="搜尋文章標題..." autocomplete="off" />
          <button id="sidebarSearchClear" class="search-clear" hidden>×</button>
        </div>
      </div>
      <nav class="file-tree" id="fileTree">
        {sortedCategories.map(cat => (
          <div class="folder-group" data-category={cat}>
            <button class="folder-btn" data-folder={cat}>
              <svg class="folder-chevron" width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="9 18 15 12 9 6"/></svg>
              <svg class="folder-icon-svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 20h16a2 2 0 0 0 2-2V8a2 2 0 0 0-2-2h-7.93a2 2 0 0 1-1.66-.9l-.82-1.2A2 2 0 0 0 7.93 3H4a2 2 0 0 0-2 2v13a2 2 0 0 0 2 2Z"/></svg>
              <span class="folder-name">{cat}</span>
              <span class="folder-count">{categorizedPosts[cat]?.length || 0}</span>
            </button>
            <div class="folder-contents" id={`folder-${cat}`}>
              {categorizedPosts[cat]?.map(p => (
                <a href={`/posts/${p.data.slug || p.id}`} class:list={['file-item', { active: (p.data.slug || p.id) === currentSlug }]} data-slug={p.data.slug || p.id} data-title={p.data.title.toLowerCase()} data-category={p.data.category}>
                  <svg class="file-icon" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/></svg>
                  <span class="file-name">{p.data.title}</span>
                </a>
              ))}
            </div>
          </div>
        ))}
      </nav>
      <button class="sidebar-close-btn" id="sidebarClose" aria-label="關閉側邊欄">×</button>
    </aside>
    <div class="sidebar-overlay" id="sidebarOverlay"></div>

    <!-- 右側：文章內容 -->
    <div class="obs-main">
      <button class="mobile-menu-btn" id="mobileMenuBtn" aria-label="開啟文章分類">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="18" x2="21" y2="18"/></svg>
        所有專欄目錄
      </button>
      <article class="article-detail">
        <nav class="article-breadcrumb" aria-label="Breadcrumb">
          <a href="/health-column">← 返回醫學筆記</a>
          <span class="divider">/</span>
          <span class="bc-cat">{currentCategory}</span>
          <span class="divider">/</span>
          <span class="current">{post.data.title}</span>
        </nav>
        <header class="article-header">
          <div class="article-meta">
            <span class="article-category">{post.data.category}</span>
          </div>
          <h1 class="article-title">{post.data.title}</h1>
          <div class="header-divider"></div>
        </header>
        <div class="article-content">
          <Content />
        </div>
        <footer class="article-footer">
          <div class="footer-card">
            <div class="doctor-mini-bio">
              <img src="https://static.wixstatic.com/media/f229cb_5dcb4100d96e46e1bab7ea4cb7062215~mv2.jpg" alt="黃冠智醫師" class="bio-avatar" />
              <div class="bio-text">
                <h3>黃冠智 醫師 審閱</h3>
                <p>現任豐田診所院長。本站文章皆為醫學實證衛教筆記，旨在推廣胃腸肝膽健康知識。若您有相關健康疑問，建議尋求專業醫師診斷諮詢。</p>
              </div>
            </div>
          </div>
          <div class="bottom-action">
            <a href="/health-column" class="back-btn">
              <span>← 返回專欄列表</span>
            </a>
          </div>
        </footer>
      </article>
    </div>
  </div>
</Layout>

<script define:vars={{ currentSlug, currentCategory }}>
  document.addEventListener('DOMContentLoaded', () => {
    const fileTree = document.getElementById('fileTree');
    const sidebarSearch = document.getElementById('sidebarSearch');
    const sidebarSearchClear = document.getElementById('sidebarSearchClear');
    const obsSidebar = document.getElementById('obsSidebar');
    const sidebarOverlay = document.getElementById('sidebarOverlay');
    const mobileMenuBtn = document.getElementById('mobileMenuBtn');
    const sidebarClose = document.getElementById('sidebarClose');
    const STORAGE_KEY = 'obs_folder_state';

    function getFolderState() { try { return JSON.parse(localStorage.getItem(STORAGE_KEY) || '{}'); } catch { return {}; } }
    function saveFolderState(state) { try { localStorage.setItem(STORAGE_KEY, JSON.stringify(state)); } catch {} }
    function setFolderOpen(fn, open) {
      const contents = document.getElementById('folder-' + fn);
      const btn = fileTree?.querySelector('[data-folder="' + fn + '"]');
      if (!contents || !btn) return;
      contents.classList.toggle('open', open);
      btn.classList.toggle('open', open);
    }

    const savedState = getFolderState();
    const folderBtns = fileTree?.querySelectorAll('.folder-btn');
    folderBtns?.forEach(btn => {
      const fn = btn.getAttribute('data-folder');
      if (!fn) return;
      const shouldOpen = (fn === currentCategory) || !!savedState[fn];
      setFolderOpen(fn, shouldOpen);
      btn.addEventListener('click', () => {
        const nowOpen = document.getElementById('folder-' + fn)?.classList.contains('open');
        setFolderOpen(fn, !nowOpen);
        const state = getFolderState(); state[fn] = !nowOpen; saveFolderState(state);
      });
    });

    const activeItem = fileTree?.querySelector('.file-item.active');
    activeItem?.scrollIntoView({ block: 'nearest' });

    sidebarSearch?.addEventListener('input', (e) => {
      const query = e.target.value.trim().toLowerCase();
      sidebarSearchClear?.toggleAttribute('hidden', !query);
      applySearch(query);
    });
    sidebarSearchClear?.addEventListener('click', () => {
      if (sidebarSearch) sidebarSearch.value = '';
      sidebarSearchClear?.setAttribute('hidden', 'true');
      applySearch('');
      sidebarSearch?.focus();
    });

    function applySearch(query) {
      const fileItems = fileTree?.querySelectorAll('.file-item');
      const folderGroups = fileTree?.querySelectorAll('.folder-group');
      if (!query) {
        fileItems?.forEach(item => item.removeAttribute('hidden'));
        folderGroups?.forEach(group => group.removeAttribute('hidden'));
        const state = getFolderState();
        folderBtns?.forEach(btn => { const fn = btn.getAttribute('data-folder'); if (fn) setFolderOpen(fn, (fn === currentCategory) || !!state[fn]); });
        return;
      }
      folderGroups?.forEach(group => {
        const catName = group.getAttribute('data-category') || '';
        const items = group.querySelectorAll('.file-item');
        let visible = 0;
        items.forEach(item => {
          const title = item.getAttribute('data-title') || '';
          const cat = (item.getAttribute('data-category') || '').toLowerCase();
          const matches = title.includes(query) || cat.includes(query);
          item.toggleAttribute('hidden', !matches);
          if (matches) visible++;
        });
        if (visible > 0) { group.removeAttribute('hidden'); setFolderOpen(catName, true); }
        else group.setAttribute('hidden', 'true');
      });
    }

    function openSidebar() { obsSidebar?.classList.add('mobile-open'); sidebarOverlay?.classList.add('active'); document.body.style.overflow = 'hidden'; }
    function closeSidebar() { obsSidebar?.classList.remove('mobile-open'); sidebarOverlay?.classList.remove('active'); document.body.style.overflow = ''; }
    mobileMenuBtn?.addEventListener('click', openSidebar);
    sidebarClose?.addEventListener('click', closeSidebar);
    sidebarOverlay?.addEventListener('click', closeSidebar);
  });
</script>

<style is:global>
  .article-content { color: var(--color-text-body, #2d4f63); font-size: 1.08rem; line-height: 1.85; letter-spacing: 0.3px; }
  .article-content h2 { color: var(--color-text-title, #1e3a4c); font-size: 1.55rem; font-weight: 800; margin: 38px 0 16px; padding-bottom: 8px; border-bottom: 2px solid var(--color-primary-light, #eef7f9); }
  .article-content h3 { color: var(--color-primary, #4a90a4); font-size: 1.25rem; font-weight: 800; margin: 28px 0 12px; }
  .article-content p { margin-bottom: 18px; text-align: justify; }
  .article-content ul, .article-content ol { margin-bottom: 22px; padding-left: 24px; }
  .article-content li { margin-bottom: 8px; }
  .article-content blockquote { background-color: var(--color-primary-light, #eef7f9); border-left: 4px solid var(--color-primary, #4a90a4); padding: 16px 24px; border-radius: 0 14px 14px 0; margin: 24px 0; color: #2d6575; font-weight: 500; }
  .article-content blockquote p { margin-bottom: 0; }
  .article-content table { width: 100%; border-collapse: collapse; margin: 26px 0; font-size: 0.96rem; border-radius: 12px; overflow: hidden; border: 1px solid var(--color-border, #d4e5eb); }
  .article-content th, .article-content td { padding: 12px 16px; border: 1px solid var(--color-border, #d4e5eb); text-align: left; }
  .article-content th { background-color: var(--color-bg-alt, #eef5f7); color: var(--color-text-title, #1e3a4c); font-weight: 800; }
  .article-content tr:nth-child(even) { background-color: rgba(74, 144, 164, 0.02); }
  .article-content img { max-width: 100%; height: auto; border-radius: 18px; margin: 24px auto; display: block; box-shadow: 0 8px 24px var(--color-shadow, rgba(74, 144, 164, 0.08)); border: 1px solid var(--color-border, #d4e5eb); }
  .article-content code { font-family: Consolas, Monaco, monospace; background-color: var(--color-primary-light, #eef7f9); color: var(--color-primary, #4a90a4); padding: 3px 8px; border-radius: 6px; font-size: 0.92em; font-weight: 700; }
</style>

<style>
  .obsidian-workspace { display: flex; gap: 0; height: calc(100vh - 180px); min-height: 650px; border-radius: 24px; overflow: hidden; box-shadow: 6px 6px 20px rgba(74, 144, 164, 0.08), -6px -6px 20px #ffffff; border: 1.5px solid var(--color-border, #d4e5eb); background: #FFFFFF; }
  .obs-sidebar { width: 280px; min-width: 240px; max-width: 280px; background-color: #f8fbfc; border-right: 1px solid var(--color-border, #d4e5eb); display: flex; flex-direction: column; overflow: hidden; flex-shrink: 0; position: relative; }
  .sidebar-header { padding: 16px 14px 12px; border-bottom: 1px solid var(--color-border, #d4e5eb); background-color: #FFFFFF; flex-shrink: 0; }
  .sidebar-title-row { display: flex; align-items: center; gap: 8px; color: var(--color-text-title, #1e3a4c); font-weight: 800; font-size: 0.92rem; margin-bottom: 12px; }
  .home-link { color: var(--color-primary, #4a90a4); display: flex; align-items: center; transition: opacity .2s; }
  .home-link:hover { opacity: 0.8; }
  .post-count-badge { margin-left: auto; background-color: var(--color-primary-light, #eef7f9); color: var(--color-primary, #4a90a4); font-size: 0.74rem; padding: 2px 8px; border-radius: 9999px; font-weight: 800; }
  .sidebar-search { position: relative; display: flex; align-items: center; }
  .sidebar-search svg { position: absolute; left: 10px; color: var(--color-text-muted, #5a7a8a); pointer-events: none; }
  #sidebarSearch { width: 100%; padding: 8px 28px 8px 30px; border-radius: 9999px; border: 1px solid var(--color-border, #d4e5eb); background-color: #FFFFFF; font-family: inherit; font-size: 0.84rem; color: var(--color-text-body, #2d4f63); outline: none; transition: border-color .2s; }
  #sidebarSearch:focus { border-color: var(--color-primary, #4a90a4); }
  #sidebarSearch::placeholder { color: #8ba5b5; }
  .search-clear { position: absolute; right: 10px; background: none; border: none; font-size: 1.1rem; color: var(--color-text-muted, #5a7a8a); cursor: pointer; padding: 0 2px; line-height: 1; }
  .search-clear:hover { color: var(--color-primary, #4a90a4); }
  .file-tree { flex: 1; overflow-y: auto; overflow-x: hidden; padding: 10px 8px; scrollbar-width: thin; scrollbar-color: var(--color-border) transparent; }
  .file-tree::-webkit-scrollbar { width: 4px; }
  .file-tree::-webkit-scrollbar-thumb { background: var(--color-border); border-radius: 3px; }
  .folder-group { margin-bottom: 2px; }
  .folder-btn { display: flex; align-items: center; gap: 6px; width: 100%; padding: 6px 10px; background: none; border: none; cursor: pointer; font-family: inherit; font-size: 0.86rem; font-weight: 700; color: var(--color-text-title, #1e3a4c); text-align: left; border-radius: 8px; transition: background-color .15s; }
  .folder-btn:hover { background-color: rgba(74, 144, 164, 0.08); color: var(--color-primary, #4a90a4); }
  .folder-chevron { flex-shrink: 0; color: var(--color-text-muted, #5a7a8a); transition: transform .2s; }
  .folder-btn.open .folder-chevron { transform: rotate(90deg); }
  .folder-icon-svg { flex-shrink: 0; color: var(--color-text-muted, #5a7a8a); }
  .folder-name { flex: 1; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .folder-count { flex-shrink: 0; font-size: 0.72rem; color: var(--color-text-muted, #5a7a8a); background-color: rgba(0, 0, 0, 0.04); padding: 1px 6px; border-radius: 9999px; }
  .folder-contents { display: none; padding-left: 20px; }
  .folder-contents.open { display: block; }
  .file-item { display: flex; align-items: center; gap: 6px; padding: 5px 8px; border-radius: 8px; font-size: 0.83rem; color: var(--color-text-body, #2d4f63); text-decoration: none; transition: all .15s; margin: 1px 0; }
