  .back-btn { display: inline-flex; align-items: center; gap: 6px; padding: 12px 32px; border-radius: 9999px; background: linear-gradient(135deg, var(--color-primary, #4a90a4), #5ba3b8); color: #FFFFFF; font-weight: 700; box-shadow: 0 4px 14px rgba(74, 144, 164, 0.35); text-decoration: none; transition: transform .2s, box-shadow .2s; }
