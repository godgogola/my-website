  .sidebar-close-btn { display: none; position: absolute; top: 12px; right: 12px; background: none; border: none; font-size: 1.4rem; color: var(--color-text-muted, #5a7a8a); cursor: pointer; }
  .sidebar-overlay { display: none; position: fixed; inset: 0; background: rgba(30, 58, 76, 0.4); backdrop-filter: blur(3px); z-index: 99; opacity: 0; transition: opacity .25s; }
  .sidebar-overlay.active { display: block; opacity: 1; }

  @media (max-width: 768px) {
    .obsidian-workspace { height: auto; min-height: auto; flex-direction: column; border-radius: 20px; }
    .obs-sidebar { position: fixed; top: 0; left: -100%; height: 100vh; z-index: 100; width: 300px; max-width: 85vw; border-radius: 0 20px 20px 0; transition: left .3s cubic-bezier(.4,0,.2,1); }
    .obs-sidebar.mobile-open { left: 0; box-shadow: 6px 0 36px rgba(0, 0, 0, .2); }
    .sidebar-close-btn { display: block; }
    .obs-main { width: 100%; }
    .mobile-menu-btn { display: flex; font-size: 0.95rem; }
    .article-detail { padding: 16px 18px 48px; }
    .article-title { font-size: 1.85rem; line-height: 1.35; }
    .article-content { font-size: 1.12rem; line-height: 1.85; }
    .doctor-mini-bio { flex-direction: column; text-align: center; }
    .article-breadcrumb .current { max-width: 160px; }
  }
</style>