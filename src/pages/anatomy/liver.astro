      ]);
      vesselGroupPortal.add(new THREE.Mesh(new THREE.TubeGeometry(lpvCurve, 24, 0.17, 14, false), pvMat));

      const p2Curve = new THREE.CatmullRomCurve3([
        new THREE.Vector3(1.3, -0.2, 0.0),
