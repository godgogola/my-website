    /**
     * Gemini 4 Argon: Organic Segment Geometry Generator (~23,600 Total Vertices Across S1-S8)
     */
    function createSolidSegmentGeometry(config, key) {
      const nx = 24, ny = 24, nz = 16;
      const geom = new THREE.BoxGeometry(1.0, 1.0, 1.0, nx, ny, nz);
      const pos = geom.attributes.position;
      const v = new THREE.Vector3();

      const xi0 = config.xiRange ? config.xiRange[0] : THREE.MathUtils.clamp(config.xRange[0] / 3.2, -1.0, 1.0);
      const xi1 = config.xiRange ? config.xiRange[1] : THREE.MathUtils.clamp(config.xRange[1] / 2.7, -1.0, 1.0);
      const eta0 = config.etaRange ? config.etaRange[0] : (config.yRange[0] < 0 ? -1.0 : 0.0);
      const eta1 = config.etaRange ? config.etaRange[1] : (config.yRange[1] > 0 ? 1.0 : 0.0);

      for (let i = 0; i < pos.count; i++) {
        v.fromBufferAttribute(pos, i);

        const uLoc = v.x * 2.0;
        const vLoc = v.y * 2.0;
        const wLoc = v.z * 2.0;

        // ── Special Organic Sculpting for S1 (Caudate / Spigelian Lobe) ──
        if (key === 's1') {
          const u2 = uLoc * uLoc, v2 = vLoc * vLoc, w2 = wLoc * wLoc;
          const sx = uLoc * Math.sqrt(Math.max(0.02, 1.0 - 0.5 * v2 - 0.5 * w2 + 0.33 * v2 * w2));
          const sy = vLoc * Math.sqrt(Math.max(0.02, 1.0 - 0.5 * u2 - 0.5 * w2 + 0.33 * u2 * w2));
          const sz = wLoc * Math.sqrt(Math.max(0.02, 1.0 - 0.5 * u2 - 0.5 * v2 + 0.33 * u2 * v2));

          const caudateProcess = (sy < 0.0 && sx < 0.0) ? -0.18 * (1.0 + sy) * (-sx) : 0.0;
          const px = -0.06 + sx * 0.46 + caudateProcess - 0.06 * sy;
          const py = 0.62 + sy * 0.56;
          const pz = -0.82 + sz * 0.32 - 0.10 * (1.0 - sy * sy);

          pos.setXYZ(i, px, py, pz);
          continue;
        }

        // ── Map local cube [-1, 1] to global normalized liver coordinates (xi, eta, zeta) ──
        const tXi = (uLoc + 1.0) * 0.5;
        const tEta = (vLoc + 1.0) * 0.5;
        const xi = THREE.MathUtils.lerp(xi0, xi1, tXi);
        const eta = THREE.MathUtils.lerp(eta0, eta1, tEta);
        const zeta = wLoc;

        const distToInternalEdge = Math.min(1.0 - Math.abs(uLoc), 1.0 - Math.abs(vLoc));
        const edgeBevelFactor = 1.0 - 0.022 * Math.exp(-distToInternalEdge * 14.0) * (1.0 - wLoc * wLoc);

        const mapped = evaluateGlobalLiverHull(xi, eta, zeta, edgeBevelFactor);
        pos.setXYZ(i, mapped.x, mapped.y, mapped.z);
      }

      computeWeldedSmoothNormals(geom);
      return geom;
    }

    /**
     * Gemini 4 Argon: Living Hepatic Parenchyma Material (SSS + Glisson's Capsule Sheen)
     */
    function createHepaticParenchymaMaterial(initialOpacity) {
      const mat = new THREE.MeshPhysicalMaterial({
        color: 0xa83828,            // Deep oxygenated hepatic parenchyma base
        roughness: 0.26,            // Moist visceral surface
        metalness: 0.02,
        clearcoat: 0.88,            // Glistening Glisson's serous capsule
        clearcoatRoughness: 0.14,
        reflectivity: 0.75,
        transparent: true,
        opacity: initialOpacity !== undefined ? initialOpacity : 1.0,
        side: THREE.DoubleSide
      });

      mat.userData.sssUniforms = {
        uSSSColor: { value: new THREE.Color(0xe63926) },     // Warm arterial subsurface scatter
        uDeepParenchyma: { value: new THREE.Color(0x52100c) }, // Deep venous hepatic core
        uCapsuleFresnel: { value: new THREE.Color(0xffd6cc) }, // Wet serosal rim highlight
        uSSSIntensity: { value: 0.68 }
      };

      mat.onBeforeCompile = function (shader) {
        Object.assign(shader.uniforms, mat.userData.sssUniforms);

        shader.vertexShader = shader.vertexShader
          .replace(
            '#include <common>',
            `#include <common>
             varying vec3 vHepaticLocalPos;
             varying vec3 vHepaticWorldPos;`
          )
          .replace(
            '#include <worldpos_vertex>',
            `#include <worldpos_vertex>
             vHepaticLocalPos = position;
             vHepaticWorldPos = (modelMatrix * vec4(transformed, 1.0)).xyz;`
          );

        shader.fragmentShader = shader.fragmentShader
          .replace(
            '#include <common>',
            `#include <common>
             uniform vec3 uSSSColor;
             uniform vec3 uDeepParenchyma;
             uniform vec3 uCapsuleFresnel;
             uniform float uSSSIntensity;
             varying vec3 vHepaticLocalPos;
             varying vec3 vHepaticWorldPos;

             float hepaticHash(vec3 p) {
               p = fract(p * 0.3183099 + 0.1);
               p *= 17.0;
               return fract(p.x * p.y * p.z * (p.x + p.y + p.z));
             }
             float hepaticLobuleNoise(vec3 x) {
               vec3 i = floor(x);
               vec3 f = fract(x);
               f = f * f * (3.0 - 2.0 * f);
               return mix(
                 mix(mix(hepaticHash(i + vec3(0,0,0)), hepaticHash(i + vec3(1,0,0)), f.x),
                     mix(hepaticHash(i + vec3(0,1,0)), hepaticHash(i + vec3(1,1,0)), f.x), f.y),
                 mix(mix(hepaticHash(i + vec3(0,0,1)), hepaticHash(i + vec3(1,0,1)), f.x),
                     mix(hepaticHash(i + vec3(0,1,1)), hepaticHash(i + vec3(1,1,1)), f.x), f.y),
                 f.z
               );
             }`
          )
          .replace(
            '#include <normal_fragment_maps>',
            `#include <normal_fragment_maps>
             float lobuleMicro = hepaticLobuleNoise(vHepaticLocalPos * 14.0) * 0.65
                               + hepaticLobuleNoise(vHepaticLocalPos * 29.0) * 0.35;
             vec3 dLobule = vec3(dFdx(lobuleMicro), dFdy(lobuleMicro), 0.0);
             normal = normalize(normal - dLobule * 0.085);`
          )
          .replace(
            '#include <dithering_fragment>',
            `// ── Subsurface Scattering (SSS) & Glisson's Capsule Serosal Reflex ──
             vec3 viewDir = normalize(vViewPosition);
             vec3 nDir = normalize(normal);

             vec3 keyLightDir = normalize(vec3(0.45, 0.65, 0.62));
             vec3 fillLightDir = normalize(vec3(-0.55, -0.25, 0.78));

             float wrapKey = max(0.0, (dot(nDir, keyLightDir) + 0.55) / 1.55);
             float wrapFill = max(0.0, (dot(nDir, fillLightDir) + 0.45) / 1.45);
             float terminatorMask = smoothstep(0.0, 0.55, wrapKey) * (1.0 - smoothstep(0.45, 0.95, max(0.0, dot(nDir, keyLightDir))));

             float radialThinness = clamp((length(vHepaticLocalPos.xy) - 0.8) * 0.38, 0.18, 0.92);
             vec3 backLightVec = -keyLightDir + nDir * 0.35;
             float backScatter = pow(clamp(dot(viewDir, backLightVec), 0.0, 1.0), 2.8) * radialThinness;

             float lobulePattern = hepaticLobuleNoise(vHepaticLocalPos * 12.0);
             vec3 tissueMottle = mix(uDeepParenchyma, uSSSColor, 0.38 + 0.32 * lobulePattern);

             vec3 sssContribution = uSSSColor * (terminatorMask * 0.52 + backScatter * 0.75 + wrapFill * 0.14) * uSSSIntensity
                                  + tissueMottle * 0.09;

             float ndotv = clamp( abs(dot(nDir, viewDir)), 0.0, 1.0 );
             float wetFresnel = pow(1.0 - ndotv, 3.4);
             vec3 capsuleSheen = uCapsuleFresnel * wetFresnel * 0.24;

             float emissiveStrength = length(totalEmissiveRadiance);
             vec3 selectionRim = emissiveStrength > 0.01
               ? totalEmissiveRadiance * pow(1.0 - ndotv, 2.0) * 0.85
               : vec3(0.0);

             gl_FragColor.rgb += sssContribution + capsuleSheen + selectionRim;

             #include <dithering_fragment>`
          );
      };

      return mat;
    }

    function build3DSolidSegments() {
      const initOpacity = typeof currentOpacity !== 'undefined' ? currentOpacity : 1.0;

      Object.keys(segmentSolidConfigs).forEach(key => {
        const config = segmentSolidConfigs[key];
        const geom = createSolidSegmentGeometry(config, key);
        const mat = createHepaticParenchymaMaterial(initOpacity);
        const mesh = new THREE.Mesh(geom, mat);
        mesh.userData = { segmentId: key };

        mesh.onBeforeRender = function () {
          const transparentMode = this.material.opacity < 0.95;
          if (this.material.depthWrite === transparentMode) {
            this.material.depthWrite = !transparentMode;
          }
        };

        basePositions[key] = new THREE.Vector3(0, 0, 0);
        explodeVectors[key] = config.dir.clone();

        scene.add(mesh);
        segmentMeshes[key] = mesh;

        const sprite = createTextSprite(config.label);
        sprite.position.set(config.labelOffset[0], config.labelOffset[1], config.labelOffset[2]);
        mesh.add(sprite);
        segmentLabelSprites[key] = sprite;
      });
    }

    function createTextSprite(text) {
      const canvas = document.createElement('canvas');
      canvas.width = 256;
      canvas.height = 128;
      const ctx = canvas.getContext('2d');
      ctx.fillStyle = 'rgba(10, 18, 36, 0.8)';
      ctx.beginPath();
      ctx.roundRect(16, 16, 224, 96, 24);
      ctx.fill();
      ctx.strokeStyle = '#00e5ff';
      ctx.lineWidth = 5;
      ctx.stroke();

      ctx.font = 'bold 56px Plus Jakarta Sans, sans-serif';
      ctx.fillStyle = '#ffffff';
      ctx.textAlign = 'center';
      ctx.textBaseline = 'middle';
      ctx.fillText(text, 128, 64);

      const texture = new THREE.CanvasTexture(canvas);
      const spriteMat = new THREE.SpriteMaterial({ map: texture, transparent: true, depthTest: false });
      const sprite = new THREE.Sprite(spriteMat);
      sprite.scale.set(0.85, 0.42, 1);
      return sprite;
    }

    /**
     * Gemini 4 Argon: Generates an organically curved, anatomically tapered 3D blood vessel geometry
     * using non-linear Murray's Law physiological vessel tapering and smooth hemispherical tip closure.
     */
    function createTaperedTubeGeometry(curve, tubularSegments, radiusStart, radiusEnd, radialSegments = 14, capTip = true) {
      const geom = new THREE.TubeGeometry(curve, tubularSegments, 1.0, radialSegments, false);
      const pos = geom.attributes.position;
      const ringStride = radialSegments + 1;
      const centerPt = new THREE.Vector3();
      const vertexPt = new THREE.Vector3();

      for (let i = 0; i <= tubularSegments; i++) {
        const t = i / tubularSegments;
        curve.getPointAt(t, centerPt);

        // Non-linear Murray's Law physiological vessel tapering
        let radius = THREE.MathUtils.lerp(radiusStart, radiusEnd, Math.pow(t, 0.85));

        // Smooth hemispherical tip closure on the final 6% of terminal branches
        if (capTip && t > 0.94) {
          const tipT = (t - 0.94) / 0.06;
          radius *= Math.sqrt(Math.max(0.0, 1.0 - tipT * tipT));
        }

        const baseIdx = i * ringStride;
        for (let j = 0; j < ringStride; j++) {
          const idx = baseIdx + j;
          vertexPt.fromBufferAttribute(pos, idx);
          vertexPt.sub(centerPt).multiplyScalar(radius).add(centerPt);
          pos.setXYZ(idx, vertexPt.x, vertexPt.y, vertexPt.z);
        }
      }

      geom.computeVertexNormals();
      return geom;
    }

    function build3DVessels() {
      vesselGroupHepatic = new THREE.Group();
      vesselGroupPortal = new THREE.Group();

      const hepaticVeinMat = new THREE.MeshPhysicalMaterial({
        color: 0x1e68e8,
        emissive: 0x082259,
        roughness: 0.28,
        clearcoat: 0.75,
        clearcoatRoughness: 0.2
      });

      const portalVeinMat = new THREE.MeshPhysicalMaterial({
        color: 0xa8329b,
        emissive: 0x33092f,
        roughness: 0.28,
        clearcoat: 0.75,
        clearcoatRoughness: 0.2
      });

      const addVesselTo = (group, pts, rStart, rEnd, mat, segs = 36, capTip = true) => {
        const curve = new THREE.CatmullRomCurve3(pts.map(p => new THREE.Vector3(p[0], p[1], p[2])), false, 'centripetal');
        const geom = createTaperedTubeGeometry(curve, segs, rStart, rEnd, 14, capTip);
        const mesh = new THREE.Mesh(geom, mat);
        group.add(mesh);
        return mesh;
      };

      // ── 1. HEPATIC VEINS (Blue - Intersegmental Scissurae Drainage to Suprahepatic IVC) ──
      // Retrohepatic Inferior Vena Cava (IVC)
      addVesselTo(vesselGroupHepatic, [
        [-0.32, -1.55, -0.98], [-0.36, -0.45, -0.92], [-0.35, 0.55, -0.82], [-0.30, 1.55, -0.65]
      ], 0.26, 0.29, hepaticVeinMat, 32, false);

      // Right Hepatic Vein (RHV - runs in right scissura between S7/S6 and S8/S5)
      addVesselTo(vesselGroupHepatic, [
        [-0.34, 1.32, -0.62], [-0.88, 0.95, -0.35], [-1.32, 0.35, -0.10],
        [-1.58, -0.38, 0.05], [-1.95, -1.05, 0.12]
      ], 0.13, 0.022, hepaticVeinMat, 40, true);
      // RHV Superior S7 Tributary
      addVesselTo(vesselGroupHepatic, [
        [-1.02, 0.78, -0.28], [-1.65, 0.92, -0.22], [-2.25, 0.82, -0.10]
      ], 0.068, 0.016, hepaticVeinMat, 24, true);

      // Middle Hepatic Vein (MHV - runs along Cantlie's line x ≈ 0 between S8/S5 and S4)
      addVesselTo(vesselGroupHepatic, [
        [-0.22, 1.30, -0.58], [-0.10, 0.85, -0.15], [-0.04, 0.20, 0.18],
        [-0.08, -0.52, 0.32], [-0.18, -1.12, 0.35]
      ], 0.12, 0.020, hepaticVeinMat, 40, true);

      // Left Hepatic Vein (LHV - drains S2/S3 & S4a along left scissura)
      addVesselTo(vesselGroupHepatic, [
        [-0.18, 1.30, -0.58], [0.42, 1.02, -0.25], [0.98, 0.58, 0.02],
        [1.52, 0.15, 0.14], [1.98, -0.35, 0.18]
      ], 0.11, 0.020, hepaticVeinMat, 36, true);
      // LHV S2 Superior Tributary
      addVesselTo(vesselGroupHepatic, [
        [0.72, 0.82, -0.12], [1.38, 0.72, 0.05], [1.95, 0.55, 0.10]
      ], 0.062, 0.015, hepaticVeinMat, 24, true);

      scene.add(vesselGroupHepatic);

      // ── 2. PORTAL VENOUS TREE (Magenta-Violet - Intrasegmental Supply P1-P8) ──
      // Main Portal Vein Trunk (MPV -> Porta Hepatis Bifurcation)
      addVesselTo(vesselGroupPortal, [
        [0.28, -1.35, -0.62], [0.15, -0.75, -0.42], [0.0, -0.18, -0.22]
      ], 0.17, 0.145, portalVeinMat, 28, false);

      // Right Portal Vein (RPV Trunk)
      addVesselTo(vesselGroupPortal, [
        [0.0, -0.18, -0.22], [-0.52, -0.10, -0.12], [-0.95, -0.04, -0.05]
      ], 0.135, 0.105, portalVeinMat, 24, false);

      // P8 (Right Anterior Superior -> S8)
      addVesselTo(vesselGroupPortal, [
        [-0.68, -0.08, -0.08], [-0.65, 0.38, 0.25], [-0.62, 0.88, 0.48]
      ], 0.085, 0.018, portalVeinMat, 28, true);

      // P5 (Right Anterior Inferior -> S5)
      addVesselTo(vesselGroupPortal, [
        [-0.68, -0.08, -0.08], [-0.68, -0.52, 0.28], [-0.72, -1.02, 0.45]
      ], 0.082, 0.018, portalVeinMat, 28, true);

      // P7 (Right Posterior Superior -> S7)
      addVesselTo(vesselGroupPortal, [
        [-0.95, -0.04, -0.05], [-1.62, 0.28, -0.18], [-2.22, 0.75, -0.15]
      ], 0.088, 0.018, portalVeinMat, 30, true);

      // P6 (Right Posterior Inferior -> S6)
      addVesselTo(vesselGroupPortal, [
        [-0.95, -0.04, -0.05], [-1.65, -0.38, -0.15], [-2.25, -0.88, -0.05]
      ], 0.085, 0.018, portalVeinMat, 30, true);

      // Left Portal Vein (LPV Transverse + Umbilical Portion at Rex Recess)
      addVesselTo(vesselGroupPortal, [
        [0.0, -0.18, -0.22], [0.55, -0.04, -0.12], [0.95, 0.02, 0.12], [1.02, -0.22, 0.35]
      ], 0.12, 0.075, portalVeinMat, 28, true);

      // P1 (Caudate Branch -> S1)
      addVesselTo(vesselGroupPortal, [
        [0.22, -0.10, -0.20], [0.05, 0.28, -0.58], [-0.05, 0.62, -0.82]
      ], 0.048, 0.014, portalVeinMat, 20, true);

      // P4a & P4b (Medial Branches -> S4a / S4b)
      addVesselTo(vesselGroupPortal, [
        [0.88, 0.0, 0.08], [0.58, 0.38, 0.32], [0.48, 0.72, 0.45]
      ], 0.062, 0.016, portalVeinMat, 24, true);
      addVesselTo(vesselGroupPortal, [
        [0.95, -0.12, 0.24], [0.62, -0.48, 0.42], [0.48, -0.82, 0.48]
      ], 0.062, 0.016, portalVeinMat, 24, true);

      // P2 (Left Lateral Superior -> S2)
      addVesselTo(vesselGroupPortal, [
        [0.92, 0.02, 0.08], [1.45, 0.28, 0.12], [1.98, 0.48, 0.14]
      ], 0.075, 0.016, portalVeinMat, 26, true);

      // P3 (Left Lateral Inferior -> S3)
      addVesselTo(vesselGroupPortal, [
        [0.98, -0.15, 0.28], [1.48, -0.35, 0.26], [1.95, -0.48, 0.20]
      ], 0.075, 0.016, portalVeinMat, 26, true);

      scene.add(vesselGroupPortal);
    }

    function buildFalciformLigament() {
      const geom = new THREE.PlaneGeometry(0.12, 2.5, 8, 8);
      const pos = geom.attributes.position;
      for (let i = 0; i < pos.count; i++) {
        const y = pos.getY(i);
        pos.setZ(i, Math.sin((y + 1.2) * 1.4) * 0.35 + 0.4);
      }
      geom.computeVertexNormals();

      const mat = new THREE.MeshStandardMaterial({
        color: 0xe2e8f0,
        roughness: 0.3,
        transparent: true,
        opacity: 0.65,
        side: THREE.DoubleSide
      });

      falciformMesh = new THREE.Mesh(geom, mat);
      falciformMesh.position.set(1.15, 0.0, 0.3);
      scene.add(falciformMesh);
    }

    function onExplodeSlider(val) {
      const factor = val / 100.0;
      const txt = document.getElementById('txt-explode-val');
      if (txt) txt.textContent = `${val}%`;

      Object.keys(segmentMeshes).forEach(key => {
        const mesh = segmentMeshes[key];
        const dir = explodeVectors[key];
        mesh.position.x = dir.x * factor * 1.4;
        mesh.position.y = dir.y * factor * 1.4;
        mesh.position.z = dir.z * factor * 1.4;
      });
    }

    function onOpacitySlider(val) {
      currentOpacity = val / 100.0;
      const txt = document.getElementById('txt-opacity-val');
      if (txt) txt.textContent = `${val}%`;
      Object.keys(segmentMeshes).forEach(key => {
        segmentMeshes[key].material.opacity = currentOpacity;
      });
    }

    function toggleVesselLayer(type) {
      if (type === 'pv') {
        vesselGroupPortal.visible = !vesselGroupPortal.visible;
        document.getElementById('btn-toggle-pv')?.classList.toggle('active', vesselGroupPortal.visible);
      } else if (type === 'hv') {
        vesselGroupHepatic.visible = !vesselGroupHepatic.visible;
        document.getElementById('btn-toggle-hv')?.classList.toggle('active', vesselGroupHepatic.visible);
      }
    }

    function selectSegment(id) {
      if (isQuizMode) {
        handleQuizClick(id);
        return;
      }

      selectedId = id;
      const data = couinaudData[id];
      if (!data) return;

      document.querySelectorAll('.seg-card-btn').forEach(btn => btn.classList.remove('active'));
      const activeBtn = document.getElementById(`btn-seg-${id}`);
      if (activeBtn) activeBtn.classList.add('active');

      Object.keys(segmentMeshes).forEach(key => {
        const mesh = segmentMeshes[key];
        if (key === id) {
          mesh.material.emissive.setHex(0x00e5ff);
          mesh.material.emissiveIntensity = 0.55;
          mesh.material.opacity = Math.max(currentOpacity, 0.95);
        } else {
          mesh.material.emissive.setHex(0x000000);
          mesh.material.emissiveIntensity = 0.0;
          mesh.material.opacity = currentOpacity;
        }
      });

      const pill = document.getElementById('det-pill');
      if (pill) pill.textContent = `Segment ${data.arabic}`;
      document.getElementById('det-sector').textContent = data.sector;
      document.getElementById('det-title-zh').textContent = data.titleZh;
      document.getElementById('det-title-en').textContent = data.titleEn;
      document.getElementById('det-vessel-in').textContent = data.vesselIn;
      document.getElementById('det-vessel-out').textContent = data.vesselOut;
      document.getElementById('det-sector-name').textContent = data.sectorName;
      document.getElementById('det-us-view').textContent = data.usView;
      document.getElementById('det-surgical-box').innerHTML = data.surgical;
      document.getElementById('det-phrase-text').textContent = data.phrase;

      const pearlsList = document.getElementById('det-pearls-list');
      if (pearlsList) {
        pearlsList.innerHTML = '';
        data.pearls.forEach(text => {
          const item = document.createElement('div');
          item.className = 'pearl-item';
          item.innerHTML = `
            <svg width="14" height="14" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/></svg>
            <span>${text}</span>
          `;
          pearlsList.appendChild(item);
        });
      }
    }

    function setPresetView(preset) {
      document.querySelectorAll('.view-btn').forEach(b => b.classList.remove('active'));
      document.getElementById(`view-btn-${preset}`)?.classList.add('active');

      const isMobile = window.innerWidth <= 1150;
      let targetPos = new THREE.Vector3(0, isMobile ? 0.9 : 0.2, isMobile ? 13.5 : 8.8);
      let targetLook = new THREE.Vector3(0, isMobile ? 0.8 : 0, 0);

      switch(preset) {
        case 'anterior': targetPos.set(0, isMobile ? 0.9 : 0.2, isMobile ? 13.5 : 8.8); break;
        case 'visceral': targetPos.set(0, isMobile ? -0.5 : -1.0, isMobile ? -13.0 : -8.8); targetLook.set(0, isMobile ? 0.5 : 0.1, 0.0); break;
        case 'right_lat': targetPos.set(isMobile ? -13.0 : -8.8, isMobile ? 0.9 : 0.5, 0.0); break;
        case 'left_lat': targetPos.set(isMobile ? 13.0 : 8.8, isMobile ? 0.6 : 0.2, 0.0); break;
        case 'superior': targetPos.set(0, isMobile ? 13.0 : 8.8, 0.5); break;
        case 'subcostal': targetPos.set(-4.5, isMobile ? -4.8 : -5.5, isMobile ? 9.0 : 5.8); break;
      }

      new TWEEN.Tween(camera.position).to(targetPos, 850).easing(TWEEN.Easing.Cubic.Out).start();
      new TWEEN.Tween(controls.target).to(targetLook, 850).easing(TWEEN.Easing.Cubic.Out).start();
    }

    function reset3DCamera() {
      setPresetView('anterior');
      const slider = document.getElementById('slider-explode');
      if (slider) slider.value = 30;
      onExplodeSlider(30);
      selectSegment('s6');
      showToast('已重設為 3D 正面標準視角');
    }

    function onWindowResize() {
      const container = document.getElementById('threejs-canvas-container');
      if (!container || !renderer || !camera) return;
      const width = container.clientWidth;
      const height = container.clientHeight;
      if (width > 0 && height > 0) {
        camera.aspect = width / height;
        camera.updateProjectionMatrix();
        renderer.setSize(width, height);
      }
    }

    // Mobile Segmented Drawer / Tab Switching
    function switchMobileTab(tab) {
      document.querySelectorAll('.mobile-tab-btn').forEach(b => b.classList.remove('active'));
      document.getElementById(`tab-btn-${tab}`)?.classList.add('active');

      const regionsPane = document.getElementById('pane-regions-pathology');
      const detailsPane = document.getElementById('pane-clinical-details');

      if (window.innerWidth <= 1150) {
        if (tab === 'regions') {
          if (regionsPane) regionsPane.style.display = 'flex';
          if (detailsPane) detailsPane.style.display = 'none';
        } else if (tab === 'details') {
          if (regionsPane) regionsPane.style.display = 'none';
          if (detailsPane) detailsPane.style.display = 'flex';
        }
      }
