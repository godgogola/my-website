    // Global 3D State
    let scene, camera, renderer, controls;
    let segmentMeshes = {};
    let segmentLabelSprites = {};
    let basePositions = {};
    let explodeVectors = {};
    let vesselGroupPortal, vesselGroupHepatic, falciformMesh;
    let selectedId = 's6';
    let isQuizMode = false, quizTarget = null;
    let raycaster, mouse;
    let currentOpacity = 0.88;

    function getLiver3DDepth(x, y) {
      const xFactor = x < 0 ? (1.0 - Math.pow(x / 3.6, 2) * 0.35) : Math.max(0.15, 1.0 - Math.pow(x / 2.8, 1.3) * 0.85);
      const yFactor = 1.0 - Math.pow(y / 1.8, 2) * 0.4;
      const baseThickness = 1.45 * xFactor * Math.max(0.2, yFactor);

      const zAnt = baseThickness * (0.85 + Math.cos(x * 0.5) * 0.15);
      let zPost = -baseThickness * 0.95;
      if (x < -1.0 && y < 0.0) zPost += 0.25;
      if (Math.abs(x) < 0.4 && y > 0.0) zPost -= 0.15;

      return { zAnt, zPost };
    }

    const segmentSolidConfigs = {
      s7: { xRange: [-3.2, -1.3], yRange: [0.0, 1.6], dir: new THREE.Vector3(-1.0, 0.7, -0.5), label: '7', labelOffset: [-2.2, 0.9, 0.9] },
      s8: { xRange: [-1.3, 0.0], yRange: [0.0, 1.6], dir: new THREE.Vector3(-0.3, 0.8, 0.4), label: '8', labelOffset: [-0.65, 1.0, 1.1] },
      s4: { xRange: [0.0, 1.1], yRange: [-1.5, 1.4], dir: new THREE.Vector3(0.4, 0.4, 0.2), label: '4', labelOffset: [0.55, 0.0, 0.9] },
      s2: { xRange: [1.1, 2.7], yRange: [0.0, 1.1], dir: new THREE.Vector3(1.1, 0.7, -0.2), label: '2', labelOffset: [1.8, 0.6, 0.5] },
      s6: { xRange: [-3.2, -1.3], yRange: [-1.7, 0.0], dir: new THREE.Vector3(-1.0, -0.7, -0.5), label: '6', labelOffset: [-2.2, -0.9, 0.8] },
      s5: { xRange: [-1.3, 0.0], yRange: [-1.7, 0.0], dir: new THREE.Vector3(-0.3, -0.8, 0.4), label: '5', labelOffset: [-0.65, -0.9, 1.0] },
      s3: { xRange: [1.1, 2.7], yRange: [-1.4, 0.0], dir: new THREE.Vector3(1.1, -0.6, 0.2), label: '3', labelOffset: [1.8, -0.6, 0.5] },
      s1: { xRange: [-0.5, 0.4], yRange: [0.1, 1.2], dir: new THREE.Vector3(0.0, 0.1, -1.1), label: '1', labelOffset: [0.0, 0.65, -1.25] }
    };

    function init3D() {
      const container = document.getElementById('threejs-canvas-container');
      if (!container) return;

      const width = container.clientWidth || (window.innerWidth > 1150 ? window.innerWidth - 720 : window.innerWidth);
      const height = container.clientHeight || (window.innerHeight - 130);

      // 1. Scene & Camera
      const isMobile = window.innerWidth <= 768;
      scene = new THREE.Scene();
      camera = new THREE.PerspectiveCamera(40, width / height, 0.1, 100);
      camera.position.set(0, 0.2, isMobile ? 12.5 : 8.8);

      // 2. WebGL Renderer
      renderer = new THREE.WebGLRenderer({ antialias: true, alpha: true });
      renderer.setSize(width, height);
      renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
      renderer.shadowMap.enabled = true;
      renderer.shadowMap.type = THREE.PCFSoftShadowMap;
      container.appendChild(renderer.domElement);

      // 3. Orbit Controls
      controls = new THREE.OrbitControls(camera, renderer.domElement);
      controls.enableDamping = true;
      controls.dampingFactor = 0.06;
      controls.minDistance = 3.5;
      controls.maxDistance = 24;
      controls.target.set(0, 0, 0);

      // 4. Lighting
      const ambientLight = new THREE.AmbientLight(0xffffff, 0.65);
      scene.add(ambientLight);

      const mainLight = new THREE.DirectionalLight(0xfff3e0, 1.1);
      mainLight.position.set(6, 8, 8);
      scene.add(mainLight);

      const rimLight = new THREE.DirectionalLight(0x00e5ff, 0.85);
      rimLight.position.set(-8, -4, -6);
      scene.add(rimLight);

      const visceralLight = new THREE.DirectionalLight(0x93c5fd, 0.75);
      visceralLight.position.set(0, -6, -8);
      scene.add(visceralLight);

      // 5. Build Meshes & Vessels
      build3DSolidSegments();
      build3DVessels();
      buildFalciformLigament();

      // 6. Raycast
      raycaster = new THREE.Raycaster();
      mouse = new THREE.Vector2();
      renderer.domElement.addEventListener('pointerdown', onPointerDown);

      // 7. Auto-Resize Observer
      const resizeObserver = new ResizeObserver(() => onWindowResize());
      resizeObserver.observe(container);
      window.addEventListener('resize', onWindowResize);

      // Init explode and selection
      onExplodeSlider(30);
      selectSegment('s6');

      setTimeout(onWindowResize, 100);

      // Animation Loop
      animate();
    }

    function createSolidSegmentGeometry(config, key) {
      const x0 = config.xRange[0], x1 = config.xRange[1];
      const y0 = config.yRange[0], y1 = config.yRange[1];
      
      const nx = 12, ny = 12, nz = 8;
      const geom = new THREE.BoxGeometry(x1 - x0, y1 - y0, 1.0, nx, ny, nz);
      
      const cx = (x0 + x1) * 0.5;
      const cy = (y0 + y1) * 0.5;
      geom.translate(cx, cy, 0);

      const pos = geom.attributes.position;
      const v = new THREE.Vector3();

      for (let i = 0; i < pos.count; i++) {
        v.fromBufferAttribute(pos, i);

        if (key === 's1') {
          v.z = -0.7 + v.z * 0.45;
          v.x = v.x * 0.9;
          pos.setXYZ(i, v.x, v.y, v.z);
          continue;
        }

        const depth = getLiver3DDepth(v.x, v.y);
        const zNorm = v.z + 0.5;
        v.z = depth.zPost + zNorm * (depth.zAnt - depth.zPost);

        if (v.y > 0.0) {
          const domeLimit = 1.6 * (v.x < 0 ? (1.0 - Math.pow(v.x / 3.6, 2) * 0.3) : Math.max(0.2, 1.0 - (v.x / 2.7) * 0.8));
          v.y = Math.min(v.y, domeLimit);
        } else {
          const botLimit = -1.65 * (v.x < 0 ? (1.0 - Math.pow(v.x / 3.6, 2) * 0.3) : Math.max(0.15, 1.0 - (v.x / 2.7) * 0.85));
          v.y = Math.max(v.y, botLimit);
        }

        pos.setXYZ(i, v.x, v.y, v.z);
      }

      geom.computeVertexNormals();
      return geom;
    }

    function build3DSolidSegments() {
      const liverMatConfig = {
        color: 0xc4573b,
        roughness: 0.32,
        metalness: 0.05,
        clearcoat: 0.6,
        clearcoatRoughness: 0.25,
        transparent: true,
        opacity: currentOpacity,
        side: THREE.DoubleSide
      };

      Object.keys(segmentSolidConfigs).forEach(key => {
        const config = segmentSolidConfigs[key];
        const geom = createSolidSegmentGeometry(config, key);
        const mat = new THREE.MeshPhysicalMaterial(Object.assign({}, liverMatConfig));
        
        const mesh = new THREE.Mesh(geom, mat);
        mesh.userData = { segmentId: key };
        
        basePositions[key] = new THREE.Vector3(0, 0, 0);
        explodeVectors[key] = config.dir.clone();

        scene.add(mesh);
        segmentMeshes[key] = mesh;

        const sprite = createTextSprite(config.label);
        sprite.position.set(config.labelOffset[0], config.labelOffset[1], config.labelOffset[2]);
        mesh.add(sprite);
        segmentLabelSprites[key] = sprite;
      });
    }

    function createTextSprite(text) {
      const canvas = document.createElement('canvas');
      canvas.width = 256;
      canvas.height = 128;
      const ctx = canvas.getContext('2d');
      ctx.fillStyle = 'rgba(10, 18, 36, 0.8)';
      ctx.beginPath();
      ctx.roundRect(16, 16, 224, 96, 24);
      ctx.fill();
      ctx.strokeStyle = '#00e5ff';
      ctx.lineWidth = 5;
      ctx.stroke();

      ctx.font = 'bold 56px Plus Jakarta Sans, sans-serif';
      ctx.fillStyle = '#ffffff';
      ctx.textAlign = 'center';
      ctx.textBaseline = 'middle';
      ctx.fillText(text, 128, 64);

      const texture = new THREE.CanvasTexture(canvas);
      const spriteMat = new THREE.SpriteMaterial({ map: texture, transparent: true, depthTest: false });
      const sprite = new THREE.Sprite(spriteMat);
      sprite.scale.set(0.85, 0.42, 1);
      return sprite;
    }

    function build3DVessels() {
      vesselGroupHepatic = new THREE.Group();
      const hvMat = new THREE.MeshStandardMaterial({
        color: 0x2563eb,
        roughness: 0.2,
        metalness: 0.3,
        emissive: 0x1d4ed8,
        emissiveIntensity: 0.45
      });

      const ivcGeom = new THREE.CylinderGeometry(0.35, 0.32, 5.2, 24);
      const ivcMesh = new THREE.Mesh(ivcGeom, hvMat);
      ivcMesh.position.set(-0.1, 0.1, -1.05);
      vesselGroupHepatic.add(ivcMesh);

      const rhvCurve = new THREE.CatmullRomCurve3([
        new THREE.Vector3(-0.1, 1.4, -0.9),
        new THREE.Vector3(-0.8, 1.3, -0.4),
        new THREE.Vector3(-1.6, 0.5, -0.3),
        new THREE.Vector3(-2.1, -0.3, -0.2)
      ]);
      vesselGroupHepatic.add(new THREE.Mesh(new THREE.TubeGeometry(rhvCurve, 32, 0.16, 12, false), hvMat));

      const mhvCurve = new THREE.CatmullRomCurve3([
        new THREE.Vector3(-0.1, 1.4, -0.9),
        new THREE.Vector3(0.0, 0.9, -0.1),
        new THREE.Vector3(-0.1, 0.1, 0.4),
        new THREE.Vector3(-0.2, -0.8, 0.5)
      ]);
      vesselGroupHepatic.add(new THREE.Mesh(new THREE.TubeGeometry(mhvCurve, 32, 0.17, 12, false), hvMat));

      const lhvCurve = new THREE.CatmullRomCurve3([
        new THREE.Vector3(-0.1, 1.4, -0.9),
        new THREE.Vector3(0.6, 1.1, -0.3),
        new THREE.Vector3(1.3, 0.6, 0.0),
        new THREE.Vector3(1.9, 0.1, 0.1)
      ]);
      vesselGroupHepatic.add(new THREE.Mesh(new THREE.TubeGeometry(lhvCurve, 32, 0.15, 12, false), hvMat));
      scene.add(vesselGroupHepatic);

      vesselGroupPortal = new THREE.Group();
      const pvMat = new THREE.MeshStandardMaterial({
        color: 0x00e5ff,
        roughness: 0.15,
        metalness: 0.2,
        emissive: 0x00d2ff,
        emissiveIntensity: 0.85
      });

      const pvTrunkCurve = new THREE.CatmullRomCurve3([
        new THREE.Vector3(0.3, -2.4, 0.3),
        new THREE.Vector3(0.1, -1.2, 0.1),
        new THREE.Vector3(0.0, -0.3, 0.0)
      ]);
      vesselGroupPortal.add(new THREE.Mesh(new THREE.TubeGeometry(pvTrunkCurve, 24, 0.24, 16, false), pvMat));

      const rpvCurve = new THREE.CatmullRomCurve3([
        new THREE.Vector3(0.0, -0.3, 0.0),
        new THREE.Vector3(-0.8, -0.2, 0.0),
        new THREE.Vector3(-1.6, -0.2, -0.1)
      ]);
      vesselGroupPortal.add(new THREE.Mesh(new THREE.TubeGeometry(rpvCurve, 24, 0.19, 14, false), pvMat));

      const p8Curve = new THREE.CatmullRomCurve3([
        new THREE.Vector3(-0.8, -0.2, 0.0),
        new THREE.Vector3(-0.7, 0.7, 0.3)
      ]);
      vesselGroupPortal.add(new THREE.Mesh(new THREE.TubeGeometry(p8Curve, 16, 0.11, 10, false), pvMat));

      const p5Curve = new THREE.CatmullRomCurve3([
        new THREE.Vector3(-0.8, -0.2, 0.0),
        new THREE.Vector3(-0.7, -0.9, 0.4)
      ]);
      vesselGroupPortal.add(new THREE.Mesh(new THREE.TubeGeometry(p5Curve, 16, 0.11, 10, false), pvMat));

      const p7Curve = new THREE.CatmullRomCurve3([
        new THREE.Vector3(-1.6, -0.2, -0.1),
        new THREE.Vector3(-1.8, 0.6, -0.3)
      ]);
      vesselGroupPortal.add(new THREE.Mesh(new THREE.TubeGeometry(p7Curve, 16, 0.11, 10, false), pvMat));

      const p6Curve = new THREE.CatmullRomCurve3([
        new THREE.Vector3(-1.6, -0.2, -0.1),
        new THREE.Vector3(-1.9, -0.8, -0.3)
      ]);
      vesselGroupPortal.add(new THREE.Mesh(new THREE.TubeGeometry(p6Curve, 16, 0.11, 10, false), pvMat));

      const lpvCurve = new THREE.CatmullRomCurve3([
        new THREE.Vector3(0.0, -0.3, 0.0),
        new THREE.Vector3(0.6, -0.2, 0.1),
