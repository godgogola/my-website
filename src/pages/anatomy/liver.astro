    /**
     * Gemini 4 Argon: Anatomical 3D Field, Depth Math & Spatial Normal Welding
     */
    function getLiver3DDepth(x, y) {
      const nx = THREE.MathUtils.clamp((x + 0.25) / 2.95, -1.0, 1.0);
      const ny = THREE.MathUtils.clamp(y / 1.65, -1.0, 1.0);
      const radialSq = THREE.MathUtils.clamp(nx * nx * 0.85 + ny * ny * 0.85, 0.0, 0.98);
      const shell = Math.sqrt(1.0 - radialSq);

      // Right lobe is thick AP; left lateral segment tapers into a thin tongue
      const rightBias = nx < 0.0 ? (1.0 - nx * 0.22) : Math.max(0.28, 1.0 - Math.pow(nx, 1.35) * 0.72);
      // Inferior border (margo inferior) tapers more acutely than superior dome
      const infTaper = ny < 0.0 ? Math.max(0.32, 1.0 + ny * 0.55) : (1.0 - ny * 0.12);
      const halfThick = 1.32 * shell * rightBias * infTaper;

      // Anterior diaphragmatic convexity vs posterior visceral concavity (renal/gastric impressions)
      const antBulge = 0.18 * Math.cos(nx * 1.2) * (1.0 - ny * ny * 0.4);
      const renalImpression = (nx < -0.25 && ny < 0.15)
        ? 0.28 * Math.exp(-Math.pow((nx + 0.62) / 0.38, 2) - Math.pow((ny + 0.35) / 0.45, 2))
        : 0.0;
      const cavalSulcus = (Math.abs(nx + 0.12) < 0.35 && ny > -0.1)
        ? -0.18 * Math.exp(-Math.pow((nx + 0.12) / 0.2, 2) - Math.pow((ny - 0.45) / 0.5, 2))
        : 0.0;

      const zAnt = halfThick * 0.96 + antBulge;
      const zPost = -halfThick * 0.92 + renalImpression + cavalSulcus;
      return { zAnt, zPost };
    }

    function smoothStep(edge0, edge1, x) {
      const t = THREE.MathUtils.clamp((x - edge0) / (edge1 - edge0), 0.0, 1.0);
      return t * t * (3.0 - 2.0 * t);
    }

    /**
     * Evaluates the continuous 3D anatomical coordinates for any normalized point
     * in the global liver domain. Adjacent segments fit together with 0.0000 seam error.
     */
    function evaluateGlobalLiverHull(xi, eta, zeta, edgeBevelFactor) {
      // 1. Physiological Scissurae Warping
      const ivcConvergence = 0.08 * (eta * 0.5 + 0.5) * (1.0 - xi * xi) * (0.5 - zeta * 0.3);
      const portalArch = 0.09 * Math.exp(-xi * xi * 1.8) * (1.0 - eta * eta)
                       - 0.06 * xi * (1.0 - xi * xi) * (1.0 - eta * eta);

      const wXi = THREE.MathUtils.clamp(xi + ivcConvergence, -1.0, 1.0);
      const wEta = THREE.MathUtils.clamp(eta + portalArch, -1.0, 1.0);
      const wZeta = THREE.MathUtils.clamp(zeta, -1.0, 1.0);

      // 2. Asymmetric Spherified-Cube Mapping
      const xi2 = wXi * wXi;
      const eta2 = wEta * wEta;
      const zeta2 = wZeta * wZeta;

      const zRoundness = wEta < 0.0 ? 0.38 : 0.48;
      const sXi = wXi * Math.sqrt(Math.max(0.04, 1.0 - 0.42 * eta2 - 0.36 * zeta2 + 0.24 * eta2 * zeta2));
      const sEta = wEta * Math.sqrt(Math.max(0.04, 1.0 - 0.38 * xi2 - zRoundness * zeta2 + 0.22 * xi2 * zeta2));
      const sZeta = wZeta * Math.sqrt(Math.max(0.02, 1.0 - 0.48 * xi2 - 0.48 * eta2 + 0.30 * xi2 * eta2));

      // 3. Map sXi [-1, 1] -> Anatomical X [-3.25, 2.75]
      const x = sXi < 0.0 ? sXi * 3.25 : sXi * 2.75;

      // 4. Anatomical Superior & Inferior Contours
      const rightDome = 1.68 * Math.exp(-Math.pow((sXi + 0.42) / 0.78, 2));
      const leftSuperior = 1.12 * Math.max(0.12, 1.0 - Math.pow(Math.max(0.0, sXi + 0.15) / 1.18, 1.45));
      const cardiacDip = -0.14 * Math.exp(-Math.pow((sXi - 0.12) / 0.28, 2));
      const yTop = Math.max(0.22, rightDome * 0.55 + leftSuperior * 0.68 + cardiacDip);

      const rightInfDepth = -1.72 * (1.0 - 0.22 * Math.pow(Math.min(0.0, sXi + 0.35), 2));
      const obliqueSlope = smoothStep(-0.55, 0.95, sXi);
      const leftApexY = -0.18;
      const gbNotch = 0.14 * Math.exp(-Math.pow((sXi + 0.02) / 0.14, 2));
      const umbNotch = 0.08 * Math.exp(-Math.pow((sXi - 0.38) / 0.10, 2));
      const yBot = THREE.MathUtils.lerp(rightInfDepth, leftApexY, obliqueSlope) + gbNotch + umbNotch;

      const eta01 = (sEta + 1.0) * 0.5;
      let y = THREE.MathUtils.lerp(yBot, yTop, eta01);

      // 5. Anterior-Posterior Thickness & Visceral Topography (Z)
      const latThickness = sXi < 0.0
        ? (1.05 - 0.18 * Math.pow(-sXi, 1.6))
        : Math.max(0.22, Math.pow(1.0 - sXi * 0.78, 1.35));

      const verticalWedge = sEta < 0.0
        ? Math.pow(1.0 + sEta * 0.68, 1.15)
        : (1.0 - 0.12 * sEta * sEta);

      const halfDepth = 1.38 * latThickness * verticalWedge;

      const costalWrap = -0.22 * Math.pow(Math.max(0.0, -sXi - 0.2), 1.5);
      const renalFossa = (sXi < -0.15 && sEta < 0.25 && sZeta < 0.0)
        ? 0.34 * (-sZeta) * Math.exp(-Math.pow((sXi + 0.58) / 0.36, 2) - Math.pow((sEta + 0.32) / 0.45, 2))
        : 0.0;
      const gastricFossa = (sXi > 0.25 && sZeta < 0.0)
        ? 0.20 * (-sZeta) * Math.exp(-Math.pow((sXi - 0.62) / 0.35, 2) - Math.pow((sEta + 0.15) / 0.55, 2))
        : 0.0;

      let z = sZeta * halfDepth + costalWrap + renalFossa + gastricFossa;
      z *= edgeBevelFactor;

      return new THREE.Vector3(x, y, z);
    }

    /**
     * Welds duplicate BoxGeometry face-edge normals by spatial proximity so the 6 faces
     * of each segment shade as one seamless organic surface without crease lines.
     */
    function computeWeldedSmoothNormals(geom) {
      geom.computeVertexNormals();
      const pos = geom.attributes.position;
      const norm = geom.attributes.normal;
      const count = pos.count;

      const map = new Map();
      const precision = 10000;

      for (let i = 0; i < count; i++) {
        const kx = Math.round(pos.getX(i) * precision);
        const ky = Math.round(pos.getY(i) * precision);
        const kz = Math.round(pos.getZ(i) * precision);
        const key = `${kx}_${ky}_${kz}`;

        let bucket = map.get(key);
        if (!bucket) {
          bucket = { nx: 0, ny: 0, nz: 0, indices: [] };
          map.set(key, bucket);
        }
        bucket.nx += norm.getX(i);
        bucket.ny += norm.getY(i);
        bucket.nz += norm.getZ(i);
        bucket.indices.push(i);
      }

      map.forEach(bucket => {
        const len = Math.hypot(bucket.nx, bucket.ny, bucket.nz) || 1.0;
        const nx = bucket.nx / len;
        const ny = bucket.ny / len;
        const nz = bucket.nz / len;
        for (let j = 0; j < bucket.indices.length; j++) {
          const idx = bucket.indices[j];
          norm.setXYZ(idx, nx, ny, nz);
        }
      });

      norm.needsUpdate = true;
    }

