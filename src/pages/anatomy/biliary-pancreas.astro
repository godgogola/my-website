    // Liver Opacity Slider Action
    function onLiverOpacitySlider(val) {
      currentLiverOpacity = val / 100.0;
      const txt = document.getElementById('txt-liver-opacity-val');
      if (txt) txt.textContent = `${val}%`;
      if (liverMaterial) liverMaterial.opacity = currentLiverOpacity;
