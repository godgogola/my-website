---
import Layout from '../../layouts/Layout.astro';
---

<Layout 
  title="肝膽胰與十二指腸 3D 互動解剖系統 | 互動解剖圖鑑 - 黃冠智醫師" 
  description="醫學教科書標準 3D 肝膽胰與十二指腸解剖模型。完整呈現肝右葉左葉與鐮狀韌帶、膽囊與膽囊管、總膽管 (CBD)、小葉腺泡質地胰臟與主副胰管、十二指腸壺腹 (Ampulla of Vater) 以及臨床病灶標記。"
  fullWidth={true}
  hideFooter={true}
>
  <!-- Three.js CDN dependencies -->
  <script is:inline src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js"></script>
  <script is:inline src="https://cdn.jsdelivr.net/npm/three@0.128.0/examples/js/controls/OrbitControls.js"></script>
  <script is:inline src="https://cdnjs.cloudflare.com/ajax/libs/tween.js/18.6.4/tween.umd.js"></script>

  <div class="hbp-app-wrapper" id="hbpAppWrapper">
    <!-- Subheader with breadcrumb & action controls -->
    <div class="anatomy-subnav">
      <div class="subnav-left">
        <a href="/anatomy" class="back-link">
          <svg width="15" height="15" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path d="M19 12H5M12 19l-7-7 7-7"/></svg>
          <span>圖鑑總覽</span>
        </a>
        <div class="divider">/</div>
        <div class="current-badge">
          <span class="pulse-dot"></span>
          <span>肝膽胰與十二指腸 (3D 解剖模型)</span>
        </div>
      </div>
      
      <div class="subnav-right">
        <!-- Fullscreen Button -->
        <button class="btn btn-fullscreen" id="btn-fullscreen-toggle" onclick="toggleFullScreen()" title="進入/退出全螢幕診間衛教模式">
          <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" id="icon-fs"><path d="M8 3H5a2 2 0 0 0-2 2v3m18 0V5a2 2 0 0 0-2-2h-3m0 18h3a2 2 0 0 0 2-2v-3M3 16v3a2 2 0 0 0 2 2h3"/></svg>
          <span class="btn-text-full">全螢幕</span>
        </button>
        <button class="btn btn-outline" id="btn-toggle-quiz" onclick="toggleQuizMode()">
          <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M9 11l3 3L22 4"/><path d="M21 12v7a2 2 0 01-2 2H5a2 2 0 01-2-2V5a2 2 0 012-2h11"/></svg>
          <span class="btn-text-full">3D 測驗</span>
        </button>
        <button class="btn btn-primary" onclick="reset3DCamera()">
          <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M3 12a9 9 0 1 0 9-9 9.75 9.75 0 0 0-6.74 2.74L3 8"/><path d="M3 3v5h5"/></svg>
          <span>重設</span>
        </button>
      </div>
    </div>

    <!-- Main 3-Column Workspace Grid -->
    <div class="workspace-grid">

      <!-- Mobile Tab Switcher Navigation -->
      <div class="mobile-tabs-nav">
        <button class="mobile-tab-btn active" id="tab-btn-regions" onclick="switchMobileTab('regions')">
          📍 器官構造 (8)
        </button>
        <button class="mobile-tab-btn" id="tab-btn-pathology" onclick="switchMobileTab('pathology')">
          🩺 4大病灶
        </button>
        <button class="mobile-tab-btn" id="tab-btn-details" onclick="switchMobileTab('details')">
          📋 超音波報告片語
        </button>
      </div>

      <!-- Left Panel: Pathology Toggles, Opacity & Segment Navigator (Column 1 on Desktop) -->
      <div class="glass-panel left-panel mobile-tab-pane" id="pane-regions-pathology">
        <div class="panel-header">
          <div class="panel-title">
            <svg width="16" height="16" fill="none" stroke="#f59e0b" stroke-width="2" viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 3"/></svg>
            解剖導航與臨床病灶標記
          </div>
        </div>
        
        <div class="panel-body">
          
          <!-- 4 Major Pathology Marker Toggles -->
          <div class="control-row pathology-section-box">
            <div class="section-label" style="margin-bottom: 0.45rem; color: #f59e0b;">
              肝膽胰常見病灶 (點擊在 3D 空間呈現)
            </div>
            <div class="pathology-btn-grid">
              <button class="btn btn-pathology" id="btn-path-gallstone" onclick="togglePathology('gallstone')">
                <span class="path-dot dot-gallstone"></span>
                膽囊結石與息肉
              </button>
              <button class="btn btn-pathology" id="btn-path-cbdstone" onclick="togglePathology('cbdstone')">
                <span class="path-dot dot-cbdstone"></span>
                總膽管結石 (CBD)
              </button>
              <button class="btn btn-pathology" id="btn-path-ampulla" onclick="togglePathology('ampulla')">
                <span class="path-dot dot-ampulla"></span>
                十二指腸壺腹嵌頓
              </button>
              <button class="btn btn-pathology" id="btn-path-pancreatitis" onclick="togglePathology('pancreatitis')">
                <span class="path-dot dot-pancreatitis"></span>
                急性胰臟炎/腫瘤
              </button>
            </div>
            <div class="pathology-info-text" id="pathology-info-text">
              點選上方按鈕可即時切換病灶位置與臨床處置說明。
            </div>
          </div>

          <!-- Segment List -->
          <div class="section-label">
            點選解剖器官與構造 (ANATOMICAL STRUCTURES)
          </div>
          <div class="segment-grid-list">
            <div class="seg-card-btn" onclick="selectSegment('liver')" id="btn-seg-liver">
              <div class="seg-card-top">
                <span class="seg-num-pill">左葉/右葉/鐮狀韌帶</span>
                <span class="seg-loc-tag">右上腹穹隆</span>
              </div>
              <div class="seg-card-name">肝臟 (Liver / Hepar)</div>
            </div>

            <div class="seg-card-btn" onclick="selectSegment('gallbladder')" id="btn-seg-gallbladder">
              <div class="seg-card-top">
                <span class="seg-num-pill">底/體/頸/螺旋管</span>
                <span class="seg-loc-tag">肝下膽囊窩</span>
              </div>
              <div class="seg-card-name">膽囊與膽囊管 (Gallbladder)</div>
            </div>

            <div class="seg-card-btn" onclick="selectSegment('biliary_tree')" id="btn-seg-biliary_tree">
              <div class="seg-card-top">
                <span class="seg-num-pill">左右肝管/總膽管</span>
                <span class="seg-loc-tag">膽道匯流通路</span>
              </div>
              <div class="seg-card-name">膽道系統 (Biliary Tree)</div>
            </div>

            <div class="seg-card-btn active" onclick="selectSegment('pancreas')" id="btn-seg-pancreas">
              <div class="seg-card-top">
                <span class="seg-num-pill">腺泡小葉顆粒質地</span>
                <span class="seg-loc-tag">腹膜後橫行</span>
              </div>
              <div class="seg-card-name">胰臟 (Pancreas)</div>
            </div>

            <div class="seg-card-btn" onclick="selectSegment('pancreatic_duct')" id="btn-seg-pancreatic_duct">
              <div class="seg-card-top">
                <span class="seg-num-pill">主胰管與副胰管</span>
                <span class="seg-loc-tag">胰液排泄主幹</span>
              </div>
              <div class="seg-card-name">胰管系統 (Pancreatic Ducts)</div>
            </div>

            <div class="seg-card-btn" onclick="selectSegment('ampulla')" id="btn-seg-ampulla">
              <div class="seg-card-top">
                <span class="seg-num-pill">奧狄氏括約肌/乳頭</span>
                <span class="seg-loc-tag">十二指腸降段</span>
              </div>
              <div class="seg-card-name">十二指腸壺腹 (Ampulla)</div>
            </div>

            <div class="seg-card-btn" onclick="selectSegment('duodenum')" id="btn-seg-duodenum">
              <div class="seg-card-top">
                <span class="seg-num-pill">C-Loop 環抱</span>
                <span class="seg-loc-tag">小腸起始段</span>
              </div>
              <div class="seg-card-name">十二指腸 (Duodenum)</div>
            </div>

            <div class="seg-card-btn" onclick="selectSegment('vessels')" id="btn-seg-vessels">
              <div class="seg-card-top">
                <span class="seg-num-pill">下腔靜脈/脾動脈</span>
                <span class="seg-loc-tag">大血管供應</span>
              </div>
              <div class="seg-card-name">後腹腔血管 (Vessels)</div>
            </div>
          </div>

        </div>
      </div>

      <!-- Center Stage: Three.js True 3D Hepatobiliary-Pancreatic Canvas (Column 2 on Desktop) -->
      <div class="glass-panel canvas-panel">
        <!-- Preset View Angles Toolbar -->
        <div class="view-angles-toolbar">
          <button class="view-btn active" id="view-btn-anterior" onclick="setPresetView('anterior')">正面全覽</button>
          <button class="view-btn" id="view-btn-ampulla" onclick="setPresetView('ampulla')">壺腹匯流特寫</button>
          <button class="view-btn" id="view-btn-gallbladder" onclick="setPresetView('gallbladder')">膽囊膽管特寫</button>
          <button class="view-btn" id="view-btn-pancreas" onclick="setPresetView('pancreas')">胰臟胰管視角</button>
          <button class="view-btn" id="view-btn-posterior" onclick="setPresetView('posterior')">後腹膜大血管</button>
        </div>

        <!-- ThreeJS Canvas Container -->
        <div id="threejs-canvas-container"></div>

        <!-- Orbit Controls Guidance Hint (Top Right) -->
        <div class="orbit-hint hide-mobile">
          <svg width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><path d="M12 8v8M8 12h8"/></svg>
          <span><strong>滑鼠左鍵拖曳</strong>：360° 空間自由旋轉 ｜ <strong>滾輪</strong>：拉近縮放 ｜ <strong>點擊器官/按鈕</strong>：聚焦解剖構造</span>
        </div>

        <!-- Opacity Control Bar (Embedded at Bottom of Center 3D Stage on Desktop & Mobile) -->
        <div class="canvas-opacity-bar">
          <div class="control-row opacity-card" style="margin-bottom: 0;">
            <div class="control-label-group">
              <span style="color: #f59e0b; font-weight: 800; display: flex; align-items: center; gap: 0.35rem;">
                <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><path d="M12 2a10 10 0 0 1 0 20z"/></svg>
                肝臟透明度 (Liver Opacity)
              </span>
              <span id="txt-liver-opacity-val" class="slider-val">85%</span>
            </div>
            <input type="range" id="slider-liver-opacity" min="0" max="100" value="85" oninput="onLiverOpacitySlider(this.value)">
            <div class="slider-subtext-single">
              降低透明度可直接透視下方膽管樹 (CBD) 與胰管走向
            </div>
          </div>
        </div>
      </div>

      <!-- Right Panel: Clinical Information & Hepatobiliary-Pancreatic Guide (Column 3 on Desktop) -->
      <div class="glass-panel right-panel mobile-tab-pane" id="pane-clinical-details">
        <div class="panel-header">
          <div class="panel-title">
            <svg width="16" height="16" fill="none" stroke="#f59e0b" stroke-width="2" viewBox="0 0 24 24"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/><polyline points="10 9 9 9 8 9"/></svg>
            肝膽胰臨床指引與超音波特徵
          </div>
        </div>
        
        <div class="panel-body" id="detail-panel">
          
          <!-- Header Title Info -->
          <div class="detail-title-group">
            <div style="display: flex; align-items: center; gap: 0.45rem; margin-bottom: 0.3rem;">
              <span id="det-pill" class="seg-badge-pill">腹膜後深層腺體</span>
              <span id="det-sector" class="sector-tag">Pancreas · Duct of Wirsung</span>
            </div>
            <div id="det-title-zh" class="main-title">胰臟 (Pancreas)</div>
            <div id="det-title-en" class="sub-title">Pancreas · Caput, Corpus, Cauda · Islets</div>
          </div>

          <!-- Metric Grid -->
          <div class="metric-grid">
            <div class="metric-box">
              <div class="metric-label">解剖分區</div>
              <div id="det-regions" class="metric-value">胰頭 (Head)、胰頸 (Neck)、胰體 (Body)、胰尾 (Tail)</div>
            </div>
            <div class="metric-box">
              <div class="metric-label">主要生理功能</div>
              <div id="det-function" class="metric-value">消化酵素 (外分泌) / 胰島素 (內分泌)</div>
            </div>
            <div class="metric-box">
              <div class="metric-label">超音波掃描特徵</div>
              <div id="det-endofeature" class="metric-value">逗號形 (Comma shape)，小葉顆粒狀均勻質地</div>
            </div>
            <div class="metric-box">
              <div class="metric-label">常見疾病好發</div>
              <div id="det-disease" class="metric-value">急性/慢性胰臟炎、胰臟囊腫、胰臟頭部腺癌</div>
            </div>
          </div>

          <!-- Clinical Pearls Box -->
          <div class="surgical-pearls" id="det-pearls-box">
            <strong>臨床診療重點：</strong> 胰臟深居後腹膜腔，橫臥於脊椎前方。表面覆蓋豐富的腺泡小葉（Acinar lobules）。胰頭被十二指腸 C-loop 緊密環抱，胰尾則指向脾門。主胰管（Duct of Wirsung）直徑正常小於 2~3mm，若伴隨總膽管同時擴張（雙管徵象 Double-duct sign），需高度警惕胰頭部腫瘤！
          </div>

          <!-- Clinical Pearls List -->
          <div class="detail-card">
            <h3>
              <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M12 2v20M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg>
              門診解說與超音波指引 (Clinical Pearls)
            </h3>
            <div id="det-pearls-list">
              <div class="pearl-item">
                <svg width="14" height="14" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/></svg>
                <span><strong>腹膜後「沉默的器官」</strong>：初期胰臟病灶多無明顯症狀，常藉由腹部超音波排查主胰管有無不正常擴張或囊腫。</span>
              </div>
              <div class="pearl-item">
                <svg width="14" height="14" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/></svg>
                <span><strong>急性胰臟炎警訊</strong>：暴飲暴食或膽結石掉落嵌頓於壺腹時，易引發胰液逆流自體消化，伴隨劇烈上腹痛且放射至後背。</span>
              </div>
            </div>
          </div>

          <!-- Automatic Medical Phrase Generator -->
          <div class="phrase-box">
            <div class="phrase-header">
              <span class="phrase-title">超音波與門診報告片語 (點擊即複製)</span>
              <button class="btn btn-outline" style="padding: 0.18rem 0.5rem; font-size: 0.68rem;" onclick="copyPhrase()">複製片語</button>
            </div>
            <div id="det-phrase-text" class="phrase-content">
              Abdominal Sonography: Pancreas shows homogenous parenchymal echogenicity without focal mass lesion. Main pancreatic duct is non-dilated (caliber < 2mm). Common bile duct caliber: 5.2mm.
            </div>
          </div>

        </div>
      </div>

    </div>
  </div>

  <!-- Toast Notification -->
  <div id="toast">
    <svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path d="M20 6L9 17l-5-5"/></svg>
    <span id="toast-msg">已複製片語至剪貼簿！</span>
  </div>

  <script is:inline>
    // Hepatobiliary & Pancreatic Anatomical Knowledge Database
    const hbpData = {
      liver: {
        titleZh: '肝臟 (Liver / Hepar)',
        titleEn: 'Hepar · Right & Left Lobes · Falciform Ligament',
        pill: '右葉、左葉與鐮狀韌帶',
        regions: '肝右葉 (Right lobe)、肝左葉 (Left lobe)、鐮狀韌帶 (Falciform ligament)',
        function: '製造膽汁 (Bile)、代謝合成、解毒、儲存肝醣',
        endofeature: '細緻均勻中等回音，下緣緊鄰膽囊窩與肝門部',
        disease: '脂肪肝、病毒性肝炎、肝硬化、肝細胞癌 (HCC)、血管瘤',
        sector: 'Right Hypochondrium & Epigastrium',
        pearlsBox: '<strong>臨床超音波重點：</strong> 肝臟分為較大的右葉與較扁平的左葉，由前方的 <strong>鐮狀韌帶 (Falciform ligament)</strong> 清晰分隔。肝細胞製造膽汁後，經由左右肝管在肝門部匯流入總肝管。',
        pearls: [
          '<strong>超音波肝門三合體（Mickey Mouse sign）</strong>：短軸切面可見門靜脈（頭）、肝動脈（右耳）與總膽管（左耳）。',
          '<strong>膽汁排泄通路</strong>：肝細胞製造膽汁 $\\to$ 膽微管 $\\to$ 左右肝管 $\\to$ 總肝管 $\\to$ 膽囊儲存濃縮。'
        ],
        phrase: 'Abdominal Sonography: Liver right and left lobes visualized with homogeneous parenchymal echogenicity. Falciform ligament and portal triad are unremarkable. No focal space-occupying lesion.'
      },
      gallbladder: {
        titleZh: '膽囊與膽囊管 (Gallbladder & Cystic Duct)',
        titleEn: 'Vesica biliaris & Ductus cysticus',
        pill: '梨形膽汁濃縮庫',
        regions: '膽囊底部 (Fundus)、體部 (Body)、頸部 (Neck)、螺旋膽囊管 (Cystic duct)',
        function: '貯存並濃縮膽汁 (達 5~10 倍)，進食油脂時收縮排空',
        endofeature: '無回音液體腔（Anechoic），薄壁 (< 3mm)',
        disease: '膽囊結石 (Gallstones)、膽囊息肉 (GB Polyp)、急性/慢性膽囊炎、膽囊腺肌增生症',
        sector: 'Subhepatic Fossa',
        pearlsBox: '<strong>臨床超音波重點：</strong> 膽囊呈典型梨形，懸掛於肝右葉下方的膽囊窩。膽囊底部常微微突出於肝臟前下緣。膽囊管內具有螺旋狀的 <strong>Heister 螺旋瓣（Spiral valves of Heister）</strong>，微小結石通過時容易卡在膽囊頸（Hartmann\'s pouch）引發急性膽絞痛。',
        pearls: [
          '<strong>膽結石三大超音波特徵 (WES triad)</strong>：強回音亮點 (Bright echo)、後方聲影 (Acoustic shadow)、隨體位移動 (Gravity-dependent shift)。',
          '<strong>超音波墨菲氏徵象 (Sonographic Murphy\'s sign)</strong>：探頭直接壓迫發炎之膽囊時引發劇烈疼痛與吸氣中斷，為急性膽囊炎之特異指標。'
        ],
        phrase: 'Abdominal Sonography: Gallbladder is well distended with smooth wall (< 3mm). No mobile acoustic shadowing calculus or intraluminal polyp noted. Sonographic Murphy sign: Negative.'
      },
      biliary_tree: {
        titleZh: '膽道系統與總膽管 (Biliary Tree & CBD)',
        titleEn: 'Ductus hepaticus & Ductus choledochus (CBD)',
        pill: '膽汁輸送高速公路',
        regions: '左/右肝管 (LHD/RHD)、總肝管 (CHD)、膽囊管 (Cystic duct)、總膽管 (CBD)',
        function: '輸送肝臟與膽囊之膽汁至十二指腸進行脂肪乳化',
        endofeature: '內徑正常小於 6~7mm（膽囊切除後可代償性擴張至 8-10mm）',
