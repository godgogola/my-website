    // Segment Selection
    function selectSegment(id) {
      if (isQuizMode) {
        handleQuizClick(id);
        return;
      }

      selectedId = id;
      const conf = segmentConfigs[id];
      const data = hbpData[id];
      if (!data || !conf) return;

      document.querySelectorAll('.seg-card-btn').forEach(btn => btn.classList.remove('active'));
      document.getElementById(`btn-seg-${id}`)?.classList.add('active');

      // Move glowing focus beacon to target position
      if (focusBeaconGroup && conf.targetPos) {
        new TWEEN.Tween(focusBeaconGroup.position)
          .to(conf.targetPos, 450)
          .easing(TWEEN.Easing.Cubic.Out)
          .start();
      }

      updateSegmentDetailsOnly(id);
    }

    function updateSegmentDetailsOnly(id) {
      const data = hbpData[id];
      if (!data) return;

      const pill = document.getElementById('det-pill');
      if (pill) pill.textContent = data.pill;
      document.getElementById('det-sector').textContent = data.sector;
      document.getElementById('det-title-zh').textContent = data.titleZh;
      document.getElementById('det-title-en').textContent = data.titleEn;
      document.getElementById('det-regions').textContent = data.regions;
      document.getElementById('det-function').textContent = data.function;
      document.getElementById('det-endofeature').textContent = data.endofeature;
      document.getElementById('det-disease').textContent = data.disease;
      document.getElementById('det-pearls-box').innerHTML = data.pearlsBox;
      document.getElementById('det-phrase-text').textContent = data.phrase;

      const pearlsList = document.getElementById('det-pearls-list');
      if (pearlsList) {
        pearlsList.innerHTML = '';
        data.pearls.forEach(text => {
          const item = document.createElement('div');
          item.className = 'pearl-item';
          item.innerHTML = `
            <svg width="14" height="14" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/></svg>
            <span>${text}</span>
          `;
          pearlsList.appendChild(item);
        });
      }
    }

    // Preset Views
    function setPresetView(preset) {
      document.querySelectorAll('.view-btn').forEach(b => b.classList.remove('active'));
      document.getElementById(`view-btn-${preset}`)?.classList.add('active');

      const isMobile = window.innerWidth <= 1150;
      let targetPos = new THREE.Vector3(0, isMobile ? 0.5 : 0.1, isMobile ? 13.0 : 8.8);
      let targetLook = new THREE.Vector3(0, isMobile ? 0.4 : 0.05, 0);

      switch(preset) {
        case 'anterior': 
          targetPos.set(0, isMobile ? 0.5 : 0.1, isMobile ? 13.0 : 8.8); 
          targetLook.set(0, isMobile ? 0.4 : 0.05, 0); 
          break;
        case 'ampulla': 
          targetPos.set(-0.8, isMobile ? -0.5 : -0.9, isMobile ? 7.5 : 4.5); 
          targetLook.set(-0.65, isMobile ? -0.5 : -0.9, 0.12); 
          selectSegment('ampulla');
          break;
        case 'gallbladder': 
          targetPos.set(-2.2, isMobile ? 0.7 : 0.3, isMobile ? 8.0 : 5.0); 
          targetLook.set(-1.3, isMobile ? 0.6 : 0.2, 0.3); 
          selectSegment('gallbladder');
          break;
        case 'pancreas': 
          targetPos.set(0.8, isMobile ? 0.0 : -0.4, isMobile ? 8.5 : 5.5); 
          targetLook.set(0.6, isMobile ? 0.0 : -0.4, 0.15); 
          selectSegment('pancreas');
          break;
        case 'posterior': 
          targetPos.set(0.5, isMobile ? 0.4 : 0.0, isMobile ? -12.5 : -8.5); 
          targetLook.set(0, isMobile ? 0.4 : 0.0, -0.2); 
          selectSegment('vessels');
          break;
      }

      new TWEEN.Tween(camera.position).to(targetPos, 850).easing(TWEEN.Easing.Cubic.Out).start();
      new TWEEN.Tween(controls.target).to(targetLook, 850).easing(TWEEN.Easing.Cubic.Out).start();
    }

    function reset3DCamera() {
      setPresetView('anterior');
      selectSegment('pancreas');
      showToast('已重設為肝膽胰 3D 正面全覽視角');
    }

    // Mobile Segmented Drawer / Tab Switching
    function switchMobileTab(tab) {
      document.querySelectorAll('.mobile-tab-btn').forEach(b => b.classList.remove('active'));
      document.getElementById(`tab-btn-${tab}`)?.classList.add('active');

      const regionsPane = document.getElementById('pane-regions-pathology');
      const detailsPane = document.getElementById('pane-clinical-details');
      const pathBox = document.querySelector('.pathology-section-box');
      const segBox = document.querySelector('.segment-grid-list');
      const segLabels = document.querySelectorAll('.left-panel .section-label');

      if (window.innerWidth <= 1150) {
        if (tab === 'regions') {
          if (regionsPane) regionsPane.style.display = 'flex';
          if (detailsPane) detailsPane.style.display = 'none';
          if (pathBox) pathBox.style.display = 'none';
          if (segBox) segBox.style.display = 'grid';
          if (segLabels[0]) segLabels[0].style.display = 'none';
          if (segLabels[1]) segLabels[1].style.display = 'block';
        } else if (tab === 'pathology') {
          if (regionsPane) regionsPane.style.display = 'flex';
          if (detailsPane) detailsPane.style.display = 'none';
          if (pathBox) pathBox.style.display = 'block';
          if (segBox) segBox.style.display = 'none';
          if (segLabels[0]) segLabels[0].style.display = 'block';
          if (segLabels[1]) segLabels[1].style.display = 'none';
        } else if (tab === 'details') {
          if (regionsPane) regionsPane.style.display = 'none';
          if (detailsPane) detailsPane.style.display = 'flex';
        }
      }
    }

    // Fullscreen Toggle
    function toggleFullScreen() {
      const wrapper = document.getElementById('hbpAppWrapper');
      if (!document.fullscreenElement) {
        if (wrapper && wrapper.requestFullscreen) {
          wrapper.requestFullscreen();
        } else if (document.documentElement.requestFullscreen) {
          document.documentElement.requestFullscreen();
        }
      } else {
        if (document.exitFullscreen) {
          document.exitFullscreen();
        }
      }
    }

    document.addEventListener('fullscreenchange', () => {
      const isFs = !!document.fullscreenElement;
      const label = document.getElementById('txt-fs-label');
      const btn = document.getElementById('btn-fullscreen-toggle');
      if (label) label.textContent = isFs ? '退出全螢幕' : '全螢幕模式';
      if (btn) btn.classList.toggle('active', isFs);
      setTimeout(onWindowResize, 150);
    });

    function onPointerDown(e) {
      const rect = renderer.domElement.getBoundingClientRect();
      mouse.x = ((e.clientX - rect.left) / rect.width) * 2 - 1;
      mouse.y = -((e.clientY - rect.top) / rect.height) * 2 + 1;

      raycaster.setFromCamera(mouse, camera);
      if (hbpMasterGroup) {
        const intersects = raycaster.intersectObjects(hbpMasterGroup.children, true);
        if (intersects.length > 0) {
          const hitPt = intersects[0].point;
          let closestId = 'pancreas', minDist = 999;
          Object.keys(segmentConfigs).forEach(k => {
            const d = hitPt.distanceTo(segmentConfigs[k].targetPos);
            if (d < minDist) {
              minDist = d;
              closestId = k;
            }
          });
          selectSegment(closestId);
        }
      }
    }

    function onWindowResize() {
      const container = document.getElementById('threejs-canvas-container');
      if (!container || !renderer || !camera) return;
      const width = container.clientWidth;
      const height = container.clientHeight;
      if (width > 0 && height > 0) {
        camera.aspect = width / height;
        camera.updateProjectionMatrix();
        renderer.setSize(width, height);
      }
    }

    function copyPhrase() {
      const text = document.getElementById('det-phrase-text')?.textContent.trim();
      if (text) {
        navigator.clipboard.writeText(text).then(() => {
          showToast('已複製肝膽胰超音波報告片語至剪貼簿！');
        });
      }
    }

    function showToast(msg) {
      const toast = document.getElementById('toast');
      const msgEl = document.getElementById('toast-msg');
      if (!toast || !msgEl) return;
      msgEl.textContent = msg;
      toast.classList.add('show');
      setTimeout(() => toast.classList.remove('show'), 2500);
    }

    const quizCandidates = ['liver', 'gallbladder', 'biliary_tree', 'pancreas', 'pancreatic_duct', 'ampulla', 'duodenum'];
    function toggleQuizMode() {
      isQuizMode = !isQuizMode;
      const btn = document.getElementById('btn-toggle-quiz');
      if (isQuizMode) {
        btn.classList.add('btn-primary');
        btn.classList.remove('btn-outline');
        btn.textContent = '結束測驗';
        nextQuizQuestion();
      } else {
        btn.classList.remove('btn-primary');
        btn.classList.add('btn-outline');
        btn.innerHTML = `
          <svg width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M9 11l3 3L22 4"/><path d="M21 12v7a2 2 0 01-2 2H5a2 2 0 01-2-2V5a2 2 0 012-2h11"/></svg>
          3D 測驗模式
        `;
        selectSegment(selectedId);
      }
    }

    function nextQuizQuestion() {
      const idx = Math.floor(Math.random() * quizCandidates.length);
      quizTarget = quizCandidates[idx];
      const data = hbpData[quizTarget];
      showToast(`🎯 請在 3D 空間中找出並點擊：【${data.titleZh}】`);
    }

    function handleQuizClick(clickedId) {
      if (clickedId === quizTarget) {
        showToast('🎉 答對了！非常優秀！');
        selectSegment(clickedId);
        setTimeout(nextQuizQuestion, 1400);
      } else {
        const clickedName = hbpData[clickedId] ? hbpData[clickedId].titleZh : clickedId;
        showToast(`❌ 答錯囉！您點到的是【${clickedName}】，旋轉一下角度再試一次！`);
      }
    }

    function animate(time) {
      requestAnimationFrame(animate);
      TWEEN.update();
      if (controls) controls.update();

      const t = (time || performance.now()) * 0.005;

      if (focusBeaconMesh) {
        focusBeaconMesh.rotation.z += 0.02;
        focusBeaconMesh.scale.setScalar(1.0 + Math.sin(t * 2) * 0.15);
      }

      if (renderer && scene && camera) {
        renderer.render(scene, camera);
      }
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', init3D);
    } else {
      init3D();
    }
  </script>
</Layout>

