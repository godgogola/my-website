      // Left Hepatic Duct (LHD) branching in liver
      const lhdPoints = [
        new THREE.Vector3(0.2, 1.15, 0.1),
        new THREE.Vector3(-0.25, 0.95, 0.15),
        new THREE.Vector3(-0.62, 0.85, 0.18)
      ];
      bileGroup.add(new THREE.Mesh(new THREE.TubeGeometry(new THREE.CatmullRomCurve3(lhdPoints), 16, 0.042, 10, false), ductMat));

      // Common Hepatic Duct (CHD) + Common Bile Duct (CBD)
      const cbdPoints = [
        new THREE.Vector3(-0.62, 0.85, 0.18), // Confluence of LHD & RHD
        new THREE.Vector3(-0.55, 0.58, 0.15), // Joined by cystic duct
        new THREE.Vector3(-0.52, 0.05, 0.12), // Supraduodenal CBD
        new THREE.Vector3(-0.56, -0.48, 0.1), // Retroduodenal & Intrapancreatic CBD
        new THREE.Vector3(-0.65, -0.9, 0.12)  // Entry into Ampulla of Vater
      ];
      const cbdCurve = new THREE.CatmullRomCurve3(cbdPoints);
      const cbdMesh = new THREE.Mesh(new THREE.TubeGeometry(cbdCurve, 32, 0.055, 14, false), ductMat);
      bileGroup.add(cbdMesh);

      hbpMasterGroup.add(bileGroup);

      // --- E. Build Pancreas with Cobblestone Lobular Texture & Head Cutaway Window ---
      const pancGroup = new THREE.Group();

      // 1. Pancreatic Head Parenchyma Section (Contoured organic lobe fitting in C-loop)
      const headGeom = new THREE.SphereGeometry(0.42, 24, 20);
      headGeom.scale(0.9, 1.15, 0.45);
      const headMesh = new THREE.Mesh(headGeom, pancCutMat);
      headMesh.position.set(-0.48, -0.62, 0.05);
      pancGroup.add(headMesh);

      // Add peripheral acinar lobules framing the head
      for (let h = 0; h < 14; h++) {
        const angle = (h / 14) * Math.PI * 2;
        const hNodule = new THREE.Mesh(new THREE.SphereGeometry(0.065 + Math.random() * 0.03, 8, 8), acinarLobuleMat);
        hNodule.position.set(
          -0.48 + Math.cos(angle) * 0.35,
          -0.62 + Math.sin(angle) * 0.42,
          0.12 + (Math.random() - 0.5) * 0.08
        );
        pancGroup.add(hNodule);
      }

      // 2. Pancreas Body & Tail Core Spline
      const pancCorePoints = [
        new THREE.Vector3(-0.35, -0.45, 0.12),
        new THREE.Vector3(0.15, -0.38, 0.14),
        new THREE.Vector3(0.85, -0.4, 0.12),
        new THREE.Vector3(1.55, -0.3, 0.04),
        new THREE.Vector3(2.15, -0.05, -0.12)
      ];
      const pancCoreCurve = new THREE.CatmullRomCurve3(pancCorePoints);

      // 3. Populate hundreds of realistic 3D cobblestone glandular acinar nodules (Pancreas Islands)
      const numLobules = 85;
      for (let i = 0; i < numLobules; i++) {
        const u = 0.05 + (i / numLobules) * 0.92;
        const pt = pancCoreCurve.getPoint(u);

        // Variable gland thickness (thick body, slender tail)
        const radius = (1.0 - u * 0.45) * 0.18 + 0.06;
        const angle = Math.random() * Math.PI * 2;
        const dist = Math.random() * radius;

        const noduleGeom = new THREE.SphereGeometry(0.07 + Math.random() * 0.04, 10, 10);
        noduleGeom.scale(1.1, 0.9, 1.0);
        const noduleMesh = new THREE.Mesh(noduleGeom, acinarLobuleMat);
        
        noduleMesh.position.set(
          pt.x + Math.cos(angle) * dist,
          pt.y + Math.sin(angle) * dist,
          pt.z + (Math.random() - 0.5) * 0.2 + 0.08
        );
        pancGroup.add(noduleMesh);
      }

      // 4. Main Pancreatic Duct (Duct of Wirsung, passing through center to Ampulla)
      const wirsungPoints = [
        new THREE.Vector3(2.05, -0.1, -0.1),
        new THREE.Vector3(1.5, -0.3, 0.05),
        new THREE.Vector3(0.85, -0.4, 0.15),
        new THREE.Vector3(0.15, -0.4, 0.16),
        new THREE.Vector3(-0.35, -0.5, 0.14),
        new THREE.Vector3(-0.62, -0.88, 0.12) // Merges with CBD at Ampulla!
      ];
      const wirsungCurve = new THREE.CatmullRomCurve3(wirsungPoints);
      const wirsungMesh = new THREE.Mesh(new THREE.TubeGeometry(wirsungCurve, 36, 0.035, 10, false), wDuctMat);
      pancGroup.add(wirsungMesh);

      // 5. Accessory Pancreatic Duct (Duct of Santorini, branching upwards to Minor Papilla)
      const santoriniPoints = [
        new THREE.Vector3(-0.35, -0.5, 0.14),
        new THREE.Vector3(-0.55, -0.65, 0.16),
        new THREE.Vector3(-0.72, -0.68, 0.14)
      ];
      const santoriniCurve = new THREE.CatmullRomCurve3(santoriniPoints);
      const santoriniMesh = new THREE.Mesh(new THREE.TubeGeometry(santoriniCurve, 16, 0.024, 8, false), wDuctMat);
      pancGroup.add(santoriniMesh);

      hbpMasterGroup.add(pancGroup);

      // --- F. Build Duodenum C-Loop with Internal Major Duodenal Papilla ---
      const duodGroup = new THREE.Group();

      const duodPoints = [
        new THREE.Vector3(-0.55, 0.15, 0.0),  // D1 Bulb start
        new THREE.Vector3(-0.95, -0.05, 0.0), // Superior Duodenal Flexure
        new THREE.Vector3(-1.05, -0.7, 0.0),  // D2 Descending Duodenum
        new THREE.Vector3(-0.92, -1.35, 0.0), // Inferior Duodenal Flexure
        new THREE.Vector3(-0.35, -1.55, 0.0), // D3 Horizontal Duodenum
        new THREE.Vector3(0.35, -1.45, 0.0),  // D4 Ascending Duodenum
        new THREE.Vector3(0.7, -1.1, -0.1)    // Treitz Ligament Flexure
      ];
      const duodCurve = new THREE.CatmullRomCurve3(duodPoints);
      const duodMesh = new THREE.Mesh(new THREE.TubeGeometry(duodCurve, 40, 0.25, 16, false), duodenumMat);
      duodGroup.add(duodMesh);

      // Major Duodenal Papilla (Ampulla of Vater / 奧狄氏括約肌開口)
      const papillaGroup = new THREE.Group();
      const papillaGeom = new THREE.TorusGeometry(0.085, 0.035, 12, 16);
      const papillaMat = new THREE.MeshStandardMaterial({ color: 0xb94943, roughness: 0.4 });
      const papillaMesh = new THREE.Mesh(papillaGeom, papillaMat);
      papillaMesh.position.set(-0.65, -0.9, 0.13);
      papillaMesh.rotation.y = Math.PI / 4;
      papillaGroup.add(papillaMesh);

      const orificeMesh = new THREE.Mesh(new THREE.SphereGeometry(0.04, 12, 12), new THREE.MeshBasicMaterial({ color: 0x0f172a }));
      orificeMesh.position.set(-0.65, -0.9, 0.13);
      papillaGroup.add(orificeMesh);

      duodGroup.add(papillaGroup);

      hbpMasterGroup.add(duodGroup);

      // Add Master Group to Scene
      scene.add(hbpMasterGroup);

      // --- G. Add Auto-Fitting 3D Billboard Labels ---
      Object.keys(segmentConfigs).forEach(k => {
        const conf = segmentConfigs[k];
        const sprite = createTextSprite(conf.label, '#f59e0b');
        sprite.position.set(conf.labelPos[0], conf.labelPos[1], conf.labelPos[2]);
        hbpMasterGroup.add(sprite);
        segmentLabelSprites[k] = sprite;
      });
    }

    // Dynamic Auto-Fitting Billboard Text Sprite Generator (100% inside borders!)
    function createTextSprite(text, accentColor = '#f59e0b') {
      const canvas = document.createElement('canvas');
      canvas.width = 512;
      canvas.height = 140;
      const ctx = canvas.getContext('2d');

      ctx.font = 'bold 36px -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Noto Sans TC", sans-serif';
      const textWidth = ctx.measureText(text).width;

      const pillWidth = Math.min(480, Math.max(160, textWidth + 64));
      const pillHeight = 72;
      const x = (canvas.width - pillWidth) / 2;
      const y = (canvas.height - pillHeight) / 2;

      // Draw pill background
      ctx.fillStyle = 'rgba(10, 20, 36, 0.92)';
      ctx.beginPath();
      ctx.roundRect(x, y, pillWidth, pillHeight, 36);
      ctx.fill();

      // Draw crisp glowing border
      ctx.strokeStyle = accentColor;
      ctx.lineWidth = 4;
      ctx.stroke();

      // Draw centered text
      ctx.fillStyle = '#ffffff';
      ctx.textAlign = 'center';
      ctx.textBaseline = 'middle';
      ctx.fillText(text, canvas.width / 2, canvas.height / 2);

      const texture = new THREE.CanvasTexture(canvas);
      texture.minFilter = THREE.LinearFilter;
      const spriteMat = new THREE.SpriteMaterial({ map: texture, transparent: true, depthTest: false });
      const sprite = new THREE.Sprite(spriteMat);
      sprite.scale.set(1.3 * (pillWidth / 250), 0.65, 1);
      return sprite;
    }

    // Build Glowing Focus Halo Beacon
    function buildFocusBeacon() {
      focusBeaconGroup = new THREE.Group();

      const ringGeom = new THREE.RingGeometry(0.32, 0.42, 32);
      const ringMat = new THREE.MeshBasicMaterial({
        color: 0xf59e0b,
        side: THREE.DoubleSide,
        transparent: true,
        opacity: 0.85
      });
      focusBeaconMesh = new THREE.Mesh(ringGeom, ringMat);
      focusBeaconGroup.add(focusBeaconMesh);

      const pointLight = new THREE.PointLight(0xf59e0b, 0.7, 2.0);
      focusBeaconGroup.add(pointLight);

      scene.add(focusBeaconGroup);
    }

    // Build 4 Major Clinical Pathologies in 3D
    function build3DPathologies() {
      pathologyGroup = new THREE.Group();

      // 1. Gallstones & Gallbladder Polyps (Inside Gallbladder Lumen)
      const stoneMat = new THREE.MeshStandardMaterial({ color: 0xfef08a, roughness: 0.6 }); // Yellow cholesterol stones
      const polypMat = new THREE.MeshPhysicalMaterial({ color: 0xf43f5e, roughness: 0.2, clearcoat: 0.8 });

      // Gallstones in GB fundus
      const gs1 = new THREE.Mesh(new THREE.DodecahedronGeometry(0.08, 1), stoneMat);
      gs1.position.set(-1.42, -0.05, 0.58);
      gs1.userData = { type: 'gallstone', name: '膽囊膽固醇結石 (Gallstone, 0.8cm)' };
      pathologyGroup.add(gs1);

      const gs2 = new THREE.Mesh(new THREE.DodecahedronGeometry(0.06, 1), stoneMat);
      gs2.position.set(-1.35, 0.05, 0.62);
      gs2.userData = { type: 'gallstone', name: '多發性膽囊微結石 (Microcalculi)' };
      pathologyGroup.add(gs2);

      // Gallbladder Polyp on GB wall
      const gbp = new THREE.Mesh(new THREE.SphereGeometry(0.055, 12, 12), polypMat);
      gbp.position.set(-1.28, 0.22, 0.52);
      gbp.userData = { type: 'gallstone', name: '膽囊膽固醇息肉 (GB Polyp, 0.4cm)' };
      pathologyGroup.add(gbp);

      // 2. Common Bile Duct Stone (CBD Stone) causing Biliary Dilatation
      const cbdStoneMat = new THREE.MeshStandardMaterial({
        color: 0xd97706,
        roughness: 0.5,
        emissive: 0xb45309,
        emissiveIntensity: 0.4
      });
      const cbdStoneMesh = new THREE.Mesh(new THREE.SphereGeometry(0.09, 14, 14), cbdStoneMat);
      cbdStoneMesh.position.set(-0.54, -0.15, 0.16);
      cbdStoneMesh.userData = { type: 'cbdstone', name: '總膽管結石 (CBD Stone, 0.9cm) 伴隨近端膽管擴張' };
      pathologyGroup.add(cbdStoneMesh);

      // 3. Ampulla Stone Impaction & Ampullary Tumor
      const ampStoneMat = new THREE.MeshStandardMaterial({
        color: 0xef4444,
        roughness: 0.4,
        emissive: 0xdc2626,
        emissiveIntensity: 0.6
      });
      const ampStoneMesh = new THREE.Mesh(new THREE.SphereGeometry(0.095, 14, 14), ampStoneMat);
      ampStoneMesh.position.set(-0.65, -0.9, 0.18);
      ampStoneMesh.userData = { type: 'ampulla', name: '十二指腸壺腹結石嵌頓 (Ampulla Stone Impaction) 引發急性膽石性胰臟炎' };
      pathologyGroup.add(ampStoneMesh);

      // 4. Acute Pancreatitis (Inflammatory Swelling & Pancreatic Head Mass)
      const massMat = new THREE.MeshPhysicalMaterial({
        color: 0x9333ea,
        roughness: 0.35,
        emissive: 0x7e22ce,
        emissiveIntensity: 0.5
      });
      const pMassMesh = new THREE.Mesh(new THREE.SphereGeometry(0.24, 16, 16), massMat);
      pMassMesh.position.set(-0.42, -0.45, 0.22);
      pMassMesh.userData = { type: 'pancreatitis', name: '胰臟頭部腫瘤/發炎水腫 (Pancreatic Head Mass, 2.5cm)' };
      pathologyGroup.add(pMassMesh);

      // Initially hide all pathologies
      pathologyGroup.children.forEach(child => child.visible = false);
      scene.add(pathologyGroup);
    }

    // Toggle Pathology Layers
    function togglePathology(type) {
      activePathology[type] = !activePathology[type];
      const btn = document.getElementById(`btn-path-${type}`);
      if (btn) btn.classList.toggle('active', activePathology[type]);

      pathologyGroup.children.forEach(child => {
        if (child.userData && child.userData.type === type) {
          child.visible = activePathology[type];
        }
      });

      const infoEl = document.getElementById('pathology-info-text');
      if (type === 'gallstone') {
        if (activePathology.gallstone) {
          infoEl.innerHTML = '🟡 <strong>已顯示膽囊結石與息肉</strong>：位於膽囊底部強回音結石（帶後方聲影）與壁上良性膽固醇息肉。';
          selectSegment('gallbladder');
        } else {
          infoEl.textContent = '已隱藏膽囊結石與息肉。';
        }
      } else if (type === 'cbdstone') {
        if (activePathology.cbdstone) {
          infoEl.innerHTML = '🟠 <strong>已顯示總膽管結石 (CBD Stone)</strong>：卡在總膽管中段，阻礙膽汁排泄引發近端膽管擴張與黃疸。';
          selectSegment('biliary_tree');
        } else {
          infoEl.textContent = '已隱藏總膽管結石。';
        }
      } else if (type === 'ampulla') {
        if (activePathology.ampulla) {
          infoEl.innerHTML = '🔴 <strong>已顯示十二指腸壺腹嵌頓</strong>：結石卡在奧狄氏括約肌開口，同時阻斷膽汁與胰液，為膽石性胰臟炎之核心機轉！';
          selectSegment('ampulla');
        } else {
          infoEl.textContent = '已隱藏壺腹病灶。';
        }
      } else if (type === 'pancreatitis') {
        if (activePathology.pancreatitis) {
