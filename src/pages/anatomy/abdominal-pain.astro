---
import Layout from '../../layouts/Layout.astro';
---

<Layout 
  title="九宮格腹痛與臨床鑑別診斷系統 | 互動解剖圖鑑 - 黃冠智醫師" 
  description="以臨床醫師視角打造的腹痛九宮格互動圖鑑。提供 3D 人體器官透視與 2D 直覺速查雙模式，深度剖析右上腹、上腹、左上腹、兩側腰、臍周中腹、下腹與兩側下腹之對應器官、急重症紅旗警訊、黃金鑑別診斷與門診病歷片語。"
  fullWidth={true}
  hideFooter={true}
>
  <!-- Three.js CDN dependencies -->
  <script is:inline src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js"></script>
  <script is:inline src="https://cdn.jsdelivr.net/npm/three@0.128.0/examples/js/controls/OrbitControls.js"></script>
  <script is:inline src="https://cdnjs.cloudflare.com/ajax/libs/tween.js/18.6.4/tween.umd.js"></script>

  <div class="abd-app-wrapper" id="abdAppWrapper">
    <!-- Subheader with breadcrumb & action controls -->
    <div class="anatomy-subnav">
      <div class="subnav-left">
        <a href="/anatomy" class="back-link">
          <svg width="15" height="15" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path d="M19 12H5M12 19l-7-7 7-7"/></svg>
          <span>圖鑑總覽</span>
        </a>
        <div class="divider">/</div>
        <div class="current-badge">
          <span class="pulse-dot"></span>
          <span>九宮格腹痛與臨床鑑別 (3D/2D 雙模式)</span>
        </div>
      </div>
      
      <div class="subnav-right">
        <!-- 3D / 2D Mode Switcher -->
        <div class="mode-toggle-group">
          <button class="btn btn-mode active" id="btn-mode-3d" onclick="switchDisplayMode('3d')">
            <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/><polyline points="3.27 6.96 12 12.01 20.73 6.96"/><line x1="12" y1="22.08" x2="12" y2="12"/></svg>
            <span>3D 透視</span>
          </button>
          <button class="btn btn-mode" id="btn-mode-2d" onclick="switchDisplayMode('2d')">
            <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/></svg>
            <span>2D 九宮格</span>
          </button>
        </div>

        <!-- Fullscreen Button -->
        <button class="btn btn-fullscreen" id="btn-fullscreen-toggle" onclick="toggleFullScreen()" title="全螢幕模式">
          <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" id="icon-fs"><path d="M8 3H5a2 2 0 0 0-2 2v3m18 0V5a2 2 0 0 0-2-2h-3m0 18h3a2 2 0 0 0 2-2v-3M3 16v3a2 2 0 0 0 2 2h3"/></svg>
          <span class="btn-text-full">全螢幕</span>
        </button>
        <button class="btn btn-primary" onclick="resetView()">
          <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M3 12a9 9 0 1 0 9-9 9.75 9.75 0 0 0-6.74 2.74L3 8"/><path d="M3 3v5h5"/></svg>
          <span>重設視角</span>
        </button>
      </div>
    </div>

    <!-- Main Workspace Grid -->
    <div class="workspace-grid">

      <!-- Mobile Tab Switcher Navigation -->
      <div class="mobile-tabs-nav">
        <button class="mobile-tab-btn active" id="tab-btn-regions" onclick="switchMobileTab('regions')">
          📍 9大腹部區位
        </button>
        <button class="mobile-tab-btn" id="tab-btn-pathology" onclick="switchMobileTab('pathology')">
          🩺 鑑別診斷
        </button>
        <button class="mobile-tab-btn" id="tab-btn-details" onclick="switchMobileTab('details')">
          📋 門診片語
        </button>
      </div>

      <!-- Left Panel: 9-Grid Quick Navigator & Clinical Filter -->
      <div class="glass-panel left-panel mobile-tab-pane" id="pane-regions-pathology">
        <div class="panel-header">
          <div class="panel-title">
            <svg width="16" height="16" fill="none" stroke="#38bdf8" stroke-width="2" viewBox="0 0 24 24"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/></svg>
            <span>腹痛九宮格導航盤</span>
          </div>
          <span class="badge-count">9 區位</span>
        </div>

        <div class="panel-body scrollable-content">
          <!-- Mini 3x3 Interactive Keypad -->
          <div class="mini-grid-wrapper">
            <div class="mini-grid-label">快速點擊切換區域：</div>
            <div class="mini-grid-board">
              <button class="mini-grid-btn" data-region="ruq" onclick="selectRegion('ruq')">
                <span class="mg-code">RUQ</span>
                <span class="mg-name">右上腹</span>
              </button>
              <button class="mini-grid-btn active" data-region="epigastric" onclick="selectRegion('epigastric')">
                <span class="mg-code">EPI</span>
                <span class="mg-name">上腹</span>
              </button>
              <button class="mini-grid-btn" data-region="luq" onclick="selectRegion('luq')">
                <span class="mg-code">LUQ</span>
                <span class="mg-name">左上腹</span>
              </button>
              <button class="mini-grid-btn" data-region="r_flank" onclick="selectRegion('r_flank')">
                <span class="mg-code">RLUM</span>
                <span class="mg-name">右側腰</span>
              </button>
              <button class="mini-grid-btn" data-region="umbilical" onclick="selectRegion('umbilical')">
                <span class="mg-code">UMB</span>
                <span class="mg-name">臍周中腹</span>
              </button>
              <button class="mini-grid-btn" data-region="l_flank" onclick="selectRegion('l_flank')">
                <span class="mg-code">LLUM</span>
                <span class="mg-name">左側腰</span>
              </button>
              <button class="mini-grid-btn" data-region="rlq" onclick="selectRegion('rlq')">
                <span class="mg-code">RLQ</span>
                <span class="mg-name">右下腹</span>
              </button>
              <button class="mini-grid-btn" data-region="suprapubic" onclick="selectRegion('suprapubic')">
                <span class="mg-code">PUB</span>
                <span class="mg-name">下腹恥骨</span>
              </button>
              <button class="mini-grid-btn" data-region="llq" onclick="selectRegion('llq')">
                <span class="mg-code">LLQ</span>
                <span class="mg-name">左下腹</span>
              </button>
            </div>
          </div>

          <!-- Section Label -->
          <div class="section-label">9 大區位細部清單</div>

          <!-- Region List Cards -->
          <div class="segment-grid-list">
            <button class="seg-card-btn" id="card-ruq" onclick="selectRegion('ruq')">
              <div class="seg-card-top">
                <span class="seg-num-pill">RUQ</span>
                <span class="seg-loc-tag">右上腹</span>
              </div>
              <div class="seg-card-name">肝臟、膽囊、十二指腸</div>
              <div class="seg-card-sub">膽囊炎 · 膽結石 · 肝炎</div>
            </button>

            <button class="seg-card-btn active" id="card-epigastric" onclick="selectRegion('epigastric')">
              <div class="seg-card-top">
                <span class="seg-num-pill">EPI</span>
                <span class="seg-loc-tag">心窩上腹</span>
              </div>
              <div class="seg-card-name">胃部、胰臟、腹主動脈</div>
              <div class="seg-card-sub">消化性潰瘍 · 胃炎 · 急性胰臟炎</div>
            </button>

            <button class="seg-card-btn" id="card-luq" onclick="selectRegion('luq')">
              <div class="seg-card-top">
                <span class="seg-num-pill">LUQ</span>
                <span class="seg-loc-tag">左上腹</span>
              </div>
              <div class="seg-card-name">胃體、脾臟、胰尾</div>
              <div class="seg-card-sub">胃炎 · 脾梗塞 · 結腸脾曲症</div>
            </button>

            <button class="seg-card-btn" id="card-r_flank" onclick="selectRegion('r_flank')">
              <div class="seg-card-top">
                <span class="seg-num-pill">RLUM</span>
                <span class="seg-loc-tag">右側腰</span>
              </div>
              <div class="seg-card-name">升結腸、右腎與輸尿管</div>
              <div class="seg-card-sub">腎輸尿管結石 · 腎盂腎炎</div>
            </button>

            <button class="seg-card-btn" id="card-umbilical" onclick="selectRegion('umbilical')">
              <div class="seg-card-top">
                <span class="seg-num-pill">UMB</span>
                <span class="seg-loc-tag">中腹臍周</span>
              </div>
              <div class="seg-card-name">小腸、橫結腸、腹主動脈</div>
              <div class="seg-card-sub">腸胃炎 · 早期闌尾炎 · 腸阻塞</div>
            </button>

            <button class="seg-card-btn" id="card-l_flank" onclick="selectRegion('l_flank')">
              <div class="seg-card-top">
                <span class="seg-num-pill">LLUM</span>
                <span class="seg-loc-tag">左側腰</span>
              </div>
              <div class="seg-card-name">降結腸、左腎與輸尿管</div>
              <div class="seg-card-sub">輸尿管結石 · 憩室炎 · 肌筋膜炎</div>
            </button>

            <button class="seg-card-btn" id="card-rlq" onclick="selectRegion('rlq')">
              <div class="seg-card-top">
                <span class="seg-num-pill">RLQ</span>
                <span class="seg-loc-tag">右下腹</span>
              </div>
              <div class="seg-card-name">闌尾、盲腸、右卵巢輸卵管</div>
              <div class="seg-card-sub">急性闌尾炎 · 憩室炎 · 婦科急症</div>
            </button>

            <button class="seg-card-btn" id="card-suprapubic" onclick="selectRegion('suprapubic')">
              <div class="seg-card-top">
                <span class="seg-num-pill">PUB</span>
                <span class="seg-loc-tag">下腹恥骨上</span>
              </div>
              <div class="seg-card-name">膀胱、直腸、子宮攝護腺</div>
              <div class="seg-card-sub">膀胱炎 · 尿滯留 · 骨盆腔發炎</div>
            </button>

            <button class="seg-card-btn" id="card-llq" onclick="selectRegion('llq')">
              <div class="seg-card-top">
                <span class="seg-num-pill">LLQ</span>
                <span class="seg-loc-tag">左下腹</span>
              </div>
              <div class="seg-card-name">乙狀結腸、左卵巢輸卵管</div>
              <div class="seg-card-sub">乙狀結腸憩室炎 · 腸躁症 · 卵巢囊腫</div>
            </button>
          </div>
        </div>
      </div>

      <!-- Center Panel: 3D Stage OR 2D Interactive Matrix -->
      <div class="glass-panel canvas-panel" id="centerStagePanel">
        <!-- Preset Angle Toolbar (Shown in 3D Mode) -->
        <div class="view-angles-toolbar" id="viewAnglesToolbar">
          <button class="view-btn active" data-view="anterior" onclick="set3DPresetView('anterior')">全景正面</button>
          <button class="view-btn" data-view="upper" onclick="set3DPresetView('upper')">上腹重點</button>
          <button class="view-btn" data-view="lower" onclick="set3DPresetView('lower')">下腹骨盆</button>
          <button class="view-btn" data-view="right_flank" onclick="set3DPresetView('right_flank')">右側腰後腹</button>
          <button class="view-btn" data-view="left_flank" onclick="set3DPresetView('left_flank')">左側腰後腹</button>
        </div>

        <div class="orbit-hint" id="orbitHint">
          <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M21 12a9 9 0 0 0-9-9 9.75 9.75 0 0 0-6.74 2.74L3 8"/><path d="M3 3v5h5"/></svg>
          <span>按住拖曳可 360° 自由旋轉</span>
        </div>

        <!-- 3D Three.js Canvas Container -->
        <div id="threejs-canvas-container" class="stage-view active"></div>

        <!-- 2D Interactive Grid Matrix View -->
        <div id="twod-grid-container" class="stage-view">
          <div class="twod-matrix-header">
            <h2 class="twod-title">肚子痛的位置與對應器官</h2>
            <p class="twod-sub">點擊下方任一九宮格，右側即刻展開完整鑑別診斷與門診片語</p>
          </div>

          <div class="twod-grid-board">
            <!-- Row 1 -->
            <div class="twod-cell" id="twod-ruq" onclick="selectRegion('ruq')">
              <div class="cell-glow-border"></div>
              <div class="cell-head">
                <span class="cell-code">RUQ</span>
                <span class="cell-title">右上腹</span>
              </div>
              <div class="cell-organs">肝臟、膽囊</div>
              <div class="cell-sub-organs">結腸肝曲 · 十二指腸 · 右腎</div>
              <div class="cell-badge alert-red">⚠️ 膽囊炎 / 結石 / 肝炎</div>
            </div>

            <div class="twod-cell active" id="twod-epigastric" onclick="selectRegion('epigastric')">
              <div class="cell-glow-border"></div>
              <div class="cell-head">
                <span class="cell-code">EPI</span>
                <span class="cell-title">上腹 (心窩)</span>
              </div>
              <div class="cell-organs">胃部、胰臟、十二指腸</div>
              <div class="cell-sub-organs">腹主動脈 · 早期闌尾炎牽引</div>
              <div class="cell-badge alert-amber">⚠️ 潰瘍 / 胃炎 / 胰臟炎</div>
            </div>

            <div class="twod-cell" id="twod-luq" onclick="selectRegion('luq')">
              <div class="cell-glow-border"></div>
              <div class="cell-head">
                <span class="cell-code">LUQ</span>
                <span class="cell-title">左上腹</span>
              </div>
              <div class="cell-organs">胃部、脾臟、胰臟</div>
              <div class="cell-sub-organs">結腸脾曲 · 胰尾 · 左腎</div>
              <div class="cell-badge alert-blue">⚠️ 脾梗塞 / 結腸脹氣 / 潰瘍</div>
            </div>

            <!-- Row 2 -->
            <div class="twod-cell" id="twod-r_flank" onclick="selectRegion('r_flank')">
              <div class="cell-glow-border"></div>
              <div class="cell-head">
                <span class="cell-code">R-FLK</span>
                <span class="cell-title">右側腰</span>
              </div>
              <div class="cell-organs">升結腸、腎臟和輸尿管</div>
              <div class="cell-sub-organs">後腹腔 · 腰肌筋膜</div>
              <div class="cell-badge alert-red">⚠️ 輸尿管結石 / 腎盂腎炎</div>
            </div>

            <div class="twod-cell" id="twod-umbilical" onclick="selectRegion('umbilical')">
              <div class="cell-glow-border"></div>
              <div class="cell-head">
                <span class="cell-code">UMB</span>
                <span class="cell-title">中腹 (臍周)</span>
              </div>
              <div class="cell-organs">小腸、橫結腸、主動脈</div>
              <div class="cell-sub-organs">腸繫膜淋巴結 · 大網膜</div>
              <div class="cell-badge alert-amber">⚠️ 腸胃炎 / 腸阻塞 / AAA</div>
            </div>

            <div class="twod-cell" id="twod-l_flank" onclick="selectRegion('l_flank')">
              <div class="cell-glow-border"></div>
              <div class="cell-head">
                <span class="cell-code">L-FLK</span>
                <span class="cell-title">左側腰</span>
              </div>
              <div class="cell-organs">降結腸、腎臟和輸尿管</div>
              <div class="cell-sub-organs">後腹腔 · 腰肌筋膜</div>
              <div class="cell-badge alert-red">⚠️ 腎結石絞痛 / 憩室炎</div>
            </div>

            <!-- Row 3 -->
            <div class="twod-cell" id="twod-rlq" onclick="selectRegion('rlq')">
              <div class="cell-glow-border"></div>
              <div class="cell-head">
                <span class="cell-code">RLQ</span>
                <span class="cell-title">右下腹</span>
              </div>
              <div class="cell-organs">升結腸、盲腸、闌尾</div>
              <div class="cell-sub-organs">右側卵巢 · 輸卵管 · 末端迴腸</div>
              <div class="cell-badge alert-red">🚨 急性闌尾炎 / 婦科急症</div>
            </div>

            <div class="twod-cell" id="twod-suprapubic" onclick="selectRegion('suprapubic')">
              <div class="cell-glow-border"></div>
              <div class="cell-head">
                <span class="cell-code">PUB</span>
                <span class="cell-title">下腹 (恥骨上)</span>
              </div>
              <div class="cell-organs">膀胱、直腸、子宮/攝護腺</div>
              <div class="cell-sub-organs">輸卵管 · 尿道 · 兩側輸尿管口</div>
              <div class="cell-badge alert-amber">⚠️ 膀胱炎 / 尿滯留 / 骨盆腔炎</div>
            </div>

            <div class="twod-cell" id="twod-llq" onclick="selectRegion('llq')">
              <div class="cell-glow-border"></div>
              <div class="cell-head">
                <span class="cell-code">LLQ</span>
                <span class="cell-title">左下腹</span>
              </div>
              <div class="cell-organs">降結腸、乙狀結腸</div>
              <div class="cell-sub-organs">左側卵巢 · 輸卵管</div>
              <div class="cell-badge alert-amber">⚠️ 乙狀結腸憩室炎 / IBS</div>
            </div>
          </div>
        </div>

        <!-- Mode Indicator Bar -->
        <div class="canvas-bottom-bar">
          <div class="mode-info">
            <span class="info-dot"></span>
            <span id="activeModeText">目前檢視：3D 人體器官透視 (點選九宮格即刻高亮對應臟器)</span>
          </div>
          <div class="current-selected-label">
            <span>目前焦點：</span>
            <strong id="bottomSelectedRegionName">上腹 (Epigastrium)</strong>
          </div>
        </div>
      </div>

      <!-- Right Panel: Clinical Differential Diagnosis & Phrases -->
      <div class="glass-panel right-panel mobile-tab-pane" id="pane-clinical-details">
        <div class="panel-header">
          <div class="panel-title">
            <svg width="16" height="16" fill="none" stroke="#10b981" stroke-width="2" viewBox="0 0 24 24"><path d="M22 12h-4l-3 9L9 3l-3 9H2"/></svg>
            <span>臨床鑑別診斷與處置指引</span>
          </div>
          <span class="badge-organ" id="badgeRegionCode">EPI</span>
        </div>

        <div class="panel-body scrollable-content">
          <!-- Region Title Header -->
          <div class="detail-title-group">
            <div class="tag-row">
              <span class="region-badge-pill" id="detailPill">上腹 (Epigastrium)</span>
              <span class="latin-name" id="detailLatin">Regio epigastrica</span>
            </div>
            <h1 class="main-title" id="detailMainTitle">上腹心窩處疼痛</h1>
            <p class="sub-title" id="detailSubTitle">核心臟器：胃、胰臟、十二指腸、腹主動脈</p>
          </div>

          <!-- Anatomical Structures Involved -->
          <div class="detail-card">
            <h3>
              <svg width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M12 2C8 2 6 6 6 11c0 5 3 9 6 11 3-2 6-6 6-11 0-5-2-9-6-9Z"/></svg>
              <span>解剖對應臟器清單 (Anatomy Involved)</span>
            </h3>
            <div class="organ-tags-cloud" id="detailOrganTags">
              <span class="organ-chip highlight">胃體 / 胃竇 (Stomach)</span>
              <span class="organ-chip highlight">十二指腸 (Duodenum)</span>
              <span class="organ-chip highlight">胰臟本體 (Pancreas)</span>
              <span class="organ-chip">腹主動脈 (Aorta)</span>
              <span class="organ-chip">肝左葉 (Left Lobe of Liver)</span>
            </div>
          </div>

          <!-- Critical Red Flags / Emergencies -->
          <div class="detail-card alert-card-red" id="detailRedFlagsBox">
            <h3 class="alert-title">
              <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>
              <span>🚨 需優先排除之急重症 (Red Flags)</span>
            </h3>
            <ul class="pearls-list" id="detailRedFlagsList">
