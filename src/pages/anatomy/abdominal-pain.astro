    // --- State Variables ---
    let currentRegion = 'epigastric';
    let displayMode = '3d'; // '3d' or '2d'
    let scene, camera, renderer, controls;
    let organMeshes = {};
    let gridPlaneMeshes = {};
    let isInitialized = false;

    // --- 3D Initialization ---
    function init3D() {
      const container = document.getElementById('threejs-canvas-container');
      if (!container) return;

      const isMobile = window.innerWidth <= 1150;
      const width = container.clientWidth || (isMobile ? window.innerWidth : 600);
      const height = container.clientHeight || (isMobile ? 360 : (window.innerHeight - 130));

      // 1. Scene & Camera
      scene = new THREE.Scene();
      camera = new THREE.PerspectiveCamera(40, width / height, 0.1, 100);
      camera.position.set(0, isMobile ? 0.9 : 0.2, isMobile ? 14.5 : 9.5);

      // 2. Renderer
      renderer = new THREE.WebGLRenderer({ antialias: true, alpha: true });
      renderer.setSize(width, height);
      renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
      renderer.shadowMap.enabled = true;
      renderer.shadowMap.type = THREE.PCFSoftShadowMap;
      renderer.domElement.style.width = '100%';
      renderer.domElement.style.height = '100%';
      container.appendChild(renderer.domElement);

      // 3. Orbit Controls
      controls = new THREE.OrbitControls(camera, renderer.domElement);
      controls.enableDamping = true;
      controls.dampingFactor = 0.06;
      controls.minDistance = 3.5;
      controls.maxDistance = 24;
      controls.target.set(0, isMobile ? 0.8 : 0.1, 0);

      // 4. Balanced Medical Lighting
      const ambientLight = new THREE.AmbientLight(0xffffff, 0.6);
      scene.add(ambientLight);

      const mainLight = new THREE.DirectionalLight(0xfff5ea, 0.95);
      mainLight.position.set(6, 8, 8);
      scene.add(mainLight);

      const rimLight = new THREE.DirectionalLight(0x38bdf8, 0.55);
      rimLight.position.set(-6, -4, 6);
      scene.add(rimLight);

      const backLight = new THREE.DirectionalLight(0x10b981, 0.4);
      backLight.position.set(0, -6, -6);
      scene.add(backLight);

      // 5. Build Anatomical Model & Holographic 9-Grid
      buildTranslucentTorsoOutline();
      buildAbdominalOrgans();
      build3DHologramGridPlanes();

      // 6. Raycaster
      const raycaster = new THREE.Raycaster();
      const mouse = new THREE.Vector2();
      renderer.domElement.addEventListener('pointerdown', (e) => {
        const rect = renderer.domElement.getBoundingClientRect();
        mouse.x = ((e.clientX - rect.left) / rect.width) * 2 - 1;
        mouse.y = -((e.clientY - rect.top) / rect.height) * 2 + 1;
        raycaster.setFromCamera(mouse, camera);

        const planeList = Object.values(gridPlaneMeshes);
        const intersects = raycaster.intersectObjects(planeList);
        if (intersects.length > 0) {
          const hit = intersects[0].object;
          if (hit.userData && hit.userData.regionKey) {
            selectRegion(hit.userData.regionKey);
          }
        }
      });

      // 7. Auto-Resize Observer
      const resizeObserver = new ResizeObserver(() => onWindowResize());
      resizeObserver.observe(container);
      window.addEventListener('resize', onWindowResize);

      // Set initial
      selectRegion('epigastric');

      // Animation Loop
      animate();
      isInitialized = true;
    }

    // --- Build Translucent Body Silhouette & Ribcage Guide ---
    function buildTranslucentTorsoOutline() {
      const torsoGroup = new THREE.Group();

      const bodyMat = new THREE.MeshPhysicalMaterial({
        color: 0x38bdf8,
        transparent: true,
        opacity: 0.08,
        roughness: 0.3,
        clearcoat: 0.5,
        wireframe: false,
        side: THREE.BackSide
      });

      // Simplified organic torso envelope
      const torsoGeom = new THREE.CylinderGeometry(2.3, 1.9, 6.2, 32, 8, true);
      torsoGeom.scale(1.15, 1.0, 0.68);
      const torsoMesh = new THREE.Mesh(torsoGeom, bodyMat);
      torsoMesh.position.set(0, 0.1, -0.1);
      torsoGroup.add(torsoMesh);

      // Translucent ribcage arch
      const ribMat = new THREE.MeshBasicMaterial({ color: 0x94a3b8, transparent: true, opacity: 0.15, wireframe: true });
      const ribGeom = new THREE.CylinderGeometry(2.2, 2.0, 2.5, 18, 4, true);
      ribGeom.scale(1.1, 1.0, 0.65);
      const ribMesh = new THREE.Mesh(ribGeom, ribMat);
      ribMesh.position.set(0, 1.6, -0.05);
      torsoGroup.add(ribMesh);

      scene.add(torsoGroup);
    }

