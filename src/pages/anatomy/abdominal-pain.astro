      recMesh.position.set(0, -2.55, -0.05);
      organMeshes.rectum = recMesh;
      organsMasterGroup.add(recMesh);

      // 8. Small Intestines (Central Umbilical bunch)
      const smallIntGroup = new THREE.Group();
      for (let i = 0; i < 9; i++) {
        const loopGeom = new THREE.TorusGeometry(0.35 + (i % 3) * 0.12, 0.12, 8, 16, Math.PI * 1.5);
        const loopMesh = new THREE.Mesh(loopGeom, matSmallInt);
        loopMesh.position.set(((i % 3) - 1) * 0.45, -0.5 - Math.floor(i / 3) * 0.42, 0.18 + (i % 2) * 0.08);
        loopMesh.rotation.set((i * 0.4), (i * 0.3), (i * 0.5));
        smallIntGroup.add(loopMesh);
      }
      organMeshes.small_intestines = smallIntGroup;
      organMeshes.ileum = smallIntGroup;
      organsMasterGroup.add(smallIntGroup);

      // 9. Kidneys & Ureters (Right & Left Flanks - Posterior)
      // Right Kidney
      const rKidGeom = new THREE.SphereGeometry(0.45, 18, 14);
      rKidGeom.scale(0.7, 1.25, 0.7);
      const rKidMesh = new THREE.Mesh(rKidGeom, matKidney);
      rKidMesh.position.set(-1.3, 0.45, -0.5);
      organMeshes.kidney_r = rKidMesh;
      organsMasterGroup.add(rKidMesh);

      // Left Kidney
      const lKidGeom = new THREE.SphereGeometry(0.45, 18, 14);
      lKidGeom.scale(0.7, 1.25, 0.7);
      const lKidMesh = new THREE.Mesh(lKidGeom, matKidney);
      lKidMesh.position.set(1.3, 0.65, -0.5);
      organMeshes.kidney_l = lKidMesh;
      organsMasterGroup.add(lKidMesh);

      // Ureters running down
      const rUreterCurve = new THREE.CatmullRomCurve3([
        new THREE.Vector3(-1.25, 0.25, -0.45),
        new THREE.Vector3(-1.1, -0.8, -0.35),
        new THREE.Vector3(-0.7, -1.8, -0.15),
        new THREE.Vector3(-0.25, -2.05, 0.1)
      ]);
      const rUreter = new THREE.Mesh(new THREE.TubeGeometry(rUreterCurve, 16, 0.035, 8, false), matUreter);
      organMeshes.ureter_r = rUreter;
      organsMasterGroup.add(rUreter);

      const lUreterCurve = new THREE.CatmullRomCurve3([
        new THREE.Vector3(1.25, 0.45, -0.45),
        new THREE.Vector3(1.1, -0.8, -0.35),
        new THREE.Vector3(0.7, -1.8, -0.15),
        new THREE.Vector3(0.25, -2.05, 0.1)
      ]);
      const lUreter = new THREE.Mesh(new THREE.TubeGeometry(lUreterCurve, 16, 0.035, 8, false), matUreter);
      organMeshes.ureter_l = lUreter;
      organsMasterGroup.add(lUreter);

      // 10. Urinary Bladder (Suprapubic)
      const bladderGeom = new THREE.SphereGeometry(0.55, 20, 16);
      bladderGeom.scale(1.1, 0.95, 0.9);
      const bladderMesh = new THREE.Mesh(bladderGeom, matBladder);
      bladderMesh.position.set(0, -2.0, 0.25);
      organMeshes.bladder = bladderMesh;
      organsMasterGroup.add(bladderMesh);

      // Uterus/Prostate representation
      const utGeom = new THREE.ConeGeometry(0.3, 0.6, 12);
      const utMesh = new THREE.Mesh(utGeom, new THREE.MeshStandardMaterial({ color: 0xe879f9, roughness: 0.4 }));
      utMesh.position.set(0, -1.85, 0.05);
      utMesh.rotation.x = Math.PI;
      organMeshes.uterus_prostate = utMesh;
      organsMasterGroup.add(utMesh);

      // Adnexa R & L
      const adnexaMat = new THREE.MeshStandardMaterial({ color: 0xf472b6 });
      const adnexaR = new THREE.Mesh(new THREE.SphereGeometry(0.18, 12, 10), adnexaMat);
      adnexaR.position.set(-0.85, -1.85, 0.1);
      organMeshes.adnexa_r = adnexaR;
      organsMasterGroup.add(adnexaR);

      const adnexaL = new THREE.Mesh(new THREE.SphereGeometry(0.18, 12, 10), adnexaMat);
      adnexaL.position.set(0.85, -1.85, 0.1);
      organMeshes.adnexa_l = adnexaL;
      organsMasterGroup.add(adnexaL);

      // 11. Abdominal Aorta
      const aortaMesh = new THREE.Mesh(new THREE.CylinderGeometry(0.12, 0.12, 4.8, 16), matAorta);
      aortaMesh.position.set(0.15, -0.1, -0.42);
      organMeshes.aorta = aortaMesh;
      organsMasterGroup.add(aortaMesh);

      scene.add(organsMasterGroup);
    }

    // --- Build 3D Holographic Nine-Grid Clickable Planes ---
    function build3DHologramGridPlanes() {
      const gridPlanesGroup = new THREE.Group();

      const cellPositions = {
        ruq:        { x: -1.35, y: 1.25, w: 1.2, h: 1.35 },
        epigastric: { x: 0.0,   y: 1.25, w: 1.3, h: 1.35 },
        luq:        { x: 1.35,  y: 1.25, w: 1.2, h: 1.35 },
        r_flank:    { x: -1.35, y: -0.2, w: 1.2, h: 1.4 },
        umbilical:  { x: 0.0,   y: -0.2, w: 1.3, h: 1.4 },
        l_flank:    { x: 1.35,  y: -0.2, w: 1.2, h: 1.4 },
        rlq:        { x: -1.35, y: -1.75, w: 1.2, h: 1.5 },
        suprapubic: { x: 0.0,   y: -1.75, w: 1.3, h: 1.5 },
        llq:        { x: 1.35,  y: -1.75, w: 1.2, h: 1.5 }
      };

      Object.entries(cellPositions).forEach(([key, pos]) => {
        // Plane geometry in front of organs
        const planeGeom = new THREE.PlaneGeometry(pos.w, pos.h);
        const planeMat = new THREE.MeshBasicMaterial({
          color: 0x38bdf8,
          transparent: true,
          opacity: 0.04,
          side: THREE.DoubleSide
        });

        const planeMesh = new THREE.Mesh(planeGeom, planeMat);
        planeMesh.position.set(pos.x, pos.y, 0.92);
        planeMesh.userData = { regionKey: key, defaultColor: 0x38bdf8, defaultOpacity: 0.04 };

        // Wireframe boundary
        const edges = new THREE.EdgesGeometry(planeGeom);
        const lineMat = new THREE.LineBasicMaterial({ color: 0x0ea5e9, transparent: true, opacity: 0.35 });
        const line = new THREE.LineSegments(edges, lineMat);
        planeMesh.add(line);
        planeMesh.userData.line = line;

        gridPlaneMeshes[key] = planeMesh;
        gridPlanesGroup.add(planeMesh);
      });

      scene.add(gridPlanesGroup);
    }

    // --- Animation Loop ---
    function animate() {
      requestAnimationFrame(animate);
      TWEEN.update();
      if (controls) controls.update();
      if (renderer && scene && camera) {
        renderer.render(scene, camera);
      }
    }

    // --- Resize Handler ---
    function onWindowResize() {
      const container = document.getElementById('threejs-canvas-container');
      if (!container || !renderer || !camera) return;
      const width = container.clientWidth;
      const height = container.clientHeight;
      if (width > 0 && height > 0) {
        camera.aspect = width / height;
        camera.updateProjectionMatrix();
        renderer.setSize(width, height);
      }
    }

    // --- Region Selection Handler (Syncs 3D, 2D, and Clinical Panel) ---
    function selectRegion(regionKey) {
      const data = ABD_DATA[regionKey];
      if (!data) return;

      currentRegion = regionKey;

      // 1. Update Left Card List & Mini-grid
      document.querySelectorAll('.seg-card-btn').forEach(b => b.classList.remove('active'));
      document.getElementById(`card-${regionKey}`)?.classList.add('active');

      document.querySelectorAll('.mini-grid-btn').forEach(b => b.classList.remove('active'));
      document.querySelector(`.mini-grid-btn[data-region="${regionKey}"]`)?.classList.add('active');

      // 2. Update 2D Grid Cells
      document.querySelectorAll('.twod-cell').forEach(c => c.classList.remove('active'));
      document.getElementById(`twod-${regionKey}`)?.classList.add('active');

      // 3. Update Bottom Bar Label
      const bottomLabel = document.getElementById('bottomSelectedRegionName');
      if (bottomLabel) bottomLabel.textContent = data.name;

      // 4. Update Right Clinical Details Panel
      updateClinicalPanel(data);

      // 5. Update 3D Stage (Camera & Organ Opacity/Emissive)
      if (isInitialized && displayMode === '3d') {
        highlight3DOrgans(data.highlightMeshes);

        // Update 3D Grid Plane Hologram Highlights
        Object.entries(gridPlaneMeshes).forEach(([k, mesh]) => {
          if (k === regionKey) {
            mesh.material.color.setHex(0x10b981);
            mesh.material.opacity = 0.22;
            mesh.userData.line.material.color.setHex(0x34d399);
            mesh.userData.line.material.opacity = 0.9;
          } else {
            mesh.material.color.setHex(0x38bdf8);
            mesh.material.opacity = 0.04;
            mesh.userData.line.material.color.setHex(0x0ea5e9);
            mesh.userData.line.material.opacity = 0.3;
          }
        });

        // Smooth Camera Tween to Framing
        const isMobile = window.innerWidth <= 1150;
        const targetPos = new THREE.Vector3(
          data.cameraPos.x * (isMobile ? 0.8 : 1.0),
          data.cameraPos.y * (isMobile ? 1.0 : 1.0),
          data.cameraPos.z * (isMobile ? 1.4 : 1.0)
        );
        const targetLook = new THREE.Vector3(data.cameraLook.x, data.cameraLook.y, data.cameraLook.z);

        new TWEEN.Tween(camera.position).to(targetPos, 800).easing(TWEEN.Easing.Cubic.Out).start();
        new TWEEN.Tween(controls.target).to(targetLook, 800).easing(TWEEN.Easing.Cubic.Out).start();
      }
    }

    // --- Highlight Specific 3D Organs ---
    function highlight3DOrgans(targetMeshKeys) {
      if (!targetMeshKeys) return;
      const targetSet = new Set(targetMeshKeys);

      Object.entries(organMeshes).forEach(([key, mesh]) => {
        if (!mesh) return;

        // Determine if mesh is in target
        const isTarget = targetSet.has(key);

        const applyHighlight = (m) => {
          if (m.material) {
            if (isTarget) {
              m.material.opacity = 0.95;
              if (m.material.emissive) {
                m.material.emissive.setHex(0x38bdf8);
                m.material.emissiveIntensity = 0.35;
              }
            } else {
              m.material.opacity = 0.18;
              if (m.material.emissive) {
                m.material.emissiveIntensity = 0.0;
              }
            }
          }
        };

        if (mesh.isGroup) {
          mesh.traverse(child => {
            if (child.isMesh) applyHighlight(child);
          });
        } else if (mesh.isMesh) {
          applyHighlight(mesh);
        }
      });
    }

    // --- Update Right Clinical Details Panel Content ---
    function updateClinicalPanel(data) {
      document.getElementById('badgeRegionCode').textContent = data.code;
      document.getElementById('detailPill').textContent = data.name;
      document.getElementById('detailLatin').textContent = data.latin;
      document.getElementById('detailMainTitle').textContent = data.mainTitle;
      document.getElementById('detailSubTitle').textContent = data.subTitle;

      // Organ Tags
      const tagsContainer = document.getElementById('detailOrganTags');
      if (tagsContainer) {
        tagsContainer.innerHTML = data.organs.map((o, idx) => 
          `<span class="organ-chip ${idx < 3 ? 'highlight' : ''}">${o}</span>`
        ).join('');
      }

      // Red Flags List
      const redFlagsList = document.getElementById('detailRedFlagsList');
      if (redFlagsList) {
        redFlagsList.innerHTML = data.redFlags.map(rf => `<li>${rf}</li>`).join('');
      }

      // Differential Diagnosis
      const diffContainer = document.getElementById('detailDiffList');
      if (diffContainer) {
        diffContainer.innerHTML = data.differentials.map(d => `
          <div class="diff-item">
            <span class="diff-name">${d.name}</span>
            <span class="diff-desc">${d.desc}</span>
          </div>
        `).join('');
      }

      // Workup Steps
      const workupBox = document.getElementById('detailWorkupBox');
      if (workupBox) {
        workupBox.innerHTML = data.workup.map(w => `
          <div class="workup-step">
            <span class="step-num">${w.num}</span>
            <div class="step-content">
              <strong>${w.title}</strong>
              <p>${w.desc}</p>
            </div>
          </div>
        `).join('');
      }

      // SOAP Phrase
      const phraseContent = document.getElementById('chartPhraseText');
      if (phraseContent) {
        phraseContent.textContent = data.phrase;
      }
    }

    // --- Switch Display Mode (3D Stage vs 2D Matrix) ---
    function switchDisplayMode(mode) {
      displayMode = mode;

      document.querySelectorAll('.btn-mode').forEach(b => b.classList.remove('active'));
      document.getElementById(`btn-mode-${mode}`)?.classList.add('active');

      const stage3D = document.getElementById('threejs-canvas-container');
      const stage2D = document.getElementById('twod-grid-container');
      const toolbar = document.getElementById('viewAnglesToolbar');
      const orbitHint = document.getElementById('orbitHint');
      const modeText = document.getElementById('activeModeText');

      if (mode === '3d') {
        stage3D.classList.add('active');
        stage2D.classList.remove('active');
        if (toolbar) toolbar.style.display = 'flex';
        if (orbitHint) orbitHint.style.display = 'flex';
        if (modeText) modeText.textContent = '目前檢視：3D 人體器官透視 (點選九宮格即刻高亮對應臟器)';
        
        onWindowResize();
        selectRegion(currentRegion);
      } else {
        stage3D.classList.remove('active');
        stage2D.classList.add('active');
        if (toolbar) toolbar.style.display = 'none';
        if (orbitHint) orbitHint.style.display = 'none';
        if (modeText) modeText.textContent = '目前檢視：2D 醫療級九宮格速查盤 (點選任一宮格即連動臨床鑑別)';

        selectRegion(currentRegion);
      }
    }

    // --- 3D Preset Angle Toolbar Controls ---
    function set3DPresetView(preset) {
      document.querySelectorAll('.view-btn').forEach(b => b.classList.remove('active'));
      document.querySelector(`.view-btn[data-view="${preset}"]`)?.classList.add('active');

      const isMobile = window.innerWidth <= 1150;
      let targetPos = new THREE.Vector3(0, isMobile ? 0.9 : 0.2, isMobile ? 14.5 : 9.5);
      let targetLook = new THREE.Vector3(0, isMobile ? 0.8 : 0.1, 0);

      switch(preset) {
        case 'anterior':
          targetPos.set(0, isMobile ? 0.9 : 0.2, isMobile ? 14.5 : 9.5);
          targetLook.set(0, isMobile ? 0.8 : 0.1, 0);
          break;
        case 'upper':
          targetPos.set(0, isMobile ? 1.5 : 1.1, isMobile ? 10.5 : 7.0);
          targetLook.set(0, isMobile ? 1.2 : 0.9, 0.1);
          break;
        case 'lower':
          targetPos.set(0, isMobile ? -1.2 : -1.5, isMobile ? 10.5 : 7.0);
          targetLook.set(0, isMobile ? -1.6 : -1.8, 0.1);
          break;
        case 'right_flank':
          targetPos.set(isMobile ? -8.5 : -6.5, isMobile ? 0.5 : 0.2, isMobile ? 7.0 : 4.5);
          targetLook.set(-1.0, isMobile ? 0.3 : 0.0, 0);
          break;
        case 'left_flank':
          targetPos.set(isMobile ? 8.5 : 6.5, isMobile ? 0.5 : 0.2, isMobile ? 7.0 : 4.5);
          targetLook.set(1.0, isMobile ? 0.3 : 0.0, 0);
          break;
      }

      new TWEEN.Tween(camera.position).to(targetPos, 850).easing(TWEEN.Easing.Cubic.Out).start();
      new TWEEN.Tween(controls.target).to(targetLook, 850).easing(TWEEN.Easing.Cubic.Out).start();
    }

    function resetView() {
      set3DPresetView('anterior');
      selectRegion('epigastric');
      showToast('已重設為正面全覽視角');
    }

    // --- Mobile Tab Switching ---
    function switchMobileTab(tab) {
      document.querySelectorAll('.mobile-tab-btn').forEach(b => b.classList.remove('active'));
      document.getElementById(`tab-btn-${tab}`)?.classList.add('active');

      const regionsPane = document.getElementById('pane-regions-pathology');
      const detailsPane = document.getElementById('pane-clinical-details');
      const redFlagsBox = document.getElementById('detailRedFlagsBox');
      const phraseBox = document.querySelector('.phrase-box');

      if (window.innerWidth <= 1150) {
        if (tab === 'regions') {
          if (regionsPane) regionsPane.style.display = 'flex';
          if (detailsPane) detailsPane.style.display = 'none';
        } else if (tab === 'pathology') {
          if (regionsPane) regionsPane.style.display = 'none';
          if (detailsPane) detailsPane.style.display = 'flex';
          if (redFlagsBox) redFlagsBox.style.display = 'block';
          if (phraseBox) phraseBox.style.display = 'none';
        } else if (tab === 'details') {
          if (regionsPane) regionsPane.style.display = 'none';
          if (detailsPane) detailsPane.style.display = 'flex';
          if (redFlagsBox) redFlagsBox.style.display = 'none';
          if (phraseBox) phraseBox.style.display = 'block';
        }
      }
    }

    // --- Fullscreen Toggle ---
    function toggleFullScreen() {
      const wrapper = document.getElementById('abdAppWrapper');
      if (!document.fullscreenElement) {
        if (wrapper && wrapper.requestFullscreen) {
          wrapper.requestFullscreen();
        } else if (document.documentElement.requestFullscreen) {
          document.documentElement.requestFullscreen();
        }
      } else {
        if (document.exitFullscreen) {
          document.exitFullscreen();
        }
      }
    }

    // --- Copy Phrase Toast ---
    function copyPhrase() {
      const text = document.getElementById('chartPhraseText')?.innerText;
      if (text) {
        navigator.clipboard.writeText(text).then(() => {
          showToast('已複製門診英文病歷片語');
        });
      }
    }

    function showToast(msg) {
      const toast = document.getElementById('toast');
      const toastText = document.getElementById('toastText');
      if (toast && toastText) {
        toastText.textContent = msg;
        toast.classList.add('show');
        setTimeout(() => toast.classList.remove('show'), 2500);
      }
    }

    // Boot
    window.addEventListener('DOMContentLoaded', () => {
      init3D();
    });
  </script>
</Layout>

<style>
  :root {
    --bg-main: #060b14;
    --border-color: rgba(56, 189, 248, 0.2);
    --accent-cyan: #00e5ff;
    --accent-blue: #38bdf8;
    --accent-emerald: #10b981;
    --accent-amber: #f59e0b;
    --accent-rose: #f43f5e;
    --text-main: #f8fafc;
    --text-sub: #94a3b8;
  }

  .abd-app-wrapper {
    background-color: var(--bg-main);
    color: var(--text-main);
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    overflow-x: hidden;
    user-select: none;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
  }

  /* Subnav Header */
  .anatomy-subnav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.65rem 1.5rem;
    background: rgba(10, 20, 36, 0.85);
    backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--border-color);
    z-index: 30;
  }

  .subnav-left {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .back-link {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    color: #cbd5e1;
    text-decoration: none;
    font-size: 0.95rem;
    font-weight: 700;
    transition: all 0.2s;
  }
  .back-link:hover {
    color: var(--accent-cyan);
    transform: translateX(-2px);
  }

  .divider {
    color: #475569;
    font-weight: 300;
  }

  .current-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.95rem;
    font-weight: 800;
    color: #f1f5f9;
  }

  .pulse-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background-color: #38bdf8;
    box-shadow: 0 0 10px #38bdf8;
    animation: pulse 2s infinite;
  }

  @keyframes pulse {
    0%, 100% { opacity: 1; transform: scale(1); }
    50% { opacity: 0.4; transform: scale(1.25); }
  }

  .subnav-right {
    display: flex;
    align-items: center;
    gap: 0.55rem;
  }

  /* Mode Switcher Group */
  .mode-toggle-group {
    display: inline-flex;
    background: rgba(15, 23, 42, 0.9);
    border: 1.5px solid var(--border-color);
    border-radius: 10px;
    padding: 2px;
    gap: 2px;
  }

  .btn-mode {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.42rem 0.85rem;
    border-radius: 8px;
    border: none;
    background: transparent;
    color: #94a3b8;
    font-size: 0.88rem;
    font-weight: 700;
    cursor: pointer;
    transition: all 0.2s;
  }
  .btn-mode:hover {
    color: #f8fafc;
  }
  .btn-mode.active {
    background: linear-gradient(135deg, rgba(56, 189, 248, 0.3), rgba(37, 99, 235, 0.3));
    color: #38bdf8;
    box-shadow: 0 0 12px rgba(56, 189, 248, 0.3);
  }

  .btn {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.45rem 0.95rem;
    border-radius: 9px;
    font-size: 0.9rem;
    font-weight: 700;
    cursor: pointer;
    transition: all 0.2s;
    border: 1px solid transparent;
  }

  .btn-fullscreen {
    background: rgba(255, 255, 255, 0.05);
    border-color: rgba(255, 255, 255, 0.12);
    color: #cbd5e1;
  }
  .btn-fullscreen:hover {
    background: rgba(255, 255, 255, 0.12);
    color: #fff;
  }

  .btn-primary {
    background: linear-gradient(135deg, #0284c7, #2563eb);
    color: #fff;
  }
  .btn-primary:hover {
    background: linear-gradient(135deg, #38bdf8, #3b82f6);
    box-shadow: 0 0 16px rgba(56, 189, 248, 0.4);
  }

  /* Workspace Grid */
  .workspace-grid {
    display: grid;
    grid-template-columns: 360px 1fr 440px;
    grid-template-areas: "left center right";
    height: calc(100vh - 120px);
    width: 100vw;
    max-width: 100%;
    gap: 0.85rem;
    padding: 0.75rem 1.25rem 1rem;
    box-sizing: border-box;
  }

  .abd-app-wrapper:fullscreen .workspace-grid {
    height: calc(100vh - 56px);
  }

  /* Glass Panels */
  .glass-panel {
    background: rgba(11, 22, 38, 0.8);
    backdrop-filter: blur(14px);
    border: 1px solid var(--border-color);
    border-radius: 16px;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    box-shadow: 0 12px 30px rgba(0, 0, 0, 0.4);
  }

  .left-panel {
    grid-area: left;
    height: 100%;
    min-height: 0;
  }

  .canvas-panel {
    grid-area: center;
    height: 100%;
    min-height: 0;
    position: relative;
    background: radial-gradient(circle at 50% 45%, #0e1e34 0%, #060b14 100%);
  }

  .right-panel {
    grid-area: right;
    height: 100%;
    min-height: 0;
  }

  .panel-header {
    display: flex;
    align-items: center;
