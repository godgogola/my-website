      new THREE.Vector3(-1.7, 1.2, -0.1),   // Hepatic Flexure (85 cm)
      new THREE.Vector3(-1.9, 0.2, -0.2),   // Mid Ascending Colon (90 cm)
      new THREE.Vector3(-1.8, -1.2, 0.0),   // Lower Ascending (95 cm)
      new THREE.Vector3(-1.8, -1.8, 0.2),   // Cecum Pole (100 cm)
      new THREE.Vector3(-1.4, -2.3, 0.3)    // Vermiform Appendix Tip (Bonus)
