    let currentColonProgStage = 0;
    let isColonAutoplaying = false;
    let colonTimer = null;
    let colonProgressionMeshGroup = null;

    // 虛擬第一人稱大腸鏡巡航參數
    let isColonFlythroughMode = false;
    let colonFlythroughT = 0.04;
    let isColonFlyPaused = false;
    let flySavedCamPos = new THREE.Vector3();
    let flySavedLookAt = new THREE.Vector3();
    let flyColonEndoLight = null;

    function switchColonControlTab(tab) {
      const scopeBar = document.getElementById('canvas-scope-bar');
      const progBar = document.getElementById('canvas-colon-progression-bar');
      const tabScope = document.getElementById('tab-btn-scope');
      const tabProg = document.getElementById('tab-btn-progression');

      if (tab === 'scope') {
        if (scopeBar) scopeBar.style.display = 'block';
        if (progBar) progBar.style.display = 'none';
        if (tabScope) tabScope.classList.add('active');
        if (tabProg) tabProg.classList.remove('active');
        stopColonAutoplay();
      } else {
        if (scopeBar) scopeBar.style.display = 'none';
        if (progBar) progBar.style.display = 'flex';
        if (tabScope) tabScope.classList.remove('active');
        if (tabProg) tabProg.classList.add('active');
        setColonProgressionStage(currentColonProgStage);
      }
    }

    function setColonProgressionStage(stageIdx) {
      currentColonProgStage = Math.max(0, Math.min(3, stageIdx));
      const data = COLON_PROGRESSION_STAGES[currentColonProgStage];

      // 更新 UI 滑桿與 Pill 按鈕
      const slider = document.getElementById('slider-colon-prog');
      if (slider) slider.value = currentColonProgStage;

      document.querySelectorAll('#canvas-colon-progression-bar .stage-pill').forEach(pill => {
        pill.classList.toggle('active', parseInt(pill.dataset.stage) === currentColonProgStage);
      });

      // 更新衛教卡
      const card = document.getElementById('colon-clinical-card');
      if (card) {
        card.innerHTML = `
          <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 4px;">
            <strong style="color: #f8fafc; font-size: 0.85rem;">${data.name}</strong>
            <span class="reversibility-tag ${data.reversibility}">${data.reversibilityText}</span>
          </div>
          <div style="color: #cbd5e1; margin-bottom: 3px;"><strong>【病理變化】</strong>${data.pathology}</div>
          <div style="color: #94a3b8; margin-bottom: 3px;"><strong>【臨床特點】</strong>${data.clinical}</div>
          <div style="color: #34d399; font-weight: 600;"><strong>【處置建議】</strong>${data.advice}</div>
        `;
      }

      // 更新大腸材質
      if (colonMaterial) {
        colonMaterial.color.setHex(data.colonColor);
        colonMaterial.roughness = data.roughness;
        colonMaterial.clearcoat = data.clearcoat;
      }

      // 切換 3D 息肉演進模型顯示
      if (colonProgressionMeshGroup) {
        colonProgressionMeshGroup.children.forEach(child => {
          child.visible = (child.userData.stage === currentColonProgStage);
        });
      }
    }

    function toggleColonAutoplay() {
      if (isColonAutoplaying) stopColonAutoplay();
      else startColonAutoplay();
    }

    function startColonAutoplay() {
      isColonAutoplaying = true;
      const btn = document.getElementById('btn-colon-autoplay');
      const icon = document.getElementById('colon-play-icon');
      const text = document.getElementById('colon-play-text');
      if (btn) btn.classList.add('active');
      if (icon) icon.textContent = '⏸';
      if (text) text.textContent = '暫停';

      colonTimer = setInterval(() => {
        const nextStage = (currentColonProgStage + 1) % 4;
        setColonProgressionStage(nextStage);
      }, 2800);
    }

    function stopColonAutoplay() {
      isColonAutoplaying = false;
      if (colonTimer) {
        clearInterval(colonTimer);
        colonTimer = null;
      }
      const btn = document.getElementById('btn-colon-autoplay');
      const icon = document.getElementById('colon-play-icon');
      const text = document.getElementById('colon-play-text');
      if (btn) btn.classList.remove('active');
      if (icon) icon.textContent = '▶';
      if (text) text.textContent = '自動演變';
    }

    // 建立大腸息肉生成時序 3D 模型組 (Stage 1 小型, Stage 2 有莖進行性, Stage 3 浸潤性大腸癌)
    function buildColonProgressionModels() {
      colonProgressionMeshGroup = new THREE.Group();
      // 位於乙狀結腸黏膜腔壁內側 (1.48, -1.82, 0.42)
      const basePos = new THREE.Vector3(1.48, -1.82, 0.42);

      // --- Stage 1: 小型管狀腺瘤 (<5mm, 0-Is 廣基隆起型) ---
      const s1Mat = new THREE.MeshPhysicalMaterial({
        color: 0xf43f5e,
        roughness: 0.28,
        clearcoat: 0.82,
        emissive: 0xe11d48,
        emissiveIntensity: 0.4
      });
      const s1Geom = new THREE.SphereGeometry(0.08, 14, 14);
      s1Geom.scale(1.0, 0.6, 1.0);
      const s1Mesh = new THREE.Mesh(s1Geom, s1Mat);
      s1Mesh.position.copy(basePos);
      s1Mesh.userData = { stage: 1 };
      colonProgressionMeshGroup.add(s1Mesh);

      // --- Stage 2: 進行性腺瘤 (>10mm, 0-Ip 有莖型，分葉菜花頭) ---
      const s2Group = new THREE.Group();
      const stalkGeom = new THREE.CylinderGeometry(0.04, 0.05, 0.26, 8);
      const stalkMat = new THREE.MeshStandardMaterial({ color: 0x9e352b, roughness: 0.35 });
      const stalkMesh = new THREE.Mesh(stalkGeom, stalkMat);
      stalkMesh.position.set(0, 0.12, 0);

      const headMat = new THREE.MeshPhysicalMaterial({
        color: 0xbe123c,
        roughness: 0.22,
        clearcoat: 0.88,
        emissive: 0x9f1239,
        emissiveIntensity: 0.6
      });
      const headGeom = new THREE.SphereGeometry(0.16, 16, 16);
      headGeom.scale(1.2, 1.0, 1.1);
      headGeom.translate(0, 0.26, 0);
      const headMesh = new THREE.Mesh(headGeom, headMat);

      // 菜花狀小突起
      for (let i = 0; i < 4; i++) {
        const nodule = new THREE.Mesh(new THREE.SphereGeometry(0.06, 8, 8), headMat);
        nodule.position.set(
          Math.cos(i * 1.57) * 0.11,
          0.26 + Math.sin(i * 1.57) * 0.05,
          Math.sin(i * 1.57) * 0.11
        );
        headMesh.add(nodule);
      }

      s2Group.add(stalkMesh);
      s2Group.add(headMesh);
      s2Group.position.copy(basePos);
      s2Group.rotation.z = -Math.PI / 4;
      s2Group.rotation.x = Math.PI / 6;
      s2Group.userData = { stage: 2 };
      colonProgressionMeshGroup.add(s2Group);

      // --- Stage 3: 浸潤性大腸癌 (菜花狀腫瘤隆起、中心深陷壞死潰瘍火山口、管壁浸潤) ---
      const s3Group = new THREE.Group();
      const cancerBaseGeom = new THREE.CylinderGeometry(0.28, 0.32, 0.12, 16);
      const cancerBaseMat = new THREE.MeshStandardMaterial({
        color: 0x661812,
        roughness: 0.65,
        emissive: 0x4a0e08,
        emissiveIntensity: 0.4
      });
      const cancerBaseMesh = new THREE.Mesh(cancerBaseGeom, cancerBaseMat);

      // 火山口中心凹陷與壞死白苔
      const craterGeom = new THREE.CylinderGeometry(0.14, 0.10, 0.06, 16);
      const craterMat = new THREE.MeshStandardMaterial({
        color: 0xf1f5f9,
        roughness: 0.7,
        emissive: 0x94a3b8,
        emissiveIntensity: 0.35
      });
      const craterMesh = new THREE.Mesh(craterGeom, craterMat);
      craterMesh.position.set(0, 0.04, 0);
      cancerBaseMesh.add(craterMesh);

      // 周圍隆起浸潤外翻邊緣 (Everted nodular margin)
      const rimGeom = new THREE.TorusGeometry(0.24, 0.06, 8, 16);
      const rimMat = new THREE.MeshPhysicalMaterial({
        color: 0x991b1b,
        roughness: 0.35,
        clearcoat: 0.4,
        emissive: 0x7f1d1d,
        emissiveIntensity: 0.5
      });
      const rimMesh = new THREE.Mesh(rimGeom, rimMat);
      rimMesh.position.set(0, 0.06, 0);
      rimMesh.rotation.x = Math.PI / 2;
      cancerBaseMesh.add(rimMesh);

      s3Group.add(cancerBaseMesh);
      s3Group.position.copy(basePos);
      s3Group.rotation.z = -Math.PI / 4;
      s3Group.rotation.x = Math.PI / 6;
      s3Group.userData = { stage: 3 };
      colonProgressionMeshGroup.add(s3Group);

      // 預設全隱藏
      colonProgressionMeshGroup.children.forEach(c => c.visible = false);
      scene.add(colonProgressionMeshGroup);
    }

    // ── 虛擬大腸鏡第一人稱「腔內飛行巡航 (Colonoscopy Fly-through)」──
    function toggleColonFlythrough() {
      if (isColonFlythroughMode) {
        exitColonFlythrough();
      } else {
        startColonFlythrough();
      }
    }

    function startColonFlythrough() {
      if (!colonSplineCurve) return;
      isColonFlythroughMode = true;
      controls.enabled = false;
      colonFlythroughT = 0.04;
      isColonFlyPaused = false;

      // 備份相機狀態
      flySavedCamPos.copy(camera.position);
      flySavedLookAt.copy(controls.target);

      // 建立腔內探照燈
      if (!flyColonEndoLight) {
        flyColonEndoLight = new THREE.PointLight(0xffffff, 2.8, 5.0);
        scene.add(flyColonEndoLight);
      }
      flyColonEndoLight.visible = true;

      // 顯示 HUD
      const hud = document.getElementById('colon-flythrough-hud');
      if (hud) hud.style.display = 'flex';

      // 隱藏一般控制欄
      const scopeBar = document.getElementById('canvas-scope-bar');
      const progBar = document.getElementById('canvas-colon-progression-bar');
      const tabs = document.querySelector('.canvas-mode-tabs');
      if (scopeBar) scopeBar.style.display = 'none';
      if (progBar) progBar.style.display = 'none';
      if (tabs) tabs.style.display = 'none';

      // 確保息肉模型可見以供 AI 偵測辨識
      if (pathologyGroup) {
        pathologyGroup.children.forEach(c => {
          if (c.userData.type === 'polyp') c.visible = true;
        });
      }

      showToast('🚀 已啟動虛擬大腸鏡腔內飛行巡航！');
    }

    function exitColonFlythrough() {
      isColonFlythroughMode = false;
      isColonFlyPaused = false;

      // 隱藏 HUD
      const hud = document.getElementById('colon-flythrough-hud');
      if (hud) hud.style.display = 'none';

      if (flyColonEndoLight) flyColonEndoLight.visible = false;

      // 還原一般控制欄
      const tabs = document.querySelector('.canvas-mode-tabs');
      if (tabs) tabs.style.display = 'inline-flex';
      switchColonControlTab('scope');

      // 平滑歸還攝影機給 OrbitControls
      controls.enabled = true;
      new TWEEN.Tween(camera.position)
        .to(flySavedCamPos, 900)
        .easing(TWEEN.Easing.Cubic.Out)
        .start();

      new TWEEN.Tween(controls.target)
        .to(flySavedLookAt, 900)
        .easing(TWEEN.Easing.Cubic.Out)
        .start();

      showToast('已結束大腸鏡巡航，回歸 3D 解剖視角');
    }

    function toggleColonFlyPause() {
      isColonFlyPaused = !isColonFlyPaused;
      const btn = document.getElementById('btn-colon-fly-pause');
      if (btn) btn.textContent = isColonFlyPaused ? '▶ 繼續' : '⏸ 暫停';
    }

    function animate(time) {
      requestAnimationFrame(animate);
      TWEEN.update();

      // 虛擬大腸鏡第一人稱「腔內飛行巡航 (Fly-through)」
      if (isColonFlythroughMode && colonSplineCurve) {
        if (!isColonFlyPaused) {
          colonFlythroughT += 0.0014; // 平滑前進
          if (colonFlythroughT >= 0.96) {
            colonFlythroughT = 0.04; // 循環巡航
          }
        }

        const t = colonFlythroughT;
        // 沿大腸曲線前進 (直腸 0cm 到盲腸 100cm)
        const tCurve = t * 0.92;
        const pt = colonSplineCurve.getPoint(tCurve);
        const tan = colonSplineCurve.getTangent(tCurve).normalize();

        camera.position.copy(pt);
        if (flyColonEndoLight) flyColonEndoLight.position.copy(pt);

        // 更新進度條
        const fillEl = document.getElementById('fly-colon-progress-fill');
        if (fillEl) fillEl.style.width = `${Math.round(t * 100)}%`;

        const cmEst = Math.round(t * 100);
        const statusText = document.getElementById('fly-colon-status-text');
        const aiAlert = document.getElementById('fly-ai-alert');
        const cecumAlert = document.getElementById('fly-cecum-alert');

        // AI 息肉即時辨識 (CADe / CADx)：在乙狀結腸 (t 在 0.22 ~ 0.35 之間)
        if (t >= 0.22 && t <= 0.35) {
          if (aiAlert) aiAlert.style.display = 'block';
        } else {
          if (aiAlert) aiAlert.style.display = 'none';
        }

        // 盲腸達標 (Cecal Intubation)：t >= 0.88
        if (t >= 0.88) {
          if (cecumAlert) cecumAlert.style.display = 'block';
        } else {
          if (cecumAlert) cecumAlert.style.display = 'none';
        }

        let locName = '直腸段 (Rectum)';
        if (cmEst >= 15 && cmEst < 40) locName = '乙狀結腸 (Sigmoid Colon)';
        else if (cmEst >= 40 && cmEst < 55) locName = '降結腸與脾曲 (Descending Colon)';
        else if (cmEst >= 55 && cmEst < 80) locName = '橫結腸 (Transverse Colon)';
        else if (cmEst >= 80 && cmEst < 95) locName = '升結腸與肝曲 (Ascending Colon)';
        else if (cmEst >= 95) locName = '盲腸底與闌尾口 (Cecal Pole & ICV)';

        if (statusText) statusText.textContent = `大腸鏡腔內飛行巡航 · ${locName} (${cmEst}cm)`;
        camera.lookAt(pt.clone().add(tan.clone().multiplyScalar(1.5)));
      } else {
        if (controls) controls.update();
      }

      const t = (time || performance.now()) * 0.005;

      if (scopeHeadLight) {
        scopeHeadLight.intensity = 2.0 + Math.sin(t) * 0.5;
      }

      if (focusBeaconMesh) {
        focusBeaconMesh.rotation.z += 0.02;
        focusBeaconMesh.scale.setScalar(1.0 + Math.sin(t * 2) * 0.15);
      }

      if (renderer && scene && camera) {
        renderer.render(scene, camera);
      }
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', init3D);
    } else {
      init3D();
    }
  </script>
</Layout>

