---
import Layout from '../../layouts/Layout.astro';
---

<Layout 
  title="大腸與直腸 3D 互動解剖暨內視鏡巡航系統 | 互動解剖圖鑑 - 黃冠智醫師" 
  description="大腸直腸一體成型 3D 實體模型。包含大腸鏡進鏡深度模擬（0-100cm）、息肉/憩室/痔瘡病灶標記、結腸袋構造與各腸段病歷片語產生器。"
  fullWidth={true}
  hideFooter={true}
>
  <!-- Three.js CDN dependencies -->
  <script is:inline src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js"></script>
  <script is:inline src="https://cdn.jsdelivr.net/npm/three@0.128.0/examples/js/controls/OrbitControls.js"></script>
  <script is:inline src="https://cdnjs.cloudflare.com/ajax/libs/tween.js/18.6.4/tween.umd.js"></script>

  <div class="colon-app-wrapper" id="colonAppWrapper">
    <!-- Subheader with breadcrumb & action controls -->
    <div class="anatomy-subnav">
      <div class="subnav-left">
        <a href="/anatomy" class="back-link">
          <svg width="15" height="15" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path d="M19 12H5M12 19l-7-7 7-7"/></svg>
          <span>圖鑑總覽</span>
        </a>
        <div class="divider">/</div>
        <div class="current-badge">
          <span class="pulse-dot"></span>
          <span>大腸與直腸 (3D 解剖模型)</span>
        </div>
      </div>
      
      <div class="subnav-right">
        <!-- 大腸鏡直通胃鏡快捷切換按鈕 -->
        <a href="/anatomy/stomach" class="btn btn-switch-endo" title="快速切換至胃部與食道 3D 解剖">
          <span class="endo-icon">🩺</span>
          <span class="btn-text-prefix">切換至</span>
          <span>胃鏡</span>
          <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
        </a>

        <!-- Fullscreen Button -->
        <button class="btn btn-fullscreen" id="btn-fullscreen-toggle" onclick="toggleFullScreen()" title="進入/退出全螢幕診間衛教模式">
          <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" id="icon-fs"><path d="M8 3H5a2 2 0 0 0-2 2v3m18 0V5a2 2 0 0 0-2-2h-3m0 18h3a2 2 0 0 0 2-2v-3M3 16v3a2 2 0 0 0 2 2h3"/></svg>
          <span class="btn-text-full">全螢幕</span>
        </button>
        <button class="btn btn-outline" id="btn-toggle-quiz" onclick="toggleQuizMode()">
          <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M9 11l3 3L22 4"/><path d="M21 12v7a2 2 0 01-2 2H5a2 2 0 01-2-2V5a2 2 0 012-2h11"/></svg>
          <span class="btn-text-full">3D 測驗</span>
        </button>
        <button class="btn btn-primary" onclick="reset3DCamera()">
          <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M3 12a9 9 0 1 0 9-9 9.75 9.75 0 0 0-6.74 2.74L3 8"/><path d="M3 3v5h5"/></svg>
          <span>重設</span>
        </button>
      </div>
    </div>

    <!-- Main 3-Column Workspace Grid -->
    <div class="workspace-grid">

      <!-- Mobile Tab Switcher Navigation -->
      <div class="mobile-tabs-nav">
        <button class="mobile-tab-btn active" id="tab-btn-regions" onclick="switchMobileTab('regions')">
          📍 6大腸段
        </button>
        <button class="mobile-tab-btn" id="tab-btn-pathology" onclick="switchMobileTab('pathology')">
          🩺 息肉與病灶
        </button>
        <button class="mobile-tab-btn" id="tab-btn-details" onclick="switchMobileTab('details')">
          📋 檢查片語
        </button>
      </div>

      <!-- Left Panel: Scope Navigation, Pathologies & Controls (Column 1 on Desktop) -->
      <div class="glass-panel left-panel mobile-tab-pane" id="pane-regions-pathology">
        <div class="panel-header">
          <div class="panel-title">
            <svg width="16" height="16" fill="none" stroke="#10b981" stroke-width="2" viewBox="0 0 24 24"><path d="M4 14c0 3.5 3 6 8 6s8-2.5 8-6-3-6-8-6-8 2.5-8 6Z"/><path d="M6 10V6a2 2 0 0 1 2-2h8a2 2 0 0 1 2 2v4"/></svg>
            大腸鏡巡航與病灶標記
          </div>
        </div>
        
        <div class="panel-body">
          
          <!-- Pathology Marker Toggles (息肉 / 憩室 / 痔瘡) -->
          <div class="control-row pathology-section-box">
            <div class="section-label" style="margin-bottom: 0.45rem;">
              常見病灶標記 (點擊在 3D 腸道顯示)
            </div>
            <div class="pathology-btn-group">
              <button class="btn btn-pathology" id="btn-path-polyp" onclick="togglePathology('polyp')">
                <span class="path-dot dot-polyp"></span>
                大腸息肉 (Polyps)
              </button>
              <button class="btn btn-pathology" id="btn-path-diverticulum" onclick="togglePathology('diverticulum')">
                <span class="path-dot dot-diverticulum"></span>
                大腸憩室 (Diverticula)
              </button>
              <button class="btn btn-pathology" id="btn-path-hemorrhoid" onclick="togglePathology('hemorrhoid')">
                <span class="path-dot dot-hemorrhoid"></span>
                痔瘡 (Hemorrhoids)
              </button>
            </div>
            <div class="pathology-info-text" id="pathology-info-text">
              點選上方按鈕可即時切提高病灶位置與臨床處置說明。
            </div>
          </div>

          <!-- Tissue Opacity Slider -->
          <div class="control-row opacity-section-box">
            <div class="control-label-group">
              <span>腸壁透明度 (Wall Opacity)</span>
              <span id="txt-opacity-val" class="slider-val">95%</span>
            </div>
            <input type="range" id="slider-opacity" min="20" max="100" value="95" oninput="onOpacitySlider(this.value)">
            <div class="slider-subtext-single">
              調低透明度可透視內部管腔與大腸鏡推進路徑
            </div>
          </div>

          <!-- Segment List -->
          <div class="section-label">
            點選解剖腸段 (COLONIC SEGMENTS)
          </div>
          <div class="segment-grid-list">
            <div class="seg-card-btn" onclick="selectSegment('rectum')" id="btn-seg-rectum">
              <div class="seg-card-top">
                <span class="seg-num-pill">0~15cm</span>
                <span class="seg-loc-tag">盆腔最底</span>
              </div>
              <div class="seg-card-name">直腸與肛門 (Rectum)</div>
            </div>

            <div class="seg-card-btn" onclick="selectSegment('sigmoid')" id="btn-seg-sigmoid">
              <div class="seg-card-top">
                <span class="seg-num-pill">15~40cm</span>
                <span class="seg-loc-tag">彎曲拉扯區</span>
              </div>
              <div class="seg-card-name">乙狀結腸 (Sigmoid)</div>
            </div>

            <div class="seg-card-btn" onclick="selectSegment('descending')" id="btn-seg-descending">
              <div class="seg-card-top">
                <span class="seg-num-pill">40~55cm</span>
                <span class="seg-loc-tag">左側腹後壁</span>
              </div>
              <div class="seg-card-name">降結腸與脾曲 (Descending)</div>
            </div>

            <div class="seg-card-btn" onclick="selectSegment('transverse')" id="btn-seg-transverse">
              <div class="seg-card-top">
                <span class="seg-num-pill">55~80cm</span>
                <span class="seg-loc-tag">上腹游離段</span>
              </div>
              <div class="seg-card-name">橫結腸 (Transverse)</div>
            </div>

            <div class="seg-card-btn" onclick="selectSegment('ascending')" id="btn-seg-ascending">
              <div class="seg-card-top">
                <span class="seg-num-pill">80~95cm</span>
                <span class="seg-loc-tag">右側腹後壁</span>
              </div>
              <div class="seg-card-name">升結腸與肝曲 (Ascending)</div>
            </div>

            <div class="seg-card-btn" onclick="selectSegment('cecum')" id="btn-seg-cecum">
              <div class="seg-card-top">
                <span class="seg-num-pill">95~100+cm</span>
                <span class="seg-loc-tag">檢查終點標記</span>
              </div>
              <div class="seg-card-name">盲腸與闌尾 (Cecum)</div>
            </div>
          </div>

        </div>
      </div>

      <!-- Center Stage: Three.js True 3D Colorectal WebGL Canvas (Column 2 on Desktop) -->
      <div class="glass-panel canvas-panel">
        <!-- Preset View Angles Toolbar -->
        <div class="view-angles-toolbar">
          <button class="view-btn active" id="view-btn-anterior" onclick="setPresetView('anterior')">正面全覽</button>
          <button class="view-btn flythrough-btn" id="btn-colon-flythrough" onclick="toggleColonFlythrough()" style="background: linear-gradient(135deg, #10b981, #059669); color: #ffffff; border-color: #34d399; font-weight: 800;">🚀 大腸鏡腔內巡航 (直腸至盲腸)</button>
          <button class="view-btn" id="view-btn-left-colon" onclick="setPresetView('left_colon')">左側大腸觀</button>
          <button class="view-btn" id="view-btn-right-colon" onclick="setPresetView('right_colon')">右側盲腸觀</button>
          <button class="view-btn" id="view-btn-splenic" onclick="setPresetView('splenic')">脾曲視角</button>
          <button class="view-btn" id="view-btn-pelvis" onclick="setPresetView('pelvis')">直腸仰視</button>
        </div>

        <!-- ThreeJS Canvas Container -->
        <div id="threejs-canvas-container"></div>

        <!-- Orbit Controls Guidance Hint (Top Right) -->
        <div class="orbit-hint hide-mobile">
          <svg width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><path d="M12 8v8M8 12h8"/></svg>
          <span><strong>滑鼠左鍵拖曳</strong>：360° 空間旋轉 ｜ <strong>滾輪</strong>：拉近縮放 ｜ <strong>下方滑桿</strong>：內視鏡深度</span>
        </div>

        <!-- Mode Tabs: Scope Navigation vs Polyp Progression -->
        <div class="canvas-mode-tabs">
          <button class="mode-tab-btn active" id="tab-btn-scope" onclick="switchColonControlTab('scope')">🔭 大腸鏡進鏡深度</button>
          <button class="mode-tab-btn" id="tab-btn-progression" onclick="switchColonControlTab('progression')">🩺 大腸息肉癌變時序演變</button>
        </div>

        <!-- 大腸息肉生成 4 階段控制卡片 (Disease Progression Slider) -->
        <div class="canvas-progression-bar" id="canvas-colon-progression-bar" style="display: none;">
          <div class="prog-header">
            <div class="prog-title-group">
              <span class="prog-badge">臨床時序</span>
              <span class="prog-main-title">大腸腺瘤至腺癌演變時序 (Adenoma-Carcinoma Sequence)</span>
            </div>
            <button class="prog-autoplay-btn" id="btn-colon-autoplay" onclick="toggleColonAutoplay()" title="自動播放病情演變過程">
              <span id="colon-play-icon">▶</span>
              <span id="colon-play-text">自動演變</span>
            </button>
          </div>

          <!-- 4 階段快捷切換按鈕 -->
          <div class="steatosis-stage-pills">
            <button class="stage-pill active" data-stage="0" onclick="setColonProgressionStage(0)">
              <span class="pill-dot stage-0"></span>正常腸黏膜
            </button>
            <button class="stage-pill" data-stage="1" onclick="setColonProgressionStage(1)">
              <span class="pill-dot stage-1"></span>小型管狀腺瘤 (&lt;5mm)
            </button>
            <button class="stage-pill" data-stage="2" onclick="setColonProgressionStage(2)">
              <span class="pill-dot stage-2"></span>進行性腺瘤 (有莖 &gt;10mm)
            </button>
            <button class="stage-pill" data-stage="3" onclick="setColonProgressionStage(3)">
              <span class="pill-dot stage-3"></span>浸潤性大腸癌 (潰瘍狹窄)
            </button>
          </div>

          <!-- 進展滑桿 -->
          <div class="prog-slider-wrapper">
            <input type="range" id="slider-colon-prog" min="0" max="3" step="1" value="0" oninput="setColonProgressionStage(parseInt(this.value))">
            <div class="prog-slider-milestones">
              <span>正常健康粉紅</span>
              <span>微小息肉丘疹</span>
              <span>巨大有莖異型增生</span>
              <span>菜花浸潤火山口</span>
            </div>
          </div>

          <!-- 臨床衛教與處置建議卡 -->
          <div class="prog-clinical-card" id="colon-clinical-card">
            <!-- 動態填入 -->
          </div>
        </div>

        <!-- 第一人稱大腸鏡腔內飛行巡航 HUD 懸浮視窗 -->
        <div class="flythrough-hud-overlay" id="colon-flythrough-hud" style="display: none;">
          <div class="fly-top-badge">
            <div class="fly-indicator-pulse"></div>
            <span id="fly-colon-status-text">大腸鏡腔內飛行巡航進行中 · 直腸段 (5cm)</span>
          </div>

          <!-- AI 輔助息肉偵測綠色科技提示框 (CADe / CADx Alert) -->
          <div class="fly-ai-alert" id="fly-ai-alert" style="display: none;">
            <div class="ai-box-header">
              <span class="ai-box-badge">🟢 內視鏡 AI 即時辨識 (CADe / CADx)</span>
              <span class="ai-box-confidence">信心度 98.6%</span>
            </div>
            <div class="ai-box-body">
              <strong>發現病灶：</strong>乙狀結腸 0.8cm 腺瘤性息肉 (Paris 0-Ip 有蒂型)
            </div>
            <div class="ai-box-footer">
              <span>處置指引：建議進行<strong>冷息肉圈切術 (CSP)</strong>，100% 阻斷癌變途徑！</span>
            </div>
          </div>

          <!-- 盲腸達標 (Cecal Intubation) 提示框 -->
          <div class="fly-cecum-alert" id="fly-cecum-alert" style="display: none;">
            🎯 抵達全大腸檢查終點 (Cecal Intubation 100cm) · 目視闌尾開口與迴盲瓣
          </div>

          <div class="fly-bottom-controls">
            <button class="fly-ctrl-btn" id="btn-colon-fly-pause" onclick="toggleColonFlyPause()">⏸ 暫停</button>
            <div class="fly-progress-bar-wrap">
              <div class="fly-progress-fill" id="fly-colon-progress-fill" style="width: 5%;"></div>
            </div>
            <button class="fly-exit-btn" onclick="exitColonFlythrough()">⏹ 退出巡航 (回到 3D)</button>
          </div>
        </div>

        <!-- Scope Slider Control Bar (Embedded at Bottom of Center 3D Stage on Desktop & Mobile) -->
        <div class="canvas-scope-bar" id="canvas-scope-bar">
          <div class="control-row scope-card" style="margin-bottom: 0;">
            <div class="control-label-group">
              <span style="color: #38bdf8; font-weight: 800; display: flex; align-items: center; gap: 0.35rem;">
                <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><polygon points="10 8 16 12 10 16 10 8"/></svg>
                大腸鏡進鏡深度 (Scope Depth)
              </span>
              <span id="txt-scope-cm" class="scope-cm-badge">0 cm</span>
            </div>
            <input type="range" id="slider-scope" min="0" max="100" value="0" step="1" oninput="onScopeSlider(this.value)">
            <div class="scope-milestones">
              <span>肛門 (0cm)</span>
              <span>乙狀結腸 (35cm)</span>
              <span>脾曲 (55cm)</span>
              <span>盲腸 (100cm)</span>
            </div>
            <div class="scope-status-box" id="scope-status-box">
              <span class="scope-status-icon">📍</span>
              <span id="scope-status-text">內視鏡位於肛門口，準備進入直腸。</span>
            </div>
          </div>
        </div>
      </div>

      <!-- Right Panel: Clinical Information & Endoscopy Guide (Column 3 on Desktop) -->
      <div class="glass-panel right-panel mobile-tab-pane" id="pane-clinical-details">
        <div class="panel-header">
          <div class="panel-title">
            <svg width="16" height="16" fill="none" stroke="#10b981" stroke-width="2" viewBox="0 0 24 24"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/><polyline points="10 9 9 9 8 9"/></svg>
            大腸鏡判讀與臨床指引
          </div>
        </div>
        
        <div class="panel-body" id="detail-panel">
          
          <!-- Header Title Info -->
          <div class="detail-title-group">
            <div style="display: flex; align-items: center; gap: 0.45rem; margin-bottom: 0.3rem;">
              <span id="det-pill" class="seg-badge-pill">15 ~ 40 cm</span>
              <span id="det-sector" class="sector-tag">Left Lower Quadrant (Sigmoid)</span>
            </div>
            <div id="det-title-zh" class="main-title">乙狀結腸 (Sigmoid Colon)</div>
            <div id="det-title-en" class="sub-title">Colon sigmoideum · Pelvic Intestinal Loop</div>
          </div>

          <!-- Metric Grid -->
          <div class="metric-grid">
            <div class="metric-box">
              <div class="metric-label">常規進鏡距離</div>
              <div id="det-distance" class="metric-value">15 ～ 40 cm</div>
            </div>
            <div class="metric-box">
              <div class="metric-label">內視鏡操作難度</div>
              <div id="det-difficulty" class="metric-value">高 (易扭曲成環/Loop)</div>
            </div>
            <div class="metric-box">
              <div class="metric-label">息肉好發類型</div>
              <div id="det-polyp-type" class="metric-value">腺瘤 (Tubular)、增生性</div>
            </div>
            <div class="metric-box">
              <div class="metric-label">常見疾病好發</div>
              <div id="det-disease" class="metric-value">大腸憩室、息肉、憩室炎</div>
            </div>
          </div>

          <!-- Endoscopy Pearls -->
          <div class="surgical-pearls" id="det-pearls-box">
            <strong>大腸鏡檢查重點：</strong> 乙狀結腸由腸繫膜懸吊，活動度極大且彎曲度最高。檢查過程中最常產生拉扯感（Looping），熟練的內視鏡醫師會透過「抽吸氣（De-aeration）」與「右旋後拉（Right torque & hook）」技術解環，以無痛安全通過。
          </div>

          <!-- Ultrasound & Endoscopic Clinical Pearls -->
          <div class="detail-card">
            <h3>
              <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M12 2v20M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg>
              內視鏡判讀與衛教指引 (Clinical Pearls)
            </h3>
            <div id="det-pearls-list">
              <div class="pearl-item">
                <svg width="14" height="14" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/></svg>
                <span><strong>大腸癌與息肉好發區</strong>：統計上超過 50% 以上的大腸腺瘤與大腸癌好發於乙狀結腸與直腸（左側大腸）。</span>
              </div>
              <div class="pearl-item">
                <svg width="14" height="14" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/></svg>
                <span><strong>微創冷剪/電燒切除 (Polypectomy)</strong>：檢查當下若發現息肉，可立即透過內視鏡切除並送病理化驗，阻斷癌變途徑。</span>
              </div>
            </div>
          </div>

          <!-- Automatic Medical Phrase Generator -->
          <div class="phrase-box">
            <div class="phrase-header">
              <span class="phrase-title">大腸鏡檢查報告片語 (點擊即複製)</span>
              <button class="btn btn-outline" style="padding: 0.18rem 0.5rem; font-size: 0.68rem;" onclick="copyPhrase()">複製片語</button>
            </div>
            <div id="det-phrase-text" class="phrase-content">
              Colonoscopy: Total colonoscopy to cecum. A 0.6cm sessile polyp noted at Sigmoid colon (approx. 25cm from anal verge), successfully removed by cold snare polypectomy.
            </div>
          </div>

        </div>
      </div>

    </div>
  </div>

  <!-- Toast Notification -->
  <div id="toast">
    <svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path d="M20 6L9 17l-5-5"/></svg>
    <span id="toast-msg">已複製片語至剪貼簿！</span>
  </div>

  <script is:inline>
    // Colorectal Anatomical Knowledge Database
    const colonData = {
      rectum: {
        titleZh: '直腸與肛門 (Rectum & Anus)',
        titleEn: 'Rectum & Canalis analis',
