      scene.add(ambientLight);

      const mainLight = new THREE.DirectionalLight(0xfff5ea, 0.85);
      mainLight.position.set(6, 8, 8);
      scene.add(mainLight);

      const rimLight = new THREE.DirectionalLight(0x38bdf8, 0.45);
      rimLight.position.set(-8, -4, -6);
      scene.add(rimLight);

      const bottomLight = new THREE.DirectionalLight(0xa7f3d0, 0.25);
      bottomLight.position.set(0, -8, 6);
      scene.add(bottomLight);

      const frontLight = new THREE.DirectionalLight(0xfff7ed, 0.5);
      frontLight.position.set(0, 0, 8);
