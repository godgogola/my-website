          // 3 Taenia Coli indentations at 120 degree intervals
          const taeniaIndent = Math.pow(Math.cos(1.5 * theta), 4.0);
          const haustraPouch = haustraFactor * (1.0 - 0.65 * taeniaIndent);

          // Classic Triangular Lumen in Transverse Colon (u: 0.55 ~ 0.78)
          let shapeMod = 1.0;
          if (u > 0.55 && u < 0.78) {
            shapeMod = 1.0 + 0.08 * Math.cos(3 * theta);
          }

          const r = baseR * (1.0 + haustraPouch) * shapeMod;
          const cx = Math.cos(theta) * r;
          const cy = Math.sin(theta) * r;

          const vx = pt.x + normalVec.x * cx + binormalVec.x * cy;
          const vy = pt.y + normalVec.y * cx + binormalVec.y * cy;
          const vz = pt.z + normalVec.z * cx + binormalVec.z * cy;

          positions.push(vx, vy, vz);
          uvs.push(u, v);

          if (j === 0) leftLipPoints.push(new THREE.Vector3(vx, vy, vz));
          if (j === radialSegs) rightLipPoints.push(new THREE.Vector3(vx, vy, vz));
        }
      }

      for (let i = 0; i < numRings; i++) {
        for (let j = 0; j < radialSegs; j++) {
          const a = i * (radialSegs + 1) + j;
          const b = (i + 1) * (radialSegs + 1) + j;
          const c = (i + 1) * (radialSegs + 1) + (j + 1);
          const d = i * (radialSegs + 1) + (j + 1);

          indices.push(a, b, d);
          indices.push(b, c, d);
        }
      }

      const geom = new THREE.BufferGeometry();
      geom.setAttribute('position', new THREE.Float32BufferAttribute(positions, 3));
      geom.setAttribute('uv', new THREE.Float32BufferAttribute(uvs, 2));
      geom.setIndex(indices);
      geom.computeVertexNormals();

      singleColonMesh = new THREE.Mesh(geom, colonMaterial);
      colonMasterGroup.add(singleColonMesh);

      // Posterior Serosa Shell
      const serosaPositions = [];
      for (let k = 0; k < positions.length; k += 3) {
        serosaPositions.push(positions[k], positions[k + 1], positions[k + 2] - 0.04);
      }
      const serosaGeom = new THREE.BufferGeometry();
      serosaGeom.setAttribute('position', new THREE.Float32BufferAttribute(serosaPositions, 3));
      serosaGeom.setAttribute('uv', new THREE.Float32BufferAttribute(uvs, 2));
      serosaGeom.setIndex(indices);
      serosaGeom.computeVertexNormals();
      const serosaMesh = new THREE.Mesh(serosaGeom, serosaMat);
      colonMasterGroup.add(serosaMesh);

      // --- B. Multi-Layered Wall Cut Border Rims ---
      const leftCurve = new THREE.CatmullRomCurve3(leftLipPoints);
      const leftRimGeom = new THREE.TubeGeometry(leftCurve, 140, 0.052, 10, false);
      const leftRimMesh = new THREE.Mesh(leftRimGeom, wallCutMat);
      leftRimMesh.scale.set(1.0, 1.0, 0.42);
      colonMasterGroup.add(leftRimMesh);

      const rightCurve = new THREE.CatmullRomCurve3(rightLipPoints);
      const rightRimGeom = new THREE.TubeGeometry(rightCurve, 140, 0.052, 10, false);
      const rightRimMesh = new THREE.Mesh(rightRimGeom, wallCutMat);
      rightRimMesh.scale.set(1.0, 1.0, 0.42);
      colonMasterGroup.add(rightRimMesh);

      // Submucosal Glistening Stripe on Cut Border
      const leftSubGeom = new THREE.TubeGeometry(leftCurve, 140, 0.026, 8, false);
      const leftSubMesh = new THREE.Mesh(leftSubGeom, submucosaStripeMat);
      leftSubMesh.position.set(0, 0, -0.012);
      colonMasterGroup.add(leftSubMesh);

      const rightSubGeom = new THREE.TubeGeometry(rightCurve, 140, 0.026, 8, false);
      const rightSubMesh = new THREE.Mesh(rightSubGeom, submucosaStripeMat);
      rightSubMesh.position.set(0, 0, -0.012);
      colonMasterGroup.add(rightSubMesh);

      // --- C. Crescent Semilunar Folds (結腸半月襞, Plicae Semilunares) ---
      // Sharp crescentic inward shelves between haustra chambers
      const foldGroup = new THREE.Group();
      const numFolds = 26;
      for (let k = 1; k <= numFolds; k++) {
        const uFold = 0.16 + (k / (numFolds + 1)) * 0.74; // Absent in rectum
        const ptF = colonSplineCurve.getPoint(uFold);
        const tanF = colonSplineCurve.getTangent(uFold).normalize();
        let nF = new THREE.Vector3(0, 0, 1).cross(tanF).normalize();
        if (nF.lengthSq() < 0.01) nF = new THREE.Vector3(1, 0, 0).cross(tanF).normalize();
        const bnF = new THREE.Vector3().crossVectors(tanF, nF).normalize();

        let baseRF = 0.35;
        if (uFold < 0.35) baseRF = 0.31;
        else if (uFold < 0.74) baseRF = 0.36;
        else baseRF = 0.39 + (uFold - 0.74) * 0.14;

        // Inward crescent protrusion
        const foldR = baseRF * 0.88;
        const arcPts = [];
        const arcSteps = 16;
        for (let s = 0; s <= arcSteps; s++) {
          const vF = 0.08 + (s / arcSteps) * 0.84;
          const thetaF = startTheta + vF * (endTheta - startTheta);
          const fx = ptF.x + nF.x * Math.cos(thetaF) * foldR + bnF.x * Math.sin(thetaF) * foldR;
          const fy = ptF.y + nF.y * Math.cos(thetaF) * foldR + bnF.y * Math.sin(thetaF) * foldR;
          const fz = ptF.z + nF.z * Math.cos(thetaF) * foldR + bnF.z * Math.sin(thetaF) * foldR;
          arcPts.push(new THREE.Vector3(fx, fy, fz));
        }
        const foldCurve = new THREE.CatmullRomCurve3(arcPts);
        const foldGeom = new THREE.TubeGeometry(foldCurve, 20, 0.026, 8, false);
        const foldMesh = new THREE.Mesh(foldGeom, foldMat);
        foldGroup.add(foldMesh);
      }
      colonMasterGroup.add(foldGroup);

      // --- D. Taenia Coli Muscular Band Ribbon (結腸帶) ---
      // Longitudinal ribbon running continuously on posterior wall
      const taeniaPoints = [];
      for (let s = 25; s <= numRings; s += 2) {
        const uT = (s / numRings) * 0.92;
        const ptT = colonSplineCurve.getPoint(uT);
        const tanT = colonSplineCurve.getTangent(uT).normalize();
        let nT = new THREE.Vector3(0, 0, 1).cross(tanT).normalize();
        if (nT.lengthSq() < 0.01) nT = new THREE.Vector3(1, 0, 0).cross(tanT).normalize();
        const bnT = new THREE.Vector3().crossVectors(tanT, nT).normalize();
        const thetaT = Math.PI * 1.5; // Central posterior line
        const rT = 0.35;
        taeniaPoints.push(new THREE.Vector3(
          ptT.x + nT.x * Math.cos(thetaT) * rT + bnT.x * Math.sin(thetaT) * rT,
          ptT.y + nT.y * Math.cos(thetaT) * rT + bnT.y * Math.sin(thetaT) * rT,
          ptT.z + nT.z * Math.cos(thetaT) * rT + bnT.z * Math.sin(thetaT) * rT - 0.01
        ));
      }
      if (taeniaPoints.length >= 4) {
        const taeniaCurve = new THREE.CatmullRomCurve3(taeniaPoints);
        const taeniaGeom = new THREE.TubeGeometry(taeniaCurve, 60, 0.038, 8, false);
        const taeniaMesh = new THREE.Mesh(taeniaGeom, taeniaMat);
        colonMasterGroup.add(taeniaMesh);
      }

      // --- E. Anus & Rectum Details (Houston Valves & Anal Sphincter) ---
      const analRingGeom = new THREE.TorusGeometry(0.38, 0.075, 12, 24);
      const analRingMesh = new THREE.Mesh(analRingGeom, sphincterMat);
      analRingMesh.position.set(0.1, -2.6, 0.0);
      analRingMesh.rotation.x = Math.PI / 2;
      colonMasterGroup.add(analRingMesh);

      // Rectal Houston transverse valves (Transverse mucosal shelves in ampulla)
      const h1Geom = new THREE.TorusGeometry(0.32, 0.038, 8, 16, Math.PI * 0.65);
      const h1Mesh = new THREE.Mesh(h1Geom, foldMat);
      h1Mesh.position.set(0.12, -2.25, 0.05);
      h1Mesh.rotation.x = Math.PI / 2;
      h1Mesh.rotation.z = Math.PI * 0.2;
      colonMasterGroup.add(h1Mesh);

      const h2Mesh = new THREE.Mesh(h1Geom, foldMat);
      h2Mesh.position.set(0.14, -1.85, 0.08);
      h2Mesh.rotation.x = Math.PI / 2;
      h2Mesh.rotation.z = -Math.PI * 0.4;
      colonMasterGroup.add(h2Mesh);

      // --- F. Cecum, Ileocecal Valve (ICV), and Vermiform Appendix ---
      const cecumSubGroup = new THREE.Group();
      // Anchor cecumSubGroup seamlessly at the bottom terminus of the ascending colon (-1.82, -1.70, 0.08)
      cecumSubGroup.position.set(-1.82, -1.70, 0.08);

      // Cecal Fundic Bowl (Rounded blind pouch capping the ascending colon)
      const cecumBowlGeom = new THREE.SphereGeometry(0.48, 24, 18, 0, Math.PI * 1.15, 0, Math.PI * 0.58);
      const cecumBowlMesh = new THREE.Mesh(cecumBowlGeom, colonMaterial);
      cecumBowlMesh.position.set(0, 0, 0);
      cecumBowlMesh.rotation.x = -Math.PI / 2;
      cecumBowlMesh.rotation.z = Math.PI / 3;
      cecumSubGroup.add(cecumBowlMesh);

      // Outer Serosa Shell for Cecum
      const cecumSerosaGeom = new THREE.SphereGeometry(0.495, 24, 18, 0, Math.PI * 1.15, 0, Math.PI * 0.58);
      const cecumSerosaMesh = new THREE.Mesh(cecumSerosaGeom, serosaMat);
      cecumSerosaMesh.position.set(0, 0, -0.015);
      cecumSerosaMesh.rotation.copy(cecumBowlMesh.rotation);
      cecumSubGroup.add(cecumSerosaMesh);

      // Vermiform Appendix (闌尾 - Narrow tapering worm-like tube dangling from cecal inferior pole)
      const appendixPoints = [
        new THREE.Vector3(-0.04, -0.10, 0.05),
        new THREE.Vector3(0.08, -0.36, 0.10),
        new THREE.Vector3(0.20, -0.58, 0.14),
        new THREE.Vector3(0.30, -0.75, 0.16)
      ];
      const appendixCurve = new THREE.CatmullRomCurve3(appendixPoints);
      const appendixGeom = new THREE.TubeGeometry(appendixCurve, 24, 0.072, 12, false);
      const appendixMesh = new THREE.Mesh(appendixGeom, serosaMat);
      cecumSubGroup.add(appendixMesh);

      const appTipGeom = new THREE.SphereGeometry(0.072, 12, 12);
      const appTipMesh = new THREE.Mesh(appTipGeom, serosaMat);
      appTipMesh.position.set(0.30, -0.75, 0.16);
      cecumSubGroup.add(appTipMesh);

      // Appendiceal Orifice (闌尾開口 - Radiating 3-spoke fold sign at cecal base)
      const appOrificeGroup = new THREE.Group();
      const craterGeom = new THREE.TorusGeometry(0.082, 0.022, 8, 16);
      const craterMesh = new THREE.Mesh(craterGeom, sphincterMat);
      appOrificeGroup.add(craterMesh);

      for (let s = 0; s < 3; s++) {
        const slitGeom = new THREE.BoxGeometry(0.016, 0.072, 0.012);
        const slitMesh = new THREE.Mesh(slitGeom, wallCutMat);
        slitMesh.rotation.z = s * (Math.PI * 2 / 3);
        appOrificeGroup.add(slitMesh);
      }
      appOrificeGroup.position.set(-0.02, -0.04, 0.08);
      appOrificeGroup.rotation.x = -Math.PI / 4;
      cecumSubGroup.add(appOrificeGroup);

      // Ileocecal Valve (迴盲瓣 - Prominent upper & lower lips with central slit at medial border)
      const icValveGroup = new THREE.Group();
      const lipUpperGeom = new THREE.CylinderGeometry(0.045, 0.045, 0.18, 10);
      lipUpperGeom.rotateZ(Math.PI / 2);
      const lipUpperMesh = new THREE.Mesh(lipUpperGeom, foldMat);
      lipUpperMesh.position.set(0, 0.042, 0);
      icValveGroup.add(lipUpperMesh);

      const lipLowerMesh = new THREE.Mesh(lipUpperGeom, foldMat);
      lipLowerMesh.position.set(0, -0.042, 0);
      icValveGroup.add(lipLowerMesh);

      icValveGroup.position.set(0.18, 0.24, 0.08);
      icValveGroup.rotation.z = -Math.PI / 6;
      cecumSubGroup.add(icValveGroup);

      colonMasterGroup.add(cecumSubGroup);

      // Add Master Group to Scene
      scene.add(colonMasterGroup);

      // --- F. Add Auto-Fitting 3D Billboard Labels ---
      Object.keys(segmentConfigs).forEach(key => {
        const conf = segmentConfigs[key];
        const sprite = createTextSprite(conf.label, '#10b981');
        sprite.position.set(conf.labelPos[0], conf.labelPos[1], conf.labelPos[2]);
        colonMasterGroup.add(sprite);
        segmentLabelSprites[key] = sprite;
      });
    }

    // Dynamic Auto-Fitting Billboard Text Sprite Generator (100% inside borders!)
    function createTextSprite(text, accentColor = '#10b981') {
      const canvas = document.createElement('canvas');
      canvas.width = 512;
      canvas.height = 140;
      const ctx = canvas.getContext('2d');

      ctx.font = 'bold 36px -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Noto Sans TC", sans-serif';
      const textWidth = ctx.measureText(text).width;

      const pillWidth = Math.min(480, Math.max(160, textWidth + 64));
      const pillHeight = 72;
      const x = (canvas.width - pillWidth) / 2;
      const y = (canvas.height - pillHeight) / 2;

      // Draw pill background
      ctx.fillStyle = 'rgba(10, 20, 36, 0.92)';
      ctx.beginPath();
      ctx.roundRect(x, y, pillWidth, pillHeight, 36);
      ctx.fill();

      // Draw crisp glowing border
      ctx.strokeStyle = accentColor;
      ctx.lineWidth = 4;
      ctx.stroke();

      // Draw centered text
      ctx.fillStyle = '#ffffff';
      ctx.textAlign = 'center';
      ctx.textBaseline = 'middle';
      ctx.fillText(text, canvas.width / 2, canvas.height / 2);

      const texture = new THREE.CanvasTexture(canvas);
      texture.minFilter = THREE.LinearFilter;
      const spriteMat = new THREE.SpriteMaterial({ map: texture, transparent: true, depthTest: false });
      const sprite = new THREE.Sprite(spriteMat);
      sprite.scale.set(1.3 * (pillWidth / 250), 0.65, 1);
      return sprite;
    }

    // Build Glowing Focus Halo Beacon
    function buildFocusBeacon() {
      focusBeaconGroup = new THREE.Group();

      const ringGeom = new THREE.RingGeometry(0.32, 0.42, 32);
      const ringMat = new THREE.MeshBasicMaterial({
        color: 0x10b981,
        side: THREE.DoubleSide,
        transparent: true,
        opacity: 0.85
      });
      focusBeaconMesh = new THREE.Mesh(ringGeom, ringMat);
      focusBeaconGroup.add(focusBeaconMesh);

      const pointLight = new THREE.PointLight(0x10b981, 2.0, 2.5);
      focusBeaconGroup.add(pointLight);

      scene.add(focusBeaconGroup);
    }

    // Build 3D Endoscope (Black flexible tube with bright LED illumination tip)
    function build3DColonoscope() {
      scopeGroup = new THREE.Group();

      const tipGeom = new THREE.SphereGeometry(0.12, 16, 16);
      const tipMat = new THREE.MeshBasicMaterial({ color: 0x00e5ff });
      scopeTipMesh = new THREE.Mesh(tipGeom, tipMat);
      scopeGroup.add(scopeTipMesh);

      const coneGeom = new THREE.ConeGeometry(0.4, 0.8, 16, 1, true);
      coneGeom.translate(0, 0.4, 0);
      coneGeom.rotateX(Math.PI / 2);
      const coneMat = new THREE.MeshBasicMaterial({
        color: 0x38bdf8,
        transparent: true,
        opacity: 0.4,
        side: THREE.DoubleSide
      });
      const lightBeamMesh = new THREE.Mesh(coneGeom, coneMat);
      scopeTipMesh.add(lightBeamMesh);

      scopeHeadLight = new THREE.PointLight(0x00e5ff, 2.5, 3.5);
      scopeGroup.add(scopeHeadLight);

      scene.add(scopeGroup);
    }

    function updateColonoscopePosition(progressT) {
      if (!colonSplineCurve || !scopeGroup) return;

      const tClamped = Math.max(0.001, Math.min(0.999, progressT));
      // Calibrate so 100cm intubates into the cecum (0.91)
      const tCurve = tClamped * 0.91;
      const pt = colonSplineCurve.getPoint(tCurve);
      const tangent = colonSplineCurve.getTangent(tCurve).normalize();

      scopeGroup.position.copy(pt);
      scopeTipMesh.quaternion.setFromUnitVectors(new THREE.Vector3(0, 0, 1), tangent);

      if (scopeTubeMesh) scene.remove(scopeTubeMesh);

      const numPoints = Math.max(8, Math.floor(tCurve * 55));
      const subPoints = [];
      for (let i = 0; i <= numPoints; i++) {
        subPoints.push(colonSplineCurve.getPoint((i / numPoints) * tCurve));
      }

      if (subPoints.length >= 2) {
        const subCurve = new THREE.CatmullRomCurve3(subPoints);
        const tubeGeom = new THREE.TubeGeometry(subCurve, numPoints * 2, 0.08, 10, false);
        const tubeMat = new THREE.MeshStandardMaterial({
          color: 0x111827,
          roughness: 0.2,
          metalness: 0.8
        });
        scopeTubeMesh = new THREE.Mesh(tubeGeom, tubeMat);
        scene.add(scopeTubeMesh);
      }
    }

    // Build 3D Pathologies (Polyps, Diverticula, Hemorrhoids)
    function build3DPathologies() {
      pathologyGroup = new THREE.Group();

      // 1. Polyps (3 Distinct Locations & Morphologies sitting on inner mucosal wall)
      const polypMat = new THREE.MeshPhysicalMaterial({
        color: 0xf43f5e,
        roughness: 0.2,
        clearcoat: 0.8,
        emissive: 0xe11d48,
        emissiveIntensity: 0.6
      });

      // Sigmoid Pedunculated Polyp (有蒂腺瘤 - projecting into the sigmoid lumen)
      const p1StalkGeom = new THREE.CylinderGeometry(0.035, 0.045, 0.22, 8);
      const p1HeadGeom = new THREE.SphereGeometry(0.13, 16, 16);
      p1HeadGeom.translate(0, 0.15, 0);
      const p1Mesh = new THREE.Mesh(p1HeadGeom, polypMat);
      p1Mesh.add(new THREE.Mesh(p1StalkGeom, polypMat));
      p1Mesh.position.set(1.48, -1.82, 0.42);
      p1Mesh.rotation.z = -Math.PI / 4;
      p1Mesh.rotation.x = Math.PI / 6;
      p1Mesh.userData = { type: 'polyp', name: '乙狀結腸有蒂腺瘤 (Pedunculated Polyp, 0.8cm)' };
      pathologyGroup.add(p1Mesh);

      // Ascending Flat Serrated Polyp (SSA/P - 扁平鋸齒狀腺瘤 flat elevation on ascending mucosa)
      const p2Geom = new THREE.CylinderGeometry(0.18, 0.22, 0.06, 16);
      const p2Mesh = new THREE.Mesh(p2Geom, polypMat);
      p2Mesh.position.set(-1.82, 0.15, -0.08);
      p2Mesh.rotation.z = Math.PI / 3;
      p2Mesh.userData = { type: 'polyp', name: '升結腸無蒂鋸齒狀腺瘤 (Flat SSA, 1.2cm)' };
      pathologyGroup.add(p2Mesh);

      // Transverse Small Polyp (橫結腸管狀腺瘤 on transverse mucosal floor)
      const p3Geom = new THREE.SphereGeometry(0.1, 12, 12);
      const p3Mesh = new THREE.Mesh(p3Geom, polypMat);
      p3Mesh.position.set(0.15, 0.68, 0.52);
      p3Mesh.userData = { type: 'polyp', name: '橫結腸管狀腺瘤 (Tubular Adenoma, 0.5cm)' };
      pathologyGroup.add(p3Mesh);

      // 2. Diverticula (Outpouching pocket crypts in Sigmoid & Descending)
      const divertMat = new THREE.MeshStandardMaterial({
        color: 0x7c3aed,
        roughness: 0.4,
        emissive: 0x6d28d9,
        emissiveIntensity: 0.5
      });

      const divPositions = [
        new THREE.Vector3(1.62, -1.85, 0.45),
        new THREE.Vector3(1.72, -2.15, 0.35),
        new THREE.Vector3(1.85, -1.2, 0.22),
        new THREE.Vector3(1.92, -0.75, 0.05),
        new THREE.Vector3(1.95, 0.2, -0.15)
      ];

      divPositions.forEach((pos, idx) => {
        const dGroup = new THREE.Group();
        const dRing = new THREE.Mesh(new THREE.TorusGeometry(0.065, 0.02, 8, 12), divertMat);
        const dSphere = new THREE.Mesh(new THREE.SphereGeometry(0.085, 10, 10), divertMat);
        dSphere.position.set(0, 0, -0.05);
        dGroup.add(dRing);
        dGroup.add(dSphere);
        dGroup.position.copy(pos);
        dGroup.userData = { type: 'diverticulum', name: `乙狀結腸憩室 (${idx + 1})` };
        pathologyGroup.add(dGroup);
      });

      // 3. Hemorrhoids (Clusters at Anorectal Junction / Dentate Line)
      const hemMat = new THREE.MeshPhysicalMaterial({
        color: 0x9333ea,
        roughness: 0.25,
        clearcoat: 0.7,
        emissive: 0x7e22ce,
        emissiveIntensity: 0.65
      });

      const hemPositions = [
        new THREE.Vector3(0.09, -2.48, 0.06),
        new THREE.Vector3(-0.09, -2.46, 0.04),
        new THREE.Vector3(0.02, -2.52, -0.05)
      ];

      hemPositions.forEach(pos => {
        const hMesh = new THREE.Mesh(new THREE.SphereGeometry(0.105, 14, 14), hemMat);
        hMesh.position.copy(pos);
        hMesh.userData = { type: 'hemorrhoid', name: '肛門齒狀線內痔血管叢 (Hemorrhoid)' };
        pathologyGroup.add(hMesh);
      });

      // Initially hide all pathologies
      pathologyGroup.children.forEach(child => child.visible = false);
      scene.add(pathologyGroup);
    }

    // Toggle Pathology Layers (Polyp / Diverticulum / Hemorrhoid)
    function togglePathology(type) {
      activePathology[type] = !activePathology[type];
      const btn = document.getElementById(`btn-path-${type}`);
      if (btn) btn.classList.toggle('active', activePathology[type]);

      pathologyGroup.children.forEach(child => {
        if (child.userData && child.userData.type === type) {
          child.visible = activePathology[type];
        }
      });

      const infoEl = document.getElementById('pathology-info-text');
      if (type === 'polyp') {
        if (activePathology.polyp) {
          infoEl.innerHTML = '🔴 <strong>已顯示大腸息肉</strong>：分布於乙狀結腸（有蒂）、升結腸（扁平 SSA）與橫結腸，可藉由內視鏡息肉切除術（EMR / Polypectomy）切除。';
          selectSegment('sigmoid');
        } else {
          infoEl.textContent = '已隱藏息肉病灶。';
        }
      } else if (type === 'diverticulum') {
        if (activePathology.diverticulum) {
          infoEl.innerHTML = '🟣 <strong>已顯示大腸憩室</strong>：主要分布於乙狀結腸與降結腸，為黏膜向外突出之囊袋，需注意高纖飲食預防憩室炎。';
          selectSegment('sigmoid');
        } else {
          infoEl.textContent = '已隱藏憩室病灶。';
        }
      } else if (type === 'hemorrhoid') {
        if (activePathology.hemorrhoid) {
          infoEl.innerHTML = '🟣 <strong>已顯示痔瘡病灶</strong>：位於肛門直腸交界齒狀線周圍，分為內痔與外痔。';
          selectSegment('rectum');
        } else {
          infoEl.textContent = '已隱藏痔瘡病灶。';
        }
      }
    }

    // Scope Slider (0 - 100 cm)
    function onScopeSlider(val) {
      const cm = parseInt(val, 10);
      const progressT = cm / 100.0;
      
      const badge = document.getElementById('txt-scope-cm');
      if (badge) badge.textContent = `${cm} cm`;

      updateColonoscopePosition(progressT);

      const statusBox = document.getElementById('scope-status-text');
      if (cm <= 15) {
        if (statusBox) statusBox.textContent = `📍 直腸段 (${cm}cm)：剛通過肛門口，觀察直腸壺腹與齒狀線。`;
        updateSegmentDetailsOnly('rectum');
      } else if (cm <= 40) {
        if (statusBox) statusBox.textContent = `📍 乙狀結腸 (${cm}cm)：進入骨盆腔彎曲段，常規解環右旋後拉技巧處。`;
        updateSegmentDetailsOnly('sigmoid');
      } else if (cm <= 55) {
        if (statusBox) statusBox.textContent = `📍 降結腸/脾曲 (${cm}cm)：抵達左側大腸最高點脾曲，穿透左上腹。`;
        updateSegmentDetailsOnly('descending');
      } else if (cm <= 80) {
        if (statusBox) statusBox.textContent = `📍 橫結腸 (${cm}cm)：典型的三角形管腔與清晰結腸袋波紋。`;
        updateSegmentDetailsOnly('transverse');
      } else if (cm <= 95) {
        if (statusBox) statusBox.textContent = `📍 升結腸/肝曲 (${cm}cm)：跨越右肝曲，仔細沖洗排查扁平鋸齒狀腺瘤。`;
        updateSegmentDetailsOnly('ascending');
      } else {
        if (statusBox) statusBox.textContent = `🎯 盲腸達標 (100cm)：成功目視闌尾開口（奔馳標誌）與迴盲瓣！`;
        updateSegmentDetailsOnly('cecum');
      }
    }

    // Opacity Slider Action
    function onOpacitySlider(val) {
      currentOpacity = val / 100.0;
      const txt = document.getElementById('txt-opacity-val');
      if (txt) txt.textContent = `${val}%`;
      if (colonMaterial) colonMaterial.opacity = currentOpacity;
    }

    // Segment Selection
    function selectSegment(id) {
      if (isQuizMode) {
        handleQuizClick(id);
        return;
      }

      selectedId = id;
      const conf = segmentConfigs[id];
      const data = colonData[id];
      if (!data || !conf) return;

      document.querySelectorAll('.seg-card-btn').forEach(btn => btn.classList.remove('active'));
      document.getElementById(`btn-seg-${id}`)?.classList.add('active');

      // Move glowing focus beacon to target position
      if (focusBeaconGroup && conf.targetPos) {
        new TWEEN.Tween(focusBeaconGroup.position)
          .to(conf.targetPos, 450)
          .easing(TWEEN.Easing.Cubic.Out)
          .start();
      }

      // Update scope slider to match segment position
      if (conf.scopeProgress !== undefined) {
        const cm = Math.round(conf.scopeProgress * 100);
        const slider = document.getElementById('slider-scope');
        if (slider) slider.value = cm;
        const badge = document.getElementById('txt-scope-cm');
        if (badge) badge.textContent = `${cm} cm`;
        updateColonoscopePosition(conf.scopeProgress);
      }

      updateSegmentDetailsOnly(id);
    }

    function updateSegmentDetailsOnly(id) {
      const data = colonData[id];
      if (!data) return;

      const pill = document.getElementById('det-pill');
      if (pill) pill.textContent = data.distance;
      document.getElementById('det-sector').textContent = data.sector;
      document.getElementById('det-title-zh').textContent = data.titleZh;
      document.getElementById('det-title-en').textContent = data.titleEn;
      document.getElementById('det-distance').textContent = data.distance;
      document.getElementById('det-difficulty').textContent = data.difficulty;
      document.getElementById('det-polyp-type').textContent = data.polypType;
      document.getElementById('det-disease').textContent = data.disease;
      document.getElementById('det-pearls-box').innerHTML = data.pearlsBox;
      document.getElementById('det-phrase-text').textContent = data.phrase;

      const pearlsList = document.getElementById('det-pearls-list');
      if (pearlsList) {
        pearlsList.innerHTML = '';
        data.pearls.forEach(text => {
          const item = document.createElement('div');
          item.className = 'pearl-item';
          item.innerHTML = `
            <svg width="14" height="14" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/></svg>
            <span>${text}</span>
          `;
          pearlsList.appendChild(item);
        });
      }
    }

    // Preset Views
    function setPresetView(preset) {
      document.querySelectorAll('.view-btn').forEach(b => b.classList.remove('active'));
      document.getElementById(`view-btn-${preset}`)?.classList.add('active');

      const isMobile = window.innerWidth <= 1150;
      let targetPos = new THREE.Vector3(0, -0.45, isMobile ? 10.8 : 9.4);
      let targetLook = new THREE.Vector3(0, -0.45, 0);

      switch(preset) {
        case 'anterior': 
          targetPos.set(0, -0.45, isMobile ? 10.8 : 9.4); 
          targetLook.set(0, -0.45, 0); 
          break;
        case 'left_colon': 
          targetPos.set(3.8, isMobile ? -0.2 : -0.5, isMobile ? 6.5 : 5.2); 
          targetLook.set(1.2, isMobile ? -0.3 : -0.65, 0.2); 
          break;
        case 'right_colon': 
          targetPos.set(-3.8, isMobile ? -0.2 : -0.5, isMobile ? 6.5 : 5.2); 
          targetLook.set(-1.2, isMobile ? -0.3 : -0.65, 0.2); 
          break;
        case 'splenic': 
          targetPos.set(2.5, isMobile ? 2.5 : 2.2, isMobile ? 6.0 : 4.8); 
          targetLook.set(1.2, isMobile ? 1.2 : 1.0, 0.0); 
          break;
        case 'pelvis': 
          targetPos.set(0, isMobile ? -4.5 : -5.0, isMobile ? 5.5 : 4.2); 
          targetLook.set(0, isMobile ? -1.8 : -2.0, 0.2); 
          break;
      }

      new TWEEN.Tween(camera.position).to(targetPos, 850).easing(TWEEN.Easing.Cubic.Out).start();
      new TWEEN.Tween(controls.target).to(targetLook, 850).easing(TWEEN.Easing.Cubic.Out).start();
    }

    function reset3DCamera() {
      setPresetView('anterior');
      selectSegment('sigmoid');
      showToast('已重設為大腸 3D 正面全覽視角');
    }

    function onWindowResize() {
      const container = document.getElementById('threejs-canvas-container');
      if (!container || !renderer || !camera) return;
      const width = container.clientWidth;
      const height = container.clientHeight;
      if (width > 0 && height > 0) {
        camera.aspect = width / height;
        camera.updateProjectionMatrix();
        renderer.setSize(width, height);
      }
    }

    // Mobile Segmented Drawer / Tab Switching
    function switchMobileTab(tab) {
      document.querySelectorAll('.mobile-tab-btn').forEach(b => b.classList.remove('active'));
      document.getElementById(`tab-btn-${tab}`)?.classList.add('active');

      const regionsPane = document.getElementById('pane-regions-pathology');
      const detailsPane = document.getElementById('pane-clinical-details');
      const pathBox = document.querySelector('.pathology-section-box');
      const opacityBox = document.querySelector('.opacity-section-box');
      const segBox = document.querySelector('.segment-grid-list');
      const segLabels = document.querySelectorAll('.left-panel .section-label');

      if (window.innerWidth <= 1150) {
        if (tab === 'regions') {
          if (regionsPane) regionsPane.style.display = 'flex';
          if (detailsPane) detailsPane.style.display = 'none';
          if (pathBox) pathBox.style.display = 'none';
          if (opacityBox) opacityBox.style.display = 'block';
          if (segBox) segBox.style.display = 'grid';
          if (segLabels[0]) segLabels[0].style.display = 'none';
          if (segLabels[1]) segLabels[1].style.display = 'block';
        } else if (tab === 'pathology') {
          if (regionsPane) regionsPane.style.display = 'flex';
          if (detailsPane) detailsPane.style.display = 'none';
          if (pathBox) pathBox.style.display = 'block';
          if (opacityBox) opacityBox.style.display = 'block';
          if (segBox) segBox.style.display = 'none';
          if (segLabels[0]) segLabels[0].style.display = 'block';
          if (segLabels[1]) segLabels[1].style.display = 'none';
        } else if (tab === 'details') {
          if (regionsPane) regionsPane.style.display = 'none';
          if (detailsPane) detailsPane.style.display = 'flex';
        }
      }
    }

    // Fullscreen Toggle
    function toggleFullScreen() {
      const wrapper = document.getElementById('colonAppWrapper');
      if (!document.fullscreenElement) {
        if (wrapper && wrapper.requestFullscreen) {
          wrapper.requestFullscreen();
        } else if (document.documentElement.requestFullscreen) {
          document.documentElement.requestFullscreen();
        }
      } else {
        if (document.exitFullscreen) {
          document.exitFullscreen();
        }
      }
    }

    document.addEventListener('fullscreenchange', () => {
      const isFs = !!document.fullscreenElement;
      const label = document.getElementById('txt-fs-label');
      const btn = document.getElementById('btn-fullscreen-toggle');
      if (label) label.textContent = isFs ? '退出全螢幕' : '全螢幕模式';
      if (btn) btn.classList.toggle('active', isFs);
      setTimeout(onWindowResize, 150);
    });

    function onPointerDown(e) {
      const rect = renderer.domElement.getBoundingClientRect();
      mouse.x = ((e.clientX - rect.left) / rect.width) * 2 - 1;
      mouse.y = -((e.clientY - rect.top) / rect.height) * 2 + 1;

      raycaster.setFromCamera(mouse, camera);
      if (colonMasterGroup) {
        const intersects = raycaster.intersectObjects(colonMasterGroup.children, true);
        if (intersects.length > 0) {
          const hitPt = intersects[0].point;
          let closestId = 'sigmoid', minDist = 999;
          Object.keys(segmentConfigs).forEach(k => {
            const d = hitPt.distanceTo(segmentConfigs[k].targetPos);
            if (d < minDist) {
              minDist = d;
              closestId = k;
            }
          });
          selectSegment(closestId);
        }
      }
    }

    function onWindowResize() {
      const container = document.getElementById('threejs-canvas-container');
      if (!container || !renderer || !camera) return;
      const width = container.clientWidth;
      const height = container.clientHeight;
      if (width > 0 && height > 0) {
        camera.aspect = width / height;
        camera.updateProjectionMatrix();
        renderer.setSize(width, height);
      }
    }

    function copyPhrase() {
      const text = document.getElementById('det-phrase-text')?.textContent.trim();
      if (text) {
        navigator.clipboard.writeText(text).then(() => {
          showToast('已複製大腸鏡病歷片語至剪貼簿！');
        });
      }
    }

    function showToast(msg) {
      const toast = document.getElementById('toast');
      const msgEl = document.getElementById('toast-msg');
      if (!toast || !msgEl) return;
      msgEl.textContent = msg;
      toast.classList.add('show');
      setTimeout(() => toast.classList.remove('show'), 2500);
    }

    const quizCandidates = ['rectum', 'sigmoid', 'descending', 'transverse', 'ascending', 'cecum'];
    function toggleQuizMode() {
      isQuizMode = !isQuizMode;
      const btn = document.getElementById('btn-toggle-quiz');
      if (isQuizMode) {
        btn.classList.add('btn-primary');
        btn.classList.remove('btn-outline');
        btn.textContent = '結束測驗';
        nextQuizQuestion();
      } else {
        btn.classList.remove('btn-primary');
        btn.classList.add('btn-outline');
        btn.innerHTML = `
          <svg width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M9 11l3 3L22 4"/><path d="M21 12v7a2 2 0 01-2 2H5a2 2 0 01-2-2V5a2 2 0 012-2h11"/></svg>
          3D 測驗模式
        `;
        selectSegment(selectedId);
      }
    }

    function nextQuizQuestion() {
      const idx = Math.floor(Math.random() * quizCandidates.length);
      quizTarget = quizCandidates[idx];
      const data = colonData[quizTarget];
      showToast(`🎯 請在 3D 空間中找出並點擊：【${data.titleZh}】`);
    }

    function handleQuizClick(clickedId) {
      if (clickedId === quizTarget) {
        showToast('🎉 答對了！非常優秀！');
        selectSegment(clickedId);
        setTimeout(nextQuizQuestion, 1400);
      } else {
        const clickedName = colonData[clickedId] ? colonData[clickedId].titleZh : clickedId;
        showToast(`❌ 答錯囉！您點到的是【${clickedName}】，旋轉一下角度再試一次！`);
      }
    }

