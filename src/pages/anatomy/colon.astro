    // Global 3D Variables
    let scene, camera, renderer, controls;
    let singleColonMesh, colonMaterial;
    let segmentLabelSprites = {};
    let scopeGroup, scopeHeadLight, scopeTipMesh, scopeTubeMesh;
    let pathologyGroup;
    let focusBeaconGroup, focusBeaconMesh;
    let activePathology = { polyp: false, diverticulum: false, hemorrhoid: false };
    let selectedId = 'sigmoid';
    let isQuizMode = false, quizTarget = null;
    let raycaster, mouse;
    let currentOpacity = 0.95;
    let colonSplineCurve;

    // Colon Centerline Keypoints (From Anus to Cecum in 3D Space)
    const colonPathPoints = [
      new THREE.Vector3(0.0, -2.6, 0.0),    // Anus / Lower Rectum (0 cm)
      new THREE.Vector3(0.0, -1.9, 0.1),    // Mid-upper Rectum (12 cm)
      new THREE.Vector3(0.6, -1.6, 0.4),    // Rectosigmoid Junction (18 cm)
      new THREE.Vector3(1.5, -2.2, 0.6),    // Sigmoid Loop Bottom (25 cm)
      new THREE.Vector3(1.8, -1.4, 0.3),    // Sigmoid Ascending (32 cm)
      new THREE.Vector3(1.8, -0.6, 0.0),    // Sigmoid-Descending Junction (40 cm)
      new THREE.Vector3(1.9, 0.4, -0.2),    // Mid Descending Colon (48 cm)
      new THREE.Vector3(1.7, 1.3, -0.1),    // Splenic Flexure Top (55 cm)
      new THREE.Vector3(1.0, 1.1, 0.3),     // Left Transverse (62 cm)
      new THREE.Vector3(0.0, 0.6, 0.7),     // Mid Transverse Colon Dip (70 cm)
