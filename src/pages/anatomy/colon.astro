    function init3D() {
      const container = document.getElementById('threejs-canvas-container');
      if (!container) return;

      const width = container.clientWidth || (window.innerWidth > 1150 ? window.innerWidth - 720 : window.innerWidth);
      const height = container.clientHeight || (window.innerHeight - 130);

      // 1. Scene & Camera
      scene = new THREE.Scene();
      camera = new THREE.PerspectiveCamera(40, width / height, 0.1, 100);
      camera.position.set(0, -0.3, 7.5);

      // 2. WebGL Renderer
      renderer = new THREE.WebGLRenderer({ antialias: true, alpha: true });
      renderer.setSize(width, height);
      renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
      renderer.shadowMap.enabled = true;
      renderer.shadowMap.type = THREE.PCFSoftShadowMap;
      container.appendChild(renderer.domElement);

      // 3. Orbit Controls
      controls = new THREE.OrbitControls(camera, renderer.domElement);
      controls.enableDamping = true;
      controls.dampingFactor = 0.06;
      controls.minDistance = 3.2;
      controls.maxDistance = 16;
      controls.target.set(0, -0.5, 0);

      // 4. Studio Medical Lighting
      const ambientLight = new THREE.AmbientLight(0xffffff, 0.68);
      scene.add(ambientLight);

      const mainLight = new THREE.DirectionalLight(0xfff5ea, 1.15);
      mainLight.position.set(6, 8, 8);
      scene.add(mainLight);

      const rimLight = new THREE.DirectionalLight(0x38bdf8, 0.8);
      rimLight.position.set(-8, -4, -6);
      scene.add(rimLight);

      const bottomLight = new THREE.DirectionalLight(0xa7f3d0, 0.6);
      bottomLight.position.set(0, -8, 6);
      scene.add(bottomLight);

      // 5. Build Spline Curve
      colonSplineCurve = new THREE.CatmullRomCurve3(colonPathPoints);

      // 6. Build 3D Segment Meshes with Haustra Modulations
      build3DColonSegments();

      // 7. Build Dynamic 3D Endoscope System
      build3DColonoscope();

      // 8. Build 3D Pathologies (Polyps, Diverticula, Hemorrhoids)
      build3DPathologies();

      // 9. Raycasting Setup
      raycaster = new THREE.Raycaster();
      mouse = new THREE.Vector2();
      renderer.domElement.addEventListener('pointerdown', onPointerDown);

      // 10. Auto-Resize Observer
      const resizeObserver = new ResizeObserver(() => onWindowResize());
      resizeObserver.observe(container);
      window.addEventListener('resize', onWindowResize);

      // Initialize default selection
      selectSegment('sigmoid');
      onScopeSlider(0);

      setTimeout(onWindowResize, 100);

      // Animation Loop
      animate();
    }

    // Build 3D Colon Segments with periodic Haustra (結腸袋) & Tenia Coli (結腸帶)
    function build3DColonSegments() {
      // Clear existing if rebuilding
      Object.keys(colonSegments).forEach(k => {
        scene.remove(colonSegments[k]);
      });
      colonSegments = {};

      const gutMatConfig = {
        color: 0xd97768,
        roughness: 0.35,
        metalness: 0.05,
        clearcoat: 0.65,
        clearcoatRoughness: 0.3,
        transparent: true,
        opacity: currentOpacity,
        side: THREE.DoubleSide
      };

      Object.keys(segmentConfigs).forEach(key => {
        const conf = segmentConfigs[key];
        const geom = createHaustratedSegmentGeometry(conf.tRange[0], conf.tRange[1], conf.radius, key, currentViewMode === 'cutaway');
        const mat = new THREE.MeshPhysicalMaterial(gutMatConfig);
        
        const mesh = new THREE.Mesh(geom, mat);
        mesh.userData = { segmentId: key };

        explodeVectors[key] = conf.explodeDir.clone();
        colonSegments[key] = mesh;
        scene.add(mesh);

        // 3D Billboard Text Label
        const sprite = createTextSprite(conf.label);
        sprite.position.set(conf.labelPos[0], conf.labelPos[1], conf.labelPos[2]);
        mesh.add(sprite);
        segmentLabelSprites[key] = sprite;
      });
    }

    function createHaustratedSegmentGeometry(tStart, tEnd, baseR, key, isCutaway) {
      const numRings = 40;
      const radialSegs = 24;
      const positions = [];
      const normals = [];
      const uvs = [];
      const indices = [];

      const thetaMax = isCutaway ? Math.PI * 1.25 : Math.PI * 2.0;

      for (let i = 0; i <= numRings; i++) {
        const u = i / numRings;
        const t = tStart + u * (tEnd - tStart);
        const pt = colonSplineCurve.getPoint(t);
        const tangent = colonSplineCurve.getTangent(t).normalize();

        // Normal and Binormal vectors for circular cross section
        let normalVec = new THREE.Vector3(0, 0, 1).cross(tangent).normalize();
        if (normalVec.lengthSq() < 0.01) normalVec = new THREE.Vector3(1, 0, 0).cross(tangent).normalize();
        const binormalVec = new THREE.Vector3().crossVectors(tangent, normalVec).normalize();

        // Haustra Sacculation Modulation Frequency along tube
        const numPockets = (tEnd - tStart) * 35;
        const haustraMod = 1.0 + 0.22 * Math.sin(u * Math.PI * 2 * numPockets);

        for (let j = 0; j <= radialSegs; j++) {
          const v = j / radialSegs;
          const theta = isCutaway ? (-Math.PI * 0.65 + v * thetaMax) : (v * Math.PI * 2);

          // 3 Teniae Coli longitudinal bands (triradiate indentations)
          const teniaMod = 1.0 + 0.08 * Math.cos(3 * theta);
          const r = baseR * haustraMod * teniaMod;

          const cx = Math.cos(theta) * r;
          const cy = Math.sin(theta) * r;

          const vx = pt.x + normalVec.x * cx + binormalVec.x * cy;
          const vy = pt.y + normalVec.y * cx + binormalVec.y * cy;
          const vz = pt.z + normalVec.z * cx + binormalVec.z * cy;

          positions.push(vx, vy, vz);
          uvs.push(u, v);
        }
      }

      for (let i = 0; i < numRings; i++) {
        for (let j = 0; j < radialSegs; j++) {
          const a = i * (radialSegs + 1) + j;
          const b = (i + 1) * (radialSegs + 1) + j;
          const c = (i + 1) * (radialSegs + 1) + (j + 1);
          const d = i * (radialSegs + 1) + (j + 1);

          indices.push(a, b, d);
          indices.push(b, c, d);
        }
      }

      const geom = new THREE.BufferGeometry();
      geom.setAttribute('position', new THREE.Float32BufferAttribute(positions, 3));
      geom.setAttribute('uv', new THREE.Float32BufferAttribute(uvs, 2));
      geom.setIndex(indices);
      geom.computeVertexNormals();

      return geom;
    }

    function createTextSprite(text) {
      const canvas = document.createElement('canvas');
      canvas.width = 256;
      canvas.height = 128;
      const ctx = canvas.getContext('2d');
      ctx.fillStyle = 'rgba(10, 18, 36, 0.85)';
      ctx.beginPath();
      ctx.roundRect(16, 16, 224, 96, 24);
      ctx.fill();
      ctx.strokeStyle = '#10b981';
      ctx.lineWidth = 5;
      ctx.stroke();

      ctx.font = 'bold 52px Plus Jakarta Sans, sans-serif';
      ctx.fillStyle = '#ffffff';
      ctx.textAlign = 'center';
      ctx.textBaseline = 'middle';
      ctx.fillText(text, 128, 64);

      const texture = new THREE.CanvasTexture(canvas);
      const spriteMat = new THREE.SpriteMaterial({ map: texture, transparent: true, depthTest: false });
      const sprite = new THREE.Sprite(spriteMat);
      sprite.scale.set(0.85, 0.42, 1);
      return sprite;
    }

    // Build 3D Endoscope (Black flexible tube with bright LED illumination tip)
    function build3DColonoscope() {
      scopeGroup = new THREE.Group();

      // Endoscope Glowing Optical Tip
      const tipGeom = new THREE.SphereGeometry(0.12, 16, 16);
      const tipMat = new THREE.MeshBasicMaterial({ color: 0x00e5ff });
      scopeTipMesh = new THREE.Mesh(tipGeom, tipMat);
      scopeGroup.add(scopeTipMesh);

      // Forward Light Cone Beam
      const coneGeom = new THREE.ConeGeometry(0.4, 0.8, 16, 1, true);
      coneGeom.translate(0, 0.4, 0);
      coneGeom.rotateX(Math.PI / 2);
      const coneMat = new THREE.MeshBasicMaterial({
        color: 0x38bdf8,
        transparent: true,
        opacity: 0.4,
        side: THREE.DoubleSide
      });
      const lightBeamMesh = new THREE.Mesh(coneGeom, coneMat);
      scopeTipMesh.add(lightBeamMesh);

      // PointLight on Scope Head
      scopeHeadLight = new THREE.PointLight(0x00e5ff, 2.5, 3.5);
      scopeGroup.add(scopeHeadLight);

      scene.add(scopeGroup);
    }

    // Update 3D Endoscope Position and In-Lumen Tube Curve along progress
    function updateColonoscopePosition(progressT) {
      if (!colonSplineCurve || !scopeGroup) return;

      const tClamped = Math.max(0.001, Math.min(0.999, progressT));
      const pt = colonSplineCurve.getPoint(tClamped);
      const tangent = colonSplineCurve.getTangent(tClamped).normalize();

      scopeGroup.position.copy(pt);
      scopeTipMesh.quaternion.setFromUnitVectors(new THREE.Vector3(0, 0, 1), tangent);

      // Rebuild the black scope insertion tube up to current t
      if (scopeTubeMesh) scene.remove(scopeTubeMesh);

      const numPoints = Math.max(8, Math.floor(tClamped * 50));
      const subPoints = [];
      for (let i = 0; i <= numPoints; i++) {
        subPoints.push(colonSplineCurve.getPoint((i / numPoints) * tClamped));
      }

      if (subPoints.length >= 2) {
        const subCurve = new THREE.CatmullRomCurve3(subPoints);
        const tubeGeom = new THREE.TubeGeometry(subCurve, numPoints * 2, 0.08, 10, false);
        const tubeMat = new THREE.MeshStandardMaterial({
          color: 0x111827,
          roughness: 0.2,
          metalness: 0.8
        });
        scopeTubeMesh = new THREE.Mesh(tubeGeom, tubeMat);
        scene.add(scopeTubeMesh);
      }
    }

    // Build 3D Pathologies (Polyps, Diverticula, Hemorrhoids)
    function build3DPathologies() {
      pathologyGroup = new THREE.Group();

      // 1. Polyps (3 Distinct Locations & Morphologies)
      const polypMat = new THREE.MeshPhysicalMaterial({
        color: 0xf43f5e,
        roughness: 0.2,
        clearcoat: 0.8,
        emissive: 0xe11d48,
        emissiveIntensity: 0.6
      });

      // Sigmoid Pedunculated Polyp
      const p1StalkGeom = new THREE.CylinderGeometry(0.04, 0.05, 0.25, 8);
      const p1HeadGeom = new THREE.SphereGeometry(0.14, 16, 16);
      p1HeadGeom.translate(0, 0.16, 0);
      const p1Mesh = new THREE.Mesh(p1HeadGeom, polypMat);
      p1Mesh.add(new THREE.Mesh(p1StalkGeom, polypMat));
      p1Mesh.position.set(1.5, -2.1, 0.7);
      p1Mesh.userData = { type: 'polyp', name: '乙狀結腸有蒂腺瘤 (Pedunculated Polyp, 0.8cm)' };
      pathologyGroup.add(p1Mesh);

      // Ascending Flat Serrated Polyp (SSA/P)
      const p2Geom = new THREE.CylinderGeometry(0.18, 0.22, 0.08, 16);
      const p2Mesh = new THREE.Mesh(p2Geom, polypMat);
      p2Mesh.position.set(-1.85, 0.1, 0.1);
      p2Mesh.rotation.z = Math.PI / 3;
      p2Mesh.userData = { type: 'polyp', name: '升結腸無蒂鋸齒狀腺瘤 (Flat SSA, 1.2cm)' };
      pathologyGroup.add(p2Mesh);

      // Transverse Small Polyp
      const p3Geom = new THREE.SphereGeometry(0.1, 12, 12);
      const p3Mesh = new THREE.Mesh(p3Geom, polypMat);
      p3Mesh.position.set(0.2, 0.65, 0.95);
      p3Mesh.userData = { type: 'polyp', name: '橫結腸管狀腺瘤 (Tubular Adenoma, 0.5cm)' };
      pathologyGroup.add(p3Mesh);

      // 2. Diverticula (Multiple Outpouchings in Sigmoid & Descending)
      const divertMat = new THREE.MeshStandardMaterial({
        color: 0x7c3aed,
        roughness: 0.4,
        emissive: 0x6d28d9,
        emissiveIntensity: 0.5
      });

      const divPositions = [
        new THREE.Vector3(1.65, -1.9, 0.85),
        new THREE.Vector3(1.75, -2.2, 0.45),
        new THREE.Vector3(1.9, -1.2, 0.5),
        new THREE.Vector3(2.0, -0.8, 0.2),
        new THREE.Vector3(2.05, 0.2, -0.3)
      ];

      divPositions.forEach((pos, idx) => {
        const dMesh = new THREE.Mesh(new THREE.SphereGeometry(0.09, 12, 12), divertMat);
        dMesh.position.copy(pos);
        dMesh.userData = { type: 'diverticulum', name: `乙狀結腸憩室 (${idx + 1})` };
        pathologyGroup.add(dMesh);
      });

      // 3. Hemorrhoids (Clusters at Anorectal Junction)
      const hemMat = new THREE.MeshPhysicalMaterial({
        color: 0x9333ea,
        roughness: 0.25,
        clearcoat: 0.7,
        emissive: 0x7e22ce,
        emissiveIntensity: 0.65
      });

      const hemPositions = [
        new THREE.Vector3(0.12, -2.48, 0.15),
        new THREE.Vector3(-0.14, -2.45, 0.12),
        new THREE.Vector3(0.02, -2.52, -0.16)
      ];

      hemPositions.forEach(pos => {
        const hMesh = new THREE.Mesh(new THREE.SphereGeometry(0.11, 14, 14), hemMat);
        hMesh.position.copy(pos);
        hMesh.userData = { type: 'hemorrhoid', name: '肛門齒狀線內痔血管叢 (Hemorrhoid)' };
        pathologyGroup.add(hMesh);
      });

      // Initially hide all pathologies
      pathologyGroup.children.forEach(child => child.visible = false);
      scene.add(pathologyGroup);
    }

    // Toggle View Mode (Cutaway Luminal vs Full 3D)
    function setViewMode(mode) {
      currentViewMode = mode;
      document.getElementById('btn-mode-cutaway')?.classList.toggle('active', mode === 'cutaway');
      document.getElementById('btn-mode-full')?.classList.toggle('active', mode === 'full');

      build3DColonSegments();
      selectSegment(selectedId);
      showToast(mode === 'cutaway' ? '已切換為：內部管腔剖面 (Cutaway) 視野' : '已切換為：完整 3D 腸道外觀模式');
    }

    // Toggle Pathology Layers (Polyp / Diverticulum / Hemorrhoid)
    function togglePathology(type) {
      activePathology[type] = !activePathology[type];
      const btn = document.getElementById(`btn-path-${type}`);
      if (btn) btn.classList.toggle('active', activePathology[type]);

      pathologyGroup.children.forEach(child => {
        if (child.userData && child.userData.type === type) {
          child.visible = activePathology[type];
        }
      });

      const infoEl = document.getElementById('pathology-info-text');
      if (type === 'polyp') {
        if (activePathology.polyp) {
          infoEl.innerHTML = '🔴 <strong>已顯示大腸息肉</strong>：分布於乙狀結腸（有蒂）、升結腸（扁平 SSA）與橫結腸，可藉由內視鏡息肉切除術（EMR / Polypectomy）切除。';
          selectSegment('sigmoid');
        } else {
          infoEl.textContent = '已隱藏息肉病灶。';
        }
      } else if (type === 'diverticulum') {
        if (activePathology.diverticulum) {
          infoEl.innerHTML = '🟣 <strong>已顯示大腸憩室</strong>：主要分布於乙狀結腸與降結腸，為黏膜向外突出之囊袋，需注意高纖飲食預防憩室炎。';
          selectSegment('sigmoid');
        } else {
          infoEl.textContent = '已隱藏憩室病灶。';
        }
      } else if (type === 'hemorrhoid') {
        if (activePathology.hemorrhoid) {
          infoEl.innerHTML = '🟣 <strong>已顯示痔瘡病灶</strong>：位於肛門直腸交界齒狀線周圍，分為內痔與外痔。';
          selectSegment('rectum');
        } else {
          infoEl.textContent = '已隱藏痔瘡病灶。';
        }
      }
    }

    // Scope Slider (0 - 100 cm)
    function onScopeSlider(val) {
      const cm = parseInt(val, 10);
      const progressT = cm / 100.0;
      
      const badge = document.getElementById('txt-scope-cm');
      if (badge) badge.textContent = `${cm} cm`;

      updateColonoscopePosition(progressT);

      // Auto-update segment info based on scope cm
      const statusBox = document.getElementById('scope-status-text');
      if (cm <= 15) {
        if (statusBox) statusBox.textContent = `📍 直腸段 (${cm}cm)：剛通過肛門口，觀察直腸壺腹與齒狀線。`;
        selectSegment('rectum');
      } else if (cm <= 40) {
        if (statusBox) statusBox.textContent = `📍 乙狀結腸 (${cm}cm)：進入骨盆腔彎曲段，常規解環右旋後拉技巧處。`;
        selectSegment('sigmoid');
      } else if (cm <= 55) {
        if (statusBox) statusBox.textContent = `📍 降結腸/脾曲 (${cm}cm)：抵達左側大腸最高點脾曲，穿透左上腹。`;
        selectSegment('descending');
      } else if (cm <= 80) {
        if (statusBox) statusBox.textContent = `📍 橫結腸 (${cm}cm)：典型的三角形管腔與清晰結腸袋波紋。`;
        selectSegment('transverse');
      } else if (cm <= 95) {
        if (statusBox) statusBox.textContent = `📍 升結腸/肝曲 (${cm}cm)：跨越右肝曲，仔細沖洗排查扁平鋸齒狀腺瘤。`;
        selectSegment('ascending');
      } else {
        if (statusBox) statusBox.textContent = `🎯 盲腸達標 (100cm)：成功目視闌尾開口（奔馳標誌）與迴盲瓣！`;
        selectSegment('cecum');
      }
    }

    // 3D Explode Slider Action
    function onExplodeSlider(val) {
      const factor = val / 100.0;
      const txt = document.getElementById('txt-explode-val');
      if (txt) txt.textContent = `${val}%`;

      Object.keys(colonSegments).forEach(key => {
        const mesh = colonSegments[key];
        const dir = explodeVectors[key];
        mesh.position.x = dir.x * factor * 1.5;
        mesh.position.y = dir.y * factor * 1.5;
        mesh.position.z = dir.z * factor * 1.5;
      });
    }

    // Opacity Slider Action
    function onOpacitySlider(val) {
      currentOpacity = val / 100.0;
      const txt = document.getElementById('txt-opacity-val');
      if (txt) txt.textContent = `${val}%`;
      Object.keys(colonSegments).forEach(key => {
        colonSegments[key].material.opacity = currentOpacity;
      });
    }

    // Segment Selection
    function selectSegment(id) {
      if (isQuizMode) {
        handleQuizClick(id);
        return;
      }

      selectedId = id;
      const data = colonData[id];
      if (!data) return;

      document.querySelectorAll('.seg-card-btn').forEach(btn => btn.classList.remove('active'));
      document.getElementById(`btn-seg-${id}`)?.classList.add('active');

      Object.keys(colonSegments).forEach(key => {
        const mesh = colonSegments[key];
        if (key === id) {
          mesh.material.emissive.setHex(0x10b981);
          mesh.material.emissiveIntensity = 0.45;
          mesh.material.opacity = Math.max(currentOpacity, 0.95);
        } else {
          mesh.material.emissive.setHex(0x000000);
          mesh.material.emissiveIntensity = 0.0;
          mesh.material.opacity = currentOpacity;
        }
      });

      const pill = document.getElementById('det-pill');
      if (pill) pill.textContent = data.distance;
      document.getElementById('det-sector').textContent = data.sector;
      document.getElementById('det-title-zh').textContent = data.titleZh;
      document.getElementById('det-title-en').textContent = data.titleEn;
      document.getElementById('det-distance').textContent = data.distance;
      document.getElementById('det-difficulty').textContent = data.difficulty;
      document.getElementById('det-polyp-type').textContent = data.polypType;
      document.getElementById('det-disease').textContent = data.disease;
      document.getElementById('det-pearls-box').innerHTML = data.pearlsBox;
      document.getElementById('det-phrase-text').textContent = data.phrase;

      const pearlsList = document.getElementById('det-pearls-list');
      if (pearlsList) {
        pearlsList.innerHTML = '';
        data.pearls.forEach(text => {
          const item = document.createElement('div');
          item.className = 'pearl-item';
          item.innerHTML = `
            <svg width="14" height="14" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/></svg>
            <span>${text}</span>
          `;
          pearlsList.appendChild(item);
        });
      }
    }

    // Preset Views
    function setPresetView(preset) {
      document.querySelectorAll('.view-btn').forEach(b => b.classList.remove('active'));
      document.getElementById(`view-btn-${preset}`)?.classList.add('active');

      let targetPos = new THREE.Vector3(0, -0.3, 7.5);
      let targetLook = new THREE.Vector3(0, -0.5, 0);

      switch(preset) {
        case 'anterior': targetPos.set(0, -0.3, 7.5); targetLook.set(0, -0.5, 0); break;
        case 'left_colon': targetPos.set(4.8, -0.5, 4.2); targetLook.set(1.2, -0.8, 0.2); break;
        case 'right_colon': targetPos.set(-4.8, -0.5, 4.2); targetLook.set(-1.2, -0.8, 0.2); break;
        case 'splenic': targetPos.set(3.5, 3.2, 4.5); targetLook.set(1.5, 1.2, 0.0); break;
        case 'pelvis': targetPos.set(0, -6.5, 3.5); targetLook.set(0, -2.0, 0.2); break;
      }

      new TWEEN.Tween(camera.position).to(targetPos, 850).easing(TWEEN.Easing.Cubic.Out).start();
      new TWEEN.Tween(controls.target).to(targetLook, 850).easing(TWEEN.Easing.Cubic.Out).start();
    }

    function reset3DCamera() {
      setPresetView('anterior');
      const slider = document.getElementById('slider-explode');
      if (slider) slider.value = 0;
      onExplodeSlider(0);
      selectSegment('sigmoid');
      showToast('已重設為大腸 3D 正面全覽視角');
    }

    // Fullscreen Toggle
    function toggleFullScreen() {
      const wrapper = document.getElementById('colonAppWrapper');
      if (!document.fullscreenElement) {
        if (wrapper && wrapper.requestFullscreen) {
          wrapper.requestFullscreen();
        } else if (document.documentElement.requestFullscreen) {
          document.documentElement.requestFullscreen();
        }
      } else {
        if (document.exitFullscreen) {
          document.exitFullscreen();
        }
      }
    }

    document.addEventListener('fullscreenchange', () => {
      const isFs = !!document.fullscreenElement;
      const label = document.getElementById('txt-fs-label');
      const btn = document.getElementById('btn-fullscreen-toggle');
      if (label) label.textContent = isFs ? '退出全螢幕' : '全螢幕模式';
      if (btn) btn.classList.toggle('active', isFs);
      setTimeout(onWindowResize, 150);
    });

    function onPointerDown(e) {
      const rect = renderer.domElement.getBoundingClientRect();
      mouse.x = ((e.clientX - rect.left) / rect.width) * 2 - 1;
      mouse.y = -((e.clientY - rect.top) / rect.height) * 2 + 1;

      raycaster.setFromCamera(mouse, camera);
      const meshes = Object.values(colonSegments);
      const intersects = raycaster.intersectObjects(meshes, false);

      if (intersects.length > 0) {
        const clickedMesh = intersects[0].object;
        if (clickedMesh.userData && clickedMesh.userData.segmentId) {
          selectSegment(clickedMesh.userData.segmentId);
        }
      }
    }

    function onWindowResize() {
      const container = document.getElementById('threejs-canvas-container');
      if (!container || !renderer || !camera) return;
      const width = container.clientWidth;
      const height = container.clientHeight;
      if (width > 0 && height > 0) {
        camera.aspect = width / height;
        camera.updateProjectionMatrix();
        renderer.setSize(width, height);
      }
    }

    function copyPhrase() {
      const text = document.getElementById('det-phrase-text')?.textContent.trim();
      if (text) {
        navigator.clipboard.writeText(text).then(() => {
          showToast('已複製大腸鏡病歷片語至剪貼簿！');
        });
      }
    }

    function showToast(msg) {
      const toast = document.getElementById('toast');
      const msgEl = document.getElementById('toast-msg');
      if (!toast || !msgEl) return;
      msgEl.textContent = msg;
      toast.classList.add('show');
      setTimeout(() => toast.classList.remove('show'), 2500);
    }

    const quizCandidates = ['rectum', 'sigmoid', 'descending', 'transverse', 'ascending', 'cecum'];
    function toggleQuizMode() {
      isQuizMode = !isQuizMode;
      const btn = document.getElementById('btn-toggle-quiz');
      if (isQuizMode) {
        btn.classList.add('btn-primary');
        btn.classList.remove('btn-outline');
        btn.textContent = '結束測驗';
        nextQuizQuestion();
      } else {
        btn.classList.remove('btn-primary');
        btn.classList.add('btn-outline');
        btn.innerHTML = `
          <svg width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M9 11l3 3L22 4"/><path d="M21 12v7a2 2 0 01-2 2H5a2 2 0 01-2-2V5a2 2 0 012-2h11"/></svg>
          3D 測驗模式
        `;
        selectSegment(selectedId);
      }
    }

    function nextQuizQuestion() {
      const idx = Math.floor(Math.random() * quizCandidates.length);
      quizTarget = quizCandidates[idx];
      const data = colonData[quizTarget];
      showToast(`🎯 請在 3D 空間中找出並點擊：【${data.titleZh}】`);
    }

    function handleQuizClick(clickedId) {
      if (clickedId === quizTarget) {
        showToast('🎉 答對了！非常優秀！');
        selectSegment(clickedId);
        setTimeout(nextQuizQuestion, 1400);
      } else {
        const clickedName = colonData[clickedId] ? colonData[clickedId].titleZh : clickedId;
        showToast(`❌ 答錯囉！您點到的是【${clickedName}】，旋轉一下角度再試一次！`);
      }
    }

    function animate(time) {
      requestAnimationFrame(animate);
      TWEEN.update();
      if (controls) controls.update();

      // Subtle pulse on scope light
      if (scopeHeadLight) {
        const pulse = 2.0 + Math.sin((time || performance.now()) * 0.005) * 0.5;
        scopeHeadLight.intensity = pulse;
      }

      if (renderer && scene && camera) {
        renderer.render(scene, camera);
      }
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', init3D);
    } else {
      init3D();
    }
  </script>
</Layout>

