    // Living Intestinal Mucosa & Serosa Material with Subsurface Scattering
    function createArgonColonMaterial(options = {}) {
      const mat = new THREE.MeshPhysicalMaterial({
        color: options.color || 0xb84238,
        roughness: options.roughness !== undefined ? options.roughness : 0.32,
        metalness: options.metalness !== undefined ? options.metalness : 0.02,
        clearcoat: options.clearcoat !== undefined ? options.clearcoat : 0.86,
        clearcoatRoughness: options.clearcoatRoughness !== undefined ? options.clearcoatRoughness : 0.14,
        reflectivity: options.reflectivity !== undefined ? options.reflectivity : 0.65,
        transparent: options.transparent !== undefined ? options.transparent : true,
        opacity: options.opacity !== undefined ? options.opacity : currentOpacity,
        side: options.side || THREE.DoubleSide
      });

      mat.userData.sssUniforms = {
        uSSSColor: { value: new THREE.Color(options.sssColor || 0xf83f2e) },
        uDeepParenchyma: { value: new THREE.Color(options.deepColor || 0x4a0e08) },
        uCapsuleFresnel: { value: new THREE.Color(options.fresnelColor || 0xffded6) },
        uSSSIntensity: { value: options.sssIntensity !== undefined ? options.sssIntensity : 0.78 }
      };

      mat.onBeforeCompile = function (shader) {
        Object.assign(shader.uniforms, mat.userData.sssUniforms);

        shader.vertexShader = shader.vertexShader
          .replace(
            '#include <common>',
            `#include <common>
             varying vec3 vOrganLocalPos;
             varying vec3 vOrganWorldPos;`
          )
          .replace(
            '#include <worldpos_vertex>',
            `#include <worldpos_vertex>
             vOrganLocalPos = position;
             vOrganWorldPos = (modelMatrix * vec4(transformed, 1.0)).xyz;`
          );

        shader.fragmentShader = shader.fragmentShader
          .replace(
            '#include <common>',
            `#include <common>
             uniform vec3 uSSSColor;
             uniform vec3 uDeepParenchyma;
             uniform vec3 uCapsuleFresnel;
             uniform float uSSSIntensity;
             varying vec3 vOrganLocalPos;
             varying vec3 vOrganWorldPos;

             float hash3D(vec3 p) {
               return fract(sin(dot(p, vec3(12.9898, 78.233, 45.164))) * 43758.5453);
             }
             float organNoise(vec3 p) {
               vec3 i = floor(p);
               vec3 f = fract(p);
               f = f * f * (3.0 - 2.0 * f);
               return mix(
                 mix(mix(hash3D(i + vec3(0,0,0)), hash3D(i + vec3(1,0,0)), f.x),
                     mix(hash3D(i + vec3(0,1,0)), hash3D(i + vec3(1,1,0)), f.x), f.y),
                 mix(mix(hash3D(i + vec3(0,0,1)), hash3D(i + vec3(1,0,1)), f.x),
                     mix(hash3D(i + vec3(0,1,1)), hash3D(i + vec3(1,1,1)), f.x), f.y), f.z
               );
             }`
          )
          .replace(
            '#include <dithering_fragment>',
            `#include <dithering_fragment>
             vec3 viewDir = normalize(cameraPosition - vOrganWorldPos);
             vec3 norm = normalize(vNormal);
             vec3 lightDir = normalize(vec3(4.0, 6.0, 5.0));

             float sssWrap = max(0.0, dot(norm, lightDir) * 0.5 + 0.5);
             float backScatter = pow(max(0.0, dot(viewDir, -lightDir)), 2.5) * 0.45;
             float fresnelRim = pow(1.0 - max(0.0, dot(viewDir, norm)), 3.0);

             float microNoise = organNoise(vOrganLocalPos * 34.0) * 0.07;

             vec3 sssEffect = mix(uDeepParenchyma, uSSSColor, sssWrap + backScatter);
             gl_FragColor.rgb = mix(gl_FragColor.rgb, sssEffect, uSSSIntensity * 0.48);
             gl_FragColor.rgb += uCapsuleFresnel * fresnelRim * 0.36 + vec3(microNoise);
            `
          );
      };

      return mat;
    }

