  // 虛擬第一人稱胃鏡巡航參數 (平穩防眩暈與 360° 封閉充氣管腔)
  let isFlythroughMode = false;
  let flythroughT = 0.05;
  let isFlyPaused = false;
  let gastricFlySpeed = 0.00045; // ~3.5x slower (平緩舒適)
  let gastricSpeedMultiplier = 1.0;
  let gastricCurrentLookTarget = new THREE.Vector3();
  let gastricLookInitialized = false;
  let anteriorStomachMesh = null;
  let stomachWallBorderGroup = null;
  let flySavedCamPos = new THREE.Vector3();
  let flySavedLookAt = new THREE.Vector3();
  let flyEndoLight = null;

  function cycleGastricFlySpeed() {
    if (gastricSpeedMultiplier === 1.0) {
      gastricSpeedMultiplier = 0.5;
    } else if (gastricSpeedMultiplier === 0.5) {
      gastricSpeedMultiplier = 2.0;
    } else {
      gastricSpeedMultiplier = 1.0;
    }
    const btn = document.getElementById('btn-gastric-fly-speed');
    if (btn) btn.textContent = `速度: ${gastricSpeedMultiplier}x`;
  }

  function switchStomachControlTab(tab) {
    const scopeBar = document.getElementById('canvas-scope-bar');
    const progBar = document.getElementById('canvas-gastric-progression-bar');
    const tabScope = document.getElementById('tab-btn-scope');
    const tabProg = document.getElementById('tab-btn-progression');

    if (tab === 'scope') {
      if (scopeBar) scopeBar.style.display = 'block';
      if (progBar) progBar.style.display = 'none';
      if (tabScope) tabScope.classList.add('active');
      if (tabProg) tabProg.classList.remove('active');
      stopGastricAutoplay();
    } else {
      if (scopeBar) scopeBar.style.display = 'none';
      if (progBar) progBar.style.display = 'flex';
      if (tabScope) tabScope.classList.remove('active');
      if (tabProg) tabProg.classList.add('active');
      setGastricProgressionStage(currentGastricProgStage);
    }
  }

  function setGastricProgressionStage(stageIdx) {
    currentGastricProgStage = Math.max(0, Math.min(3, stageIdx));
    const data = GASTRIC_PROGRESSION_STAGES[currentGastricProgStage];

    // 更新 UI 滑桿與 Pill 按鈕
    const slider = document.getElementById('slider-gastric-prog');
    if (slider) slider.value = currentGastricProgStage;

    document.querySelectorAll('#canvas-gastric-progression-bar .stage-pill').forEach(pill => {
      pill.classList.toggle('active', parseInt(pill.dataset.stage) === currentGastricProgStage);
    });

    // 更新衛教卡
    const card = document.getElementById('gastric-clinical-card');
    if (card) {
      card.innerHTML = `
        <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 4px;">
          <strong style="color: #f8fafc; font-size: 0.85rem;">${data.name}</strong>
          <span class="reversibility-tag ${data.reversibility}">${data.reversibilityText}</span>
        </div>
        <div style="color: #cbd5e1; margin-bottom: 3px;"><strong>【病理變化】</strong>${data.pathology}</div>
        <div style="color: #94a3b8; margin-bottom: 3px;"><strong>【臨床特點】</strong>${data.clinical}</div>
        <div style="color: #38bdf8; font-weight: 600;"><strong>【處置建議】</strong>${data.advice}</div>
      `;
    }

    // 更新胃黏膜材質
    if (stomachMucosaMat) {
      stomachMucosaMat.color.setHex(data.mucosaColor);
      stomachMucosaMat.roughness = data.roughness;
      stomachMucosaMat.clearcoat = data.clearcoat;
    }
    if (stomachRugaeMat) {
      stomachRugaeMat.color.setHex(data.rugaeColor);
      stomachRugaeMat.roughness = data.roughness;
      stomachRugaeMat.clearcoat = data.clearcoat;
    }

    // 控制病灶顯示
    if (pathologyGroup) {
      pathologyGroup.children.forEach(child => {
        const type = child.userData.type;
        if (type === 'gerd') child.visible = (currentGastricProgStage === 1);
        if (type === 'metaplasia') child.visible = (currentGastricProgStage === 2);
        if (type === 'ulcer') child.visible = (currentGastricProgStage === 1 || currentGastricProgStage === 2);
      });
    }

    if (egcCancerMesh) {
      egcCancerMesh.visible = (currentGastricProgStage === 3);
    }
  }

  function toggleGastricAutoplay() {
    if (isGastricAutoplaying) stopGastricAutoplay();
    else startGastricAutoplay();
  }

  function startGastricAutoplay() {
    isGastricAutoplaying = true;
    const btn = document.getElementById('btn-gastric-autoplay');
    const icon = document.getElementById('gastric-play-icon');
    const text = document.getElementById('gastric-play-text');
    if (btn) btn.classList.add('active');
    if (icon) icon.textContent = '⏸';
    if (text) text.textContent = '暫停';

    gastricTimer = setInterval(() => {
      const nextStage = (currentGastricProgStage + 1) % 4;
      setGastricProgressionStage(nextStage);
    }, 2800);
  }

  function stopGastricAutoplay() {
    isGastricAutoplaying = false;
    if (gastricTimer) {
      clearInterval(gastricTimer);
      gastricTimer = null;
    }
    const btn = document.getElementById('btn-gastric-autoplay');
    const icon = document.getElementById('gastric-play-icon');
    const text = document.getElementById('gastric-play-text');
    if (btn) btn.classList.remove('active');
    if (icon) icon.textContent = '▶';
    if (text) text.textContent = '自動演變';
  }

  // ── 建立早期胃癌 3D 惡性凹陷病灶 (Early Gastric Cancer Paris 0-IIc) ──
  function buildEarlyGastricCancerModel() {
    const cancerGroup = new THREE.Group();
    cancerGroup.visible = false;

    // 凹陷糜爛中心
    const centerGeo = new THREE.CylinderGeometry(0.18, 0.16, 0.05, 16);
    const centerMat = new THREE.MeshStandardMaterial({
      color: 0x7f1d1d,
      roughness: 0.6,
      emissive: 0x991b1b,
      emissiveIntensity: 0.5
    });
    const centerMesh = new THREE.Mesh(centerGeo, centerMat);

    // 不規則結節隆起邊緣
    const rimGeo = new THREE.TorusGeometry(0.20, 0.045, 8, 16);
    const rimMat = new THREE.MeshStandardMaterial({
      color: 0xb91c1c,
      roughness: 0.35,
      metalness: 0.05
    });
    const rimMesh = new THREE.Mesh(rimGeo, rimMat);
    centerMesh.add(rimMesh);

    // 位於胃角前壁 (Incisura / Pre-pyloric antrum)
    centerMesh.position.set(-0.25, -0.95, 0.12);
    centerMesh.rotation.x = Math.PI / 4;
    cancerGroup.add(centerMesh);

    egcCancerMesh = cancerGroup;
    scene.add(cancerGroup);
  }

  // ── 虛擬胃鏡第一人稱「腔內飛行巡航 (Fly-through Mode)」──
  function toggleGastricFlythrough() {
    if (isFlythroughMode) {
      exitGastricFlythrough();
    } else {
      startGastricFlythrough();
    }
  }

  function startGastricFlythrough() {
    if (!gastroscopySplineCurve) return;
    isFlythroughMode = true;
    controls.enabled = false;
    flythroughT = 0.05;
    isFlyPaused = false;
    gastricLookInitialized = false;

    // 啟動 360° 完整充氣胃腔 (顯示前壁穹頂，隱藏剖切邊緣)
    if (anteriorStomachMesh) anteriorStomachMesh.visible = true;
    if (stomachWallBorderGroup) stomachWallBorderGroup.visible = false;

    // 隱藏一般底部控制欄 (專注於巡航 HUD)
    const controlsContainer = document.getElementById('canvas-controls-container');
    if (controlsContainer) controlsContainer.style.display = 'none';

    // 徹底隱藏胃鏡軟管、頭部與 3D 浮動標籤 (徹底消除圖二穿模高光白條與阻擋視線之文字)
    if (scopeGroup) scopeGroup.visible = false;
    if (scopeTubeMesh) scopeTubeMesh.visible = false;
    Object.values(segmentLabelSprites).forEach(sprite => {
      if (sprite) sprite.visible = false;
    });

    // 保存預設相機視角以便退出時還原
    flySavedCamPos.copy(camera.position);
    flySavedLookAt.copy(controls.target);

    // 建立腔內探照強效 LED 燈
    if (!flyEndoLight) {
      flyEndoLight = new THREE.PointLight(0xffffff, 2.8, 5.5);
      scene.add(flyEndoLight);
    }
    flyEndoLight.visible = true;

    // 顯示 HUD
    const hud = document.getElementById('gastric-flythrough-hud');
    if (hud) hud.style.display = 'flex';

    const btn = document.getElementById('btn-flythrough');
    if (btn) btn.classList.add('active');

    camera.fov = 65; // 胃鏡超廣角鏡頭感
    camera.updateProjectionMatrix();

    showToast('🚀 已啟動平穩胃鏡腔內飛行巡航 (360° 充氣胃腔)！');
  }

  function exitGastricFlythrough() {
    isFlythroughMode = false;
    isFlyPaused = false;
    gastricLookInitialized = false;

    // 恢復 3D 正面剖切觀 (隱藏前壁穹頂，還原剖切邊緣)
    if (anteriorStomachMesh) anteriorStomachMesh.visible = false;
    if (stomachWallBorderGroup) stomachWallBorderGroup.visible = true;

    // 還原一般底部控制欄
    const controlsContainer = document.getElementById('canvas-controls-container');
    if (controlsContainer) controlsContainer.style.display = 'flex';
    switchStomachControlTab('scope');

    // 還原胃鏡軟管、頭部與 3D 浮動標籤
    if (scopeGroup) scopeGroup.visible = true;
    if (scopeTubeMesh) scopeTubeMesh.visible = true;
    Object.values(segmentLabelSprites).forEach(sprite => {
      if (sprite) sprite.visible = true;
    });

    controls.enabled = true;

    if (flyEndoLight) flyEndoLight.visible = false;

    const hud = document.getElementById('gastric-flythrough-hud');
    if (hud) hud.style.display = 'none';

    const alertEl = document.getElementById('fly-retroflexion-alert');
    if (alertEl) alertEl.style.display = 'none';

    const btn = document.getElementById('btn-flythrough');
    if (btn) btn.classList.remove('active');

    // 還原相機視角與 FOV
    camera.fov = 45;
    camera.updateProjectionMatrix();

    new TWEEN.Tween(camera.position)
      .to(flySavedCamPos, 900)
      .easing(TWEEN.Easing.Cubic.Out)
      .start();

    new TWEEN.Tween(controls.target)
      .to(flySavedLookAt, 900)
      .easing(TWEEN.Easing.Cubic.Out)
      .start();

    showToast('⏹ 已退出巡航，返回 3D 正面剖切視角');
  }

  function toggleFlyPause() {
    isFlyPaused = !isFlyPaused;
    const btn = document.getElementById('btn-fly-pause');
    if (btn) btn.textContent = isFlyPaused ? '▶ 繼續' : '⏸ 暫停';
  }

    function buildTextbookStomachModel() {
      stomachMasterGroup = new THREE.Group();

      // Argon 4.0 Subsurface Scattering Materials
      const mucosaMat = stomachMucosaMat = createArgonGastricMaterial({
        color: 0xba3f36,
        roughness: 0.30,
        clearcoat: 0.88,
        clearcoatRoughness: 0.12,
        sssColor: 0xf84332,
        deepColor: 0x480e08,
        sssIntensity: 0.78
      });

      const serosaMat = createArgonGastricMaterial({
        color: 0xad463d,
        roughness: 0.38,
        clearcoat: 0.75,
        clearcoatRoughness: 0.18,
        sssColor: 0xdb4a39,
        deepColor: 0x3d0b07,
        sssIntensity: 0.65
      });

      const rugaeMat = stomachRugaeMat = createArgonGastricMaterial({
        color: 0xc2463c,
        roughness: 0.28,
        clearcoat: 0.90,
        clearcoatRoughness: 0.10,
        sssColor: 0xff4d3b,
        deepColor: 0x54120c,
        sssIntensity: 0.82
      });

      const esophMat = createArgonGastricMaterial({
        color: 0xd28680,
        roughness: 0.42,
        clearcoat: 0.68,
        clearcoatRoughness: 0.22,
        sssColor: 0xf3928c,
        deepColor: 0x521814,
        sssIntensity: 0.55
      });

      const wallCutMat = new THREE.MeshStandardMaterial({
        color: 0x7a1c16,
        roughness: 0.52,
        side: THREE.DoubleSide
      });

      const submucosaStripeMat = new THREE.MeshStandardMaterial({
        color: 0xf2deda,
        roughness: 0.35,
        side: THREE.DoubleSide
      });

      const sphincterMat = new THREE.MeshStandardMaterial({
        color: 0x8f2720,
        roughness: 0.50
      });

      // --- A. Anatomical Boundary Splines ---
      // Greater Curvature (Angle of His -> Vaulted Fundus Dome -> Broad Gastric Body -> Antrum -> Pylorus)
      const greaterPoints = [
        new THREE.Vector3(-0.48, 1.45, 0.0), // Angle of His (Cardiac notch)
        new THREE.Vector3(-0.08, 2.05, -0.05), // Fundus rise
        new THREE.Vector3(0.65, 2.42, -0.1),  // Fundus apex dome
        new THREE.Vector3(1.65, 2.18, -0.15), // Fundus lateral crest
        new THREE.Vector3(2.25, 1.45, -0.2),  // Upper body greater curvature
        new THREE.Vector3(2.48, 0.35, -0.25), // Mid body greater curvature (Apex of bulge)
        new THREE.Vector3(2.28, -0.7, -0.2),  // Lower body
        new THREE.Vector3(1.65, -1.6, -0.1),  // Greater curvature antrum transition
        new THREE.Vector3(0.6, -2.05, 0.0),   // Antrum dependent curve
        new THREE.Vector3(-0.55, -1.88, 0.0), // Pre-pyloric antrum bottom
        new THREE.Vector3(-1.18, -1.65, 0.0)  // Pylorus inferior margin
      ];
      const greaterCurve = new THREE.CatmullRomCurve3(greaterPoints);

      // Lesser Curvature (Cardia -> Lesser Curve -> Incisura Angularis -> Pylorus)
      const lesserPoints = [
        new THREE.Vector3(-0.68, 1.4, 0.0),   // Cardia medial margin
        new THREE.Vector3(-0.46, 0.72, 0.0),  // Upper lesser curvature
        new THREE.Vector3(-0.32, 0.02, 0.0),  // Mid lesser curvature
        new THREE.Vector3(-0.28, -0.62, 0.0), // Incisura angularis (Distinct gastric angle notch)
        new THREE.Vector3(-0.52, -1.15, 0.0), // Antrum superior curve
        new THREE.Vector3(-1.18, -1.25, 0.0)  // Pylorus superior margin
      ];
      const lesserCurve = new THREE.CatmullRomCurve3(lesserPoints);

      // --- B. Construct 3D Posterior Cavity Surface & Outer Serosa Shell ---
      const uSteps = 55;
      const vSteps = 35;
      const posArray = [];
      const uvsArray = [];
      const idxArray = [];

      for (let i = 0; i <= uSteps; i++) {
        const u = i / uSteps;
        const ptG = greaterCurve.getPoint(u);
        const ptL = lesserCurve.getPoint(u);

        for (let j = 0; j <= vSteps; j++) {
          const v = j / vSteps; // 0 = Lesser curve, 1 = Greater curve
          const basePt = new THREE.Vector3().lerpVectors(ptL, ptG, v);

          // Deep anatomical 3D cavity profiling
          const spanDist = ptL.distanceTo(ptG);
          const arch = Math.sin(v * Math.PI);
          const uProfile = Math.sin(u * Math.PI);

          // Fundus (u < 0.28) is deeply hollowed posteriorly and superiorly
          // Mid body (u 0.28~0.70) has deep visceral depression
          // Antrum (u > 0.70) becomes more cylindrical and tapers
          let depthFactor = 0.58 + 0.52 * uProfile;
          if (u < 0.25) depthFactor = 0.75 + (0.25 - u) * 0.8;
          if (u > 0.75) depthFactor = 0.58 * (1.0 - (u - 0.75) * 1.5);

          const depthZ = -Math.pow(arch, 0.82) * (spanDist * 0.44 + 0.38) * depthFactor;

          posArray.push(basePt.x, basePt.y, depthZ);
          uvsArray.push(u, v);
        }
      }

      for (let i = 0; i < uSteps; i++) {
        for (let j = 0; j < vSteps; j++) {
          const a = i * (vSteps + 1) + j;
          const b = (i + 1) * (vSteps + 1) + j;
          const c = (i + 1) * (vSteps + 1) + (j + 1);
          const d = i * (vSteps + 1) + (j + 1);

          idxArray.push(a, b, d);
          idxArray.push(b, c, d);
        }
      }

      const backWallGeom = new THREE.BufferGeometry();
      backWallGeom.setAttribute('position', new THREE.Float32BufferAttribute(posArray, 3));
      backWallGeom.setAttribute('uv', new THREE.Float32BufferAttribute(uvsArray, 2));
      backWallGeom.setIndex(idxArray);
      backWallGeom.computeVertexNormals();

      const backWallMesh = new THREE.Mesh(backWallGeom, mucosaMat);
      stomachMasterGroup.add(backWallMesh);

      // --- Anterior Gastric Vault Dome (Visible ONLY in Flythrough Mode for 360° Insufflated Lumen) ---
      const antPosArray = [];
      const antUvsArray = [];
      const antIdxArray = [];

      for (let i = 0; i <= uSteps; i++) {
        const u = i / uSteps;
        const ptG = greaterCurve.getPoint(u);
        const ptL = lesserCurve.getPoint(u);

        for (let j = 0; j <= vSteps; j++) {
          const v = j / vSteps;
          const basePt = new THREE.Vector3().lerpVectors(ptL, ptG, v);
          const spanDist = ptL.distanceTo(ptG);
          const arch = Math.sin(v * Math.PI);
          const uProfile = Math.sin(u * Math.PI);

          let depthFactor = 0.58 + 0.52 * uProfile;
          if (u < 0.25) depthFactor = 0.75 + (0.25 - u) * 0.8;
          if (u > 0.75) depthFactor = 0.58 * (1.0 - (u - 0.75) * 1.5);

          const depthZFront = +Math.pow(arch, 0.82) * (spanDist * 0.44 + 0.38) * depthFactor * 0.95;
          antPosArray.push(basePt.x, basePt.y, depthZFront);
          antUvsArray.push(u, v);
        }
      }

      for (let i = 0; i < uSteps; i++) {
        for (let j = 0; j < vSteps; j++) {
          const a = i * (vSteps + 1) + j;
          const b = (i + 1) * (vSteps + 1) + j;
          const c = (i + 1) * (vSteps + 1) + (j + 1);
          const d = i * (vSteps + 1) + (j + 1);

          antIdxArray.push(a, d, b);
          antIdxArray.push(b, d, c);
        }
      }

      const frontWallGeom = new THREE.BufferGeometry();
      frontWallGeom.setAttribute('position', new THREE.Float32BufferAttribute(antPosArray, 3));
      frontWallGeom.setAttribute('uv', new THREE.Float32BufferAttribute(antUvsArray, 2));
      frontWallGeom.setIndex(antIdxArray);
      frontWallGeom.computeVertexNormals();

      anteriorStomachMesh = new THREE.Mesh(frontWallGeom, mucosaMat);
      anteriorStomachMesh.visible = false;
      stomachMasterGroup.add(anteriorStomachMesh);

      // Outer Serosal Shell (Posterior exterior coat)
      const serosaPosArray = [];
      for (let k = 0; k < posArray.length; k += 3) {
        serosaPosArray.push(posArray[k], posArray[k + 1], posArray[k + 2] - 0.05);
      }
      const serosaGeom = new THREE.BufferGeometry();
      serosaGeom.setAttribute('position', new THREE.Float32BufferAttribute(serosaPosArray, 3));
      serosaGeom.setAttribute('uv', new THREE.Float32BufferAttribute(uvsArray, 2));
      serosaGeom.setIndex(idxArray);
      serosaGeom.computeVertexNormals();
      const serosaMesh = new THREE.Mesh(serosaGeom, serosaMat);
      stomachMasterGroup.add(serosaMesh);

      // --- C. Multi-Layered Anatomical Wall Cut Border Rims ---
      const wallBorderGroup = stomachWallBorderGroup = new THREE.Group();

      // Muscularis Layer (Thick deep red muscular core)
      const greaterMuscGeom = new THREE.TubeGeometry(greaterCurve, 70, 0.082, 12, false);
      const greaterMuscMesh = new THREE.Mesh(greaterMuscGeom, wallCutMat);
      greaterMuscMesh.scale.set(1.0, 1.0, 0.42);
      wallBorderGroup.add(greaterMuscMesh);

      const lesserMuscGeom = new THREE.TubeGeometry(lesserCurve, 45, 0.072, 12, false);
      const lesserMuscMesh = new THREE.Mesh(lesserMuscGeom, wallCutMat);
      lesserMuscMesh.scale.set(1.0, 1.0, 0.42);
      wallBorderGroup.add(lesserMuscMesh);

      // Submucosal Glistening Stripe (Delicate inner rim highlight)
      const greaterSubGeom = new THREE.TubeGeometry(greaterCurve, 70, 0.038, 8, false);
      const greaterSubMesh = new THREE.Mesh(greaterSubGeom, submucosaStripeMat);
      greaterSubMesh.position.set(0, 0, -0.015);
      wallBorderGroup.add(greaterSubMesh);

      const lesserSubGeom = new THREE.TubeGeometry(lesserCurve, 45, 0.034, 8, false);
      const lesserSubMesh = new THREE.Mesh(lesserSubGeom, submucosaStripeMat);
      lesserSubMesh.position.set(0, 0, -0.015);
      wallBorderGroup.add(lesserSubMesh);

      stomachMasterGroup.add(wallBorderGroup);

      // --- D. Volumetric Organic Gastric Rugae (胃皺襞, Argon 4.0 Standard) ---
      // Real gastric rugae run longitudinally along greater curvature and posterior wall,
      // undulating organically, and flattening out completely in the prepyloric antrum!
      const rugaeGroup = new THREE.Group();
      const numRugaeFolds = 12;

      for (let r = 1; r <= numRugaeFolds; r++) {
        // Spread folds across mid-to-greater curvature
        const vRatio = 0.22 + (r / (numRugaeFolds + 1)) * 0.72;
        const foldPoints = [];
        const numPts = 42;

        for (let p = 2; p <= numPts - 3; p++) {
          const uRatio = p / numPts;
          const ptG = greaterCurve.getPoint(uRatio);
          const ptL = lesserCurve.getPoint(uRatio);
          const basePt = new THREE.Vector3().lerpVectors(ptL, ptG, vRatio);

          // Real rugal folds are prominent in the body and flatten out in the antrum (uRatio > 0.70)
          let foldAmp = 0.052 * Math.sin(uRatio * Math.PI * 0.95);
          if (uRatio > 0.70) {
            foldAmp *= Math.max(0.0, 1.0 - (uRatio - 0.70) / 0.18); // Tapers to 0 in antrum
          }

          // Sinusoidal serpentine undulation with organic harmonic variation
          const wavePhase = uRatio * Math.PI * 14 + r * 1.45;
          const wriggleX = Math.cos(wavePhase) * foldAmp * 0.75;
          const wriggleY = Math.sin(wavePhase) * foldAmp * 0.75;

          const arch = Math.sin(vRatio * Math.PI);
          const spanDist = ptL.distanceTo(ptG);
          let depthFactor = 0.58 + 0.52 * Math.sin(uRatio * Math.PI);
          if (uRatio < 0.25) depthFactor = 0.75 + (0.25 - uRatio) * 0.8;
          if (uRatio > 0.75) depthFactor = 0.58 * (1.0 - (uRatio - 0.75) * 1.5);

          const depthZ = -Math.pow(arch, 0.82) * (spanDist * 0.44 + 0.38) * depthFactor + 0.038 + foldAmp * 0.45;

          foldPoints.push(new THREE.Vector3(basePt.x + wriggleX, basePt.y + wriggleY, depthZ));
        }

        if (foldPoints.length >= 4) {
          const foldCurve = new THREE.CatmullRomCurve3(foldPoints);
          const foldRadius = 0.032 + 0.016 * Math.sin((r / numRugaeFolds) * Math.PI);
          const foldGeom = new THREE.TubeGeometry(foldCurve, 45, foldRadius, 8, false);
          const foldMesh = new THREE.Mesh(foldGeom, rugaeMat);
          rugaeGroup.add(foldMesh);
        }
      }
      stomachMasterGroup.add(rugaeGroup);

      // --- E. Esophagus, LES, and Z-Line (Squamocolumnar Junction at 40cm) ---
      const esophGroup = new THREE.Group();
      const esophPoints = [
        new THREE.Vector3(-0.95, 3.4, 0.0),
        new THREE.Vector3(-0.85, 2.5, 0.0),
        new THREE.Vector3(-0.72, 1.85, 0.0),
        new THREE.Vector3(-0.58, 1.4, 0.0)
      ];
      const esophCurve = new THREE.CatmullRomCurve3(esophPoints);
      const esophGeom = new THREE.TubeGeometry(esophCurve, 28, 0.21, 16, false);
      const esophMesh = new THREE.Mesh(esophGeom, esophMat);
      esophGroup.add(esophMesh);

      // LES Sphincter Ring (Muscular pinch at 1.85)
      const lesGeom = new THREE.TorusGeometry(0.23, 0.058, 12, 24);
      const lesMesh = new THREE.Mesh(lesGeom, sphincterMat);
      lesMesh.position.set(-0.72, 1.85, 0.0);
      lesMesh.rotation.x = Math.PI / 3;
      esophGroup.add(lesMesh);

      // Z-Line (Squamocolumnar Junction at 40cm / EGJ)
      const zLinePoints = [];
      const zRadius = 0.22;
      for (let s = 0; s <= 24; s++) {
        const theta = (s / 24) * Math.PI * 2;
        // Distinct zigzag crenulation
        const crenulation = 0.022 * Math.sin(theta * 10);
        const zx = Math.cos(theta) * (zRadius + crenulation);
        const zy = Math.sin(theta) * (zRadius + crenulation) * 0.45;
        zLinePoints.push(new THREE.Vector3(zx - 0.58, zy + 1.42, crenulation));
      }
      const zLineCurve = new THREE.CatmullRomCurve3(zLinePoints);
      const zLineGeom = new THREE.TubeGeometry(zLineCurve, 32, 0.016, 6, true);
      const zLineMat = new THREE.MeshStandardMaterial({ color: 0xff6655, roughness: 0.3 });
      const zLineMesh = new THREE.Mesh(zLineGeom, zLineMat);
      esophGroup.add(zLineMesh);

      stomachMasterGroup.add(esophGroup);

      // --- F. Pyloric Sphincter & Duodenal Bulb with Kerckring Folds ---
      const duoGroup = new THREE.Group();

      // Pyloric Sphincter Muscular Cuff
      const pylorusRingGeom = new THREE.TorusGeometry(0.24, 0.088, 14, 24);
      const pylorusRingMesh = new THREE.Mesh(pylorusRingGeom, sphincterMat);
      pylorusRingMesh.position.set(-1.18, -1.45, 0.0);
      pylorusRingMesh.rotation.y = Math.PI / 4;
      duoGroup.add(pylorusRingMesh);

      // Duodenal C-Loop (D1 Bulb curving into D2 Descending Duodenum)
      const duoPoints = [
        new THREE.Vector3(-1.18, -1.45, 0.0),
        new THREE.Vector3(-1.52, -1.48, 0.0),
        new THREE.Vector3(-1.78, -1.82, 0.0),
        new THREE.Vector3(-1.88, -2.42, 0.0),
        new THREE.Vector3(-1.76, -2.85, 0.0)
      ];
      const duoCurve = new THREE.CatmullRomCurve3(duoPoints);
      const duoGeom = new THREE.TubeGeometry(duoCurve, 32, 0.23, 16, false);
      const duoMesh = new THREE.Mesh(duoGeom, serosaMat);
      duoGroup.add(duoMesh);

      // Duodenal Circular Folds (Plicae circulares / Kerckring's folds in D2)
      for (let k = 1; k <= 5; k++) {
        const uD = 0.42 + (k / 6) * 0.52;
        const ptD = duoCurve.getPoint(uD);
        const tanD = duoCurve.getTangent(uD).normalize();
        const foldRingGeom = new THREE.TorusGeometry(0.22, 0.024, 8, 16);
        const foldRingMesh = new THREE.Mesh(foldRingGeom, rugaeMat);
        foldRingMesh.position.copy(ptD);
        foldRingMesh.quaternion.setFromUnitVectors(new THREE.Vector3(0, 0, 1), tanD);
        duoGroup.add(foldRingMesh);
      }

      stomachMasterGroup.add(duoGroup);

      // Add Master Group to Scene
      scene.add(stomachMasterGroup);

      // --- G. Add Auto-Fitting 3D Billboard Labels ---
      Object.keys(segmentConfigs).forEach(k => {
        const conf = segmentConfigs[k];
        const sprite = createTextSprite(conf.label, '#38bdf8');
        sprite.position.set(conf.labelPos[0], conf.labelPos[1], conf.labelPos[2]);
        stomachMasterGroup.add(sprite);
        segmentLabelSprites[k] = sprite;
      });
    }

    // Dynamic Auto-Fitting Billboard Text Sprite Generator (100% inside borders!)
    function createTextSprite(text, accentColor = '#38bdf8') {
      const canvas = document.createElement('canvas');
      canvas.width = 512;
      canvas.height = 140;
      const ctx = canvas.getContext('2d');

      ctx.font = 'bold 36px -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Noto Sans TC", sans-serif';
      const textWidth = ctx.measureText(text).width;

      const pillWidth = Math.min(480, Math.max(160, textWidth + 64));
      const pillHeight = 72;
      const x = (canvas.width - pillWidth) / 2;
      const y = (canvas.height - pillHeight) / 2;

      // Draw pill background
      ctx.fillStyle = 'rgba(10, 20, 36, 0.92)';
      ctx.beginPath();
      ctx.roundRect(x, y, pillWidth, pillHeight, 36);
      ctx.fill();

      // Draw crisp glowing border
      ctx.strokeStyle = accentColor;
      ctx.lineWidth = 4;
      ctx.stroke();

      // Draw centered text
      ctx.fillStyle = '#ffffff';
      ctx.textAlign = 'center';
      ctx.textBaseline = 'middle';
      ctx.fillText(text, canvas.width / 2, canvas.height / 2);

      const texture = new THREE.CanvasTexture(canvas);
      texture.minFilter = THREE.LinearFilter;
      const spriteMat = new THREE.SpriteMaterial({ map: texture, transparent: true, depthTest: false });
      const sprite = new THREE.Sprite(spriteMat);
      sprite.scale.set(1.3 * (pillWidth / 250), 0.65, 1);
      return sprite;
    }

    // Build Glowing Focus Halo Beacon
    function buildFocusBeacon() {
      focusBeaconGroup = new THREE.Group();

      const ringGeom = new THREE.RingGeometry(0.35, 0.45, 32);
      const ringMat = new THREE.MeshBasicMaterial({
        color: 0x00e5ff,
        side: THREE.DoubleSide,
        transparent: true,
        opacity: 0.85
      });
      focusBeaconMesh = new THREE.Mesh(ringGeom, ringMat);
      focusBeaconGroup.add(focusBeaconMesh);

      const pointLight = new THREE.PointLight(0x00e5ff, 0.7, 2.0);
      focusBeaconGroup.add(pointLight);

      scene.add(focusBeaconGroup);
    }

    // Build 3D Gastroscope (Flexible black tube with bright LED optic beam)
    function build3DGastroscope() {
      scopeGroup = new THREE.Group();

      const tipGeom = new THREE.SphereGeometry(0.1, 16, 16);
      const tipMat = new THREE.MeshBasicMaterial({ color: 0x00e5ff });
      scopeTipMesh = new THREE.Mesh(tipGeom, tipMat);
      scopeGroup.add(scopeTipMesh);

      const coneGeom = new THREE.ConeGeometry(0.35, 0.75, 16, 1, true);
      coneGeom.translate(0, 0.38, 0);
      coneGeom.rotateX(Math.PI / 2);
      const coneMat = new THREE.MeshBasicMaterial({
        color: 0x38bdf8,
        transparent: true,
        opacity: 0.35,
        side: THREE.DoubleSide
      });
      const lightBeamMesh = new THREE.Mesh(coneGeom, coneMat);
      scopeTipMesh.add(lightBeamMesh);

      scopeHeadLight = new THREE.PointLight(0x00e5ff, 0.8, 2.5);
      scopeGroup.add(scopeHeadLight);

      scene.add(scopeGroup);
    }

    function updateGastroscopePosition(progressT) {
      if (!gastroscopySplineCurve || !scopeGroup) return;

      const tClamped = Math.max(0.001, Math.min(0.999, progressT));
      const pt = gastroscopySplineCurve.getPoint(tClamped);
      const tangent = gastroscopySplineCurve.getTangent(tClamped).normalize();

      scopeGroup.position.copy(pt);
      scopeTipMesh.quaternion.setFromUnitVectors(new THREE.Vector3(0, 0, 1), tangent);

      if (scopeTubeMesh) scene.remove(scopeTubeMesh);

      const numPoints = Math.max(8, Math.floor(tClamped * 45));
      const subPoints = [];
      for (let i = 0; i <= numPoints; i++) {
        subPoints.push(gastroscopySplineCurve.getPoint((i / numPoints) * tClamped));
      }

      if (subPoints.length >= 2) {
        const subCurve = new THREE.CatmullRomCurve3(subPoints);
        const tubeGeom = new THREE.TubeGeometry(subCurve, numPoints * 2, 0.075, 10, false);
        const tubeMat = new THREE.MeshStandardMaterial({
          color: 0x18181b,
          roughness: 0.8,
          metalness: 0.05
        });
        scopeTubeMesh = new THREE.Mesh(tubeGeom, tubeMat);
        scene.add(scopeTubeMesh);
      }
    }

    // Build 4 Major Pathologies in 3D (GERD, Ulcers, Polyps, Intestinal Metaplasia)
    function build3DPathologies() {
      pathologyGroup = new THREE.Group();

      // 1. GERD (Erosive Streaks at EGJ / Cardia)
      const gerdMat = new THREE.MeshPhysicalMaterial({
        color: 0xf43f5e,
        roughness: 0.3,
        emissive: 0xe11d48,
        emissiveIntensity: 0.75
      });

      const gerdStreaks = [
        new THREE.Vector3(-0.55, 1.5, 0.05),
        new THREE.Vector3(-0.62, 1.35, 0.08),
        new THREE.Vector3(-0.48, 1.25, 0.02)
      ];
      gerdStreaks.forEach(pos => {
        const streakMesh = new THREE.Mesh(new THREE.CylinderGeometry(0.025, 0.025, 0.22, 8), gerdMat);
        streakMesh.position.copy(pos);
        streakMesh.rotation.z = -Math.PI / 6;
        streakMesh.userData = { type: 'gerd', name: '逆流性食道炎黏膜破損 (LA Grade A/B)' };
        pathologyGroup.add(streakMesh);
      });

      // 2. Peptic Ulcers (Gastric Ulcer at Angulus & Duodenal Ulcer at Bulb)
      const ulcerMat = new THREE.MeshStandardMaterial({
        color: 0xf1f5f9,
        roughness: 0.5,
        emissive: 0xffffff,
        emissiveIntensity: 0.85
      });
      const ulcerBorderMat = new THREE.MeshStandardMaterial({
        color: 0xb91c1c,
        roughness: 0.3
      });

      // Gastric Ulcer at Angulus (胃角潰瘍)
      const guMesh = new THREE.Mesh(new THREE.CylinderGeometry(0.12, 0.12, 0.04, 16), ulcerMat);
      guMesh.add(new THREE.Mesh(new THREE.TorusGeometry(0.13, 0.03, 8, 16), ulcerBorderMat));
      guMesh.position.set(-0.35, -0.7, -0.05);
      guMesh.userData = { type: 'ulcer', name: '胃角部良性活動性胃潰瘍 (Gastric Ulcer, A1/A2 stage)' };
      pathologyGroup.add(guMesh);

      // Duodenal Ulcer at Bulb (十二指腸球部前壁潰瘍)
      const duMesh = new THREE.Mesh(new THREE.CylinderGeometry(0.09, 0.09, 0.04, 16), ulcerMat);
      duMesh.add(new THREE.Mesh(new THREE.TorusGeometry(0.1, 0.025, 8, 16), ulcerBorderMat));
      duMesh.position.set(-1.6, -1.65, 0.05);
      duMesh.userData = { type: 'ulcer', name: '十二指腸球部潰瘍 (Duodenal Ulcer)' };
      pathologyGroup.add(duMesh);

      // 3. Gastric Polyps (Fundic Gland Polyps vs Hyperplastic Polyp)
      const fpgMat = new THREE.MeshPhysicalMaterial({
        color: 0xfda4af,
        roughness: 0.2,
        clearcoat: 0.9,
        emissive: 0xf43f5e,
        emissiveIntensity: 0.4
      });
      const hyperplasticMat = new THREE.MeshPhysicalMaterial({
        color: 0xe11d48,
        roughness: 0.3,
        emissive: 0xbe123c,
        emissiveIntensity: 0.6
      });

      // FGPs at Fundus (Multiple tiny benign polyps)
      const fgpPositions = [
        new THREE.Vector3(1.1, 1.9, -0.05),
        new THREE.Vector3(1.5, 1.7, -0.08),
        new THREE.Vector3(0.7, 2.0, -0.04)
      ];
      fgpPositions.forEach(pos => {
        const fgpMesh = new THREE.Mesh(new THREE.SphereGeometry(0.07, 12, 12), fpgMat);
        fgpMesh.position.copy(pos);
        fgpMesh.userData = { type: 'polyp', name: '胃底腺息肉 (Fundic Gland Polyp, 0.3cm)' };
        pathologyGroup.add(fgpMesh);
      });

      // Hyperplastic Polyp at Antrum
      const hpMesh = new THREE.Mesh(new THREE.SphereGeometry(0.12, 14, 14), hyperplasticMat);
      hpMesh.position.set(-0.6, -1.4, 0.05);
      hpMesh.userData = { type: 'polyp', name: '胃竇增生性息肉 (Hyperplastic Polyp, 0.8cm)' };
      pathologyGroup.add(hpMesh);

      // 4. Atrophic Gastritis & Intestinal Metaplasia (Plaques at Antrum)
      const metaMat = new THREE.MeshStandardMaterial({
        color: 0xe2e8f0,
        roughness: 0.6,
        emissive: 0x94a3b8,
        emissiveIntensity: 0.4
      });

      const metaPositions = [
        new THREE.Vector3(-0.1, -1.1, -0.05),
        new THREE.Vector3(-0.4, -1.25, -0.08),
        new THREE.Vector3(-0.7, -1.35, -0.04)
      ];
      metaPositions.forEach(pos => {
        const mMesh = new THREE.Mesh(new THREE.CylinderGeometry(0.12, 0.14, 0.02, 12), metaMat);
        mMesh.position.copy(pos);
        mMesh.userData = { type: 'metaplasia', name: '胃竇萎縮性胃炎伴腸化生斑塊 (Intestinal Metaplasia)' };
        pathologyGroup.add(mMesh);
      });

      // Initially hide all pathologies
      pathologyGroup.children.forEach(child => child.visible = false);
      scene.add(pathologyGroup);
    }

    // Toggle Pathology Layers
    function togglePathology(type) {
      activePathology[type] = !activePathology[type];
      const btn = document.getElementById(`btn-path-${type}`);
      if (btn) btn.classList.toggle('active', activePathology[type]);

      pathologyGroup.children.forEach(child => {
        if (child.userData && child.userData.type === type) {
          child.visible = activePathology[type];
        }
      });

      const infoEl = document.getElementById('pathology-info-text');
      if (type === 'gerd') {
        if (activePathology.gerd) {
          infoEl.innerHTML = '🔴 <strong>已顯示胃食道逆流 (GERD)</strong>：標記於 EGJ 齒狀線與賁門黏膜破損。';
          selectSegment('cardia');
        } else {
          infoEl.textContent = '已隱藏胃食道逆流病灶。';
        }
      } else if (type === 'ulcer') {
        if (activePathology.ulcer) {
          infoEl.innerHTML = '⚪ <strong>已顯示消化性潰瘍</strong>：胃角部胃潰瘍（GU）與十二指腸球部潰瘍（DU），附帶白色壞死苔與周邊充血。';
          selectSegment('antrum');
        } else {
          infoEl.textContent = '已隱藏潰瘍病灶。';
        }
      } else if (type === 'polyp') {
        if (activePathology.polyp) {
          infoEl.innerHTML = '🔴 <strong>已顯示胃息肉</strong>：胃底腺息肉 (FGPs，胃底良性小突起) 與胃竇增生性息肉。';
          selectSegment('fundus');
        } else {
          infoEl.textContent = '已隱藏胃息肉病灶。';
        }
      } else if (type === 'metaplasia') {
        if (activePathology.metaplasia) {
          infoEl.innerHTML = '⚪ <strong>已顯示慢性萎縮性胃炎與腸化生</strong>：胃竇灰白色扁平斑塊，為胃癌篩檢核心追蹤指標。';
          selectSegment('antrum');
        } else {
          infoEl.textContent = '已隱藏萎縮與腸化生病灶。';
        }
      }
    }

    // Scope Slider (0 - 65 cm)
    function onScopeSlider(val) {
      const cm = parseInt(val, 10);
      const progressT = cmToProgressT(cm);
      
      const badge = document.getElementById('txt-scope-cm');
      if (badge) badge.textContent = `${cm} cm`;

      updateGastroscopePosition(progressT);

      const statusBox = document.getElementById('scope-status-text');
      if (cm <= 25) {
        if (statusBox) statusBox.textContent = `📍 食道段 (${cm}cm)：平滑粉紅鱗狀黏膜，觀察中上段食道。`;
        updateSegmentDetailsOnly('esophagus');
      } else if (cm <= 42) {
        if (statusBox) statusBox.textContent = `📍 賁門與 EGJ (${cm}cm)：齒狀線交界，評估有無逆流性食道炎與 LES。`;
        updateSegmentDetailsOnly('cardia');
      } else if (cm <= 50) {
        if (statusBox) statusBox.textContent = `📍 胃體部與胃皺襞 (${cm}cm)：大彎波浪皺襞，排查胃體部病灶。`;
        updateSegmentDetailsOnly('body');
      } else if (cm <= 58) {
        if (statusBox) statusBox.textContent = `📍 胃竇與胃角 (${cm}cm)：胃角 V 字切跡，排查潰瘍、萎縮與幽門桿菌。`;
        updateSegmentDetailsOnly('antrum');
      } else {
        if (statusBox) statusBox.textContent = `🎯 幽門括約肌與十二指腸 (${cm}cm)：穿越幽門環，排查球部潰瘍與降部。`;
        updateSegmentDetailsOnly('pylorus');
      }
    }

    // Segment Selection
    function selectSegment(id) {
      if (isQuizMode) {
        handleQuizClick(id);
        return;
      }

      selectedId = id;
      const conf = segmentConfigs[id];
      const data = stomachData[id];
      if (!data || !conf) return;

      document.querySelectorAll('.seg-card-btn').forEach(btn => btn.classList.remove('active'));
      document.getElementById(`btn-seg-${id}`)?.classList.add('active');

      // Move glowing focus beacon to target position
      if (focusBeaconGroup && conf.targetPos) {
        new TWEEN.Tween(focusBeaconGroup.position)
          .to(conf.targetPos, 450)
          .easing(TWEEN.Easing.Cubic.Out)
          .start();
      }

      // Update scope slider to match segment position
      if (conf.cm !== undefined) {
        const cm = conf.cm;
        const slider = document.getElementById('slider-scope');
        if (slider) slider.value = cm;
        const badge = document.getElementById('txt-scope-cm');
        if (badge) badge.textContent = `${cm} cm`;
        updateGastroscopePosition(cmToProgressT(cm));
      }

      updateSegmentDetailsOnly(id);
    }

    function updateSegmentDetailsOnly(id) {
      const data = stomachData[id];
      if (!data) return;

      const pill = document.getElementById('det-pill');
      if (pill) pill.textContent = data.distance;
      document.getElementById('det-sector').textContent = data.sector;
      document.getElementById('det-title-zh').textContent = data.titleZh;
      document.getElementById('det-title-en').textContent = data.titleEn;
      document.getElementById('det-distance').textContent = data.distance;
      document.getElementById('det-function').textContent = data.function;
      document.getElementById('det-endofeature').textContent = data.endofeature;
      document.getElementById('det-disease').textContent = data.disease;
      document.getElementById('det-pearls-box').innerHTML = data.pearlsBox;
      document.getElementById('det-phrase-text').textContent = data.phrase;

      const pearlsList = document.getElementById('det-pearls-list');
      if (pearlsList) {
        pearlsList.innerHTML = '';
        data.pearls.forEach(text => {
          const item = document.createElement('div');
          item.className = 'pearl-item';
          item.innerHTML = `
            <svg width="14" height="14" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/></svg>
            <span>${text}</span>
          `;
          pearlsList.appendChild(item);
        });
      }
    }

    // Preset Views
    function setPresetView(preset) {
      document.querySelectorAll('.view-btn').forEach(b => b.classList.remove('active'));
      document.getElementById(`view-btn-${preset}`)?.classList.add('active');

      const isMobile = window.innerWidth <= 1150;
      let targetPos = new THREE.Vector3(0, isMobile ? 0.5 : 0.1, isMobile ? 9.2 : 8.8);
      let targetLook = new THREE.Vector3(0.1, isMobile ? 0.4 : 0.1, 0);

      switch(preset) {
        case 'anterior': 
          targetPos.set(0, isMobile ? 0.5 : 0.1, isMobile ? 9.2 : 8.8); 
          targetLook.set(0.1, isMobile ? 0.4 : 0.1, 0); 
          break;
        case 'jturn': 
          targetPos.set(0.6, isMobile ? -2.2 : -3.2, isMobile ? 6.2 : 5.5); 
          targetLook.set(0.4, isMobile ? 1.0 : 0.8, 0.0); 
          break;
        case 'pylorus': 
          targetPos.set(-3.5, isMobile ? -1.0 : -1.8, isMobile ? 6.5 : 5.8); 
          targetLook.set(-0.8, isMobile ? -0.4 : -1.0, 0.0); 
          break;
        case 'layers': 
          targetPos.set(5.5, isMobile ? 0.5 : 0.2, isMobile ? 6.2 : 5.5); 
          targetLook.set(0.6, isMobile ? 0.3 : 0.0, 0.0); 
          break;
        case 'duodenum': 
          targetPos.set(-5.2, isMobile ? -0.8 : -1.4, isMobile ? 5.8 : 4.8); 
          targetLook.set(-1.5, isMobile ? -0.8 : -1.5, 0.0); 
          break;
      }

      new TWEEN.Tween(camera.position).to(targetPos, 850).easing(TWEEN.Easing.Cubic.Out).start();
      new TWEEN.Tween(controls.target).to(targetLook, 850).easing(TWEEN.Easing.Cubic.Out).start();
    }

    function reset3DCamera() {
      setPresetView('anterior');
      selectSegment('body');
      showToast('已重設為正面教科書切面視角');
    }

    function onWindowResize() {
      const container = document.getElementById('threejs-canvas-container');
      if (!container || !renderer || !camera) return;
      const width = container.clientWidth;
      const height = container.clientHeight;
      if (width > 0 && height > 0) {
        camera.aspect = width / height;
        camera.updateProjectionMatrix();
        renderer.setSize(width, height);
      }
    }

    // Mobile Segmented Drawer / Tab Switching
    function switchMobileTab(tab) {
      document.querySelectorAll('.mobile-tab-btn').forEach(b => b.classList.remove('active'));
      document.getElementById(`tab-btn-${tab}`)?.classList.add('active');

      const regionsPane = document.getElementById('pane-regions-pathology');
      const detailsPane = document.getElementById('pane-clinical-details');
      const pathBox = document.querySelector('.pathology-section-box');
      const segBox = document.querySelector('.segment-grid-list');
      const segLabels = document.querySelectorAll('.left-panel .section-label');

      if (window.innerWidth <= 1150) {
        if (tab === 'regions') {
          if (regionsPane) regionsPane.style.display = 'flex';
          if (detailsPane) detailsPane.style.display = 'none';
          if (pathBox) pathBox.style.display = 'none';
          if (segBox) segBox.style.display = 'grid';
          if (segLabels[0]) segLabels[0].style.display = 'none';
          if (segLabels[1]) segLabels[1].style.display = 'block';
        } else if (tab === 'pathology') {
          if (regionsPane) regionsPane.style.display = 'flex';
          if (detailsPane) detailsPane.style.display = 'none';
          if (pathBox) pathBox.style.display = 'block';
          if (segBox) segBox.style.display = 'none';
          if (segLabels[0]) segLabels[0].style.display = 'block';
          if (segLabels[1]) segLabels[1].style.display = 'none';
        } else if (tab === 'details') {
          if (regionsPane) regionsPane.style.display = 'none';
          if (detailsPane) detailsPane.style.display = 'flex';
        }
      }
    }

    // Fullscreen Toggle
    function toggleFullScreen() {
      const wrapper = document.getElementById('stomachAppWrapper');
      if (!document.fullscreenElement) {
        if (wrapper && wrapper.requestFullscreen) {
          wrapper.requestFullscreen();
        } else if (document.documentElement.requestFullscreen) {
          document.documentElement.requestFullscreen();
        }
      } else {
        if (document.exitFullscreen) {
          document.exitFullscreen();
        }
      }
    }

    document.addEventListener('fullscreenchange', () => {
      const isFs = !!document.fullscreenElement;
      const label = document.getElementById('txt-fs-label');
      const btn = document.getElementById('btn-fullscreen-toggle');
      if (label) label.textContent = isFs ? '退出全螢幕' : '全螢幕模式';
      if (btn) btn.classList.toggle('active', isFs);
      setTimeout(onWindowResize, 150);
    });

    function onPointerDown(e) {
      const rect = renderer.domElement.getBoundingClientRect();
      mouse.x = ((e.clientX - rect.left) / rect.width) * 2 - 1;
      mouse.y = -((e.clientY - rect.top) / rect.height) * 2 + 1;

      raycaster.setFromCamera(mouse, camera);
      if (stomachMasterGroup) {
        const intersects = raycaster.intersectObjects(stomachMasterGroup.children, true);
        if (intersects.length > 0) {
          const hitPt = intersects[0].point;
          let closestId = 'body', minDist = 999;
          Object.keys(segmentConfigs).forEach(k => {
            const d = hitPt.distanceTo(segmentConfigs[k].targetPos);
            if (d < minDist) {
              minDist = d;
              closestId = k;
            }
          });
          selectSegment(closestId);
        }
      }
    }

    function onWindowResize() {
      const container = document.getElementById('threejs-canvas-container');
      if (!container || !renderer || !camera) return;
      const width = container.clientWidth;
      const height = container.clientHeight;
      if (width > 0 && height > 0) {
        camera.aspect = width / height;
        camera.updateProjectionMatrix();
        renderer.setSize(width, height);
      }
    }

    function copyPhrase() {
      const text = document.getElementById('det-phrase-text')?.textContent.trim();
      if (text) {
        navigator.clipboard.writeText(text).then(() => {
          showToast('已複製胃鏡病歷片語至剪貼簿！');
        });
      }
    }

    function showToast(msg) {
      const toast = document.getElementById('toast');
      const msgEl = document.getElementById('toast-msg');
      if (!toast || !msgEl) return;
      msgEl.textContent = msg;
      toast.classList.add('show');
      setTimeout(() => toast.classList.remove('show'), 2500);
    }

    const quizCandidates = ['esophagus', 'cardia', 'fundus', 'body', 'antrum', 'pylorus'];
    function toggleQuizMode() {
      isQuizMode = !isQuizMode;
      const btn = document.getElementById('btn-toggle-quiz');
      if (isQuizMode) {
        btn.classList.add('btn-primary');
        btn.classList.remove('btn-outline');
        btn.textContent = '結束測驗';
        nextQuizQuestion();
      } else {
        btn.classList.remove('btn-primary');
        btn.classList.add('btn-outline');
        btn.innerHTML = `
          <svg width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M9 11l3 3L22 4"/><path d="M21 12v7a2 2 0 01-2 2H5a2 2 0 01-2-2V5a2 2 0 012-2h11"/></svg>
          3D 測驗模式
        `;
        selectSegment(selectedId);
      }
    }

    function nextQuizQuestion() {
      const idx = Math.floor(Math.random() * quizCandidates.length);
      quizTarget = quizCandidates[idx];
      const data = stomachData[quizTarget];
      showToast(`🎯 請在 3D 空間中找出並點擊：【${data.titleZh}】`);
    }

    function handleQuizClick(clickedId) {
      if (clickedId === quizTarget) {
        showToast('🎉 答對了！非常優秀！');
        selectSegment(clickedId);
        setTimeout(nextQuizQuestion, 1400);
      } else {
        const clickedName = stomachData[clickedId] ? stomachData[clickedId].titleZh : clickedId;
        showToast(`❌ 答錯囉！您點到的是【${clickedName}】，旋轉一下角度再試一次！`);
      }
    }

    function animate(time) {
      requestAnimationFrame(animate);
      TWEEN.update();

      // 虛擬胃鏡第一人稱「腔內飛行巡航 (Fly-through)」
      // 臨床真實順序：先一路進鏡抵達十二指腸 (65cm) ➔ 退鏡拉回至胃體 (50cm) ➔ 執行 J-turn 倒轉仰望賁門與胃底！
      if (isFlythroughMode && gastroscopySplineCurve) {
        if (!isFlyPaused) {
          flythroughT += gastricFlySpeed * gastricSpeedMultiplier; // 平緩舒適放慢
          if (flythroughT >= 1.0) {
            flythroughT = 0.02; // 重新循環巡航
            gastricLookInitialized = false;
          }
        }

        const t = flythroughT;
        const statusText = document.getElementById('fly-status-text');
        const alertEl = document.getElementById('fly-retroflexion-alert');
        const fillEl = document.getElementById('fly-progress-fill');
        if (fillEl) fillEl.style.width = `${Math.round(t * 100)}%`;

        // 階段 1：進鏡巡航 (0.00 ~ 0.68) -> 從門齒一路深入至十二指腸降段 (65cm)
        if (t <= 0.68) {
          if (alertEl) alertEl.style.display = 'none';
          const scopeCurveT = Math.min(0.999, (t / 0.68) * 0.98);
          const pt = gastroscopySplineCurve.getPoint(scopeCurveT);
          camera.position.copy(pt);
          camera.up.set(0, 1, 0);
          if (flyEndoLight) flyEndoLight.position.copy(pt);

          const forwardCurveT = Math.min(0.999, scopeCurveT + 0.04);
          const aheadPt = gastroscopySplineCurve.getPoint(forwardCurveT);

          const cmEst = Math.round(scopeCurveT * 65);
          let locName = '食道段 (Esophagus)';
          if (cmEst >= 38 && cmEst < 44) locName = '賁門部 (Cardia / EGJ)';
          else if (cmEst >= 44 && cmEst < 54) locName = '胃體部 (Gastric Body)';
          else if (cmEst >= 54 && cmEst < 58) locName = '胃角與胃竇部 (Angulus & Antrum)';
          else if (cmEst >= 58) locName = '幽門與十二指腸 (Pylorus & Duodenum 65cm)';

          if (statusText) statusText.textContent = `胃鏡進鏡巡航 · ${locName} (${cmEst}cm)`;

          if (!gastricLookInitialized) {
            gastricCurrentLookTarget.copy(aheadPt);
            gastricLookInitialized = true;
          } else {
            gastricCurrentLookTarget.lerp(aheadPt, 0.048); // 三軸防晃濾波
          }
          camera.lookAt(gastricCurrentLookTarget);
        }
        // 階段 2：退鏡拉回胃體 (0.68 ~ 0.80) -> 從十二指腸穩步退鏡回胃體下段 (約 50cm, T=0.52)
        else if (t > 0.68 && t <= 0.80) {
          if (alertEl) alertEl.style.display = 'none';
          const pullBackRatio = (t - 0.68) / 0.12;
          const currentT = 0.98 - pullBackRatio * (0.98 - 0.52);
          const pt = gastroscopySplineCurve.getPoint(currentT);
          camera.position.copy(pt);
          camera.up.set(0, 1, 0);
          if (flyEndoLight) flyEndoLight.position.copy(pt);

          const lookPt = gastroscopySplineCurve.getPoint(Math.max(0.01, currentT - 0.03));
          if (statusText) statusText.textContent = `胃鏡退鏡中 · 拉回胃體部 (50cm) 準備執行 J-turn 倒轉`;

          gastricCurrentLookTarget.lerp(lookPt, 0.04);
          camera.lookAt(gastricCurrentLookTarget);
        }
        // 階段 3：J-turn 倒轉迴旋檢查 (0.80 ~ 0.95) -> 於胃體下段向上仰望檢視胃底穹隆 (Fundus) 與賁門 (Cardia)
        else if (t > 0.80 && t <= 0.95) {
          if (alertEl) alertEl.style.display = 'block';
          if (statusText) statusText.textContent = `🔄 胃鏡 J-turn 倒轉檢查：仰望檢視胃底穹隆 (Fundus) 與賁門 (Cardia)`;

          const jTurnBasePt = gastroscopySplineCurve.getPoint(0.52);
          camera.position.copy(jTurnBasePt);
          camera.up.set(0, 1, 0);
          if (flyEndoLight) flyEndoLight.position.copy(jTurnBasePt);

          const cardiaPos = new THREE.Vector3(-0.58, 1.38, 0.0);
          const fundusPos = new THREE.Vector3(0.55, 2.2, -0.1);
          const targetInversion = cardiaPos.clone().lerp(fundusPos, 0.35);

          gastricCurrentLookTarget.lerp(targetInversion, 0.035);
          camera.lookAt(gastricCurrentLookTarget);
        }
        // 階段 4：J-turn 完成平滑回正 (0.95 ~ 1.00)
        else {
          if (alertEl) alertEl.style.display = 'none';
          if (statusText) statusText.textContent = `J-turn 檢查完成 · 即將重新開始進鏡巡航...`;
          const returnAhead = gastroscopySplineCurve.getPoint(0.55);
          gastricCurrentLookTarget.lerp(returnAhead, 0.04);
          camera.lookAt(gastricCurrentLookTarget);
        }
      } else {
        if (controls) controls.update();
      }

      const t = (time || performance.now()) * 0.005;

      if (scopeHeadLight) {
        scopeHeadLight.intensity = 2.0 + Math.sin(t) * 0.5;
      }

      if (focusBeaconMesh) {
        focusBeaconMesh.rotation.z += 0.02;
        focusBeaconMesh.scale.setScalar(1.0 + Math.sin(t * 2) * 0.15);
      }

      if (renderer && scene && camera) {
        renderer.render(scene, camera);
      }
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', init3D);
    } else {
      init3D();
    }
  </script>
</Layout>

