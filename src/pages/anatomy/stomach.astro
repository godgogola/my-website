    // Non-linear piecewise mapping from Clinical CM (0-65cm) to Spline Progress T (0.0-1.0)
    function cmToProgressT(cm) {
      if (cm <= 0) return 0.0;
      if (cm <= 20) return (cm / 20.0) * 0.10;
      if (cm <= 40) return 0.10 + ((cm - 20) / 20.0) * 0.20; // 40cm -> 0.30 (Exact LES / Cardia)
      if (cm <= 48) return 0.30 + ((cm - 40) / 8.0) * 0.20;  // 48cm -> 0.50 (Mid Body)
      if (cm <= 55) return 0.50 + ((cm - 48) / 7.0) * 0.20;  // 55cm -> 0.70 (Antrum)
      if (cm <= 58) return 0.70 + ((cm - 55) / 3.0) * 0.10;  // 58cm -> 0.80 (Pylorus)
      if (cm <= 65) return 0.80 + ((cm - 58) / 7.0) * 0.20;  // 65cm -> 1.00 (Duodenum)
      return 1.0;
    }

