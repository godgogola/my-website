---
import Layout from '../../layouts/Layout.astro';
---

<Layout 
  title="胃部與食道 3D 互動解剖暨胃鏡巡航系統 | 互動解剖圖鑑 - 黃冠智醫師" 
  description="胃部與食道 3D 空間立體解剖系統。包含胃鏡進鏡深度模擬（0-65cm）、胃食道逆流/潰瘍/息肉/腸化生病灶標記、3D 空間立體炸開與病歷片語產生器。"
  fullWidth={true}
  hideFooter={true}
>
  <!-- Three.js CDN dependencies -->
  <script is:inline src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js"></script>
  <script is:inline src="https://cdn.jsdelivr.net/npm/three@0.128.0/examples/js/controls/OrbitControls.js"></script>
  <script is:inline src="https://cdnjs.cloudflare.com/ajax/libs/tween.js/18.6.4/tween.umd.js"></script>

  <div class="stomach-app-wrapper" id="stomachAppWrapper">
    <!-- Subheader with breadcrumb & action controls -->
    <div class="anatomy-subnav">
      <div class="subnav-left">
        <a href="/anatomy" class="back-link">
          <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path d="M19 12H5M12 19l-7-7 7-7"/></svg>
          <span>返回圖鑑總覽</span>
        </a>
        <div class="divider">/</div>
        <div class="current-badge">
          <span class="pulse-dot"></span>
          <span>胃部與食道 (Stomach & Esophagus 3D 實體模型)</span>
        </div>
      </div>
      
      <div class="subnav-right">
        <!-- Fullscreen Button -->
        <button class="btn btn-fullscreen" id="btn-fullscreen-toggle" onclick="toggleFullScreen()" title="進入/退出全螢幕診間衛教模式">
          <svg width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" id="icon-fs"><path d="M8 3H5a2 2 0 0 0-2 2v3m18 0V5a2 2 0 0 0-2-2h-3m0 18h3a2 2 0 0 0 2-2v-3M3 16v3a2 2 0 0 0 2 2h3"/></svg>
          <span id="txt-fs-label">全螢幕模式</span>
        </button>
        <button class="btn btn-outline" id="btn-toggle-quiz" onclick="toggleQuizMode()">
          <svg width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M9 11l3 3L22 4"/><path d="M21 12v7a2 2 0 01-2 2H5a2 2 0 01-2-2V5a2 2 0 012-2h11"/></svg>
          3D 測驗模式
        </button>
        <button class="btn btn-primary" onclick="reset3DCamera()">
          <svg width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M3 12a9 9 0 1 0 9-9 9.75 9.75 0 0 0-6.74 2.74L3 8"/><path d="M3 3v5h5"/></svg>
          重設視角
        </button>
      </div>
    </div>

    <!-- Main 3-Column Workspace Grid -->
    <div class="workspace-grid">
      
      <!-- Left Panel: Scope Navigation, Pathologies & Controls -->
      <div class="glass-panel left-panel">
        <div class="panel-header">
          <div class="panel-title">
            <svg width="16" height="16" fill="none" stroke="#38bdf8" stroke-width="2" viewBox="0 0 24 24"><path d="M12 2C6.5 2 3 6.5 3 12c0 3.5 2.5 7 5.5 8.5 2 .8 4.5.5 6-.5 2-1.5 3-4 3.5-7.5.5-3.5-2-10.5-6-10.5Z"/></svg>
            胃鏡巡航與病灶標記
          </div>
        </div>
        
        <div class="panel-body">
          
          <!-- Gastroscopy Scope Navigation Slider (0 - 65 cm) -->
          <div class="control-row scope-card">
            <div class="control-label-group">
              <span style="color: #38bdf8; font-weight: 800; display: flex; align-items: center; gap: 0.35rem;">
                <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><polygon points="10 8 16 12 10 16 10 8"/></svg>
                胃鏡進鏡深度 (Scope Depth)
              </span>
              <span id="txt-scope-cm" class="scope-cm-badge">0 cm</span>
            </div>
            <input type="range" id="slider-scope" min="0" max="65" value="0" step="1" oninput="onScopeSlider(this.value)">
            <div class="scope-milestones">
              <span>門齒 (0cm)</span>
              <span>賁門 (40cm)</span>
              <span>胃竇 (55cm)</span>
              <span>十二指腸 (65cm)</span>
            </div>
            <div class="scope-status-box" id="scope-status-box">
              <span class="scope-status-icon">📍</span>
              <span id="scope-status-text">內視鏡位於門齒口外，準備進入食道。</span>
            </div>
          </div>

          <!-- 4 Major Pathology Marker Toggles -->
          <div class="control-row">
            <div class="section-label" style="margin-bottom: 0.45rem;">
              常見上消化道病灶 (點擊在 3D 胃壁呈現)
            </div>
            <div class="pathology-btn-grid">
              <button class="btn btn-pathology" id="btn-path-gerd" onclick="togglePathology('gerd')">
                <span class="path-dot dot-gerd"></span>
                胃食道逆流 (GERD / 疝氣)
              </button>
              <button class="btn btn-pathology" id="btn-path-ulcer" onclick="togglePathology('ulcer')">
                <span class="path-dot dot-ulcer"></span>
                消化性潰瘍 (胃/十二指腸)
              </button>
              <button class="btn btn-pathology" id="btn-path-polyp" onclick="togglePathology('polyp')">
                <span class="path-dot dot-polyp"></span>
                胃息肉 (胃底腺/增生性)
              </button>
              <button class="btn btn-pathology" id="btn-path-metaplasia" onclick="togglePathology('metaplasia')">
                <span class="path-dot dot-metaplasia"></span>
                萎縮性胃炎與腸化生
              </button>
            </div>
            <div class="pathology-info-text" id="pathology-info-text">
              點選上方按鈕可即時切換病灶位置與臨床處置說明。
            </div>
          </div>

          <!-- 3D Explode Slider -->
          <div class="control-row">
            <div class="control-label-group">
              <span>3D 解剖部位立體炸開 (Explosion)</span>
              <span id="txt-explode-val" class="slider-val">0%</span>
            </div>
            <input type="range" id="slider-explode" min="0" max="100" value="0" oninput="onExplodeSlider(this.value)">
            <div class="slider-subtext">
              <span>0% (緊密天然連貫構造)</span>
              <span>100% (完全分離觀察)</span>
            </div>
          </div>

          <!-- Wall Opacity Slider -->
          <div class="control-row">
            <div class="control-label-group">
              <span>胃壁透明度 (Wall Opacity)</span>
              <span id="txt-opacity-val" class="slider-val">92%</span>
            </div>
            <input type="range" id="slider-opacity" min="20" max="100" value="92" oninput="onOpacitySlider(this.value)">
            <div class="slider-subtext-single">
              微調透明度可透視內部管腔走向與胃鏡發光鏡頭
            </div>
          </div>

          <!-- Segment List -->
          <div class="section-label">
            點選解剖部位 (GASTRIC REGIONS)
          </div>
          <div class="segment-grid-list">
            <div class="seg-card-btn" onclick="selectSegment('esophagus')" id="btn-seg-esophagus">
              <div class="seg-card-top">
                <span class="seg-num-pill">15~40cm</span>
                <span class="seg-loc-tag">胸腔管腔</span>
              </div>
              <div class="seg-card-name">食道與下食道括約肌 (LES)</div>
            </div>

            <div class="seg-card-btn" onclick="selectSegment('cardia')" id="btn-seg-cardia">
              <div class="seg-card-top">
                <span class="seg-num-pill">40cm (EGJ)</span>
                <span class="seg-loc-tag">胃入口/Z-line</span>
              </div>
              <div class="seg-card-name">賁門 (Cardia)</div>
            </div>

            <div class="seg-card-btn" onclick="selectSegment('fundus')" id="btn-seg-fundus">
              <div class="seg-card-top">
                <span class="seg-num-pill">J-turn 視角</span>
                <span class="seg-loc-tag">左穹隆圓頂</span>
              </div>
              <div class="seg-card-name">胃底 (Fundus)</div>
            </div>

            <div class="seg-card-btn" onclick="selectSegment('body')" id="btn-seg-body">
              <div class="seg-card-top">
                <span class="seg-num-pill">40~52cm</span>
                <span class="seg-loc-tag">胃大彎與胃小彎</span>
              </div>
              <div class="seg-card-name">胃體 (Corpus / Body)</div>
            </div>

            <div class="seg-card-btn" onclick="selectSegment('antrum')" id="btn-seg-antrum">
              <div class="seg-card-top">
                <span class="seg-num-pill">52~58cm</span>
                <span class="seg-loc-tag">胃角/幽門前區</span>
              </div>
              <div class="seg-card-name">胃竇與胃角 (Antrum)</div>
            </div>

            <div class="seg-card-btn" onclick="selectSegment('pylorus')" id="btn-seg-pylorus">
              <div class="seg-card-top">
                <span class="seg-num-pill">58~65cm</span>
                <span class="seg-loc-tag">幽門環/球部</span>
              </div>
              <div class="seg-card-name">幽門與十二指腸 (Pylorus)</div>
            </div>
          </div>

        </div>
      </div>

      <!-- Center Stage: Three.js True 3D Gastric WebGL Canvas -->
      <div class="glass-panel canvas-panel">
        <!-- Preset View Angles Toolbar -->
        <div class="view-angles-toolbar">
          <button class="view-btn active" id="view-btn-anterior" onclick="setPresetView('anterior')">正面全覽 (Coronal View)</button>
          <button class="view-btn" id="view-btn-jturn" onclick="setPresetView('jturn')">胃底 J-turn 倒轉視角 (Cardia View)</button>
          <button class="view-btn" id="view-btn-antrum" onclick="setPresetView('antrum')">胃竇與幽門切面</button>
          <button class="view-btn" id="view-btn-curvatures" onclick="setPresetView('curvatures')">胃大彎與小彎側視</button>
          <button class="view-btn" id="view-btn-duodenum" onclick="setPresetView('duodenum')">十二指腸球部視角</button>
        </div>

        <!-- ThreeJS Canvas Container -->
        <div id="threejs-canvas-container"></div>

        <!-- Orbit Controls Guidance Hint -->
        <div class="orbit-hint">
          <svg width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><path d="M12 8v8M8 12h8"/></svg>
          <span><strong>滑鼠左鍵拖曳</strong>：360° 真 3D 空間自由旋轉 ｜ <strong>滾輪</strong>：拉近縮放 ｜ <strong>滑動進鏡深度</strong>：模擬胃鏡巡航</span>
        </div>
      </div>

      <!-- Right Panel: Clinical Information & Gastroscopy Guide -->
      <div class="glass-panel right-panel">
        <div class="panel-header">
          <div class="panel-title">
            <svg width="16" height="16" fill="none" stroke="#38bdf8" stroke-width="2" viewBox="0 0 24 24"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/><polyline points="10 9 9 9 8 9"/></svg>
            胃鏡判讀與臨床指引
          </div>
        </div>
        
        <div class="panel-body" id="detail-panel">
          
          <!-- Header Title Info -->
          <div class="detail-title-group">
            <div style="display: flex; align-items: center; gap: 0.45rem; margin-bottom: 0.3rem;">
              <span id="det-pill" class="seg-badge-pill">40 ~ 52 cm</span>
              <span id="det-sector" class="sector-tag">Gastric Corpus / Rugae</span>
            </div>
            <div id="det-title-zh" class="main-title">胃體 (Corpus / Body)</div>
            <div id="det-title-en" class="sub-title">Corpus gastricum · Greater & Lesser Curvatures</div>
          </div>

          <!-- Metric Grid -->
          <div class="metric-grid">
            <div class="metric-box">
              <div class="metric-label">常規進鏡距離</div>
              <div id="det-distance" class="metric-value">40 ～ 52 cm (距門齒)</div>
            </div>
            <div class="metric-box">
              <div class="metric-label">主要分泌功能</div>
              <div id="det-function" class="metric-value">壁細胞 (胃酸/內在因子)</div>
            </div>
            <div class="metric-box">
              <div class="metric-label">解剖特徵</div>
              <div id="det-endofeature" class="metric-value">胃大彎、胃小彎、胃體部</div>
            </div>
            <div class="metric-box">
              <div class="metric-label">常見疾病好發</div>
              <div id="det-disease" class="metric-value">胃體部潰瘍、胃息肉、胃炎</div>
            </div>
          </div>

          <!-- Endoscopy Pearls -->
          <div class="surgical-pearls" id="det-pearls-box">
            <strong>胃鏡檢查重點：</strong> 胃體部為胃容積最大區域，胃大彎佈滿豐富飽滿的肌層走向。充足充氣時胃腔平滑舒張，檢查時需沿胃小彎與大彎平滑排查有無早癌或潰瘍。
          </div>

          <!-- Endoscopic Clinical Pearls -->
          <div class="detail-card">
            <h3>
              <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M12 2v20M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg>
              胃鏡判讀與衛教指引 (Clinical Pearls)
            </h3>
            <div id="det-pearls-list">
              <div class="pearl-item">
                <svg width="14" height="14" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/></svg>
                <span><strong>胃小彎與胃大彎</strong>：小彎側平滑無皺襞，為胃潰瘍與早期胃癌最易發生的區域之一。</span>
              </div>
              <div class="pearl-item">
                <svg width="14" height="14" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/></svg>
                <span><strong>壁細胞萎縮警訊</strong>：長期幽門桿菌感染可使胃體黏膜萎縮變薄，胃酸分泌低下並增加腸化生風險。</span>
              </div>
            </div>
          </div>

          <!-- Automatic Medical Phrase Generator -->
          <div class="phrase-box">
            <div class="phrase-header">
              <span class="phrase-title">胃鏡檢查報告片語 (點擊即複製)</span>
              <button class="btn btn-outline" style="padding: 0.18rem 0.5rem; font-size: 0.68rem;" onclick="copyPhrase()">複製片語</button>
            </div>
            <div id="det-phrase-text" class="phrase-content">
              Panendoscopy: Esophagus shows normal mucosa without mucosal break. Stomach shows smooth mucosal contours at body with mild superficial gastritis at antrum. CLO test: Negative.
            </div>
          </div>

        </div>
      </div>

    </div>
  </div>

  <!-- Toast Notification -->
  <div id="toast">
    <svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path d="M20 6L9 17l-5-5"/></svg>
    <span id="toast-msg">已複製片語至剪貼簿！</span>
  </div>

  <script is:inline>
    // Stomach & Upper GI Anatomical Knowledge Database
    const stomachData = {
      esophagus: {
        titleZh: '食道與下食道括約肌 (Esophagus & LES)',
        titleEn: 'Esophagus & Sphincter esophageus inferior',
        distance: '15 ～ 40 cm (距門齒)',
        function: '推進食團，防止胃酸逆流 (LES 靜止高壓帶)',
        endofeature: '淡粉紅鱗狀上皮 (Squamous epithelium)',
        disease: '胃食道逆流 (GERD)、食道潰瘍、巴瑞特氏食道 (Barrett\'s)、食道靜脈曲張',
        sector: 'Thorax & Mediastinum',
        pearlsBox: '<strong>胃鏡檢查重點：</strong> 食道全長約 25 cm，管壁呈平滑粉白色鱗狀上皮。在約 38~40 cm 處與胃柱狀黏膜交會形成 <strong>齒狀線 (Z-line / EGJ)</strong>。下食道括約肌 (LES) 鬆弛是胃食道逆流與食道裂孔疝氣之核心機轉。',
        pearls: [
          '<strong>洛杉磯分類 (LA Classification)</strong>：依食道黏膜破損長度與融合範圍評估逆流嚴重度（Grade A 到 D）。',
          '<strong>巴瑞特氏食道 (Barrett\'s Esophagus)</strong>：長期胃酸逆流刺激使鱗狀上皮轉變為特化柱狀上皮，為食道腺癌之癌前病變。'
        ],
        phrase: 'Panendoscopy: Esophagus shows lower third mucosal breaks (< 5mm, non-confluent), compatible with Reflux Esophagitis, LA Grade A.'
      },
      cardia: {
        titleZh: '賁門 (Cardia & EGJ)',
        titleEn: 'Cardia & Gastroesophageal Junction',
        distance: '38 ～ 40 cm (距門齒)',
        function: '食物進入胃部之閘門，防止胃內容物反流',
        endofeature: '齒狀線 (Z-line) 紅白黏膜交界線',
        disease: '賁門失弛緩症 (Achalasia)、食道裂孔疝氣 (Hiatal Hernia)、賁門癌',
        sector: 'Diaphragmatic Hiatus',
        pearlsBox: '<strong>胃鏡檢查重點：</strong> 胃鏡進入胃部後，必須於胃底進行 <strong>J-turn 倒轉觀察（Retroflexion view）</strong>，直接近距離檢視「賁門周圍緊縮度（Flap valve grading）」與有無食道裂孔疝氣囊袋。',
        pearls: [
          '<strong>Hill 賁門瓣分級 (Grade I~IV)</strong>：評估賁門貼合鏡身的緊密度，Grade III~IV 常伴隨嚴重胃酸逆流與裂孔疝氣。',
          '<strong>撕裂傷 (Mallory-Weiss tear)</strong>：劇烈劇吐後常在此交界處引發黏膜縱向撕裂大出血。'
        ],
        phrase: 'Panendoscopy: Retroflexion view shows lax cardia with sliding hiatal hernia (approx. 2cm), Hill Grade III.'
      },
      fundus: {
        titleZh: '胃底 (Gastric Fundus)',
        titleEn: 'Fundus gastricus',
        distance: '40 ～ 45 cm (J-turn 倒轉視野)',
        function: '貯存進食吞入之氣體（胃泡）與容受性舒張',
        endofeature: '左側穹隆頂部，覆蓋薄黏膜與黏液湖',
        disease: '胃底腺息肉 (FGPs)、胃靜脈曲張 (Gastric varices)、黏膜下腫瘤 (GIST)',
        sector: 'Left Subdiaphragmatic Dome',
        pearlsBox: '<strong>胃鏡檢查重點：</strong> 位於左側橫膈穹隆下方，為倒轉觀察（J-turn）之主要視野。若有肝硬化門脈高壓，此處易形成危險性極高的 <strong>胃底靜脈曲張 (Gastric varices)</strong>。',
        pearls: [
          '<strong>胃底腺息肉 (Fundic Gland Polyps, FGPs)</strong>：臨床最常見良性胃息肉（多小於 0.5cm，半透明），常與長期服用 PPI 抑制胃酸相關，惡性機率極低。',
          '<strong>胃基質瘤好發 (GIST)</strong>：胃底常偶發平滑凸起之上皮下腫瘤（Subepithelial lesion）。'
        ],
        phrase: 'Panendoscopy: Multiple tiny fundic gland polyps (0.2-0.4cm) noted at gastric fundus, benign appearance.'
      },
      body: {
        titleZh: '胃體 (Corpus / Body)',
        titleEn: 'Corpus gastricum',
        distance: '40 ～ 52 cm (距門齒)',
        function: '分泌胃酸 (HCl) 與胃蛋白酶原，進行食物混合研磨',
        endofeature: '胃大彎與胃小彎平滑肌層',
        disease: '胃體部潰瘍、胃息肉、自身免疫性胃炎、胃癌',
        sector: 'Mid Gastric Region',
        pearlsBox: '<strong>胃鏡檢查重點：</strong> 胃體部為胃容積最大區域，胃大彎走向寬廣。胃小彎側則為胃潰瘍好發處，需仔細觀察黏膜色澤與微細血管排列。',
        pearls: [
          '<strong>胃小彎 (Lesser Curvature)</strong>：血流灌注相對薄弱，胃酸侵蝕時極易形成深度潰瘍。',
          '<strong>萎縮性變化</strong>：長期幽門桿菌感染可使胃體黏膜萎縮變薄，胃酸分泌低下並增加腸化生風險。'
        ],
        phrase: 'Panendoscopy: Gastric body shows regular mucosal architecture with no active ulceration or mass.'
