---
import Layout from '../../layouts/Layout.astro';
---

<Layout 
  title="胃部與食道 3D 互動解剖暨胃鏡巡航系統 | 互動解剖圖鑑 - 黃冠智醫師" 
  description="教科書級 3D 胃部解剖實體模型。展現胃底穹隆、胃體大彎小彎、立體胃皺襞 (Rugae)、幽門括約肌與胃鏡進鏡巡航模擬。"
  fullWidth={true}
  hideFooter={true}
>
  <!-- Three.js CDN dependencies -->
  <script is:inline src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js"></script>
  <script is:inline src="https://cdn.jsdelivr.net/npm/three@0.128.0/examples/js/controls/OrbitControls.js"></script>
  <script is:inline src="https://cdnjs.cloudflare.com/ajax/libs/tween.js/18.6.4/tween.umd.js"></script>

  <div class="stomach-app-wrapper" id="stomachAppWrapper">
    <!-- Subheader with breadcrumb & action controls -->
    <div class="anatomy-subnav">
      <div class="subnav-left">
        <a href="/anatomy" class="back-link">
          <svg width="15" height="15" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path d="M19 12H5M12 19l-7-7 7-7"/></svg>
          <span>圖鑑總覽</span>
        </a>
        <div class="divider">/</div>
        <div class="current-badge">
          <span class="pulse-dot"></span>
          <span>胃部與食道 (3D 解剖模型)</span>
        </div>
      </div>
      
      <div class="subnav-right">
        <!-- 胃鏡直通大腸鏡快捷切換按鈕 -->
        <a href="/anatomy/colon" class="btn btn-switch-endo" title="快速切換至大腸鏡 3D 巡航解剖">
          <span class="endo-icon">🩺</span>
          <span class="btn-text-prefix">切換至</span>
          <span>大腸鏡</span>
          <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
        </a>

        <!-- Fullscreen Button -->
        <button class="btn btn-fullscreen" id="btn-fullscreen-toggle" onclick="toggleFullScreen()" title="進入/退出全螢幕診間衛教模式">
          <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" id="icon-fs"><path d="M8 3H5a2 2 0 0 0-2 2v3m18 0V5a2 2 0 0 0-2-2h-3m0 18h3a2 2 0 0 0 2-2v-3M3 16v3a2 2 0 0 0 2 2h3"/></svg>
          <span class="btn-text-full">全螢幕</span>
        </button>
        <button class="btn btn-outline" id="btn-toggle-quiz" onclick="toggleQuizMode()">
          <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M9 11l3 3L22 4"/><path d="M21 12v7a2 2 0 01-2 2H5a2 2 0 01-2-2V5a2 2 0 012-2h11"/></svg>
          <span class="btn-text-full">3D 測驗</span>
        </button>
        <button class="btn btn-primary" onclick="reset3DCamera()">
          <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M3 12a9 9 0 1 0 9-9 9.75 9.75 0 0 0-6.74 2.74L3 8"/><path d="M3 3v5h5"/></svg>
          <span>重設</span>
        </button>
      </div>
    </div>

    <!-- Main 3-Column Workspace Grid -->
    <div class="workspace-grid">

      <!-- Mobile Tab Switcher Navigation (Only shown on mobile for seamless panel switching) -->
      <div class="mobile-tabs-nav">
        <button class="mobile-tab-btn active" id="tab-btn-regions" onclick="switchMobileTab('regions')">
          📍 6大部位
        </button>
        <button class="mobile-tab-btn" id="tab-btn-pathology" onclick="switchMobileTab('pathology')">
          🩺 4大病灶
        </button>
        <button class="mobile-tab-btn" id="tab-btn-details" onclick="switchMobileTab('details')">
          📋 門診片語
        </button>
      </div>

      <!-- Left Panel: Pathologies & Gastric Regions (Placed in Column 1 on Desktop) -->
      <div class="glass-panel left-panel mobile-tab-pane" id="pane-regions-pathology">
        <div class="panel-header">
          <div class="panel-title">
            <svg width="16" height="16" fill="none" stroke="#38bdf8" stroke-width="2" viewBox="0 0 24 24"><path d="M12 2C6.5 2 3 6.5 3 12c0 3.5 2.5 7 5.5 8.5 2 .8 4.5.5 6-.5 2-1.5 3-4 3.5-7.5.5-3.5-2-10.5-6-10.5Z"/></svg>
            胃部解剖部位與常見病灶
          </div>
        </div>
        
        <div class="panel-body">
          <!-- 4 Major Pathology Marker Toggles (Decluttered) -->
          <div class="control-row pathology-section-box">
            <div class="section-label">常見病灶標記</div>
            <div class="pathology-btn-grid">
              <button class="btn btn-pathology" id="btn-path-gerd" onclick="togglePathology('gerd')">
                <span class="path-dot dot-gerd"></span>胃食道逆流 (GERD)
              </button>
              <button class="btn btn-pathology" id="btn-path-ulcer" onclick="togglePathology('ulcer')">
                <span class="path-dot dot-ulcer"></span>消化性潰瘍 (GU/DU)
              </button>
              <button class="btn btn-pathology" id="btn-path-polyp" onclick="togglePathology('polyp')">
                <span class="path-dot dot-polyp"></span>胃息肉 (FGPs/增生)
              </button>
              <button class="btn btn-pathology" id="btn-path-metaplasia" onclick="togglePathology('metaplasia')">
                <span class="path-dot dot-metaplasia"></span>萎縮性胃炎/腸化生
              </button>
            </div>
          </div>

          <!-- Segment List (Clean, Layout does the explaining) -->
          <div class="section-label" style="margin-top: 0.6rem;">解剖分段檢視</div>
          <div class="segment-grid-list">
            <div class="seg-card-btn" onclick="selectSegment('esophagus')" id="btn-seg-esophagus">
              <span class="seg-num-pill">15~40cm</span>
              <div class="seg-card-name">食道與下食道括約肌</div>
            </div>

            <div class="seg-card-btn" onclick="selectSegment('cardia')" id="btn-seg-cardia">
              <span class="seg-num-pill">40cm (EGJ)</span>
              <div class="seg-card-name">賁門 (Cardia)</div>
            </div>

            <div class="seg-card-btn" onclick="selectSegment('fundus')" id="btn-seg-fundus">
              <span class="seg-num-pill">J-turn 視角</span>
              <div class="seg-card-name">胃底穹隆 (Fundus)</div>
            </div>

            <div class="seg-card-btn" onclick="selectSegment('body')" id="btn-seg-body">
              <span class="seg-num-pill">40~52cm</span>
              <div class="seg-card-name">胃體與胃皺襞 (Body)</div>
            </div>

            <div class="seg-card-btn" onclick="selectSegment('antrum')" id="btn-seg-antrum">
              <span class="seg-num-pill">52~58cm</span>
              <div class="seg-card-name">胃竇與胃角 (Antrum)</div>
            </div>

            <div class="seg-card-btn" onclick="selectSegment('pylorus')" id="btn-seg-pylorus">
              <span class="seg-num-pill">58~65cm</span>
              <div class="seg-card-name">幽門與十二指腸</div>
            </div>
          </div>
        </div>
      </div>

      <!-- Center 3D Stage (Center Column on Desktop) -->
      <div class="glass-panel canvas-panel">
        <!-- Preset View Angles Floating Bar -->
        <div class="view-angles-toolbar">
          <button class="view-btn active" onclick="setPresetView('anterior')" id="view-btn-anterior">正面剖切</button>
          <button class="view-btn flythrough-btn" id="btn-flythrough" onclick="toggleGastricFlythrough()" style="background: linear-gradient(135deg, #0ea5e9, #0284c7); color: #ffffff; border-color: #38bdf8; font-weight: 800;">🚀 胃鏡腔內巡航 (含 J-turn)</button>
          <button class="view-btn" onclick="setPresetView('jturn')" id="view-btn-jturn">胃底 J-turn</button>
          <button class="view-btn" onclick="setPresetView('pylorus')" id="view-btn-pylorus">胃竇幽門</button>
          <button class="view-btn" onclick="setPresetView('layers')" id="view-btn-layers">大彎層次</button>
          <button class="view-btn" onclick="setPresetView('duodenum')" id="view-btn-duodenum">十二指腸球部</button>
        </div>

        <div id="threejs-canvas-container"></div>
        
        <!-- 3D Orbit Interaction Hint (Top Right) -->
        <div class="orbit-hint hide-mobile">
          <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><path d="M12 8v8M8 12h8"/></svg>
          <span>360° 空間旋轉 · 滾輪縮放</span>
        </div>

        <!-- 第一人稱胃鏡腔內飛行巡航 HUD 懸浮視窗 -->
        <div class="flythrough-hud-overlay" id="gastric-flythrough-hud" style="display: none;">
          <div class="fly-top-badge">
            <div class="fly-indicator-pulse"></div>
            <span id="fly-status-text">胃鏡腔內飛行巡航進行中 · 食道段 (25cm)</span>
          </div>
          <div class="fly-retroflexion-alert" id="fly-retroflexion-alert" style="display: none;">
            🔄 胃鏡 J-turn 倒轉迴旋檢查 (Inversion View) · 仰望檢視胃底穹隆與賁門黏膜
          </div>
          <div class="fly-bottom-controls">
            <button class="fly-ctrl-btn" id="btn-fly-pause" onclick="toggleFlyPause()">⏸ 暫停</button>
            <button class="fly-ctrl-btn" id="btn-gastric-fly-speed" onclick="cycleGastricFlySpeed()" title="切換巡航速度">速度: 1.0x</button>
            <div class="fly-progress-bar-wrap">
              <div class="fly-progress-fill" id="fly-progress-fill" style="width: 10%;"></div>
            </div>
            <button class="fly-exit-btn" onclick="exitGastricFlythrough()">⏹ 退出巡航 (回到 3D)</button>
          </div>
        </div>

        <!-- 整合式底部控制容器：Mode Tabs 位於頂端自然流式排列，絕對不壓在滑桿上 -->
        <div class="canvas-controls-container" id="canvas-controls-container">
          <div class="canvas-mode-tabs-bar">
            <div class="canvas-mode-tabs">
              <button class="mode-tab-btn active" id="tab-btn-scope" onclick="switchStomachControlTab('scope')">🔭 胃鏡推進深度</button>
              <button class="mode-tab-btn" id="tab-btn-progression" onclick="switchStomachControlTab('progression')">🩺 胃黏膜時序演變</button>
            </div>
          </div>

          <!-- Scope Slider Control Bar (0 ~ 70cm, 含 J-turn 倒轉刻度) -->
          <div class="canvas-scope-bar" id="canvas-scope-bar">
            <div class="control-row scope-card" style="margin-bottom: 0;">
              <div class="control-label-group">
                <span style="color: #38bdf8; font-weight: 800; display: flex; align-items: center; gap: 0.35rem;">
                  <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><polygon points="10 8 16 12 10 16 10 8"/></svg>
                  胃鏡進鏡深度 (Scope Depth)
                </span>
                <span id="txt-scope-cm" class="scope-cm-badge">0 cm</span>
              </div>
              <input type="range" id="slider-scope" min="0" max="70" value="0" step="1" oninput="onScopeSlider(this.value)">
              <div class="scope-milestones">
                <span>門齒 (0cm)</span>
                <span>賁門 (40cm)</span>
                <span>胃竇 (55cm)</span>
                <span>十二指腸 (65cm)</span>
                <span style="color: #f43f5e; font-weight: 800;">🔄 J-turn (70cm)</span>
              </div>
              <div class="scope-status-box" id="scope-status-box">
                <span class="scope-status-icon">📍</span>
                <span id="scope-status-text">內視鏡位於門齒口外，準備進入食道。</span>
              </div>
            </div>
          </div>

          <!-- 胃黏膜病變 4 階段控制卡片 (Disease Progression Slider) -->
          <div class="canvas-progression-bar" id="canvas-gastric-progression-bar" style="display: none;">
            <div class="prog-header">
              <div class="prog-title-group">
                <span class="prog-badge">臨床時序</span>
                <span class="prog-main-title">胃黏膜病變演變時序 (Correa 多步驟致癌機轉)</span>
              </div>
              <button class="prog-autoplay-btn" id="btn-gastric-autoplay" onclick="toggleGastricAutoplay()" title="自動播放病情演變過程">
                <span id="gastric-play-icon">▶</span>
                <span id="gastric-play-text">自動演變</span>
              </button>
            </div>

            <!-- 4 階段快捷切換按鈕 -->
            <div class="steatosis-stage-pills">
              <button class="stage-pill active" data-stage="0" onclick="setGastricProgressionStage(0)">
                <span class="pill-dot stage-0"></span>正常胃黏膜
              </button>
              <button class="stage-pill" data-stage="1" onclick="setGastricProgressionStage(1)">
                <span class="pill-dot stage-1"></span>表淺性胃炎
              </button>
              <button class="stage-pill" data-stage="2" onclick="setGastricProgressionStage(2)">
                <span class="pill-dot stage-2"></span>萎縮性胃炎/腸化生
              </button>
              <button class="stage-pill" data-stage="3" onclick="setGastricProgressionStage(3)">
                <span class="pill-dot stage-3"></span>早期胃癌 (Paris 0-IIc)
              </button>
            </div>

            <!-- 進展滑桿 -->
            <div class="prog-slider-wrapper">
              <input type="range" id="slider-gastric-prog" min="0" max="3" step="1" value="0" oninput="setGastricProgressionStage(parseInt(this.value))">
              <div class="prog-slider-milestones">
                <span>正常健康粉紅</span>
                <span>潮紅充血斑塊</span>
                <span>蒼白變薄化生</span>
                <span>惡性潰瘍糜爛</span>
              </div>
            </div>

            <!-- 臨床衛教與處置建議卡 -->
            <div class="prog-clinical-card" id="gastric-clinical-card">
              <!-- 動態填入 -->
            </div>
          </div>
        </div>
      </div>

      <!-- Right Panel: Clinical Information & Gastroscopy Guide (Placed in Right Column on Desktop) -->
      <div class="glass-panel right-panel mobile-tab-pane" id="pane-clinical-details">
        <div class="panel-header">
          <div class="panel-title">
            <svg width="16" height="16" fill="none" stroke="#38bdf8" stroke-width="2" viewBox="0 0 24 24"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/><polyline points="10 9 9 9 8 9"/></svg>
            胃鏡判讀與臨床指引
          </div>
        </div>
        
        <div class="panel-body" id="detail-panel">
          
          <!-- Header Title Info -->
          <div class="detail-title-group">
            <div style="display: flex; align-items: center; gap: 0.45rem; margin-bottom: 0.3rem;">
              <span id="det-pill" class="seg-badge-pill">40 ~ 52 cm</span>
              <span id="det-sector" class="sector-tag">Gastric Corpus / Rugae</span>
            </div>
            <div id="det-title-zh" class="main-title">胃體與胃皺襞 (Body & Rugae)</div>
            <div id="det-title-en" class="sub-title">Corpus gastricum · Greater Curvature · Gastric Rugae</div>
          </div>

          <!-- Metric Grid -->
          <div class="metric-grid">
            <div class="metric-box">
              <div class="metric-label">常規進鏡距離</div>
              <div id="det-distance" class="metric-value">40 ～ 52 cm (距門齒)</div>
            </div>
            <div class="metric-box">
              <div class="metric-label">主要黏膜特徵</div>
              <div id="det-function" class="metric-value">豐富縱向波浪狀胃皺襞 (Rugae)</div>
            </div>
            <div class="metric-box">
              <div class="metric-label">解剖構造</div>
              <div id="det-endofeature" class="metric-value">胃大彎 (Greater)、胃小彎 (Lesser)</div>
            </div>
            <div class="metric-box">
              <div class="metric-label">常見疾病好發</div>
              <div id="det-disease" class="metric-value">胃體潰瘍、胃息肉、慢性萎縮性胃炎</div>
            </div>
          </div>

          <!-- Endoscopy Pearls -->
          <div class="surgical-pearls" id="det-pearls-box">
            <strong>胃鏡檢查重點：</strong> 胃體部黏膜具有豐富的縱向波浪狀 <strong>胃皺襞 (Gastric Rugae)</strong>。充氣時皺襞舒展開闊，胃鏡退鏡時需沿著小彎（平滑區）與大彎（皺襞區）做 360° 全面排查。
          </div>

          <!-- Endoscopic Clinical Pearls -->
          <div class="detail-card">
            <h3>
              <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M12 2v20M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg>
              胃鏡判讀與衛教指引 (Clinical Pearls)
            </h3>
            <div id="det-pearls-list">
              <div class="pearl-item">
                <svg width="14" height="14" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/></svg>
                <span><strong>胃小彎與胃大彎</strong>：小彎側黏膜薄且平滑，血流分佈相對敏感，為良性胃潰瘍與早期胃癌最易發生的區域之一。</span>
              </div>
              <div class="pearl-item">
                <svg width="14" height="14" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/></svg>
                <span><strong>胃皺襞肥大或消失</strong>：幽門桿菌感染或萎縮性胃炎會造成皺襞變平（萎縮），而梅內特里耶病（Menetrier\'s disease）則會造成極度肥厚巨大皺襞。</span>
              </div>
            </div>
          </div>

          <!-- Automatic Medical Phrase Generator -->
          <div class="phrase-box">
            <div class="phrase-header">
              <span class="phrase-title">胃鏡檢查報告片語 (點擊即複製)</span>
              <button class="btn btn-outline" style="padding: 0.18rem 0.5rem; font-size: 0.68rem;" onclick="copyPhrase()">複製片語</button>
            </div>
            <div id="det-phrase-text" class="phrase-content">
              Panendoscopy: Stomach shows prominent normal gastric rugae at greater curvature. Lesser curvature is smooth without active ulceration or suspicious neoplastic lesion.
            </div>
          </div>

        </div>
      </div>

    </div>
  </div>

  <!-- Toast Notification -->
  <div id="toast">
    <svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path d="M20 6L9 17l-5-5"/></svg>
    <span id="toast-msg">已複製片語至剪貼簿！</span>
  </div>

  <script is:inline>
    // Stomach & Upper GI Anatomical Knowledge Database
    const stomachData = {
      esophagus: {
        titleZh: '食道與下食道括約肌 (Esophagus & LES)',
        titleEn: 'Esophagus & Sphincter esophageus inferior',
        distance: '15 ～ 40 cm (距門齒)',
        function: '推進食團，LES 高壓帶防止胃酸反流',
        endofeature: '淡粉紅平滑鱗狀上皮 (Squamous epithelium)',
        disease: '胃食道逆流 (GERD)、食道裂孔疝氣、巴瑞特氏食道 (Barrett\'s)、食道潰瘍',
        sector: 'Thorax & Mediastinum',
        pearlsBox: '<strong>胃鏡檢查重點：</strong> 食道自咽喉向下延伸約 25cm，在約 38~40cm 處與胃柱狀黏膜交會形成 <strong>齒狀線 (Z-line / EGJ)</strong>。管腔末端為環形增厚的 <strong>下食道括約肌 (LES)</strong>。',
        pearls: [
          '<strong>洛杉磯分類 (LA Classification)</strong>：依食道黏膜破損長度與融合範圍評估逆流嚴重度（Grade A 到 D）。',
          '<strong>巴瑞特氏食道 (Barrett\'s Esophagus)</strong>：長期胃酸逆流刺激使鱗狀上皮轉變為特化柱狀上皮，為食道腺癌之癌前病變。'
        ],
        phrase: 'Panendoscopy: Esophagus shows lower third mucosal breaks (< 5mm, non-confluent), compatible with Reflux Esophagitis, LA Grade A.'
      },
      cardia: {
        titleZh: '賁門 (Cardia & EGJ)',
        titleEn: 'Cardia & Gastroesophageal Junction',
        distance: '38 ～ 40 cm (距門齒)',
        function: '食物進入胃腔之門戶，防止胃內容物逆衝',
        endofeature: '齒狀線 (Z-line) 紅白黏膜交界交會處',
        disease: '賁門失弛緩症 (Achalasia)、食道裂孔疝氣 (Hiatal Hernia)、賁門癌',
        sector: 'Diaphragmatic Hiatus',
