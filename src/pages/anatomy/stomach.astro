    // Parametric Full 360° Closed Tube Generator
    function createSmoothClosedTube(points, rStart, rEnd, radialSegs = 20) {
      const curve = new THREE.CatmullRomCurve3(points);
      const numRings = 24;
      const positions = [];
      const normals = [];
      const uvs = [];
      const indices = [];

      for (let i = 0; i <= numRings; i++) {
        const u = i / numRings;
        const pt = curve.getPoint(u);
        const tangent = curve.getTangent(u).normalize();
        const r = rStart + u * (rEnd - rStart);

        let normalVec = new THREE.Vector3(0, 0, 1).cross(tangent).normalize();
        if (normalVec.lengthSq() < 0.01) normalVec = new THREE.Vector3(1, 0, 0).cross(tangent).normalize();
        const binormalVec = new THREE.Vector3().crossVectors(tangent, normalVec).normalize();

        for (let j = 0; j <= radialSegs; j++) {
          const v = j / radialSegs;
          const theta = v * Math.PI * 2;

          const cx = Math.cos(theta) * r;
          const cy = Math.sin(theta) * r;

          const vx = pt.x + normalVec.x * cx + binormalVec.x * cy;
          const vy = pt.y + normalVec.y * cx + binormalVec.y * cy;
          const vz = pt.z + normalVec.z * cx + binormalVec.z * cy;

          positions.push(vx, vy, vz);
          uvs.push(u, v);
        }
      }

      for (let i = 0; i < numRings; i++) {
        for (let j = 0; j < radialSegs; j++) {
          const a = i * (radialSegs + 1) + j;
          const b = (i + 1) * (radialSegs + 1) + j;
          const c = (i + 1) * (radialSegs + 1) + (j + 1);
          const d = i * (radialSegs + 1) + (j + 1);

          indices.push(a, b, d);
          indices.push(b, c, d);
        }
      }

      const geom = new THREE.BufferGeometry();
      geom.setAttribute('position', new THREE.Float32BufferAttribute(positions, 3));
      geom.setAttribute('uv', new THREE.Float32BufferAttribute(uvs, 2));
      geom.setIndex(indices);
      geom.computeVertexNormals();
      return geom;
    }

    // Fundus Full Closed Dome
    function createSeamlessFundusGeometry() {
      const geom = new THREE.SphereGeometry(0.85, 28, 24);
      geom.scale(1.15, 0.92, 0.95);
      geom.translate(1.05, 0.65, 0.0);
      geom.computeVertexNormals();
      return geom;
    }

    // Corpus / Body Full Continuous 3D Volume
    function createSeamlessCorpusGeometry() {
      const numU = 32, numV = 24;
      const positions = [];
      const uvs = [];
      const indices = [];

      for (let i = 0; i <= numU; i++) {
        const u = i / numU;
        const y = 0.45 - u * 1.3;
        
        const centerX = 0.4 + Math.sin(u * Math.PI) * 0.35;
        const radiusX = 0.68 + Math.sin(u * Math.PI) * 0.38;
        const radiusY = 0.58 + Math.sin(u * Math.PI) * 0.28;

        for (let j = 0; j <= numV; j++) {
          const v = j / numV;
          const theta = v * Math.PI * 2.0;

          let rx = radiusX * Math.cos(theta);
          let rz = radiusY * Math.sin(theta);

          const vx = centerX + rx;
          const vy = y;
          const vz = rz;

          positions.push(vx, vy, vz);
          uvs.push(u, v);
        }
      }

      for (let i = 0; i < numU; i++) {
        for (let j = 0; j < numV; j++) {
          const a = i * (numV + 1) + j;
          const b = (i + 1) * (numV + 1) + j;
          const c = (i + 1) * (numV + 1) + (j + 1);
          const d = i * (numV + 1) + (j + 1);

          indices.push(a, b, d);
          indices.push(b, c, d);
        }
      }

      const geom = new THREE.BufferGeometry();
      geom.setAttribute('position', new THREE.Float32BufferAttribute(positions, 3));
      geom.setAttribute('uv', new THREE.Float32BufferAttribute(uvs, 2));
      geom.setIndex(indices);
      geom.computeVertexNormals();
      return geom;
    }

    // Dynamic Auto-Fitting Billboard Text Sprite Generator (100% inside borders!)
    function createTextSprite(text, accentColor = '#38bdf8') {
      const canvas = document.createElement('canvas');
      canvas.width = 512;
      canvas.height = 140;
      const ctx = canvas.getContext('2d');

      ctx.font = 'bold 36px -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Noto Sans TC", sans-serif';
      const textWidth = ctx.measureText(text).width;

      const pillWidth = Math.min(480, Math.max(160, textWidth + 64));
      const pillHeight = 72;
      const x = (canvas.width - pillWidth) / 2;
      const y = (canvas.height - pillHeight) / 2;

      // Draw pill background
      ctx.fillStyle = 'rgba(10, 20, 36, 0.92)';
      ctx.beginPath();
      ctx.roundRect(x, y, pillWidth, pillHeight, 36);
      ctx.fill();

      // Draw crisp border
      ctx.strokeStyle = accentColor;
      ctx.lineWidth = 4;
      ctx.stroke();

      // Draw centered text
      ctx.fillStyle = '#ffffff';
      ctx.textAlign = 'center';
      ctx.textBaseline = 'middle';
      ctx.fillText(text, canvas.width / 2, canvas.height / 2);

      const texture = new THREE.CanvasTexture(canvas);
      texture.minFilter = THREE.LinearFilter;
      const spriteMat = new THREE.SpriteMaterial({ map: texture, transparent: true, depthTest: false });
      const sprite = new THREE.Sprite(spriteMat);
      sprite.scale.set(1.3 * (pillWidth / 250), 0.65, 1);
      return sprite;
    }

    // Build 3D Gastroscope (Flexible black scope with bright LED optic beam)
    function build3DGastroscope() {
      scopeGroup = new THREE.Group();

      const tipGeom = new THREE.SphereGeometry(0.1, 16, 16);
      const tipMat = new THREE.MeshBasicMaterial({ color: 0x00e5ff });
      scopeTipMesh = new THREE.Mesh(tipGeom, tipMat);
      scopeGroup.add(scopeTipMesh);

      const coneGeom = new THREE.ConeGeometry(0.35, 0.75, 16, 1, true);
      coneGeom.translate(0, 0.38, 0);
      coneGeom.rotateX(Math.PI / 2);
      const coneMat = new THREE.MeshBasicMaterial({
        color: 0x38bdf8,
        transparent: true,
        opacity: 0.45,
        side: THREE.DoubleSide
      });
      const lightBeamMesh = new THREE.Mesh(coneGeom, coneMat);
      scopeTipMesh.add(lightBeamMesh);

      scopeHeadLight = new THREE.PointLight(0x00e5ff, 2.5, 3.5);
      scopeGroup.add(scopeHeadLight);

      scene.add(scopeGroup);
    }

    function updateGastroscopePosition(progressT) {
      if (!gastroscopySplineCurve || !scopeGroup) return;

      const tClamped = Math.max(0.001, Math.min(0.999, progressT));
      const pt = gastroscopySplineCurve.getPoint(tClamped);
      const tangent = gastroscopySplineCurve.getTangent(tClamped).normalize();

      scopeGroup.position.copy(pt);
      scopeTipMesh.quaternion.setFromUnitVectors(new THREE.Vector3(0, 0, 1), tangent);

      if (scopeTubeMesh) scene.remove(scopeTubeMesh);

      const numPoints = Math.max(8, Math.floor(tClamped * 45));
      const subPoints = [];
      for (let i = 0; i <= numPoints; i++) {
        subPoints.push(gastroscopySplineCurve.getPoint((i / numPoints) * tClamped));
      }

      if (subPoints.length >= 2) {
        const subCurve = new THREE.CatmullRomCurve3(subPoints);
        const tubeGeom = new THREE.TubeGeometry(subCurve, numPoints * 2, 0.075, 10, false);
        const tubeMat = new THREE.MeshStandardMaterial({
          color: 0x111827,
          roughness: 0.2,
          metalness: 0.8
        });
        scopeTubeMesh = new THREE.Mesh(tubeGeom, tubeMat);
        scene.add(scopeTubeMesh);
      }
    }

