        pearlsBox: '<strong>胃鏡檢查重點：</strong> 胃鏡進入胃部後，必須於胃底進行 <strong>J-turn 倒轉觀察（Retroflexion view）</strong>，直接近距離檢視「賁門周圍緊縮度（Flap valve grading）」與有無食道裂孔疝氣囊袋。',
        pearls: [
          '<strong>Hill 賁門瓣分級 (Grade I~IV)</strong>：評估賁門貼合鏡身的緊密度，Grade III~IV 常伴隨嚴重胃酸逆流與裂孔疝氣。',
          '<strong>撕裂傷 (Mallory-Weiss tear)</strong>：劇烈嘔吐後常在此交界處引發黏膜縱向撕裂大出血。'
        ],
        phrase: 'Panendoscopy: Retroflexion view shows lax cardia with sliding hiatal hernia (approx. 2cm), Hill Grade III.'
      },
      fundus: {
        titleZh: '胃底 (Gastric Fundus)',
        titleEn: 'Fundus gastricus',
        distance: '40 ～ 45 cm (J-turn 倒轉視野)',
