<script>
  // 抽屜開關與全域事件監聽
  function setupObsidianCard() {
    const card = document.getElementById('dr-huang-obsidian-card');
    const openBtn = document.getElementById('btn-open-drawer');
    const closeBtn = document.getElementById('btn-close-drawer');
    const backBtn = document.getElementById('btn-back-drawer');

    if (!card) return;

    function openDrawer(e?: Event) {
      if (e) e.stopPropagation();
      card?.classList.add('is-expanded');
    }

    function closeDrawer(e?: Event) {
      if (e) e.stopPropagation();
      card?.classList.remove('is-expanded');
    }

    // 點擊「完整學經歷」或箭頭按鈕打開抽屜
    openBtn?.addEventListener('click', openDrawer);
    closeBtn?.addEventListener('click', closeDrawer);
    backBtn?.addEventListener('click', closeDrawer);

    // 點擊未展開的卡片本體時自動展開
    card.addEventListener('click', (e) => {
      const target = e.target as HTMLElement;
      if (target.closest('.card-detail-drawer') || target.closest('.card-detail-btn')) {
        return;
      }
      if (!card.classList.contains('is-expanded')) {
        openDrawer(e);
      }
    });

    // 點擊卡片外部時關閉
    document.addEventListener('click', (e) => {
      const target = e.target as HTMLElement;
      if (!target.closest('#dr-huang-obsidian-card')) {
        closeDrawer();
      }
    });

    // ESC 鍵關閉
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') {
        closeDrawer();
      }
    });

    // 游標感應實體光影追蹤 (Physical Cursor Reflection)
    const interactiveEls = document.querySelectorAll<HTMLElement>(
      '#dr-huang-obsidian-card, .card-detail-btn, .metal-badge'
    );
    interactiveEls.forEach((el) => {
      el.addEventListener('mousemove', (e: MouseEvent) => {
        const rect = el.getBoundingClientRect();
        const x = ((e.clientX - rect.left) / rect.width) * 100;
        const y = ((e.clientY - rect.top) / rect.height) * 100;
        el.style.setProperty('--mx', `${x.toFixed(1)}%`);
        el.style.setProperty('--my', `${y.toFixed(1)}%`);
      });
      el.addEventListener('mouseleave', () => {
        el.style.setProperty('--mx', '50%');
        el.style.setProperty('--my', '20%');
      });
    });
  }

  // 支援 Astro 頁面初次載入及路由切換
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', setupObsidianCard);
  } else {
    setupObsidianCard();
  }
  document.addEventListener('astro:page-load', setupObsidianCard);
</script>
