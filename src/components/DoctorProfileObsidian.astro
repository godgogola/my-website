      0 0 16px rgba(56, 189, 248, 0.22),
      inset 0 1px 1px #FFFFFF,
      inset 0 -1.5px 2px rgba(15, 23, 42, 0.4);
    outline: none;
    font-family: inherit;
  }

  /* 虹彩稜鏡折射外框 */
