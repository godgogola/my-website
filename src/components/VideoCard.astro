---
import type { VideoItem } from '../data/videos';
import { getYouTubeThumbnail, getArticleUrl } from '../data/videos';

interface Props {
  video: VideoItem;
  compact?: boolean;
  isEmbed?: boolean;
}

const { video, compact = false, isEmbed = false } = Astro.props;
const thumbnail = getYouTubeThumbnail(video.id);
const hasArticle = Boolean(video.articleSlug);
const articleUrl = hasArticle ? getArticleUrl(video.articleSlug, isEmbed) : '';

// 分類主題色映射
const categoryColorMap: Record<string, string> = {
  '內視鏡檢查': 'badge-exam',
  '肝膽胰疾病': 'badge-liver',
  '胃部疾病': 'badge-stomach',
  '腸道疾病': 'badge-intestine',
  '慢性病': 'badge-chronic',
  '高血壓': 'badge-bp',
  '高血脂': 'badge-lipid',
  '糖尿病': 'badge-dm',
  '減重': 'badge-weight',
  '健康飲食': 'badge-diet',
  '要活就要動': 'badge-exercise',
  '健檢項目介紹': 'badge-exam',
};

const categoryClass = categoryColorMap[video.category] || 'badge-default';
---

<article
  class:list={['video-card', { 'video-card-compact': compact, 'is-embed-card': isEmbed }]}
  data-video-id={video.id}
  data-video-title={video.title}
  data-video-category={video.category}
  tabindex="0"
  role="region"
  aria-label={`衛教短影音：${video.title}`}
>
  <!-- 16:9 影片縮圖與播放按鈕 (點擊觸發播放) -->
  <div class="thumbnail-wrapper" role="button" aria-label={`播放影片：${video.title}`}>
    <img
      src={thumbnail}
      alt={video.title}
      class="thumbnail-img"
      loading="lazy"
    />
    
    <!-- 縮圖上方遮罩光影 (底層漸層讓標籤更清晰) -->
    <div class="thumbnail-scrim"></div>

    <!-- 播放按鈕徽章 (移至左下角，不遮擋萌寵主角臉孔，與右下角時長對稱呼應) -->
    <div class="thumbnail-play-btn" aria-hidden="true">
      <div class="play-btn-circle">
        <svg viewBox="0 0 24 24" width="15" height="15" fill="currentColor">
          <polygon points="6 3 20 12 6 21 6 3"></polygon>
        </svg>
      </div>
    </div>

    <!-- 時長標籤 (右下角) -->
    <div class="duration-badge">
      <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
        <circle cx="12" cy="12" r="10"></circle>
        <polyline points="12 6 12 12 16 14"></polyline>
      </svg>
      <span>{video.duration}</span>
    </div>

    <!-- 分類標籤 (浮動於縮圖左上角) -->
    <span class:list={['category-tag', categoryClass]}>
      {video.category}
    </span>

    <!-- 原地播放容器 (點擊後動態載入 YouTube iframe，不離開原位) -->
    <div class="inline-player-container" style="display: none;"></div>

    <!-- 原地播放關閉按鈕 (浮於播放器右上角) -->
    <button type="button" class="inline-player-close-btn" style="display: none;" aria-label="關閉影片回到縮圖" title="關閉影片回到縮圖">
      <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.8" stroke-linecap="round" stroke-linejoin="round">
        <line x1="18" y1="6" x2="6" y2="18"></line>
        <line x1="6" y1="6" x2="18" y2="18"></line>
      </svg>
      <span>關閉</span>
    </button>
  </div>

  <!-- 卡片文字內容 -->
  <div class="card-content">
    <!-- 頂部作者與閱讀專文按鈕 (二合一互動按鈕) -->
    <div class="card-header-meta">
      <span class="doctor-badge">
        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm0 3c1.66 0 3 1.34 3 3s-1.34 3-3 3-3-1.34-3-3 1.34-3 3-3zm0 14.2c-2.5 0-4.71-1.28-6-3.22.03-1.99 4-3.08 6-3.08 1.99 0 5.97 1.09 6 3.08-1.29 1.94-3.5 3.22-6 3.22z"/></svg>
        黃冠智 醫師
      </span>
      {hasArticle && (
        <a 
          href={articleUrl} 
          class="header-article-link"
          data-article-link
          target="_blank"
          rel="noopener noreferrer"
          aria-label={`閱讀完整衛教專文：${video.title}`}
          onclick="event.stopPropagation();"
        >
          <svg viewBox="0 0 24 24" width="12" height="12" fill="none" stroke="currentColor" stroke-width="2.3" stroke-linecap="round" stroke-linejoin="round">
            <path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"></path>
            <path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"></path>
          </svg>
          <span>閱讀專文</span>
          <svg viewBox="0 0 24 24" width="10" height="10" fill="none" stroke="currentColor" stroke-width="2.5" class="external-icon">
            <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path>
            <polyline points="15 3 21 3 21 9"></polyline>
            <line x1="10" y1="14" x2="21" y2="3"></line>
          </svg>
        </a>
      )}
    </div>

    <h3 class="video-title">{video.title}</h3>
    <p class="video-desc">{video.description}</p>
  </div>
</article>

<style>
  /* ═══════════════════════════════════════
     Video Card 精品簡潔衛教卡片
  ═══════════════════════════════════════ */
  .video-card {
    background: #ffffff;
    border-radius: var(--radius-md, 16px);
    overflow: hidden;
    box-shadow: 0 4px 20px rgba(74, 144, 164, 0.08), 0 1px 3px rgba(0, 0, 0, 0.04);
    border: 1px solid var(--color-border, #d4e5eb);
    display: flex;
    flex-direction: column;
    transition: transform 0.28s cubic-bezier(0.16, 1, 0.3, 1),
                box-shadow 0.28s cubic-bezier(0.16, 1, 0.3, 1),
                border-color 0.28s ease;
    user-select: none;
    outline: none;
    position: relative;
    cursor: pointer;
  }

  .video-card:hover {
    transform: translateY(-5px);
    box-shadow: 0 16px 36px -8px rgba(74, 144, 164, 0.22), 0 2px 6px rgba(0, 0, 0, 0.06);
    border-color: var(--color-primary, #4a90a4);
  }

  .video-card:focus-visible {
    box-shadow: 0 0 0 3px rgba(74, 144, 164, 0.35);
  }

  /* 縮圖區域 (16:9) */
  .thumbnail-wrapper {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    background: #11222e;
  }

  .thumbnail-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    transition: transform 0.45s cubic-bezier(0.16, 1, 0.3, 1), filter 0.35s ease;
    filter: brightness(1.08) contrast(1.02);
  }

  .video-card:hover .thumbnail-img {
    transform: scale(1.05);
    filter: brightness(1.15) contrast(1.04);
  }

  /* 光影遮罩 (柔和底層微漸層，保持底圖明亮乾淨同時確保控制項清晰) */
  .thumbnail-scrim {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      180deg,
      rgba(0, 0, 0, 0.08) 0%,
      rgba(0, 0, 0, 0) 45%,
      rgba(0, 0, 0, 0.38) 100%
    );
    pointer-events: none;
  }

  /* 播放按鈕徽章 (左下角，不遮擋主角動物臉部) */
  .thumbnail-play-btn {
    position: absolute;
    bottom: 0.65rem;
    left: 0.65rem;
    z-index: 2;
    pointer-events: none;
    display: flex;
    align-items: center;
  }

  .play-btn-circle {
    width: 36px;
    height: 36px;
    border-radius: 50%;
    background: rgba(231, 111, 81, 0.95);
    color: #ffffff;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 3px 12px rgba(0, 0, 0, 0.35), 0 2px 8px rgba(231, 111, 81, 0.45);
    backdrop-filter: blur(4px);
    transition: transform 0.25s cubic-bezier(0.34, 1.56, 0.64, 1),
                background-color 0.2s ease,
                box-shadow 0.25s ease;
  }

  .video-card:hover .play-btn-circle {
    transform: scale(1.15);
    background: #e76f51;
    box-shadow: 0 4px 18px rgba(231, 111, 81, 0.7);
  }

  .play-btn-circle svg {
    margin-left: 2px;
  }

  /* 時長標籤 (右下角) */
  .duration-badge {
    position: absolute;
    bottom: 0.75rem;
    right: 0.75rem;
    z-index: 2;
    background: rgba(15, 30, 42, 0.88);
    backdrop-filter: blur(4px);
    color: #ffffff;
    font-size: 0.82rem;
    font-weight: 700;
    padding: 0.25rem 0.6rem;
    border-radius: var(--radius-sm, 6px);
    display: flex;
    align-items: center;
    gap: 0.35rem;
    letter-spacing: 0.05em;
  }

  /* 分類標籤 (浮動於左上角) */
  .category-tag {
    position: absolute;
    top: 0.75rem;
    left: 0.75rem;
    z-index: 2;
    font-size: 0.82rem;
    font-weight: 800;
    padding: 0.28rem 0.75rem;
    border-radius: var(--radius-full, 9999px);
    backdrop-filter: blur(8px);
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.2);
    letter-spacing: 0.03em;
  }

  .badge-liver {
    background: rgba(14, 165, 233, 0.92);
    color: #ffffff;
  }

  .badge-stomach {
    background: rgba(231, 111, 81, 0.92);
    color: #ffffff;
  }

  .badge-intestine {
    background: rgba(74, 144, 164, 0.92);
    color: #ffffff;
  }

  .badge-exam {
    background: rgba(107, 181, 162, 0.92);
    color: #ffffff;
  }

  .badge-diet {
    background: rgba(16, 185, 129, 0.92);
    color: #ffffff;
  }

  .badge-lipid {
    background: rgba(245, 158, 11, 0.95);
    color: #ffffff;
  }

  .badge-bp {
    background: rgba(244, 63, 94, 0.92);
    color: #ffffff;
  }

  .badge-dm {
    background: rgba(139, 92, 246, 0.92);
    color: #ffffff;
  }

  .badge-chronic {
    background: rgba(244, 162, 97, 0.95);
    color: #3b2405;
  }

  .badge-weight {
    background: rgba(20, 184, 166, 0.92);
    color: #ffffff;
  }

  .badge-exercise {
    background: rgba(6, 182, 212, 0.92);
    color: #ffffff;
  }

  .badge-default {
    background: rgba(44, 83, 100, 0.88);
    color: #ffffff;
  }

  /* 卡片內容 (簡潔、緊湊) */
  .card-content {
    padding: 1.25rem 1.4rem 1.4rem 1.4rem;
    display: flex;
    flex-direction: column;
    flex: 1;
  }

  /* 頂部作者與閱讀專文按鈕 */
  .card-header-meta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.6rem;
    margin-bottom: 0.75rem;
  }

  .doctor-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.95rem;
    font-weight: 700;
    color: var(--color-primary-dark, #3b7688);
    white-space: nowrap;
  }

  .doctor-badge svg {
    color: var(--color-primary, #4a90a4);
    width: 15px;
    height: 15px;
  }

  /* 閱讀專文互動藥丸按鈕 (置於作者旁) */
  .header-article-link {
    display: inline-flex;
    align-items: center;
    gap: 0.38rem;
    font-size: 0.86rem;
    font-weight: 700;
    color: #1e6b5c;
    background: #eef8f5;
    border: 1px solid rgba(43, 122, 104, 0.28);
    padding: 0.28rem 0.75rem;
    border-radius: var(--radius-full, 9999px);
    text-decoration: none;
    transition: all 0.2s cubic-bezier(0.16, 1, 0.3, 1);
    white-space: nowrap;
    cursor: pointer;
    line-height: 1.25;
  }

  .header-article-link:hover {
    background: #2b7a68;
    color: #ffffff;
    border-color: #2b7a68;
    transform: translateY(-1px);
    box-shadow: 0 3px 10px rgba(43, 122, 104, 0.28);
  }

  .header-article-link .external-icon {
    opacity: 0.7;
    transition: transform 0.2s ease, opacity 0.2s ease;
  }

  .header-article-link:hover .external-icon {
    opacity: 1;
    transform: translate(1px, -1px);
  }

  .video-title {
    font-size: 1.25rem;
    font-weight: 800;
    color: var(--color-text-title, #1e3a4c);
    line-height: 1.45;
    margin: 0 0 0.55rem 0;
    transition: color 0.2s ease;
  }

  .video-card:hover .video-title {
    color: var(--color-primary-dark, #3b7688);
  }

  .video-desc {
    font-size: 0.98rem;
    color: var(--color-text-body, #2d4f63);
    line-height: 1.62;
    margin: 0;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    opacity: 0.9;
  }

  /* 緊湊模式 */
  .video-card-compact .card-content {
    padding: 1rem 1.1rem 1.15rem 1.1rem;
  }

  .video-card-compact .video-title {
    font-size: 1.15rem;
  }

  .video-card-compact .header-article-link {
    padding: 0.22rem 0.6rem;
    font-size: 0.8rem;
  }

  @media (max-width: 640px) {
    .card-content {
      padding: 1rem 1.1rem 1.15rem 1.1rem;
    }
    .video-title {
      font-size: 1.1rem;
    }
    .video-desc {
      font-size: 0.88rem;
    }
    .doctor-badge {
      font-size: 0.85rem;
    }
    .header-article-link {
      font-size: 0.78rem;
      padding: 0.2rem 0.6rem;
    }
  }

  /* ═══ 原地播放器樣式 (Inline Player) ═══ */
  .inline-player-container {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: 10;
    background: #000000;
  }

  .inline-player-container :global(iframe),
  :global(.inline-player-iframe) {
    position: absolute !important;
    top: 0 !important;
    left: 0 !important;
    width: 100% !important;
    height: 100% !important;
    border: none !important;
    display: block !important;
  }

  .inline-player-close-btn {
    position: absolute;
    top: 0.65rem;
    right: 0.65rem;
    z-index: 25;
    background: rgba(15, 30, 42, 0.88);
    color: #ffffff;
    border: 1px solid rgba(255, 255, 255, 0.35);
    padding: 0.28rem 0.72rem;
    border-radius: var(--radius-full, 9999px);
    font-size: 0.8rem;
    font-weight: 700;
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    cursor: pointer;
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    box-shadow: 0 4px 14px rgba(0, 0, 0, 0.45);
    transition: all 0.2s cubic-bezier(0.16, 1, 0.3, 1);
    line-height: 1.2;
  }

  .inline-player-close-btn:hover {
    background: #e76f51;
    border-color: #e76f51;
    transform: translateY(-1px) scale(1.04);
    box-shadow: 0 6px 18px rgba(231, 111, 81, 0.55);
  }

  .inline-player-close-btn:active {
    transform: translateY(0) scale(0.98);
  }

  .video-card.is-playing {
    border-color: var(--color-primary, #4a90a4);
    box-shadow: 0 12px 32px rgba(74, 144, 164, 0.28), 0 0 0 2px rgba(74, 144, 164, 0.35);
    transform: translateY(-2px);
  }

  .video-card.is-playing .thumbnail-play-btn,
  .video-card.is-playing .duration-badge,
  .video-card.is-playing .category-tag,
  .video-card.is-playing .thumbnail-scrim {
    opacity: 0 !important;
    pointer-events: none !important;
  }

  /* ================================================================
     UI/UX Pro Max — Obsidian & Liquid Chrome Styles for VideoCard
     ================================================================ */
  .video-card {
    background: #11141B !important;
    border-radius: 20px !important;
    border: 1px solid rgba(255, 255, 255, 0.08) !important;
    box-shadow: 0 12px 28px -6px rgba(0, 0, 0, 0.65), 0 0 1px 1px rgba(255, 255, 255, 0.06) !important;
    transition: all 0.35s cubic-bezier(0.16, 1, 0.3, 1) !important;
    overflow: hidden !important;
  }
  .video-card:hover {
    transform: translateY(-6px) !important;
    box-shadow: 0 22px 48px -8px rgba(0, 0, 0, 0.85), 0 0 24px rgba(16, 185, 129, 0.12), 0 0 1px 1px rgba(255, 255, 255, 0.28) !important;
    border-color: rgba(255, 255, 255, 0.28) !important;
  }

  .thumbnail-wrapper {
    background: #0B0E14 !important;
  }

  /* 拋光鍍鉻光碟播放按鈕 */
  .play-btn-circle {
    background: linear-gradient(180deg, #FFFFFF 0%, #E2E8F0 40%, #94A3B8 100%) !important;
    color: #0A0D12 !important;
    border: 1px solid #FFFFFF !important;
    box-shadow: 0 4px 14px rgba(0, 0, 0, 0.4), 0 0 16px rgba(255, 255, 255, 0.4) !important;
    transition: transform 0.25s cubic-bezier(0.34, 1.56, 0.64, 1), box-shadow 0.25s ease !important;
  }
  .video-card:hover .play-btn-circle {
    transform: scale(1.15) !important;
    box-shadow: 0 6px 20px rgba(255, 255, 255, 0.65), 0 0 22px rgba(56, 189, 248, 0.4) !important;
  }

  /* 底部黑曜毛玻璃質感內容區 */
  .card-content {
    background: linear-gradient(180deg, rgba(17, 21, 28, 0.95) 0%, rgba(10, 13, 18, 0.98) 100%) !important;
    border-top: 1px solid rgba(255, 255, 255, 0.08) !important;
    color: #F1F5F9 !important;
  }

  .doctor-badge {
    color: #A7F3D0 !important;
  }
  .doctor-badge svg {
    color: #10B981 !important;
  }

  /* 液態銀彩專文連結膠囊 */
  .header-article-link {
    background: rgba(255, 255, 255, 0.06) !important;
    border: 1px solid rgba(255, 255, 255, 0.18) !important;
    color: #E2E8F0 !important;
    border-radius: 9999px !important;
    padding: 4px 12px !important;
    font-weight: 700 !important;
    transition: all 0.25s ease !important;
  }
  .header-article-link:hover {
    background: #FFFFFF !important;
    color: #0A0D12 !important;
    border-color: #FFFFFF !important;
    box-shadow: 0 4px 14px rgba(255, 255, 255, 0.3) !important;
  }

  .video-title {
    color: #F8FAFC !important;
    transition: color 0.25s ease !important;
  }
  .video-card:hover .video-title {
    color: #FFFFFF !important;
    text-shadow: 0 0 14px rgba(255, 255, 255, 0.3) !important;
  }

  .video-desc {
    color: #94A3B8 !important;
  }

</style>

<script>
  // 卡片原地播放控制核心 (支援 Wix / Iframe 嵌入與獨立頁面)
  function initInlineVideoPlayers() {
    function stopAllInlinePlayers() {
      document.querySelectorAll<HTMLElement>('.video-card.is-playing').forEach((card) => {
        card.classList.remove('is-playing');
        const container = card.querySelector<HTMLElement>('.inline-player-container');
        const closeBtn = card.querySelector<HTMLElement>('.inline-player-close-btn');
        if (container) {
          container.innerHTML = '';
          container.style.display = 'none';
        }
        if (closeBtn) {
          closeBtn.style.display = 'none';
        }
      });
    }

    // 註冊至全域供換頁或隨機換一批時統一呼叫
    (window as any).stopAllInlinePlayers = stopAllInlinePlayers;

    function playInlineVideo(card: HTMLElement) {
      const videoId = card.dataset.videoId;
      if (!videoId) return;

      if (card.classList.contains('is-playing')) return;

      // 停止其他正在播放的卡片
      stopAllInlinePlayers();

      const container = card.querySelector<HTMLElement>('.inline-player-container');
      const closeBtn = card.querySelector<HTMLElement>('.inline-player-close-btn');

      if (container) {
        container.innerHTML = `
          <iframe
            src="https://www.youtube-nocookie.com/embed/${videoId}?autoplay=1&rel=0&modestbranding=1&playsinline=1&enablejsapi=1"
            title="${card.dataset.videoTitle || '衛教短影音'}"
            class="inline-player-iframe"
            width="100%"
            height="100%"
            style="position: absolute; top: 0; left: 0; width: 100%; height: 100%; border: 0; display: block;"
            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
            allowfullscreen
          ></iframe>
        `;
        container.style.display = 'block';
      }

      if (closeBtn) {
        closeBtn.style.display = 'inline-flex';
      }

      card.classList.add('is-playing');
    }

    // 關閉按鈕點擊事件
    document.addEventListener('click', (e) => {
      const closeBtn = (e.target as HTMLElement).closest<HTMLElement>('.inline-player-close-btn');
      if (closeBtn) {
        e.preventDefault();
        e.stopPropagation();
        const card = closeBtn.closest<HTMLElement>('.video-card');
        if (card) {
          card.classList.remove('is-playing');
          const container = card.querySelector<HTMLElement>('.inline-player-container');
          if (container) {
            container.innerHTML = '';
            container.style.display = 'none';
          }
          closeBtn.style.display = 'none';
        }
      }
    });

    // 卡片點擊事件
    document.addEventListener('click', (e) => {
      const target = e.target as HTMLElement;

      // 排除專文按鈕、關閉按鈕
      if (target.closest('a[data-article-link], .header-article-link, .twin-btn-article, .inline-player-close-btn')) {
        return;
      }

      const card = target.closest<HTMLElement>('.video-card');
      if (!card) return;

      // 判斷是否為嵌入模式卡片或處於嵌入環境 (例如 Wix iframe)
      const isEmbedMode = card.classList.contains('is-embed-card') ||
                          document.documentElement.classList.contains('is-embed') ||
                          document.body?.classList.contains('is-embed') ||
                          Boolean(document.querySelector('.videos-embed-container')) ||
                          (window.self !== window.top);

      if (isEmbedMode) {
        e.preventDefault();
        if (!card.classList.contains('is-playing')) {
          playInlineVideo(card);
        }
      }
    });

    // 支援 ESC 鍵快速停止播放
    window.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') {
        stopAllInlinePlayers();
      }
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initInlineVideoPlayers);
  } else {
    initInlineVideoPlayers();
  }
</script>
