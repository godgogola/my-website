---
import type { VideoItem } from '../data/videos';
import { getYouTubeThumbnail, getArticleUrl } from '../data/videos';

interface Props {
  video: VideoItem;
  compact?: boolean;
  isEmbed?: boolean;
}

const { video, compact = false, isEmbed = false } = Astro.props;
const thumbnail = getYouTubeThumbnail(video.id);
const hasArticle = Boolean(video.articleSlug);
const articleUrl = hasArticle ? getArticleUrl(video.articleSlug, isEmbed) : '';

// 分類主題色映射
const categoryColorMap: Record<string, string> = {
  '肝膽胰疾病': 'badge-liver',
  '胃部疾病': 'badge-stomach',
  '腸道健康': 'badge-intestine',
  '檢查衛教': 'badge-exam',
  '代謝慢病': 'badge-metabolic',
};

const categoryClass = categoryColorMap[video.category] || 'badge-default';
---

<article
  class:list={['video-card', { 'video-card-compact': compact }]}
  data-video-id={video.id}
  data-video-title={video.title}
  data-video-category={video.category}
  tabindex="0"
  role="region"
  aria-label={`衛教短影音：${video.title}`}
>
  <!-- 16:9 影片縮圖與播放按鈕 (點擊觸發燈箱播放) -->
  <div class="thumbnail-wrapper" role="button" aria-label={`播放影片：${video.title}`}>
    <img
      src={thumbnail}
      alt={video.title}
      class="thumbnail-img"
      loading="lazy"
    />
    
    <!-- 縮圖上方遮罩光影 (底層漸層讓標籤更清晰) -->
    <div class="thumbnail-scrim"></div>

    <!-- 播放按鈕徽章 (移至左下角，不遮擋萌寵主角臉孔，與右下角時長對稱呼應) -->
    <div class="thumbnail-play-btn" aria-hidden="true">
      <div class="play-btn-circle">
        <svg viewBox="0 0 24 24" width="15" height="15" fill="currentColor">
          <polygon points="6 3 20 12 6 21 6 3"></polygon>
        </svg>
      </div>
    </div>

    <!-- 時長標籤 (右下角) -->
    <div class="duration-badge">
      <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
        <circle cx="12" cy="12" r="10"></circle>
        <polyline points="12 6 12 12 16 14"></polyline>
      </svg>
      <span>{video.duration}</span>
    </div>

    <!-- 分類標籤 (浮動於縮圖左上角) -->
    <span class:list={['category-tag', categoryClass]}>
      {video.category}
    </span>
  </div>

  <!-- 卡片文字內容 -->
  <div class="card-content">
    <!-- 頂部作者與閱讀專文按鈕 (二合一互動按鈕) -->
    <div class="card-header-meta">
      <span class="doctor-badge">
        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm0 3c1.66 0 3 1.34 3 3s-1.34 3-3 3-3-1.34-3-3 1.34-3 3-3zm0 14.2c-2.5 0-4.71-1.28-6-3.22.03-1.99 4-3.08 6-3.08 1.99 0 5.97 1.09 6 3.08-1.29 1.94-3.5 3.22-6 3.22z"/></svg>
        黃冠智 醫師
      </span>
      {hasArticle && (
        <a 
          href={articleUrl} 
          class="header-article-link"
          data-article-link
          target="_blank"
          rel="noopener noreferrer"
          aria-label={`閱讀完整衛教專文：${video.title}`}
          onclick="event.stopPropagation();"
        >
          <svg viewBox="0 0 24 24" width="12" height="12" fill="none" stroke="currentColor" stroke-width="2.3" stroke-linecap="round" stroke-linejoin="round">
            <path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"></path>
            <path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"></path>
          </svg>
          <span>閱讀專文</span>
          <svg viewBox="0 0 24 24" width="10" height="10" fill="none" stroke="currentColor" stroke-width="2.5" class="external-icon">
            <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path>
            <polyline points="15 3 21 3 21 9"></polyline>
            <line x1="10" y1="14" x2="21" y2="3"></line>
          </svg>
        </a>
      )}
    </div>

    <h3 class="video-title">{video.title}</h3>
    <p class="video-desc">{video.description}</p>
  </div>
</article>

<style>
  /* ═══════════════════════════════════════
     Video Card 精品簡潔衛教卡片
  ═══════════════════════════════════════ */
  .video-card {
    background: #ffffff;
    border-radius: var(--radius-md, 16px);
    overflow: hidden;
    box-shadow: 0 4px 20px rgba(74, 144, 164, 0.08), 0 1px 3px rgba(0, 0, 0, 0.04);
    border: 1px solid var(--color-border, #d4e5eb);
    display: flex;
    flex-direction: column;
    transition: transform 0.28s cubic-bezier(0.16, 1, 0.3, 1),
                box-shadow 0.28s cubic-bezier(0.16, 1, 0.3, 1),
                border-color 0.28s ease;
    user-select: none;
    outline: none;
    position: relative;
    cursor: pointer;
  }

  .video-card:hover {
    transform: translateY(-5px);
    box-shadow: 0 16px 36px -8px rgba(74, 144, 164, 0.22), 0 2px 6px rgba(0, 0, 0, 0.06);
    border-color: var(--color-primary, #4a90a4);
  }

  .video-card:focus-visible {
    box-shadow: 0 0 0 3px rgba(74, 144, 164, 0.35);
  }

  /* 縮圖區域 (16:9) */
  .thumbnail-wrapper {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    background: #11222e;
  }

  .thumbnail-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    transition: transform 0.45s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .video-card:hover .thumbnail-img {
    transform: scale(1.05);
  }

  /* 光影遮罩 (底部漸層確保控制項清晰對比) */
  .thumbnail-scrim {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      180deg,
      rgba(0, 0, 0, 0.2) 0%,
      rgba(0, 0, 0, 0) 40%,
      rgba(0, 0, 0, 0.6) 100%
    );
    pointer-events: none;
  }

  /* 播放按鈕徽章 (左下角，不遮擋主角動物臉部) */
  .thumbnail-play-btn {
    position: absolute;
    bottom: 0.65rem;
    left: 0.65rem;
    z-index: 2;
    pointer-events: none;
    display: flex;
    align-items: center;
  }

  .play-btn-circle {
    width: 36px;
    height: 36px;
    border-radius: 50%;
    background: rgba(231, 111, 81, 0.95);
    color: #ffffff;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 3px 12px rgba(0, 0, 0, 0.35), 0 2px 8px rgba(231, 111, 81, 0.45);
    backdrop-filter: blur(4px);
    transition: transform 0.25s cubic-bezier(0.34, 1.56, 0.64, 1),
                background-color 0.2s ease,
                box-shadow 0.25s ease;
  }

  .video-card:hover .play-btn-circle {
    transform: scale(1.15);
    background: #e76f51;
    box-shadow: 0 4px 18px rgba(231, 111, 81, 0.7);
  }

  .play-btn-circle svg {
    margin-left: 2px;
  }

  /* 時長標籤 (右下角) */
  .duration-badge {
    position: absolute;
    bottom: 0.65rem;
    right: 0.65rem;
    z-index: 2;
    background: rgba(15, 30, 42, 0.85);
    backdrop-filter: blur(4px);
    color: #ffffff;
    font-size: 0.75rem;
    font-weight: 700;
    padding: 0.22rem 0.55rem;
    border-radius: var(--radius-sm, 6px);
    display: flex;
    align-items: center;
    gap: 0.3rem;
    letter-spacing: 0.05em;
  }

  /* 分類標籤 (浮動於左上角) */
  .category-tag {
    position: absolute;
    top: 0.65rem;
    left: 0.65rem;
    z-index: 2;
    font-size: 0.72rem;
    font-weight: 800;
    padding: 0.22rem 0.65rem;
    border-radius: var(--radius-full, 9999px);
    backdrop-filter: blur(8px);
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.2);
    letter-spacing: 0.03em;
  }

  .badge-liver {
    background: rgba(14, 165, 233, 0.92);
    color: #ffffff;
  }

  .badge-stomach {
    background: rgba(231, 111, 81, 0.92);
    color: #ffffff;
  }

  .badge-intestine {
    background: rgba(74, 144, 164, 0.92);
    color: #ffffff;
  }

  .badge-exam {
    background: rgba(107, 181, 162, 0.92);
    color: #ffffff;
  }

  .badge-metabolic {
    background: rgba(244, 162, 97, 0.95);
    color: #3b2405;
  }

  .badge-default {
    background: rgba(44, 83, 100, 0.88);
    color: #ffffff;
  }

  /* 卡片內容 (簡潔、緊湊) */
  .card-content {
    padding: 1.1rem 1.25rem 1.25rem 1.25rem;
    display: flex;
    flex-direction: column;
    flex: 1;
  }

  /* 頂部作者與閱讀專文按鈕 */
  .card-header-meta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    margin-bottom: 0.65rem;
  }

  .doctor-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-size: 0.8rem;
    font-weight: 700;
    color: var(--color-primary-dark, #3b7688);
    white-space: nowrap;
  }

  .doctor-badge svg {
    color: var(--color-primary, #4a90a4);
  }

  /* 閱讀專文互動藥丸按鈕 (置於作者旁) */
  .header-article-link {
    display: inline-flex;
    align-items: center;
    gap: 0.32rem;
    font-size: 0.74rem;
    font-weight: 700;
    color: #1e6b5c;
    background: #eef8f5;
    border: 1px solid rgba(43, 122, 104, 0.28);
    padding: 0.22rem 0.62rem;
    border-radius: var(--radius-full, 9999px);
    text-decoration: none;
    transition: all 0.2s cubic-bezier(0.16, 1, 0.3, 1);
    white-space: nowrap;
    cursor: pointer;
    line-height: 1.2;
  }

  .header-article-link:hover {
    background: #2b7a68;
    color: #ffffff;
    border-color: #2b7a68;
    transform: translateY(-1px);
    box-shadow: 0 3px 10px rgba(43, 122, 104, 0.28);
  }

  .header-article-link .external-icon {
    opacity: 0.7;
    transition: transform 0.2s ease, opacity 0.2s ease;
  }

  .header-article-link:hover .external-icon {
    opacity: 1;
    transform: translate(1px, -1px);
  }

  .video-title {
    font-size: 1.12rem;
    font-weight: 800;
    color: var(--color-text-title, #1e3a4c);
    line-height: 1.42;
    margin: 0 0 0.45rem 0;
    transition: color 0.2s ease;
  }

  .video-card:hover .video-title {
    color: var(--color-primary-dark, #3b7688);
  }

  .video-desc {
    font-size: 0.86rem;
    color: var(--color-text-body, #2d4f63);
    line-height: 1.58;
    margin: 0;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    opacity: 0.88;
  }

  /* 緊湊模式 */
  .video-card-compact .card-content {
    padding: 0.95rem 1rem 1.05rem 1rem;
  }

  .video-card-compact .video-title {
    font-size: 1.05rem;
  }

  .video-card-compact .header-article-link {
    padding: 0.18rem 0.5rem;
    font-size: 0.72rem;
  }
</style>
