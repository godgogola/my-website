---
// 無痛腸胃鏡核心專題組件
interface Props {
  isEmbed?: boolean;
}

const { isEmbed = false } = Astro.props;

// 核心主要影片
const mainVideo = {
  id: '-Nfxr0NGDQ0',
  title: '無痛腸胃鏡',
  subtitle: '安心睡眠中完成 · 肝膽腸胃專科團隊親自操作',
  description: '您對做胃鏡、大腸鏡感到恐懼嗎？豐田診所採用專業舒眠鎮靜麻醉技術與醫療級 CO2 充氣，讓您在如同小睡片刻的平穩放鬆狀態下，精準完成全消化道防癌檢查。'
};

// 四部優先推薦清腸核心影片
const coreBowelVideos = [
  {
    id: 'S2QcETFlIxI',
    title: '低渣飲食',
    category: '飲食準備',
    desc: '清腸成功的一半！掌握紅白綠燈飲食原則，避免纖維殘渣干擾病灶發現。',
    tag: '飲食關鍵'
  },
  {
    id: 'hBuG7IPxWRQ',
    title: '【腸鏡前準備】清腸劑比較：保可淨 vs 耐福力散',
    category: '藥物對比',
    desc: '兩種常見清腸劑該怎麼選？口感、沖泡水量與適用族群一次看懂。',
    tag: '藥物挑選'
  },
  {
    id: 'z-gNT0nBsZU',
    title: '【腸鏡前準備】保可淨 (Bowklean)',
    category: '服藥教學',
    desc: '低容量好入口！保可淨兩劑沖泡細節與水分分次補充正確步驟教學。',
    tag: '保可淨'
  },
  {
    id: 'Eo7sb0VvcTs',
    title: '【腸鏡前準備】耐福力散 (Niflec)',
    category: '服藥教學',
    desc: '大容量等滲透壓清腸劑沖泡與分段飲用技巧，⚠️ 嚴禁直接乾吞藥粉！',
    tag: '耐福力散'
  }
];

// 其餘延伸衛教影片（置於最後）
const extraVideos = [
  {
    id: 'cBAGeNQeMP8',
    title: '一次做完腸胃篩檢',
    category: '檢查須知',
    desc: '胃鏡與大腸鏡能同一天完成嗎？一次麻醉雙重防癌篩檢優勢解析。'
  },
  {
    id: 'VeS9ab3m4eY',
    title: '高品質大腸鏡',
    category: '醫療品質',
    desc: '如何評估一份高品質的大腸鏡檢查？盲腸到達率、清腸度與腺瘤偵測率。'
  },
  {
    id: 'kbVjl-HOKr4',
    title: '大腸息肉與腺瘤',
    category: '疾病處置',
    desc: '息肉一定要切除嗎？大腸癌由息肉演變的致癌路徑與當日切除時機。'
  },
  {
    id: '0Ix8__RylaU',
    title: '糞便潛血陽性就一定是大腸癌嗎',
    category: '防癌篩檢',
    desc: '健檢收到潛血紅字別恐慌！英國NHS大數據揭秘與即時鏡檢的重要性。'
  },
  {
    id: 'lxOZ1KRJDDE',
    title: '胃幽門螺旋桿菌',
    category: '胃部疾病',
    desc: '世界衛生組織認定之一級致癌物！胃潰瘍與胃癌的隱形殺手。'
  },
  {
    id: 'wCFG_s-ToXA',
    title: '幽門桿菌檢驗方法',
    category: '檢查須知',
    desc: '碳13吹氣試驗、切片檢查與糞便抗原檢驗優缺點全面評比。'
  },
  {
    id: '4j84jWlgqlY',
    title: '巴瑞氏食道炎',
    category: '胃食道逆流',
    desc: '胃酸長期逆流導致食道黏膜變性！防範食道腺癌的黃金追蹤期。'
  },
  {
    id: 'c7jElX1VEbE',
    title: '黑腸症 (Melanosis Coli)',
    category: '腸道疾病',
    desc: '長期濫用便秘瀉藥導致大腸黏膜色素沉澱的成因與預後。'
  }
];
---

<div class:list={['endoscopy-special-container', { 'embed-mode': isEmbed }]}>
  <!-- ═══════════════════════════════════════════════════
       1. HERO 專題主視覺區
  ═══════════════════════════════════════════════════ -->
  <section class="endo-hero">
    <div class="endo-hero-inner">
      <h1 class="endo-hero-title">
        舒眠無痛腸胃鏡 <span class="highlight-text">守護全消化道健康</span>
      </h1>

      <!-- 快速跳轉錨點 -->
      <div class="endo-quick-anchors">
        <a href="#video-showcase" class="anchor-btn">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polygon points="5 3 19 12 5 21 5 3"/></svg>
          觀看衛教影音
        </a>
        <a href="#prep-calculator" class="anchor-btn primary">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
          個人化清腸試算
        </a>
        <a href="#diet-guide" class="anchor-btn">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><circle cx="12" cy="12" r="10"/><path d="M12 6v6l4 2"/></svg>
          低渣飲食速查
        </a>
        <a href="#flow-steps" class="anchor-btn">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M9 11l3 3L22 4"/><path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"/></svg>
          檢查流程說明
        </a>
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════════════
       2. 診所醫療品質四大王牌特色
  ═══════════════════════════════════════════════════ -->
  <section class="endo-features-section">
    <div class="section-heading">
      <span class="sub-label">CLINICAL EXCELLENCE</span>
      <h2 class="main-heading">為什麼選擇豐田診所無痛腸胃鏡？</h2>
      <p class="desc-heading">超越傳統健檢的細膩照護，兼具醫學中心等級的儀器設備與基層診所的親切便利。</p>
    </div>

    <div class="features-grid">
      <!-- 特色 1 -->
      <div class="feature-card">
        <h3 class="card-title">安全靜脈舒眠麻醉</h3>
        <p class="card-desc">
          並非插管全身麻醉，而是使用安全短效的靜脈鎮靜藥物。檢查過程如同小睡片刻，全程由受過專業急救與鎮靜訓練的醫護團隊密集監測血壓、心跳與血氧，無痛、無嘔吐反射、無恐懼。
        </p>
      </div>

      <!-- 特色 2 -->
      <div class="feature-card highlight">
        <div class="popular-tag">大幅減脹</div>
        <h3 class="card-title">醫療級 CO2 充氣系統</h3>
        <p class="card-desc">
          大腸鏡需充氣撐開腸道皺褶以利觀察。傳統灌入空氣難以吸收，術後常腹脹劇痛數小時；我們全面採用<strong>醫療級二氧化碳 (CO2)</strong>，人體吸收速度比空氣快 150 倍，檢查後迅速自然消脹、極速舒緩。
        </p>
      </div>

      <!-- 特色 3 -->
      <div class="feature-card">
        <h3 class="card-title">高解析光學影像系統</h3>
        <p class="card-desc">
          引進先進數位高解析內視鏡，搭載窄頻光 (NBI) 與光學放大技術。可清晰顯現微細黏膜表層毛細血管與腺管微結構（Pit Pattern），及時揪出早期平坦型微小腺瘤，防患大腸癌於未然。
        </p>
      </div>

      <!-- 特色 4 -->
      <div class="feature-card">
        <h3 class="card-title">當日瘜肉評估與微創切除</h3>
        <p class="card-desc">
          檢查中若發現大腸瘜肉，經醫師專業評估符合適應症者，即可採<strong>微創冷切除／熱切除技術</strong>當場切除並送病理化驗。免除二次回診奔波與重新清腸服藥的痛苦。
        </p>
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════════════
       3. 核心衛教影音專題 SHOWCASE (以《無痛腸胃鏡》為首 + 四大清腸影片)
  ═══════════════════════════════════════════════════ -->
  <section class="endo-video-showcase" id="video-showcase">
    <div class="section-heading">
      <span class="sub-label">VIDEO EDUCATION</span>
      <h2 class="main-heading">動物農莊 · 內視鏡與清腸影音教室</h2>
      <p class="desc-heading">由動物界專科醫師出診，以 1 分鐘生動實證短片為您說解檢查大小事。點擊下方卡片即可切換觀看！</p>
    </div>

    <div class="showcase-container">
      <!-- 主播放焦點視窗 -->
      <div class="player-main-card">
        <div class="video-responsive-wrap">
          <iframe
            id="mainPlayerIframe"
            src={`https://www.youtube.com/embed/${mainVideo.id}?rel=0&enablejsapi=1`}
            title={mainVideo.title}
            frameborder="0"
            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
            allowfullscreen
          ></iframe>
        </div>
        <div class="player-info-bar">
          <div class="player-badge">當前播放焦點</div>
          <h3 class="player-active-title" id="activeVideoTitle">{mainVideo.title}</h3>
          <p class="player-active-desc" id="activeVideoDesc">{mainVideo.description}</p>
        </div>
      </div>

      <!-- 四部核心清腸推薦卡片清單 -->
      <div class="showcase-playlist">
        <div class="playlist-header">
          <span class="playlist-icon">🎬</span>
          <h4>核心清腸與檢查短影音（點選切換）</h4>
        </div>

        <!-- 主影片本身卡片 -->
        <button
          type="button"
          class="playlist-item active"
          data-video-id={mainVideo.id}
          data-video-title={mainVideo.title}
          data-video-desc={mainVideo.description}
        >
          <div class="item-thumb-wrap">
            <img src={`https://i.ytimg.com/vi/${mainVideo.id}/hqdefault.jpg`} alt={mainVideo.title} loading="lazy" />
            <span class="play-icon">▶</span>
          </div>
          <div class="item-meta">
            <span class="item-tag tag-primary">主打推薦</span>
            <div class="item-title">{mainVideo.title}</div>
            <p class="item-desc">安心睡眠中完成，無懼鏡檢不適。</p>
          </div>
        </button>

        {coreBowelVideos.map((video) => (
          <button
            type="button"
            class="playlist-item"
            data-video-id={video.id}
            data-video-title={video.title}
            data-video-desc={video.desc}
          >
            <div class="item-thumb-wrap">
              <img src={`https://i.ytimg.com/vi/${video.id}/hqdefault.jpg`} alt={video.title} loading="lazy" />
              <span class="play-icon">▶</span>
            </div>
            <div class="item-meta">
              <span class="item-tag">{video.tag}</span>
              <div class="item-title">{video.title}</div>
              <p class="item-desc">{video.desc}</p>
            </div>
          </button>
        ))}
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════════════
       4. 核心互動表單與試算模組 (大腸鏡檢個人化時間試算表)
  ═══════════════════════════════════════════════════ -->
  <section class="endo-calc-section" id="prep-calculator">
    <div class="section-heading">
      <span class="sub-label">INTERACTIVE PREP CALCULATOR</span>
      <h2 class="main-heading">大腸鏡檢個人化時間試算表</h2>
      <p class="desc-heading">輸入您已預約的大腸鏡檢查時間，系統將精確為您推算出服藥、補水、飲食控制與絕對禁食禁水時間軸！</p>
    </div>

    <!-- 步驟 1：輸入時間與選擇藥物 -->
    <div class="calc-control-card">
      <div class="control-grid">
        <!-- 檢查時間 -->
        <div class="control-box">
          <label for="endoExamDateTime" class="control-label">
            <span class="step-num">1</span> 選擇已安排的大腸鏡檢查時間：
          </label>
          <input type="datetime-local" id="endoExamDateTime" class="datetime-input" />
          
          <div class="quick-chips">
            <span class="chip-label">快捷預設：</span>
            <button type="button" class="btn-chip" data-preset="tomorrow-morning">明日上午 08:30</button>
            <button type="button" class="btn-chip" data-preset="tomorrow-afternoon">明日下午 13:30</button>
            <button type="button" class="btn-chip" data-preset="dayafter-morning">後天上午 08:30</button>
          </div>
        </div>

        <!-- 藥物選擇 -->
        <div class="control-box">
          <label class="control-label">
            <span class="step-num">2</span> 選擇您所領取的清腸劑：
          </label>
          <div class="drug-tabs">
            <label class="drug-tab-label active" id="label-bowklean">
              <input type="radio" name="endoDrugType" value="bowklean" checked class="drug-radio-hidden" />
              <div class="drug-tab-content">
                <span class="drug-pill-badge badge-teal">低容量 / 水分分段喝</span>
                <span class="drug-name-text">保可淨 (Bowklean)</span>
                <p class="drug-hint-text">單包以 150c.c. 冷水泡開，分兩劑服用，含鎂成分口感佳。</p>
              </div>
            </label>

            <label class="drug-tab-label" id="label-niflec">
              <input type="radio" name="endoDrugType" value="niflec" class="drug-radio-hidden" />
              <div class="drug-tab-content">
                <span class="drug-pill-badge badge-amber">等滲透壓 / 2000c.c.</span>
                <span class="drug-name-text">耐福利散 (Niflec)</span>
                <p class="drug-hint-text">整包以 2000c.c. 冷開水沖泡分段飲用，⚠️ 絕不可乾吞藥粉。</p>
              </div>
            </label>
          </div>
        </div>
      </div>
    </div>

    <!-- 步驟 2：動態生成的時間軸結果卡片 -->
    <div class="schedule-result-card" id="scheduleResultCard">
      <div class="result-header">
        <div class="result-header-main">
          <span class="result-badge" id="displayDrugBadge">保可淨 (Bowklean) 專屬服藥時間表</span>
          <h3 class="result-title">您的個人清腸準備時間軸</h3>
          <div class="result-exam-time" id="displayExamTime">📅 預約檢查時間：載入中...</div>
        </div>
        <div class="result-actions">
          <button type="button" class="btn-tool-action" id="btnEndoPrint">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><polyline points="6 9 6 2 18 2 18 9"/><path d="M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2"/><rect x="6" y="14" width="12" height="8"/></svg>
            列印 / 存 PDF
          </button>
          <button type="button" class="btn-tool-action primary" id="btnEndoCopy">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>
            複製 LINE 提醒
          </button>
        </div>
      </div>

      <!-- 時間軸節點容器 -->
      <div class="timeline-nodes-wrap" id="endoTimelineContainer">
        <!-- JS 動態填入 -->
      </div>

      <div class="timeline-footer-notice">
        <strong>⚠️ 專科醫師溫馨叮嚀：</strong>
        若需實施無痛靜脈舒眠麻醉，在「禁水截止時間」過後<strong>嚴格禁止喝水或進食</strong>，以防止麻醉過程嘔吐引發吸入性肺炎。高血壓藥請於第二劑前一小時以少許白開水吞服；降血糖藥與胰島素於檢查當日早晨請暫停使用。
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════════════
       5. 飲食準備：低渣飲食指南 (紅黃綠燈圖鑑)
  ═══════════════════════════════════════════════════ -->
  <section class="endo-diet-section" id="diet-guide">
    <div class="section-heading">
      <span class="sub-label">DIETARY INSTRUCTIONS</span>
      <h2 class="main-heading">檢查前飲食指南：低渣飲食與清流質</h2>
      <p class="desc-heading">清腸藥只能排除糞便，無法溶解高纖維蔬菜植物渣。請於檢查前 2 至 3 天落實低渣飲食！</p>
    </div>

    <div class="diet-cards-grid">
      <!-- 綠燈：可吃 -->
      <div class="diet-box allow-box">
        <div class="diet-box-head">
          <span class="status-icon">⭕</span>
          <div>
            <h3>推薦攝取（低渣精緻食物）</h3>
            <p>好消化、無粗纖維殘渣</p>
          </div>
        </div>
        <ul class="diet-check-list">
          <li><strong>主食類：</strong> 白稀飯、白飯、白吐司、白麵條、去包子皮、白饅頭。</li>
          <li><strong>蛋白質：</strong> 蒸蛋、水煮蛋、去皮去刺魚肉、嫩雞胸肉、清蒸嫩豆腐。</li>
          <li><strong>湯品飲品：</strong> 過濾清肉湯、清魚湯、去渣蔬果汁、黑咖啡（不加奶）、無渣茶水、運動飲料。</li>
        </ul>
      </div>

      <!-- 紅燈：忌吃 -->
      <div class="diet-box deny-box">
        <div class="diet-box-head">
          <span class="status-icon">❌</span>
          <div>
            <h3>嚴格禁食（高纖油膩難消化）</h3>
            <p>會在腸道壁黏附殘渣，影響息肉判讀</p>
          </div>
        </div>
        <ul class="diet-check-list danger">
          <li><strong>高纖維蔬菜水果：</strong> 蔬菜根莖、葉菜、筍類、芹菜、芭樂、奇異果、番茄、火龍果、草莓等帶籽水果。</li>
          <li><strong>全穀雜糧與堅果：</strong> 糙米、燕麥、全麥麵包、芝麻、核桃、杏仁、黑豆等。</li>
          <li><strong>乳製品與豆漿：</strong> 牛奶、優酪乳、起司、未過濾濃豆漿（乳酪與奶類會形成黏稠白色凝乳）。</li>
          <li><strong>油炸與高油食物：</strong> 油條、炸雞、五花肉、麻辣鍋、高油糕點。</li>
        </ul>
      </div>
    </div>

    <!-- 慢性病與減重瘦瘦針專題提醒 -->
    <div class="special-med-alert">
      <div class="alert-icon-sign">💡</div>
      <div class="alert-text-body">
        <h4>慢性病與減重「瘦瘦針 (GLP-1)」用藥重要須知</h4>
