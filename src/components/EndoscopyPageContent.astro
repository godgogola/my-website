<script>
  // ── 影音切換與時間軸試算客戶端腳本 ──
  document.addEventListener('DOMContentLoaded', () => {
    // ═══════════════════════════════════════════════════
    // 1. 影音 Showcase 切換邏輯
    // ═══════════════════════════════════════════════════
    const mainIframe = document.getElementById('mainPlayerIframe') as HTMLIFrameElement;
    const activeTitle = document.getElementById('activeVideoTitle');
    const activeDesc = document.getElementById('activeVideoDesc');
    const playlistItems = document.querySelectorAll('.playlist-item');
    const extraCards = document.querySelectorAll('.extra-video-card');

    function switchVideo(videoId: string, title: string, desc: string, targetEl?: Element) {
      if (mainIframe) {
        mainIframe.src = `https://www.youtube.com/embed/${videoId}?autoplay=1&rel=0`;
      }
      if (activeTitle) activeTitle.textContent = title;
      if (activeDesc) activeDesc.textContent = desc;

      playlistItems.forEach(item => item.classList.remove('active'));
      if (targetEl && targetEl.classList.contains('playlist-item')) {
        targetEl.classList.add('active');
      }

      // 平滑捲動至播放器
      const showcase = document.getElementById('video-showcase');
      if (showcase) {
        showcase.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
      }
    }

    playlistItems.forEach(item => {
      item.addEventListener('click', () => {
        const id = item.getAttribute('data-video-id') || '';
        const title = item.getAttribute('data-video-title') || '';
        const desc = item.getAttribute('data-video-desc') || '';
        switchVideo(id, title, desc, item);
      });
    });

    extraCards.forEach(card => {
      card.addEventListener('click', () => {
        const id = card.getAttribute('data-video-id') || '';
        const title = card.getAttribute('data-video-title') || '';
        const desc = card.getAttribute('data-video-desc') || '';
        switchVideo(id, title, desc);
      });
    });

    // ═══════════════════════════════════════════════════
    // 2. 清腸時間軸計算邏輯
    // ═══════════════════════════════════════════════════
    const examInput = document.getElementById('endoExamDateTime') as HTMLInputElement;
    const drugRadios = document.querySelectorAll('input[name="endoDrugType"]') as NodeListOf<HTMLInputElement>;
    const timelineWrap = document.getElementById('endoTimelineContainer');
    const displayDrugBadge = document.getElementById('displayDrugBadge');
    const displayExamTime = document.getElementById('displayExamTime');
    const labelBowklean = document.getElementById('label-bowklean');
    const labelNiflec = document.getElementById('label-niflec');
    const btnPrint = document.getElementById('btnEndoPrint');
    const btnCopy = document.getElementById('btnEndoCopy');
    const presetBtns = document.querySelectorAll('.btn-chip');

    // 預設將時間設為「明天 08:30」
    function setDefaultDateTime() {
      if (!examInput) return;
      const now = new Date();
      const tomorrow = new Date(now.getFullYear(), now.getMonth(), now.getDate() + 1, 8, 30);
      const pad = (n: number) => n.toString().padStart(2, '0');
      examInput.value = `${tomorrow.getFullYear()}-${pad(tomorrow.getMonth() + 1)}-${pad(tomorrow.getDate())}T${pad(tomorrow.getHours())}:${pad(tomorrow.getMinutes())}`;
    }

    function formatChineseDate(date: Date, showTime = true): string {
      const days = ['星期日', '星期一', '星期二', '星期三', '星期四', '星期五', '星期六'];
      const pad = (n: number) => n.toString().padStart(2, '0');
      const str = `${date.getFullYear()}/${pad(date.getMonth() + 1)}/${pad(date.getDate())} (${days[date.getDay()]})`;
      return showTime ? `${str} ${pad(date.getHours())}:${pad(date.getMinutes())}` : str;
    }

    function updateDrugStyle() {
      const drug = (document.querySelector('input[name="endoDrugType"]:checked') as HTMLInputElement)?.value || 'bowklean';
      if (drug === 'bowklean') {
        labelBowklean?.classList.add('active');
        labelNiflec?.classList.remove('active');
      } else {
        labelNiflec?.classList.add('active');
        labelBowklean?.classList.remove('active');
      }
    }

    function calculateTimeline() {
      if (!examInput || !examInput.value || !timelineWrap) return;
      const examDate = new Date(examInput.value);
      if (isNaN(examDate.getTime())) return;

      const drug = (document.querySelector('input[name="endoDrugType"]:checked') as HTMLInputElement)?.value || 'bowklean';

      // 檢查前2天
      const dayMinus2 = new Date(examDate);
      dayMinus2.setDate(examDate.getDate() - 2);

      // 檢查前1天
      const dayMinus1 = new Date(examDate);
      dayMinus1.setDate(examDate.getDate() - 1);

      // 前一晚第一劑 (保可淨 17:00-19:00 / 耐福利散 19:00)
      const dose1Time = new Date(dayMinus1);
      dose1Time.setHours(drug === 'bowklean' ? 17 : 19, 0, 0);

      // 當天早晨第二劑 (檢查前4~5小時，預設 04:00)
      const dose2Time = new Date(examDate);
      dose2Time.setHours(4, 0, 0);

      // 高血壓藥時間 (第二劑前1小時，03:00)
      const bpTime = new Date(dose2Time);
      bpTime.setHours(dose2Time.getHours() - 1);

      // 禁水截止時限 (檢查前3小時)
      const npoTime = new Date(examDate);
      npoTime.setHours(examDate.getHours() - 3, examDate.getMinutes());

      // 更新頂部顯示
      if (displayDrugBadge) {
        displayDrugBadge.textContent = drug === 'bowklean' ? '保可淨 (Bowklean) 專屬服藥時間表' : '耐福利散 (Niflec Powder) 專屬服藥時間表';
      }
      if (displayExamTime) {
        displayExamTime.textContent = `📅 預約檢查時間：${formatChineseDate(examDate)}`;
      }

      let html = '';

      // 節點 1：前 2~3 天低渣飲食
      html += `
        <div class="endo-timeline-item">
          <div class="endo-node-top">
            <span class="endo-node-tag">飲食準備</span>
            <span class="endo-node-time">${formatChineseDate(dayMinus2, false)} 起</span>
          </div>
          <div class="endo-node-title">開始嚴格採行「低渣飲食」</div>
          <p class="endo-node-desc">食用白粥、白吐司、去皮魚肉、去皮蒸蛋。絕對禁食高纖蔬菜、水果、堅果、乳製品與豆漿。</p>
          <div class="endo-node-tip">💡 習慣性便秘者建議提前於檢查前 5~7 天即開始進行低渣飲食。</div>
        </div>
      `;

      // 節點 2：檢查前一天清流質與早晚餐
      html += `
        <div class="endo-timeline-item">
          <div class="endo-node-top">
            <span class="endo-node-tag">前日飲食</span>
            <span class="endo-node-time">${formatChineseDate(dayMinus1, false)}</span>
          </div>
          <div class="endo-node-title">檢查前一天飲食與晚餐禁食</div>
          <p class="endo-node-desc">早餐與午餐僅可食用白稀飯或白吐司。<strong>下午 16:00 起全面禁食固體食物</strong>，僅可飲用無渣清流質（如過濾清肉湯、無渣運動飲料、冬瓜茶、蜂蜜水）。</p>
        </div>
      `;

      // 節點 3：第一劑服藥
      if (drug === 'bowklean') {
        html += `
          <div class="endo-timeline-item">
            <div class="endo-node-top">
              <span class="endo-node-tag">第一劑服藥</span>
              <span class="endo-node-time">${formatChineseDate(dose1Time, false)} 17:00 ~ 19:00</span>
            </div>
            <div class="endo-node-title">服用保可淨 (Bowklean) 第 1 劑</div>
            <p class="endo-node-desc">以 150c.c. 冷水沖泡攪拌均勻後一口飲盡。並於服藥後 2 小時內<strong>分次補充 1500 ~ 2000c.c. 水分或清流質</strong>。</p>
            <div class="endo-node-tip">⚠️ 保可淨遇水會微放熱，絕不可直接乾吞藥粉！</div>
          </div>
        `;
      } else {
        html += `
          <div class="endo-timeline-item">
            <div class="endo-node-top">
              <span class="endo-node-tag">第一劑服藥</span>
              <span class="endo-node-time">${formatChineseDate(dose1Time, false)} 19:00</span>
            </div>
            <div class="endo-node-title">沖泡並飲用耐福利散 (Niflec) 前 1000c.c.</div>
            <p class="endo-node-desc">將整包藥粉倒入耐福力散專用塑膠罐中，加入冷開水至 2000c.c. 刻度搖勻。今晚先每 15 分鐘飲用 250c.c.，2 小時內喝完前 1000c.c.。</p>
            <div class="endo-node-tip">⚠️ 耐福利散為等滲透壓劑型，務必整罐加足 2 公升冷開水沖泡！</div>
          </div>
        `;
      }

      // 節點 4：高血壓用藥注意 (當日清晨 03:00)
      html += `
        <div class="endo-timeline-item">
          <div class="endo-node-top">
            <span class="endo-node-tag">藥物調整</span>
            <span class="endo-node-time">${formatChineseDate(bpTime)}</span>
          </div>
          <div class="endo-node-title">高血壓用藥服用（第二劑清腸藥前 1 小時）</div>
          <p class="endo-node-desc">若有服用高血壓藥物，請配<strong>一小口白開水 (約 30c.c.)</strong>吞服，維持血壓平穩。糖尿病降血糖藥物與胰島素於今晨暫停使用。</p>
        </div>
      `;

      // 節點 5：第二劑服藥
      if (drug === 'bowklean') {
        html += `
          <div class="endo-timeline-item">
            <div class="endo-node-top">
              <span class="endo-node-tag">第二劑服藥</span>
              <span class="endo-node-time">${formatChineseDate(dose2Time)}</span>
            </div>
            <div class="endo-node-title">服用保可淨 (Bowklean) 第 2 劑</div>
            <p class="endo-node-desc">同樣以 150c.c. 冷水沖泡一口飲盡。隨後於 1~2 小時內<strong>分次補充至少 750 ~ 1000c.c. 開水</strong>，促使腸道殘餘糞水徹底排空呈清澈黃色液體。</p>
          </div>
        `;
      } else {
        html += `
          <div class="endo-timeline-item">
            <div class="endo-node-top">
              <span class="endo-node-tag">第二劑服藥</span>
              <span class="endo-node-time">${formatChineseDate(dose2Time)}</span>
            </div>
            <div class="endo-node-title">飲用耐福利散 (Niflec) 剩餘 1000c.c.</div>
            <p class="endo-node-desc">將冷藏之剩餘 1000c.c. 藥水，以每 15 分鐘喝 250c.c. 的速度飲用完畢，並配合適度室內走動促進排便。</p>
          </div>
        `;
      }

      // 節點 6：絕對禁食禁水 (Critical)
      html += `
        <div class="endo-timeline-item item-critical">
          <div class="endo-node-top">
            <span class="endo-node-tag tag-danger">重要時限</span>
            <span class="endo-node-time">${formatChineseDate(npoTime)}</span>
          </div>
          <div class="endo-node-title">⛔ 嚴格禁止喝水與進食 (NPO 截止)</div>
          <p class="endo-node-desc">此時間點為<strong>檢查前 3 小時</strong>。若實施舒眠無痛麻醉，此時起<strong>滴水不沾、連藥水與白開水都不可喝</strong>，避免麻醉引起嗆咳與吸入性肺炎危險！</p>
          <div class="endo-node-tip tip-danger">🚨 務必確保腸道排出物已呈現「無渣清澈透明淡黃色液體」。</div>
        </div>
      `;

      // 節點 7：報到與檢查
      html += `
        <div class="endo-timeline-item">
          <div class="endo-node-top">
            <span class="endo-node-tag">當日檢查</span>
            <span class="endo-node-time">${formatChineseDate(examDate)}</span>
          </div>
          <div class="endo-node-title">🏥 準時至豐田診所報到接受無痛腸胃鏡檢查</div>
          <p class="endo-node-desc">請攜帶健保卡、身分證，著輕便寬鬆衣物，勿配戴隱形眼鏡與金屬飾品。舒眠麻醉後<strong>請勿自行騎車或開車</strong>，建議由親友陪同。</p>
        </div>
      `;

      timelineWrap.innerHTML = html;
    }

    // 快速按鈕事件
    presetBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        const type = btn.getAttribute('data-preset');
        const now = new Date();
        let target = new Date();
        if (type === 'tomorrow-morning') {
          target = new Date(now.getFullYear(), now.getMonth(), now.getDate() + 1, 8, 30);
        } else if (type === 'tomorrow-afternoon') {
          target = new Date(now.getFullYear(), now.getMonth(), now.getDate() + 1, 13, 30);
        } else if (type === 'dayafter-morning') {
          target = new Date(now.getFullYear(), now.getMonth(), now.getDate() + 2, 8, 30);
        }
        const pad = (n: number) => n.toString().padStart(2, '0');
        if (examInput) {
          examInput.value = `${target.getFullYear()}-${pad(target.getMonth() + 1)}-${pad(target.getDate())}T${pad(target.getHours())}:${pad(target.getMinutes())}`;
          calculateTimeline();
        }
      });
    });

    if (examInput) {
      examInput.addEventListener('change', calculateTimeline);
    }
    drugRadios.forEach(radio => {
      radio.addEventListener('change', () => {
        updateDrugStyle();
        calculateTimeline();
      });
    });

    // 列印按鈕
    btnPrint?.addEventListener('click', () => {
      window.print();
    });

    // 複製文字按鈕
    btnCopy?.addEventListener('click', () => {
      if (!examInput || !examInput.value) return;
      const examDate = new Date(examInput.value);
      const drug = (document.querySelector('input[name="endoDrugType"]:checked') as HTMLInputElement)?.value || 'bowklean';
      const drugName = drug === 'bowklean' ? '保可淨 (Bowklean)' : '耐福利散 (Niflec)';

      const text = `【豐田診所 大腸鏡清腸提醒】
📅 預約檢查時間：${formatChineseDate(examDate)}
💊 清腸藥物：${drugName}
📌 重點時程：
1. 檢查前 2~3 天開始採行低渣飲食（禁食蔬菜水果與奶製品）
2. 檢查前一日 16:00 起禁食固體食物，僅飲用清流質
3. 依時程服用第 1 劑與第 2 劑藥水並補足水分
4. 檢查前 3 小時起全面「嚴格禁食禁水（滴水不沾）」
⚠️ 檢查當日請攜帶健保卡，勿自行開車騎車。
更多詳情：${window.location.href}`;

      navigator.clipboard.writeText(text).then(() => {
        alert('已成功複製大腸鏡清腸提醒文字！可直接貼上至 LINE 傳給家人或受檢者。');
      }).catch(() => {
        prompt('請複製以下提醒文字：', text);
      });
    });

    // 初始化
    setDefaultDateTime();
    updateDrugStyle();
    calculateTimeline();

    // ═══════════════════════════════════════════════════
    // 3. 自動向父視窗回報高度 (Wix iFrame Auto-Resize 通訊)
    // ═══════════════════════════════════════════════════
    function notifyParentHeight() {
      if (window.parent && window.parent !== window) {
        const height = document.documentElement.scrollHeight || document.body.scrollHeight;
        window.parent.postMessage({ type: 'resize', height: height }, '*');
      }
    }
    window.addEventListener('load', notifyParentHeight);
    window.addEventListener('resize', notifyParentHeight);
    setTimeout(notifyParentHeight, 500);
    setTimeout(notifyParentHeight, 1500);
  });
</script>
