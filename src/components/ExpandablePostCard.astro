---
/**
 * ExpandablePostCard.astro — SmoothUI 可展開式衛教文章卡片元件
 *
 * 特色：
 * 1. 預設狀態：高質感滿版封面圖、白色浮雕標題、微透光分類膠囊、查看簡介按鈕。
 * 2. 展開狀態（SmoothUI 動畫）：平滑展開資訊面板，呈現衛教重點摘要、黃醫師認證資訊與「閱讀全文」按鈕。
 * 3. 完美支援 RWD：電腦版橫向平滑延展，手機版優雅向下展開。
 */
import { Image } from 'astro:assets';

interface Props {
  title: string;
  href: string;
  category: string;
  publishDate: Date;
  summary?: string;
  coverImage?: string;
  cardId?: string | number;
}

const { title, href, category, publishDate, summary, coverImage, cardId } = Astro.props;

// 格式化日期
const formattedDate = new Intl.DateTimeFormat('zh-TW', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
}).format(publishDate);

// 使用 import.meta.glob 編譯時處理圖片
const allImages = import.meta.glob<{ default: ImageMetadata }>(
  '../assets/images/**/*.{png,jpg,jpeg,webp,avif}',
  { eager: true }
);

const isExternalImage = coverImage && (coverImage.startsWith('http://') || coverImage.startsWith('https://'));
const isPublicImage = coverImage && !isExternalImage;
const publicImageSrc = isPublicImage ? `/images/${coverImage}` : null;

let resolvedImage: ImageMetadata | null = null;
if (coverImage && !isExternalImage) {
  const matchKey = Object.keys(allImages).find(
    (key) => key.endsWith(`/${coverImage}`) || key === `../assets/images/${coverImage}`
  );
  if (matchKey) {
    resolvedImage = allImages[matchKey].default;
  }
}

// 預設頭像與作者
const authorAvatar = "https://static.wixstatic.com/media/f229cb_5dcb4100d96e46e1bab7ea4cb7062215~mv2.jpg";
const authorName = "黃冠智 醫師";
const authorRole = "豐田診所院長 / 肝膽腸胃專科";
---

<div
  class="expandable-card"
  data-expandable-card
  data-card-id={cardId || title}
  role="button"
  tabindex="0"
  aria-expanded="false"
  aria-label={`${title}，點擊展開查看摘要`}
>
  <!-- 左側／主體：封面圖片與標題層 -->
  <div class="card-cover-side">
    <div class="cover-image-box">
      {isExternalImage ? (
        <img
          src={coverImage}
          alt={title}
          class="cover-img"
          loading="lazy"
          decoding="async"
        />
      ) : publicImageSrc ? (
        <img
          src={publicImageSrc}
          alt={title}
          class="cover-img"
          loading="lazy"
          decoding="async"
        />
      ) : resolvedImage ? (
        <Image
          src={resolvedImage}
          alt={title}
          class="cover-img"
          format="webp"
          quality={85}
          loading="lazy"
          decoding="async"
        />
      ) : (
        <div class="cover-placeholder">
          <svg viewBox="0 0 60 60" width="48" height="48" fill="none" aria-hidden="true">
            <rect x="4" y="14" width="52" height="36" rx="4" stroke="currentColor" stroke-width="2"/>
            <circle cx="18" cy="28" r="5" stroke="currentColor" stroke-width="2"/>
            <path d="M4 38 L20 26 L32 36 L42 28 L56 38" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/>
          </svg>
        </div>
      )}
    </div>

    <!-- 圖片暗色微透光遮罩 -->
    <div class="cover-gradient-overlay" aria-hidden="true"></div>

    <!-- 頂部與底部懸浮文字 -->
    <div class="cover-content-layer">
      <div class="cover-top-meta">
        <span class="cover-category-badge">{category}</span>
      </div>

      <div class="cover-bottom-meta">
        <h3 class="cover-article-title">{title}</h3>
        
        <div class="expand-trigger-row">
          <div class="expand-indicator-btn" aria-hidden="true">
            <svg class="icon-expand" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.5">
              <path d="M12 5v14M5 12h14" stroke-linecap="round"/>
            </svg>
            <svg class="icon-collapse" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.5">
              <path d="M5 12h14" stroke-linecap="round"/>
            </svg>
          </div>
          <span class="expand-hint-text">查看簡介</span>
        </div>
      </div>
    </div>
  </div>

  <!-- 右側／展開面板：詳細摘要與導流區 -->
  <div class="card-detail-panel" aria-hidden="true">
    <div class="panel-inner">
      <div class="panel-header">
        <div class="panel-date-badge">
          <svg viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2">
            <rect x="3" y="4" width="18" height="18" rx="2" ry="2"/>
            <line x1="16" y1="2" x2="16" y2="6"/>
            <line x1="8" y1="2" x2="8" y2="6"/>
            <line x1="3" y1="10" x2="21" y2="10"/>
          </svg>
          <span>{formattedDate}</span>
        </div>
        <span class="panel-category-tag">{category}</span>
      </div>

      <div class="panel-body">
        <h4 class="panel-title">{title}</h4>
        <p class="panel-summary">{summary || '點擊下方按鈕閱讀完整衛教專欄文章。'}</p>
      </div>

      <div class="panel-footer">
        <!-- 醫師認證小卡 -->
        <div class="author-badge-card">
          <img src={authorAvatar} alt={authorName} class="author-avatar-img" />
          <div class="author-info">
            <span class="author-name">{authorName}</span>
            <span class="author-role">{authorRole}</span>
          </div>
        </div>

        <!-- 閱讀全文按鈕 -->
        <a
          href={href}
          class="read-full-btn"
          onclick="event.stopPropagation();"
          aria-label={`前往閱讀：${title}`}
        >
          <span>閱讀全文</span>
          <svg viewBox="0 0 20 20" width="16" height="16" fill="none" aria-hidden="true">
            <path d="M4 10h12M11 5l5 5-5 5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </a>
      </div>
    </div>
  </div>
</div>

<style>
  /* ═══════════════════════════════════════
     SmoothUI Expandable Card 基礎結構
     ═══════════════════════════════════════ */
  .expandable-card {
    position: relative;
    display: flex;
    flex-direction: row;
    height: 330px;
    width: 230px;
    min-width: 230px;
    border-radius: 20px;
    overflow: hidden;
    background-color: var(--color-bg-card, #FFFFFF);
    border: 1px solid var(--color-border, #E2EAE6);
    box-shadow: 0 8px 24px var(--color-shadow, rgba(47, 102, 86, 0.08));
    cursor: pointer;
    user-select: none;
    outline: none;
    scroll-snap-align: start;
    flex-shrink: 0;
    transition:
      width 0.4s cubic-bezier(0.23, 1, 0.32, 1),
      height 0.4s cubic-bezier(0.23, 1, 0.32, 1),
      transform 0.3s cubic-bezier(0.23, 1, 0.32, 1),
      box-shadow 0.3s ease,
      border-color 0.3s ease;
  }

  .expandable-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 14px 32px rgba(47, 102, 86, 0.14);
    border-color: rgba(47, 102, 86, 0.3);
  }

  .expandable-card:focus-visible {
    ring: 2px solid var(--color-primary, #2F6656);
    outline: 2px solid var(--color-primary, #2F6656);
    outline-offset: 3px;
  }

  /* 展開狀態（Carousel 橫向） */
  .expandable-card.is-expanded {
    width: 550px;
    border-color: var(--color-primary, #2F6656);
    box-shadow: 0 18px 40px rgba(47, 102, 86, 0.18);
  }

  /* ── 網格佈局（Grid Item）適配 ── */
  :global(.grid-item) .expandable-card {
    width: 100%;
    min-width: 0;
  }

  :global(.grid-item) .expandable-card:not(.is-expanded) .card-cover-side {
    width: 100%;
    min-width: 0;
  }

  :global(.grid-item) .expandable-card.is-expanded .card-cover-side {
    width: 240px;
    min-width: 240px;
  }

  :global(.grid-item) .expandable-card.is-expanded .card-detail-panel {
    width: auto;
    flex-grow: 1;
  }

  /* ── 左側封面區 ── */
  .card-cover-side {
    position: relative;
    width: 230px;
    min-width: 230px;
    height: 100%;
    overflow: hidden;
    flex-shrink: 0;
    background: #1e332a;
    transition: width 0.4s cubic-bezier(0.23, 1, 0.32, 1);
  }

  .cover-image-box {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .cover-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    transition: transform 0.5s cubic-bezier(0.23, 1, 0.32, 1);
  }

  .expandable-card:hover .cover-img {
    transform: scale(1.05);
  }

  .cover-placeholder {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    background: linear-gradient(135deg, var(--color-primary), #1b4332);
    color: rgba(255, 255, 255, 0.6);
  }

  .cover-gradient-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      180deg,
      rgba(0, 0, 0, 0.35) 0%,
      rgba(0, 0, 0, 0.1) 40%,
      rgba(0, 0, 0, 0.85) 100%
    );
    z-index: 1;
    pointer-events: none;
    transition: background 0.3s ease;
  }

  .cover-content-layer {
    position: absolute;
    inset: 0;
    z-index: 2;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding: 16px;
    color: #FFFFFF;
  }

  .cover-category-badge {
    display: inline-block;
    background: rgba(255, 255, 255, 0.22);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    color: #FFFFFF;
    font-size: 0.76rem;
    font-weight: 700;
    padding: 4px 11px;
    border-radius: 999px;
    border: 1px solid rgba(255, 255, 255, 0.35);
    letter-spacing: 0.3px;
    text-shadow: 0 1px 2px rgba(0, 0, 0, 0.4);
  }

  .cover-bottom-meta {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .cover-article-title {
    font-size: 1.15rem;
    font-weight: 800;
    line-height: 1.35;
    color: #FFFFFF;
    text-shadow: 0 2px 8px rgba(0, 0, 0, 0.8);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    margin: 0;
  }

  .expand-trigger-row {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .expand-indicator-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.25);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    border: 1px solid rgba(255, 255, 255, 0.4);
    color: #FFFFFF;
    transition: transform 0.25s ease, background 0.25s ease;
  }

  .expandable-card:hover .expand-indicator-btn {
    transform: scale(1.1);
    background: rgba(255, 255, 255, 0.4);
  }

  .icon-expand {
    display: block;
  }
  .icon-collapse {
    display: none;
  }

  .expandable-card.is-expanded .icon-expand {
    display: none;
  }
  .expandable-card.is-expanded .icon-collapse {
    display: block;
  }

  .expand-hint-text {
    font-size: 0.8rem;
    font-weight: 600;
    color: rgba(255, 255, 255, 0.9);
    text-shadow: 0 1px 3px rgba(0, 0, 0, 0.6);
  }

  /* ── 右側展開面板 ── */
  .card-detail-panel {
    position: relative;
    width: 0;
    height: 100%;
    overflow: hidden;
    background-color: var(--color-bg-card, #FFFFFF);
    opacity: 0;
    filter: blur(6px);
    transition:
      width 0.4s cubic-bezier(0.23, 1, 0.32, 1),
      opacity 0.3s cubic-bezier(0.23, 1, 0.32, 1) 0.08s,
      filter 0.3s cubic-bezier(0.23, 1, 0.32, 1) 0.08s;
  }

  .expandable-card.is-expanded .card-detail-panel {
    width: 320px;
    opacity: 1;
    filter: blur(0px);
    pointer-events: auto;
  }

  .panel-inner {
    width: 100%;
    min-width: 280px;
    height: 100%;
    padding: 22px 20px;
    box-sizing: border-box;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
  }

  .panel-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 8px;
  }

  .panel-date-badge {
    display: flex;
    align-items: center;
    gap: 5px;
    font-size: 0.78rem;
    color: var(--color-text-muted, #607369);
    font-weight: 500;
  }

  .panel-category-tag {
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--color-primary, #2F6656);
    background: var(--color-primary-light, #E8F2EE);
    padding: 2px 8px;
    border-radius: 6px;
  }

  .panel-body {
    flex-grow: 1;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 8px;
    margin: 6px 0 14px;
  }

  .panel-title {
    font-size: 1.05rem;
    font-weight: 800;
    color: var(--color-primary, #2F6656);
    line-height: 1.35;
    margin: 0;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .panel-summary {
    font-size: 0.85rem;
    color: var(--color-text-body, #2C3E35);
    line-height: 1.55;
    margin: 0;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .panel-footer {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .author-badge-card {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 8px 10px;
    background: rgba(188, 138, 74, 0.08);
    border-radius: 10px;
    border: 1px solid rgba(188, 138, 74, 0.18);
  }

  .author-avatar-img {
    width: 34px;
    height: 34px;
    border-radius: 50%;
    object-fit: cover;
    border: 1.5px solid var(--color-accent, #BC8A4A);
  }

  .author-info {
    display: flex;
    flex-direction: column;
    line-height: 1.25;
  }

  .author-name {
    font-size: 0.82rem;
    font-weight: 800;
    color: var(--color-primary, #2F6656);
  }

  .author-role {
    font-size: 0.7rem;
    color: var(--color-text-muted, #607369);
    font-weight: 500;
  }

  .read-full-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    background: linear-gradient(135deg, var(--color-primary, #2F6656), #1b4332);
    color: #FFFFFF;
    font-size: 0.88rem;
    font-weight: 700;
    padding: 9px 16px;
    border-radius: 10px;
    text-decoration: none;
    box-shadow: 0 4px 12px rgba(47, 102, 86, 0.2);
    transition: transform 0.2s ease, box-shadow 0.2s ease, background 0.2s ease;
  }

  .read-full-btn:hover {
    transform: translateY(-2px);
    box-shadow: 0 6px 16px rgba(47, 102, 86, 0.3);
    background: linear-gradient(135deg, #3d806d, #2F6656);
    color: #FFFFFF;
  }

  /* ═══════════════════════════════════════
     手機版（Mobile RWD）適配
     ═══════════════════════════════════════ */
  @media (max-width: 640px) {
    .expandable-card {
      width: 100% !important;
      min-width: 0 !important;
      height: 280px;
      flex-direction: column;
    }

    .expandable-card.is-expanded {
      width: 100% !important;
      height: 520px;
    }

    .card-cover-side {
      width: 100% !important;
      min-width: 0 !important;
      height: 280px;
    }

    .expandable-card.is-expanded .card-cover-side {
      height: 200px;
    }

    .card-detail-panel {
      width: 100% !important;
      height: 0;
    }

    .expandable-card.is-expanded .card-detail-panel {
      width: 100% !important;
      height: 320px;
    }

    .panel-inner {
      width: 100%;
      min-width: 0;
      padding: 16px;
    }

    .panel-summary {
      -webkit-line-clamp: 2;
    }
  }
</style>
