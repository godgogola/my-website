---
interface Props {
  title: string;
  href: string;
  category: string;
  publishDate: string | Date;
  coverImage?: string;
}

const {
  title,
  href,
  category,
  publishDate,
  coverImage,
} = Astro.props;

// 正規化封面圖路徑
const getCoverImageUrl = (img?: string) => {
  if (!img) return '/images/og-default.jpg';
  const trimmed = img.trim();
  if (trimmed.startsWith('http://') || trimmed.startsWith('https://')) return trimmed;
  if (trimmed.startsWith('/')) return trimmed;
  return `/images/${trimmed}`;
};

const finalCoverImage = getCoverImageUrl(coverImage);

const formatDate = (date: string | Date) => {
  if (!date) return '';
  const d = new Date(date);
  return `${d.getFullYear()}年${d.getMonth() + 1}月${d.getDate()}日`;
};
---

<a href={href} class="media-post-card" aria-label={`閱讀文章：${title}`}>
  <!-- 滿版背景圖層 -->
  <div class="card-bg-layer">
    <img
      src={finalCoverImage}
      alt={title}
      class="card-img"
      loading="lazy"
      onerror="this.onerror=null; this.src='/images/og-default.jpg';"
    />
  </div>

  <!-- 深色黑曜漸層覆蓋層 -->
  <div class="card-gradient-overlay"></div>

  <!-- 內容層 (黑曜毛玻璃標籤 + 標題與動作) -->
  <div class="card-overlay-content">
    <!-- 頂部：分類標籤與日期 -->
    <div class="card-top-row">
      <span class="category-pill-badge">
        <span class="pill-emerald-dot"></span>
        <span>{category}</span>
      </span>
      <span class="date-badge">{formatDate(publishDate)}</span>
    </div>

    <!-- 底部：文章標題與閱讀箭頭 -->
    <div class="card-bottom-row">
      <h3 class="card-article-title">{title}</h3>
      <div class="card-action-hint">
        <span class="action-text">閱讀完整筆記</span>
        <div class="action-arrow-circle" aria-hidden="true">
          <svg viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round">
            <line x1="7" y1="17" x2="17" y2="7"></line>
            <polyline points="7 7 17 7 17 17"></polyline>
          </svg>
        </div>
      </div>
    </div>
  </div>
</a>

<style>
  /* ================================================================
     UI/UX Pro Max — Obsidian & Liquid Chrome Article Card
     ================================================================ */
  .media-post-card {
    position: relative;
    display: flex;
    flex-direction: column;
    height: 290px;
    width: 100%;
    border-radius: 20px;
    overflow: hidden;
    background-color: #11141B;
    border: 1px solid rgba(255, 255, 255, 0.08);
    box-shadow: 0 12px 28px -6px rgba(0, 0, 0, 0.65), 0 0 1px 1px rgba(255, 255, 255, 0.06);
    text-decoration: none;
    color: #FFFFFF;
    box-sizing: border-box;
    transition: all 0.35s cubic-bezier(0.16, 1, 0.3, 1);
    isolation: isolate;
  }

  .media-post-card:hover {
    transform: translateY(-6px);
    box-shadow: 0 22px 48px -8px rgba(0, 0, 0, 0.85), 0 0 24px rgba(16, 185, 129, 0.12), 0 0 1px 1px rgba(255, 255, 255, 0.28);
    border-color: rgba(255, 255, 255, 0.28);
  }

  /* 滿版背景圖層 */
  .card-bg-layer {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: 0;
    background: #0B0E14;
  }

  .card-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    display: block;
    transition: transform 0.6s cubic-bezier(0.16, 1, 0.3, 1), filter 0.4s ease;
    filter: brightness(1.08) contrast(1.02);
  }

  .media-post-card:hover .card-img {
    transform: scale(1.06);
    filter: brightness(1.15) contrast(1.04);
  }

  /* 黑曜漸層覆蓋層（柔和透亮，凸顯溫馨童話立體質感同時確保文字可讀） */
  .card-gradient-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      180deg,
      rgba(9, 11, 15, 0.32) 0%,
      rgba(9, 11, 15, 0.0) 25%,
      rgba(9, 11, 15, 0.15) 55%,
      rgba(9, 11, 15, 0.88) 100%
    );
    z-index: 1;
    pointer-events: none;
    transition: background 0.35s ease;
  }

  .media-post-card:hover .card-gradient-overlay {
    background: linear-gradient(
      180deg,
      rgba(9, 11, 15, 0.38) 0%,
      rgba(9, 11, 15, 0.02) 25%,
      rgba(9, 11, 15, 0.2) 55%,
      rgba(9, 11, 15, 0.92) 100%
    );
  }

  /* 內容覆蓋層 */
  .card-overlay-content {
    position: relative;
    z-index: 2;
    height: 100%;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding: 18px 20px;
    box-sizing: border-box;
  }

  /* 頂部排版 */
  .card-top-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
  }

  /* 科技黑曜微光膠囊標籤 */
  .category-pill-badge {
    background: rgba(10, 13, 19, 0.82);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    color: #E2E8F0;
    font-size: 0.78rem;
    font-weight: 700;
    padding: 4px 12px;
    border-radius: 9999px;
    border: 1px solid rgba(255, 255, 255, 0.18);
    letter-spacing: 0.02em;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    box-shadow: 0 4px 14px rgba(0, 0, 0, 0.4), inset 0 1px 1px rgba(255, 255, 255, 0.12);
  }
  .pill-emerald-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #10B981;
    box-shadow: 0 0 6px #10B981;
    flex-shrink: 0;
  }

  .date-badge {
    font-size: 0.76rem;
    color: #94A3B8;
    font-weight: 600;
    letter-spacing: 0.02em;
    text-shadow: 0 1px 3px rgba(0, 0, 0, 0.8);
  }

  /* 底部排版 */
  .card-bottom-row {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .card-article-title {
    font-size: 1.15rem;
    font-weight: 800;
    line-height: 1.4;
    color: #F8FAFC;
    text-shadow: 0 2px 8px rgba(0, 0, 0, 0.9);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    margin: 0;
    letter-spacing: -0.01em;
    transition: color 0.25s ease;
  }

  .media-post-card:hover .card-article-title {
    color: #FFFFFF;
    text-shadow: 0 0 16px rgba(255, 255, 255, 0.35);
  }

  .card-action-hint {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-top: 10px;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
    color: #94A3B8;
    transition: color 0.25s ease;
  }
  .media-post-card:hover .card-action-hint {
    color: #FFFFFF;
    border-top-color: rgba(255, 255, 255, 0.18);
  }

  .action-text {
    font-size: 0.82rem;
    font-weight: 700;
    letter-spacing: 0.02em;
  }

  /* 右下角拉絲鈦金轉鍍鉻圓形光碟鈕 */
  .action-arrow-circle {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 28px;
    height: 28px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.06);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    border: 1px solid rgba(255, 255, 255, 0.18);
    color: #CBD5E1;
    transition: all 0.35s cubic-bezier(0.16, 1, 0.3, 1);
    box-shadow: inset 0 1px 1px rgba(255, 255, 255, 0.1);
  }

  .media-post-card:hover .action-arrow-circle {
    background: linear-gradient(180deg, #FFFFFF 0%, #E2E8F0 40%, #94A3B8 100%);
    color: #0A0D12;
    border-color: #FFFFFF;
    transform: scale(1.1) translate(2px, -2px);
    box-shadow: 0 0 14px rgba(255, 255, 255, 0.4), inset 0 1px 1px #FFFFFF;
  }

  @media (max-width: 640px) {
    .media-post-card {
      height: 270px;
      border-radius: 18px;
    }
    .card-overlay-content {
      padding: 16px 18px;
    }
    .card-article-title {
      font-size: 1.1rem;
    }
  }
</style>
