---
/**
 * PostCard.astro — 全景圖文衛教卡片（字在圖片中，點擊直接進入文章）
 *
 * Props:
 *   - title: 文章標題
 *   - href: 連結路徑
 *   - category: 分類標籤
 *   - publishDate: 發表日期
 *   - coverImage: 圖片檔名（例如 "胃食道逆流.png" / "胃食道逆流.webp"）
 */
import { Image } from 'astro:assets';

interface Props {
  title: string;
  href: string;
  category: string;
  publishDate: Date;
  summary?: string;
  coverImage?: string;
}

const { title, href, category, publishDate, coverImage } = Astro.props;

// 格式化日期
const formattedDate = new Intl.DateTimeFormat('zh-TW', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
}).format(publishDate);

// 使用 import.meta.glob 編譯時處理圖片
const allImages = import.meta.glob<{ default: ImageMetadata }>(
  '../assets/images/**/*.{png,jpg,jpeg,webp,avif}',
  { eager: true }
);

const isExternalImage = coverImage && (coverImage.startsWith('http://') || coverImage.startsWith('https://'));
const isPublicImage = coverImage && !isExternalImage;
const publicImageSrc = isPublicImage ? `/images/${coverImage}` : null;

let resolvedImage: ImageMetadata | null = null;
if (coverImage && !isExternalImage) {
  const matchKey = Object.keys(allImages).find(
    (key) => key.endsWith(`/${coverImage}`) || key === `../assets/images/${coverImage}`
  );
  if (matchKey) {
    resolvedImage = allImages[matchKey].default;
  }
}
---

<a href={href} class="media-post-card" aria-label={`閱讀文章：${title}`}>
  <!-- 滿版背景圖 -->
  <div class="card-bg-layer">
    {isExternalImage ? (
      <img
        src={coverImage}
        alt={title}
        class="card-img"
        loading="lazy"
        decoding="async"
      />
    ) : publicImageSrc ? (
      <img
        src={publicImageSrc}
        alt={title}
        class="card-img"
        loading="lazy"
        decoding="async"
      />
    ) : resolvedImage ? (
      <Image
        src={resolvedImage}
        alt={title}
        class="card-img"
        format="webp"
        quality={85}
        loading="lazy"
        decoding="async"
      />
    ) : (
      <div class="card-placeholder">
        <svg viewBox="0 0 60 60" width="48" height="48" fill="none" aria-hidden="true">
          <rect x="4" y="14" width="52" height="36" rx="4" stroke="currentColor" stroke-width="2"/>
          <circle cx="18" cy="28" r="5" stroke="currentColor" stroke-width="2"/>
          <path d="M4 38 L20 26 L32 36 L42 28 L56 38" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/>
        </svg>
      </div>
    )}
  </div>

  <!-- 暗色多層漸層遮罩 -->
  <div class="card-gradient-overlay" aria-hidden="true"></div>

  <!-- 浮貼內容層（頂部標籤、底部標題與閱讀指示） -->
  <div class="card-overlay-content">
    <div class="card-top-row">
      <span class="category-pill-badge">{category}</span>
      <span class="date-badge">{formattedDate}</span>
    </div>

    <div class="card-bottom-row">
      <h3 class="card-article-title">{title}</h3>
      <div class="card-action-hint">
        <span class="action-text">閱讀文章</span>
        <div class="action-arrow-circle" aria-hidden="true">
          <svg viewBox="0 0 20 20" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.5">
            <path d="M4 10h12M11 5l5 5-5 5" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </div>
      </div>
    </div>
  </div>
</a>

<style>
  .media-post-card {
    position: relative;
    display: flex;
    flex-direction: column;
    height: 280px;
    width: 100%;
    border-radius: 20px;
    overflow: hidden;
    background-color: #1e332a;
    border: 1px solid var(--color-border, #E2EAE6);
    box-shadow: 0 8px 24px var(--color-shadow, rgba(47, 102, 86, 0.08));
    text-decoration: none;
    color: #FFFFFF;
    box-sizing: border-box;
    transition:
      transform 0.35s cubic-bezier(0.23, 1, 0.32, 1),
      box-shadow 0.35s ease,
      border-color 0.35s ease;
  }

  .media-post-card:hover {
    transform: translateY(-6px);
    box-shadow: 0 18px 36px rgba(47, 102, 86, 0.2);
    border-color: rgba(47, 102, 86, 0.4);
  }

  /* 背景圖層 */
  .card-bg-layer {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: 0;
  }

  .card-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    transition: transform 0.5s cubic-bezier(0.23, 1, 0.32, 1);
  }

  .media-post-card:hover .card-img {
    transform: scale(1.06);
  }

  .card-placeholder {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    background: linear-gradient(135deg, var(--color-primary, #2F6656), #1b4332);
    color: rgba(255, 255, 255, 0.6);
  }

  /* 漸層覆蓋層 */
  .card-gradient-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      180deg,
      rgba(0, 0, 0, 0.4) 0%,
      rgba(0, 0, 0, 0.1) 40%,
      rgba(0, 0, 0, 0.85) 100%
    );
    z-index: 1;
    pointer-events: none;
    transition: background 0.3s ease;
  }

  .media-post-card:hover .card-gradient-overlay {
    background: linear-gradient(
      180deg,
      rgba(0, 0, 0, 0.45) 0%,
      rgba(0, 0, 0, 0.15) 35%,
      rgba(0, 0, 0, 0.9) 100%
    );
  }

  /* 內容層 */
  .card-overlay-content {
    position: relative;
    z-index: 2;
    height: 100%;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding: 18px 20px;
    box-sizing: border-box;
  }

  .card-top-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
  }

  .category-pill-badge {
    background: rgba(255, 255, 255, 0.25);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    color: #FFFFFF;
    font-size: 0.78rem;
    font-weight: 700;
    padding: 4px 12px;
    border-radius: 999px;
    border: 1px solid rgba(255, 255, 255, 0.35);
    letter-spacing: 0.3px;
    text-shadow: 0 1px 2px rgba(0, 0, 0, 0.4);
  }

  .date-badge {
    font-size: 0.75rem;
    color: rgba(255, 255, 255, 0.85);
    font-weight: 500;
    text-shadow: 0 1px 3px rgba(0, 0, 0, 0.6);
  }

  .card-bottom-row {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .card-article-title {
    font-size: 1.18rem;
    font-weight: 800;
    line-height: 1.35;
    color: #FFFFFF;
    text-shadow: 0 2px 8px rgba(0, 0, 0, 0.85);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    margin: 0;
  }

  .card-action-hint {
    display: flex;
    align-items: center;
    gap: 8px;
    color: rgba(255, 255, 255, 0.9);
  }

  .action-text {
    font-size: 0.82rem;
    font-weight: 700;
    letter-spacing: 0.3px;
    text-shadow: 0 1px 3px rgba(0, 0, 0, 0.6);
  }

  .action-arrow-circle {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 26px;
    height: 26px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.25);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    border: 1px solid rgba(255, 255, 255, 0.4);
    color: #FFFFFF;
    transition: transform 0.25s ease, background 0.25s ease;
  }

  .media-post-card:hover .action-arrow-circle {
    transform: translateX(4px);
    background: var(--color-primary, #2F6656);
    border-color: var(--color-primary, #2F6656);
  }

  @media (max-width: 640px) {
    .media-post-card {
      height: 250px;
      border-radius: 16px;
    }
    .card-overlay-content {
      padding: 14px 16px;
    }
    .card-article-title {
      font-size: 1.1rem;
    }
  }
</style>
