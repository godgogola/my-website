---
interface Props {
  title: string;
  href: string;
  category: string;
  publishDate: string | Date;
  coverImage?: string;
}

const {
  title,
  href,
  category,
  publishDate,
  coverImage = '/images/og-default.jpg',
} = Astro.props;

const formatDate = (date: string | Date) => {
  if (!date) return '';
  const d = new Date(date);
  return `${d.getFullYear()}年${d.getMonth() + 1}月${d.getDate()}日`;
};
---

<a href={href} class="pet-card-link" aria-label={`閱讀文章：${title}`}>
  <div class="pet-card">
    <!-- 封面圖容器 (16:9 比例) -->
    <div class="card-image-wrap">
      <img
        src={coverImage}
        alt={title}
        class="card-cover-img"
        loading="lazy"
        onerror="this.onerror=null; this.src='/images/og-default.jpg';"
      />
      <!-- 右上角愛心徽章 (Veterinary Clinic 收藏圓鈕) -->
      <button class="card-heart-btn" aria-label="收藏文章" type="button" onclick="event.preventDefault(); event.stopPropagation();">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor" class="heart-icon">
          <path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"/>
        </svg>
      </button>
    </div>

    <!-- 卡片內容區 -->
    <div class="card-content">
      <!-- 頂部分類與日期 -->
      <div class="card-meta">
        <span class="category-pill">{category}</span>
        <span class="publish-date">{formatDate(publishDate)}</span>
      </div>

      <!-- 文章標題 -->
      <h3 class="card-title">{title}</h3>

      <!-- 底部動作列 -->
      <div class="card-action">
        <span class="action-text">閱讀筆記</span>
        <div class="action-arrow">
          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <line x1="5" y1="12" x2="19" y2="12"></line>
            <polyline points="12 5 19 12 12 19"></polyline>
          </svg>
        </div>
      </div>
    </div>
  </div>
</a>

<style>
  .pet-card-link {
    display: block;
    text-decoration: none;
    color: inherit;
    height: 100%;
  }

  .pet-card {
    background-color: #FFFFFF;
    border-radius: 20px;
    border: 1.5px solid var(--color-border, #d4e5eb);
    box-shadow: 0 4px 16px rgba(74, 144, 164, 0.06);
    overflow: hidden;
    display: flex;
    flex-direction: column;
    height: 100%;
    transition: transform 0.28s cubic-bezier(0.34, 1.56, 0.64, 1), box-shadow 0.28s ease, border-color 0.28s ease;
  }

  .pet-card-link:hover .pet-card {
    transform: translateY(-4px);
    border-color: var(--color-primary, #4a90a4);
    box-shadow: 0 10px 28px rgba(74, 144, 164, 0.16);
  }

  /* 封面圖 16:9 */
  .card-image-wrap {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 9;
    background-color: var(--color-bg-alt, #eef5f7);
    overflow: hidden;
  }

  .card-cover-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    display: block;
    transition: transform 0.4s ease;
  }

  .pet-card-link:hover .card-cover-img {
    transform: scale(1.04);
  }

  /* 愛心圓鈕 */
  .card-heart-btn {
    position: absolute;
    top: 12px;
    right: 12px;
    width: 32px;
    height: 32px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.92);
    backdrop-filter: blur(4px);
    border: none;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
    color: #e76f51;
    transition: transform 0.2s ease, background-color 0.2s ease;
  }

  .card-heart-btn:hover {
    transform: scale(1.12);
    background: #FFFFFF;
  }

  /* 卡片主體 */
  .card-content {
    padding: 18px 20px 20px;
    display: flex;
    flex-direction: column;
    flex: 1;
  }

  .card-meta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
    margin-bottom: 12px;
  }

  .category-pill {
    display: inline-block;
    background-color: var(--color-primary-light, #eef7f9);
    color: var(--color-primary, #4a90a4);
    font-size: 0.76rem;
    font-weight: 800;
    padding: 3px 10px;
    border-radius: 9999px;
    border: 1px solid rgba(74, 144, 164, 0.2);
    letter-spacing: 0.3px;
  }

  .publish-date {
    font-size: 0.78rem;
    color: var(--color-text-muted, #5a7a8a);
    font-weight: 500;
  }

  .card-title {
    font-size: 1.08rem;
    font-weight: 800;
    color: var(--color-text-title, #1e3a4c);
    line-height: 1.45;
    margin-bottom: 16px;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    transition: color 0.2s ease;
  }

  .pet-card-link:hover .card-title {
    color: var(--color-primary, #4a90a4);
  }

  .card-action {
    margin-top: auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-top: 12px;
    border-top: 1px solid rgba(212, 229, 235, 0.6);
  }

  .action-text {
    font-size: 0.84rem;
    font-weight: 700;
    color: var(--color-primary, #4a90a4);
  }

  .action-arrow {
    width: 26px;
    height: 26px;
    border-radius: 50%;
    background-color: var(--color-primary-light, #eef7f9);
    color: var(--color-primary, #4a90a4);
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 0.25s ease;
  }

  .pet-card-link:hover .action-arrow {
    background: linear-gradient(135deg, var(--color-primary, #4a90a4), #5ba3b8);
    color: #FFFFFF;
    transform: translateX(3px);
  }
</style>
