---
interface Props {
  title: string;
  href: string;
  category: string;
  publishDate: string | Date;
  coverImage?: string;
}

const {
  title,
  href,
  category,
  publishDate,
  coverImage,
} = Astro.props;

// 正規化封面圖路徑
const getCoverImageUrl = (img?: string) => {
  if (!img) return '/images/og-default.jpg';
  const trimmed = img.trim();
  if (trimmed.startsWith('http://') || trimmed.startsWith('https://')) return trimmed;
  if (trimmed.startsWith('/')) return trimmed;
  return `/images/${trimmed}`;
};

const finalCoverImage = getCoverImageUrl(coverImage);

const formatDate = (date: string | Date) => {
  if (!date) return '';
  const d = new Date(date);
  return `${d.getFullYear()}年${d.getMonth() + 1}月${d.getDate()}日`;
};
---

<a href={href} class="media-post-card" aria-label={`閱讀文章：${title}`}>
  <!-- 滿版背景圖層 -->
  <div class="card-bg-layer">
    <img
      src={finalCoverImage}
      alt={title}
      class="card-img"
      loading="lazy"
      onerror="this.onerror=null; this.src='/images/og-default.jpg';"
    />
  </div>

  <!-- 深色漸層覆蓋層 (確保文字清晰度) -->
  <div class="card-gradient-overlay"></div>

  <!-- 內容層 (毛玻璃標籤 + 標題與動作) -->
  <div class="card-overlay-content">
    <!-- 頂部：分類標籤與日期 -->
    <div class="card-top-row">
      <span class="category-pill-badge">{category}</span>
      <span class="date-badge">{formatDate(publishDate)}</span>
    </div>

    <!-- 底部：文章標題與閱讀箭頭 -->
    <div class="card-bottom-row">
      <h3 class="card-article-title">{title}</h3>
      <div class="card-action-hint">
        <span class="action-text">閱讀文章</span>
        <div class="action-arrow-circle" aria-hidden="true">
          <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <line x1="5" y1="12" x2="19" y2="12"></line>
            <polyline points="12 5 19 12 12 19"></polyline>
          </svg>
        </div>
      </div>
    </div>
  </div>
</a>

<style>
  .media-post-card {
    position: relative;
    display: flex;
    flex-direction: column;
    height: 280px;
    width: 100%;
    border-radius: 20px;
    overflow: hidden;
    background-color: var(--color-bg-dark, #2c5364);
    border: 1px solid var(--color-border, #d4e5eb);
    box-shadow: 0 6px 20px rgba(74, 144, 164, 0.1);
    text-decoration: none;
    color: #FFFFFF;
    box-sizing: border-box;
    transition:
      transform 0.32s cubic-bezier(0.34, 1.56, 0.64, 1),
      box-shadow 0.32s ease,
      border-color 0.32s ease;
  }

  .media-post-card:hover {
    transform: translateY(-6px);
    box-shadow: 0 16px 36px rgba(74, 144, 164, 0.25);
    border-color: var(--color-primary, #4a90a4);
  }

  /* 滿版背景圖層 */
  .card-bg-layer {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: 0;
  }

  .card-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    display: block;
    transition: transform 0.45s ease;
  }

  .media-post-card:hover .card-img {
    transform: scale(1.05);
  }

  /* 深色漸層覆蓋層 */
  .card-gradient-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      180deg,
      rgba(30, 58, 76, 0.45) 0%,
      rgba(30, 58, 76, 0.12) 40%,
      rgba(20, 42, 56, 0.9) 100%
    );
    z-index: 1;
    pointer-events: none;
    transition: background 0.3s ease;
  }

  .media-post-card:hover .card-gradient-overlay {
    background: linear-gradient(
      180deg,
      rgba(30, 58, 76, 0.5) 0%,
      rgba(30, 58, 76, 0.18) 35%,
      rgba(15, 34, 46, 0.95) 100%
    );
  }

  /* 內容覆蓋層 */
  .card-overlay-content {
    position: relative;
    z-index: 2;
    height: 100%;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding: 18px 20px;
    box-sizing: border-box;
  }

  /* 頂部排版 */
  .card-top-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
  }

  .category-pill-badge {
    background: rgba(255, 255, 255, 0.26);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    color: #FFFFFF;
    font-size: 0.78rem;
    font-weight: 700;
    padding: 4px 12px;
    border-radius: 9999px;
    border: 1px solid rgba(255, 255, 255, 0.35);
    letter-spacing: 0.3px;
    text-shadow: 0 1px 2px rgba(0, 0, 0, 0.4);
  }

  .date-badge {
    font-size: 0.76rem;
    color: rgba(255, 255, 255, 0.9);
    font-weight: 500;
    text-shadow: 0 1px 3px rgba(0, 0, 0, 0.6);
  }

  /* 底部排版 */
  .card-bottom-row {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .card-article-title {
    font-size: 1.15rem;
    font-weight: 800;
    line-height: 1.38;
    color: #FFFFFF;
    text-shadow: 0 2px 8px rgba(0, 0, 0, 0.85);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    margin: 0;
  }

  .card-action-hint {
    display: flex;
    align-items: center;
    gap: 8px;
    color: rgba(255, 255, 255, 0.92);
  }

  .action-text {
    font-size: 0.82rem;
    font-weight: 700;
    letter-spacing: 0.3px;
    text-shadow: 0 1px 3px rgba(0, 0, 0, 0.6);
  }

  .action-arrow-circle {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 26px;
    height: 26px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.22);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    border: 1px solid rgba(255, 255, 255, 0.4);
    color: #FFFFFF;
    transition: transform 0.25s ease, background 0.25s ease;
  }

  .media-post-card:hover .action-arrow-circle {
    transform: translateX(4px);
    background: linear-gradient(135deg, var(--color-primary, #4a90a4), #5ba3b8);
    border-color: transparent;
  }

  @media (max-width: 640px) {
    .media-post-card {
      height: 250px;
      border-radius: 18px;
    }
    .card-overlay-content {
      padding: 14px 16px;
    }
    .card-article-title {
      font-size: 1.08rem;
    }
  }
</style>
